# ===========================================
# Beauty Face Lift — Environment Variables
# Copy to .env.local and fill in values
# ===========================================

# Supabase
PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe (optional — only if using deposit feature)
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Tracking — Meta (set after creating Meta Pixel)
META_PIXEL_ID=123456789
META_ACCESS_TOKEN=EAA...

# Tracking — Google (set after creating GA4 property)
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=xxxxxxxx

# GTM (set after creating GTM container)
PUBLIC_GTM_ID=GTM-XXXXXXX

# Contact form security
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAA...
TURNSTILE_SECRET_KEY=0x4AAAA...
TURNSTILE_ALLOWED_HOSTS=beautyfacelift.ch,www.beautyfacelift.ch,beautyfacelift.mediapaulo.workers.dev

# Notifications — Resend / Kontaktformular
RESEND_API_KEY=re_...
CONTACT_FROM_EMAIL="Beauty Face Lift <onboarding@resend.dev>"
CONTACT_TO_EMAIL=info@beautyfacelift.ch
OWNER_EMAIL=info@beautyfacelift.ch
OWNER_PHONE=+41792143462
