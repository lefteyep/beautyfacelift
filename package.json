{
  "name": "astro-v2",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && tsc -p worker",
    "smoke:security": "node scripts/security-smoke.mjs",
    "cf:dev": "wrangler dev",
    "cf:build": "astro build",
    "cf:deploy": "astro build && wrangler deploy --assets=./dist --old-asset-ttl=0 --keep-vars",
    "cf:tail": "wrangler tail",
    "qa:carbon-lp": "node scripts/check-carbon-lp-offer.mjs",
    "qa:aquafacial-lp": "node scripts/check-aquafacial-aktion-lp-offer.mjs",
    "qa:aquafacial-combo-lp": "node scripts/check-aquafacial-lp-offer.mjs",
    "qa:simple-lps": "node scripts/check-simple-lps.mjs",
    "qa:docs": "node scripts/check-docs-current.mjs",
    "qa:marketing": "node scripts/check-marketing-ads.mjs",
    "qa:contact": "node scripts/check-contact-concierge.mjs",
    "qa:worker": "node scripts/check-worker-api.mjs",
    "qa:leads": "node scripts/check-leads.mjs",
    "d1:migrate:local": "wrangler d1 migrations apply beautyfacelift-leads --local",
    "harness:leads-ingest": "node --disable-warning=ExperimentalWarning --import tsx scripts/harness/leads-ingest.mts",
    "harness:leads-access": "node --disable-warning=ExperimentalWarning --import tsx scripts/harness/leads-access.mts",
    "harness:leads-cockpit": "node --disable-warning=ExperimentalWarning --import tsx scripts/harness/leads-cockpit.mts",
    "harness:leads-cron": "node --disable-warning=ExperimentalWarning --import tsx scripts/harness/leads-cron.mts",
    "harness:leads-manual": "node --disable-warning=ExperimentalWarning --import tsx scripts/harness/leads-manual.mts",
    "harness:leads-readiness": "node --disable-warning=ExperimentalWarning --import tsx scripts/harness/leads-readiness.mts",
    "qa:data-ops": "node --disable-warning=ExperimentalWarning --test scripts/leads-data-ops.test.mjs",
    "preview:cockpit": "node --disable-warning=ExperimentalWarning --import tsx scripts/harness/pilot-preview-server.mts",
    "launch:check": "node scripts/check-domain-launch.mjs",
    "validate": "node scripts/validate.mjs",
    "validate:harnesses": "node scripts/validate-harnesses.mjs",
    "validate:smoke": "node scripts/validate-local-smoke.mjs",
    "qa:guardrails": "node --test scripts/release-guardrails.test.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.0",
    "@astrojs/sitemap": "^3.7.1",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@stripe/stripe-js": "^8.10.0",
    "@supabase/supabase-js": "^2.99.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.0.2",
    "astro-seo": "^1.1.0",
    "gsap": "^3.14.2",
    "itty-router": "^5.0.23",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261006.1",
    "supabase": "^2.98.2",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "wrangler": "^4.83.0"
  },
  "overrides": {
    "ws": "8.21.0",
    "yaml-language-server": {
      "yaml": "2.8.4"
    },
    "sharp": "0.35.5"
  }
}
