---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/main.css';
import '../styles/components.css';
import '../styles/booking.css';
import '../styles/admin.css';
import '../styles/blog.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  preloadImage?: string;
  ogImage?: string;
  navVariant?: 'default' | 'treatment';
  structuredData?: object;
  noindex?: boolean;
  articleDate?: string;
  articleModified?: string;
}

const { title, description, canonical, preloadImage, ogImage, navVariant = 'default', structuredData, noindex = false, articleDate, articleModified } = Astro.props;
const canonicalUrl = canonical || new URL(Astro.url.pathname, 'https://beautyfacelift.ch').href;
const ogImageUrl = ogImage || 'https://beautyfacelift.ch/assets/spa_interior.png';
---

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl}>

    <!-- SEO -->
    {noindex && <meta name="robots" content="noindex, nofollow">}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">}
    <meta name="theme-color" content="#CFA65E">
    <meta name="geo.region" content="CH-ZH">
    <meta name="geo.placename" content="Zürich">
    <meta name="geo.position" content="47.3753;8.5385">
    <meta name="ICBM" content="47.3753, 8.5385">
    <link rel="alternate" hreflang="de-CH" href={canonicalUrl}>
    <link rel="alternate" hreflang="x-default" href={canonicalUrl}>

    <!-- Open Graph -->
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:type" content={articleDate ? "article" : "website"}>
    <meta property="og:locale" content="de_CH">
    <meta property="og:image" content={ogImageUrl}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:site_name" content="Beauty Face Lift">
    {articleDate && <meta property="article:published_time" content={articleDate}>}
    {articleModified && <meta property="article:modified_time" content={articleModified}>}
    {articleDate && <meta property="article:author" content="Teresa Stimac">}
    {articleDate && <meta property="article:section" content="Hautpflege">}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImageUrl}>

    {structuredData && (
        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}

    <!-- GTM via Partytown (runs in web worker, non-blocking) -->
    {import.meta.env.PUBLIC_GTM_ID && (
      <script type="text/partytown" set:html={`
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','${import.meta.env.PUBLIC_GTM_ID}');
      `} />
    )}

    <!-- Favicon & Manifest -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="manifest" href="/manifest.json">

    {preloadImage && <link rel="preload" as="image" href={preloadImage}>}
</head>
<body>
    <a href="#main-content" class="skip-link">Zum Inhalt springen</a>
    <Nav variant={navVariant} />

    <main id="main-content">
        <slot />
    </main>

    <Footer />

    <!-- UTM Parameter Persistence -->
    <script is:inline>
        (function() {
            var params = new URLSearchParams(window.location.search);
            var utmKeys = ['utm_source','utm_medium','utm_campaign','utm_content','utm_term','gclid','fbclid'];
            var utm = {};
            var hasUtm = false;
            utmKeys.forEach(function(k) {
                var v = params.get(k);
                if (v) { utm[k] = v; hasUtm = true; }
            });
            if (hasUtm) {
                try { sessionStorage.setItem('bfl_utm', JSON.stringify(utm)); } catch(e) {}
            }
        })();
    </script>

    <!-- GSAP (bundled via npm, tree-shaken by Vite) -->
    <script>
        import gsap from 'gsap';
        import { ScrollTrigger } from 'gsap/ScrollTrigger';
        gsap.registerPlugin(ScrollTrigger);

        // Respect reduced motion preference
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (!prefersReducedMotion) {
            // 1. Text Reveal Animation for Hero
            const heroTl = gsap.timeline({ defaults: { ease: "power4.out" } });

            document.querySelectorAll('.text-reveal-wrapper').forEach(wrapper => {
                (wrapper as HTMLElement).style.overflow = 'hidden';
            });

            heroTl.fromTo('.title-line .text-reveal',
                { y: '110%', rotateY: 10 },
                { y: '0%', rotateY: 0, duration: 1.5, stagger: 0.2, delay: 0.2 }
            )
            .fromTo('.sub-display .text-reveal',
                { y: '110%' },
                { y: '0%', duration: 1 },
                "-=1.2"
            );

            // Floating emotional image fade up
            gsap.to('#hero-float-1', {
                y: 0,
                opacity: 1,
                duration: 1.5,
                ease: "power3.out",
                delay: 1.2
            });

            // 2. Hero Image Scaling on Scroll
            gsap.to('#hero-media', {
                width: '100vw',
                height: '100vh',
                borderRadius: '0px',
                y: '20vh',
                scrollTrigger: {
                    trigger: '.hero-editorial',
                    start: 'top top',
                    end: 'bottom top',
                    scrub: 1.5
                }
            });

            // 3. Image Parallax + clip-path curtain reveal
            document.querySelectorAll('.service-image-mask, .about-image .service-image-mask').forEach(container => {
                const img = container.querySelector('.anim-img');
                if (!img) return;

                // Curtain-up reveal
                gsap.fromTo(container,
                    { clipPath: 'inset(100% 0 0 0)' },
                    {
                        clipPath: 'inset(0 0 0 0)',
                        duration: 1.2,
                        ease: 'expo.out',
                        scrollTrigger: {
                            trigger: container,
                            start: 'top 85%',
                        }
                    }
                );

                // Parallax
                gsap.fromTo(img,
                    { y: '-10%' },
                    {
                        y: '10%',
                        scrollTrigger: {
                            trigger: container,
                            start: 'top bottom',
                            end: 'bottom top',
                            scrub: 1
                        }
                    }
                );
            });

            // 4. Fade Up Reveal for blocks
            gsap.utils.toArray('.scroll-anim').forEach(element => {
                gsap.fromTo(element as Element,
                    { opacity: 0, y: 40 },
                    {
                        opacity: 1,
                        y: 0,
                        duration: 1.2,
                        ease: "expo.out",
                        scrollTrigger: {
                            trigger: element as Element,
                            start: 'top 85%',
                            toggleActions: "play none none reverse"
                        }
                    }
                );
            });

            // 5. Treatment Hero Parallax
            const treatmentHeroImg = document.querySelector('#treatment-hero-img');
            if (treatmentHeroImg) {
                gsap.fromTo(treatmentHeroImg,
                    { scale: 1.05 },
                    {
                        scale: 1.15,
                        scrollTrigger: {
                            trigger: '.treatment-hero',
                            start: 'top top',
                            end: 'bottom top',
                            scrub: 1
                        }
                    }
                );
            }

            // 6. Footer Text Reveal
            const footerReveal = document.querySelector('.footer-editorial .text-reveal');
            if (footerReveal) {
                gsap.fromTo(footerReveal,
                    { y: '110%' },
                    {
                        y: '0%',
                        duration: 1.5,
                        ease: "expo.out",
                        scrollTrigger: {
                            trigger: '.footer-editorial',
                            start: 'top 75%'
                        }
                    }
                );
            }
        } else {
            // Reduced motion: make everything visible immediately
            document.querySelectorAll('.text-reveal').forEach(el => {
                (el as HTMLElement).style.transform = 'none';
            });
            document.querySelectorAll('.scroll-anim').forEach(el => {
                (el as HTMLElement).style.opacity = '1';
                (el as HTMLElement).style.transform = 'none';
            });
            const heroFloat = document.getElementById('hero-float-1');
            if (heroFloat) {
                heroFloat.style.opacity = '1';
                heroFloat.style.transform = 'none';
            }
        }
    </script>
</body>
</html>
