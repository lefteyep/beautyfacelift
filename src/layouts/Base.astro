---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import HeadIcons from '../components/HeadIcons.astro';
import '../styles/main.css';
import '../styles/components.css';
import '../styles/booking.css';
import '../styles/admin.css';
import '../styles/blog.css';
import { absoluteUrl, SITE_NAME } from '../../shared/site';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  preloadImage?: string | {
    href: string;
    imagesrcset?: string;
    imagesizes?: string;
    type?: string;
    fetchpriority?: 'high' | 'low' | 'auto';
  };
  ogImage?: string;
  navVariant?: 'default' | 'treatment';
  structuredData?: object;
  noindex?: boolean;
  articleDate?: string;
  articleModified?: string;
  bodyClass?: string;
}

const {
  title,
  description,
  canonical,
  preloadImage,
  ogImage,
  navVariant = 'default',
  structuredData,
  noindex = false,
  articleDate,
  articleModified,
  bodyClass,
} = Astro.props;
const canonicalUrl = canonical || absoluteUrl(Astro.url.pathname);
const ogImageUrl = ogImage || absoluteUrl('/assets/hero_editorial_portrait.png');
const isTreatment = navVariant === 'treatment';
const preloadImageLink = typeof preloadImage === 'string' ? { href: preloadImage } : preloadImage;
const pixelId = import.meta.env.PUBLIC_META_PIXEL_ID;
const pixelNoscriptHtml = pixelId
    ? `<img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=${pixelId}&amp;ev=PageView&amp;noscript=1" />`
    : '';
---

<!DOCTYPE html>
<html lang="de-CH">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Critical layout CSS — inlined to prevent FOUC. Must apply before
         any external stylesheet / dev-mode JS-injected CSS loads. -->
    <style>
        :root { --content-px: max(58px, calc(50vw - 620px)); }
        body { margin: 0; position: relative; overflow-x: hidden; }
        .nav-minimal {
            position: fixed; top: 0; left: 0; right: 0; z-index: 100;
            display: flex; justify-content: space-between; align-items: center;
            padding: 28px var(--content-px);
            pointer-events: none;
        }
        .nav-minimal > * { pointer-events: auto; }
        .hero-editorial { max-width: 1240px; margin: 0 auto; padding: 12vh 58px 8vh; }
        .services-section,
        .about-editorial,
        .testimonials-section,
        .faq-section,
        .rating-line,
        .trust-strip,
        .footer-editorial,
        .treatment-hero { padding-left: var(--content-px); padding-right: var(--content-px); }
        .marquee-container { padding: 32px 0; overflow: hidden; }
        .nav-treatment { color: #F6F1EA; }
        .nav-treatment .nav-logo { filter: brightness(0) invert(1); }
        body.page-treatment { background: #1C1A17; }
        body.page-treatment main { background: #F6F1EA; }
        body.page-treatment .treatment-hero {
            min-height: 600px;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            position: relative;
            margin-top: 0;
            padding: 0 var(--content-px) 48px;
            background: #1C1A17;
            isolation: isolate;
        }
        body.page-treatment .treatment-hero-media {
            position: absolute;
            inset: -1px 0 0;
            overflow: hidden;
            border-radius: 0 0 22px 22px;
        }
        body.page-treatment .treatment-hero-media::after {
            content: '';
            position: absolute;
            inset: 0;
            background:
                linear-gradient(to bottom, rgba(26,24,22,0.55) 0%, rgba(26,24,22,0.18) 18%, rgba(26,24,22,0) 32%),
                linear-gradient(to top, rgba(26,24,22,0.88) 0%, rgba(26,24,22,0.32) 46%, rgba(26,24,22,0.06) 72%);
            z-index: 1;
        }
        body.page-treatment .treatment-hero-media img,
        body.page-treatment .treatment-hero-media picture,
        body.page-treatment .treatment-hero-media picture > img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        body.page-treatment .treatment-hero .hero-titles {
            position: relative;
            z-index: 2;
        }
        @media (max-width: 900px) {
            .nav-minimal { padding: 16px 24px; }
            .hero-editorial { padding: 80px 24px 48px; }
            .hero-sub-display { display: none; }
            .hero-display .display-text { font-size: clamp(2.25rem, 8.8vw, 2.5rem); line-height: 1.08; }
            .hero-media { width: min(100%, 340px); max-width: 340px; margin-left: auto; margin-right: auto; }
            .services-section,
            .about-editorial,
            .testimonials-section,
            .faq-section,
            .rating-line,
            .trust-strip,
            .footer-editorial,
            .treatment-hero { padding-left: 24px; padding-right: 24px; }
            body.page-treatment .treatment-hero {
                min-height: 380px;
                padding: 0 24px 32px;
            }
            body.page-treatment .treatment-hero-media { inset: -1px 0 0; border-radius: 0; }
        }
    </style>

    <meta name="description" content={description}>
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl}>

    <!-- SEO -->
    {noindex && <meta name="robots" content="noindex, nofollow">}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">}
    <meta name="theme-color" content="#B98F47">
    <meta name="geo.region" content="CH-ZH">
    <meta name="geo.placename" content="Zürich">
    <meta name="geo.position" content="47.3753;8.5385">
    <meta name="ICBM" content="47.3753, 8.5385">
    <link rel="alternate" hreflang="de-CH" href={canonicalUrl}>
    <link rel="alternate" hreflang="x-default" href={canonicalUrl}>

    <!-- Open Graph -->
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:type" content={articleDate ? "article" : "website"}>
    <meta property="og:locale" content="de_CH">
    <meta property="og:image" content={ogImageUrl}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:site_name" content={SITE_NAME}>
    {articleDate && <meta property="article:published_time" content={articleDate}>}
    {articleModified && <meta property="article:modified_time" content={articleModified}>}
    {articleDate && <meta property="article:author" content="Teresa Stimac">}
    {articleDate && <meta property="article:section" content="Hautpflege">}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImageUrl}>

    {structuredData && (
        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}

    <!-- GTM via Partytown (runs in web worker, non-blocking) -->
    {import.meta.env.PUBLIC_GTM_ID && (
      <script type="text/partytown" set:html={`
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','${import.meta.env.PUBLIC_GTM_ID}');
      `} />
    )}

    <!-- Meta Pixel bootstrap. Events are fired from src/lib/track.ts with event IDs for CAPI dedupe. -->
    {pixelId && (
      <script is:inline define:vars={{ pixelId }}>
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
        n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
        document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', pixelId);
      </script>
    )}
    {pixelId && <noscript set:html={pixelNoscriptHtml}></noscript>}

    <!-- Favicon & Manifest -->
    <HeadIcons />

    {preloadImageLink && (
      <link
        rel="preload"
        as="image"
        href={preloadImageLink.href}
        imagesrcset={preloadImageLink.imagesrcset}
        imagesizes={preloadImageLink.imagesizes}
        type={preloadImageLink.type}
        fetchpriority={preloadImageLink.fetchpriority}
      />
    )}
</head>
<body class:list={[bodyClass, isTreatment && 'page-treatment']}>
    <a href="#main-content" class="skip-link">Zum Inhalt springen</a>
    <Nav variant={navVariant} />

    <main id="main-content">
        <slot />
    </main>

    <Footer />

    <!-- UTM Parameter Persistence -->
    <script is:inline>
        (function() {
            var params = new URLSearchParams(window.location.search);
            var utmKeys = ['utm_id','utm_source','utm_medium','utm_campaign','utm_content','utm_term','utm_source_platform','gclid','gbraid','wbraid','fbclid','matchtype','network','device'];
            var utm = {};
            var hasUtm = false;
            utmKeys.forEach(function(k) {
                var v = params.get(k);
                if (v) { utm[k] = v; hasUtm = true; }
            });
            if (hasUtm) {
                try { sessionStorage.setItem('bfl_utm', JSON.stringify(utm)); } catch(e) {}
            }
        })();
    </script>

    <script>
        import { initPpcTracking } from '../lib/track';
        initPpcTracking();
    </script>

    <!-- Lazy image reveal -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('img[loading="lazy"]').forEach(function(img) {
                img.loading = 'eager';
                if (img.complete) { img.classList.add('loaded'); }
                else { img.addEventListener('load', function() { img.classList.add('loaded'); }); }
            });
        });
    </script>

    <!-- GSAP — cinematic animations -->
    <script>
        import gsap from 'gsap';
        import { ScrollTrigger } from 'gsap/ScrollTrigger';
        gsap.registerPlugin(ScrollTrigger);

        // Respect reduced motion preference
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (!prefersReducedMotion) {
            // Global defaults
            gsap.defaults({ ease: "power4.out" });

            // 1. Hero Fade-In — simple, robust, descender-safe.
            // immediateRender: false keeps elements at their natural CSS state
            // until the tween actually plays. If the ticker ever stalls (e.g.
            // tab backgrounded on load) the text stays visible instead of
            // being stuck at opacity 0.
            const heroTl = gsap.timeline();
            const heroSubDisplay = document.querySelector('.hero-sub-display .text-reveal');
            const heroDisplay = document.querySelector('.hero-display .text-reveal');
            const heroCta = document.querySelector('.hero-cta');

            if (heroSubDisplay) {
                heroTl.from(heroSubDisplay,
                    { opacity: 0, y: 12, duration: 0.9, delay: 0.2, immediateRender: false }
                );
            }
            if (heroDisplay) {
                heroTl.from(heroDisplay,
                    { opacity: 0, y: 20, duration: 1.1, immediateRender: false },
                    heroSubDisplay ? "-=0.6" : 0
                );
            }
            if (heroCta) {
                heroTl.from(heroCta,
                    { y: 20, opacity: 0, duration: 0.8, ease: "power3.out", immediateRender: false },
                    heroDisplay ? "-=0.6" : 0
                );
            }

            // 2. Floating image fade up with slight rotation
            const heroFloat = document.getElementById('hero-float-1');
            if (heroFloat) {
                gsap.from(heroFloat,
                    { y: 36, opacity: 0, rotate: 1.5, duration: 1.4, ease: "power3.out", delay: 0.8, immediateRender: false }
                );
            }


            // 4. Image Parallax + clip-path curtain reveal
            document.querySelectorAll('.service-image-mask, .about-image .service-image-mask').forEach(container => {
                const img = container.querySelector('.anim-img');
                if (!img) return;

                // Parallax
                gsap.fromTo(img,
                    { y: '-10%' },
                    {
                        y: '10%',
                        scrollTrigger: {
                            trigger: container,
                            start: 'top bottom',
                            end: 'bottom top',
                            scrub: 1.2
                        }
                    }
                );
            });

            // 5. Fade Up Reveal for blocks — staggered with more finesse
            gsap.utils.toArray('.scroll-anim').forEach(element => {
                gsap.from(element as Element,
                    {
                        y: 32,
                        duration: 1.1,
                        ease: "expo.out",
                        immediateRender: false,
                        scrollTrigger: {
                            trigger: element as Element,
                            start: 'top 88%',
                            once: true,
                        }
                    }
                );
            });

            // 6. Treatment Hero Parallax
            const treatmentHeroImg = document.querySelector('#treatment-hero-img');
            if (treatmentHeroImg) {
                gsap.fromTo(treatmentHeroImg,
                    { scale: 1.05 },
                    {
                        scale: 1.15,
                        scrollTrigger: {
                            trigger: '.treatment-hero',
                            start: 'top top',
                            end: 'bottom top',
                            scrub: 1
                        }
                    }
                );
            }

            // 7. Footer Text Reveal — cinematic entrance
            const footerReveal = document.querySelector('.footer-editorial .text-reveal');
            if (footerReveal) {
                gsap.from(footerReveal,
                    {
                        y: '42%',
                        duration: 1.15,
                        ease: "expo.out",
                        immediateRender: false,
                        scrollTrigger: {
                            trigger: '.footer-editorial',
                            start: 'top 82%',
                            once: true,
                        }
                    }
                );
            }

            // 8. Parallax depth on about portrait
            const aboutPortrait = document.querySelector('.about-portrait img');
            if (aboutPortrait) {
                gsap.fromTo(aboutPortrait,
                    { y: '-5%', scale: 1.08 },
                    {
                        y: '5%',
                        scale: 1.08,
                        scrollTrigger: {
                            trigger: '.about-portrait',
                            start: 'top bottom',
                            end: 'bottom top',
                            scrub: 1.5
                        }
                    }
                );
            }

            // 9. Stagger service cards for sequential reveal
            const serviceCards = gsap.utils.toArray('.service-card');
            if (serviceCards.length > 0) {
                serviceCards.forEach((card, i) => {
                    gsap.from(card as Element,
                        {
                            y: 36,
                            duration: 1,
                            ease: "expo.out",
                            immediateRender: false,
                            scrollTrigger: {
                                trigger: card as Element,
                                start: 'top 90%',
                                once: true,
                            }
                        }
                    );
                });
            }

            // 10. Testimonial cards stagger
            const testimonialCards = gsap.utils.toArray('.testimonial-card');
            if (testimonialCards.length > 0) {
                gsap.from(testimonialCards as Element[],
                    {
                        y: 28,
                        duration: 1,
                        stagger: 0.15,
                        ease: "power3.out",
                        immediateRender: false,
                        scrollTrigger: {
                            trigger: '.testimonials-grid',
                            start: 'top 85%',
                            once: true,
                        }
                    }
                );
            }

            // 11. FAQ items stagger
            const faqItems = gsap.utils.toArray('.faq-item');
            if (faqItems.length > 0) {
                gsap.from(faqItems as Element[],
                    {
                        y: 18,
                        duration: 0.8,
                        stagger: 0.08,
                        ease: "power3.out",
                        immediateRender: false,
                        scrollTrigger: {
                            trigger: '.faq-list',
                            start: 'top 85%',
                            once: true,
                        }
                    }
                );
            }

            // 12. Highlight/Process grid stagger
            const highlightItems = gsap.utils.toArray('.highlight-item, .process-step');
            if (highlightItems.length > 0) {
                gsap.from(highlightItems as Element[],
                    {
                        y: 24,
                        duration: 0.9,
                        stagger: 0.1,
                        ease: "power3.out",
                        immediateRender: false,
                        scrollTrigger: {
                            trigger: (highlightItems[0] as Element).parentElement,
                            start: 'top 85%',
                            once: true,
                        }
                    }
                );
            }

        } else {
            // Reduced motion: make everything visible immediately
            document.querySelectorAll('.text-reveal').forEach(el => {
                (el as HTMLElement).style.transform = 'none';
            });
            document.querySelectorAll('.scroll-anim').forEach(el => {
                (el as HTMLElement).style.opacity = '1';
                (el as HTMLElement).style.transform = 'none';
            });
            const heroFloat = document.getElementById('hero-float-1');
            if (heroFloat) {
                heroFloat.style.opacity = '1';
                heroFloat.style.transform = 'none';
            }
            document.querySelectorAll('.service-card, .testimonial-card, .faq-item, .highlight-item, .process-step').forEach(el => {
                (el as HTMLElement).style.opacity = '1';
                (el as HTMLElement).style.transform = 'none';
            });
        }
    </script>
</body>
</html>
