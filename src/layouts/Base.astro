---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import HeadIcons from '../components/HeadIcons.astro';
import MarketingConsent from '../components/MarketingConsent.astro';
import '../styles/main.css';
import '../styles/components.css';
import '../styles/booking.css';
import { absoluteUrl, SITE_NAME } from '../../shared/site';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  preloadImage?: string | {
    href: string;
    imagesrcset?: string;
    imagesizes?: string;
    type?: string;
    fetchpriority?: 'high' | 'low' | 'auto';
  };
  ogImage?: string;
  navVariant?: 'default' | 'treatment';
  structuredData?: object;
  noindex?: boolean;
  articleDate?: string;
  articleModified?: string;
  bodyClass?: string;
}

const {
  title,
  description,
  canonical,
  preloadImage,
  ogImage,
  navVariant = 'default',
  structuredData,
  noindex = false,
  articleDate,
  articleModified,
  bodyClass,
} = Astro.props;
const canonicalUrl = canonical || absoluteUrl(Astro.url.pathname);
const ogImageUrl = ogImage || absoluteUrl('/assets/hero_editorial_portrait.png');
const isTreatment = navVariant === 'treatment';
const preloadImageLink = typeof preloadImage === 'string' ? { href: preloadImage } : preloadImage;
const pixelId = import.meta.env.PUBLIC_META_PIXEL_ID;
const gtmId = import.meta.env.PUBLIC_GTM_ID;
---

<!DOCTYPE html>
<html lang="de-CH">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="facebook-domain-verification" content="61xaasiyh074x1sn3szqej2sf3mzet">

    <!-- Critical layout CSS — inlined so the fixed nav and page ground are
         correct before the bundled stylesheets arrive. -->
    <style>
        :root { --nav-h: 84px; --gutter: clamp(20px, 5vw, 72px); --content-px: max(var(--gutter), calc(50vw - 660px)); }
        html, body { background: #F7F4EF; }
        body { margin: 0; position: relative; overflow-x: hidden; color: #3A332C; }
        .nav-minimal {
            position: fixed; top: 0; left: 0; right: 0; z-index: 100;
            height: var(--nav-h);
            display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center;
            padding: 0 var(--content-px);
            background: rgba(247, 244, 239, 0.9);
        }
        .nav-brand { grid-column: 2; }
        .nav-logo { height: 48px; width: auto; }
        @media (max-width: 900px) {
            :root { --nav-h: 68px; }
            .nav-minimal { grid-template-columns: auto 1fr auto; padding: 0 var(--gutter); }
            .nav-brand { grid-column: 1; }
            .nav-logo { height: 38px; }
            .nav-links, .nav-right { display: none; }
        }
    </style>

    <meta name="description" content={description}>
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl}>

    <!-- SEO -->
    {noindex && <meta name="robots" content="noindex, nofollow">}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">}
    <meta name="theme-color" content="#F7F4EF">
    <meta name="geo.region" content="CH-ZH">
    <meta name="geo.placename" content="Zürich">
    <meta name="geo.position" content="47.3753;8.5385">
    <meta name="ICBM" content="47.3753, 8.5385">
    <link rel="alternate" hreflang="de-CH" href={canonicalUrl}>
    <link rel="alternate" hreflang="x-default" href={canonicalUrl}>

    <!-- Open Graph -->
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:type" content={articleDate ? "article" : "website"}>
    <meta property="og:locale" content="de_CH">
    <meta property="og:image" content={ogImageUrl}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:site_name" content={SITE_NAME}>
    {articleDate && <meta property="article:published_time" content={articleDate}>}
    {articleModified && <meta property="article:modified_time" content={articleModified}>}
    {articleDate && <meta property="article:author" content="Teresa Stimac">}
    {articleDate && <meta property="article:section" content="Hautpflege">}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImageUrl}>

    {structuredData && (
        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}

    <!-- Favicon & Manifest -->
    <HeadIcons />

    {preloadImageLink && (
      <link
        rel="preload"
        as="image"
        href={preloadImageLink.href}
        imagesrcset={preloadImageLink.imagesrcset}
        imagesizes={preloadImageLink.imagesizes}
        type={preloadImageLink.type}
        fetchpriority={preloadImageLink.fetchpriority}
      />
    )}
</head>
<body class:list={[bodyClass, isTreatment && 'page-treatment']}>
    <a href="#main-content" class="skip-link">Zum Inhalt springen</a>
    <Nav variant={navVariant} />

    <main id="main-content">
        <slot />
    </main>

    <Footer />
    <MarketingConsent />

    <script is:inline define:vars={{ pixelId, gtmId }}>
        window.bflTrackingConfig = {
            metaPixelId: pixelId || '',
            gtmId: gtmId || ''
        };
    </script>

    <!-- UTM Parameter Persistence -->
    <script is:inline>
        (function() {
            var params = new URLSearchParams(window.location.search);
            var utmKeys = ['utm_id','utm_source','utm_medium','utm_campaign','utm_content','utm_term','utm_source_platform','gclid','gbraid','wbraid','fbclid','matchtype','network','device'];
            var utm = {};
            var hasUtm = false;
            utmKeys.forEach(function(k) {
                var v = params.get(k);
                if (v) { utm[k] = v; hasUtm = true; }
            });
            if (hasUtm) {
                try { sessionStorage.setItem('bfl_utm', JSON.stringify(utm)); } catch(e) {}
            }
        })();
    </script>

    <script>
        import { initPpcTracking } from '../lib/track';
        initPpcTracking();
    </script>

    <!-- Lazy image reveal -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('img[loading="lazy"]').forEach(function(img) {
                img.loading = 'eager';
                if (img.complete) { img.classList.add('loaded'); }
                else { img.addEventListener('load', function() { img.classList.add('loaded'); }); }
            });
        });
    </script>

    <!-- GSAP — cinematic animations -->
    <script>
        import gsap from 'gsap';
        import { ScrollTrigger } from 'gsap/ScrollTrigger';
        gsap.registerPlugin(ScrollTrigger);

        // Respect reduced motion preference
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (!prefersReducedMotion) {
            // Global defaults
            gsap.defaults({ ease: "power4.out" });

            // 1. Hero entrance is pure CSS (.reveal-up in components.css) so it
            // never flashes or depends on the GSAP ticker.


            // 4. Image Parallax + clip-path curtain reveal
            document.querySelectorAll('.service-image-mask, .about-image .service-image-mask').forEach(container => {
                const img = container.querySelector('.anim-img');
                if (!img) return;

                // Parallax
                gsap.fromTo(img,
                    { y: '-4%' },
                    {
                        y: '4%',
                        scrollTrigger: {
                            trigger: container,
                            start: 'top bottom',
                            end: 'bottom top',
                            scrub: 1.2
                        }
                    }
                );
            });

            // 5. Fade Up Reveal for blocks — staggered with more finesse
            gsap.utils.toArray('.scroll-anim').forEach(element => {
                gsap.from(element as Element,
                    {
                        y: 24,
                        duration: 1.1,
                        ease: "expo.out",
                        immediateRender: false,
                        scrollTrigger: {
                            trigger: element as Element,
                            start: 'top 88%',
                            once: true,
                        }
                    }
                );
            });

            // 6. Treatment Hero Parallax
            const treatmentHeroImg = document.querySelector('#treatment-hero-img');
            if (treatmentHeroImg) {
                gsap.fromTo(treatmentHeroImg,
                    { scale: 1 },
                    {
                        scale: 1.06,
                        scrollTrigger: {
                            trigger: '.treatment-hero',
                            start: 'top top',
                            end: 'bottom top',
                            scrub: 1
                        }
                    }
                );
            }

            // 7. Footer Text Reveal — cinematic entrance
            const footerReveal = document.querySelector('.footer-editorial .text-reveal');
            if (footerReveal) {
                gsap.from(footerReveal,
                    {
                        y: '42%',
                        duration: 1.15,
                        ease: "expo.out",
                        immediateRender: false,
                        scrollTrigger: {
                            trigger: '.footer-editorial',
                            start: 'top 82%',
                            once: true,
                        }
                    }
                );
            }

            // 8. Parallax depth on about portrait
            const aboutPortrait = document.querySelector('.about-portrait img');
            if (aboutPortrait) {
                gsap.fromTo(aboutPortrait,
                    { y: '-5%', scale: 1.08 },
                    {
                        y: '5%',
                        scale: 1.08,
                        scrollTrigger: {
                            trigger: '.about-portrait',
                            start: 'top bottom',
                            end: 'bottom top',
                            scrub: 1.5
                        }
                    }
                );
            }

            // 9. Stagger service cards for sequential reveal
            const serviceCards = gsap.utils.toArray('.service-card');
            if (serviceCards.length > 0) {
                serviceCards.forEach((card, i) => {
                    gsap.from(card as Element,
                        {
                            y: 36,
                            duration: 1,
                            ease: "expo.out",
                            immediateRender: false,
                            scrollTrigger: {
                                trigger: card as Element,
                                start: 'top 90%',
                                once: true,
                            }
                        }
                    );
                });
            }

            // 10. Testimonial cards stagger
            const testimonialCards = gsap.utils.toArray('.testimonial-card');
            if (testimonialCards.length > 0) {
                gsap.from(testimonialCards as Element[],
                    {
                        y: 28,
                        duration: 1,
                        stagger: 0.15,
                        ease: "power3.out",
                        immediateRender: false,
                        scrollTrigger: {
                            trigger: '.testimonials-grid',
                            start: 'top 85%',
                            once: true,
                        }
                    }
                );
            }

            // 11. FAQ items stagger
            const faqItems = gsap.utils.toArray('.faq-item');
            if (faqItems.length > 0) {
                const faqTrigger = document.querySelector('.faq-list') ?? (faqItems[0] as Element).parentElement;
                gsap.from(faqItems as Element[],
                    {
                        y: 18,
                        duration: 0.8,
                        stagger: 0.08,
                        ease: "power3.out",
                        immediateRender: false,
                        scrollTrigger: {
                            trigger: faqTrigger,
                            start: 'top 85%',
                            once: true,
                        }
                    }
                );
            }

            // 12. Highlight/Process grid stagger
            const highlightItems = gsap.utils.toArray('.highlight-item, .process-step');
            if (highlightItems.length > 0) {
                gsap.from(highlightItems as Element[],
                    {
                        y: 24,
                        duration: 0.9,
                        stagger: 0.1,
                        ease: "power3.out",
                        immediateRender: false,
                        scrollTrigger: {
                            trigger: (highlightItems[0] as Element).parentElement,
                            start: 'top 85%',
                            once: true,
                        }
                    }
                );
            }

        } else {
            // Reduced motion: make everything visible immediately
            document.querySelectorAll('.text-reveal').forEach(el => {
                (el as HTMLElement).style.transform = 'none';
            });
            document.querySelectorAll('.scroll-anim').forEach(el => {
                (el as HTMLElement).style.opacity = '1';
                (el as HTMLElement).style.transform = 'none';
            });
            document.querySelectorAll('.service-card, .testimonial-card, .faq-item, .highlight-item, .process-step').forEach(el => {
                (el as HTMLElement).style.opacity = '1';
                (el as HTMLElement).style.transform = 'none';
            });
        }
    </script>
</body>
</html>
