---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import HeadIcons from '../components/HeadIcons.astro';
import MarketingConsent from '../components/MarketingConsent.astro';
import '../styles/main.css';
import '../styles/components.css';
import FontPreloads from '../components/FontPreloads.astro';
import { absoluteUrl, SITE_NAME } from '../../shared/site';
import { cropImage, OG_RATIO } from '../lib/og-image';
import ogFallback from '../assets/lp/aquafacial/hautanalyse-beratung-zuerich.webp';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  preloadImage?: string | {
    href: string;
    imagesrcset?: string;
    imagesizes?: string;
    type?: string;
    fetchpriority?: 'high' | 'low' | 'auto';
  };
  /** A photo (cropped to a 1200×630 JPG at build time) or a ready-made URL. */
  ogImage?: string | ImageMetadata;
  /** Crop focus for ogImage, as CSS object-position (e.g. 'top' for portraits). */
  ogImagePosition?: string;
  navVariant?: 'default' | 'treatment';
  structuredData?: object;
  noindex?: boolean;
  articleDate?: string;
  articleModified?: string;
  /** article:section for articles (the post category). */
  articleSection?: string;
  bodyClass?: string;
}

const {
  title,
  description,
  canonical,
  preloadImage,
  ogImage,
  ogImagePosition = 'center',
  navVariant = 'default',
  structuredData,
  noindex = false,
  articleDate,
  articleModified,
  articleSection,
  bodyClass,
} = Astro.props;
const canonicalUrl = canonical || absoluteUrl(Astro.url.pathname);
// Social previews are 1.91:1. Crop a real 1200×630 JPG from the page's own photo instead of
// declaring a portrait PNG as 1200×630 (Facebook/WhatsApp cropped Teresa's face off).
const ogSource = ogImage ?? ogFallback;
let ogImageUrl: string;
let ogImageSize: { width: number; height: number } | null = null;
if (typeof ogSource === 'string') {
  ogImageUrl = absoluteUrl(ogSource);
} else {
  // Never upscaled: a narrower source keeps the 1.91:1 ratio at its own width.
  const og = await cropImage(ogSource, OG_RATIO, ogImagePosition);
  ogImageUrl = absoluteUrl(og.src);
  ogImageSize = { width: og.width, height: og.height };
}
const isTreatment = navVariant === 'treatment';
const preloadImageLink = typeof preloadImage === 'string' ? { href: preloadImage } : preloadImage;
const pixelId = import.meta.env.PUBLIC_META_PIXEL_ID;
const gtmId = import.meta.env.PUBLIC_GTM_ID;
---

<!DOCTYPE html>
<html lang="de-CH">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <FontPreloads />
    <meta name="facebook-domain-verification" content="61xaasiyh074x1sn3szqej2sf3mzet">

    {/* Critical layout for the fixed nav and page ground; Astro merges it into the page's inline <style>. */}
    <style>
        :root { --nav-h: 104px; --gutter: clamp(16px, 4vw, 40px); }
        html, body { background: #FBF7F2; }
        body { margin: 0; position: relative; overflow-x: hidden; color: #4B3B32; }
        .nav-minimal {
            position: fixed; top: 16px; left: 0; right: 0; z-index: 100;
            width: calc(100% - 2 * var(--gutter)); max-width: 1280px; height: 72px; margin: 0 auto;
            display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
            padding: 0 12px 0 30px; border-radius: 999px; background: rgba(255, 253, 251, 0.9);
        }
        .nav-logo { height: 36px; width: auto; }
        @media (max-width: 900px) {
            :root { --nav-h: 84px; }
            .nav-minimal { top: 10px; height: 64px; padding: 0 8px 0 20px; grid-template-columns: 1fr auto; }
            .nav-logo { height: 32px; }
            .nav-links, .nav-right { display: none; }
        }
    </style>

    <meta name="description" content={description}>
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl}>

    <!-- SEO -->
    {noindex && <meta name="robots" content="noindex, nofollow">}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">}
    <meta name="theme-color" content="#FBF7F2">
    <meta name="geo.region" content="CH-ZH">
    <meta name="geo.placename" content="Zürich">
    <meta name="geo.position" content="47.3760;8.5397">
    <meta name="ICBM" content="47.3760, 8.5397">
    <link rel="alternate" hreflang="de-CH" href={canonicalUrl}>
    <link rel="alternate" hreflang="x-default" href={canonicalUrl}>

    <!-- Open Graph -->
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:type" content={articleDate ? "article" : "website"}>
    <meta property="og:locale" content="de_CH">
    <meta property="og:image" content={ogImageUrl}>
    {ogImageSize && <meta property="og:image:width" content={String(ogImageSize.width)}>}
    {ogImageSize && <meta property="og:image:height" content={String(ogImageSize.height)}>}
    <meta property="og:site_name" content={SITE_NAME}>
    {articleDate && <meta property="article:published_time" content={articleDate}>}
    {articleModified && <meta property="article:modified_time" content={articleModified}>}
    {articleDate && <meta property="article:author" content="Teresa Stimac">}
    {articleSection && <meta property="article:section" content={articleSection}>}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImageUrl}>

    {structuredData && (
        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}

    <!-- Favicon & Manifest -->
    <HeadIcons />

    {preloadImageLink && (
      <link
        rel="preload"
        as="image"
        href={preloadImageLink.href}
        imagesrcset={preloadImageLink.imagesrcset}
        imagesizes={preloadImageLink.imagesizes}
        type={preloadImageLink.type}
        fetchpriority={preloadImageLink.fetchpriority}
      />
    )}
</head>
<body class:list={[bodyClass, isTreatment && 'page-treatment']}>
    <a href="#main-content" class="skip-link">Zum Inhalt springen</a>
    <Nav variant={navVariant} />

    <main id="main-content">
        <slot />
    </main>

    <Footer />
    <MarketingConsent />

    <script is:inline define:vars={{ pixelId, gtmId }}>
        window.bflTrackingConfig = {
            metaPixelId: pixelId || '',
            gtmId: gtmId || ''
        };
    </script>

    <!-- UTM Parameter Persistence -->
    <script is:inline>
        (function() {
            var params = new URLSearchParams(window.location.search);
            var utmKeys = ['utm_id','utm_source','utm_medium','utm_campaign','utm_content','utm_term','utm_source_platform','gclid','gbraid','wbraid','fbclid','matchtype','network','device'];
            var utm = {};
            var hasUtm = false;
            utmKeys.forEach(function(k) {
                var v = params.get(k);
                if (v) { utm[k] = v; hasUtm = true; }
            });
            if (hasUtm) {
                try { sessionStorage.setItem('bfl_utm', JSON.stringify(utm)); } catch(e) {}
            }
        })();
    </script>

    <script>
        import { initPpcTracking } from '../lib/track';
        initPpcTracking();
    </script>

    <!-- Lazy image reveal -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('img[loading="lazy"]').forEach(function(img) {
                img.loading = 'eager';
                if (img.complete) { img.classList.add('loaded'); }
                else { img.addEventListener('load', function() { img.classList.add('loaded'); }); }
            });
        });
    </script>

    <!-- GSAP — cinematic animations -->
    <script>
        import gsap from 'gsap';
        import { ScrollTrigger } from 'gsap/ScrollTrigger';
        gsap.registerPlugin(ScrollTrigger);

        // Respect reduced motion preference
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (!prefersReducedMotion) {
            // Global defaults
            gsap.defaults({ ease: "power4.out" });

            // 1. Hero entrance is pure CSS (.reveal-up in components.css) so it
            // never flashes or depends on the GSAP ticker.


            // 2. Gentle rise for blocks marked .scroll-anim
            gsap.utils.toArray('.scroll-anim').forEach(element => {
                gsap.from(element as Element,
                    {
                        y: 24,
                        duration: 1.1,
                        ease: "expo.out",
                        immediateRender: false,
                        scrollTrigger: {
                            trigger: element as Element,
                            start: 'top 88%',
                            once: true,
                        }
                    }
                );
            });

            // 3. Slow zoom on the treatment hero image while scrolling
            const treatmentHeroImg = document.querySelector('#treatment-hero-img');
            if (treatmentHeroImg) {
                gsap.fromTo(treatmentHeroImg,
                    { scale: 1 },
                    {
                        scale: 1.06,
                        scrollTrigger: {
                            trigger: '.treatment-hero',
                            start: 'top top',
                            end: 'bottom top',
                            scrub: 1
                        }
                    }
                );
            }

            // 4. Footer wordmark entrance
            const footerReveal = document.querySelector('.footer-editorial .text-reveal');
            if (footerReveal) {
                gsap.from(footerReveal,
                    {
                        y: '42%',
                        duration: 1.15,
                        ease: "expo.out",
                        immediateRender: false,
                        scrollTrigger: {
                            trigger: '.footer-editorial',
                            start: 'top 82%',
                            once: true,
                        }
                    }
                );
            }

            // 5. Testimonial stagger
            const testimonialCards = gsap.utils.toArray('.testimonial-card');
            if (testimonialCards.length > 0) {
                gsap.from(testimonialCards as Element[],
                    {
                        y: 28,
                        duration: 1,
                        stagger: 0.15,
                        ease: "power3.out",
                        immediateRender: false,
                        scrollTrigger: {
                            trigger: '.testimonials-grid',
                            start: 'top 85%',
                            once: true,
                        }
                    }
                );
            }

            // 6. FAQ rows stagger
            const faqItems = gsap.utils.toArray('.faq-item');
            if (faqItems.length > 0) {
                const faqTrigger = document.querySelector('.faq-list') ?? (faqItems[0] as Element).parentElement;
                gsap.from(faqItems as Element[],
                    {
                        y: 18,
                        duration: 0.8,
                        stagger: 0.08,
                        ease: "power3.out",
                        immediateRender: false,
                        scrollTrigger: {
                            trigger: faqTrigger,
                            start: 'top 85%',
                            once: true,
                        }
                    }
                );
            }

        } else {
            // Reduced motion: make everything visible immediately
            document.querySelectorAll('.text-reveal').forEach(el => {
                (el as HTMLElement).style.transform = 'none';
            });
            document.querySelectorAll('.scroll-anim').forEach(el => {
                (el as HTMLElement).style.opacity = '1';
                (el as HTMLElement).style.transform = 'none';
            });
            document.querySelectorAll('.testimonial-card, .faq-item').forEach(el => {
                (el as HTMLElement).style.opacity = '1';
                (el as HTMLElement).style.transform = 'none';
            });
        }
    </script>
</body>
</html>
