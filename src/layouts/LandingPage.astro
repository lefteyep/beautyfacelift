---
import '../styles/main.css';
import '../styles/components.css';
import '../styles/booking.css';
import HeadIcons from '../components/HeadIcons.astro';
import MarketingConsent from '../components/MarketingConsent.astro';
import { absoluteUrl, BOOKING_ATTRIBUTION_KEYS, SITE_NAME } from '../../shared/site';

interface PreloadImage {
  href: string;
  imagesrcset?: string;
  imagesizes?: string;
  media?: string;
  type?: string;
  fetchpriority?: 'high' | 'low' | 'auto';
}

interface Props {
  title: string;
  description: string;
  ogDescription?: string;
  ogImage?: string;
  preloadImage?: PreloadImage | PreloadImage[];
}

const { title, description, ogDescription, ogImage, preloadImage } = Astro.props;
const canonicalUrl = absoluteUrl(Astro.url.pathname);
const ogImageUrl = ogImage ? absoluteUrl(ogImage) : absoluteUrl('/assets/hero_editorial_portrait.png');
const socialDescription = ogDescription ?? description;
const pixelId = import.meta.env.PUBLIC_META_PIXEL_ID;
const gtmId = import.meta.env.PUBLIC_GTM_ID;
const attributionKeys = [...BOOKING_ATTRIBUTION_KEYS];
const preloadImages = Array.isArray(preloadImage) ? preloadImage : preloadImage ? [preloadImage] : [];
---

<!DOCTYPE html>
<html lang="de-CH">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <meta name="robots" content="noindex, nofollow">
    <meta name="facebook-domain-verification" content="61xaasiyh074x1sn3szqej2sf3mzet">
    <link rel="canonical" href={canonicalUrl}>
    <title>{title}</title>
    <meta name="theme-color" content="#F7F4EF">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={socialDescription}>
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:type" content="website">
    <meta property="og:locale" content="de_CH">
    <meta property="og:image" content={ogImageUrl}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:site_name" content={SITE_NAME}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={socialDescription}>
    <meta name="twitter:image" content={ogImageUrl}>
    <HeadIcons />
    {preloadImages.map((image) => (
        <link
            rel="preload"
            as="image"
            href={image.href}
            imagesrcset={image.imagesrcset}
            imagesizes={image.imagesizes}
            media={image.media}
            type={image.type}
            fetchpriority={image.fetchpriority}
        />
    ))}
</head>
<body>
    <!-- Minimal masthead: centred monogram only, no menu. Static, scrolls with the page. -->
    <header class="lp-masthead">
        <a href="/" class="lp-masthead-brand">
            <img
                src="/assets/beautyfacelift-zurich-kosmetikstudio-logo.png"
                alt="Beauty Face Lift Zürich"
                width="224"
                height="130"
                decoding="async"
            >
        </a>
    </header>

    <slot />

    <footer class="lp-legal-strip" aria-label="Rechtliches">
        <a href="/impressum/">Impressum</a>
        <a href="/datenschutz/">Datenschutz</a>
        <a href="/kontakt/">Kontakt</a>
        <a href="#cookie-einstellungen" data-bfl-consent-open>Cookie-Einstellungen</a>
    </footer>
    <MarketingConsent />

    <style>
        .lp-masthead {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 88px;
            padding: 16px var(--gutter);
            border-bottom: 1px solid var(--rule);
            background: var(--porcelain);
        }

        .lp-masthead-brand {
            display: inline-flex;
            line-height: 0;
        }

        .lp-masthead-brand img {
            display: block;
            width: auto;
            height: 44px;
        }

        .lp-legal-strip {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 12px 36px;
            padding: 28px var(--gutter) calc(28px + env(safe-area-inset-bottom, 0px));
            border-top: 1px solid var(--rule);
            background: var(--porcelain);
            font-family: var(--f-body);
            font-size: var(--fs-label);
            font-weight: 600;
            letter-spacing: 0.16em;
            line-height: 1.4;
            text-transform: uppercase;
        }

        .lp-legal-strip a {
            padding-block: 6px;
            color: var(--taupe);
            border-bottom: 1px solid transparent;
            transition: color 0.3s ease, border-color 0.3s ease;
        }

        .lp-legal-strip a:hover {
            color: var(--espresso);
            border-bottom-color: currentColor;
        }

        @media (max-width: 900px) {
            .lp-masthead {
                min-height: 64px;
                padding-block: 12px;
            }

            .lp-masthead-brand img {
                height: 36px;
            }

            /* Pages with a fixed bottom bar set --lp-sticky-offer-height on <body>. */
            .lp-legal-strip {
                gap: 8px 24px;
                padding-bottom: calc(28px + var(--lp-sticky-offer-height, 0px) + env(safe-area-inset-bottom, 0px));
            }
        }
    </style>

    <script is:inline define:vars={{ pixelId, gtmId }}>
        window.bflTrackingConfig = {
            metaPixelId: pixelId || '',
            gtmId: gtmId || ''
        };
    </script>

    <!-- UTM Persistence -->
    <script is:inline define:vars={{ attributionKeys }}>
        (function() {
            var params = new URLSearchParams(window.location.search);
            var utmKeys = attributionKeys;
            var utm = {};
            var hasUtm = false;
            utmKeys.forEach(function(k) {
                var v = params.get(k);
                if (v) { utm[k] = v; hasUtm = true; }
            });
            if (hasUtm) {
                try { sessionStorage.setItem('bfl_utm', JSON.stringify(utm)); } catch(e) {}
            }
        })();
    </script>

    <script>
        import { initPpcTracking } from '../lib/track';
        initPpcTracking();
    </script>
</body>
</html>
