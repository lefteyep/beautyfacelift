---
import '../styles/main.css';
import '../styles/components.css';
import '../styles/booking.css';
import HeadIcons from '../components/HeadIcons.astro';
import MarketingConsent from '../components/MarketingConsent.astro';
import { absoluteUrl, SITE_NAME } from '../../shared/site';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  preloadImage?: {
    href: string;
    imagesrcset?: string;
    imagesizes?: string;
    type?: string;
    fetchpriority?: 'high' | 'low' | 'auto';
  };
}

const { title, description, ogImage, preloadImage } = Astro.props;
const canonicalUrl = absoluteUrl(Astro.url.pathname);
const ogImageUrl = ogImage ? absoluteUrl(ogImage) : absoluteUrl('/assets/hero_editorial_portrait.png');
const pixelId = import.meta.env.PUBLIC_META_PIXEL_ID;
const gtmId = import.meta.env.PUBLIC_GTM_ID;
---

<!DOCTYPE html>
<html lang="de-CH">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <meta name="robots" content="noindex, nofollow">
    <meta name="facebook-domain-verification" content="61xaasiyh074x1sn3szqej2sf3mzet">
    <link rel="canonical" href={canonicalUrl}>
    <title>{title}</title>
    <meta name="theme-color" content="#B98F47">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:type" content="website">
    <meta property="og:locale" content="de_CH">
    <meta property="og:image" content={ogImageUrl}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:site_name" content={SITE_NAME}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImageUrl}>
    <HeadIcons />
    {preloadImage && (
        <link
            rel="preload"
            as="image"
            href={preloadImage.href}
            imagesrcset={preloadImage.imagesrcset}
            imagesizes={preloadImage.imagesizes}
            type={preloadImage.type}
            fetchpriority={preloadImage.fetchpriority}
        />
    )}
</head>
<body>
    <!-- Minimal Nav: Logo only — static in document flow (scrolls with page) -->
    <nav class="nav-minimal nav-minimal--lp">
        <a href="/" class="nav-minimal-brand">
            <img src="/assets/beautyfacelift-zurich-kosmetikstudio-logo.png" alt="Beauty Face Lift Zürich">
        </a>
    </nav>

    <slot />

    <footer class="lp-legal-strip" aria-label="Rechtliches">
        <a href="/impressum/">Impressum</a>
        <a href="/datenschutz/">Datenschutz</a>
        <a href="/kontakt/">Kontakt</a>
    </footer>
    <MarketingConsent />

    <style>
        .nav-minimal--lp {
            position: static;
            width: 100%;
            padding: 1.5rem 2rem;
            display: flex;
            justify-content: flex-start;
            align-items: center;
            background: transparent;
            color: var(--text-primary);
            mix-blend-mode: normal;
        }
        .nav-minimal-brand {
            display: inline-flex;
            text-decoration: none;
            pointer-events: auto;
        }
        .nav-minimal-brand img {
            height: 40px;
            width: auto;
            display: block;
        }
        .lp-legal-strip {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 1rem;
            padding: 1.5rem 2rem calc(1.5rem + env(safe-area-inset-bottom, 0px));
            border-top: 1px solid var(--border-subtle);
            color: var(--text-muted);
            font-size: 0.9rem;
        }
        .lp-legal-strip a {
            color: inherit;
            text-decoration: underline;
            text-underline-offset: 3px;
        }
        .lp-legal-strip a:hover {
            color: var(--accent-text);
        }
        @media (max-width: 900px) {
            .nav-minimal--lp {
                justify-content: center;
                padding: 1.25rem 1.5rem;
            }
            .nav-minimal-brand img {
                height: 36px;
            }
            .lp-legal-strip {
                padding-bottom: calc(1.5rem + var(--lp-sticky-offer-height, 78px) + env(safe-area-inset-bottom, 0px));
            }
        }
    </style>

    <script is:inline define:vars={{ pixelId, gtmId }}>
        window.bflTrackingConfig = {
            metaPixelId: pixelId || '',
            gtmId: gtmId || ''
        };
    </script>

    <!-- UTM Persistence -->
    <script is:inline>
        (function() {
            var params = new URLSearchParams(window.location.search);
            var utmKeys = ['utm_id','utm_source','utm_medium','utm_campaign','utm_content','utm_term','utm_source_platform','gclid','gbraid','wbraid','fbclid','matchtype','network','device'];
            var utm = {};
            var hasUtm = false;
            utmKeys.forEach(function(k) {
                var v = params.get(k);
                if (v) { utm[k] = v; hasUtm = true; }
            });
            if (hasUtm) {
                try { sessionStorage.setItem('bfl_utm', JSON.stringify(utm)); } catch(e) {}
            }
        })();
    </script>

    <script>
        import { initPpcTracking } from '../lib/track';
        initPpcTracking();
    </script>
</body>
</html>
