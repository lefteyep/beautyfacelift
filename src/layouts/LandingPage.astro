---
import '../styles/main.css';
import '../styles/components.css';
import '../styles/booking.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const pixelId = import.meta.env.PUBLIC_META_PIXEL_ID;
const pixelNoscriptHtml = pixelId
    ? `<img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=${pixelId}&amp;ev=PageView&amp;noscript=1" />`
    : '';
---

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <meta name="robots" content="noindex, nofollow">
    <title>{title}</title>
    <meta name="theme-color" content="#CFA65E">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    {pixelId && (
        <script is:inline define:vars={{ pixelId }}>
            !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
            n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
            n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
            t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
            document,'script','https://connect.facebook.net/en_US/fbevents.js');
            fbq('init', pixelId);
        </script>
    )}
    {pixelId && <noscript set:html={pixelNoscriptHtml}></noscript>}
</head>
<body>
    <!-- Minimal Nav: Logo only -->
    <nav class="nav-minimal" style="mix-blend-mode: normal; color: var(--text-primary); padding-top: 2vw;">
        <a href="/" style="text-decoration: none; pointer-events: auto;">
            <img src="/assets/beautyfacelift-zurich-kosmetikstudio-logo.png" alt="Beauty Face Lift Zürich" style="height: 40px; width: auto;">
        </a>
    </nav>

    <slot />

    <!-- UTM Persistence -->
    <script is:inline>
        (function() {
            var params = new URLSearchParams(window.location.search);
            var utmKeys = ['utm_source','utm_medium','utm_campaign','utm_content','utm_term','gclid','fbclid'];
            var utm = {};
            var hasUtm = false;
            utmKeys.forEach(function(k) {
                var v = params.get(k);
                if (v) { utm[k] = v; hasUtm = true; }
            });
            if (hasUtm) {
                try { sessionStorage.setItem('bfl_utm', JSON.stringify(utm)); } catch(e) {}
            }
        })();
    </script>
</body>
</html>
