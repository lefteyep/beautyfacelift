---
import '../styles/main.css';
import '../styles/components.css';
import '../styles/booking.css';
import HeadIcons from '../components/HeadIcons.astro';
import { absoluteUrl } from '../../shared/site';

interface Props {
  title: string;
  description: string;
  preloadImage?: {
    href: string;
    imagesrcset?: string;
    imagesizes?: string;
    type?: string;
    fetchpriority?: 'high' | 'low' | 'auto';
  };
}

const { title, description, preloadImage } = Astro.props;
const canonicalUrl = absoluteUrl(Astro.url.pathname);
const pixelId = import.meta.env.PUBLIC_META_PIXEL_ID;
const pixelNoscriptHtml = pixelId
    ? `<img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=${pixelId}&amp;ev=PageView&amp;noscript=1" />`
    : '';
---

<!DOCTYPE html>
<html lang="de-CH">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <meta name="robots" content="noindex, nofollow">
    <link rel="canonical" href={canonicalUrl}>
    <title>{title}</title>
    <meta name="theme-color" content="#B98F47">
    <HeadIcons />
    {preloadImage && (
        <link
            rel="preload"
            as="image"
            href={preloadImage.href}
            imagesrcset={preloadImage.imagesrcset}
            imagesizes={preloadImage.imagesizes}
            type={preloadImage.type}
            fetchpriority={preloadImage.fetchpriority}
        />
    )}
    {pixelId && (
        <script is:inline define:vars={{ pixelId }}>
            !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
            n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
            n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
            t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
            document,'script','https://connect.facebook.net/en_US/fbevents.js');
            fbq('init', pixelId);
        </script>
    )}
    {pixelId && <noscript set:html={pixelNoscriptHtml}></noscript>}
</head>
<body>
    <!-- Minimal Nav: Logo only — static in document flow (scrolls with page) -->
    <nav class="nav-minimal nav-minimal--lp">
        <a href="/" class="nav-minimal-brand">
            <img src="/assets/beautyfacelift-zurich-kosmetikstudio-logo.png" alt="Beauty Face Lift Zürich">
        </a>
    </nav>

    <slot />

    <style>
        .nav-minimal--lp {
            position: static;
            width: 100%;
            padding: 1.5rem 2rem;
            display: flex;
            justify-content: flex-start;
            align-items: center;
            background: transparent;
            color: var(--text-primary);
            mix-blend-mode: normal;
        }
        .nav-minimal-brand {
            display: inline-flex;
            text-decoration: none;
            pointer-events: auto;
        }
        .nav-minimal-brand img {
            height: 40px;
            width: auto;
            display: block;
        }
        @media (max-width: 900px) {
            .nav-minimal--lp {
                justify-content: center;
                padding: 1.25rem 1.5rem;
            }
            .nav-minimal-brand img {
                height: 36px;
            }
        }
    </style>

    <!-- UTM Persistence -->
    <script is:inline>
        (function() {
            var params = new URLSearchParams(window.location.search);
            var utmKeys = ['utm_source','utm_medium','utm_campaign','utm_content','utm_term','gclid','fbclid'];
            var utm = {};
            var hasUtm = false;
            utmKeys.forEach(function(k) {
                var v = params.get(k);
                if (v) { utm[k] = v; hasUtm = true; }
            });
            if (hasUtm) {
                try { sessionStorage.setItem('bfl_utm', JSON.stringify(utm)); } catch(e) {}
            }
        })();
    </script>
</body>
</html>
