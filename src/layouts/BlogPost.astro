---
// Journal article layout. Each article keeps its own <title>, description,
// canonical and JSON-LD (passed through unchanged); presentation metadata
// (category, date, reading time, lead image) comes from pages/blog/_posts.ts.
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { Image } from 'astro:assets';
import { teresaPortrait } from '../lib/site-images';
import { formatJournalDate, getJournalPost } from '../pages/blog/_posts';
import '../styles/blog.css';

interface RelatedLink {
    href: string;
    title: string;
    text: string;
}

interface Props {
    slug: string;
    pageTitle: string;
    description: string;
    canonical?: string;
    structuredData: object;
    breadcrumbLabel: string;
    title: string;
    lead?: string;
    related: RelatedLink[];
    cta: {
        /** Trusted markup: may contain one <em> accent word. */
        title: string;
        text: string;
        label: string;
    };
}

const {
    slug,
    pageTitle,
    description,
    canonical,
    structuredData,
    breadcrumbLabel,
    title,
    lead,
    related,
    cta,
} = Astro.props;

const post = getJournalPost(slug);
const dateLabel = formatJournalDate(post.publishDate);
const leadImageSizes = '(min-width: 1024px) 880px, 100vw';

const breadcrumbs = [
    { label: 'Home', href: '/' },
    { label: 'Blog', href: '/blog/' },
    { label: breadcrumbLabel },
];
---

<Base
    title={pageTitle}
    description={description}
    canonical={canonical}
    structuredData={structuredData}
>
    <article class="journal-article">
        <header class="journal-header">
            <div class="container container--narrow">
                <Breadcrumbs items={breadcrumbs} />
                <div class="journal-header-copy">
                    <p class="eyebrow eyebrow--rule reveal-up">{post.category}</p>
                    <h1 class="journal-title reveal-up">{title}</h1>
                    {lead && <p class="lead journal-lead reveal-up">{lead}</p>}
                </div>
                <p class="journal-byline">
                    <span>Von Teresa Stimac</span>
                    <span class="journal-byline-meta">
                        <time datetime={post.publishDate}>{dateLabel}</time>
                        <span>{post.readingTime} Lesezeit</span>
                    </span>
                </p>
            </div>
            <figure class="container container--narrow journal-figure reveal-media">
                <div class="media journal-lead-image">
                    <Image
                        src={post.image}
                        widths={[480, 720, 960, 1320, 1760]}
                        sizes={leadImageSizes}
                        format="webp"
                        quality="high"
                        alt={post.imageAlt}
                        priority
                    />
                </div>
            </figure>
        </header>

        <div class="container container--text">
            <div class="blog-article">
                <slot />
            </div>

            <aside class="journal-author" aria-label="Über die Autorin">
                <div class="media journal-author-portrait">
                    <Image
                        src={teresaPortrait}
                        widths={[160, 240, 320]}
                        sizes="120px"
                        format="webp"
                        quality="high"
                        alt="Teresa Stimac, Gründerin von Beauty Face Lift Zürich"
                        loading="lazy"
                    />
                </div>
                <div class="journal-author-copy">
                    <p class="label">Über die Autorin</p>
                    <slot name="author-bio" />
                    <a href="/ueber-mich/" class="btn-link">Mehr über Teresa</a>
                </div>
            </aside>
        </div>
    </article>

    <section class="section section--tight journal-related" aria-labelledby="journal-related-title">
        <div class="container container--narrow">
            <div class="section-head">
                <div>
                    <p class="eyebrow eyebrow--rule">Weiterlesen</p>
                    <h2 id="journal-related-title">Passend zu diesem <em>Beitrag</em></h2>
                </div>
                <a href="/blog/" class="btn-link">Alle Beiträge</a>
            </div>
            <ul class="index-list journal-related-list">
                {related.map((item) => (
                    <li>
                        <a href={item.href} class="index-item">
                            <h3 class="index-item-title">{item.title}</h3>
                            <p class="index-item-text">{item.text}</p>
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <section class="cta-band" aria-labelledby="journal-cta-title">
        <div class="cta-band-inner">
            <div>
                <p class="eyebrow eyebrow--rule">Termin</p>
                <h2 id="journal-cta-title" set:html={cta.title} />
                <p>{cta.text}</p>
            </div>
            <div class="btn-row">
                <a href="/termin/" class="btn" data-button-location="blog_article_cta">{cta.label}</a>
                <a href="/kontakt/" class="btn-link">Persönlich beraten lassen</a>
            </div>
        </div>
    </section>
</Base>
