---
import { absoluteUrl, TREATWELL_URL } from '../../../shared/site';

import Base from '../../layouts/Base.astro';
import { Image, getImage } from 'astro:assets';
import { spaInterior, spaProducts, teresaPortrait } from '../../lib/site-images';

const aboutImageSizes = '(min-width: 1320px) 520px, (min-width: 901px) 38vw, 100vw';
const editorialImageSizes = '(min-width: 1320px) 560px, (min-width: 901px) 42vw, 100vw';
const aboutTeresaPreload = await getImage({
    src: teresaPortrait,
    widths: [360, 540, 720, 960, 1023],
    sizes: aboutImageSizes,
    format: 'webp',
    quality: 'high',
});

const values = [
    {
        title: 'Expertise',
        text: 'Seit über zwei Jahrzehnten selbstständige Kosmetikerin in Zürich, mit tausenden Behandlungen, die Teresa persönlich durchgeführt hat.',
    },
    {
        title: 'Vertrauen',
        text: 'Eine treue Stammkundschaft, einige Kundinnen begleitet Teresa seit 2008. Sie kennt die Geschichte jeder Haut und geht sorgfältig auf Veränderungen ein.',
    },
    {
        title: 'Innovation',
        text: 'Regelmässige Weiterbildung in neuen Methoden, von Aquafacial über Microneedling bis ColdPlasma, mit modernen Geräten und hochwertigen Produkten.',
    },
    {
        title: 'Leidenschaft',
        text: 'Jede Behandlung führt Teresa selbst durch. Keine Assistenten, keine Delegation, sondern volle Aufmerksamkeit für Ihre Haut.',
    },
];

const testimonials = [
    { quote: 'Wie immer eine wunderbare Verwöhnzeit!', author: 'Emina', detail: 'Stammkundin' },
    { quote: 'Seit 2008 bei Teresa, absolute Vertrauenssache. Professionell, ehrlich und immer auf dem neuesten Stand.', author: 'Daniel', detail: 'Stammkunde seit 2008' },
    { quote: 'Teresas Charme und Professionalität machen jeden Besuch besonders. Man fühlt sich sofort wohl und bestens aufgehoben.', author: 'Andreas', detail: 'Verifizierter Kunde' },
];

const structuredData = {
    "@context": "https://schema.org",
    "@type": "BeautySalon",
    "name": "Beauty Face Lift Zürich",
    "url": absoluteUrl('/'),
    "address": {
        "@type": "PostalAddress",
        "streetAddress": "Bahnhofstrasse 94",
        "addressLocality": "Zürich",
        "postalCode": "8001",
        "addressCountry": "CH"
    },
    "areaServed": [
        "Zürich",
        "Switzerland"
    ],
    "founder": {
        "@type": "Person",
        "name": "Teresa Stimac",
        "image": absoluteUrl('/assets/teresa_portrait.jpg'),
        "jobTitle": "Gründerin & Kosmetikerin",
        "description": "Selbstständige Kosmetikerin mit über 20 Jahren Erfahrung in Zürich",
        "knowsAbout": ["Aquafacial", "Microneedling", "Fruchtsäure Peeling", "ColdPlasma", "Hautpflege", "Anti-Aging"],
        "worksFor": {
            "@type": "BeautySalon",
            "name": "Beauty Face Lift Zürich"
        }
    },
};
---

<Base
    title="Über mich | Beauty Face Lift — Teresa Stimac, Kosmetikerin Zürich"
    description="Lernen Sie Teresa Stimac kennen — seit über 20 Jahren selbstständige Kosmetikerin in Zürich. 4.8 Sterne bei 248+ Bewertungen. Ihr Premium Kosmetikinstitut an der Bahnhofstrasse 94."
    preloadImage={{
        href: aboutTeresaPreload.src,
        imagesrcset: aboutTeresaPreload.srcSet.attribute,
        imagesizes: aboutImageSizes,
        type: 'image/webp',
        fetchpriority: 'high',
    }}
    ogImage={absoluteUrl('/assets/teresa_portrait.jpg')}
    structuredData={structuredData}
>
    <!-- 1 · Portrait hero -->
    <header class="page-hero page-hero--split about-hero">
        <div class="container page-hero-inner">
            <div class="page-hero-copy about-hero-copy">
                <p class="eyebrow eyebrow--rule reveal-up">Teresa Stimac</p>
                <h1 class="reveal-up reveal-d1">Über mich und meine <em>Leidenschaft</em> für Ihre Haut</h1>
                <p class="lead reveal-up reveal-d2">Gründerin und Kosmetikerin von Beauty Face Lift an der Bahnhofstrasse 94, seit über 20 Jahren selbstständig in Zürich. Jede Behandlung führt Teresa persönlich durch.</p>
                <div class="btn-row reveal-up reveal-d3">
                    <a href="/termin/" class="btn" data-button-location="about_hero">Termin bei Teresa buchen</a>
                    <a href="/behandlungen/" class="btn-link">Behandlungen ansehen</a>
                </div>
            </div>
            <figure class="media-figure about-hero-media reveal-media">
                <div class="media media--portrait about-hero-frame">
                    <Image
                        src={teresaPortrait}
                        widths={[360, 540, 720, 960, 1023]}
                        sizes={aboutImageSizes}
                        format="webp"
                        quality="high"
                        alt="Teresa Stimac, Gründerin von Beauty Face Lift Zürich"
                        priority
                    />
                </div>
                <figcaption>Teresa Stimac im Studio an der Bahnhofstrasse 94</figcaption>
            </figure>
        </div>
    </header>

    <!-- 2 · The founder -->
    <section class="section section--rule" aria-labelledby="founder-title">
        <div class="container about-founder">
            <div class="about-founder-head">
                <p class="eyebrow eyebrow--rule">Die Gründerin</p>
                <h2 id="founder-title">Vertrauen, über viele Jahre <em>gewachsen</em></h2>
            </div>
            <div class="about-founder-body">
                <p class="lead">Seit über 20 Jahren ist Teresa Stimac als selbstständige Kosmetikerin in Zürich tätig. Eine treue, langjährige Stammkundschaft verlässt sich auf ihre Erfahrung, einige Kundinnen begleitet sie seit 2008.</p>
                <p>In dieser Zeit hat Teresa tausende Behandlungen persönlich durchgeführt, jede mit voller Aufmerksamkeit. An der Bahnhofstrasse 94 hat sie mit Beauty Face Lift einen ruhigen Ort geschaffen, der moderne Behandlungsmethoden mit persönlicher, ehrlicher Beratung verbindet. Ihr Anspruch ist von Beginn an derselbe: Kundinnen und Kunden zu einem strahlenden, selbstbewussten Hautbild zu begleiten, mit Behandlungen, deren Ergebnis man sieht und spürt.</p>
                <dl class="facts about-facts">
                    <div><dt>Erfahrung</dt><dd>Über 20 Jahre selbstständig in Zürich</dd></div>
                    <div><dt>Stammkundschaft</dt><dd>Einige Kundinnen begleitet Teresa seit 2008</dd></div>
                    <div><dt>Behandlung</dt><dd>Jeder Termin persönlich durch Teresa, ohne Delegation</dd></div>
                    <div><dt>Weiterbildung</dt><dd>Regelmässig in neuen Methoden und Technologien</dd></div>
                    <div><dt>Bewertungen</dt><dd><a href={TREATWELL_URL} target="_blank" rel="noopener">4,8 von 5 aus 248+ Bewertungen auf Treatwell</a></dd></div>
                </dl>
            </div>
        </div>
    </section>

    <!-- 3 · Philosophy -->
    <section class="section section--ivory" aria-labelledby="philosophy-title">
        <div class="container about-split">
            <figure class="media-figure about-split-media scroll-anim">
                <div class="media media--portrait">
                    <Image
                        src={spaProducts}
                        widths={[360, 540, 720, 960]}
                        sizes={editorialImageSizes}
                        format="webp"
                        quality="high"
                        alt="Hochwertige Pflegeseren, persönlich von Teresa ausgewählt"
                        loading="lazy"
                    />
                </div>
            </figure>
            <div class="about-split-copy">
                <p class="eyebrow eyebrow--rule">Philosophie</p>
                <h2 id="philosophy-title">Nur das <em>Beste</em> ist gut genug</h2>
                <p>Teresa verwendet ausschliesslich Produkte, deren Eigenschaften und Rezepturen sie persönlich kennt und selbst anwendet. Was sie nicht an ihrer eigenen Haut getestet hat, kommt nicht an Ihre. Ein einfaches Prinzip, das seit über zwei Jahrzehnten den Unterschied macht.</p>
                <p>Jede Behandlung wird von Teresa persönlich durchgeführt. Wenn Sie bei Beauty Face Lift einen Termin buchen, behandelt Sie die Gründerin selbst. Das ist kein Zufall, sondern Überzeugung: Nur wer eine Haut kennt, kann sie wirklich gut behandeln. Diese Haltung hat Teresa die Treue ihrer Kundinnen über viele Jahre gesichert.</p>
                <a href="/behandlungen/" class="btn-link">Behandlungen ansehen</a>
            </div>
        </div>
    </section>

    <!-- 4 · Values -->
    <section class="section" aria-labelledby="values-title">
        <div class="container">
            <div class="section-head">
                <div>
                    <p class="eyebrow eyebrow--rule">Was Teresa auszeichnet</p>
                    <h2 id="values-title">Vier Werte, ein <em>Anspruch</em></h2>
                </div>
            </div>
            <ul class="index-grid about-values">
                {values.map((value) => (
                    <li class="scroll-anim">
                        <h3>{value.title}</h3>
                        <p>{value.text}</p>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <!-- 5 · Studio -->
    <section class="section section--sand" aria-labelledby="studio-title">
        <div class="container about-split about-split--reverse">
            <figure class="media-figure about-split-media scroll-anim">
                <div class="media media--portrait">
                    <Image
                        src={spaInterior}
                        widths={[360, 540, 720, 960]}
                        sizes={editorialImageSizes}
                        format="webp"
                        quality="high"
                        alt="Ruhiger Behandlungsraum mit Liege, Leinen und warmem Licht"
                        loading="lazy"
                    />
                </div>
            </figure>
            <div class="about-split-copy">
                <p class="eyebrow eyebrow--rule">Das Studio</p>
                <h2 id="studio-title">Bahnhofstrasse 94, <em>Zürich</em></h2>
                <p>Im Herzen von Zürich, an einer der bekanntesten Adressen der Stadt, liegt das Studio von Beauty Face Lift. Ein Ort der Ruhe, ausgestattet mit modernen Technologien und einer Atmosphäre, in der Sie den Alltag für eine Weile hinter sich lassen.</p>
                <p>Ob Aquafacial, Microneedling, Fruchtsäure Peeling oder ColdPlasma: Jede Behandlung wird individuell auf Ihren Hauttyp und Ihre Wünsche abgestimmt. Diskret gelegen, wenige Schritte vom Paradeplatz und leicht erreichbar.</p>
                <a href="/behandlungen/vergleich/" class="btn-link">Behandlungen vergleichen</a>
            </div>
        </div>
    </section>

    <!-- 6 · Testimonials -->
    <section class="section" aria-labelledby="voices-title">
        <div class="container">
            <div class="section-head">
                <div>
                    <p class="eyebrow eyebrow--rule">Kundenstimmen</p>
                    <h2 id="voices-title">Vertrauen, das man <em>spürt</em></h2>
                    <p class="caption">4,8 von 5 aus 248+ Bewertungen auf Treatwell</p>
                </div>
                <a href={TREATWELL_URL} class="btn-link" target="_blank" rel="noopener">Bewertungen ansehen</a>
            </div>
            <div class="about-quotes">
                {testimonials.map((item) => (
                    <figure class="quote about-quote scroll-anim">
                        <blockquote>„{item.quote}“</blockquote>
                        <figcaption>{item.author} · {item.detail}</figcaption>
                    </figure>
                ))}
            </div>
        </div>
    </section>

    <!-- 7 · Closing CTA -->
    <section class="cta-band" aria-labelledby="about-cta-title">
        <div class="cta-band-inner">
            <div>
                <p class="eyebrow eyebrow--rule">Termin</p>
                <h2 id="about-cta-title">Bereit für Ihr neues <em>Hautbild</em>?</h2>
                <p>Vereinbaren Sie Ihren persönlichen Termin bei Teresa, unkompliziert und in wenigen Klicks.</p>
            </div>
            <div class="btn-row">
                <a href="/termin/" class="btn" data-button-location="about_cta_band">Jetzt Termin buchen</a>
                <a href="/kontakt/" class="btn-link">Kontakt aufnehmen</a>
            </div>
        </div>
    </section>
</Base>

<style>
    /* Hero — portrait above the fold */
    .about-hero {
        padding-top: calc(var(--nav-h) + clamp(32px, 5vw, 80px));
    }

    .about-hero .page-hero-inner {
        grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
        align-items: end;
    }

    .about-hero-copy {
        padding-bottom: clamp(0px, 3vw, 48px);
    }

    .about-hero h1 {
        max-width: 13ch;
        font-size: clamp(2.6rem, 5.6vw, 5.25rem);
        line-height: 1;
    }

    .about-hero .btn-row {
        margin-top: 8px;
    }

    .about-hero-frame :global(img) {
        object-position: 50% 20%;
    }

    .reveal-d1 { --d: 1; }
    .reveal-d2 { --d: 2; }
    .reveal-d3 { --d: 3; }

    /* Founder */
    .about-founder {
        display: grid;
        grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        gap: clamp(40px, 7vw, 120px);
        align-items: start;
    }

    .about-founder-head {
        display: grid;
        gap: 20px;
        position: sticky;
        top: calc(var(--nav-h) + 40px);
    }

    .about-founder-head h2 {
        max-width: 14ch;
    }

    .about-founder-body {
        display: grid;
        gap: 28px;
    }

    .about-founder-body .lead {
        max-width: 56ch;
    }

    .about-facts {
        margin-top: 12px;
    }

    .about-facts a {
        border-bottom: 1px solid var(--rule-strong);
        transition: color 0.3s ease, border-color 0.3s ease;
    }

    .about-facts a:hover {
        color: var(--bronze);
        border-color: currentColor;
    }

    /* Editorial split (philosophy, studio) */
    .about-split {
        display: grid;
        grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
        gap: clamp(40px, 7vw, 120px);
        align-items: center;
    }

    .about-split--reverse .about-split-media {
        order: 2;
    }

    .about-split-copy {
        display: grid;
        gap: 24px;
        justify-items: start;
    }

    .about-split-copy h2 {
        max-width: 14ch;
        margin-bottom: 4px;
    }

    .about-split-copy .btn-link {
        margin-top: 12px;
    }

    /* Values — four columns, never an orphan */
    .about-values {
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    /* Testimonials */
    .about-quotes {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        column-gap: clamp(24px, 4vw, 64px);
    }

    .about-quote {
        align-content: space-between;
        padding-top: 28px;
        border-top: 1px solid var(--rule-strong);
    }

    .about-quote blockquote {
        font-size: clamp(1.35rem, 1.9vw, 1.7rem);
        line-height: 1.32;
    }

    .section-head .caption {
        margin-top: 4px;
    }

    /* Keep the link at its natural width when .section-head stacks on mobile */
    .section-head > .btn-link {
        justify-self: start;
    }

    @media (max-width: 1100px) {
        .about-values {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 900px) {
        .about-hero {
            padding-top: calc(var(--nav-h) + 12px);
        }

        .about-hero .page-hero-inner {
            grid-template-columns: minmax(0, 1fr);
            gap: 28px;
        }

        .about-hero-media {
            order: -1;
            margin-inline: calc(-1 * var(--gutter));
        }

        .about-hero-media figcaption {
            padding-inline: var(--gutter);
        }

        .about-hero-frame {
            aspect-ratio: 1 / 1;
        }

        .about-hero h1 {
            max-width: 15ch;
        }

        .about-founder,
        .about-split,
        .about-quotes {
            grid-template-columns: minmax(0, 1fr);
        }

        .about-founder-head {
            position: static;
        }

        .about-split--reverse .about-split-media {
            order: 0;
        }

        .about-split-media .media {
            aspect-ratio: 4 / 3;
        }

        .about-quotes {
            row-gap: 40px;
        }
    }

    @media (max-width: 600px) {
        .about-values {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
