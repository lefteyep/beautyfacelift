---
// Swiss Quiet Luxury — internal design-system reference (noindex, unlinked).
// Standalone document (no Nav/Footer/tracking) that renders the live site CSS,
// so every specimen below is the real component, not a copy.
// Source of truth: src/styles/main.css + src/styles/components.css and
// docs/superpowers/specs/2026-10-06-luxury-redesign-design.md.
import { absoluteUrl } from '../../../shared/site';
import '../../styles/main.css';
import '../../styles/components.css';
import '../../styles/kontakt.css';

const colours = [
    { token: '--porcelain', hex: '#F7F4EF', role: 'Seitenhintergrund', dark: false },
    { token: '--ivory', hex: '#FBF9F5', role: 'Erhöhte Flächen, Eingabefelder', dark: false },
    { token: '--sand', hex: '#ECE4D8', role: 'Alternierendes Sektionsband', dark: false },
    { token: '--stone', hex: '#CFC4B4', role: 'Kräftige Linien, Bild-Platzhalter', dark: false },
    { token: '--espresso', hex: '#171411', role: 'Primärtext, Primär-Button, dunkle Bänder, Footer', dark: true },
    { token: '--umber', hex: '#3A332C', role: 'Fliesstext (11.3:1 auf Porcelain)', dark: true },
    { token: '--taupe', hex: '#6B6258', role: 'Gedämpfter Text, Captions (≥ 4.7:1)', dark: true },
    { token: '--bronze', hex: '#7A5C34', role: 'Akzent-Text, Eyebrows, aktive Zustände (≥ 4.89:1)', dark: true },
    { token: '--bronze-light', hex: '#C2A475', role: 'Akzent auf Espresso (7.7:1), Haarlinien-Highlights', dark: false },
    { token: '--champagne', hex: '#D9C6A5', role: 'Gedämpfter Text auf Espresso', dark: false },
];

const typeScale = [
    { token: '--fs-display', size: 'clamp(3rem, 7vw, 6.25rem)', use: 'Homepage-H1', className: 'ds-type-display', sample: 'Bahnhofstrasse' },
    { token: '--fs-h1', size: 'clamp(2.6rem, 5.2vw, 4.75rem)', use: 'Seiten-H1', className: 'ds-type-h1', sample: 'Über mich' },
    { token: '--fs-h2', size: 'clamp(2rem, 3.6vw, 3.25rem)', use: 'Sektionstitel', className: 'ds-type-h2', sample: 'Zeit für Ihre Haut' },
    { token: '--fs-h3', size: 'clamp(1.4rem, 1.9vw, 1.75rem)', use: 'Unterzeilen, Listentitel', className: 'ds-type-h3', sample: 'Aquafacial' },
    { token: '--fs-h4', size: 'clamp(1.15rem, 1.3vw, 1.3rem)', use: 'Kleine Titel, FAQ-Gruppen', className: 'ds-type-h4', sample: 'Beratung & Hautanalyse' },
    { token: '--fs-lead', size: 'clamp(1.125rem, 1.4vw, 1.3rem)', use: 'Einleitungen', className: 'ds-type-lead', sample: 'Persönlich abgestimmt von Teresa Stimac.' },
    { token: '--fs-body', size: '1.0625rem · 1.7', use: 'Fliesstext, max. 66ch', className: 'ds-type-body', sample: 'Jede Behandlung beginnt mit einem Gespräch.' },
    { token: '--fs-small', size: '0.9rem', use: 'Captions, Meta', className: 'ds-type-small', sample: 'Teresa Stimac im Studio an der Bahnhofstrasse 94' },
    { token: '--fs-label', size: '0.75rem · 600 · 0.18em', use: 'Eyebrows, Buttons, Navigation', className: 'ds-type-label', sample: 'Termin buchen' },
];

const layoutTokens = [
    { label: 'Container', value: '--container: 1320px · --gutter: clamp(20px, 5vw, 72px)' },
    { label: 'Sektionen', value: '--section-y: clamp(88px, 11vw, 168px) · tight: clamp(56px, 7vw, 104px)' },
    { label: 'Ecken', value: '0 auf Bildern, Buttons, Bändern · 2px nur auf Eingabefeldern · keine Pills' },
    { label: 'Tiefe', value: 'Keine Schatten · --shadow-float nur für Nav-Dropdown und Consent-Banner' },
    { label: 'Linien', value: '--rule rgba(23,20,17,.12) · --rule-strong .24 · auf Dunkel --rule-light' },
    { label: 'Bewegung', value: '≤ 24px Versatz, 0.9–1.2s expo · Bild-Hover scale 1.03 · reduced motion respektiert' },
];
---

<!DOCTYPE html>
<html lang="de-CH">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <meta name="facebook-domain-verification" content="61xaasiyh074x1sn3szqej2sf3mzet">
    <meta name="theme-color" content="#F7F4EF">
    <title>Design System — Beauty Face Lift</title>
    <link rel="canonical" href={absoluteUrl('/admin/design-system/')}>
</head>
<body>
    <main class="ds">
        <!-- Masthead -->
        <header class="container ds-masthead">
            <p class="eyebrow eyebrow--rule">Design System · Swiss Quiet Luxury · 2026</p>
            <h1 class="display">Ruhe, Linie, <em>Licht</em></h1>
            <p class="lead">Interne Referenz für beautyfacelift-zuerich.ch. Typografie, Weissraum, echte Fotografie und Haarlinien tragen den Luxus; Bronze ist Detail, nicht Fläche. Alle Muster auf dieser Seite sind die echten Komponenten aus <code>main.css</code> und <code>components.css</code>.</p>
            <ul class="index-grid ds-principles">
                <li>
                    <h3>Zurückhaltung</h3>
                    <p>Bodoni Moda für Überschriften, Instrument Sans für Text. Eine kursive Akzentzeile pro Überschrift, nie mehr.</p>
                </li>
                <li>
                    <h3>Haarlinien</h3>
                    <p>Keine Karten, keine runden Ecken, keine Schatten. Linien und Weissraum gliedern.</p>
                </li>
                <li>
                    <h3>Echte Bilder</h3>
                    <p>Bestehende Fotografie, nie erfunden. Teresa im Studio vor Stimmungsbildern.</p>
                </li>
            </ul>
        </header>

        <!-- 01 Typography -->
        <section class="section section--rule" aria-labelledby="ds-type">
            <div class="container">
                <div class="section-head">
                    <div>
                        <p class="eyebrow eyebrow--rule">Typografie</p>
                        <h2 id="ds-type">Zwei Stimmen, eine <em>Haltung</em></h2>
                    </div>
                </div>

                <div class="ds-faces">
                    <div class="ds-face">
                        <p class="label">Display · Bodoni Moda Variable</p>
                        <p class="ds-face-sample ds-face-sample--display">Aa <em>Aa</em></p>
                        <p class="caption">opsz 6–96 · Gewicht 400 · roman + italic · <code>font-optical-sizing: auto</code> · −0.01 bis −0.025em bei grossen Grössen. Kursiv nur für ein Akzentwort (<code>&lt;em&gt;</code>, Bronze).</p>
                    </div>
                    <div class="ds-face">
                        <p class="label">Text &amp; UI · Instrument Sans Variable</p>
                        <p class="ds-face-sample ds-face-sample--text">Aa <strong>Aa</strong></p>
                        <p class="caption">Gewicht 400 für Text, 600 für Labels (uppercase, 0.16–0.18em). 300/350 existieren nicht.</p>
                    </div>
                </div>

                <ul class="ds-scale">
                    {typeScale.map((row) => (
                        <li>
                            <span class="ds-scale-meta">
                                <code>{row.token}</code>
                                <span class="caption">{row.size}</span>
                                <span class="caption">{row.use}</span>
                            </span>
                            <span class={row.className}>{row.sample}</span>
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <!-- 02 Colour -->
        <section class="section section--rule" aria-labelledby="ds-colour">
            <div class="container">
                <div class="section-head">
                    <div>
                        <p class="eyebrow eyebrow--rule">Farbe</p>
                        <h2 id="ds-colour">Porzellan, Espresso, <em>Bronze</em></h2>
                    </div>
                    <p class="caption ds-head-note">Nur über Tokens. Legacy-Aliase (<code>--bg-*</code>, <code>--gold*</code>, <code>--ink*</code> …) zeigen auf diese Werte.</p>
                </div>
                <ul class="ds-swatches">
                    {colours.map((colour) => (
                        <li class="ds-swatch">
                            <span class:list={['ds-chip', `ds-chip-${colour.token.slice(2)}`]} aria-hidden="true"></span>
                            <code>{colour.token}</code>
                            <span class="ds-swatch-hex">{colour.hex}</span>
                            <span class="caption">{colour.role}</span>
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <!-- 03 Space, shape, depth, motion -->
        <section class="section section--rule" aria-labelledby="ds-tokens">
            <div class="container ds-two">
                <div class="ds-two-head">
                    <p class="eyebrow eyebrow--rule">Raum &amp; Form</p>
                    <h2 id="ds-tokens">Eckig, flach, <em>ruhig</em></h2>
                </div>
                <dl class="facts">
                    {layoutTokens.map((row) => (
                        <div><dt>{row.label}</dt><dd>{row.value}</dd></div>
                    ))}
                </dl>
            </div>
        </section>

        <!-- 04 Buttons -->
        <section class="section section--rule" aria-labelledby="ds-buttons">
            <div class="container">
                <div class="section-head">
                    <div>
                        <p class="eyebrow eyebrow--rule">Aktionen</p>
                        <h2 id="ds-buttons">Eine Primäraktion pro <em>Moment</em></h2>
                    </div>
                </div>
                <div class="ds-two-panels">
                    <div class="ds-panel">
                        <p class="label">Auf hellem Grund</p>
                        <div class="btn-row">
                            <a href="#ds-buttons" class="btn">Termin buchen</a>
                            <a href="#ds-buttons" class="btn btn-secondary">WhatsApp</a>
                            <a href="#ds-buttons" class="btn-link">Behandlungen</a>
                        </div>
                        <div class="btn-row">
                            <a href="#ds-buttons" class="btn btn-sm">Klein · 44px</a>
                            <a href="#ds-buttons" class="btn btn-lg">Gross · 58px</a>
                        </div>
                        <p class="caption"><code>.btn</code> Espresso 52px · <code>.btn-secondary</code> 1px Espresso · <code>.btn-link</code> Label + Pfeil, Unterstrich mit 6px Abstand.</p>
                    </div>
                    <div class="ds-panel on-dark">
                        <p class="label">Auf Espresso (<code>.on-dark</code>, <code>.cta-band</code>)</p>
                        <div class="btn-row">
                            <a href="#ds-buttons" class="btn">Termin buchen</a>
                            <a href="#ds-buttons" class="btn btn-secondary">WhatsApp</a>
                            <a href="#ds-buttons" class="btn-link">Kontakt</a>
                        </div>
                        <p class="caption">Farben kehren sich automatisch um; Fokus-Ring in Bronze Light.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- 05 Patterns -->
        <section class="section section--rule" aria-labelledby="ds-patterns">
            <div class="container">
                <div class="section-head">
                    <div>
                        <p class="eyebrow eyebrow--rule">Muster</p>
                        <h2 id="ds-patterns">Linien statt <em>Karten</em></h2>
                    </div>
                </div>

                <div class="ds-pattern">
                    <p class="label">Eyebrow · <code>.eyebrow</code> + <code>.eyebrow--rule</code></p>
                    <p class="eyebrow">Signature-Behandlungen</p>
                    <p class="eyebrow eyebrow--rule">Ihr erster Besuch</p>
                </div>

                <div class="ds-pattern">
                    <p class="label">Index-Liste · <code>.index-list</code> / <code>.index-item</code></p>
                    <ul class="index-list">
                        <li>
                            <a class="index-item" href="#ds-patterns">
                                <h3 class="index-item-title">Aquafacial</h3>
                                <p class="index-item-text">Tiefenreinigung, sanftes Peeling und intensive Feuchtigkeit.</p>
                                <span class="index-item-meta">ab CHF 180</span>
                            </a>
                        </li>
                        <li>
                            <a class="index-item" href="#ds-patterns">
                                <h3 class="index-item-title">Fruchtsäure Peeling</h3>
                                <p class="index-item-text">AHA-Peeling für einen klaren, ebenmässigen Teint.</p>
                                <span class="index-item-meta">CHF 150</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="ds-pattern ds-pattern--split">
                    <div>
                        <p class="label">Fakten · <code>.facts</code></p>
                        <dl class="facts">
                            <div><dt>Dauer</dt><dd>60 Minuten</dd></div>
                            <div><dt>Preis</dt><dd>CHF 180</dd></div>
                            <div><dt>Downtime</dt><dd>Meist keine</dd></div>
                        </dl>
                    </div>
                    <div>
                        <p class="label">Preisliste · <code>.price-menu</code></p>
                        <ul class="price-menu">
                            <li class="price-row">
                                <div><h3 class="price-row-name">Aquafacial Basic Intensiv</h3><p class="price-row-note">Tiefenreinigung, Peeling, Feuchtigkeit</p></div>
                                <span class="price-row-duration">60 Min.</span>
                                <span class="price-row-price">CHF 180</span>
                            </li>
                            <li class="price-row">
                                <div><h3 class="price-row-name">Aquafacial Anti Aging</h3><p class="price-row-note">Die intensivere Variante</p></div>
                                <span class="price-row-duration">90 Min.</span>
                                <span class="price-row-price">CHF 250</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="ds-pattern">
                    <p class="label">Schritte · <code>.steps</code> (nur für echte Abfolgen nummerieren)</p>
                    <ol class="steps">
                        <li><h3>Termin wählen</h3><p>Online buchen oder per WhatsApp anfragen.</p></li>
                        <li><h3>Beratung</h3><p>Hauttyp, Ziele und Empfindlichkeiten.</p></li>
                        <li><h3>Behandlung</h3><p>Persönlich durch Teresa.</p></li>
                    </ol>
                </div>

                <div class="ds-pattern ds-pattern--split">
                    <div>
                        <p class="label">Zitat · <code>.quote</code></p>
                        <figure class="quote">
                            <blockquote>„Die Haut ist 90 Prozent von deinem Selfie.“</blockquote>
                            <figcaption>Teresa Stimac, Gründerin</figcaption>
                        </figure>
                    </div>
                    <div>
                        <p class="label">FAQ · <code>details.faq-item</code></p>
                        <div class="faq-list">
                            <details class="faq-item" open>
                                <summary>Brauche ich eine Beratung vor der ersten Behandlung?</summary>
                                <p>Eine kurze persönliche Beratung ist fester Bestandteil jeder Erstbehandlung.</p>
                            </details>
                            <details class="faq-item">
                                <summary>Kann ich mehrere Behandlungen kombinieren?</summary>
                                <p>Ja, viele Behandlungen ergänzen sich.</p>
                            </details>
                        </div>
                    </div>
                </div>

                <div class="ds-pattern">
                    <p class="label">Vertrauenszeile · <code>.trust-line</code></p>
                    <div class="trust-line">
                        <span>Seit über 20 Jahren in Zürich</span>
                        <span>4,8 / 5 aus 248+ Bewertungen</span>
                        <span>Bahnhofstrasse 94</span>
                    </div>
                </div>

                <div class="ds-pattern ds-pattern--split">
                    <div>
                        <p class="label">Medien · <code>.media</code> + Seitenverhältnis</p>
                        <div class="ds-ratios">
                            <span class="media media--portrait"><span>4:5</span></span>
                            <span class="media media--tall"><span>3:4</span></span>
                            <span class="media media--landscape"><span>3:2</span></span>
                        </div>
                    </div>
                    <div>
                        <p class="label">Eingabefeld · 2px Radius, Haarlinie, klarer Fokus</p>
                        <div class="kontakt-field">
                            <label for="ds-input">Ihr Name <span aria-hidden="true">*</span></label>
                            <input id="ds-input" type="text" placeholder="Vor- und Nachname" />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 06 Voice -->
        <section class="section section--rule" aria-labelledby="ds-voice">
            <div class="container ds-two">
                <div class="ds-two-head">
                    <p class="eyebrow eyebrow--rule">Sprache</p>
                    <h2 id="ds-voice">Persönlich, präzise, <em>Sie</em></h2>
                </div>
                <dl class="facts">
                    <div><dt>Anrede</dt><dd>Formelles „Sie“, de-CH (ss statt ß).</dd></div>
                    <div><dt>Anführung</dt><dd>Deutsche Anführungszeichen „…“.</dd></div>
                    <div><dt>Bewertung</dt><dd>„4,8 / 5 aus 248+ Bewertungen“, Treatwell als genannte und verlinkte Quelle.</dd></div>
                    <div><dt>Zahlen</dt><dd>Numerale nur für echte Abfolgen; Raster ohne Waisen.</dd></div>
                    <div><dt>Kein Jargon</dt><dd>Keine Agentur-, SEO- oder Tracking-Begriffe im sichtbaren Text.</dd></div>
                    <div><dt>Buchung</dt><dd>„Sie werden zur sicheren Online-Buchung bei unserem Partner Treatwell weitergeleitet.“</dd></div>
                </dl>
            </div>
        </section>

        <!-- 07 Closing band -->
        <section class="cta-band" aria-labelledby="ds-cta">
            <div class="cta-band-inner">
                <div>
                    <p class="eyebrow eyebrow--rule">Abschlussband · .cta-band</p>
                    <h2 id="ds-cta">Zeit für <em>Ihre</em> Haut</h2>
                    <p>Espresso-Band als ruhiger Abschluss jeder Seite.</p>
                </div>
                <div class="btn-row">
                    <a href="#ds-cta" class="btn">Termin buchen</a>
                    <a href="#ds-cta" class="btn-link">WhatsApp</a>
                </div>
            </div>
        </section>
    </main>
</body>
</html>

<style>
    .ds code {
        font-family: var(--f-body);
        font-size: 0.85em;
        font-weight: 600;
        color: var(--bronze);
    }

    .ds-masthead {
        display: grid;
        gap: 28px;
        padding-top: clamp(64px, 9vw, 136px);
        padding-bottom: var(--section-y-tight);
    }

    .ds-masthead .display {
        max-width: 12ch;
    }

    .ds-principles {
        margin-top: clamp(24px, 4vw, 56px);
    }

    /* Typography */
    .ds-faces {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        column-gap: clamp(24px, 4vw, 64px);
        margin-bottom: clamp(48px, 6vw, 88px);
    }

    .ds-face {
        display: grid;
        gap: 16px;
        align-content: start;
        padding-top: 24px;
        border-top: 1px solid var(--rule-strong);
    }

    .ds-face-sample {
        max-width: none;
        font-size: clamp(4rem, 9vw, 7.5rem);
        line-height: 1;
        color: var(--espresso);
    }

    .ds-face-sample--display {
        font-family: var(--f-display);
    }

    .ds-face-sample--display em {
        color: var(--bronze);
    }

    .ds-face-sample--text {
        font-family: var(--f-body);
        letter-spacing: -0.02em;
    }

    .ds-scale {
        border-top: 1px solid var(--rule-strong);
    }

    .ds-scale li {
        display: grid;
        grid-template-columns: minmax(200px, 3fr) minmax(0, 9fr);
        gap: 12px 48px;
        align-items: baseline;
        padding-block: 22px;
        border-bottom: 1px solid var(--rule);
    }

    .ds-scale-meta {
        display: grid;
        gap: 2px;
    }

    .ds-type-display { font-family: var(--f-display); font-size: var(--fs-display); line-height: 0.98; letter-spacing: -0.025em; color: var(--espresso); }
    .ds-type-h1 { font-family: var(--f-display); font-size: var(--fs-h1); line-height: 1.02; letter-spacing: var(--tracking-display); color: var(--espresso); }
    .ds-type-h2 { font-family: var(--f-display); font-size: var(--fs-h2); line-height: 1.06; color: var(--espresso); }
    .ds-type-h3 { font-family: var(--f-display); font-size: var(--fs-h3); line-height: 1.15; color: var(--espresso); }
    .ds-type-h4 { font-family: var(--f-display); font-size: var(--fs-h4); line-height: 1.25; color: var(--espresso); }
    .ds-type-lead { font-size: var(--fs-lead); line-height: 1.6; color: var(--umber); }
    .ds-type-body { font-size: var(--fs-body); line-height: 1.7; color: var(--umber); }
    .ds-type-small { font-size: var(--fs-small); color: var(--taupe); }
    .ds-type-label { font-size: var(--fs-label); font-weight: 600; letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--bronze); }

    /* Colour */
    .ds-head-note {
        max-width: 36ch;
    }

    .ds-swatches {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 40px clamp(16px, 2.5vw, 32px);
    }

    .ds-swatch {
        display: grid;
        gap: 6px;
        align-content: start;
    }

    .ds-chip {
        display: block;
        aspect-ratio: 4 / 5;
        margin-bottom: 10px;
        border: 1px solid var(--rule);
    }

    .ds-chip-porcelain { background: var(--porcelain); }
    .ds-chip-ivory { background: var(--ivory); }
    .ds-chip-sand { background: var(--sand); }
    .ds-chip-stone { background: var(--stone); }
    .ds-chip-espresso { background: var(--espresso); }
    .ds-chip-umber { background: var(--umber); }
    .ds-chip-taupe { background: var(--taupe); }
    .ds-chip-bronze { background: var(--bronze); }
    .ds-chip-bronze-light { background: var(--bronze-light); }
    .ds-chip-champagne { background: var(--champagne); }

    .ds-swatch-hex {
        font-size: var(--fs-label);
        font-weight: 600;
        letter-spacing: 0.14em;
        color: var(--espresso);
        font-variant-numeric: tabular-nums;
    }

    /* Two-column token sections */
    .ds-two {
        display: grid;
        grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
        gap: clamp(40px, 7vw, 120px);
        align-items: start;
    }

    .ds-two-head {
        display: grid;
        gap: 20px;
    }

    /* Buttons */
    .ds-two-panels {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ds-panel {
        display: grid;
        gap: 28px;
        align-content: start;
        padding: clamp(28px, 4vw, 56px);
        border: 1px solid var(--rule);
    }

    .ds-panel.on-dark {
        border-color: var(--espresso);
    }

    .ds-panel.on-dark .label,
    .ds-panel.on-dark .caption {
        color: var(--champagne);
    }

    .ds-panel.on-dark code {
        color: var(--bronze-light);
    }

    /* Patterns */
    .ds-pattern {
        display: grid;
        gap: 24px;
        padding-block: clamp(32px, 4vw, 56px);
        border-top: 1px solid var(--rule);
    }

    .ds-pattern:first-of-type {
        border-top: 0;
        padding-top: 0;
    }

    .ds-pattern--split {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 32px clamp(32px, 5vw, 80px);
    }

    .ds-pattern--split > div {
        display: grid;
