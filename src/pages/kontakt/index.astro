---
import Base from '../../layouts/Base.astro';
import {
    ADDRESS,
    CONTACT_EMAIL,
    CONTACT_PHONE,
    CONTACT_PHONE_DISPLAY,
    CONTACT_TOPICS,
    CONTACT_WHATSAPP_URL,
    FULL_ADDRESS,
    OPENING_HOURS,
} from '../../../shared/site';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim() ?? '';

const channels = [
    {
        index: '01',
        label: 'Telefon',
        value: CONTACT_PHONE_DISPLAY,
        note: 'Für Rückfragen, Terminänderungen und kurze Anliegen.',
        href: `tel:${CONTACT_PHONE}`,
        action: 'Jetzt anrufen',
        serifValue: true,
    },
    {
        index: '02',
        label: 'WhatsApp',
        value: 'Schnell schreiben',
        note: 'Ideal für kurze Rückfragen und Terminwünsche unterwegs.',
        href: CONTACT_WHATSAPP_URL,
        action: 'Chat öffnen',
        external: true,
        serifValue: false,
    },
    {
        index: '03',
        label: 'E-Mail',
        value: CONTACT_EMAIL,
        note: 'Für ausführlichere Fragen, Unterlagen oder Rückrufwünsche.',
        href: `mailto:${CONTACT_EMAIL}`,
        action: 'E-Mail schreiben',
        serifValue: false,
    },
    {
        index: '04',
        label: 'Termin',
        value: 'Direkt online buchen',
        note: 'Wenn Sie bereits wissen, welche Behandlung Sie möchten.',
        href: '/termin/',
        action: 'Zur Online-Buchung',
        serifValue: false,
    },
];

const studioFacts = [
    {
        index: '01',
        label: 'Adresse',
        lines: [ADDRESS.street, `${ADDRESS.postalCode} ${ADDRESS.city}`],
    },
    {
        index: '02',
        label: 'Öffnungszeiten',
        rows: OPENING_HOURS,
    },
    {
        index: '03',
        label: 'Mit dem ÖV',
        text: 'Paradeplatz und Börsenstrasse sind in wenigen Minuten zu Fuss erreichbar — aus allen Richtungen der Stadt unkompliziert.',
    },
    {
        index: '04',
        label: 'Mit dem Auto',
        text: 'Mehrere Innenstadt-Parkhäuser rund um Paradeplatz und Bleicherweg liegen nur wenige Gehminuten entfernt.',
    },
];

const guidance = [
    {
        index: '01',
        title: 'Erstberatung',
        body: 'Wenn Sie zwischen Hydrafacial, Microneedling, Peeling oder ColdPlasma schwanken, beschreiben Sie uns kurz Ihr Hautziel und Ihre Hauptanliegen.',
    },
    {
        index: '02',
        title: 'Terminfragen',
        body: 'Für Terminverschiebungen, Absagen oder einen bevorzugten Rückrufzeitpunkt bitten wir um eine Telefonnummer, unter der wir Sie zuverlässig erreichen.',
    },
    {
        index: '03',
        title: 'Vor dem ersten Termin',
        body: 'Teilen Sie uns mit, ob es sensible Haut, bekannte Unverträglichkeiten, aktive Akne, Rosazea oder aktuelle Medikamente gibt. So können wir Sie sauber vorbereiten.',
    },
];

const structuredData = {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": "Kontakt | Beauty Face Lift",
    "url": "https://beautyfacelift.ch/kontakt/",
    "mainEntity": {
        "@type": "HealthAndBeautyBusiness",
        "name": "Beauty Face Lift",
        "telephone": CONTACT_PHONE,
        "email": CONTACT_EMAIL,
        "address": {
            "@type": "PostalAddress",
            "streetAddress": ADDRESS.street,
            "addressLocality": ADDRESS.city,
            "postalCode": ADDRESS.postalCode,
            "addressCountry": ADDRESS.country,
        },
        "openingHoursSpecification": [
            { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], "opens": "09:00", "closes": "18:00" },
            { "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "10:00", "closes": "16:00" },
        ],
        "contactPoint": {
            "@type": "ContactPoint",
            "telephone": CONTACT_PHONE,
            "email": CONTACT_EMAIL,
            "contactType": "customer service",
            "availableLanguage": ["de", "en"],
            "areaServed": "CH"
        }
    }
};
---

<Base
    title="Kontakt | Beauty Face Lift Zürich"
    description="Kontaktieren Sie Beauty Face Lift an der Bahnhofstrasse 94 in Zürich. Telefon, WhatsApp, E-Mail und Kontaktformular für Erstberatung, Terminfragen und Studioanfragen."
    structuredData={structuredData}
>
    <section class="kontakt" aria-labelledby="kontakt-heading">

        <!-- MASTHEAD -->
        <div class="kontakt-masthead">
            <div class="kontakt-masthead-inner">
                <header class="kontakt-masthead-copy">
                    <p class="kontakt-eyebrow"><span class="kontakt-eyebrow-rule" aria-hidden="true"></span>Kontakt &amp; Beratung</p>
                    <h1 id="kontakt-heading" class="kontakt-display">
                        Ein Gespräch. Ein <span class="accent-word">Termin.</span> Ein spürbar klareres Hautgefühl.
                    </h1>
                    <p class="kontakt-lede">
                        Unsicher, welche Behandlung zu Ihrem Hautbild passt? Wir begleiten Sie persönlich — per Telefon, WhatsApp, E-Mail oder direkt im Studio an der Bahnhofstrasse 94. Für Erstberatungen und Rückfragen vor der Buchung ist diese Seite der schnellste Weg zu uns.
                    </p>
                    <p class="kontakt-lede kontakt-lede--muted">
                        Für Terminverschiebungen oder kurzfristige Absagen genügt ein Anruf oder eine WhatsApp-Nachricht.
                    </p>
                </header>

                <aside class="kontakt-channels" aria-labelledby="kontakt-channels-heading">
                    <p class="kontakt-eyebrow kontakt-eyebrow--aside">
                        <span id="kontakt-channels-heading">Direkt erreichbar</span>
                    </p>
                    <ul class="kontakt-channel-list">
                        {channels.map((c) => (
                            <li class="kontakt-channel">
                                <a
                                    class="kontakt-channel-link"
                                    href={c.href}
                                    {...(c.external ? { target: '_blank', rel: 'noopener' } : {})}
                                    aria-label={`${c.label}: ${c.action}`}
                                >
                                    <span class="kontakt-channel-index" aria-hidden="true">{c.index}</span>
                                    <span class="kontakt-channel-body">
                                        <span class="kontakt-channel-label">{c.label}</span>
                                        <span class={`kontakt-channel-value${c.serifValue ? ' kontakt-channel-value--serif' : ''}`}>{c.value}</span>
                                        <span class="kontakt-channel-note">{c.note}</span>
                                    </span>
                                    <span class="kontakt-channel-cta" aria-hidden="true">
                                        <span class="kontakt-channel-cta-label">{c.action}</span>
                                        <svg class="kontakt-channel-arrow" width="28" height="10" viewBox="0 0 28 10" fill="none" aria-hidden="true">
                                            <path d="M0 5 H26 M22 1 L26 5 L22 9" stroke="currentColor" stroke-width="1" fill="none" stroke-linecap="square" />
                                        </svg>
                                    </span>
                                </a>
                            </li>
                        ))}
                    </ul>
                </aside>
            </div>
        </div>

        <!-- STUDIO BAND (full-bleed paper-2) -->
        <div class="kontakt-studio full-bleed">
            <div class="kontakt-studio-inner">
                <div class="kontakt-studio-heading">
                    <p class="kontakt-eyebrow"><span class="kontakt-eyebrow-rule" aria-hidden="true"></span>Studio &amp; Anfahrt</p>
                    <h2 class="kontakt-studio-title">
                        Bahnhofstrasse 94 <span class="kontakt-dot" aria-hidden="true">·</span> <span class="accent-word">Zürich</span>
                    </h2>
                    <p class="kontakt-studio-sub">Mitten im Herzen der Stadt. Wenige Minuten vom Paradeplatz.</p>
                </div>

                <ul class="kontakt-studio-grid">
                    {studioFacts.map((f) => (
                        <li class="kontakt-studio-item">
                            <span class="kontakt-studio-index" aria-hidden="true">{f.index}</span>
                            <span class="kontakt-studio-label">{f.label}</span>
                            {f.lines && (
                                <address class="kontakt-studio-body">
                                    {f.lines.map((line) => (<p>{line}</p>))}
                                </address>
                            )}
                            {f.rows && (
                                <div class="kontakt-studio-body kontakt-studio-hours">
                                    {f.rows.map((row) => (
                                        <p>
                                            <span class="kontakt-hours-day">{row.label}</span>
                                            <span class="kontakt-hours-value">{row.value}</span>
                                        </p>
                                    ))}
                                </div>
                            )}
                            {f.text && (
                                <p class="kontakt-studio-body">{f.text}</p>
                            )}
                        </li>
                    ))}
                </ul>
            </div>
        </div>

        <!-- DIALOG: guidance + form -->
        <div class="kontakt-dialog">
            <aside class="kontakt-guidance" aria-labelledby="kontakt-guidance-heading">
                <p class="kontakt-eyebrow"><span class="kontakt-eyebrow-rule" aria-hidden="true"></span>Gut zu wissen</p>
                <h2 id="kontakt-guidance-heading" class="kontakt-guidance-heading">Worüber Sie uns am besten <span class="accent-word">schreiben</span></h2>
                <p class="kontakt-guidance-lede">Damit wir Ihnen rasch eine präzise Antwort geben können, hier die Themen, bei denen wir Ihnen besonders helfen können.</p>

                <ol class="kontakt-guidance-list">
                    {guidance.map((g) => (
                        <li class="kontakt-guidance-item">
                            <span class="kontakt-guidance-index" aria-hidden="true">{g.index}</span>
                            <div class="kontakt-guidance-body">
                                <h3 class="kontakt-guidance-title">{g.title}</h3>
                                <p>{g.body}</p>
                            </div>
                        </li>
                    ))}
                </ol>
            </aside>

            <article class="kontakt-form-panel" aria-labelledby="kontakt-form-heading">
                <p class="kontakt-eyebrow"><span class="kontakt-eyebrow-rule" aria-hidden="true"></span>Kontaktformular</p>
                <h2 id="kontakt-form-heading" class="kontakt-form-heading">Eine Nachricht an <span class="accent-word">Teresa</span></h2>
                <p class="kontakt-form-intro">
                    Pflichtfelder sind mit <span class="kontakt-required">*</span> markiert. Sie können eine E-Mail-Adresse, eine Telefonnummer oder beides hinterlassen. Das Formular funktioniert auch ohne JavaScript.
                </p>

                <form class="kontakt-form" action="/api/contact" method="post" novalidate>
                    <div class="kontakt-field-grid">
                        <div class="kontakt-field">
                            <label for="contact-name">Name <span class="kontakt-required" aria-hidden="true">*</span></label>
                            <input id="contact-name" name="name" type="text" autocomplete="name" required />
                        </div>
                        <div class="kontakt-field">
                            <label for="contact-topic">Thema <span class="kontakt-required" aria-hidden="true">*</span></label>
                            <div class="kontakt-select">
                                <select id="contact-topic" name="topic" required>
                                    <option value="">Bitte auswählen</option>
                                    {CONTACT_TOPICS.map((topic) => (
                                        <option value={topic}>{topic}</option>
                                    ))}
                                </select>
                                <svg class="kontakt-select-caret" width="12" height="8" viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1 L6 6 L11 1" stroke="currentColor" stroke-width="1" fill="none" stroke-linecap="square" /></svg>
                            </div>
                        </div>
                        <div class="kontakt-field">
                            <label for="contact-email">E-Mail</label>
                            <input id="contact-email" name="email" type="email" autocomplete="email" />
                        </div>
                        <div class="kontakt-field">
                            <label for="contact-phone">Telefon</label>
                            <input id="contact-phone" name="phone" type="tel" autocomplete="tel" />
                        </div>
                        <div class="kontakt-field kontakt-field--full">
                            <label for="contact-callback">Bevorzugter Rückrufzeitpunkt</label>
                            <input id="contact-callback" name="preferredCallbackTime" type="text" placeholder="z. B. werktags zwischen 12:00 und 14:00 Uhr" />
                        </div>
                        <div class="kontakt-field kontakt-field--full">
                            <label for="contact-message">Ihre Nachricht <span class="kontakt-required" aria-hidden="true">*</span></label>
                            <textarea id="contact-message" name="message" required placeholder="Beschreiben Sie kurz Ihr Anliegen, Ihre Hautziele oder Ihre Frage."></textarea>
                        </div>
                    </div>

                    <div class="kontakt-field kontakt-honeypot" aria-hidden="true">
                        <label for="contact-company">Firma</label>
                        <input id="contact-company" name="company" type="text" tabindex="-1" autocomplete="off" />
                    </div>

                    <div class="kontakt-turnstile">
                        {turnstileSiteKey ? (
                            <>
                                <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
                                <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
                            </>
                        ) : (
                            <p class="kontakt-form-note">Turnstile ist lokal noch nicht konfiguriert. Für Produktion bitte <code>PUBLIC_TURNSTILE_SITE_KEY</code> und <code>TURNSTILE_SECRET_KEY</code> setzen.</p>
                        )}
                    </div>

                    <label class="kontakt-checkbox" for="contact-privacy">
                        <input id="contact-privacy" name="privacyConsent" type="checkbox" required />
                        <span>Ich habe die <a href="/datenschutz/">Datenschutzerklärung</a> gelesen und bin mit der Verarbeitung meiner Angaben zur Beantwortung meiner Anfrage einverstanden. <span class="kontakt-required" aria-hidden="true">*</span></span>
                    </label>

                    <div class="kontakt-form-actions">
                        <button type="submit" class="pill-btn kontakt-submit">
                            <span>Nachricht senden</span>
                            <svg width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true"><path d="M0 5 H16 M12 1 L16 5 L12 9" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="square" /></svg>
                        </button>
                        <p class="kontakt-form-note">Für dringende Terminänderungen bitte direkt anrufen oder per WhatsApp schreiben.</p>
                    </div>
                </form>
            </article>
        </div>

    </section>
</Base>
