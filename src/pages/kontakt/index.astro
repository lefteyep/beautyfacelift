---
import Base from '../../layouts/Base.astro';
import '../../styles/kontakt.css';
import { Image, getImage } from 'astro:assets';
import { teresaPortrait, spaInterior } from '../../lib/site-images';
import {
    absoluteUrl,
    ADDRESS,
    CONTACT_EMAIL,
    CONTACT_PHONE,
    CONTACT_PHONE_DISPLAY,
    CONTACT_PREFERRED_METHODS,
    CONTACT_TOPICS,
    CONTACT_TREATMENT_INTERESTS,
    CONTACT_WHATSAPP_URL,
    FULL_ADDRESS,
    OPENING_HOURS,
    TREATWELL_URL,
} from '../../../shared/site';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim() ?? '';
const bookingHref = '/termin/';
const instagramUrl = 'https://www.instagram.com/beautyfacelift.zh/';
const addressLines = ['Beauty Face Lift', ADDRESS.street, `${ADDRESS.postalCode} ${ADDRESS.city}`];
const routeDestination = `${ADDRESS.street}, ${ADDRESS.postalCode} ${ADDRESS.city}, Schweiz`;
const routeUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(routeDestination)}`;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`Beauty Face Lift ${routeDestination}`)}`;
const mapEmbedUrl = `https://www.google.com/maps?q=${encodeURIComponent(`Beauty Face Lift ${routeDestination}`)}&output=embed`;

const heroImageSizes = '(min-width: 1200px) 460px, (min-width: 768px) 38vw, 92vw';
const heroImage = await getImage({
    src: teresaPortrait,
    widths: [360, 520, 720, 960],
    sizes: heroImageSizes,
    format: 'webp',
    quality: 'high',
});

const contactMethods = [
    {
        title: 'Beratung anfragen',
        body: 'Sie sind unsicher, welche Behandlung zu Ihrer Haut passt? Beschreiben Sie kurz Ihr Hautziel — Teresa empfiehlt Ihnen den passenden nächsten Schritt.',
        cta: 'Zum Formular',
        href: '#kontaktformular',
        priority: 'primary',
        event: 'contact_form_view',
        location: 'contact_method_cards',
        icon: 'sparkle',
    },
    {
        title: 'WhatsApp schreiben',
        body: 'Ideal für kurze Rückfragen, Terminwünsche oder kleine Änderungen unterwegs.',
        cta: 'Chat öffnen',
        href: CONTACT_WHATSAPP_URL,
        priority: 'secondary',
        event: 'contact_whatsapp_click',
        location: 'contact_method_cards',
        method: 'whatsapp',
        external: true,
        icon: 'message',
    },
    {
        title: 'Direkt online buchen',
        body: 'Wenn Sie bereits wissen, welche Behandlung Sie möchten, können Sie Ihren Termin direkt online auswählen.',
        cta: 'Termin buchen',
        href: bookingHref,
        priority: 'medium',
        event: 'contact_booking_click',
        location: 'contact_method_cards',
        method: 'booking',
        icon: 'calendar',
    },
    {
        title: 'Anrufen',
        body: 'Für dringende Terminänderungen oder kurzfristige Fragen erreichen Sie uns telefonisch am schnellsten.',
        cta: 'Jetzt anrufen',
        href: `tel:${CONTACT_PHONE}`,
        priority: 'medium',
        event: 'contact_phone_click',
        location: 'contact_method_cards',
        method: 'phone',
        icon: 'phone',
    },
];

const treatmentIntents = [
    {
        title: 'Frischer Glow & Feuchtigkeit',
        body: 'Für fahle, müde oder trockene Haut.',
    },
    {
        title: 'Unreinheiten, Poren & Akne',
        body: 'Für ein klareres, ruhigeres Hautbild.',
    },
    {
        title: 'Anti-Aging & Hautstruktur',
        body: 'Für feine Linien, Elastizität und ein verfeinertes Hautgefühl.',
    },
    {
        title: 'Sensible Haut & Rötungen',
        body: 'Für Kundinnen und Kunden, die besonders vorsichtig planen möchten.',
    },
    {
        title: 'Laser-Haarentfernung',
        body: 'Für Fragen zu Zonen, Ablauf, Preisen oder Eignung.',
    },
    {
        title: 'Wimpern, Brauen, Waxing & Make-up',
        body: 'Für klassische Beauty-Termine und kurzfristige Anliegen.',
    },
];

const trustCards = [
    {
        title: 'Über 20 Jahre Erfahrung',
        body: 'Langjährige Expertise in professioneller Kosmetik und Hautpflege.',
    },
    {
        title: 'Persönlich durch Teresa',
        body: 'Beratung und Behandlung erfolgen persönlich, aufmerksam und individuell.',
    },
    {
        title: 'Sehr gute Kundenbewertungen',
        body: '4,8 von 5 aus 248+ Bewertungen auf Treatwell.',
    },
    {
        title: 'Zentral in Zürich',
        body: 'An der Bahnhofstrasse 94, wenige Minuten vom Paradeplatz.',
    },
    {
        title: 'Hygienisch & professionell',
        body: 'Sorgfältige Vorbereitung, saubere Behandlungsräume und professionelle Abläufe.',
    },
];

const faqItems = [
    {
        question: 'Soll ich direkt buchen oder zuerst schreiben?',
        answer: 'Wenn Sie bereits wissen, welche Behandlung Sie möchten, können Sie direkt online buchen. Wenn Sie unsicher sind, schreiben Sie uns kurz Ihr Hautziel — Teresa empfiehlt Ihnen den passenden nächsten Schritt.',
    },
    {
        question: 'Welche Angaben helfen bei einer Behandlungsempfehlung?',
        answer: 'Hilfreich sind Ihr Hautziel, aktuelle Hautthemen, bekannte Unverträglichkeiten, sensible Haut, aktive Akne, Rosazea, Medikamente oder kürzlich durchgeführte Behandlungen.',
    },
    {
        question: 'Kann ich per WhatsApp einen Termin verschieben?',
        answer: 'Ja. Für Terminverschiebungen, kurzfristige Fragen oder kleine Änderungen ist WhatsApp der schnellste Weg.',
    },
    {
        question: 'Wie schnell erhalte ich eine Antwort?',
        answer: 'Teresa meldet sich so rasch wie möglich persönlich bei Ihnen. Bei dringenden Terminänderungen rufen Sie bitte direkt an oder schreiben Sie per WhatsApp.',
    },
    {
        question: 'Wo befindet sich Beauty Face Lift genau?',
        answer: 'Beauty Face Lift befindet sich an der Bahnhofstrasse 94 in 8001 Zürich, wenige Minuten von Paradeplatz und Börsenstrasse entfernt.',
    },
    {
        question: 'Muss ich schon wissen, welche Behandlung ich möchte?',
        answer: 'Nein. Beschreiben Sie einfach, was Sie sich für Ihre Haut wünschen. Teresa berät Sie ehrlich und empfiehlt eine passende Behandlung oder Kombination.',
    },
];

const openingHoursSpecification = [
    {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "09:00",
        "closes": "18:00",
    },
    {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": "Saturday",
        "opens": "10:00",
        "closes": "16:00",
    },
];

const structuredData = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "ContactPage",
            "@id": absoluteUrl('/kontakt/#contact-page'),
            "name": "Kontakt & Beratung | Beauty Face Lift Zürich",
            "url": absoluteUrl('/kontakt/'),
            "description": "Kontaktieren Sie Beauty Face Lift in Zürich für persönliche Hautberatung, Terminwünsche und Behandlungsfragen. Teresa Stimac berät Sie direkt an der Bahnhofstrasse 94.",
            "mainEntity": { "@id": absoluteUrl('/#beauty-salon') },
        },
        {
            "@type": "BeautySalon",
            "@id": absoluteUrl('/#beauty-salon'),
            "name": "Beauty Face Lift Zürich",
            "url": absoluteUrl('/'),
            "telephone": CONTACT_PHONE_DISPLAY,
            "email": CONTACT_EMAIL,
            "address": {
                "@type": "PostalAddress",
                "streetAddress": ADDRESS.street,
                "addressLocality": ADDRESS.city,
                "postalCode": ADDRESS.postalCode,
                "addressCountry": ADDRESS.country,
            },
            "areaServed": ["Zürich", "Switzerland"],
            "openingHoursSpecification": openingHoursSpecification,
            "sameAs": [instagramUrl, TREATWELL_URL],
        },
        {
            "@type": "FAQPage",
            "@id": absoluteUrl('/kontakt/#faq'),
            "mainEntity": faqItems.map((item) => ({
                "@type": "Question",
                "name": item.question,
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": item.answer,
                },
            })),
        },
    ],
};
---

<Base
    title="Kontakt & Beratung | Beauty Face Lift Zürich"
    description="Kontaktieren Sie Beauty Face Lift in Zürich für persönliche Hautberatung, Terminwünsche und Behandlungsfragen. Teresa Stimac berät Sie direkt an der Bahnhofstrasse 94."
    preloadImage={{
        href: heroImage.src,
        imagesrcset: heroImage.srcSet.attribute,
        imagesizes: heroImageSizes,
        type: 'image/webp',
        fetchpriority: 'high',
    }}
    ogImage={absoluteUrl('/assets/teresa_portrait.jpg')}
    structuredData={structuredData}
    bodyClass="page-contact"
>
    <div class="kontakt-page" data-contact-page>
        <!-- ContactHero -->
        <section class="kontakt-hero" aria-labelledby="kontakt-heading">
            <div class="kontakt-hero-copy">
                <p class="eyebrow eyebrow--rule reveal-up">Kontakt &amp; Beratung</p>
                <h1 id="kontakt-heading" class="reveal-up">Persönliche <em>Hautberatung</em> &amp; Termine in Zürich</h1>
                <p class="lead kontakt-hero-lede reveal-up">
                    Sie möchten einen Termin buchen, eine Behandlung abklären oder sind unsicher, was zu Ihrer Haut passt? Schreiben Sie Teresa direkt: persönlich, diskret und unkompliziert an der Bahnhofstrasse 94 in Zürich.
                </p>

                <div class="btn-row kontakt-hero-actions reveal-up" aria-label="Wichtigste Kontaktoptionen">
                    <a class="btn kontakt-primary" href="#kontaktformular" data-contact-event="contact_form_view" data-cta-location="hero" data-cta-label="Beratung oder Termin anfragen">
                        Beratung oder Termin anfragen
                    </a>
                    <a
                        class="btn btn-secondary kontakt-secondary"
                        href={CONTACT_WHATSAPP_URL}
                        target="_blank"
                        rel="noopener"
                        data-contact-event="contact_whatsapp_click"
                        data-contact-method="whatsapp"
                        data-cta-location="hero"
                        data-cta-label="Per WhatsApp schreiben"
                        data-button-location="hero_whatsapp"
                        data-source="kontakt_hero"
                    >
                        Per WhatsApp schreiben
                    </a>
                </div>

                <a class="btn-link kontakt-text-link" href={bookingHref} data-contact-event="contact_booking_click" data-contact-method="booking" data-cta-location="hero" data-cta-label="Ich weiss schon, was ich möchte — direkt online buchen" data-button-location="hero_booking">
                    Ich weiss schon, was ich möchte: direkt online buchen
                </a>

                <ul class="kontakt-trust-strip" aria-label="Vertrauenssignale">
                    <li><a href={TREATWELL_URL} target="_blank" rel="noopener">4,8 / 5 aus 248+ Bewertungen</a></li>
                    <li>Über 20 Jahre Erfahrung</li>
                    <li>Bahnhofstrasse 94, Zürich</li>
                </ul>
            </div>

            <figure class="kontakt-hero-media media-figure reveal-media">
                <div class="media media--portrait">
                    <Image
                        src={teresaPortrait}
                        widths={[360, 520, 720, 960]}
                        sizes={heroImageSizes}
                        format="webp"
                        quality="high"
                        alt="Teresa Stimac von Beauty Face Lift Zürich"
                        priority
                    />
                </div>
                <figcaption>
                    Persönliche Beratung durch Teresa Stimac an der Bahnhofstrasse 94.
                </figcaption>
            </figure>
        </section>

        <!-- ContactMethodCards -->
        <section class="kontakt-section kontakt-methods" aria-labelledby="kontakt-methods-heading">
            <div class="kontakt-section-heading">
                <p class="eyebrow eyebrow--rule">Kontaktwege</p>
                <h2 id="kontakt-methods-heading">Wie möchten Sie uns <em>erreichen</em>?</h2>
                <p>Wählen Sie den Weg, der am besten zu Ihrem Anliegen passt. Für kurze Fragen ist WhatsApp ideal, für eine persönliche Behandlungsempfehlung nutzen Sie am besten das Formular.</p>
            </div>

            <div class="kontakt-method-grid">
                {contactMethods.map((method) => (
                    <a
                        class:list={['kontakt-method-card', `kontakt-method-card--${method.priority}`]}
                        href={method.href}
                        {...(method.external ? { target: '_blank', rel: 'noopener' } : {})}
                        data-contact-event={method.event}
                        data-contact-method={method.method}
                        data-cta-location={method.location}
                        data-cta-label={method.cta}
                        data-button-location={`contact_method_${method.title.toLowerCase().replaceAll(' ', '_')}`}
                    >
                        {method.priority === 'primary' && <span class="kontakt-method-flag">Empfohlen</span>}
                        <span class="kontakt-method-title">{method.title}</span>
                        <span class="kontakt-method-copy">{method.body}</span>
                        <span class="kontakt-method-cta">{method.cta}</span>
                    </a>
                ))}
            </div>
        </section>

        <!-- AppointmentInquiryForm -->
        <section id="kontaktformular" class="kontakt-form-band" aria-labelledby="kontakt-form-heading">
            <div class="kontakt-form-section">
                <div class="kontakt-form-intro-block">
                    <p class="eyebrow eyebrow--rule">Anfrageformular</p>
                    <h2 id="kontakt-form-heading">Ihre Anfrage an <em>Teresa</em></h2>
                    <p>Beschreiben Sie kurz Ihr Anliegen, Ihr Hautziel oder Ihren gewünschten Termin. Teresa prüft Ihre Anfrage persönlich und meldet sich mit einer passenden Empfehlung oder Terminoption.</p>
                    <p class="kontakt-urgent-note">Für dringende Terminänderungen bitte direkt anrufen oder per WhatsApp schreiben.</p>
                </div>

                <div class="kontakt-form-panel">
                    <div class="kontakt-form-status" data-contact-status role="status" aria-live="polite" hidden></div>
                    <div class="kontakt-form-success" data-contact-success tabindex="-1" hidden>
                        <h3>Vielen Dank, Ihre Anfrage wurde gesendet.</h3>
                        <p>Teresa meldet sich persönlich bei Ihnen. Bei dringenden Terminänderungen erreichen Sie uns schneller telefonisch oder per WhatsApp.</p>
                        <div class="kontakt-success-actions">
                            <a class="btn-link" href={CONTACT_WHATSAPP_URL} target="_blank" rel="noopener" data-contact-event="contact_whatsapp_click" data-contact-method="whatsapp" data-cta-location="form" data-cta-label="WhatsApp schreiben" data-button-location="form_success_whatsapp">WhatsApp schreiben</a>
                            <a class="btn-link" href={bookingHref} data-contact-event="contact_booking_click" data-contact-method="booking" data-cta-location="form" data-cta-label="Direkt online buchen" data-button-location="form_success_booking">Direkt online buchen</a>
                            <a class="btn-link" href="#anfahrt" data-contact-event="contact_route_click" data-cta-location="form" data-cta-label="Anfahrt ansehen">Anfahrt ansehen</a>
                        </div>
                    </div>

                    <form class="kontakt-form" action="/api/contact" method="post" novalidate data-contact-form>
                        <input type="hidden" name="source" value="kontakt-page" />
                        <div class="kontakt-field-grid">
                            <div class="kontakt-field">
                                <label for="contact-name">Ihr Name <span aria-hidden="true">*</span></label>
                                <input id="contact-name" name="name" type="text" autocomplete="name" placeholder="Vor- und Nachname" required aria-describedby="contact-name-error" />
                                <p id="contact-name-error" class="kontakt-field-error" data-field-error="name" hidden></p>
                            </div>

                            <div class="kontakt-field">
                                <label for="contact-topic">Worum geht es? <span aria-hidden="true">*</span></label>
                                <div class="kontakt-select">
                                    <select id="contact-topic" name="topic" required aria-describedby="contact-topic-error">
                                        <option value="">Bitte auswählen</option>
                                        {CONTACT_TOPICS.map((topic) => (
                                            <option value={topic}>{topic}</option>
                                        ))}
                                    </select>
                                </div>
                                <p id="contact-topic-error" class="kontakt-field-error" data-field-error="topic" hidden></p>
                            </div>

                            <div class="kontakt-field">
                                <label for="contact-treatment-interest">Welche Behandlung interessiert Sie?</label>
                                <div class="kontakt-select">
                                    <select id="contact-treatment-interest" name="treatment_interest">
                                        <option value="">Optional auswählen</option>
                                        {CONTACT_TREATMENT_INTERESTS.map((interest) => (
                                            <option value={interest}>{interest}</option>
                                        ))}
                                    </select>
                                </div>
                            </div>

                            <div class="kontakt-field">
                                <label for="contact-email">E-Mail-Adresse</label>
                                <input id="contact-email" name="email" type="email" autocomplete="email" placeholder="name@email.ch" aria-describedby="contact-email-error contact-method-error" />
                                <p id="contact-email-error" class="kontakt-field-error" data-field-error="email" hidden></p>
                            </div>

                            <div class="kontakt-field">
                                <label for="contact-phone">Telefon oder WhatsApp</label>
                                <input id="contact-phone" name="phone" type="tel" autocomplete="tel" placeholder="+41 79 000 00 00" aria-describedby="contact-phone-error contact-method-error" />
                                <p id="contact-phone-error" class="kontakt-field-error" data-field-error="phone" hidden></p>
                            </div>

                            <fieldset class="kontakt-field kontakt-field--full kontakt-radio-field">
                                <legend>Wie dürfen wir Sie kontaktieren?</legend>
                                <div class="kontakt-radio-options">
                                    {CONTACT_PREFERRED_METHODS.map((method) => (
                                        <label>
                                            <input type="radio" name="preferred_contact" value={method} />
                                            <span>{method}</span>
                                        </label>
                                    ))}
                                </div>
                            </fieldset>

                            <div class="kontakt-field kontakt-field--full">
                                <label for="contact-preferred-time">Wunschtermin oder bevorzugte Zeit</label>
                                <input id="contact-preferred-time" name="preferred_time" type="text" placeholder="z. B. Dienstagabend, Freitagvormittag oder nächstmöglich" />
                            </div>

                            <div class="kontakt-field kontakt-field--full">
                                <label for="contact-message">Ihre Nachricht <span aria-hidden="true">*</span></label>
                                <textarea id="contact-message" name="message" required placeholder="Beschreiben Sie kurz Ihr Anliegen, Ihr Hautziel oder Ihren gewünschten Termin." aria-describedby="contact-message-error"></textarea>
                                <p id="contact-message-error" class="kontakt-field-error" data-field-error="message" hidden></p>
                            </div>
                        </div>

                        <p id="contact-method-error" class="kontakt-field-error kontakt-field-error--wide" data-field-error="contact" hidden></p>

                        <div class="kontakt-honeypot" aria-hidden="true">
                            <input id="contact-company" name="company" type="text" tabindex="-1" autocomplete="off" />
                        </div>

                        {turnstileSiteKey && (
                            <div class="kontakt-turnstile">
                                <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
                                <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
                            </div>
                        )}

                        <label class="kontakt-checkbox" for="contact-privacy">
                            <input id="contact-privacy" name="privacy" type="checkbox" required aria-describedby="contact-privacy-error" />
                            <span>Ich habe die <a href="/datenschutz/">Datenschutzerklärung</a> gelesen und bin einverstanden, dass meine Angaben zur Beantwortung meiner Anfrage verarbeitet werden. <span aria-hidden="true">*</span></span>
                        </label>
                        <p id="contact-privacy-error" class="kontakt-field-error" data-field-error="privacy" hidden></p>

                        <div class="kontakt-form-actions">
                            <button type="submit" class="btn kontakt-submit" data-contact-submit>
                                Anfrage an Teresa senden
                            </button>
                            <p>Bitte geben Sie mindestens eine Kontaktmöglichkeit an: E-Mail, Telefon oder WhatsApp.</p>
                        </div>
                    </form>
                </div>
            </div>
        </section>

        <!-- TreatmentIntentGuide -->
        <section class="kontakt-section kontakt-intents" aria-labelledby="kontakt-intents-heading">
            <div class="kontakt-section-heading kontakt-section-heading--row">
                <div>
                    <p class="eyebrow eyebrow--rule">Orientierung</p>
                    <h2 id="kontakt-intents-heading">Noch unsicher, welche Behandlung <em>passt</em>?</h2>
                    <p>Sie müssen die richtige Behandlung nicht selbst auswählen. Beschreiben Sie einfach Ihr Hautziel. Teresa berät Sie ehrlich und empfiehlt, was zu Ihrer Haut, Ihrem Alltag und Ihren Erwartungen passt.</p>
                </div>
                <a class="btn-link kontakt-section-link" href="#kontaktformular" data-contact-event="contact_form_view" data-cta-location="treatment_intent_guide" data-cta-label="Hautziel im Formular beschreiben">
                    Hautziel im Formular beschreiben
                </a>
            </div>

            <div class="kontakt-intent-grid">
                {treatmentIntents.map((intent) => (
                    <article class="kontakt-intent-card">
                        <h3>{intent.title}</h3>
                        <p>{intent.body}</p>
                    </article>
                ))}
            </div>
        </section>

        <!-- TrustSection -->
        <section class="kontakt-section kontakt-trust" aria-labelledby="kontakt-trust-heading">
            <figure class="kontakt-trust-image media-figure">
                <div class="media media--portrait">
                    <Image
                        src={spaInterior}
                        widths={[360, 540, 720, 960]}
                        sizes="(min-width: 1000px) 420px, 92vw"
                        format="webp"
                        quality="high"
                        alt="Behandlungsraum von Beauty Face Lift Zürich"
                        loading="lazy"
                    />
                </div>
            </figure>

            <div class="kontakt-trust-copy">
                <p class="eyebrow eyebrow--rule">Warum Kundinnen Teresa vertrauen</p>
                <h2 id="kontakt-trust-heading">Persönliche Beratung statt <em>anonymer</em> Massenbehandlung</h2>
                <p>Bei Beauty Face Lift werden Sie persönlich von Teresa Stimac betreut, mit über 20 Jahren Erfahrung, viel Feingefühl und einem klaren Blick dafür, welche Behandlung wirklich zu Ihrer Haut passt. Jede Anfrage wird sorgfältig gelesen, damit Ihr erster Schritt einfach, sicher und gut vorbereitet ist.</p>
                <dl class="facts kontakt-trust-grid">
                    {trustCards.map((card) => (
                        <div class="kontakt-trust-card">
                            <dt>{card.title}</dt>
                            <dd>{card.body}</dd>
                        </div>
                    ))}
                </dl>
            </div>
        </section>

        <!-- LocationHoursMap -->
        <section id="anfahrt" class="kontakt-section kontakt-location" aria-labelledby="kontakt-location-heading">
            <div class="kontakt-section-heading">
                <p class="eyebrow eyebrow--rule">Studio &amp; Anfahrt</p>
                <h2 id="kontakt-location-heading">Beauty Face Lift an der <em>Bahnhofstrasse</em> 94</h2>
                <p>Sie finden Beauty Face Lift zentral in Zürich Kreis 1, an der Bahnhofstrasse 94, 8001 Zürich. Paradeplatz und Börsenstrasse sind in wenigen Minuten zu Fuss erreichbar.</p>
            </div>

            <div class="kontakt-location-grid">
                <article class="kontakt-location-card">
                    <h3>Adresse</h3>
                    <address>
                        {addressLines.map((line) => (<span>{line}</span>))}
                    </address>
                    <a class="btn-link" href={routeUrl} target="_blank" rel="noopener" data-contact-event="contact_route_click" data-cta-location="location_section" data-cta-label="Route planen">
                        Route planen
                    </a>
                </article>

                <article class="kontakt-location-card">
                    <h3>Öffnungszeiten</h3>
                    <dl class="kontakt-hours">
                        {OPENING_HOURS.map((item) => (
                            <>
                                <dt>{item.label}</dt>
                                <dd>{item.value}</dd>
                            </>
                        ))}
                    </dl>
                </article>

                <article class="kontakt-location-card">
                    <h3>Mit dem ÖV</h3>
                    <p>Paradeplatz und Börsenstrasse sind nur wenige Gehminuten entfernt. Das Studio ist aus allen Richtungen der Stadt gut erreichbar.</p>
                </article>

                <article class="kontakt-location-card">
                    <h3>Mit dem Auto</h3>
                    <p>Rund um Paradeplatz und Bleicherweg befinden sich mehrere Innenstadt-Parkhäuser in Gehdistanz.</p>
                </article>
            </div>

            <div class="kontakt-map">
                <div class="kontakt-map-copy">
                    <h3>Anfahrt auf der Karte</h3>
                    <p>Die Route öffnet sich in Google Maps. Die Adresse können Sie auch direkt kopieren.</p>
                    <div class="kontakt-map-actions">
                        <a class="btn" href={mapsUrl} target="_blank" rel="noopener" data-contact-event="contact_route_click" data-cta-location="location_section" data-cta-label="Google Maps öffnen">Google Maps öffnen</a>
                        <button type="button" class="btn-link" data-copy-address={FULL_ADDRESS} data-contact-event="contact_address_copy" data-cta-location="location_section" data-cta-label="Adresse kopieren">Adresse kopieren</button>
                        <a class="btn-link" href={`mailto:${CONTACT_EMAIL}`} data-contact-event="contact_email_click" data-contact-method="email" data-cta-location="location_section" data-cta-label="E-Mail schreiben">E-Mail schreiben</a>
                    </div>
                </div>
                <iframe
                    title="Karte mit Beauty Face Lift an der Bahnhofstrasse 94 in Zürich"
                    src={mapEmbedUrl}
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    allowfullscreen
                ></iframe>
            </div>
        </section>

        <!-- ContactFAQ -->
        <section class="kontakt-section kontakt-faq" aria-labelledby="kontakt-faq-heading">
            <div class="kontakt-faq-head">
                <p class="eyebrow eyebrow--rule">Gut zu wissen</p>
                <h2 id="kontakt-faq-heading">Häufige Fragen vor der <em>Kontaktaufnahme</em></h2>
            </div>
            <div class="faq-list kontakt-faq-list">
                {faqItems.map((item) => (
                    <details class="faq-item" data-contact-faq>
                        <summary>{item.question}</summary>
                        <p>{item.answer}</p>
                    </details>
                ))}
            </div>
        </section>

        <!-- FinalCTA -->
        <section class="cta-band kontakt-final" aria-labelledby="kontakt-final-heading">
            <div class="cta-band-inner">
                <div>
                    <p class="eyebrow eyebrow--rule">Beratung</p>
                    <h2 id="kontakt-final-heading">Bereit für Ihre persönliche <em>Hautberatung</em>?</h2>
                    <p>Ob Terminwunsch, Behandlungsfrage oder Unsicherheit vor dem ersten Besuch: Schreiben Sie uns kurz. Teresa meldet sich persönlich und hilft Ihnen, den nächsten Schritt entspannt zu planen.</p>
                </div>
                <div class="btn-row kontakt-final-actions">
                    <a class="btn" href="#kontaktformular" data-contact-event="contact_form_view" data-cta-location="final_cta" data-cta-label="Beratung anfragen">Beratung anfragen</a>
                    <a class="btn btn-secondary kontakt-secondary" href={CONTACT_WHATSAPP_URL} target="_blank" rel="noopener" data-contact-event="contact_whatsapp_click" data-contact-method="whatsapp" data-cta-location="final_cta" data-cta-label="Per WhatsApp schreiben" data-button-location="final_cta_whatsapp">Per WhatsApp schreiben</a>
                    <a class="btn-link" href={bookingHref} data-contact-event="contact_booking_click" data-contact-method="booking" data-cta-location="final_cta" data-cta-label="Direkt online buchen" data-button-location="final_cta_booking">Direkt online buchen</a>
                </div>
            </div>
        </section>

        <!-- MobileStickyContactBar -->
        <nav class="kontakt-mobile-bar" aria-label="Schnelle Kontaktoptionen">
            <a href={CONTACT_WHATSAPP_URL} target="_blank" rel="noopener" aria-label="Beauty Face Lift per WhatsApp schreiben" data-contact-event="contact_whatsapp_click" data-contact-method="whatsapp" data-cta-location="mobile_sticky_bar" data-cta-label="WhatsApp" data-button-location="mobile_sticky_whatsapp">WhatsApp</a>
            <a href={`tel:${CONTACT_PHONE}`} aria-label={`Beauty Face Lift unter ${CONTACT_PHONE_DISPLAY} anrufen`} data-contact-event="contact_phone_click" data-contact-method="phone" data-cta-location="mobile_sticky_bar" data-cta-label="Anrufen" data-button-location="mobile_sticky_phone">Anrufen</a>
            <a href={bookingHref} aria-label="Direkt online buchen" data-contact-event="contact_booking_click" data-contact-method="booking" data-cta-location="mobile_sticky_bar" data-cta-label="Buchen" data-button-location="mobile_sticky_booking">Buchen</a>
        </nav>
        <div class="kontakt-mobile-safe-space" aria-hidden="true"></div>
    </div>

    <script is:inline>
        (function() {
            var form = document.querySelector('[data-contact-form]');
            var successBox = document.querySelector('[data-contact-success]');
            var statusBox = document.querySelector('[data-contact-status]');
            var formViewed = false;
            var formStarted = false;

            var messages = {
                name: 'Bitte geben Sie Ihren Namen ein.',
                topic: 'Bitte wählen Sie aus, worum es bei Ihrer Anfrage geht.',
                contact: 'Bitte geben Sie eine E-Mail-Adresse oder Telefonnummer an, damit Teresa Ihnen antworten kann.',
                email: 'Bitte prüfen Sie die E-Mail-Adresse. Beispiel: name@email.ch',
                phone: 'Bitte prüfen Sie die Telefonnummer. Beispiel: +41 79 000 00 00',
                message: 'Bitte beschreiben Sie kurz Ihr Anliegen oder Ihren Terminwunsch.',
                privacy: 'Bitte bestätigen Sie die Datenschutzhinweise, damit wir Ihre Anfrage beantworten dürfen.'
            };

            function hasMarketingConsent() {
                try {
                    return window.localStorage.getItem('bfl_marketing_consent') === 'granted';
                } catch (error) {
                    return false;
                }
            }

            function deviceType() {
                return window.matchMedia('(max-width: 767px)').matches ? 'mobile' : 'desktop';
            }

            function formValue(name) {
                if (!form) return '';
                var control = form.elements[name];
                if (!control) return '';
                if (control instanceof RadioNodeList) return control.value || '';
                return String(control.value || '').trim();
            }

            function pushContactEvent(eventName, props) {
                if (!hasMarketingConsent()) return;
                window.dataLayer = window.dataLayer || [];
                window.dataLayer.push(Object.assign({
                    event: eventName,
                    page_path: window.location.pathname,
                    device_type: deviceType()
                }, props || {}));
            }

            function eventPropsFromElement(element) {
                return {
                    cta_location: element.dataset.ctaLocation || '',
                    cta_label: element.dataset.ctaLabel || element.textContent.trim(),
                    contact_method: element.dataset.contactMethod || '',
                    form_topic: formValue('topic'),
                    treatment_interest: formValue('treatment_interest')
                };
            }

            function setFieldError(name, message) {
                if (!form) return;
                var error = form.querySelector('[data-field-error="' + name + '"]');
                if (error) {
                    error.textContent = message || '';
                    error.hidden = !message;
                }
                var control = form.elements[name];
                if (control && !(control instanceof RadioNodeList)) {
                    if (message) control.setAttribute('aria-invalid', 'true');
                    else control.removeAttribute('aria-invalid');
                }
            }

            function setContactError(message) {
                setFieldError('contact', message);
                ['email', 'phone'].forEach(function(name) {
                    var control = form && form.elements[name];
                    if (!control) return;
                    if (message) control.setAttribute('aria-invalid', 'true');
                    else control.removeAttribute('aria-invalid');
                });
            }

            function clearErrors() {
                if (!form) return;
                form.querySelectorAll('[data-field-error]').forEach(function(error) {
                    error.textContent = '';
                    error.hidden = true;
                });
                form.querySelectorAll('[aria-invalid]').forEach(function(control) {
                    control.removeAttribute('aria-invalid');
                });
                if (statusBox) {
                    statusBox.hidden = true;
                    statusBox.textContent = '';
                    statusBox.removeAttribute('data-state');
                }
            }

            function validEmail(value) {
                return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
            }

            function validPhone(value) {
                var digits = value.replace(/\D/g, '');
                return !value || (digits.length >= 8 && digits.length <= 15);
            }

            function validateForm() {
                clearErrors();
                if (!form) return false;

                var valid = true;
                var name = formValue('name');
                var topic = formValue('topic');
                var email = formValue('email');
                var phone = formValue('phone');
                var message = formValue('message');
                var privacy = form.elements.privacy;

                if (!name) {
                    setFieldError('name', messages.name);
                    valid = false;
                }
                if (!topic) {
                    setFieldError('topic', messages.topic);
                    valid = false;
                }
                if (!email && !phone) {
                    setContactError(messages.contact);
                    valid = false;
                } else {
                    setContactError('');
                }
                if (email && !validEmail(email)) {
                    setFieldError('email', messages.email);
                    valid = false;
                }
                if (phone && !validPhone(phone)) {
                    setFieldError('phone', messages.phone);
                    valid = false;
                }
                if (!message) {
                    setFieldError('message', messages.message);
                    valid = false;
                }
                if (!privacy || !privacy.checked) {
                    setFieldError('privacy', messages.privacy);
                    if (privacy) privacy.setAttribute('aria-invalid', 'true');
                    valid = false;
                }

                return valid;
            }

            function showStatus(message, state) {
                if (!statusBox) return;
                statusBox.textContent = message;
                statusBox.hidden = false;
                statusBox.dataset.state = state || 'error';
                statusBox.setAttribute('role', state === 'error' ? 'alert' : 'status');
            }

            function focusFirstInvalid() {
                var firstInvalid = form && form.querySelector('[aria-invalid="true"]');
                if (firstInvalid && typeof firstInvalid.focus === 'function') firstInvalid.focus();
            }

            if (form) {
                form.addEventListener('input', function() {
                    if (formStarted) return;
                    formStarted = true;
                    pushContactEvent('contact_form_start', {
                        cta_location: 'form',
                        form_topic: formValue('topic'),
                        treatment_interest: formValue('treatment_interest')
                    });
                }, { once: true });

                form.addEventListener('submit', function(event) {
                    if (!validateForm()) {
                        event.preventDefault();
                        pushContactEvent('contact_form_submit_error', {
                            cta_location: 'form',
                            error_type: 'validation',
                            form_topic: formValue('topic'),
                            treatment_interest: formValue('treatment_interest')
                        });
                        focusFirstInvalid();
                        return;
                    }

                    if (!window.fetch) return;

                    event.preventDefault();
                    var submitButton = form.querySelector('[data-contact-submit]');
                    var originalText = submitButton ? submitButton.textContent : '';
                    var formData = new FormData(form);
                    var payload = {};
                    formData.forEach(function(value, key) {
                        payload[key] = String(value);
                    });

                    if (submitButton) {
                        submitButton.disabled = true;
                        submitButton.textContent = 'Anfrage wird gesendet';
                    }

                    fetch(form.action, {
                        method: 'POST',
                        headers: {
                            'Accept': 'application/json',
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(payload)
                    }).then(function(response) {
                        return response.text().then(function(text) {
                            var data = {};
                            try { data = text ? JSON.parse(text) : {}; } catch (error) {}
                            if (!response.ok) {
                                throw new Error(data.error || 'Ihre Anfrage konnte gerade nicht versendet werden. Bitte rufen Sie uns direkt an oder schreiben Sie uns per E-Mail.');
                            }
                            return data;
                        });
                    }).then(function() {
                        pushContactEvent('contact_form_submit_success', {
                            cta_location: 'form',
                            form_topic: formValue('topic'),
                            treatment_interest: formValue('treatment_interest')
                        });
                        window.bflTracking?.trackLead?.({
                            email: formValue('email'),
                            phone: formValue('phone'),
                            source: 'kontakt_form'
                        });
                        form.hidden = true;
                        if (successBox) {
                            successBox.hidden = false;
                            successBox.focus();
                        }
                    }).catch(function(error) {
                        showStatus(error.message || 'Ihre Anfrage konnte gerade nicht versendet werden. Bitte rufen Sie uns direkt an oder schreiben Sie uns per E-Mail.', 'error');
                        pushContactEvent('contact_form_submit_error', {
                            cta_location: 'form',
                            error_type: 'server',
                            form_topic: formValue('topic'),
                            treatment_interest: formValue('treatment_interest')
                        });
                    }).finally(function() {
                        if (submitButton) {
                            submitButton.disabled = false;
                            submitButton.textContent = originalText;
                        }
                    });
                });

                form.addEventListener('focusin', function(event) {
                    if (event.target && event.target.matches('input, select, textarea')) {
                        document.body.classList.add('kontakt-form-focused');
                    }
                });
                form.addEventListener('focusout', function() {
                    window.setTimeout(function() {
                        if (!form.contains(document.activeElement)) {
                            document.body.classList.remove('kontakt-form-focused');
                        }
                    }, 80);
                });
            }

            var formSection = document.getElementById('kontaktformular');
            function trackFormView() {
                if (formViewed) return;
                formViewed = true;
                pushContactEvent('contact_form_view', { cta_location: 'form' });
            }
            if (formSection && 'IntersectionObserver' in window) {
                var observer = new IntersectionObserver(function(entries) {
                    entries.forEach(function(entry) {
                        if (entry.isIntersecting) {
                            trackFormView();
                            observer.disconnect();
                        }
                    });
                }, { threshold: 0.35 });
                observer.observe(formSection);
            } else {
                trackFormView();
            }

            var heroSection = document.querySelector('.kontakt-hero');
            function updateMobileStickyState() {
                if (!heroSection) return;
                var heroBottom = heroSection.getBoundingClientRect().bottom;
                document.body.classList.toggle('kontakt-sticky-visible', heroBottom < window.innerHeight * 0.72);
            }
            function scheduleMobileStickyUpdate() {
                window.requestAnimationFrame(function() {
                    updateMobileStickyState();
                });
            }
            if (heroSection) {
                scheduleMobileStickyUpdate();
                window.addEventListener('load', updateMobileStickyState);
                window.addEventListener('scroll', updateMobileStickyState, { passive: true });
                window.addEventListener('resize', scheduleMobileStickyUpdate);
            }

            document.querySelectorAll('[data-contact-event]').forEach(function(element) {
                element.addEventListener('click', function() {
                    pushContactEvent(element.dataset.contactEvent, eventPropsFromElement(element));
                });
            });

            document.querySelectorAll('[data-contact-faq]').forEach(function(details) {
                details.addEventListener('toggle', function() {
                    if (!details.open) return;
                    pushContactEvent('faq_open', {
                        cta_location: 'faq',
                        cta_label: details.querySelector('summary')?.textContent.trim() || ''
                    });
                });
            });

            document.querySelectorAll('[data-copy-address]').forEach(function(button) {
                button.addEventListener('click', function() {
                    var address = button.dataset.copyAddress || '';
                    if (!navigator.clipboard || !address) return;
                    navigator.clipboard.writeText(address).then(function() {
                        button.textContent = 'Adresse kopiert';
                        window.setTimeout(function() {
                            button.textContent = 'Adresse kopieren';
                        }, 2200);
                    }).catch(function() {});
                });
            });
        })();
    </script>

</Base>
