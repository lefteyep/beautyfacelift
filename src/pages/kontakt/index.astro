---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { teresaPortrait } from '../../lib/site-images';
import {
    absoluteUrl,
    ADDRESS,
    CONTACT_EMAIL,
    CONTACT_PHONE,
    CONTACT_PHONE_DISPLAY,
    CONTACT_TOPICS,
    CONTACT_WHATSAPP_URL,
    FULL_ADDRESS,
    OPENING_HOURS,
    TREATWELL_URL,
    TURNSTILE_ALLOWED_HOSTS,
} from '../../../shared/site';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim() ?? '';
const routeUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(FULL_ADDRESS)}`;
const instagramUrl = 'https://www.instagram.com/beautyfacelift.zh/';

const openingHoursSpecification = [
    {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
        opens: '09:00',
        closes: '18:00',
    },
    {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: 'Saturday',
        opens: '10:00',
        closes: '16:00',
    },
];

const primaryPaths = [
    {
        id: 'contact-card-booking',
        eyebrow: 'Direkt buchen',
        title: 'Termin online buchen',
        copy: 'Wenn Sie bereits wissen, was Sie möchten, wählen Sie Ihren Termin direkt online aus.',
        cta: 'Jetzt Termin buchen',
        href: 'https://buchung.treatwell.ch/ort/beauty-face-lift/',
        event: 'click_booking',
        buttonLocation: 'contact_card_booking',
        variant: 'primary',
    },
    {
        id: 'contact-card-whatsapp',
        eyebrow: 'Kurze Frage',
        title: 'Per WhatsApp schreiben',
        copy: 'Ideal für Terminwünsche, Rückfragen oder eine erste Einschätzung vor der Behandlung.',
        cta: 'Per WhatsApp schreiben',
        href: CONTACT_WHATSAPP_URL,
        event: 'click_whatsapp',
        buttonLocation: 'contact_card_whatsapp',
        external: true,
        variant: 'secondary',
    },
    {
        id: 'contact-card-phone',
        eyebrow: 'Telefon',
        title: CONTACT_PHONE_DISPLAY,
        copy: 'Für kurzfristige Änderungen oder wenn Sie direkt persönlich sprechen möchten.',
        cta: 'Anrufen',
        href: `tel:${CONTACT_PHONE}`,
        event: 'click_phone',
        buttonLocation: 'contact_card_phone',
        variant: 'quiet',
    },
    {
        id: 'contact-card-email',
        eyebrow: 'E-Mail',
        title: CONTACT_EMAIL,
        copy: 'Für ausführlichere Anliegen, Unterlagen oder Rückrufwünsche.',
        cta: 'E-Mail schreiben',
        href: `mailto:${CONTACT_EMAIL}`,
        event: 'click_email',
        buttonLocation: 'contact_card_email',
        variant: 'quiet',
    },
];

const intentCards = [
    {
        id: 'contact-intent-booking',
        title: 'Ich möchte buchen',
        copy: 'Für Kundinnen, die bereits wissen, welche Behandlung sie möchten.',
        cta: 'Jetzt Termin buchen',
        href: 'https://buchung.treatwell.ch/ort/beauty-face-lift/',
        event: 'click_booking',
        buttonLocation: 'contact_intent_booking',
    },
    {
        id: 'contact-intent-recommendation',
        title: 'Ich bin unsicher',
        copy: 'Teresa empfiehlt Ihnen den passenden nächsten Schritt für Ihr Hautziel.',
        cta: 'Anfrage senden',
        href: '#kontakt-form',
        event: 'click_form_intent',
        buttonLocation: 'contact_intent_recommendation',
    },
    {
        id: 'contact-intent-reschedule',
        title: 'Termin ändern',
        copy: 'Für kurzfristige Änderungen bitte direkt per WhatsApp schreiben oder anrufen.',
        cta: 'Per WhatsApp schreiben',
        href: CONTACT_WHATSAPP_URL,
        event: 'click_whatsapp',
        buttonLocation: 'contact_intent_reschedule',
        external: true,
    },
    {
        id: 'contact-intent-route',
        title: 'Anfahrt planen',
        copy: 'Bahnhofstrasse 94, wenige Minuten vom Paradeplatz und der Börsenstrasse.',
        cta: 'Route planen',
        href: routeUrl,
        event: 'click_route',
        buttonLocation: 'contact_intent_route',
        external: true,
    },
];

const structuredData = {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Kontakt & Termin buchen bei Beauty Face Lift Zürich',
    url: absoluteUrl('/kontakt/'),
    mainEntity: {
        '@type': 'BeautySalon',
        name: 'Beauty Face Lift Zürich',
        url: absoluteUrl('/'),
        image: absoluteUrl('/assets/hero_editorial_portrait.png'),
        telephone: CONTACT_PHONE,
        email: CONTACT_EMAIL,
        hasMap: routeUrl,
        address: {
            '@type': 'PostalAddress',
            streetAddress: ADDRESS.street,
            addressLocality: ADDRESS.city,
            postalCode: ADDRESS.postalCode,
            addressCountry: ADDRESS.country,
        },
        contactPoint: [
            {
                '@type': 'ContactPoint',
                contactType: 'customer service',
                telephone: CONTACT_PHONE,
                email: CONTACT_EMAIL,
                availableLanguage: ['de-CH', 'de'],
            },
        ],
        openingHoursSpecification,
        sameAs: [instagramUrl, TREATWELL_URL],
        areaServed: ['Zürich', 'Switzerland'],
    },
};
---

<Base
    title="Kontakt & Termin buchen Zürich | Beauty Face Lift Bahnhofstrasse"
    description="Kontaktieren Sie Beauty Face Lift Zürich an der Bahnhofstrasse 94. Termin online buchen, per WhatsApp schreiben oder persönliche Beratung bei Teresa anfragen."
    structuredData={structuredData}
>
    <main class="kontakt kontakt-desk" aria-labelledby="kontakt-heading">
        <section class="kontakt-desk-hero">
            <div class="kontakt-desk-hero-copy">
                <p class="kontakt-desk-kicker">Beauty Face Lift Zürich · Bahnhofstrasse</p>
                <h1 id="kontakt-heading">Kontakt &amp; Termin buchen bei Beauty Face Lift Zürich</h1>
                <p class="kontakt-desk-lead">
                    Sie möchten einen Termin vereinbaren oder sind unsicher, welche Behandlung zu Ihrem Hautbild passt?
                    Teresa berät Sie persönlich per WhatsApp, Telefon, E-Mail oder direkt im Studio an der Bahnhofstrasse 94.
                </p>
                <p class="kontakt-desk-location">Bahnhofstrasse 94 · 8001 Zürich · wenige Minuten vom Paradeplatz</p>

                <div class="kontakt-desk-hero-actions" aria-label="Wichtigste Kontaktoptionen">
                    <a
                        id="contact-hero-booking"
                        class="pill-btn kontakt-desk-primary"
                        href="https://buchung.treatwell.ch/ort/beauty-face-lift/"
                        data-event="click_booking"
                        data-button-location="contact_hero_booking"
                    >
                        Jetzt Termin buchen
                    </a>
                    <a
                        id="contact-hero-whatsapp"
                        class="pill-btn pill-btn-outline kontakt-desk-secondary"
                        href={CONTACT_WHATSAPP_URL}
                        target="_blank"
                        rel="noopener"
                        data-event="click_whatsapp"
                        data-button-location="contact_hero_whatsapp"
                        data-source="contact_hero"
                    >
                        Per WhatsApp schreiben
                    </a>
                </div>

                <div class="kontakt-desk-quick-links" aria-label="Schnellkontakte">
                    <a
                        id="contact-hero-phone"
                        href={`tel:${CONTACT_PHONE}`}
                        data-event="click_phone"
                        data-button-location="contact_hero_phone"
                    >
                        Anrufen: {CONTACT_PHONE_DISPLAY}
                    </a>
                    <a
                        href={`mailto:${CONTACT_EMAIL}`}
                        data-event="click_email"
                        data-button-location="contact_hero_email"
                    >
                        {CONTACT_EMAIL}
                    </a>
                </div>
            </div>

            <aside class="kontakt-desk-card" aria-labelledby="kontakt-direct-heading">
                <div class="kontakt-desk-card-header">
                    <p class="kontakt-desk-kicker">Direkt erreichbar</p>
                    <h2 id="kontakt-direct-heading">Wählen Sie den schnellsten Weg.</h2>
                    <p>Online buchen und WhatsApp sind die besten Wege für eine schnelle Terminabstimmung.</p>
                </div>

                <div class="kontakt-desk-paths">
                    {primaryPaths.map((path) => (
                        <a
                            id={path.id}
                            class={`kontakt-desk-path kontakt-desk-path--${path.variant}`}
                            href={path.href}
                            {...(path.external ? { target: '_blank', rel: 'noopener' } : {})}
                            data-event={path.event}
                            data-button-location={path.buttonLocation}
                            data-source="contact_direct"
                        >
                            <span>{path.eyebrow}</span>
                            <strong>{path.title}</strong>
                            <em>{path.copy}</em>
                            <b>{path.cta}</b>
                        </a>
                    ))}
                </div>
            </aside>
        </section>

        <section class="kontakt-desk-intents" aria-labelledby="kontakt-intent-heading">
            <div class="kontakt-desk-section-head">
                <p class="kontakt-desk-kicker">Wie dürfen wir Ihnen helfen?</p>
                <h2 id="kontakt-intent-heading">Der richtige Einstieg ohne Umwege.</h2>
            </div>

            <div class="kontakt-desk-intent-grid">
                {intentCards.map((intent) => (
                    <a
                        id={intent.id}
                        class="kontakt-desk-intent"
                        href={intent.href}
                        {...(intent.external ? { target: '_blank', rel: 'noopener' } : {})}
                        data-event={intent.event}
                        data-button-location={intent.buttonLocation}
                    >
                        <strong>{intent.title}</strong>
                        <span>{intent.copy}</span>
                        <em>{intent.cta}</em>
                    </a>
                ))}
            </div>
        </section>

        <section class="kontakt-desk-form-shell" aria-labelledby="kontakt-form-heading">
            <div class="kontakt-desk-form-copy">
                <p class="kontakt-desk-kicker">Persönliche Anfrage</p>
                <h2 id="kontakt-form-heading">Eine Nachricht an Teresa</h2>
                <p>
                    Beschreiben Sie kurz Ihr Anliegen oder Ihr Hautziel. Wir melden uns persönlich bei Ihnen zurück.
                </p>
                <p class="kontakt-desk-note">
                    Für dringende Terminänderungen bitte direkt per WhatsApp schreiben oder anrufen.
                </p>
            </div>

            <form id="kontakt-form" class="kontakt-form kontakt-desk-form" action="/api/contact" method="post">
                <div class="kontakt-field-grid">
                    <div class="kontakt-field kontakt-field--full">
                        <label for="contact-name">Name <span class="kontakt-required" aria-hidden="true">*</span></label>
                        <input id="contact-name" name="name" type="text" autocomplete="name" required />
                    </div>

                    <div class="kontakt-field kontakt-contact-fields kontakt-field--full" aria-describedby="contact-reach-note">
                        <p class="kontakt-field-group-label">Telefon oder E-Mail <span class="kontakt-required" aria-hidden="true">*</span></p>
                        <p id="contact-reach-note" class="kontakt-field-help">Bitte mindestens eine Kontaktangabe ausfüllen.</p>
                        <div class="kontakt-contact-field-grid">
                            <label for="contact-phone">
                                <span>Telefon</span>
                                <input id="contact-phone" name="phone" type="tel" autocomplete="tel" placeholder={CONTACT_PHONE_DISPLAY} />
                            </label>
                            <label for="contact-email">
                                <span>E-Mail</span>
                                <input id="contact-email" name="email" type="email" autocomplete="email" placeholder={CONTACT_EMAIL} />
                            </label>
                        </div>
                    </div>

                    <fieldset class="kontakt-field kontakt-choice-field kontakt-field--full">
                        <legend>Bevorzugter Kontaktweg <span class="kontakt-required" aria-hidden="true">*</span></legend>
                        <div class="kontakt-choice-grid">
                            <label>
                                <input type="radio" name="preferredContactMethod" value="WhatsApp" required />
                                <span>WhatsApp</span>
                            </label>
                            <label>
                                <input type="radio" name="preferredContactMethod" value="Telefon" />
                                <span>Telefon</span>
                            </label>
                            <label>
                                <input type="radio" name="preferredContactMethod" value="E-Mail" />
                                <span>E-Mail</span>
                            </label>
                        </div>
                    </fieldset>

                    <div class="kontakt-field kontakt-field--full">
                        <label for="contact-topic">Worum geht es? <span class="kontakt-required" aria-hidden="true">*</span></label>
                        <div class="kontakt-select">
                            <select id="contact-topic" name="topic" required>
                                <option value="">Bitte auswählen</option>
                                {CONTACT_TOPICS.map((topic) => (
                                    <option value={topic}>{topic}</option>
                                ))}
                            </select>
                            <svg class="kontakt-select-caret" width="12" height="8" viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1 L6 6 L11 1" stroke="currentColor" stroke-width="1" fill="none" stroke-linecap="square" /></svg>
                        </div>
                    </div>

                    <div class="kontakt-field kontakt-field--full">
                        <label for="contact-message">Ihre Nachricht <span class="kontakt-required" aria-hidden="true">*</span></label>
                        <textarea id="contact-message" name="message" required placeholder="Beschreiben Sie kurz Ihr Anliegen, Ihre Hautziele oder Ihre Frage."></textarea>
                    </div>
                </div>

                <div class="kontakt-field kontakt-honeypot" aria-hidden="true">
                    <label for="contact-company">Firma</label>
                    <input id="contact-company" name="company" type="text" tabindex="-1" autocomplete="off" />
                </div>

                {turnstileSiteKey && (
                    <>
                        <div
                            class="kontakt-turnstile"
                            data-turnstile-hosts={TURNSTILE_ALLOWED_HOSTS.join(',')}
                            data-turnstile-sitekey={turnstileSiteKey}
                        ></div>
                        <script is:inline>
                            (() => {
                                const mount = document.querySelector('.kontakt-turnstile[data-turnstile-hosts]');
                                if (!mount) return;

                                const hosts = (mount.dataset.turnstileHosts || '')
                                    .split(',')
                                    .map((host) => host.trim().toLowerCase())
                                    .filter(Boolean);

                                if (!hosts.includes(window.location.hostname.toLowerCase())) {
                                    mount.remove();
                                    return;
                                }

                                const widget = document.createElement('div');
                                widget.className = 'cf-turnstile';
                                widget.dataset.sitekey = mount.dataset.turnstileSitekey || '';
                                mount.append(widget);

                                const script = document.createElement('script');
                                script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
                                script.async = true;
                                script.defer = true;
                                document.head.append(script);
                            })();
                        </script>
                    </>
                )}

                <label class="kontakt-checkbox" for="contact-privacy">
                    <input id="contact-privacy" name="privacyConsent" type="checkbox" required />
                    <span>Ich habe die <a href="/datenschutz/">Datenschutzerklärung</a> gelesen und bin mit der Verarbeitung meiner Angaben zur Beantwortung meiner Anfrage einverstanden. <span class="kontakt-required" aria-hidden="true">*</span></span>
                </label>

                <div class="kontakt-form-actions">
                    <button
                        id="contact-form-submit"
                        type="submit"
                        class="pill-btn kontakt-submit"
                        data-event="form_submit"
                        data-button-location="contact_form_submit"
                    >
                        Anfrage an Teresa senden
                    </button>
                </div>
            </form>

            <aside class="kontakt-desk-sidebar" aria-label="Studio und direkte Kontaktdaten">
                <div class="kontakt-desk-person">
                    <Image
                        src={teresaPortrait}
                        widths={[240, 360, 520]}
                        sizes="(min-width: 901px) 320px, 100vw"
                        format="webp"
                        quality="high"
                        loading="lazy"
                        alt="Teresa von Beauty Face Lift Zürich"
                    />
                    <div>
                        <p class="kontakt-desk-kicker">Persönlich</p>
                        <h3>Nicht sicher, welche Behandlung passt?</h3>
                        <p>Teresa empfiehlt Ihnen den passenden nächsten Schritt für Ihr Hautziel.</p>
                    </div>
                </div>

                <div class="kontakt-desk-sidebar-card">
                    <h3>Beauty Face Lift Zürich</h3>
                    <address>
                        Bahnhofstrasse 94<br />
                        8001 Zürich<br />
                        Wenige Minuten vom Paradeplatz
                    </address>
                    <a
                        id="contact-card-route"
                        href={routeUrl}
                        target="_blank"
                        rel="noopener"
                        data-event="click_route"
                        data-button-location="contact_card_route"
                    >
                        Route planen
                    </a>
                </div>
            </aside>
        </section>

        <section class="kontakt-desk-studio" aria-labelledby="kontakt-studio-heading">
            <div class="kontakt-desk-section-head">
                <p class="kontakt-desk-kicker">Studio &amp; Anfahrt</p>
                <h2 id="kontakt-studio-heading">Zentral an der Bahnhofstrasse 94.</h2>
                <p>Beauty Face Lift befindet sich zentral in Zürich, nur wenige Minuten vom Paradeplatz und der Börsenstrasse entfernt.</p>
            </div>

            <div class="kontakt-desk-studio-grid">
                <article>
                    <span>Adresse</span>
                    <address>
                        Beauty Face Lift Zürich<br />
                        Bahnhofstrasse 94<br />
                        8001 Zürich
                    </address>
                </article>
                <article>
                    <span>Öffnungszeiten</span>
                    <div class="kontakt-hours">
                        {OPENING_HOURS.map((row) => (
                            <p>
                                <strong>{row.label}</strong>
                                <em>{row.value}</em>
                            </p>
                        ))}
                    </div>
                </article>
                <article>
                    <span>ÖV</span>
                    <p>Paradeplatz und Börsenstrasse sind in wenigen Minuten zu Fuss erreichbar.</p>
                </article>
                <article>
                    <span>Auto</span>
                    <p>Mehrere Innenstadt-Parkhäuser rund um Paradeplatz und Bleicherweg liegen nur wenige Gehminuten entfernt.</p>
                </article>
            </div>

            <a
                id="contact-route"
                class="kontakt-desk-route"
                href={routeUrl}
                target="_blank"
                rel="noopener"
                data-event="click_route"
                data-button-location="contact_studio_route"
            >
                <span>Google Maps</span>
                <strong>Route planen</strong>
            </a>
        </section>

        <nav class="kontakt-mobile-cta" aria-label="Schnelle Kontaktoptionen">
            <a
                href="https://buchung.treatwell.ch/ort/beauty-face-lift/"
                data-event="click_booking"
                data-button-location="contact_mobile_sticky_booking"
            >
                Termin
            </a>
            <a
                href={CONTACT_WHATSAPP_URL}
                target="_blank"
                rel="noopener"
                data-event="click_whatsapp"
                data-button-location="contact_mobile_sticky_whatsapp"
                data-source="contact_mobile_sticky"
            >
                WhatsApp
            </a>
            <a
                href={`tel:${CONTACT_PHONE}`}
                data-event="click_phone"
                data-button-location="contact_mobile_sticky_phone"
            >
                Anrufen
            </a>
        </nav>
    </main>

    <script is:inline>
        (() => {
            const stickyCta = document.querySelector('.kontakt-mobile-cta');
            const formShell = document.querySelector('.kontakt-desk-form-shell');

            if (!stickyCta || !formShell) return;

            const syncSticky = () => {
                const formRect = formShell.getBoundingClientRect();
                const isMobile = window.matchMedia('(max-width: 900px)').matches;
                const formNearViewport = formRect.top < window.innerHeight - 70 && formRect.bottom > 130;
                stickyCta.classList.toggle('is-visible', isMobile && window.scrollY > 440 && !formNearViewport);
            };

            window.addEventListener('scroll', syncSticky, { passive: true });
            window.addEventListener('resize', syncSticky);
            syncSticky();
        })();
    </script>
</Base>
