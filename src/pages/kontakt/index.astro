        .kontakt-section,
        .kontakt-final {
            padding-left: var(--content-px);
            padding-right: var(--content-px);
        }

        .kontakt-hero {
            display: grid;
            grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.72fr);
            gap: 72px;
            align-items: center;
            max-width: 1240px;
            margin: 0 auto;
            padding-top: 64px;
            padding-bottom: 92px;
        }

        .kontakt-hero-copy {
            max-width: 720px;
        }

        .kontakt-eyebrow {
            display: flex;
            align-items: center;
            gap: 14px;
            margin: 0 0 24px;
            font-family: var(--font-mono);
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 0.18em;
            line-height: 1.2;
            text-transform: uppercase;
