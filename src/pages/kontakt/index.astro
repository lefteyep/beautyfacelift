            box-shadow: var(--shadow-1);
        }

        .kontakt-hero-media figcaption {
            max-width: 32ch;
            margin-top: 14px;
            font-size: 13px;
            line-height: 1.55;
            color: var(--ink-3);
        }

        .kontakt-section {
            max-width: 1240px;
            margin: 0 auto;
            padding-top: 86px;
            padding-bottom: 86px;
            border-top: 1px solid rgba(28, 26, 23, 0.08);
        }

        .kontakt-section-heading {
            max-width: 720px;
            margin-bottom: 42px;
        }

        .kontakt-section-heading h2,
        .kontakt-form-intro-block h2,
        .kontakt-trust-copy h2,
        .kontakt-final h2 {
            font-size: 3.4rem;
            line-height: 1.05;
        }

        .kontakt-section-heading p,
        .kontakt-form-intro-block p,
        .kontakt-trust-copy p,
        .kontakt-final p {
            margin: 18px 0 0;
            max-width: 700px;
            font-size: 17px;
            line-height: 1.68;
            color: var(--ink-2);
        }

        .kontakt-method-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 18px;
        }

        .kontakt-method-card {
            display: flex !important;
            min-height: 310px;
            flex-direction: column;
            justify-content: space-between;
            gap: 26px;
            padding: 28px;
            border: 1px solid rgba(28, 26, 23, 0.1);
            border-radius: var(--r-md);
            background: var(--bone);
            color: var(--ink);
            transition: transform 0.25s var(--ease-expo), border-color 0.25s var(--ease-expo), background 0.25s var(--ease-expo);
        }

        .kontakt-method-card:hover,
        .kontakt-method-card:focus-visible {
            transform: translateY(-3px);
            border-color: rgba(185, 143, 71, 0.55);
            background: #fffaf2;
        }

        .kontakt-method-card--primary {
            background: var(--ink);
            color: var(--paper);
            border-color: var(--ink);
        }

        .kontakt-method-card--primary:hover,
        .kontakt-method-card--primary:focus-visible {
            background: var(--ink-2);
            color: var(--paper);
        }

        .kontakt-method-card--secondary {
            border-color: rgba(185, 143, 71, 0.42);
            background: #fbf4e8;
        }

        .kontakt-card-icon {
            display: inline-flex;
            width: 42px;
            height: 42px;
            align-items: center;
            justify-content: center;
            border: 1px solid currentColor;
            border-radius: 50%;
            color: var(--gold-deep);
        }

        .kontakt-method-card--primary .kontakt-card-icon {
            color: var(--gold-soft);
        }

        .kontakt-card-icon svg {
