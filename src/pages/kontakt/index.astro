        }

        .kontakt-text-link {
            display: inline-flex !important;
            margin-top: 18px;
            color: var(--ink-2);
            font-size: 15px;
            line-height: 1.45;
            text-decoration: underline;
            text-decoration-color: rgba(185, 143, 71, 0.58);
            text-underline-offset: 5px;
        }

        .kontakt-text-link:hover,
        .kontakt-text-link:focus-visible {
            color: var(--gold-deep);
        }

        .kontakt-trust-strip {
            display: flex;
            flex-wrap: wrap;
            gap: 10px 18px;
            margin: 34px 0 0;
            padding: 20px 0 0;
            border-top: 1px solid var(--border-medium);
            list-style: none;
            color: var(--ink-3);
            font-family: var(--font-mono);
            font-size: 11px;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .kontakt-trust-strip li {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .kontakt-trust-strip li:not(:last-child)::after {
            content: '';
