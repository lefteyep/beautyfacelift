---
import Base from '../../layouts/Base.astro';
import {
    ADDRESS,
    CONTACT_EMAIL,
    CONTACT_PHONE,
    CONTACT_PHONE_DISPLAY,
    CONTACT_TOPICS,
    CONTACT_WHATSAPP_URL,
    FULL_ADDRESS,
    OPENING_HOURS,
} from '../../../shared/site';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim() ?? '';

const structuredData = {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": "Kontakt | Beauty Face Lift",
    "url": "https://beautyfacelift.ch/kontakt/",
    "mainEntity": {
        "@type": "HealthAndBeautyBusiness",
        "name": "Beauty Face Lift",
        "telephone": CONTACT_PHONE,
        "email": CONTACT_EMAIL,
        "address": {
            "@type": "PostalAddress",
            "streetAddress": ADDRESS.street,
            "addressLocality": ADDRESS.city,
            "postalCode": ADDRESS.postalCode,
            "addressCountry": ADDRESS.country,
        },
        "openingHoursSpecification": [
            { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], "opens": "09:00", "closes": "18:00" },
            { "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "10:00", "closes": "16:00" },
        ],
        "contactPoint": {
            "@type": "ContactPoint",
            "telephone": CONTACT_PHONE,
            "email": CONTACT_EMAIL,
            "contactType": "customer service",
            "availableLanguage": ["de", "en"],
            "areaServed": "CH"
        }
    }
};
---

<Base
    title="Kontakt | Beauty Face Lift Zürich"
    description="Kontaktieren Sie Beauty Face Lift an der Bahnhofstrasse 94 in Zürich. Telefon, WhatsApp, E-Mail und Kontaktformular für Erstberatung, Terminfragen und Studioanfragen."
    structuredData={structuredData}
>
    <section class="contact-page">
        <div class="contact-intro">
            <div class="contact-intro-copy">
                <span class="sub-display">Kontakt & Beratung</span>
                <h1 style="font-size: clamp(2.75rem, 6vw, 5rem); margin: 0;">Direkter Kontakt für Fragen, Erstberatung und Terminwünsche.</h1>
                <p>Wenn Sie unsicher sind, welche Behandlung zu Ihrem Hautbild passt, unterstützen wir Sie gerne persönlich. Sie erreichen uns telefonisch, per WhatsApp, per E-Mail oder über das Kontaktformular. Für Erstberatungen, Rückfragen vor der Buchung und organisatorische Anliegen ist die Kontaktseite der schnellste Weg.</p>
                <p>Wir melden uns so rasch wie möglich zurück. Für Terminverschiebungen oder kurzfristige Absagen ist ein kurzer Anruf oder eine WhatsApp-Nachricht meist am effizientesten.</p>
            </div>

            <div class="contact-card-grid">
                <article class="contact-card">
                    <span class="sub-display">Telefon</span>
                    <h2>{CONTACT_PHONE_DISPLAY}</h2>
                    <p>Für Rückfragen, Terminänderungen und kurze Anliegen.</p>
                    <a class="contact-card-action" href={`tel:${CONTACT_PHONE}`}>Jetzt anrufen</a>
                </article>
                <article class="contact-card">
                    <span class="sub-display">WhatsApp</span>
                    <h2>Schnell schreiben</h2>
                    <p>Ideal für kurze Rückfragen und Terminwünsche unterwegs.</p>
                    <a class="contact-card-action" href={CONTACT_WHATSAPP_URL} target="_blank" rel="noopener">WhatsApp öffnen</a>
                </article>
                <article class="contact-card">
                    <span class="sub-display">E-Mail</span>
                    <h2>{CONTACT_EMAIL}</h2>
                    <p>Für ausführlichere Fragen, Unterlagen oder Rückrufwünsche.</p>
                    <a class="contact-card-action" href={`mailto:${CONTACT_EMAIL}`}>E-Mail schreiben</a>
                </article>
                <article class="contact-card">
                    <span class="sub-display">Termin</span>
                    <h2>Direkt buchen</h2>
                    <p>Wenn Sie bereits wissen, welche Behandlung Sie möchten.</p>
                    <a class="contact-card-action" href="/termin/">Zur Online-Buchung</a>
                </article>
            </div>
        </div>

        <div class="contact-grid">
            <div class="contact-meta-column">
                <article class="contact-meta-card">
                    <span class="sub-display">Studio & Anfahrt</span>
                    <h2>{FULL_ADDRESS}</h2>
                    <ul class="contact-meta-list">
                        <li>
                            <span class="contact-meta-label">Adresse</span>
                            <p>{ADDRESS.street}<br />{ADDRESS.postalCode} {ADDRESS.city}</p>
                        </li>
                        <li>
                            <span class="contact-meta-label">Öffnungszeiten</span>
                            {OPENING_HOURS.map((hours) => (
                                <p><strong>{hours.label}:</strong> {hours.value}</p>
                            ))}
                        </li>
                        <li>
                            <span class="contact-meta-label">ÖV</span>
                            <p>Paradeplatz und Börsenstrasse sind in wenigen Minuten zu Fuss erreichbar. Damit ist das Studio aus allen Richtungen der Stadt unkompliziert erreichbar.</p>
                        </li>
                        <li>
                            <span class="contact-meta-label">Parkieren</span>
                            <p>Mehrere Innenstadt-Parkhäuser rund um Paradeplatz und Bleicherweg liegen nur wenige Gehminuten entfernt. Für die Anfahrt mit dem Auto empfehlen wir etwas zeitlichen Puffer.</p>
                        </li>
                    </ul>
                </article>

                <article class="contact-guidance">
                    <span class="sub-display">Gut zu wissen</span>
                    <h2>Wofür Sie uns am besten kontaktieren</h2>
                    <ul class="contact-guidance-list">
                        <li>
                            <p><strong>Erstberatung:</strong> Wenn Sie zwischen Hydrafacial, Microneedling, Peeling oder ColdPlasma schwanken, beschreiben Sie uns kurz Ihr Hautziel und Ihre Hauptanliegen.</p>
                        </li>
                        <li>
                            <p><strong>Terminfragen:</strong> Für Terminverschiebungen, Absagen oder einen bevorzugten Rückrufzeitpunkt bitten wir um eine Telefonnummer, unter der wir Sie zuverlässig erreichen.</p>
                        </li>
                        <li>
                            <p><strong>Vor dem ersten Termin:</strong> Teilen Sie uns bitte mit, ob es sensible Haut, bekannte Unverträglichkeiten, aktive Akne, Rosazea oder aktuelle Medikamente gibt. So können wir Sie sauber vorbereiten.</p>
                        </li>
                    </ul>
                </article>
            </div>

            <article class="contact-form-shell">
                <span class="sub-display">Kontaktformular</span>
                <h2>Nachricht senden</h2>
                <p class="contact-helper">Pflichtfelder sind markiert. Sie können entweder eine E-Mail-Adresse, eine Telefonnummer oder beides hinterlassen. Ohne JavaScript funktioniert das Formular ebenfalls.</p>

                <form class="contact-form" action="/api/contact" method="post">
                    <div class="contact-field-grid">
                        <div class="contact-field">
                            <label for="contact-name">Name *</label>
                            <input id="contact-name" name="name" type="text" autocomplete="name" required />
                        </div>
                        <div class="contact-field">
                            <label for="contact-topic">Thema *</label>
                            <select id="contact-topic" name="topic" required>
                                <option value="">Bitte auswählen</option>
                                {CONTACT_TOPICS.map((topic) => (
                                    <option value={topic}>{topic}</option>
                                ))}
                            </select>
                        </div>
                        <div class="contact-field">
                            <label for="contact-email">E-Mail</label>
                            <input id="contact-email" name="email" type="email" autocomplete="email" />
                        </div>
                        <div class="contact-field">
                            <label for="contact-phone">Telefon</label>
                            <input id="contact-phone" name="phone" type="tel" autocomplete="tel" />
                        </div>
                        <div class="contact-field contact-field--full">
                            <label for="contact-callback">Bevorzugter Rückrufzeitpunkt</label>
                            <input id="contact-callback" name="preferredCallbackTime" type="text" placeholder="z. B. werktags zwischen 12:00 und 14:00 Uhr" />
                        </div>
                        <div class="contact-field contact-field--full">
                            <label for="contact-message">Nachricht *</label>
                            <textarea id="contact-message" name="message" required placeholder="Worum geht es? Beschreiben Sie bitte kurz Ihr Anliegen, Ihre Hautziele oder Ihre Frage."></textarea>
                        </div>
                    </div>

                    <div class="contact-field contact-field--full" style="position: absolute; left: -9999px;" aria-hidden="true">
                        <label for="contact-company">Firma</label>
                        <input id="contact-company" name="company" type="text" tabindex="-1" autocomplete="off" />
                    </div>

                    <div class="contact-turnstile">
                        {turnstileSiteKey ? (
                            <>
                                <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
                                <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
                            </>
                        ) : (
                            <p class="contact-form-note">Turnstile ist lokal noch nicht konfiguriert. Für Produktion bitte `PUBLIC_TURNSTILE_SITE_KEY` und `TURNSTILE_SECRET_KEY` setzen.</p>
                        )}
                    </div>

                    <label class="contact-checkbox" for="contact-privacy">
                        <input id="contact-privacy" name="privacyConsent" type="checkbox" required />
                        <span>Ich habe die <a href="/datenschutz/">Datenschutzerklärung</a> gelesen und bin mit der Verarbeitung meiner Angaben zur Beantwortung meiner Anfrage einverstanden. *</span>
                    </label>

                    <div class="contact-form-actions">
                        <button type="submit" class="pill-btn">Nachricht senden</button>
                        <p class="contact-form-note">Für dringende Terminänderungen bitte direkt anrufen oder per WhatsApp schreiben.</p>
                    </div>
                </form>
            </article>
        </div>
    </section>
</Base>
