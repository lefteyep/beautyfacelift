---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { consultationTrust } from '../../lib/site-images';
import {
    absoluteUrl,
    ADDRESS,
    CONTACT_EMAIL,
    CONTACT_PHONE,
    CONTACT_PHONE_DISPLAY,
    CONTACT_TOPICS,
    CONTACT_WHATSAPP_URL,
    FULL_ADDRESS,
    OPENING_HOURS,
    TREATWELL_URL,
} from '../../../shared/site';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim() ?? '';
const routeUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(FULL_ADDRESS)}`;
const instagramUrl = 'https://www.instagram.com/beautyfacelift.zh/';

const openingHoursSpecification = [
    {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
        opens: '09:00',
        closes: '18:00',
    },
    {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: 'Saturday',
        opens: '10:00',
        closes: '16:00',
    },
];

const contactLinks = [
    {
        id: 'contact-card-whatsapp',
        label: 'WhatsApp',
        value: 'Per WhatsApp schreiben',
        href: CONTACT_WHATSAPP_URL,
        event: 'click_whatsapp',
        buttonLocation: 'contact_card_whatsapp',
        external: true,
    },
    {
        id: 'contact-card-phone',
        label: 'Telefon',
        value: CONTACT_PHONE_DISPLAY,
        href: `tel:${CONTACT_PHONE}`,
        event: 'click_phone',
        buttonLocation: 'contact_card_phone',
    },
    {
        id: 'contact-card-email',
        label: 'E-Mail',
        value: CONTACT_EMAIL,
        href: `mailto:${CONTACT_EMAIL}`,
        event: 'click_email',
        buttonLocation: 'contact_card_email',
    },
    {
        id: 'contact-card-route',
        label: 'Route',
        value: 'Bahnhofstrasse 94',
        href: routeUrl,
        event: 'click_route',
        buttonLocation: 'contact_card_route',
        external: true,
    },
];

const structuredData = {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Kontakt & Termin buchen bei Beauty Face Lift Zürich',
    url: absoluteUrl('/kontakt/'),
    mainEntity: {
        '@type': 'BeautySalon',
        name: 'Beauty Face Lift Zürich',
        url: absoluteUrl('/'),
        image: absoluteUrl('/assets/hero_editorial_portrait.png'),
        telephone: CONTACT_PHONE,
        email: CONTACT_EMAIL,
        hasMap: routeUrl,
        address: {
            '@type': 'PostalAddress',
            streetAddress: ADDRESS.street,
            addressLocality: ADDRESS.city,
            postalCode: ADDRESS.postalCode,
            addressCountry: ADDRESS.country,
        },
        contactPoint: [
            {
                '@type': 'ContactPoint',
                contactType: 'customer service',
                telephone: CONTACT_PHONE,
                email: CONTACT_EMAIL,
                availableLanguage: ['de-CH', 'de'],
            },
        ],
        openingHoursSpecification,
        sameAs: [instagramUrl, TREATWELL_URL],
        areaServed: ['Zürich', 'Switzerland'],
    },
};
---

<Base
    title="Kontakt & Termin buchen Zürich | Beauty Face Lift Bahnhofstrasse"
    description="Kontaktieren Sie Beauty Face Lift Zürich an der Bahnhofstrasse 94. Termin online buchen, per WhatsApp schreiben oder persönliche Beratung bei Teresa anfragen."
    structuredData={structuredData}
>
    <section class="kontakt kontakt-clean" aria-labelledby="kontakt-heading">
        <header class="kontakt-clean-hero">
            <div class="kontakt-clean-copy">
                <p class="kontakt-clean-kicker">Beauty Face Lift Zürich</p>
                <h1 id="kontakt-heading">Kontakt &amp; Termin buchen bei Beauty Face Lift Zürich</h1>
                <p class="kontakt-clean-lead">
                    Sie möchten einen Termin vereinbaren oder sind unsicher, welche Behandlung zu Ihrem Hautbild passt? Teresa berät Sie persönlich per WhatsApp, Telefon, E-Mail oder direkt im Studio an der Bahnhofstrasse 94 in Zürich.
                </p>
                <p class="kontakt-clean-location">Bahnhofstrasse 94 · 8001 Zürich · wenige Minuten vom Paradeplatz</p>

                <div class="kontakt-clean-actions" aria-label="Wichtigste Kontaktoptionen">
                    <a
                        id="contact-hero-booking"
                        class="pill-btn kontakt-clean-primary"
                        href="/termin/"
                        data-event="click_booking"
                        data-button-location="contact_hero_booking"
                    >
                        Jetzt Termin buchen
                    </a>
                    <a
                        id="contact-hero-whatsapp"
                        class="pill-btn pill-btn-outline kontakt-clean-secondary"
                        href={CONTACT_WHATSAPP_URL}
                        target="_blank"
                        rel="noopener"
                        data-event="click_whatsapp"
                        data-button-location="contact_hero_whatsapp"
                        data-source="contact_hero"
                    >
                        Per WhatsApp schreiben
                    </a>
                </div>

                <a
                    id="contact-hero-phone"
                    class="kontakt-clean-phone"
                    href={`tel:${CONTACT_PHONE}`}
                    data-event="click_phone"
                    data-button-location="contact_hero_phone"
                >
                    Anrufen: {CONTACT_PHONE_DISPLAY}
                </a>
            </div>

            <aside class="kontakt-clean-panel" aria-labelledby="kontakt-direct-heading">
                <div>
                    <p class="kontakt-clean-kicker">Direkt erreichbar</p>
                    <h2 id="kontakt-direct-heading">Der schnellste Weg zu Teresa</h2>
                    <p>Online buchen, kurz per WhatsApp schreiben oder direkt anrufen.</p>
                </div>

                <div class="kontakt-clean-link-list">
                    {contactLinks.map((link) => (
                        <a
                            id={link.id}
                            href={link.href}
                            {...(link.external ? { target: '_blank', rel: 'noopener' } : {})}
                            data-event={link.event}
                            data-button-location={link.buttonLocation}
                            data-source="contact_direct"
                        >
                            <span>{link.label}</span>
                            <strong>{link.value}</strong>
                        </a>
                    ))}
                </div>

                <div class="kontakt-clean-panel-actions">
                    <a
                        id="contact-card-booking"
                        class="pill-btn"
                        href="/termin/"
                        data-event="click_booking"
                        data-button-location="contact_card_booking"
                    >
                        Termin buchen
                    </a>
                    <a
                        class="pill-btn pill-btn-outline"
                        href="#kontakt-form"
                        id="contact-card-form"
                        data-event="click_form_intent"
                        data-button-location="contact_card_form"
                    >
                        Nachricht senden
                    </a>
                </div>
            </aside>
        </header>

        <section class="kontakt-clean-form-section" aria-labelledby="kontakt-form-heading">
            <div class="kontakt-clean-form-intro">
                <p class="kontakt-clean-kicker">Persönliche Anfrage</p>
                <h2 id="kontakt-form-heading">Eine Nachricht an Teresa</h2>
                <p>Beschreiben Sie kurz Ihr Anliegen oder Ihr Hautziel. Wir melden uns persönlich bei Ihnen zurück.</p>
                <p class="kontakt-clean-note">Für dringende Terminänderungen bitte direkt per WhatsApp schreiben oder anrufen.</p>
            </div>

            <form id="kontakt-form" class="kontakt-form kontakt-clean-form" action="/api/contact" method="post">
                <div class="kontakt-field-grid">
                    <div class="kontakt-field kontakt-field--full">
                        <label for="contact-name">Name <span class="kontakt-required" aria-hidden="true">*</span></label>
                        <input id="contact-name" name="name" type="text" autocomplete="name" required />
                    </div>

                    <div class="kontakt-field kontakt-contact-fields kontakt-field--full" aria-describedby="contact-reach-note">
                        <p class="kontakt-field-group-label">Telefon oder E-Mail <span class="kontakt-required" aria-hidden="true">*</span></p>
                        <p id="contact-reach-note" class="kontakt-field-help">Bitte mindestens eine Kontaktangabe ausfüllen.</p>
                        <div class="kontakt-contact-field-grid">
                            <label for="contact-phone">
                                <span>Telefon</span>
                                <input id="contact-phone" name="phone" type="tel" autocomplete="tel" placeholder={CONTACT_PHONE_DISPLAY} />
                            </label>
                            <label for="contact-email">
                                <span>E-Mail</span>
                                <input id="contact-email" name="email" type="email" autocomplete="email" placeholder={CONTACT_EMAIL} />
                            </label>
                        </div>
                    </div>

                    <div class="kontakt-field">
                        <label for="contact-preferred-method">Bevorzugter Kontaktweg <span class="kontakt-required" aria-hidden="true">*</span></label>
                        <div class="kontakt-select">
                            <select id="contact-preferred-method" name="preferredContactMethod" required>
                                <option value="">Bitte auswählen</option>
                                <option value="WhatsApp">WhatsApp</option>
                                <option value="Telefon">Telefon</option>
                                <option value="E-Mail">E-Mail</option>
                            </select>
                            <svg class="kontakt-select-caret" width="12" height="8" viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1 L6 6 L11 1" stroke="currentColor" stroke-width="1" fill="none" stroke-linecap="square" /></svg>
                        </div>
                    </div>

                    <div class="kontakt-field">
                        <label for="contact-topic">Worum geht es? <span class="kontakt-required" aria-hidden="true">*</span></label>
                        <div class="kontakt-select">
                            <select id="contact-topic" name="topic" required>
                                <option value="">Bitte auswählen</option>
                                {CONTACT_TOPICS.map((topic) => (
                                    <option value={topic}>{topic}</option>
                                ))}
                            </select>
                            <svg class="kontakt-select-caret" width="12" height="8" viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1 L6 6 L11 1" stroke="currentColor" stroke-width="1" fill="none" stroke-linecap="square" /></svg>
                        </div>
                    </div>

                    <div class="kontakt-field kontakt-field--full">
                        <label for="contact-callback">Bevorzugter Rückrufzeitpunkt</label>
                        <input id="contact-callback" name="preferredCallbackTime" type="text" placeholder="z. B. werktags zwischen 12:00 und 14:00 Uhr" />
                    </div>

                    <div class="kontakt-field kontakt-field--full">
                        <label for="contact-message">Ihre Nachricht <span class="kontakt-required" aria-hidden="true">*</span></label>
                        <textarea id="contact-message" name="message" required placeholder="Beschreiben Sie kurz Ihr Anliegen, Ihre Hautziele oder Ihre Frage."></textarea>
                    </div>
                </div>

                <div class="kontakt-field kontakt-honeypot" aria-hidden="true">
                    <label for="contact-company">Firma</label>
                    <input id="contact-company" name="company" type="text" tabindex="-1" autocomplete="off" />
                </div>

                {turnstileSiteKey && (
                    <div class="kontakt-turnstile">
                        <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
                        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
                    </div>
                )}

                <label class="kontakt-checkbox" for="contact-privacy">
                    <input id="contact-privacy" name="privacyConsent" type="checkbox" required />
                    <span>Ich habe die <a href="/datenschutz/">Datenschutzerklärung</a> gelesen und bin mit der Verarbeitung meiner Angaben zur Beantwortung meiner Anfrage einverstanden. <span class="kontakt-required" aria-hidden="true">*</span></span>
                </label>

                <div class="kontakt-form-actions">
                    <button
                        id="contact-form-submit"
                        type="submit"
                        class="pill-btn kontakt-submit"
                        data-event="form_submit"
                        data-button-location="contact_form_submit"
                    >
                        Anfrage an Teresa senden
                    </button>
                </div>
            </form>
        </section>

        <section class="kontakt-clean-support" aria-labelledby="kontakt-support-heading">
            <div class="kontakt-clean-support-copy">
                <p class="kontakt-clean-kicker">Behandlungsempfehlung</p>
                <h2 id="kontakt-support-heading">Nicht sicher, welche Behandlung passt?</h2>
                <p>Viele Kundinnen wissen vor dem ersten Termin nicht genau, ob Hydrafacial, Microneedling, Peeling, ColdPlasma oder eine andere Behandlung die richtige Wahl ist. Teresa empfiehlt Ihnen den passenden nächsten Schritt für Ihr Hautziel.</p>
                <a
                    class="pill-btn pill-btn-outline"
                    href="#kontakt-form"
                    data-event="click_form_intent"
                    data-button-location="contact_support_recommendation"
                >
                    Behandlungsempfehlung anfragen
                </a>
            </div>
            <div class="kontakt-clean-support-image">
                <Image
                    src={consultationTrust}
                    widths={[420, 640, 840]}
                    sizes="(min-width: 901px) 38vw, 100vw"
                    format="webp"
                    quality="high"
                    loading="lazy"
                    alt="Persönliche Hautberatung bei Beauty Face Lift Zürich"
                />
            </div>
        </section>

        <section class="kontakt-clean-studio" aria-labelledby="kontakt-studio-heading">
            <div class="kontakt-clean-studio-heading">
                <p class="kontakt-clean-kicker">Studio &amp; Anfahrt</p>
                <h2 id="kontakt-studio-heading">Bahnhofstrasse 94 in Zürich</h2>
                <p>Beauty Face Lift befindet sich zentral an der Bahnhofstrasse 94 in Zürich, wenige Minuten vom Paradeplatz und der Börsenstrasse entfernt.</p>
            </div>

            <div class="kontakt-clean-studio-grid">
                <article>
                    <span>Adresse</span>
                    <address>
                        Beauty Face Lift Zürich<br />
                        Bahnhofstrasse 94<br />
                        8001 Zürich
                    </address>
                </article>
                <article>
                    <span>Öffnungszeiten</span>
                    <div class="kontakt-hours">
                        {OPENING_HOURS.map((row) => (
                            <p>
                                <strong>{row.label}</strong>
                                <em>{row.value}</em>
                            </p>
                        ))}
                    </div>
                </article>
                <article>
                    <span>ÖV</span>
                    <p>Paradeplatz und Börsenstrasse sind in wenigen Minuten zu Fuss erreichbar.</p>
                </article>
                <article>
                    <span>Auto</span>
                    <p>Mehrere Innenstadt-Parkhäuser rund um Paradeplatz und Bleicherweg liegen nur wenige Gehminuten entfernt.</p>
                </article>
            </div>

            <a
                id="contact-route"
                class="kontakt-clean-route"
                href={routeUrl}
                target="_blank"
                rel="noopener"
                data-event="click_route"
                data-button-location="contact_studio_route"
            >
                <span>Google Maps</span>
                <strong>Route planen</strong>
            </a>
        </section>

        <nav class="kontakt-mobile-cta" aria-label="Schnelle Kontaktoptionen">
            <a
                href="/termin/"
                data-event="click_booking"
                data-button-location="contact_mobile_sticky_booking"
            >
                Termin
            </a>
            <a
                href={CONTACT_WHATSAPP_URL}
                target="_blank"
                rel="noopener"
                data-event="click_whatsapp"
                data-button-location="contact_mobile_sticky_whatsapp"
                data-source="contact_mobile_sticky"
            >
                WhatsApp
            </a>
            <a
                href={`tel:${CONTACT_PHONE}`}
                data-event="click_phone"
                data-button-location="contact_mobile_sticky_phone"
            >
                Anrufen
            </a>
        </nav>
    </section>

    <script is:inline>
        (() => {
            const stickyCta = document.querySelector('.kontakt-mobile-cta');
            const formSection = document.querySelector('.kontakt-clean-form-section');

            if (!stickyCta || !formSection) return;

            const syncSticky = () => {
                const formRect = formSection.getBoundingClientRect();
                const formNearViewport = formRect.top < window.innerHeight - 80 && formRect.bottom > 120;
                stickyCta.classList.toggle('is-visible', window.scrollY > 520 && !formNearViewport);
            };

            window.addEventListener('scroll', syncSticky, { passive: true });
            window.addEventListener('resize', syncSticky);
            syncSticky();
        })();
    </script>
</Base>
