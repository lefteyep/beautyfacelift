            height: 4px;
            border-radius: 50%;
            background: var(--gold);
            opacity: 0.7;
        }

        .kontakt-hero-media {
            margin: 0;
        }

        .kontakt-hero-media :global(img) {
            width: 100%;
            aspect-ratio: 4 / 5;
