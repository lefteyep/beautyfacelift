---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { consultationTrust } from '../../lib/site-images';
import {
    absoluteUrl,
    ADDRESS,
    CONTACT_EMAIL,
    CONTACT_PHONE,
    CONTACT_PHONE_DISPLAY,
    CONTACT_TOPICS,
    CONTACT_WHATSAPP_URL,
    FULL_ADDRESS,
    OPENING_HOURS,
    TREATWELL_URL,
} from '../../../shared/site';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim() ?? '';
const routeUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(FULL_ADDRESS)}`;
const instagramUrl = 'https://www.instagram.com/beautyfacelift.zh/';

const openingHoursSpecification = [
    {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
        opens: '09:00',
        closes: '18:00',
    },
    {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: 'Saturday',
        opens: '10:00',
        closes: '16:00',
    },
];

const intentCards = [
    {
        title: 'Ich möchte einen Termin buchen',
        copy: 'Für Kundinnen, die bereits wissen, welche Behandlung sie buchen möchten.',
        cta: 'Termin buchen',
        href: '/termin/',
        id: 'contact-intent-booking',
        event: 'click_booking',
        buttonLocation: 'contact_intent_booking',
    },
    {
        title: 'Ich bin unsicher, welche Behandlung passt',
        copy: 'Teresa empfiehlt Ihnen den passenden nächsten Schritt für Ihr Hautziel.',
        cta: 'Behandlungsempfehlung anfragen',
        href: '#kontakt-form',
        id: 'contact-intent-recommendation',
        event: 'click_form_intent',
        buttonLocation: 'contact_intent_recommendation',
    },
    {
        title: 'Ich habe eine Frage vor meinem ersten Termin',
        copy: 'Ideal bei sensibler Haut, Unsicherheit oder speziellen Anliegen vor der Behandlung.',
        cta: 'Frage stellen',
        href: '#kontakt-form',
        id: 'contact-intent-question',
        event: 'click_form_intent',
        buttonLocation: 'contact_intent_question',
    },
    {
        title: 'Ich möchte einen Termin verschieben',
        copy: 'Für kurzfristige Änderungen bitte direkt per WhatsApp schreiben oder anrufen.',
        cta: 'WhatsApp öffnen',
        href: CONTACT_WHATSAPP_URL,
        id: 'contact-intent-reschedule',
        event: 'click_whatsapp',
        buttonLocation: 'contact_intent_reschedule',
        external: true,
    },
];

const structuredData = {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Kontakt & Termin buchen bei Beauty Face Lift Zürich',
    url: absoluteUrl('/kontakt/'),
    mainEntity: {
        '@type': 'BeautySalon',
        name: 'Beauty Face Lift Zürich',
        url: absoluteUrl('/'),
        image: absoluteUrl('/assets/hero_editorial_portrait.png'),
        telephone: CONTACT_PHONE,
        email: CONTACT_EMAIL,
        hasMap: routeUrl,
        address: {
            '@type': 'PostalAddress',
            streetAddress: ADDRESS.street,
            addressLocality: ADDRESS.city,
            postalCode: ADDRESS.postalCode,
            addressCountry: ADDRESS.country,
        },
        contactPoint: [
            {
                '@type': 'ContactPoint',
                contactType: 'customer service',
                telephone: CONTACT_PHONE,
                email: CONTACT_EMAIL,
                availableLanguage: ['de-CH', 'de'],
            },
        ],
        "openingHoursSpecification": openingHoursSpecification,
        "sameAs": [instagramUrl, TREATWELL_URL],
        areaServed: ['Zürich', 'Switzerland'],
    },
};
---

<Base
    title="Kontakt & Termin buchen Zürich | Beauty Face Lift Bahnhofstrasse"
    description="Kontaktieren Sie Beauty Face Lift Zürich an der Bahnhofstrasse 94. Termin online buchen, per WhatsApp schreiben oder persönliche Beratung bei Teresa anfragen."
    structuredData={structuredData}
>
    <section class="kontakt" aria-labelledby="kontakt-heading">
        <header class="kontakt-hero">
            <div class="kontakt-hero-inner">
                <div class="kontakt-hero-copy">
                    <h1 id="kontakt-heading" class="kontakt-display">Kontakt &amp; Termin buchen bei Beauty Face Lift Zürich</h1>
                    <p class="kontakt-hero-subheadline">
                        Sie möchten einen Termin vereinbaren oder sind unsicher, welche Behandlung zu Ihrem Hautbild passt? Teresa berät Sie persönlich — per WhatsApp, Telefon, E-Mail oder direkt im Studio an der Bahnhofstrasse 94 in Zürich.
                    </p>
                    <p class="kontakt-hero-micro">Bahnhofstrasse 94 · 8001 Zürich · wenige Minuten vom Paradeplatz</p>
                    <div class="kontakt-hero-actions">
                        <a
                            id="contact-hero-booking"
                            class="pill-btn kontakt-primary-cta"
                            href="/termin/"
                            data-event="click_booking"
                            data-button-location="contact_hero_booking"
                        >
                            Jetzt Termin buchen
                        </a>
                        <a
                            id="contact-hero-whatsapp"
                            class="pill-btn pill-btn-outline kontakt-secondary-cta"
                            href={CONTACT_WHATSAPP_URL}
                            target="_blank"
                            rel="noopener"
                            data-event="click_whatsapp"
                            data-button-location="contact_hero_whatsapp"
                            data-source="contact_hero"
                        >
                            Per WhatsApp schreiben
                        </a>
                    </div>
                    <a
                        id="contact-hero-phone"
                        class="kontakt-hero-phone"
                        href={`tel:${CONTACT_PHONE}`}
                        data-event="click_phone"
                        data-button-location="contact_hero_phone"
                    >
                        Anrufen: {CONTACT_PHONE_DISPLAY}
                    </a>
                </div>

                <aside class="kontakt-concierge-card" aria-label="Beauty Face Lift Zürich Kontaktkarte">
                    <div class="kontakt-card-header">
                        <p class="kontakt-card-kicker">Premium Beauty Concierge</p>
                        <h2>Beauty Face Lift Zürich</h2>
                        <address>
                            Bahnhofstrasse 94<br />
                            8001 Zürich<br />
                            <span>Wenige Minuten vom Paradeplatz</span>
                        </address>
                    </div>

                    <div class="kontakt-card-rows" aria-label="Direkte Kontaktmöglichkeiten">
                        <a
                            id="contact-card-whatsapp"
                            href={CONTACT_WHATSAPP_URL}
                            target="_blank"
                            rel="noopener"
                            data-event="click_whatsapp"
                            data-button-location="contact_card_whatsapp"
                            data-source="contact_card"
                        >
                            <span>WhatsApp</span>
                            <strong>Direkt schreiben</strong>
                        </a>
                        <a
                            id="contact-card-phone"
                            href={`tel:${CONTACT_PHONE}`}
                            data-event="click_phone"
                            data-button-location="contact_card_phone"
                        >
                            <span>Telefon</span>
                            <strong>{CONTACT_PHONE_DISPLAY}</strong>
                        </a>
                        <a
                            id="contact-card-email"
                            href={`mailto:${CONTACT_EMAIL}`}
                            data-event="click_email"
                            data-button-location="contact_card_email"
                        >
                            <span>E-Mail</span>
                            <strong>{CONTACT_EMAIL}</strong>
                        </a>
                        <a
                            id="contact-card-route"
                            href={routeUrl}
                            target="_blank"
                            rel="noopener"
                            data-event="click_route"
                            data-button-location="contact_card_route"
                        >
                            <span>Route planen</span>
                            <strong>Google Maps öffnen</strong>
                        </a>
                    </div>

                    <div class="kontakt-card-actions">
                        <a
                            id="contact-card-booking"
                            class="pill-btn"
                            href="/termin/"
                            data-event="click_booking"
                            data-button-location="contact_card_booking"
                        >
                            Termin buchen
                        </a>
                        <a
                            class="pill-btn pill-btn-outline"
                            href={routeUrl}
                            target="_blank"
                            rel="noopener"
                            data-event="click_route"
                            data-button-location="contact_card_route_button"
                        >
                            Route planen
                        </a>
                    </div>
                </aside>
            </div>
        </header>

        <section class="kontakt-actions-section" aria-labelledby="kontakt-actions-heading">
            <div class="kontakt-section-heading">
                <h2 id="kontakt-actions-heading">Direkt erreichbar</h2>
                <p>Wählen Sie den schnellsten Weg zu Teresa. Online-Buchung und WhatsApp sind für die meisten Anliegen am effizientesten.</p>
            </div>

            <div class="kontakt-action-layout">
                <article class="kontakt-action-card kontakt-action-primary">
                    <div>
                        <span class="kontakt-action-index">01</span>
                        <h3>Termin online buchen</h3>
                        <p>Wenn Sie bereits wissen, welche Behandlung Sie möchten, können Sie Ihren Termin bequem online auswählen.</p>
                    </div>
                    <a
                        class="pill-btn"
                        href="/termin/"
                        data-event="click_booking"
                        data-button-location="contact_action_booking"
                    >
                        Termin buchen
                    </a>
                </article>

                <div class="kontakt-action-secondary-grid">
                    <article class="kontakt-action-card">
                        <span class="kontakt-action-index">02</span>
                        <h3>WhatsApp schreiben</h3>
                        <p>Ideal für kurze Fragen, Terminwünsche oder Rückfragen vor Ihrer Behandlung.</p>
                        <a
                            href={CONTACT_WHATSAPP_URL}
                            target="_blank"
                            rel="noopener"
                            data-event="click_whatsapp"
                            data-button-location="contact_action_whatsapp"
                            data-source="contact_action"
                        >
                            Chat öffnen
                        </a>
                    </article>
                    <article class="kontakt-action-card">
                        <span class="kontakt-action-index">03</span>
                        <h3>Anrufen</h3>
                        <p>Für kurzfristige Terminänderungen, persönliche Rückfragen oder eine schnelle Abstimmung.</p>
                        <a
                            href={`tel:${CONTACT_PHONE}`}
                            data-event="click_phone"
                            data-button-location="contact_action_phone"
                        >
                            Jetzt anrufen
                        </a>
                    </article>
                    <article class="kontakt-action-card">
                        <span class="kontakt-action-index">04</span>
                        <h3>E-Mail senden</h3>
                        <p>Für ausführlichere Anliegen, Unterlagen oder Rückrufwünsche.</p>
                        <a
                            href={`mailto:${CONTACT_EMAIL}`}
                            data-event="click_email"
                            data-button-location="contact_action_email"
                        >
                            E-Mail schreiben
                        </a>
                    </article>
                    <article class="kontakt-action-card kontakt-action-card--form">
                        <span class="kontakt-action-index">05</span>
                        <h3>Kontaktformular nutzen</h3>
                        <p>Für eine persönliche Anfrage an Teresa mit Hautziel, bevorzugtem Kontaktweg und Rückrufwunsch.</p>
                        <a
                            id="contact-card-form"
                            href="#kontakt-form"
                            data-event="click_form_intent"
                            data-button-location="contact_action_form"
                        >
                            Nachricht senden
                        </a>
                    </article>
                </div>
            </div>
        </section>

        <section class="kontakt-intent-section" aria-labelledby="kontakt-intent-heading">
            <div class="kontakt-section-heading">
                <h2 id="kontakt-intent-heading">Wie dürfen wir Ihnen helfen?</h2>
                <p>Wählen Sie den Weg, der am besten zu Ihrem Anliegen passt.</p>
            </div>
            <div class="kontakt-intent-grid">
                {intentCards.map((card, index) => (
                    <article class="kontakt-intent-card">
                        <span>{String(index + 1).padStart(2, '0')}</span>
                        <h3>{card.title}</h3>
                        <p>{card.copy}</p>
                        <a
                            id={card.id}
                            href={card.href}
                            {...(card.external ? { target: '_blank', rel: 'noopener' } : {})}
                            data-event={card.event}
                            data-button-location={card.buttonLocation}
                            data-source="contact_intent"
                        >
                            {card.cta}
                        </a>
                    </article>
                ))}
            </div>
        </section>

        <section class="kontakt-consultation" aria-labelledby="kontakt-consultation-heading">
            <div class="kontakt-consultation-copy">
                <p class="kontakt-card-kicker">Persönliche Beratung</p>
                <h2 id="kontakt-consultation-heading">Nicht sicher, welche Behandlung passt?</h2>
                <p>
                    Viele Kundinnen wissen vor dem ersten Termin nicht genau, ob Hydrafacial, Microneedling, Peeling, ColdPlasma oder eine andere Behandlung die richtige Wahl ist. Teresa nimmt sich Zeit für Ihr Anliegen und empfiehlt Ihnen den passenden nächsten Schritt für Ihr Hautziel.
                </p>
                <p class="kontakt-consultation-micro">Persönlich · ehrlich · passend zu Ihrem Hautbild</p>
                <a
                    class="pill-btn"
                    href="#kontakt-form"
                    data-event="click_form_intent"
                    data-button-location="contact_consultation_recommendation"
                >
                    Behandlungsempfehlung anfragen
                </a>
            </div>
            <div class="kontakt-consultation-media">
                <Image
                    src={consultationTrust}
                    widths={[480, 720, 960]}
                    sizes="(min-width: 901px) 42vw, 100vw"
                    format="webp"
                    quality="high"
                    loading="lazy"
                    alt="Persönliche Hautberatung bei Beauty Face Lift Zürich"
                />
            </div>
        </section>

        <section class="kontakt-studio" aria-labelledby="kontakt-studio-heading">
            <div class="kontakt-section-heading kontakt-section-heading--split">
                <div>
                    <h2 id="kontakt-studio-heading">Studio &amp; Anfahrt</h2>
                    <p>Beauty Face Lift befindet sich zentral an der Bahnhofstrasse 94 in Zürich — nur wenige Minuten vom Paradeplatz entfernt.</p>
                </div>
                <a
                    id="contact-route"
                    class="pill-btn pill-btn-outline"
                    href={routeUrl}
                    target="_blank"
                    rel="noopener"
                    data-event="click_route"
                    data-button-location="contact_studio_route"
                >
                    Route planen
                </a>
            </div>

            <div class="kontakt-studio-layout">
                <div class="kontakt-studio-grid">
                    <article class="kontakt-info-card">
                        <span>Adresse</span>
                        <address>
                            Beauty Face Lift Zürich<br />
                            Bahnhofstrasse 94<br />
                            8001 Zürich
                        </address>
                    </article>
                    <article class="kontakt-info-card">
                        <span>Öffnungszeiten</span>
                        <div class="kontakt-hours">
                            {OPENING_HOURS.map((row) => (
                                <p>
                                    <strong>{row.label}</strong>
                                    <em>{row.value}</em>
                                </p>
                            ))}
                        </div>
                    </article>
                    <article class="kontakt-info-card">
                        <span>Mit dem ÖV</span>
                        <p>Paradeplatz und Börsenstrasse sind in wenigen Minuten zu Fuss erreichbar.</p>
                    </article>
                    <article class="kontakt-info-card">
                        <span>Mit dem Auto / Parkhäuser</span>
                        <p>Mehrere Innenstadt-Parkhäuser rund um Paradeplatz und Bleicherweg liegen nur wenige Gehminuten entfernt.</p>
                    </article>
                </div>

                <a
                    class="kontakt-map-card"
                    href={routeUrl}
                    target="_blank"
                    rel="noopener"
                    data-event="click_route"
                    data-button-location="contact_map_card"
                    aria-label="Route zu Beauty Face Lift Zürich auf Google Maps planen"
                >
                    <span class="kontakt-map-pin" aria-hidden="true"></span>
                    <span class="kontakt-map-title">Bahnhofstrasse 94</span>
                    <span class="kontakt-map-copy">Zürich · nahe Paradeplatz</span>
                    <strong>Route planen</strong>
                </a>
            </div>
        </section>

        <section class="kontakt-form-section" aria-labelledby="kontakt-form-heading">
            <div class="kontakt-form-copy">
                <h2 id="kontakt-form-heading">Eine Nachricht an Teresa</h2>
                <p>Beschreiben Sie kurz Ihr Anliegen oder Ihr Hautziel. Wir melden uns persönlich bei Ihnen zurück.</p>
            </div>

            <form id="kontakt-form" class="kontakt-form" action="/api/contact" method="post">
                <div class="kontakt-field-grid">
                    <div class="kontakt-field kontakt-field--full">
                        <label for="contact-name">Name <span class="kontakt-required" aria-hidden="true">*</span></label>
                        <input id="contact-name" name="name" type="text" autocomplete="name" required />
                    </div>

                    <div class="kontakt-field kontakt-contact-fields kontakt-field--full" aria-describedby="contact-reach-note">
                        <p class="kontakt-field-group-label">Telefon oder E-Mail <span class="kontakt-required" aria-hidden="true">*</span></p>
                        <p id="contact-reach-note" class="kontakt-field-help">Bitte mindestens eine Kontaktangabe ausfüllen.</p>
                        <div class="kontakt-contact-field-grid">
                            <label for="contact-phone">
                                <span>Telefon</span>
                                <input id="contact-phone" name="phone" type="tel" autocomplete="tel" placeholder={CONTACT_PHONE_DISPLAY} />
                            </label>
                            <label for="contact-email">
                                <span>E-Mail</span>
                                <input id="contact-email" name="email" type="email" autocomplete="email" placeholder={CONTACT_EMAIL} />
                            </label>
                        </div>
                    </div>

                    <div class="kontakt-field">
                        <label for="contact-preferred-method">Bevorzugter Kontaktweg <span class="kontakt-required" aria-hidden="true">*</span></label>
                        <div class="kontakt-select">
                            <select id="contact-preferred-method" name="preferredContactMethod" required>
                                <option value="">Bitte auswählen</option>
                                <option value="WhatsApp">WhatsApp</option>
                                <option value="Telefon">Telefon</option>
                                <option value="E-Mail">E-Mail</option>
                            </select>
                            <svg class="kontakt-select-caret" width="12" height="8" viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1 L6 6 L11 1" stroke="currentColor" stroke-width="1" fill="none" stroke-linecap="square" /></svg>
                        </div>
                    </div>

                    <div class="kontakt-field">
                        <label for="contact-topic">Worum geht es? <span class="kontakt-required" aria-hidden="true">*</span></label>
                        <div class="kontakt-select">
                            <select id="contact-topic" name="topic" required>
                                <option value="">Bitte auswählen</option>
                                {CONTACT_TOPICS.map((topic) => (
                                    <option value={topic}>{topic}</option>
                                ))}
                            </select>
                            <svg class="kontakt-select-caret" width="12" height="8" viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1 L6 6 L11 1" stroke="currentColor" stroke-width="1" fill="none" stroke-linecap="square" /></svg>
                        </div>
                    </div>

                    <div class="kontakt-field kontakt-field--full">
                        <label for="contact-callback">Bevorzugter Rückrufzeitpunkt</label>
                        <input id="contact-callback" name="preferredCallbackTime" type="text" placeholder="z. B. werktags zwischen 12:00 und 14:00 Uhr" />
                    </div>

                    <div class="kontakt-field kontakt-field--full">
                        <label for="contact-message">Ihre Nachricht <span class="kontakt-required" aria-hidden="true">*</span></label>
                        <textarea id="contact-message" name="message" required placeholder="Beschreiben Sie kurz Ihr Anliegen, Ihre Hautziele oder Ihre Frage."></textarea>
                    </div>
                </div>

                <div class="kontakt-field kontakt-honeypot" aria-hidden="true">
                    <label for="contact-company">Firma</label>
                    <input id="contact-company" name="company" type="text" tabindex="-1" autocomplete="off" />
                </div>

                {turnstileSiteKey && (
                    <div class="kontakt-turnstile">
                        <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
                        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
                    </div>
                )}

                <label class="kontakt-checkbox" for="contact-privacy">
                    <input id="contact-privacy" name="privacyConsent" type="checkbox" required />
                    <span>Ich habe die <a href="/datenschutz/">Datenschutzerklärung</a> gelesen und bin mit der Verarbeitung meiner Angaben zur Beantwortung meiner Anfrage einverstanden. <span class="kontakt-required" aria-hidden="true">*</span></span>
                </label>

                <div class="kontakt-form-actions">
                    <button
                        id="contact-form-submit"
                        type="submit"
                        class="pill-btn kontakt-submit"
                        data-event="form_submit"
                        data-button-location="contact_form_submit"
                    >
                        Anfrage an Teresa senden
                    </button>
                    <p class="kontakt-form-note">Für dringende Terminänderungen bitte direkt per WhatsApp schreiben oder anrufen.</p>
                </div>
            </form>
        </section>

        <nav class="kontakt-mobile-cta" aria-label="Schnelle Kontaktoptionen">
            <a
                href="/termin/"
                data-event="click_booking"
                data-button-location="contact_mobile_sticky_booking"
            >
                Termin
            </a>
            <a
                href={CONTACT_WHATSAPP_URL}
                target="_blank"
                rel="noopener"
                data-event="click_whatsapp"
                data-button-location="contact_mobile_sticky_whatsapp"
                data-source="contact_mobile_sticky"
            >
                WhatsApp
            </a>
            <a
                href={`tel:${CONTACT_PHONE}`}
                data-event="click_phone"
                data-button-location="contact_mobile_sticky_phone"
            >
                Anrufen
            </a>
        </nav>
    </section>

    <script is:inline>
        (() => {
            const stickyCta = document.querySelector('.kontakt-mobile-cta');
            const formSection = document.querySelector('.kontakt-form-section');

            if (!stickyCta || !formSection || !('IntersectionObserver' in window)) return;

            const observer = new IntersectionObserver((entries) => {
                stickyCta.classList.toggle('is-hidden', entries.some((entry) => entry.isIntersecting));
            }, {
                rootMargin: '0px 0px -35% 0px',
                threshold: 0.01,
            });

            observer.observe(formSection);
        })();
    </script>
</Base>
