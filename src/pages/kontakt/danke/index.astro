---
import Base from '../../../layouts/Base.astro';
import {
    CONTACT_EMAIL,
    CONTACT_PHONE,
    CONTACT_PHONE_DISPLAY,
    CONTACT_WHATSAPP_URL,
} from '../../../../shared/site';
---

<Base
    title="Nachricht gesendet | Beauty Face Lift"
    description="Ihre Nachricht wurde erfolgreich an Beauty Face Lift übermittelt."
    noindex
>
    <section class="contact-page" style="padding-bottom: 8rem;">
        <div class="contact-grid" style="grid-template-columns: 1fr; max-width: 760px; margin: 0 auto;">
            <article class="contact-form-shell">
                <div class="contact-status contact-status-success">
                    Ihre Nachricht wurde erfolgreich übermittelt. Wir melden uns so rasch wie möglich zurück.
                </div>
                <span class="sub-display">Vielen Dank</span>
                <h1 style="font-size: clamp(2.4rem, 5vw, 4rem); margin-bottom: 1rem;">Wir haben Ihre Anfrage erhalten.</h1>
                <p style="margin-bottom: 1.5rem;">Wenn Ihr Anliegen zeitkritisch ist oder Sie einen Termin kurzfristig verschieben müssen, erreichen Sie uns weiterhin direkt per Telefon oder WhatsApp.</p>
                <div class="contact-card-grid">
                    <article class="contact-card">
                        <span class="sub-display">Telefon</span>
                        <h2>{CONTACT_PHONE_DISPLAY}</h2>
                        <a class="contact-card-action" href={`tel:${CONTACT_PHONE}`}>Jetzt anrufen</a>
                    </article>
                    <article class="contact-card">
                        <span class="sub-display">WhatsApp</span>
                        <h2>Schnelle Rückfrage</h2>
                        <a class="contact-card-action" href={CONTACT_WHATSAPP_URL} target="_blank" rel="noopener">WhatsApp öffnen</a>
                    </article>
                    <article class="contact-card">
                        <span class="sub-display">E-Mail</span>
                        <h2>{CONTACT_EMAIL}</h2>
                        <a class="contact-card-action" href={`mailto:${CONTACT_EMAIL}`}>E-Mail schreiben</a>
                    </article>
                    <article class="contact-card">
                        <span class="sub-display">Buchung</span>
                        <h2>Termin online buchen</h2>
                        <a class="contact-card-action" href="/termin/">Zur Buchung</a>
                    </article>
                </div>
            </article>
        </div>
    </section>
</Base>
