---
import Base from '../../../layouts/Base.astro';
import '../../../styles/kontakt.css';
import {
    CONTACT_EMAIL,
    CONTACT_PHONE,
    CONTACT_PHONE_DISPLAY,
    CONTACT_WHATSAPP_URL,
} from '../../../../shared/site';
---

<Base
    title="Anfrage gesendet | Beauty Face Lift Zürich"
    description="Vielen Dank — Ihre Anfrage wurde an Beauty Face Lift Zürich gesendet."
    noindex
>
    <section class="kontakt-thanks" aria-labelledby="thanks-title">
        <div class="kontakt-thanks-copy">
            <p class="eyebrow eyebrow--rule">Vielen Dank</p>
            <h1 id="thanks-title">Ihre Anfrage wurde <em>gesendet</em>.</h1>
            <p class="lead">Teresa meldet sich persönlich bei Ihnen. Bei dringenden Terminänderungen erreichen Sie uns schneller telefonisch oder per WhatsApp.</p>
        </div>

        <div class="kontakt-location-grid">
            <article class="kontakt-location-card">
                <span class="label">Telefon</span>
                <h2 class="kontakt-thanks-value">{CONTACT_PHONE_DISPLAY}</h2>
                <a class="btn-link" href={`tel:${CONTACT_PHONE}`}>Jetzt anrufen</a>
            </article>
            <article class="kontakt-location-card">
                <span class="label">WhatsApp</span>
                <h2 class="kontakt-thanks-value">Schnelle Rückfrage</h2>
                <a class="btn-link" href={CONTACT_WHATSAPP_URL} target="_blank" rel="noopener">WhatsApp öffnen</a>
            </article>
            <article class="kontakt-location-card">
                <span class="label">E-Mail</span>
                <h2 class="kontakt-thanks-value">{CONTACT_EMAIL}</h2>
                <a class="btn-link" href={`mailto:${CONTACT_EMAIL}`}>E-Mail schreiben</a>
            </article>
            <article class="kontakt-location-card">
                <span class="label">Buchung</span>
                <h2 class="kontakt-thanks-value">Termin online buchen</h2>
                <a class="btn-link" href="/termin/">Zur Buchung</a>
            </article>
        </div>
    </section>
</Base>
