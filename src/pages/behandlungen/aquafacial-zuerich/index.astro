---
import Base from '../../../layouts/Base.astro';
import BookingCta from '../../../components/BookingCta.astro';
import TreatmentHero from '../../../components/treatment/TreatmentHero.astro';
import TreatmentSplit from '../../../components/treatment/TreatmentSplit.astro';
import BenefitList from '../../../components/treatment/BenefitList.astro';
import PriceMenu from '../../../components/treatment/PriceMenu.astro';
import TreatmentSteps from '../../../components/treatment/TreatmentSteps.astro';
import RuledList from '../../../components/treatment/RuledList.astro';
import ReviewQuote from '../../../components/treatment/ReviewQuote.astro';
import FaqBlock from '../../../components/treatment/FaqBlock.astro';
import RelatedTreatments from '../../../components/treatment/RelatedTreatments.astro';
import { treatmentHeroPreload } from '../../../components/treatment/images';
import { aquafacialCard, consultationTrust } from '../../../lib/site-images';
import glowPortrait from '../../../assets/lp/aquafacial/post-treatment-glow-zuerich.webp';
import consultation from '../../../assets/lp/aquafacial/hautanalyse-beratung-zuerich.webp';
import { absoluteUrl, bookingLinkForService } from '../../../../shared/site';
import { beautySalonRef } from '../../../lib/schema';

const pagePath = '/behandlungen/aquafacial-zuerich/';
const bookingHref = bookingLinkForService('Aquafacial');
const heroPreload = await treatmentHeroPreload(aquafacialCard);

const benefits = [
    { title: 'Frischer Teint', text: 'Die Haut kann direkt nach der ersten Sitzung frischer, praller und ebenmässiger wirken.' },
    { title: 'Meist keine Ausfallzeit', text: 'Make-up ist direkt danach möglich – ideal vor besonderen Anlässen.' },
    { title: 'Individuell abgestimmt', text: 'Teresa analysiert Ihre Haut und stellt die Seren nach Hauttyp und Saison zusammen.' },
];

const priceItems = [
    { name: 'Aquafacial Basic Intensiv', duration: '60 Min.', price: 'CHF 180', note: 'Tiefenreinigung, Peeling und Feuchtigkeitsaufbau.' },
    { name: 'Aquafacial Anti Aging', duration: '90 Min.', price: 'CHF 250', note: 'Intensive Pflege mit Anti-Aging-Fokus und Glow-Finish.' },
    { name: 'Gesicht, Hals, Dekolletee', duration: '90 Min.', price: 'CHF 280', note: 'Erweiterte Behandlung über Gesicht, Hals und Dekolletee.' },
    { name: 'Aquafacial + coldPLASMA', duration: '90 Min.', price: 'CHF 280', note: 'Für Akne und unreine Haut.' },
    { name: 'Aquafacial + Microneedling', duration: '90 Min.', price: 'CHF 250', note: 'Beide Behandlungen in einer Sitzung.' },
];

const steps = [
    { title: 'Reinigung & Peeling', text: 'Eine sanfte Reinigung öffnet die Poren, ein mildes Glykolsäure-Peeling entfernt abgestorbene Hautzellen.' },
    { title: 'Extraktion & Hydration', text: 'Unreinheiten werden sanft aus den Poren gelöst, Seren mit Hyaluronsäure und Antioxidantien eingearbeitet.' },
    { title: 'Schutz & Glow', text: 'Peptide und weitere Wirkstoffe pflegen die Haut – optional ergänzt durch LED-Lichttherapie.' },
];

const suitedFor = [
    'Fahler Teint und Feuchtigkeitsmangel',
    'Fettige Haut und vergrösserte Poren',
    'Unreinheiten und Akne',
    'Erste feine Linien',
    'Sonnenschäden und Hyperpigmentierung',
    'Vor Hochzeiten, Fotoshootings oder wichtigen Events',
];

const faqs = [
    {
        question: 'Was kostet ein Aquafacial in Zürich?',
        answer: 'Aquafacial Basic Intensiv (60 Min.) kostet CHF 180, Anti Aging (90 Min.) CHF 250, Gesicht/Hals/Dekolletee (90 Min.) CHF 280 und Aquafacial + coldPLASMA für Akne (90 Min.) CHF 280. Alle Preise inklusive MwSt., persönlicher Beratung und Hautanalyse durch Teresa Stimac.',
    },
    {
        question: 'Wie oft sollte man Aquafacial machen?',
        answer: 'Zu Beginn empfehlen wir häufig eine Behandlung alle 4 Wochen – passend zum natürlichen Hauterneuerungszyklus von circa 28 Tagen. Nach 3–4 Sitzungen kann das Intervall auf alle 6 Wochen ausgeweitet werden.',
    },
    {
        question: 'Wie lange dauert eine Aquafacial Behandlung?',
        answer: 'Aquafacial Basic Intensiv dauert circa 60 Minuten; Anti Aging, Gesicht/Hals/Dekolletee, Aquafacial + coldPLASMA und Aquafacial + Microneedling dauern circa 90 Minuten. Meist gibt es keine längere Ausfallzeit.',
    },
    {
        question: 'Für welche Hauttypen ist Aquafacial geeignet?',
        answer: 'Für alle Hauttypen und jedes Alter – ob fettig, trocken, empfindlich, Mischhaut oder reife Haut. Die Seren werden individuell auf Ihren Hautzustand und die aktuelle Saison abgestimmt.',
    },
    {
        question: 'Hat Aquafacial Nebenwirkungen?',
        answer: 'Aquafacial ist in der Regel gut verträglich. In seltenen Fällen kann eine leichte Rötung auftreten, die meist rasch abklingt. Make-up können Sie direkt nach der Behandlung auftragen.',
    },
    {
        question: 'Aquafacial oder Microneedling – was ist besser?',
        answer: 'Aquafacial passt zu frischem Glow, Hydration und sanfter Porenreinigung, in der Regel ohne Ausfallzeit. Microneedling passt eher zu Hautstruktur, feinen Linien oder Narbenoptik – mit 1–2 Tagen Regeneration. Teresa berät Sie persönlich.',
    },
    {
        question: 'Kann man Aquafacial in der Schwangerschaft machen?',
        answer: 'Aquafacial ist sanft und enthält keine invasiven Elemente. Wir empfehlen dennoch Rücksprache mit Ihrer Gynäkologin oder Ihrem Gynäkologen; auf Wunsch verwenden wir ausschliesslich schwangerschaftsfreundliche Wirkstoffe.',
    },
];

const structuredData = {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Aquafacial Behandlung Zürich",
    "serviceType": "Aquafacial",
    "category": "Gesichtsbehandlung",
    "url": absoluteUrl(pagePath),
    "image": absoluteUrl('/assets/aquafacial_treatment.png'),
    "provider": beautySalonRef(),
    "description": "Aquafacial in Zürich: Reinigung, sanfte Exfoliation und Feuchtigkeit in einer Behandlung – persönlich von Teresa Stimac im Kosmetikinstitut Beauty Face Lift an der Bahnhofstrasse.",
    "areaServed": "Zürich"
};
---

<Base
    title="Aquafacial Zürich ab CHF 180 | Beauty Face Lift"
    description="Aquafacial an der Bahnhofstrasse Zürich: Tiefenreinigung, Peeling und Feuchtigkeit für frischen Glow, meist ohne Ausfallzeit. Ab CHF 180 – Termin buchen."
    preloadImage={heroPreload}
    structuredData={structuredData}
>
    <TreatmentHero
        treatment="Aquafacial"
        breadcrumb="Aquafacial Zürich"
        lead="Aquafacial in Zürich: Reinigung, sanfte Exfoliation und Feuchtigkeit in einer Behandlung – persönlich von Teresa Stimac."
        bookingHref={bookingHref}
        image={aquafacialCard}
        alt="Aquafacial Behandlung bei Beauty Face Lift an der Bahnhofstrasse Zürich"
        focus="right"
        price="ab CHF 180"
        duration="60–90 Minuten"
    >Aquafacial <em>Zürich</em></TreatmentHero>

    <!-- What it is & benefits -->
    <section class="section section--flush-top" aria-labelledby="intro-title">
        <div class="container">
            <TreatmentSplit image={glowPortrait} alt="Frau mit frischer, gepflegter Haut nach einer Gesichtsbehandlung">
                <h2 id="intro-title">Frischer Glow, meist ohne Ausfallzeit</h2>
                <p class="lead">Aquafacial reinigt, peelt und hydratisiert die Haut in drei Schritten – abgestimmt auf Ihren Hauttyp.</p>
                <BenefitList items={benefits} />
            </TreatmentSplit>
        </div>
    </section>

    <!-- Prices -->
    <section class="section section--shell" id="preise" aria-label="Preise und Dauer">
        <div class="container">
            <PriceMenu items={priceItems} note="Inklusive MwSt., persönlicher Beratung und Hautanalyse durch Teresa Stimac.">
                <Fragment slot="title">Aquafacial Preise</Fragment>
                <a slot="actions" href={bookingHref} class="btn btn-arrow" data-treatment="Aquafacial" data-button-location="treatment_prices">Termin buchen</a>
            </PriceMenu>
        </div>
    </section>

    <!-- Process -->
    <section class="section" aria-labelledby="process-title">
        <div class="container">
            <div class="section-head">
                <div>
                    <h2 id="process-title">In drei Schritten zum Glow</h2>
                    <p class="lead">Jede Behandlung beginnt mit einer kurzen Hautanalyse durch Teresa.</p>
                </div>
            </div>
            <TreatmentSteps steps={steps} />
        </div>
    </section>

    <!-- Suitability -->
    <section class="section section--flush-top" aria-labelledby="suitability-title">
        <div class="container">
            <TreatmentSplit image={consultationTrust} alt="Persönliche Hautanalyse und Aquafacial Beratung bei Beauty Face Lift Zürich" quality="high" reverse>
                <h2 id="suitability-title">Für wen ist Aquafacial geeignet?</h2>
                <p class="lead">Für praktisch jeden Hauttyp und jedes Alter – Teresa stimmt die Seren auf Ihren Hautzustand ab.</p>
                <RuledList items={suitedFor} />
                <p class="split-note">Nicht empfohlen bei aktiven Herpes-Ausbrüchen, offenen Wunden oder schwerer Rosazea im akuten Schub.</p>
            </TreatmentSplit>
        </div>
    </section>

    <!-- Review -->
    <section class="section section--shell" aria-label="Kundenstimme">
        <div class="container">
            <ReviewQuote quote="Wie immer eine wunderbare Verwöhnzeit!" author="Emina" detail="Aquafacial Kundin" />
        </div>
    </section>

    <!-- FAQ -->
    <section class="section" aria-label="Häufige Fragen">
        <div class="container">
            <FaqBlock items={faqs}>
                <Fragment slot="title">Fragen zu Aquafacial</Fragment>
            </FaqBlock>
        </div>
    </section>

    <!-- Booking -->
    <section class="section section--flush-top" id="buchen">
        <div class="container">
            <BookingCta treatment="Aquafacial" href={bookingHref} image={consultation} alt="Teresa Stimac bespricht mit einer Kundin die Hautanalyse" />
        </div>
    </section>

    <RelatedTreatments current={pagePath} />
</Base>
