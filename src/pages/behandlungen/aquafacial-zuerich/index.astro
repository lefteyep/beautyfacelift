---
import Base from '../../../layouts/Base.astro';
import TreatmentLinkCard from '../../../components/TreatmentLinkCard.astro';
import BookingCta from '../../../components/BookingCta.astro';
import AiSummary from '../../../components/AiSummary.astro';
import TreatmentHero from '../../../components/treatment/TreatmentHero.astro';
import TreatmentSplit from '../../../components/treatment/TreatmentSplit.astro';
import PriceMenu from '../../../components/treatment/PriceMenu.astro';
import ReviewQuote from '../../../components/treatment/ReviewQuote.astro';
import FaqBlock from '../../../components/treatment/FaqBlock.astro';
import LinkList from '../../../components/treatment/LinkList.astro';
import { treatmentHeroPreload } from '../../../components/treatment/images';
import { consultationTrust, aquafacialCard, spaInterior } from '../../../lib/site-images';
import { absoluteUrl, bookingLinkForService } from '../../../../shared/site';

const bookingHref = bookingLinkForService('Aquafacial');
const heroPreload = await treatmentHeroPreload(aquafacialCard);

const summaryFacts = [
    { label: 'Dauer', value: '60 bis 90 Minuten' },
    { label: 'Preis', value: 'ab CHF 180' },
    { label: 'Downtime', value: 'meist keine, leichte Rötung möglich' },
    { label: 'Geeignet für', value: 'fahle, trockene oder unreine Haut, vergrösserte Poren, Glow-Wunsch' },
];

const priceItems = [
    { name: 'Aquafacial Basic Intensiv', duration: '60 Minuten', price: 'CHF 180', note: 'Tiefenreinigung, Peeling und Feuchtigkeitsaufbau für sichtbar frische Haut.' },
    { name: 'Aquafacial Anti Aging', duration: '90 Minuten', price: 'CHF 250', note: 'Intensive Aquafacial Pflege mit Anti-Aging-Fokus und Glow-Finish.' },
    { name: 'Gesicht, Hals, Dekolletee', duration: '90 Minuten', price: 'CHF 280', note: 'Erweiterte Aquafacial Behandlung für ein harmonisches Ergebnis über Gesicht, Hals und Dekolletee.' },
    { name: 'Aquafacial + coldPLASMA', duration: '90 Minuten', price: 'CHF 280', note: 'Für Akne und unreine Haut: Aquafacial Reinigung kombiniert mit coldPLASMA.' },
];

const combinations = [
    {
        href: '/behandlungen/microneedling-zuerich/',
        title: 'Aquafacial + Microneedling',
        text: 'Eine sinnvolle Kombination: Aquafacial bereitet die Haut sorgfältig vor, Microneedling kann die natürliche Hauterneuerung und Kollagenbildung unterstützen. Empfohlen im Abstand von 2 Wochen.',
    },
    {
        href: '/behandlungen/coldplasma-zuerich/',
        title: 'Aquafacial + ColdPlasma',
        text: 'ColdPlasma direkt nach dem Aquafacial kann die Wirkstoffaufnahme je nach Hautzustand unterstützen. Ideal für Anti-Aging und Hautverjüngung.',
    },
    {
        href: '/behandlungen/fruchtsaeure-peeling-zuerich/',
        title: 'Aquafacial + Fruchtsäure Peeling',
        text: 'Bei hartnäckigen Unreinheiten oder Akne-Narben: Fruchtsäure Peeling für die Tiefenwirkung, Aquafacial für die Regeneration. Im Wechsel alle 2–3 Wochen.',
    },
];

const structuredData = {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Aquafacial Behandlung Zürich",
    "serviceType": "Aquafacial",
    "category": "Gesichtsbehandlung",
    "url": absoluteUrl('/behandlungen/aquafacial-zuerich/'),
    "image": absoluteUrl('/assets/aquafacial_treatment.png'),
    "provider": {
        "@type": "BeautySalon",
        "name": "Beauty Face Lift Zürich",
        "url": absoluteUrl('/'),
        "address": {
            "@type": "PostalAddress",
            "streetAddress": "Bahnhofstrasse 94",
            "addressLocality": "Zürich",
            "postalCode": "8001",
            "addressCountry": "CH"
        }
    },
    "description": "Aquafacial ist eine patentierte, nicht-invasive Gesichtsbehandlung in drei Schritten — Reinigung, Peeling und Hydrierung — im Premium Kosmetikinstitut Beauty Face Lift an der Bahnhofstrasse in Zürich.",
    "areaServed": "Zürich"
};

// The two price questions were merged into one entry; markup and JSON-LD share this text.
const priceQuestion = 'Was kostet ein Aquafacial in Zürich an der Bahnhofstrasse?';
const priceAnswer = 'Die Kosten richten sich nach dem Behandlungsumfang. Bei Beauty Face Lift an der Bahnhofstrasse 94 in Zürich kostet Aquafacial Basic Intensiv (60 Min.) aktuell CHF 180, Anti Aging (90 Min.) CHF 250, Gesicht/Hals/Dekolletee (90 Min.) CHF 280 und Aquafacial + coldPLASMA für Akne (90 Min.) CHF 280. Alle Preise verstehen sich inklusive MwSt., persönlicher Beratung und Hautanalyse durch Teresa Stimac.';

const faqData = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{
        "@type": "Question",
        "name": priceQuestion,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": priceAnswer
        }
    }, {
        "@type": "Question",
        "name": "Wie oft sollte man Aquafacial machen?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Für ein gepflegtes und länger anhaltend frisches Hautgefühl empfehlen wir bei Beauty Face Lift in Zürich zu Beginn häufig eine Aquafacial Behandlung alle 4 Wochen. Dieser Rhythmus orientiert sich am natürlichen Hauterneuerungszyklus von circa 28 Tagen und kann die regelmässige Feuchtigkeitsversorgung unterstützen. Nach einer Anfangsphase von 3-4 Sitzungen kann das Intervall auf alle 6 Wochen ausgeweitet werden. Teresa berät Sie individuell, welcher Rhythmus zu Hauttyp, Hautzustand und Ziel passt."
        }
    }, {
        "@type": "Question",
        "name": "Wie lange dauert eine Aquafacial Behandlung?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Die Behandlungsdauer hängt von der gewählten Variante ab: Aquafacial Basic Intensiv dauert circa 60 Minuten. Anti Aging, Gesicht/Hals/Dekolletee, Aquafacial + coldPLASMA und Aquafacial + Microneedling dauern circa 90 Minuten. Direkt danach sind Sie wieder gesellschaftsfähig — in der Regel ohne Ausfallzeit."
        }
    }, {
        "@type": "Question",
        "name": "Für welche Hauttypen ist Aquafacial geeignet?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Aquafacial eignet sich für alle Hauttypen und jedes Alter — ob fettig, trocken, empfindlich, Mischhaut oder reife Haut. Die verwendeten Seren werden bei Beauty Face Lift individuell auf Ihren Hautzustand und die aktuelle Saison abgestimmt. Auch bei spezifischen Hautproblemen wie Akne, vergrösserten Poren, Hyperpigmentierung, ersten Fältchen oder Rosacea kann Aquafacial gezielt eingesetzt werden. Nicht empfohlen wird die Behandlung lediglich bei aktiven Herpes-Ausbrüchen, offenen Wunden oder schwerer Rosacea im akuten Schub. Teresa berät Sie im Vorgespräch individuell."
        }
    }, {
        "@type": "Question",
        "name": "Hat Aquafacial Nebenwirkungen?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Aquafacial gilt als eine der sanftesten professionellen Gesichtsbehandlungen und ist in der Regel gut verträglich. In seltenen Fällen kann eine leichte Rötung auftreten, die meist rasch abklingt. Anders als bei aggressiven chemischen Peelings oder Laserbehandlungen gibt es keine Schälphase und meist keine Ausfallzeit. Sie können direkt nach der Behandlung Make-up auftragen und Ihrem Alltag nachgehen. Bei sehr empfindlicher Haut oder Rosacea stimmt Teresa die Intensität individuell ab, um die Behandlung möglichst verträglich zu gestalten."
        }
    }, {
        "@type": "Question",
        "name": "Aquafacial oder Microneedling — was ist besser?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Beide Behandlungen haben ihre Stärken und können sich sinnvoll ergänzen. Aquafacial ist eine passende Wahl, wenn Sie frischen Glow, Hydration und eine sanfte Porenreinigung in der Regel ohne Ausfallzeit wünschen. Microneedling passt eher zu Zielen wie Hautstruktur, Porenbild, feinen Linien oder der kosmetischen Verbesserung von Narbenoptik; hier ist eine kurze Regenerationsphase von 1-2 Tagen einzuplanen. Teresa berät Sie gerne persönlich, welche Variante für Ihre Hautbedürfnisse die richtige ist."
        }
    }, {
        "@type": "Question",
        "name": "Kann man Aquafacial in der Schwangerschaft machen?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Grundsätzlich gilt Aquafacial als eine der sanftesten professionellen Gesichtsbehandlungen und enthält keine invasiven Elemente. Dennoch empfehlen wir Schwangeren, vor der Behandlung Rücksprache mit ihrem Gynäkologen oder ihrer Gynäkologin zu halten. Bestimmte Wirkstoffe wie Salicylsäure oder Retinol, die in einigen Aquafacial-Seren enthalten sein können, werden in der Schwangerschaft häufig gemieden. Bei Beauty Face Lift können wir die Serum-Auswahl entsprechend anpassen und ausschliesslich schwangerschaftsfreundliche Wirkstoffe verwenden. Sprechen Sie uns einfach bei der Buchung darauf an."
        }
    }]
};
---

<Base
    title="Aquafacial Zürich | Beauty Face Lift Zürich"
    description="Aquafacial / Aquafacial Zürich an der Bahnhofstrasse. Tiefenreinigung für strahlende Haut, Anti-Aging & Glow-Effekt im Premium Kosmetikinstitut. Ab CHF 180."
    preloadImage={heroPreload}
    structuredData={structuredData}
>
    <TreatmentHero
        treatment="Aquafacial"
        breadcrumb="Aquafacial Zürich"
        lead="Aquafacial ist eine professionelle Gesichtsbehandlung zur Reinigung, sanften Exfoliation und Feuchtigkeitsversorgung der Haut."
        bookingHref={bookingHref}
        image={aquafacialCard}
        alt="Aquafacial Behandlung Zürich — Tiefenreinigung und Glow im Premium Kosmetikinstitut"
        focus="right"
    >Aquafacial <em>Zürich</em></TreatmentHero>

    <AiSummary
        title="Aquafacial kurz erklärt"
        intro="Bei Beauty Face Lift an der Bahnhofstrasse 94 in Zürich wird die Behandlung nach kurzer Hautanalyse individuell angepasst und von Teresa Stimac persönlich durchgeführt."
        facts={summaryFacts}
    />

    <!-- Experience -->
    <section class="section section--ivory" aria-labelledby="experience-title">
        <div class="container">
            <TreatmentSplit image={spaInterior} alt="Premium Aquafacial Behandlungsraum bei Beauty Face Lift Zürich Bahnhofstrasse">
                <h2 id="experience-title">„Frischer <em>Glow</em>.<br />Ohne Downtime.“</h2>
                <p>Aquafacial ist eine patentierte, nicht-invasive Gesichtsbehandlung, die in drei Schritten — Reinigung, Peeling und Hydrierung — arbeitet und weltweit zu den beliebten Kosmetikinstitut-Behandlungen zählt. Bei Beauty Face Lift an der Bahnhofstrasse in Zürich erleben Sie diese Technologie in einem ruhigen Premium-Ambiente mit persönlicher Betreuung. Jede Behandlung wird von Inhaberin Teresa Stimac persönlich durchgeführt und individuell auf Ihren Hauttyp abgestimmt.</p>
                <p>Die Vortex-Technologie unterscheidet sich von klassischen manuellen Gesichtsbehandlungen: Ein spiralförmiger Sog löst Unreinheiten und abgestorbene Hautzellen sanft aus den Poren. Gleichzeitig werden professionelle Antioxidantien, Hyaluronsäure und Peptide auf die vorbereitete Haut aufgetragen und sorgfältig eingearbeitet — für ein frischer, hydratisierter wirkendes Hautbild.</p>
                <p>Das Resultat: Sofort sichtbar strahlende, hydratisierte Haut mit verfeinerten Poren und einem ebenmässigen Teint — direkt nach der ersten Sitzung und in der Regel ohne Ausfallzeit. Gut geeignet für das pulsierende Leben in Zürich, ob vor einem wichtigen Business-Meeting, einem besonderen Anlass oder einfach als regelmässige Hautpflege-Routine.</p>
                <div class="btn-row">
                    <a href={bookingHref} class="btn-link">Termin vereinbaren</a>
                </div>
            </TreatmentSplit>
        </div>
    </section>

    <!-- Benefits -->
    <section class="section" aria-labelledby="benefits-title">
        <div class="container">
            <div class="section-head">
                <div>
                    <h2 id="benefits-title">Was Aquafacial <em>auszeichnet</em></h2>
                </div>
            </div>
            <ul class="index-grid">
                <li class="scroll-anim">
                    <h3>Sofort sichtbar</h3>
                    <p>Strahlender Glow direkt nach der ersten Sitzung — kein Verstecken, kein Warten. Die Haut wirkt sofort frischer, praller und ebenmässiger. Ideal vor besonderen Anlässen.</p>
                </li>
                <li class="scroll-anim">
                    <h3>Meist keine Ausfallzeit</h3>
                    <p>Zurück in den Alltag innert Minuten. Sie können direkt nach der Behandlung Make-up auftragen und Ihrem Tag nachgehen — ideal für den anspruchsvollen Zürcher Lifestyle.</p>
                </li>
                <li class="scroll-anim">
                    <h3>Individuell abgestimmt</h3>
                    <p>Teresa analysiert Ihre Haut vor jeder Sitzung. Die Seren werden saisonal und auf Ihren Hauttyp massgeschneidert zusammengestellt — für eine gut abgestimmte Pflege bei jedem Besuch.</p>
                </li>
            </ul>
        </div>
    </section>

    <!-- Process -->
    <section class="section section--sand" aria-labelledby="process-title">
        <div class="container">
            <div class="section-head">
                <div>
                    <h2 id="process-title">In drei <em>Schritten</em> zum Glow</h2>
                </div>
            </div>
            <ol class="steps">
                <li class="scroll-anim">
                    <h3>Reinigung &amp; Peeling</h3>
                    <p>Die Vortex-Technologie öffnet die Poren sanft und entfernt abgestorbene Hautzellen sowie überschüssigen Talg. Gleichzeitig wird ein mildes Glykolsäure-Peeling aufgetragen, das die Haut auf die nächsten Schritte vorbereitet.</p>
                </li>
                <li class="scroll-anim">
                    <h3>Extraktion &amp; Hydration</h3>
                    <p>Durch den Vortex-Sog werden Unreinheiten sanft aus den Poren gelöst. Anschliessend werden professionelle Seren mit Hyaluronsäure und Antioxidantien aufgetragen und sorgfältig eingearbeitet.</p>
                </li>
                <li class="scroll-anim">
                    <h3>Schutz &amp; Glow</h3>
                    <p>Im letzten Schritt werden Peptide und pflegende Wirkstoffe aufgetragen, die die Haut schützen und den Glow-Effekt unterstützen. Optional: LED-Lichttherapie für zusätzliche Anti-Aging-Wirkung.</p>
                </li>
            </ol>
        </div>
    </section>

    <!-- Suitability -->
    <section class="section" aria-labelledby="suitability-title">
        <div class="container">
            <TreatmentSplit image={consultationTrust} alt="Persönliche Hautanalyse und Aquafacial Beratung bei Beauty Face Lift Zürich" quality="high" reverse>
                <h2 id="suitability-title">Für wen ist Aquafacial <em>geeignet</em>?</h2>
                <p>Aquafacial eignet sich für praktisch jeden Hauttyp und jedes Alter. Die Behandlung ist häufig geeignet bei fettiger Haut und vergrösserten Poren, ersten Anzeichen der Hautalterung wie feinen Linien, Unreinheiten und Akne, fahlem Teint und Feuchtigkeitsmangel, sowie Sonnenschäden und Hyperpigmentierung. Durch die individuell anpassbaren Seren kann Teresa die Behandlung exakt auf Ihren Hautzustand abstimmen — ob Sie 25 oder 65 sind.</p>
                <p>Besonders beliebt ist Aquafacial auch als Vorbereitung auf besondere Anlässe wie Hochzeiten, Fotoshootings oder wichtige Events. Nicht empfohlen wird die Behandlung lediglich bei aktiven Herpes-Ausbrüchen, offenen Wunden oder schwerer Rosacea im akuten Schub. Teresa berät Sie im Vorgespräch individuell.</p>
            </TreatmentSplit>
        </div>
    </section>

    <!-- Combinations -->
    <section class="section section--ivory" aria-labelledby="combinations-title">
        <div class="container">
            <div class="section-head">
                <div>
                    <h2 id="combinations-title">Aquafacial <em>kombinieren</em></h2>
                </div>
            </div>
            <LinkList items={combinations} />
        </div>
    </section>

    <!-- Prices -->
    <section class="section" aria-label="Preise">
        <div class="container">
            <PriceMenu items={priceItems} note="Alle Preise verstehen sich inklusive MwSt., persönlicher Beratung und Hautanalyse durch Teresa Stimac.">
                <Fragment slot="title">Aquafacial <em>Preise</em></Fragment>
            </PriceMenu>
        </div>
    </section>

    <!-- Testimonial -->
    <section class="section section--sand" aria-label="Kundenstimme">
        <div class="container">
            <ReviewQuote quote="Wie immer eine wunderbare Verwöhnzeit!" author="Emina" detail="Aquafacial Kundin" />
        </div>
    </section>

    <!-- FAQ -->
    <section class="section" aria-label="Häufige Fragen">
        <div class="container">
            <FaqBlock>
                <Fragment slot="title">Fragen zu <em>Aquafacial</em></Fragment>
                <details class="faq-item">
                    <summary><h3>{priceQuestion}</h3></summary>
                    <div class="faq-answer"><div class="faq-answer-inner">
                        <p>{priceAnswer}</p>
                    </div></div>
                </details>
                <details class="faq-item">
                    <summary><h3>Wie oft sollte man Aquafacial machen?</h3></summary>
                    <div class="faq-answer"><div class="faq-answer-inner">
                        <p>Für ein gepflegtes und länger anhaltend frisches Hautgefühl empfehlen wir bei Beauty Face Lift in Zürich zu Beginn häufig eine Aquafacial Behandlung alle 4 Wochen. Dieser Rhythmus orientiert sich am natürlichen Hauterneuerungszyklus von circa 28 Tagen und kann die regelmässige Feuchtigkeitsversorgung unterstützen. Nach einer Anfangsphase von 3–4 Sitzungen kann das Intervall auf alle 6 Wochen ausgeweitet werden. Teresa berät Sie individuell, welcher Rhythmus zu Hauttyp, Hautzustand und Ziel passt.</p>
                    </div></div>
                </details>
                <details class="faq-item">
                    <summary><h3>Wie lange dauert eine Aquafacial Behandlung?</h3></summary>
                    <div class="faq-answer"><div class="faq-answer-inner">
                        <p>Die Behandlungsdauer hängt von der gewählten Variante ab: Aquafacial Basic Intensiv dauert circa 60 Minuten. Anti Aging, Gesicht/Hals/Dekolletee, Aquafacial + coldPLASMA und Aquafacial + Microneedling dauern circa 90 Minuten. Jede Behandlung beginnt mit einer kurzen Hautanalyse durch Teresa. Das Besondere: Meist gibt es keine längere Ausfallzeit; bei leichter Rötung sollte die Haut zunächst beruhigt werden.</p>
                    </div></div>
                </details>
                <details class="faq-item">
                    <summary><h3>Für welche Hauttypen ist Aquafacial geeignet?</h3></summary>
                    <div class="faq-answer"><div class="faq-answer-inner">
                        <p>Aquafacial eignet sich für alle Hauttypen und jedes Alter — ob fettig, trocken, empfindlich, Mischhaut oder reife Haut. Die verwendeten Seren werden bei Beauty Face Lift individuell auf Ihren Hautzustand und die aktuelle Saison abgestimmt. Auch bei spezifischen Hautproblemen wie Akne, vergrösserten Poren, Hyperpigmentierung, ersten Fältchen oder Rosacea kann Aquafacial gezielt eingesetzt werden. Nicht empfohlen wird die Behandlung lediglich bei aktiven Herpes-Ausbrüchen, offenen Wunden oder schwerer Rosacea im akuten Schub. Teresa berät Sie im Vorgespräch individuell zu den passenden Wirkstoffen für Ihre Haut.</p>
                    </div></div>
                </details>
                <details class="faq-item">
                    <summary><h3>Hat Aquafacial Nebenwirkungen?</h3></summary>
                    <div class="faq-answer"><div class="faq-answer-inner">
                        <p>Aquafacial gilt als eine der sanftesten professionellen Gesichtsbehandlungen und ist in der Regel gut verträglich. In seltenen Fällen kann eine leichte Rötung auftreten, die meist rasch abklingt. Anders als bei aggressiven chemischen Peelings oder Laserbehandlungen gibt es keine Schälphase und meist keine Ausfallzeit. Sie können direkt nach der Behandlung Make-up auftragen und Ihrem Alltag nachgehen. Stärkere Reaktionen sind selten; vorübergehende Rötung oder Empfindlichkeit ist dennoch möglich. Bei sehr empfindlicher Haut oder Rosacea stimmt Teresa die Intensität individuell ab, um die Behandlung möglichst verträglich zu gestalten.</p>
                    </div></div>
                </details>
                <details class="faq-item">
                    <summary><h3>Aquafacial oder Microneedling — was ist besser?</h3></summary>
                    <div class="faq-answer"><div class="faq-answer-inner">
                        <p>Beide Behandlungen haben ihre Stärken und können sich sinnvoll ergänzen. Aquafacial ist eine passende Wahl, wenn Sie frischen Glow, Hydration und eine sanfte Porenreinigung in der Regel ohne Ausfallzeit wünschen — ideal vor besonderen Anlässen oder als regelmässige Pflege. Microneedling passt eher zu Zielen wie Hautstruktur, Porenbild, feinen Linien oder der kosmetischen Verbesserung von Narbenoptik; hier ist eine kurze Regenerationsphase von 1–2 Tagen einzuplanen. Teresa berät Sie gerne persönlich, welche Variante für Ihre Hautbedürfnisse die richtige ist.</p>
                    </div></div>
                </details>
                <details class="faq-item">
                    <summary><h3>Kann man Aquafacial in der Schwangerschaft machen?</h3></summary>
                    <div class="faq-answer"><div class="faq-answer-inner">
                        <p>Grundsätzlich gilt Aquafacial als eine der sanftesten professionellen Gesichtsbehandlungen und enthält keine invasiven Elemente. Dennoch empfehlen wir Schwangeren, vor der Behandlung Rücksprache mit ihrem Gynäkologen oder ihrer Gynäkologin zu halten. Bestimmte Wirkstoffe wie Salicylsäure oder Retinol, die in einigen Aquafacial-Seren enthalten sein können, werden in der Schwangerschaft häufig gemieden. Bei Beauty Face Lift können wir die Serum-Auswahl entsprechend anpassen und ausschliesslich schwangerschaftsfreundliche Wirkstoffe verwenden. Sprechen Sie uns einfach bei der Buchung darauf an — Teresa nimmt sich gerne die Zeit für eine individuelle Beratung.</p>
                    </div></div>
                </details>
            </FaqBlock>
        </div>
        <script type="application/ld+json" set:html={JSON.stringify(faqData)} />
    </section>

    <!-- Booking -->
    <section class="section section--tight section--flush-top" id="buchen">
        <div class="container">
            <BookingCta treatment="Aquafacial" href={bookingHref} />
        </div>
    </section>

    <!-- Related -->
    <section class="section section--tight section--rule" aria-labelledby="related-title">
        <div class="container">
            <div class="section-head">
                <div>
                    <h2 id="related-title">Mehr für Ihre <em>Haut</em></h2>
                </div>
                <a href="/behandlungen/" class="btn-link">Alle Behandlungen</a>
            </div>
            <div class="index-grid">
                <TreatmentLinkCard
                    href="/behandlungen/microneedling-zuerich/"
                    title="Microneedling"
                    description="Kosmetische Hautbildverbesserung ohne OP. Kollagenstimulation für ein verfeinertes Hautbild."
                />
                <TreatmentLinkCard
                    href="/behandlungen/fruchtsaeure-peeling-zuerich/"
                    title="Fruchtsäure Peeling"
                    description="Tiefenreinigung und Hauterneuerung für einen kompromisslos klaren Teint."
                />
                <TreatmentLinkCard
                    href="/behandlungen/coldplasma-zuerich/"
                    title="ColdPlasma"
                    description="Innovative Plasmatechnologie für ergänzende Wirkstoffpflege und ein ruhiger wirkendes Hautbild."
                />
            </div>
        </div>
    </section>
</Base>
