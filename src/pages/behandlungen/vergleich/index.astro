---

import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import FaqBlock from '../../../components/treatment/FaqBlock.astro';

const treatments = [
    { name: 'Aquafacial', href: '/behandlungen/aquafacial-zuerich/' },
    { name: 'Microneedling', href: '/behandlungen/microneedling-zuerich/' },
    { name: 'Fruchtsäure Peeling', href: '/behandlungen/fruchtsaeure-peeling-zuerich/' },
    { name: 'ColdPlasma', href: '/behandlungen/coldplasma-zuerich/' },
];

// One row per criterion; cells follow the order of `treatments` as [value, explanation].
const comparison: { label: string; cells: [string, string][] }[] = [
    {
        label: 'Hauptziel',
        cells: [
            ['Glow & Hydration', 'Ein sichtbar frischeres Hautbild durch patentierte Vortex-Tiefenreinigung und intensive Hydrierung.'],
            ['Anti-Aging & Hautstruktur', 'Kann die natürliche Hauterneuerung und Kollagenbildung für ein sichtbar verfeinertes Hautbild unterstützen.'],
            ['Hauterneuerung & Klärung', 'Natürliche AHA-Säuren entfernen abgestorbene Hautzellen für einen ebenmässigen Teint.'],
            ['Wirkstoffpflege & Hautbarriere', 'Innovative Plasmatechnologie für ergänzende Pflege und ein ruhiger wirkendes Hautbild.'],
        ],
    },
    {
        label: 'Dauer der Behandlung',
        cells: [
            ['60–90 Minuten', 'Je nach Aquafacial Variante und Kombination.'],
            ['90 Minuten', 'Inklusive Vorbereitung und Nachpflege.'],
            ['45–60 Minuten', 'Abhängig von Variante und Hautzustand.'],
            ['90 Minuten', 'Je nach Behandlungsfokus und Kombination.'],
        ],
    },
    {
        label: 'Schmerz­empfinden',
        cells: [
            ['Schmerzfrei', 'Die Behandlung fühlt sich angenehm an, wie eine sanfte Gesichtsmassage.'],
            ['Leichtes Piksen', 'Nach Auftragen der Betäubungscreme gut verträglich.'],
            ['Leichtes Brennen', 'Ein kurzes Wärmegefühl, das nach Neutralisierung sofort nachlässt.'],
            ['Schmerzfrei', 'Ein leichtes, warmes Kribbeln auf der Haut, aber meist keine stärkeren Schmerzen.'],
        ],
    },
    {
        label: 'Ausfallzeit (Downtime)',
        cells: [
            ['Keine', 'Direkt zurück in den Alltag. Perfekt vor Events und wichtigen Terminen.'],
            ['24–48 h Rötung', 'Für 1–2 Tage sollten Sie auf Make-up und Sonne verzichten.'],
            ['Leichte Schuppung', 'Die Haut kann 2–3 Tage leicht schuppen, was zur natürlichen Erneuerung gehört.'],
            ['Keine', 'Sie können sofort Make-up auftragen und Ihren normalen Alltag fortsetzen.'],
        ],
    },
    {
        label: 'Preis ab',
        cells: [
            ['Ab CHF 180', 'Aquafacial Basic Intensiv (60 Min.). Anti Aging CHF 250, erweiterte Varianten CHF 280.'],
            ['Ab CHF 210', 'Microneedling 90 Min.; Anti Aging mit coldPLASMA CHF 220, Carbon Laser + Microneedling CHF 250.'],
            ['CHF 150', 'Unsere günstigste online buchbare Behandlung für wirksame Hauterneuerung.'],
            ['Ab CHF 180', 'coldPLASMA Akne/unreine Haut; Anti Aging und Hautbarriere CHF 220.'],
        ],
    },
    {
        label: 'Empfohlene Sitzungen',
        cells: [
            ['Monatlich', 'Regelmässige Pflege im Rhythmus des natürlichen Hauterneuerungszyklus.'],
            ['3–5 Sitzungen', 'Im Abstand von 4–6 Wochen zur Unterstützung der Kollagenbildung.'],
            ['4–6 Sitzungen', 'In steigender Konzentration für kontrollierte kosmetische Hauterneuerung.'],
            ['Nach Bedarf', 'Flexibel als Einzelbehandlung oder Ergänzung zu anderen Treatments.'],
        ],
    },
    {
        label: 'Ideal für',
        cells: [
            ['Alle Hauttypen, Glow', 'Die universellste Behandlung für ein sichtbar frischeres Hautbild bei jedem Hauttyp.'],
            ['Anti-Aging, Narben', 'Häufig geeignet bei Fältchen, Aknenarben und schlaffer Haut.'],
            ['Akne, Unreinheiten', 'Die Lösung für unreine Haut, vergrösserte Poren und unebenmässigen Teint.'],
            ['Hautverjüngung', 'Für alle, die auf modernste Technologie und gezielte Wirkstoffpflege setzen.'],
        ],
    },
];

const structuredData = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{
        "@type": "Question",
        "name": "Aquafacial oder Microneedling — was ist besser?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Die Wahl zwischen Aquafacial und Microneedling hängt von Ihrem Hautziel ab. Aquafacial eignet sich gut für frischen Glow, Tiefenreinigung und Hydration — in der Regel ohne Ausfallzeit. Es ist eine passende Behandlung vor besonderen Anlässen oder als regelmässige Hautpflege. Microneedling kann die natürliche Hauterneuerung und Kollagenbildung unterstützen und passt eher zu Hautstruktur, Poren, feinen Linien oder Narbenoptik. Teresa berät Sie bei Beauty Face Lift individuell."
        }
    }, {
        "@type": "Question",
        "name": "Kann man verschiedene Behandlungen kombinieren?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja, viele unserer Kundinnen bei Beauty Face Lift in Zürich kombinieren verschiedene Behandlungen für möglichst gute Ergebnisse. Besonders beliebt ist die Kombination von Aquafacial mit ColdPlasma oder Aquafacial als Vorbereitung vor Microneedling. Exosome Therapie kann nach persönlicher Hautanalyse als regenerative Wirkstoffpflege eingeplant werden, zum Beispiel im Umfeld von Microneedling. Wichtig: Zwischen intensiveren Behandlungen wie Microneedling und Fruchtsäure Peeling sollten mindestens 2-4 Wochen Abstand liegen. Teresa erstellt Ihnen einen individuellen Behandlungsplan."
        }
    }, {
        "@type": "Question",
        "name": "Welche Behandlung hat die wenigste Ausfallzeit?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Aquafacial und ColdPlasma haben meist keine längere Ausfallzeit; viele Kundinnen können direkt in den Alltag zurückkehren. Direkte Sonne sollte nach der Behandlung möglichst vermieden werden. Beide Behandlungen sind ideal für den Zürcher Lifestyle und gut vor wichtigen Terminen oder besonderen Anlässen. Beim Fruchtsäure Peeling kann eine leichte Schuppung auftreten, die 2-3 Tage anhält. Microneedling verursacht eine Rötung von 24-48 Stunden, in der Sie auf Make-up und direkte Sonneneinstrahlung verzichten sollten. Planen Sie Microneedling daher am besten vor einem freien Tag ein."
        }
    }, {
        "@type": "Question",
        "name": "Welche Behandlung ist am günstigsten?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Das Fruchtsäure Peeling ist mit CHF 150 die günstigste online buchbare Einzelbehandlung bei Beauty Face Lift an der Bahnhofstrasse in Zürich. Aquafacial und ColdPlasma beginnen bei CHF 180, Microneedling beginnt bei CHF 210. Bedenken Sie bei der Wahl jedoch nicht nur den Preis, sondern vor allem, welche Behandlung zu Ihrem Hautziel passt — Teresa berät Sie ehrlich und empfiehlt nur, was Ihre Haut wirklich braucht."
        }
    }, {
        "@type": "Question",
        "name": "Wie finde ich die richtige Behandlung für meinen Hauttyp?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Der beste Weg zur richtigen Behandlung führt über eine persönliche Hautanalyse bei Teresa Stimac. Als Faustregel gilt: Bei fahler, dehydrierter Haut ohne Glow ist Aquafacial die erste Wahl. Bei Zeichen der Hautalterung wie Fältchen, schlaffer Haut oder Narben kann Microneedling sinnvoll sein. Akne, Unreinheiten und vergrösserte Poren sprechen oft gut auf Fruchtsäure Peeling an. ColdPlasma und Exosome Therapie können die professionelle Wirkstoffpflege ergänzen. Buchen Sie einen unverbindlichen Beratungstermin bei Beauty Face Lift — Teresa findet die passende Behandlung für Ihre Haut."
        }
    }]
};
---

<Base
    title="Behandlungsvergleich | Aquafacial vs. Microneedling vs. Peeling vs. ColdPlasma — Beauty Face Lift Zürich"
    description="Welche Gesichtsbehandlung passt? Vergleich von Aquafacial, Microneedling, Peeling, ColdPlasma und Exosome Therapie in Zürich."
    structuredData={structuredData}
>
    <header class="page-hero compare-hero">
        <div class="container page-hero-inner">
            <div class="reveal-up">
                <Breadcrumbs items={[
                    { label: "Home", href: "/" },
                    { label: "Behandlungen", href: "/behandlungen/" },
                    { label: "Vergleich" }
                ]} />
            </div>
            <p class="eyebrow eyebrow--rule reveal-up d-1">Orientierung</p>
            <h1 class="reveal-up d-2">Behandlungs&shy;vergleich</h1>
            <p class="lead reveal-up d-3">Beauty Face Lift in Zürich bietet mehrere Gesichtsbehandlungen an, die unterschiedliche Hautbedürfnisse gezielt ansprechen. Aquafacial steht für frischen Glow und Tiefenreinigung. Microneedling kann die natürliche Hauterneuerung und Kollagenbildung unterstützen. Fruchtsäure Peeling klärt die Haut bei Unreinheiten durch kontrollierte kosmetische Hauterneuerung. ColdPlasma setzt auf ergänzende Wirkstoffpflege. Exosome Therapie ergänzt das Spektrum als regenerative Kosmetik mit Exosomen Serum beziehungsweise exosomenähnlicher Technologie. In diesem Vergleich finden Sie die wichtigsten Unterschiede auf einen Blick.</p>
        </div>
    </header>

    <!-- Comparison table -->
    <section class="section section--flush-top" aria-labelledby="compare-title">
        <div class="container">
            <div class="section-head">
                <div>
                    <p class="eyebrow eyebrow--rule">Vergleich im Überblick</p>
                    <h2 id="compare-title">Die Unterschiede auf einen <em>Blick</em></h2>
                </div>
                <p class="compare-hint" aria-hidden="true">Tabelle seitlich scrollen</p>
            </div>
            <div class="compare-scroll" role="region" aria-labelledby="compare-title" tabindex="0">
                <table class="compare-table">
                    <caption class="sr-only">Vergleich von Aquafacial, Microneedling, Fruchtsäure Peeling und ColdPlasma nach Hauptziel, Dauer, Schmerzempfinden, Ausfallzeit, Preis, Sitzungen und Eignung</caption>
                    <colgroup>
                        <col class="compare-col-label" />
                        {treatments.map(() => <col />)}
                    </colgroup>
                    <thead>
                        <tr>
                            <th scope="col"><span class="sr-only">Kriterium</span></th>
                            {treatments.map((treatment) => (
                                <th scope="col"><a href={treatment.href}>{treatment.name}</a></th>
                            ))}
                        </tr>
                    </thead>
                    <tbody>
                        {comparison.map((row) => (
                            <tr>
                                <th scope="row">{row.label}</th>
                                {row.cells.map(([value, text]) => (
                                    <td>
                                        <strong>{value}</strong>
                                        <span>{text}</span>
                                    </td>
                                ))}
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <!-- Which treatment fits -->
    <section class="section section--ivory" aria-labelledby="fit-title">
        <div class="container">
            <div class="section-head">
                <div>
                    <p class="eyebrow eyebrow--rule">Welche Behandlung passt zu mir?</p>
                    <h2 id="fit-title">Ihr Hautziel bestimmt die richtige <em>Wahl</em></h2>
                </div>
            </div>
            <div class="index-grid index-grid--2 fit-grid">
                <div class="scroll-anim">
                    <h3>Wenn Sie frischen Glow wollen</h3>
                    <p>Dann kann <strong>Aquafacial</strong> gut passen. Die patentierte Vortex-Technologie reinigt, peelt und hydriert die Haut in einem Ablauf — häufig mit direkt frischerem Hautgefühl und meist ohne längere Ausfallzeit. Vor Hochzeiten, Fotoshootings oder wichtigen Events sollte die Behandlung rechtzeitig geplant werden. Viele Kundinnen nutzen Aquafacial regelmässig als Basis-Hautpflege.</p>
                    <div class="btn-row"><a href="/behandlungen/aquafacial-zuerich/" class="btn-link">Aquafacial entdecken</a></div>
                </div>
                <div class="scroll-anim">
                    <h3>Wenn Sie Anti-Aging und Straffung suchen</h3>
                    <p>Dann führt kein Weg an <strong>Microneedling</strong> vorbei. Die kontrollierten Mikroverletzungen aktivieren die natürliche Wundheilung Ihrer Haut und stimulieren die Neubildung von Kollagen und Elastin. Das Ergebnis: ein sichtbar verfeinertes, glatteres und gepflegteres Hautbild. Besonders wirksam bei Fältchen, Aknenarben und Elastizitätsverlust. Die Ergebnisse bauen sich über mehrere Sitzungen auf und halten langfristig an.</p>
                    <div class="btn-row"><a href="/behandlungen/microneedling-zuerich/" class="btn-link">Microneedling entdecken</a></div>
                </div>
                <div class="scroll-anim">
                    <h3>Wenn Sie regenerative Wirkstoffpflege suchen</h3>
                    <p>Dann kann die <strong>Exosome Therapie</strong> interessant sein. Dabei wird ein Exosomen Serum beziehungsweise eine exosomenähnliche Wirkstofftechnologie kosmetisch eingesetzt, um Feuchtigkeit, Hautbarriere, Glow und ein ruhiger wirkendes Hautbild zu unterstützen. Die Behandlung ist kein Stammzell-Ersatz und sollte realistisch eingeordnet werden.</p>
                    <div class="btn-row"><a href="/behandlungen/exosome-therapie-zuerich/" class="btn-link">Exosome Therapie entdecken</a></div>
                </div>
                <div class="scroll-anim">
                    <h3>Wenn Sie Akne oder Unreinheiten behandeln wollen</h3>
                    <p>Dann ist das <strong>Fruchtsäure Peeling</strong> die gezielte Lösung. Natürliche AHA-Säuren lösen die Verbindungen zwischen abgestorbenen Hautzellen und ermöglichen eine kontrollierte Hauterneuerung. Verstopfte Poren werden befreit, der Teint wird ebenmässiger und klarer. Besonders wirksam bei Akne, Mitessern, vergrösserten Poren und Hyperpigmentierung. Zudem ist es mit CHF 150 die günstigste online buchbare Option.</p>
                    <div class="btn-row"><a href="/behandlungen/fruchtsaeure-peeling-zuerich/" class="btn-link">Fruchtsäure Peeling entdecken</a></div>
                </div>
                <div class="scroll-anim">
                    <h3>Wenn Sie innovative Technologie bevorzugen</h3>
                    <p>Dann ist <strong>ColdPlasma</strong> eine moderne Ergänzung in unserem Angebot. Die Plasmatechnologie ionisiert Luft zu energiereichem Plasma, kann die kosmetische Hautpflege unterstützen und die Wirkstoffpflege je nach Hautzustand ergänzen. Besonders sinnvoll kann ColdPlasma nach einem Aquafacial sein, wenn Teresa die Hautbarriere und Verträglichkeit entsprechend einschätzt. Schmerzfrei und ohne Ausfallzeit.</p>
                    <div class="btn-row"><a href="/behandlungen/coldplasma-zuerich/" class="btn-link">ColdPlasma entdecken</a></div>
                </div>
                <div class="scroll-anim">
                    <h3>Wenn Sie unsicher sind</h3>
                    <p>Kein Problem — genau dafür ist Teresa da. In einem persönlichen Beratungsgespräch analysiert sie Ihren Hautzustand, bespricht Ihre Wünsche und empfiehlt die Behandlung oder Kombination, die gut zu Ihrer Haut passt. Ehrlich, kompetent und ohne Verkaufsdruck. Über 20 Jahre Erfahrung sprechen für sich.</p>
                    <div class="btn-row"><a href="/termin/" class="btn">Beratungstermin buchen</a></div>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ -->
    <section class="section" aria-label="Häufige Fragen">
        <div class="container">
            <FaqBlock>
                <Fragment slot="title">Häufig gestellte <em>Fragen</em></Fragment>
                <details class="faq-item">
                    <summary><h3>Aquafacial oder Microneedling — was ist besser?</h3></summary>
                    <div class="faq-answer"><div class="faq-answer-inner">
                        <p>Die Wahl zwischen Aquafacial und Microneedling hängt von Ihrem Hautziel ab. Aquafacial eignet sich gut für frischen Glow, Tiefenreinigung und Hydration — in der Regel ohne Ausfallzeit. Es ist eine passende Behandlung vor besonderen Anlässen oder als regelmässige Hautpflege. Microneedling kann die natürliche Hauterneuerung und Kollagenbildung unterstützen und passt eher zu Hautstruktur, Poren, feinen Linien oder Narbenoptik. Teresa berät Sie bei Beauty Face Lift individuell.</p>
                    </div></div>
                </details>
                <details class="faq-item">
                    <summary><h3>Kann man verschiedene Behandlungen kombinieren?</h3></summary>
                    <div class="faq-answer"><div class="faq-answer-inner">
                        <p>Ja, viele unserer Kundinnen bei Beauty Face Lift in Zürich kombinieren verschiedene Behandlungen für möglichst gute Ergebnisse. Besonders beliebt ist die Kombination von Aquafacial mit ColdPlasma oder Aquafacial als Vorbereitung vor Microneedling. Exosome Therapie kann nach persönlicher Hautanalyse als regenerative Wirkstoffpflege eingeplant werden, zum Beispiel im Umfeld von Microneedling. Wichtig: Zwischen intensiveren Behandlungen wie Microneedling und Fruchtsäure Peeling sollten mindestens 2-4 Wochen Abstand liegen. Teresa erstellt Ihnen einen individuellen Behandlungsplan.</p>
                    </div></div>
                </details>
                <details class="faq-item">
                    <summary><h3>Welche Behandlung hat die wenigste Ausfallzeit?</h3></summary>
                    <div class="faq-answer"><div class="faq-answer-inner">
                        <p>Aquafacial und ColdPlasma haben meist keine längere Ausfallzeit; viele Kundinnen können direkt in den Alltag zurückkehren. Direkte Sonne sollte nach der Behandlung möglichst vermieden werden. Beide Behandlungen sind ideal für den Zürcher Lifestyle und gut vor wichtigen Terminen oder besonderen Anlässen. Beim Fruchtsäure Peeling kann eine leichte Schuppung auftreten, die 2-3 Tage anhält. Microneedling verursacht eine Rötung von 24-48 Stunden, in der Sie auf Make-up und direkte Sonneneinstrahlung verzichten sollten. Planen Sie Microneedling daher am besten vor einem freien Tag ein.</p>
                    </div></div>
                </details>
                <details class="faq-item">
                    <summary><h3>Welche Behandlung ist am günstigsten?</h3></summary>
                    <div class="faq-answer"><div class="faq-answer-inner">
                        <p>Das Fruchtsäure Peeling ist mit CHF 150 die günstigste online buchbare Einzelbehandlung bei Beauty Face Lift an der Bahnhofstrasse in Zürich. Aquafacial und ColdPlasma beginnen bei CHF 180, Microneedling beginnt bei CHF 210. Bedenken Sie bei der Wahl jedoch nicht nur den Preis, sondern vor allem, welche Behandlung zu Ihrem Hautziel passt — Teresa berät Sie ehrlich und empfiehlt nur, was Ihre Haut wirklich braucht.</p>
                    </div></div>
                </details>
                <details class="faq-item">
                    <summary><h3>Wie finde ich die richtige Behandlung für meinen Hauttyp?</h3></summary>
                    <div class="faq-answer"><div class="faq-answer-inner">
                        <p>Der beste Weg zur richtigen Behandlung führt über eine persönliche Hautanalyse bei Teresa Stimac. Als Faustregel gilt: Bei fahler, dehydrierter Haut ohne Glow ist Aquafacial die erste Wahl. Bei Zeichen der Hautalterung wie Fältchen, schlaffer Haut oder Narben kann Microneedling sinnvoll sein. Akne, Unreinheiten und vergrösserte Poren sprechen oft gut auf Fruchtsäure Peeling an. ColdPlasma und Exosome Therapie können die professionelle Wirkstoffpflege ergänzen. Buchen Sie einen unverbindlichen Beratungstermin bei Beauty Face Lift — Teresa findet die passende Behandlung für Ihre Haut.</p>
                    </div></div>
                </details>
            </FaqBlock>
        </div>
    </section>

    <!-- Closing CTA -->
    <section class="cta-band" aria-labelledby="cta-title">
        <div class="cta-band-inner">
            <div>
                <p class="eyebrow eyebrow--rule">Persönliche Beratung</p>
                <h2 id="cta-title">Noch unsicher? Lassen Sie sich <em>beraten</em>.</h2>
                <p>Teresa Stimac analysiert Ihren Hautzustand und empfiehlt Ihnen die passende Behandlung — ehrlich, kompetent und unverbindlich. Über 20 Jahre Erfahrung, direkt an der Bahnhofstrasse in Zürich.</p>
            </div>
            <div class="btn-row">
                <a href="/termin/" class="btn">Beratungstermin buchen</a>
            </div>
        </div>
    </section>
</Base>

<style>
    .d-1 { --d: 1; }
    .d-2 { --d: 2; }
    .d-3 { --d: 3; }

    .compare-hero .page-hero-inner :global(.breadcrumbs) {
        padding: 0;
    }

    .compare-hero .lead {
        max-width: 64ch;
    }

    /* Comparison table — hairline rows; scrolls inside its own box on small screens */
    .compare-scroll {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .compare-scroll:focus-visible {
        outline: 1px solid var(--bronze);
        outline-offset: 4px;
    }

    .compare-table {
        width: 100%;
        min-width: 880px;
        border-collapse: collapse;
        table-layout: fixed;
        text-align: left;
    }

    .compare-col-label {
        width: 190px;
    }

    .compare-table th,
    .compare-table td {
        padding: 22px 28px 24px 0;
        vertical-align: top;
        border-bottom: 1px solid var(--rule);
    }

    .compare-table thead th {
        padding-top: 0;
        padding-bottom: 20px;
        vertical-align: bottom;
        border-bottom-color: var(--rule-strong);
        font-family: var(--f-display);
        font-size: var(--fs-h3);
        font-weight: 400;
        line-height: 1.15;
        color: var(--espresso);
    }

    .compare-table thead a {
        transition: color 0.35s ease;
    }

    .compare-table thead a:hover {
        color: var(--bronze);
    }

    .compare-table tbody th {
        padding-top: 26px;
        font-family: var(--f-body);
        font-size: var(--fs-label);
        font-weight: 600;
        letter-spacing: var(--tracking-label);
        line-height: 1.5;
        text-transform: uppercase;
        color: var(--taupe);
    }

    .compare-table td strong {
        display: block;
        margin-bottom: 6px;
        font-family: var(--f-display);
        font-size: 1.2rem;
        font-weight: 400;
        line-height: 1.3;
        color: var(--espresso);
    }

    .compare-table td span {
        display: block;
        font-size: var(--fs-small);
        line-height: 1.55;
        color: var(--umber);
    }

    .compare-hint {
        display: none;
        font-size: var(--fs-label);
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--taupe);
    }

    .fit-grid :global(.btn-row) {
        margin-top: auto;
        padding-top: 12px;
    }

    @media (max-width: 900px) {
        .compare-hint {
            display: block;
        }

        .compare-col-label {
            width: 124px;
        }

        .compare-table tbody th {
            letter-spacing: 0.12em;
        }

        .compare-table th[scope="row"],
        .compare-table thead th:first-child {
            position: sticky;
            left: 0;
            z-index: 1;
            background: var(--porcelain);
            padding-right: 16px;
        }

        /* Hairline that travels with the sticky label column */
        .compare-table th[scope="row"]::after {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            bottom: 0;
            width: 1px;
            background: var(--rule);
        }
    }
</style>
