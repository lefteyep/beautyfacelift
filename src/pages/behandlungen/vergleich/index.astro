---
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import FaqBlock from '../../../components/treatment/FaqBlock.astro';
import { FACIAL_TREATMENTS } from '../../../components/treatment/catalog';

type Cell = [value: string, note?: string];

// Criteria in display order; each treatment fills one cell per criterion.
const criteria = ['Hauptziel', 'Dauer', 'Gefühl', 'Ausfallzeit', 'Preis', 'Sitzungen', 'Ideal für'] as const;

const comparison: { href: string; cells: Cell[] }[] = [
    {
        href: '/behandlungen/aquafacial-zuerich/',
        cells: [
            ['Glow & Hydration', 'Tiefenreinigung und intensive Hydrierung.'],
            ['60–90 Min.'],
            ['Angenehm', 'Wie eine sanfte Gesichtsmassage.'],
            ['Meist keine', 'Direkt zurück in den Alltag.'],
            ['ab CHF 180', 'Anti Aging CHF 250, erweiterte Varianten CHF 280.'],
            ['Monatlich', 'Im Rhythmus der natürlichen Hauterneuerung.'],
            ['Alle Hauttypen, Glow'],
        ],
    },
    {
        href: '/behandlungen/microneedling-zuerich/',
        cells: [
            ['Anti-Aging & Hautstruktur', 'Kann Hauterneuerung und Kollagenbildung unterstützen.'],
            ['90 Min.'],
            ['Leichtes Piksen', 'Mit Betäubungscreme gut verträglich.'],
            ['24–48 h Rötung', 'Make-up frühestens nach 12 h, 1–2 Tage keine direkte Sonne.'],
            ['ab CHF 210', 'Mit coldPLASMA CHF 220, Carbon Laser + Microneedling CHF 250.'],
            ['3–5 Sitzungen', 'Im Abstand von 4–6 Wochen.'],
            ['Anti-Aging, Narben'],
        ],
    },
    {
        href: '/behandlungen/fruchtsaeure-peeling-zuerich/',
        cells: [
            ['Hauterneuerung & Klärung', 'AHA-Säuren lösen abgestorbene Hautzellen.'],
            ['45–60 Min.'],
            ['Leichtes Brennen', 'Lässt nach der Neutralisation nach.'],
            ['Leichte Schuppung', 'Gehört zur natürlichen Erneuerung.'],
            ['CHF 150', 'Tiefster Preis in diesem Vergleich.'],
            ['4–6 Sitzungen', 'Mit schrittweise steigender Konzentration.'],
            ['Akne, Unreinheiten'],
        ],
    },
    {
        href: '/behandlungen/coldplasma-zuerich/',
        cells: [
            ['Wirkstoffpflege & Hautbarriere', 'Für ein ruhiger wirkendes Hautbild.'],
            ['90 Min.'],
            ['Leichtes Kribbeln', 'Meist keine stärkeren Schmerzen.'],
            ['Meist keine', 'Make-up direkt danach möglich.'],
            ['ab CHF 180', 'Anti Aging und Hautbarriere CHF 220.'],
            ['Nach Bedarf', 'Einzeln oder als Ergänzung.'],
            ['Unreine Haut, Hautbarriere'],
        ],
    },
];

// Keep "CHF 220" on one line.
const keepPrice = (text?: string) => text?.replace(/CHF /g, 'CHF ');

const columns = comparison.map((column) => ({
    ...column,
    treatment: FACIAL_TREATMENTS.find((treatment) => treatment.href === column.href)!,
}));

const faqs = [
    {
        question: 'Aquafacial oder Microneedling – was ist besser?',
        answer: 'Das hängt von Ihrem Hautziel ab. Aquafacial eignet sich für frischen Glow, Tiefenreinigung und Hydration – in der Regel ohne Ausfallzeit. Microneedling kann die natürliche Hauterneuerung und Kollagenbildung unterstützen und passt eher zu Hautstruktur, Poren, feinen Linien oder Narbenoptik.',
    },
    {
        question: 'Kann man verschiedene Behandlungen kombinieren?',
        answer: 'Ja. Beliebt ist Aquafacial mit ColdPlasma oder als Vorbereitung vor Microneedling; Exosome Therapie kann nach persönlicher Hautanalyse ergänzen. Zwischen intensiveren Behandlungen wie Microneedling und Fruchtsäure Peeling sollten mindestens 2–4 Wochen Abstand liegen.',
    },
    {
        question: 'Welche Behandlung hat die wenigste Ausfallzeit?',
        answer: 'Aquafacial und ColdPlasma haben meist keine längere Ausfallzeit. Beim Fruchtsäure Peeling kann eine leichte Schuppung auftreten; Microneedling verursacht eine Rötung von 24–48 Stunden – planen Sie es am besten vor einem freien Tag ein.',
    },
    {
        question: 'Welche dieser Behandlungen ist am günstigsten?',
        answer: 'Im Vergleich dieser vier Behandlungen hat das Fruchtsäure Peeling mit CHF 150 den tiefsten Preis. Aquafacial und ColdPlasma beginnen bei CHF 180, Microneedling bei CHF 210.',
    },
    {
        question: 'Wie finde ich die richtige Behandlung für meinen Hauttyp?',
        answer: 'Am besten über eine persönliche Hautanalyse bei Teresa Stimac. Als Faustregel: fahle, dehydrierte Haut – Aquafacial; Fältchen, Hautstruktur oder Narbenoptik – Microneedling; Unreinheiten und vergrösserte Poren – Fruchtsäure Peeling. ColdPlasma und Exosome Therapie können die Wirkstoffpflege ergänzen.',
    },
];
---

<Base
    title="Gesichtsbehandlungen im Vergleich | Beauty Face Lift Zürich"
    description="Aquafacial, Microneedling, Fruchtsäure Peeling und ColdPlasma im Vergleich: Ziel, Dauer, Ausfallzeit und Preis. Kostenlose Erstberatung in Zürich."
>
    <header class="page-hero cmp-hero">
        <div class="container cmp-hero-inner">
            <div class="cmp-hero-title">
                <div class="reveal-up">
                    <Breadcrumbs items={[
                        { label: 'Home', href: '/' },
                        { label: 'Behandlungen', href: '/behandlungen/' },
                        { label: 'Vergleich' }
                    ]} />
                </div>
                <h1 class="reveal-up d-1">Behandlungen im <em>Vergleich</em></h1>
            </div>
            <div class="cmp-hero-copy">
                <p class="lead reveal-up d-2">Aquafacial, Microneedling, Fruchtsäure Peeling und ColdPlasma nebeneinander – Ziel, Dauer, Ausfallzeit und Preis.</p>
                <div class="btn-row reveal-up d-3">
                    <a href="/termin/" class="btn btn-lg btn-arrow" data-button-location="compare_hero">Termin buchen</a>
                    <a href="/kontakt/" class="btn btn-secondary btn-lg" data-button-location="compare_hero_consultation">Kostenlose Beratung</a>
                </div>
            </div>
        </div>
    </header>

    <!-- Comparison: table on desktop, one card per treatment on mobile -->
    <section class="section section--flush-top" aria-label="Vergleich der Gesichtsbehandlungen">
        <div class="container">
            <div class="cmp-table-wrap">
                <table class="cmp-table">
                    <caption class="sr-only">Aquafacial, Microneedling, Fruchtsäure Peeling und ColdPlasma nach Hauptziel, Dauer, Gefühl, Ausfallzeit, Preis, Sitzungen und Eignung</caption>
                    <colgroup>
                        <col class="cmp-col-label" />
                        {columns.map(() => <col />)}
                    </colgroup>
                    <thead>
                        <tr>
                            <td></td>
                            {columns.map(({ treatment }) => (
                                <th scope="col">
                                    <a href={treatment.href} class="cmp-head">
                                        <span class="cmp-thumb">
                                            <Image src={treatment.image} widths={[96, 160]} sizes="64px" format="webp" quality="mid" loading="lazy" alt="" />
                                        </span>
                                        <span class="cmp-name">{treatment.name}</span>
                                        <span class="cmp-go" aria-hidden="true"></span>
                                    </a>
                                </th>
                            ))}
                        </tr>
                    </thead>
                    <tbody>
                        {criteria.map((label, row) => (
                            <tr>
                                <th scope="row">{label}</th>
                                {columns.map(({ cells }) => (
                                    <td>
                                        <strong>{cells[row][0]}</strong>
                                        {cells[row][1] && <span>{keepPrice(cells[row][1])}</span>}
                                    </td>
                                ))}
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>

            <ul class="cmp-cards">
                {columns.map(({ treatment, cells }) => (
                    <li class="cmp-card">
                        <a href={treatment.href} class="cmp-card-head">
                            <span class="cmp-thumb">
                                <Image src={treatment.image} widths={[96, 160]} sizes="56px" format="webp" quality="mid" loading="lazy" alt="" />
                            </span>
                            <h2 class="cmp-name">{treatment.name}</h2>
                            <span class="cmp-go" aria-hidden="true"></span>
                        </a>
                        <dl>
                            {criteria.map((label, row) => (
                                <div>
                                    <dt>{label}</dt>
                                    <dd>
                                        <strong>{cells[row][0]}</strong>
                                        {cells[row][1] && <span>{keepPrice(cells[row][1])}</span>}
                                    </dd>
                                </div>
                            ))}
                        </dl>
                    </li>
                ))}
            </ul>

            <div class="cmp-more">
                <p>Exosome Therapie wird nach persönlicher Hautanalyse als regenerative Wirkstoffpflege eingeplant.</p>
                <a href="/behandlungen/exosome-therapie-zuerich/" class="btn btn-secondary btn-arrow" data-button-location="compare_exosome">Exosome Therapie</a>
            </div>
        </div>
    </section>

    <!-- FAQ -->
    <section class="section section--shell" aria-label="Häufige Fragen">
        <div class="container">
            <FaqBlock items={faqs}>
                <Fragment slot="title">Gut zu wissen</Fragment>
            </FaqBlock>
        </div>
    </section>

    <!-- Closing CTA -->
    <div class="cmp-cta-space">
        <section class="cta-band" aria-labelledby="cta-title">
            <div class="cta-band-inner">
                <div>
                    <h2 id="cta-title">Noch unsicher? Lassen Sie sich beraten.</h2>
                    <p>Teresa analysiert Ihren Hautzustand und empfiehlt die passende Behandlung – ehrlich und unverbindlich.</p>
                </div>
                <div class="btn-row">
                    <a href="/termin/" class="btn btn-arrow" data-button-location="compare_cta_band">Beratungstermin buchen</a>
                </div>
            </div>
        </section>
    </div>
</Base>

<style>
    .d-1 { --d: 1; }
    .d-2 { --d: 2; }
    .d-3 { --d: 3; }

    /* ─── Hero: title left, lead + CTAs right ─────────────── */
    .cmp-hero-inner {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
        align-items: end;
        gap: 28px clamp(32px, 6vw, 96px);
    }

    .cmp-hero-title {
        display: grid;
        gap: 22px;
        justify-items: start;
    }

    .cmp-hero-title :global(.breadcrumbs) { padding: 0; }

    .cmp-hero h1 {
        max-width: 11ch;
        font-size: clamp(2.75rem, 5.4vw, 5.25rem);
        line-height: 0.96;
        letter-spacing: -0.015em;
    }

    .cmp-hero-copy {
        display: grid;
        gap: 24px;
        justify-items: start;
        padding-bottom: 8px;
    }

    .cmp-hero-copy .lead { max-width: 40ch; }

    /* ─── Shared bits ─────────────────────────────────────── */
    .cmp-thumb {
        flex: none;
        display: block;
        width: 56px;
        height: 56px;
        overflow: hidden;
        border-radius: 50%;
        background: var(--blush);
    }

    .cmp-thumb :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.8s var(--ease-expo);
    }

    .cmp-name {
        font-family: var(--f-serif);
        font-weight: 400;
        font-size: clamp(1.5rem, 1.9vw, 1.8rem);
        line-height: 1.05;
        letter-spacing: -0.01em;
        color: var(--cocoa);
        transition: color 0.3s ease;
    }

    .cmp-go {
        flex: none;
        width: 32px;
        height: 32px;
        margin-left: auto;
        border-radius: 50%;
        border: 1px solid var(--line-strong);
        background: var(--i-arrow-dark) center / 11px no-repeat;
        transition: background 0.3s ease, border-color 0.3s ease, transform 0.45s var(--ease-expo);
    }

    :is(.cmp-head, .cmp-card-head):hover .cmp-name { color: var(--clay); }
    :is(.cmp-head, .cmp-card-head):hover .cmp-thumb :global(img) { transform: scale(1.08); }

    :is(.cmp-head, .cmp-card-head):hover .cmp-go {
        border-color: var(--clay);
        background: var(--i-arrow-light) center / 11px no-repeat, var(--clay);
        transform: rotate(45deg);
    }

    /* ─── Desktop table ───────────────────────────────────── */
    .cmp-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        text-align: left;
    }

    .cmp-col-label { width: 168px; }

    .cmp-table thead :is(th, td) {
        padding: 0 20px 24px 0;
        vertical-align: bottom;
        border-bottom: 1px solid var(--line-strong);
    }

    .cmp-head {
        display: flex;
        align-items: center;
        gap: 14px;
        color: inherit;
    }

    .cmp-table tbody :is(th, td) {
        padding: 20px 24px 20px 0;
        vertical-align: top;
        border-bottom: 1px solid var(--line);
    }

    .cmp-table tbody th {
        font-size: var(--fs-small);
        font-weight: 500;
        line-height: 1.5;
        color: var(--muted);
    }

    .cmp-table td strong,
    .cmp-card dd strong {
        display: block;
        font-weight: 500;
        line-height: 1.4;
        color: var(--cocoa);
    }

    .cmp-table td span,
    .cmp-card dd span {
        display: block;
        margin-top: 4px;
        font-size: var(--fs-small);
        line-height: 1.5;
        color: var(--muted);
    }

    /* Price row stands out a touch */
    .cmp-table tbody tr:nth-child(5) td strong {
        font-family: var(--f-serif);
        font-weight: 400;
        font-size: 1.6rem;
        line-height: 1.1;
    }

    .cmp-table tbody tr:hover td { background: rgba(255, 252, 249, 0.6); }

    /* ─── Mobile cards ────────────────────────────────────── */
    .cmp-cards { display: none; }

    .cmp-card {
        padding: 8px 20px 4px;
        border-radius: var(--r-lg);
        background: var(--paper);
        border: 1px solid var(--line);
    }

    .cmp-card-head {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 0 16px;
        border-bottom: 1px solid var(--line-strong);
        color: inherit;
    }

    .cmp-card dl > div {
        display: grid;
        grid-template-columns: 96px minmax(0, 1fr);
        gap: 12px;
        padding-block: 14px;
        border-bottom: 1px solid var(--line);
    }

    .cmp-card dl > div:last-child { border-bottom: 0; }

    .cmp-card dt {
        font-size: var(--fs-small);
        font-weight: 500;
        color: var(--muted);
    }

    .cmp-card dd { margin: 0; }

    /* ─── Exosome line ────────────────────────────────────── */
    .cmp-more {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 16px 32px;
        margin-top: clamp(32px, 4vw, 48px);
    }

    .cmp-more p {
        max-width: 56ch;
        color: var(--text);
    }

    /* ─── Closing CTA spacing ─────────────────────────────── */
    .cmp-cta-space { padding-top: var(--section-y); }

    @media (max-width: 1000px) {
        .cmp-table-wrap { display: none; }

        .cmp-cards {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px;
        }
    }

    @media (max-width: 900px) {
        .cmp-hero-inner { grid-template-columns: minmax(0, 1fr); }

        .cmp-hero h1 {
            max-width: none;
            font-size: clamp(2.6rem, 11vw, 3.6rem);
        }
    }

    @media (max-width: 680px) {
        .cmp-cards { grid-template-columns: minmax(0, 1fr); }
    }

    @media (max-width: 600px) {
        .cmp-hero-copy .btn-row { width: 100%; }
        .cmp-hero-copy .btn-row .btn { flex: 1 1 100%; }
        .cmp-more .btn { width: 100%; }
    }
</style>
