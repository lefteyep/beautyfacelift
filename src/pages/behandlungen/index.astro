---

import Base from '../../layouts/Base.astro';
import TreatmentLinkCard from '../../components/TreatmentLinkCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const breadcrumbs = [
    { label: 'Home', href: '/' },
    { label: 'Behandlungen' }
];

const structuredData = {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Behandlungen bei Beauty Face Lift Zürich",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "item": {
                "@type": "Service",
                "name": "Hydrafacial Zürich",
                "url": "https://beautyfacelift.ch/behandlungen/hydrafacial-zuerich/",
                "description": "Patentierte Vortex-Technologie zur Tiefenreinigung, Peeling und Hydrierung der Haut in drei Schritten. Sofort sichtbarer Glow ohne Ausfallzeit. Ab CHF 190, Dauer 60–90 Minuten."
            }
        },
        {
            "@type": "ListItem",
            "position": 2,
            "item": {
                "@type": "Service",
                "name": "Microneedling Zürich",
                "url": "https://beautyfacelift.ch/behandlungen/microneedling-zuerich/",
                "description": "Kollagenstimulation durch kontrollierte Mikroverletzungen der Haut. Das natürliche Facelift ohne Operation für straffere Haut und reduzierte Narben. Ab CHF 250, Dauer 60–90 Minuten."
            }
        },
        {
            "@type": "ListItem",
            "position": 3,
            "item": {
                "@type": "Service",
                "name": "Fruchtsäure Peeling Zürich",
                "url": "https://beautyfacelift.ch/behandlungen/fruchtsaeure-peeling-zuerich/",
                "description": "Medizinisches AHA-Peeling zur Hauterneuerung. Entfernt verhornte Zellen, verfeinert Poren und reduziert Akne-Narben und Hyperpigmentierung. Ab CHF 150, Dauer 45–60 Minuten."
            }
        },
        {
            "@type": "ListItem",
            "position": 4,
            "item": {
                "@type": "Service",
                "name": "ColdPlasma Behandlung Zürich",
                "url": "https://beautyfacelift.ch/behandlungen/coldplasma-zuerich/",
                "description": "Ionisiertes Gas bei niedriger Temperatur stimuliert Zellerneuerung, wirkt antimikrobiell und verbessert die Wirkstoffaufnahme um bis zu 300%. Ab CHF 200, Dauer 45–60 Minuten."
            }
        }
    ]
};

const pageFaqs = [
    {
        question: 'Was kostet eine Gesichtsbehandlung in Zürich?',
        answer: 'Die Preise für professionelle Gesichtsbehandlungen bei Beauty Face Lift variieren je nach Behandlungsart und Dauer. Ein <a href="/behandlungen/fruchtsaeure-peeling-zuerich/">Fruchtsäure Peeling</a> beginnt ab CHF 150, ein <a href="/behandlungen/hydrafacial-zuerich/">Hydrafacial</a> ab CHF 190, <a href="/behandlungen/coldplasma-zuerich/">ColdPlasma</a> ab CHF 200 und <a href="/behandlungen/microneedling-zuerich/">Microneedling</a> ab CHF 250. Bei Buchung von Kurpaketen (z. B. 5er-Kur) erhalten Sie bis zu 10 % Rabatt. Alle Preise verstehen sich inklusive Mehrwertsteuer und einer individuellen Hautanalyse durch Teresa Stimac.'
    },
    {
        question: 'Welche Behandlung ist die beste für Anfänger?',
        answer: 'Für Einsteigerinnen empfehlen wir das <a href="/behandlungen/hydrafacial-zuerich/">Hydrafacial</a> — es ist vollkommen schmerzfrei, erfordert keine Ausfallzeit und liefert sofort sichtbare Ergebnisse. Die patentierte Vortex-Technologie kombiniert Tiefenreinigung, sanftes Peeling und intensive Hydrierung in einer einzigen Sitzung. Bereits nach der ersten Behandlung strahlt Ihre Haut sichtbar. Bei einem persönlichen Beratungsgespräch stimmt Teresa die Behandlung individuell auf Ihren Hauttyp ab. <a href="/termin/">Buchen Sie Ihren ersten Termin</a> bequem online.'
    },
    {
        question: 'Kann ich Behandlungen kombinieren?',
        answer: 'Ja, viele unserer Behandlungen lassen sich hervorragend kombinieren, um optimale Ergebnisse zu erzielen. Besonders beliebt ist die Kombination aus <a href="/behandlungen/hydrafacial-zuerich/">Hydrafacial</a> und <a href="/behandlungen/microneedling-zuerich/">Microneedling</a> — das Hydrafacial bereitet die Haut ideal vor und verstärkt die Wirkung des Needlings erheblich. Auch ein <a href="/behandlungen/fruchtsaeure-peeling-zuerich/">Fruchtsäure Peeling</a> gefolgt von einer <a href="/behandlungen/coldplasma-zuerich/">ColdPlasma-Behandlung</a> zeigt synergistische Effekte. Teresa erstellt Ihnen einen individuellen Behandlungsplan, der verschiedene Verfahren optimal aufeinander abstimmt.'
    },
    {
        question: 'Wie buche ich einen Termin?',
        answer: 'Am einfachsten buchen Sie direkt über unsere <a href="/termin/">Online-Terminbuchung</a>. Wählen Sie Ihre gewünschte Behandlung, ein passendes Datum und Ihre bevorzugte Uhrzeit — die Bestätigung erhalten Sie umgehend per E-Mail. Der gesamte Buchungsprozess dauert nur wenige Klicks und ist rund um die Uhr verfügbar. Selbstverständlich können Sie uns auch telefonisch unter +41 79 214 34 62 oder per E-Mail an info@beautyfacelift.ch erreichen. Unser Studio befindet sich an der Bahnhofstrasse 94, 8001 Zürich.'
    }
];

const faqStructuredData = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": pageFaqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": faq.answer.replace(/<[^>]*>/g, '')
        }
    }))
};
---

<Base
    title="Behandlungen | Beauty Face Lift Zürich — Gesichtsbehandlungen an der Bahnhofstrasse"
    description="Entdecken Sie unsere Premium Gesichtsbehandlungen in Zürich: Hydrafacial, Microneedling, Fruchtsäure Peeling und ColdPlasma. Ihr Medical Spa an der Bahnhofstrasse."
    structuredData={structuredData}
>
    <!-- Breadcrumbs -->
    <section class="container" style="padding-top: 100px; padding-bottom: 0;">
        <Breadcrumbs items={breadcrumbs} />
    </section>

    <!-- Page Header — design: 100px 58px 60px -->
    <section class="container" style="padding-top: 16px; padding-bottom: 60px;">
        <span class="sub-display" style="display: block; margin-bottom: 16px;">Unsere Expertise</span>
        <h1 style="font-size: 52px; margin-bottom: 16px;">Behandlungen</h1>
        <p style="max-width: 700px;">Hochwirksame, schonende Verfahren für ein strahlendes, jugendliches Hautbild. Jede Behandlung wird individuell auf Ihren Hauttyp abgestimmt — in unserem Premium Medical Spa an der Bahnhofstrasse Zürich.</p>
        <p style="max-width: 700px; margin-top: 1.25rem;">Unser Behandlungsspektrum umfasst vier Kernbereiche: Tiefenreinigung und sofortigen Glow mit dem Hydrafacial, natürliches Anti-Aging durch Microneedling, intensive Hauterneuerung mit medizinischen Fruchtsäure Peelings sowie innovative Zellregeneration durch ColdPlasma-Technologie. Alle Verfahren sind nicht-invasiv, wissenschaftlich fundiert und werden von Teresa Stimac persönlich durchgeführt.</p>
    </section>

    <!-- Treatment Grid -->
    <section class="container" style="padding-bottom: 120px;">
        <div class="treatments-overview-grid">
            <a href="/behandlungen/hydrafacial-zuerich/" class="treatment-overview-card scroll-anim">
                <div class="service-image-mask" style="padding-bottom: 70%;">
                    <img src="/assets/spa_facial_treatment.png" alt="Hydrafacial Behandlung Zürich" class="anim-img" loading="lazy" width="600" height="420">
                </div>
                <div class="treatment-overview-content">
                    <h3>Hydra Facial</h3>
                    <p>Tiefenreinigung, Vitalisierung und Glow. Die ultimative Pflege für ein strahlendes Selfie-Hautbild mit patentierter Vortex-Technologie.</p>
                    <span class="card-arrow">Details erfahren &rarr;</span>
                </div>
            </a>

            <a href="/behandlungen/microneedling-zuerich/" class="treatment-overview-card scroll-anim">
                <div class="service-image-mask" style="padding-bottom: 70%;">
                    <img src="/assets/spa_products.png" alt="Microneedling Behandlung Zürich" class="anim-img" loading="lazy" width="600" height="420">
                </div>
                <div class="treatment-overview-content">
                    <h3>Micro Needling</h3>
                    <p>Das natürliche Face-Lift ohne OP. Stimulation der körpereigenen Kollagenproduktion für ein sichtbar verfeinertes, straffes Hautbild.</p>
                    <span class="card-arrow">Details erfahren &rarr;</span>
                </div>
            </a>

            <a href="/behandlungen/fruchtsaeure-peeling-zuerich/" class="treatment-overview-card scroll-anim">
                <div class="service-image-mask" style="padding-bottom: 70%;">
                    <img src="/assets/spa_interior.png" alt="Fruchtsäure Peeling Zürich" class="anim-img" loading="lazy" width="600" height="420">
                </div>
                <div class="treatment-overview-content">
                    <h3>Fruchtsäure Peeling</h3>
                    <p>Intensive Hauterneuerung durch natürliche AHA-Säuren. Für einen ebenmässigen, strahlenden Teint und verfeinerte Poren.</p>
                    <span class="card-arrow">Details erfahren &rarr;</span>
                </div>
            </a>

            <a href="/behandlungen/coldplasma-zuerich/" class="treatment-overview-card scroll-anim">
                <div class="service-image-mask" style="padding-bottom: 70%;">
                    <img src="/assets/spa_facial_treatment.png" alt="ColdPlasma Behandlung Zürich" class="anim-img" loading="lazy" width="600" height="420">
                </div>
                <div class="treatment-overview-content">
                    <h3>ColdPlasma</h3>
                    <p>Innovative Plasma-Technologie zur Hautverjüngung. Stimuliert die Zellerneuerung und fördert die Aufnahme hochwirksamer Wirkstoffe.</p>
                    <span class="card-arrow">Details erfahren &rarr;</span>
                </div>
            </a>
        </div>
    </section>

    <!-- Welche Behandlung passt zu mir? -->
    <section class="container" style="padding-bottom: 12vh;">
        <div class="sub-display margin-bottom-md">Ihr persönlicher Guide</div>
        <h2 style="font-size: clamp(2rem, 4vw, 3.5rem); margin-bottom: 1rem; text-transform: none;">Welche Behandlung passt zu mir?</h2>
        <p style="max-width: 650px; margin-bottom: 3rem;">Jedes Hautbild ist einzigartig. Finden Sie die passende Behandlung für Ihr persönliches Hautpflegeziel.</p>

        <div class="highlights-grid highlights-grid--4col">
            <a href="/behandlungen/hydrafacial-zuerich/" class="highlight-item scroll-anim" style="text-decoration: none; color: inherit;">
                <div class="highlight-number">01</div>
                <h4>Sofortiger Glow</h4>
                <p>Fahle, müde Haut? Das Hydrafacial schenkt Ihnen in nur 60 Minuten sichtbar strahlende, hydratisierte Haut — ohne Ausfallzeit.</p>
            </a>

            <a href="/behandlungen/microneedling-zuerich/" class="highlight-item scroll-anim" style="text-decoration: none; color: inherit;">
                <div class="highlight-number">02</div>
                <h4>Anti-Aging & Straffung</h4>
                <p>Feine Linien und Elastizitätsverlust? Microneedling stimuliert Ihre natürliche Kollagenproduktion für sichtbar straffere Haut.</p>
            </a>

            <a href="/behandlungen/fruchtsaeure-peeling-zuerich/" class="highlight-item scroll-anim" style="text-decoration: none; color: inherit;">
                <div class="highlight-number">03</div>
                <h4>Reine Haut & klarer Teint</h4>
                <p>Unreinheiten, grosse Poren oder Pigmentflecken? Das Fruchtsäure Peeling erneuert Ihre Haut Schicht für Schicht.</p>
            </a>

            <a href="/behandlungen/coldplasma-zuerich/" class="highlight-item scroll-anim" style="text-decoration: none; color: inherit;">
                <div class="highlight-number">04</div>
                <h4>Innovation & Regeneration</h4>
                <p>Maximale Wirkstoffaufnahme und Zellregeneration? ColdPlasma-Technologie steigert die Aufnahme um bis zu 300 %.</p>
            </a>
        </div>

        <div style="text-align: center; margin-top: 3rem;">
            <a href="/behandlungen/vergleich/" style="font-family: var(--font-sans); font-weight: 500; color: var(--accent); text-decoration: none; border-bottom: 1px solid var(--accent); padding-bottom: 2px; transition: opacity 0.2s ease;">Ausführlicher Behandlungsvergleich &rarr;</a>
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-section" style="padding: 80px 160px;">
        <div class="faq-label" style="text-align: left;">Häufige Fragen</div>
        <h2 style="font-size: 42px; margin-bottom: 32px; text-transform: none;">Gut zu wissen</h2>

        <div class="faq-list">
            {pageFaqs.map((faq) => (
                <details class="faq-item">
                    <summary><h3>{faq.question}</h3></summary>
                    <div class="faq-answer">
                        <div class="faq-answer-inner">
                            <p set:html={faq.answer} />
                        </div>
                    </div>
                </details>
            ))}
        </div>
    </section>

    <!-- FAQ JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />

    <!-- CTA Section — design: 100px 58px padding -->
    <section class="container" style="padding-bottom: 100px; text-align: center;">
        <h2 style="font-size: 38px; margin-bottom: 20px; text-transform: none;">Bereit für Ihr neues Hautbild?</h2>
        <p style="max-width: 500px; margin: 0 auto 2.5rem;">Buchen Sie Ihren Termin direkt online — unkompliziert und in wenigen Klicks.</p>
        <a href="/termin/" class="pill-btn">Termin buchen</a>
    </section>
</Base>
