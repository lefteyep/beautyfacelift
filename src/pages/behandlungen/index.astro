---
import { absoluteUrl, SERVICE_GROUPS } from '../../../shared/site';
import Base from '../../layouts/Base.astro';
import TreatmentLinkCard from '../../components/TreatmentLinkCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AiSummary from '../../components/AiSummary.astro';
import { Image } from 'astro:assets';
import {
    coldplasmaCard,
    hydrafacialCard,
    microneedlingCard,
    peelingCard,
    spaProducts,
} from '../../lib/site-images';

const overviewCardSizes = '(min-width: 1240px) 595px, (min-width: 901px) 44vw, 100vw';

const breadcrumbs = [
    { label: 'Home', href: '/' },
    { label: 'Behandlungen' }
];

const summaryFacts = [
    { label: 'Ort', value: 'Bahnhofstrasse 94, 8001 Zürich' },
    { label: 'Bereiche', value: 'Gesicht & Haut, Laser-Haarentfernung, Waxing, Wimpern & Brauen, Make-up, Massage' },
    { label: 'Preise', value: 'ab CHF 20; Gesichtsbehandlungen ab CHF 150' },
    { label: 'Durchführung', value: 'persönlich durch Teresa Stimac' },
];

const serviceListItems = SERVICE_GROUPS.flatMap((group) => group.services).map((service, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
        "@type": "Service",
        "name": service.label,
        "url": absoluteUrl(service.href),
        "description": service.description
    }
}));

const structuredData = {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Behandlungen bei Beauty Face Lift Zürich",
    "itemListElement": serviceListItems
};

const pageFaqs = [
    {
        question: 'Was kostet eine Gesichtsbehandlung in Zürich?',
        answer: 'Die Preise variieren je nach Behandlungsart und Dauer. Gesichtsbehandlungen beginnen bei CHF 150, Hydra4Face bei CHF 180, Microneedling bei CHF 210, ColdPlasma bei CHF 180. Waxing beginnt bei CHF 35, Laser-Haarentfernung bei CHF 85, Wimpern- und Brauenleistungen bei CHF 20, Make-up bei CHF 100 und Massagen bei CHF 65 beziehungsweise nach Buchungsumfang. Alle veröffentlichten Preise sollten vor dem Termin anhand der aktuellen Buchungsseite geprüft werden.'
    },
    {
        question: 'Welche Behandlung passt für den Einstieg?',
        answer: 'Für viele neue Kundinnen ist eine klassische <a href="/behandlungen/gesichtsbehandlung-zuerich/">Gesichtsbehandlung</a> oder Hydra4Face ein sinnvoller Einstieg, weil Teresa dabei Hautzustand, Verträglichkeit und Pflegeziel einschätzen kann. Wer bereits weiss, dass Haarentfernung, Wimpern und Brauen, Make-up oder Massage gefragt sind, kann diese Leistungen direkt über die Buchung wählen.'
    },
    {
        question: 'Kann ich Behandlungen kombinieren?',
        answer: 'Ja, viele Leistungen können sinnvoll kombiniert werden, etwa Gesichtsbehandlung mit Wimpern und Brauen oder abgestimmte Hautbehandlungen wie Hydra4Face, Microneedling, Peeling und ColdPlasma. Reihenfolge und Abstand legt Teresa nach Hautzustand, Verträglichkeit und Ziel fest.'
    },
    {
        question: 'Wie buche ich einen Termin?',
        answer: 'Am einfachsten buchen Sie direkt über unsere <a href="/termin/">Online-Terminbuchung</a>. Wählen Sie Ihre gewünschte Behandlung, ein passendes Datum und Ihre bevorzugte Uhrzeit — die Bestätigung erhalten Sie umgehend per E-Mail. Der gesamte Buchungsprozess dauert nur wenige Klicks und ist rund um die Uhr verfügbar. Selbstverständlich können Sie uns auch telefonisch unter +41 79 214 34 62 oder per E-Mail an info@beautyfacelift.ch erreichen. Unser Studio befindet sich an der Bahnhofstrasse 94, 8001 Zürich.'
    }
];

const faqStructuredData = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": pageFaqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": faq.answer.replace(/<[^>]*>/g, '')
        }
    }))
};
---

<Base
    title="Kosmetische Behandlungen Zürich | Beauty Face Lift Bahnhofstrasse"
    description="Kosmetische Behandlungen in Zürich an der Bahnhofstrasse: Gesichtsbehandlung, Hydrafacial, Microneedling, Laser-Haarentfernung, Waxing, Wimpern, Brauen, Make-up und Massage."
    structuredData={structuredData}
>
    <!-- Breadcrumbs -->
    <section class="container" style="padding-top: 88px; padding-bottom: 0;">
        <Breadcrumbs items={breadcrumbs} />
    </section>

    <!-- Page Header — design: 100px 58px 60px -->
    <section class="container" style="padding-top: 16px; padding-bottom: 48px;">
        <span class="sub-display" style="display: block; margin-bottom: 16px;">Unsere Expertise</span>
        <h1 style="font-size: 52px; margin-bottom: 16px;">Kosmetische Behandlungen in Zürich</h1>
        <p style="max-width: 700px;">Professionelle Kosmetik an der Bahnhofstrasse 94: von individueller Gesichtsbehandlung über moderne Hautpflege bis zu Laser-Haarentfernung, Waxing, Wimpern, Brauen, Make-up und Massage.</p>
        <p style="max-width: 700px; margin-top: 1.25rem;">Teresa Stimac stimmt jede Leistung auf Hautzustand, Ziel, Verträglichkeit und Anlass ab. Hautbehandlungen bleiben der fachliche Schwerpunkt; ergänzende Beauty-Leistungen machen Beauty Face Lift zur persönlichen Adresse für gepflegte Ausstrahlung im Herzen von Zürich.</p>
    </section>

    <AiSummary
        title="Behandlungen an der Bahnhofstrasse Zürich"
        intro="Beauty Face Lift bietet Gesichtsbehandlungen, Haarentfernung und ergänzende Beauty-Leistungen an der Bahnhofstrasse 94 in Zürich. Die Auswahl richtet sich nach Ziel, Hautzustand, Anlass und gewünschter Behandlungsdauer."
        facts={summaryFacts}
    />

    <section class="container" style="padding-bottom: 88px;">
        <div class="sub-display margin-bottom-md">Behandlungsbereiche</div>
        <h2 style="font-size: clamp(2rem, 4vw, 3.4rem); margin-bottom: 1rem; text-transform: none;">Von Hautpflege bis Haarentfernung</h2>
        <p style="max-width: 720px; margin-bottom: 2.25rem;">Die Übersicht ist nach natürlicher Suchintention aufgebaut: zuerst Haut und Gesicht, danach kaufnahe Leistungen wie Laser-Haarentfernung Zürich, Waxing Zürich und präzise Beauty-Details.</p>
        <div class="highlights-grid highlights-grid--4col">
            {SERVICE_GROUPS.map((group, index) => (
                <a href={group.href} class="highlight-item scroll-anim" style="text-decoration: none; color: inherit;">
                    <div class="highlight-number">{String(index + 1).padStart(2, '0')}</div>
                    <h4>{group.label}</h4>
                    <p>{group.description}</p>
                </a>
            ))}
        </div>
    </section>

    <!-- Treatment Grid -->
    <section class="container" style="padding-bottom: 88px;">
        <div class="treatments-overview-grid">
            <a href="/behandlungen/hydrafacial-zuerich/" class="treatment-overview-card scroll-anim">
                <div class="service-image-mask service-image-tall">
                    <Image
                        src={hydrafacialCard}
                        widths={[360, 540, 720, 960]}
                        sizes={overviewCardSizes}
                        format="webp"
                        quality="high"
                        alt="Hydrafacial Behandlung Zürich"
                        class="anim-img"
                        loading="lazy"
                    />
                </div>
                <div class="treatment-overview-content">
                    <h3>Hydra Facial</h3>
                    <p>Tiefenreinigung, Vitalisierung und Glow. Professionelle Pflege für ein strahlendes Selfie-Hautbild mit patentierter Vortex-Technologie.</p>
                    <span class="card-arrow">Details erfahren &rarr;</span>
                </div>
            </a>

            <a href="/behandlungen/microneedling-zuerich/" class="treatment-overview-card scroll-anim">
                <div class="service-image-mask service-image-tall">
                    <Image
                        src={microneedlingCard}
                        widths={[360, 540, 720, 960]}
                        sizes={overviewCardSizes}
                        format="webp"
                        quality="high"
                        alt="Microneedling Behandlung Zürich"
                        class="anim-img"
                        loading="lazy"
                    />
                </div>
                <div class="treatment-overview-content">
                    <h3>Micro Needling</h3>
                    <p>Kosmetische Hautbildverbesserung ohne OP. Microneedling kann die körpereigene Kollagenbildung unterstützen und Poren, Textur und feine Linien verfeinern.</p>
                    <span class="card-arrow">Details erfahren &rarr;</span>
                </div>
            </a>

            <a href="/behandlungen/fruchtsaeure-peeling-zuerich/" class="treatment-overview-card scroll-anim">
                <div class="service-image-mask service-image-tall">
                    <Image
                        src={peelingCard}
                        widths={[360, 540, 720, 960]}
                        sizes={overviewCardSizes}
                        format="webp"
                        quality="high"
                        alt="Fruchtsäure Peeling Zürich"
                        class="anim-img"
                        loading="lazy"
                    />
                </div>
                <div class="treatment-overview-content">
                    <h3>Fruchtsäure Peeling</h3>
                    <p>Intensive Hauterneuerung durch natürliche AHA-Säuren. Für einen ebenmässigen, strahlenden Teint und verfeinerte Poren.</p>
                    <span class="card-arrow">Details erfahren &rarr;</span>
                </div>
            </a>

            <a href="/behandlungen/coldplasma-zuerich/" class="treatment-overview-card scroll-anim">
                <div class="service-image-mask service-image-tall">
                    <Image
                        src={coldplasmaCard}
                        widths={[360, 540, 720, 960]}
                        sizes={overviewCardSizes}
                        format="webp"
                        quality="high"
                        alt="ColdPlasma Behandlung Zürich"
                        class="anim-img"
                        loading="lazy"
                    />
                </div>
                <div class="treatment-overview-content">
                    <h3>ColdPlasma</h3>
                    <p>Kosmetische Plasma-Technologie zur unterstützenden Pflege bei unreiner Haut, Hautbarriere und professionellen Wirkstoffen.</p>
                    <span class="card-arrow">Details erfahren &rarr;</span>
                </div>
            </a>

            <a href="/behandlungen/exosome-therapie-zuerich/" class="treatment-overview-card scroll-anim">
                <div class="service-image-mask service-image-tall">
                    <Image
                        src={spaProducts}
                        widths={[360, 540, 720, 960]}
                        sizes={overviewCardSizes}
                        format="webp"
                        quality="high"
                        alt="Exosome Therapie Zürich mit Serum und Hyaluronsäure"
                        class="anim-img"
                        loading="lazy"
                    />
                </div>
                <div class="treatment-overview-content">
                    <h3>Exosome Therapie</h3>
                    <p>Regenerative Kosmetik mit Exosomen Serum beziehungsweise exosomenähnlicher Wirkstofftechnologie. Für Feuchtigkeit, Hautbarriere, Glow und ein ruhigeres Hautbild.</p>
                    <span class="card-arrow">Details erfahren &rarr;</span>
                </div>
            </a>
        </div>
    </section>

    <div class="section-divider"></div>

    <!-- Welche Behandlung passt zu mir? -->
    <section class="container" style="padding-top: 76px; padding-bottom: 92px;">
        <div class="sub-display margin-bottom-md">Ihr persönlicher Guide</div>
        <h2 style="font-size: clamp(2rem, 4vw, 3.5rem); margin-bottom: 1rem; text-transform: none;">Welche Behandlung passt zu mir?</h2>
        <p style="max-width: 650px; margin-bottom: 2.25rem;">Jedes Hautbild ist einzigartig. Finden Sie die passende Behandlung für Ihr persönliches Hautpflegeziel.</p>

        <div class="highlights-grid highlights-grid--4col">
            <a href="/behandlungen/hydrafacial-zuerich/" class="highlight-item scroll-anim" style="text-decoration: none; color: inherit;">
                <div class="highlight-number">01</div>
                <h4>Sofortiger Glow</h4>
                <p>Fahle, müde Haut? Hydra4Face kann in 60 Minuten ein frischeres, hydratisiertes Hautgefühl unterstützen — meist ohne Ausfallzeit.</p>
            </a>

            <a href="/behandlungen/microneedling-zuerich/" class="highlight-item scroll-anim" style="text-decoration: none; color: inherit;">
                <div class="highlight-number">02</div>
                <h4>Anti-Aging & Straffung</h4>
                <p>Feine Linien und Elastizitätsverlust? Microneedling kann die natürliche Hauterneuerung und Kollagenbildung unterstützen und das Hautbild sichtbar verfeinern.</p>
            </a>

            <a href="/behandlungen/fruchtsaeure-peeling-zuerich/" class="highlight-item scroll-anim" style="text-decoration: none; color: inherit;">
                <div class="highlight-number">03</div>
                <h4>Reine Haut & klarer Teint</h4>
                <p>Unreinheiten, grosse Poren oder Pigmentflecken? Das Fruchtsäure Peeling erneuert Ihre Haut Schicht für Schicht.</p>
            </a>

            <a href="/behandlungen/coldplasma-zuerich/" class="highlight-item scroll-anim" style="text-decoration: none; color: inherit;">
                <div class="highlight-number">04</div>
                <h4>Innovation & Regeneration</h4>
                <p>Unreine oder empfindliche Haut? ColdPlasma kann die professionelle Wirkstoffpflege je nach Hautzustand sinnvoll ergänzen.</p>
            </a>

            <a href="/behandlungen/exosome-therapie-zuerich/" class="highlight-item scroll-anim" style="text-decoration: none; color: inherit;">
                <div class="highlight-number">05</div>
                <h4>Regenerative Wirkstoffpflege</h4>
                <p>Fahle, gestresste Haut oder Wunsch nach Exosomen Kosmetik? Exosome Therapie kann Feuchtigkeit, Hautbarriere und Glow unterstützen.</p>
            </a>
        </div>

        <div style="text-align: center; margin-top: 2.5rem;">
            <a href="/behandlungen/vergleich/" style="font-family: var(--font-sans); font-weight: 500; color: var(--accent-text); text-decoration: none; border-bottom: 1px solid var(--accent-text); padding-bottom: 2px; transition: opacity 0.2s ease;">Ausführlicher Behandlungsvergleich &rarr;</a>
        </div>
    </section>

    <div class="section-divider"></div>

    <!-- FAQ Section -->
    <section class="faq-section">
        <div class="faq-label" style="text-align: left;">Häufige Fragen</div>
        <h2 style="font-size: 42px; margin-bottom: 32px; text-transform: none;">Gut zu wissen</h2>

        <div class="faq-list">
            {pageFaqs.map((faq) => (
                <details class="faq-item">
                    <summary><h3>{faq.question}</h3></summary>
                    <div class="faq-answer">
                        <div class="faq-answer-inner">
                            <p set:html={faq.answer} />
                        </div>
                    </div>
                </details>
            ))}
        </div>
    </section>

    <!-- FAQ JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />

    <div class="section-divider"></div>

    <!-- CTA Section — design: 100px 58px padding -->
    <section class="container" style="padding-bottom: 80px; text-align: center;">
        <h2 style="font-size: 38px; margin-bottom: 20px; text-transform: none;">Bereit für Ihr neues Hautbild?</h2>
        <p style="max-width: 500px; margin: 0 auto 2.5rem;">Buchen Sie Ihren Termin direkt online — unkompliziert und in wenigen Klicks.</p>
        <a href="/termin/" class="pill-btn">Termin buchen</a>
    </section>
</Base>
