---
import { absoluteUrl, SERVICE_GROUPS } from '../../../shared/site';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AiSummary from '../../components/AiSummary.astro';
import FaqBlock from '../../components/treatment/FaqBlock.astro';
import LinkList from '../../components/treatment/LinkList.astro';
import { cropFactor, widthsFor } from '../../components/treatment/images';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
    coldplasmaCard,
    aquafacialCard,
    microneedlingCard,
    peelingCard,
    spaProducts,
} from '../../lib/site-images';

const breadcrumbs = [
    { label: 'Home', href: '/' },
    { label: 'Behandlungen' }
];

// Group labels (checked by scripts/seo-plan-smoke.mjs): Gesicht & Haut, Laser-Haarentfernung,
// Waxing, Wimpern & Brauen, Make-up, Massage.
const summaryFacts = [
    { label: 'Ort', value: 'Bahnhofstrasse 94, 8001 Zürich' },
    { label: 'Bereiche', value: 'Gesicht & Haut, Laser-Haarentfernung, Waxing, Wimpern & Brauen, Make-up, Massage' },
    { label: 'Preise', value: 'ab CHF 20; Gesichtsbehandlungen ab CHF 150' },
    { label: 'Durchführung', value: 'persönlich durch Teresa Stimac' },
];

// Exact-match anchor per hub: the service whose page is the group's hub.
const groupAnchor = (group: (typeof SERVICE_GROUPS)[number]) =>
    group.services.find((service) => service.href === group.href)?.label ?? group.label;

const signatureTreatments = [
    {
        href: '/behandlungen/aquafacial-zuerich/',
        name: 'Aquafacial',
        text: 'Tiefenreinigung, Vitalisierung und Glow. Professionelle Pflege für ein strahlendes Selfie-Hautbild mit patentierter Vortex-Technologie.',
        image: aquafacialCard,
        alt: 'Aquafacial Behandlung Zürich',
    },
    {
        href: '/behandlungen/microneedling-zuerich/',
        name: 'Microneedling',
        text: 'Kosmetische Hautbildverbesserung ohne OP. Microneedling kann die körpereigene Kollagenbildung unterstützen und Poren, Textur und feine Linien verfeinern.',
        image: microneedlingCard,
        alt: 'Microneedling Behandlung Zürich',
    },
    {
        href: '/behandlungen/fruchtsaeure-peeling-zuerich/',
        name: 'Fruchtsäure Peeling',
        text: 'Intensive Hauterneuerung durch natürliche AHA-Säuren. Für einen ebenmässigen, strahlenden Teint und verfeinerte Poren.',
        image: peelingCard,
        alt: 'Fruchtsäure Peeling Zürich',
    },
    {
        href: '/behandlungen/coldplasma-zuerich/',
        name: 'ColdPlasma',
        text: 'Kosmetische Plasma-Technologie zur unterstützenden Pflege bei unreiner Haut, Hautbarriere und professionellen Wirkstoffen.',
        image: coldplasmaCard,
        alt: 'ColdPlasma Behandlung Zürich',
    },
    {
        href: '/behandlungen/exosome-therapie-zuerich/',
        name: 'Exosome Therapie',
        text: 'Regenerative Kosmetik mit Exosomen Serum beziehungsweise exosomenähnlicher Wirkstofftechnologie. Für Feuchtigkeit, Hautbarriere, Glow und ein ruhigeres Hautbild.',
        image: spaProducts,
        alt: 'Exosome Therapie Zürich mit Serum und Hyaluronsäure',
    },
];

const featuredSizes = (image: ImageMetadata) => {
    const factor = cropFactor(image, 5 / 4);
    return `(min-width: 1440px) ${Math.round(520 * factor)}px, (min-width: 901px) ${Math.round(36 * factor)}vw, 92vw`;
};
const cardSizes = '(min-width: 1440px) 390px, (min-width: 901px) 28vw, (min-width: 601px) 46vw, 92vw';

const guide = [
    { href: '/behandlungen/aquafacial-zuerich/', title: 'Sofortiger Glow', text: 'Fahle, müde Haut? Aquafacial kann in 60 Minuten ein frischeres, hydratisiertes Hautgefühl unterstützen — meist ohne Ausfallzeit.', meta: 'Aquafacial' },
    { href: '/behandlungen/microneedling-zuerich/', title: 'Anti-Aging & Straffung', text: 'Feine Linien und Elastizitätsverlust? Microneedling kann die natürliche Hauterneuerung und Kollagenbildung unterstützen und das Hautbild sichtbar verfeinern.', meta: 'Microneedling' },
    { href: '/behandlungen/fruchtsaeure-peeling-zuerich/', title: 'Reine Haut & klarer Teint', text: 'Unreinheiten, grosse Poren oder Pigmentflecken? Das Fruchtsäure Peeling erneuert Ihre Haut Schicht für Schicht.', meta: 'Peeling' },
    { href: '/behandlungen/coldplasma-zuerich/', title: 'Innovation & Regeneration', text: 'Unreine oder empfindliche Haut? ColdPlasma kann die professionelle Wirkstoffpflege je nach Hautzustand sinnvoll ergänzen.', meta: 'ColdPlasma' },
    { href: '/behandlungen/exosome-therapie-zuerich/', title: 'Regenerative Wirkstoffpflege', text: 'Fahle, gestresste Haut oder Wunsch nach Exosomen Kosmetik? Exosome Therapie kann Feuchtigkeit, Hautbarriere und Glow unterstützen.', meta: 'Exosome' },
];

type ServiceGroupService = (typeof SERVICE_GROUPS)[number]['services'][number];

const serviceListItems = SERVICE_GROUPS.flatMap<ServiceGroupService>((group) => group.services).map((service, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
        "@type": "Service",
        "name": service.label,
        "url": absoluteUrl(service.href),
        "description": service.description
    }
}));

const structuredData = {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Behandlungen bei Beauty Face Lift Zürich",
    "itemListElement": serviceListItems
};

const pageFaqs = [
    {
        question: 'Was kostet eine Gesichtsbehandlung in Zürich?',
        answer: 'Die Preise variieren je nach Behandlungsart und Dauer. Gesichtsbehandlungen beginnen bei CHF 150, Aquafacial bei CHF 180, Microneedling bei CHF 210, ColdPlasma bei CHF 180. Waxing beginnt bei CHF 35, Laser-Haarentfernung bei CHF 85, Wimpern- und Brauenleistungen bei CHF 20, Make-up bei CHF 100 und Massagen bei CHF 65 beziehungsweise nach Buchungsumfang. Alle veröffentlichten Preise sollten vor dem Termin anhand der aktuellen Buchungsseite geprüft werden.'
    },
    {
        question: 'Welche Behandlung passt für den Einstieg?',
        answer: 'Für viele neue Kundinnen ist eine klassische <a href="/behandlungen/gesichtsbehandlung-zuerich/">Gesichtsbehandlung</a> oder Aquafacial ein sinnvoller Einstieg, weil Teresa dabei Hautzustand, Verträglichkeit und Pflegeziel einschätzen kann. Wer bereits weiss, dass Haarentfernung, Wimpern und Brauen, Make-up oder Massage gefragt sind, kann diese Leistungen direkt über die Buchung wählen.'
    },
    {
        question: 'Kann ich Behandlungen kombinieren?',
        answer: 'Ja, viele Leistungen können sinnvoll kombiniert werden, etwa Gesichtsbehandlung mit Wimpern und Brauen oder abgestimmte Hautbehandlungen wie Aquafacial, Microneedling, Peeling und ColdPlasma. Reihenfolge und Abstand legt Teresa nach Hautzustand, Verträglichkeit und Ziel fest.'
    },
    {
        question: 'Wie buche ich einen Termin?',
        answer: 'Am einfachsten buchen Sie direkt über unsere <a href="/termin/">Online-Terminbuchung</a>. Wählen Sie Ihre gewünschte Behandlung, ein passendes Datum und Ihre bevorzugte Uhrzeit — die Bestätigung erhalten Sie umgehend per E-Mail. Der gesamte Buchungsprozess dauert nur wenige Klicks und ist rund um die Uhr verfügbar. Selbstverständlich können Sie uns auch telefonisch unter +41 79 214 34 62 oder per E-Mail an info@beautyfacelift.ch erreichen. Unser Studio befindet sich an der Bahnhofstrasse 94, 8001 Zürich.'
    }
];

const faqStructuredData = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": pageFaqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": faq.answer.replace(/<[^>]*>/g, '')
        }
    }))
};
---

<Base
    title="Kosmetische Behandlungen Zürich | Beauty Face Lift Bahnhofstrasse"
    description="Kosmetische Behandlungen in Zürich an der Bahnhofstrasse: Gesichtsbehandlung, Aquafacial, Microneedling, Laser-Haarentfernung, Waxing, Wimpern, Brauen, Make-up und Massage."
    structuredData={structuredData}
>
    <header class="page-hero page-hero--split overview-hero">
        <div class="container page-hero-inner">
            <div class="page-hero-copy">
                <div class="reveal-up">
                    <Breadcrumbs items={breadcrumbs} />
                </div>
                <p class="eyebrow eyebrow--rule reveal-up d-1">Unsere Expertise</p>
                <h1 class="reveal-up d-2">Kosmetische Behandlungen in <em>Zürich</em></h1>
                <p class="lead reveal-up d-3">Professionelle Kosmetik an der Bahnhofstrasse 94: von individueller Gesichtsbehandlung über moderne Hautpflege bis zu Laser-Haarentfernung, Waxing, Wimpern, Brauen, Make-up und Massage.</p>
                <p class="reveal-up d-3">Teresa Stimac stimmt jede Leistung auf Hautzustand, Ziel, Verträglichkeit und Anlass ab. Hautbehandlungen bleiben der fachliche Schwerpunkt; ergänzende Beauty-Leistungen machen Beauty Face Lift zur persönlichen Adresse für gepflegte Ausstrahlung im Herzen von Zürich.</p>
                <div class="btn-row reveal-up d-4">
                    <a href="/termin/" class="btn">Termin buchen</a>
                    <a href="/behandlungen/vergleich/" class="btn-link">Behandlungen vergleichen</a>
                </div>
            </div>
            <div class="reveal-up d-5">
                <AiSummary
                    variant="aside"
                    title="Behandlungen an der Bahnhofstrasse Zürich"
                    intro="Beauty Face Lift bietet Gesichtsbehandlungen, Haarentfernung und ergänzende Beauty-Leistungen an der Bahnhofstrasse 94 in Zürich. Die Auswahl richtet sich nach Ziel, Hautzustand, Anlass und gewünschter Behandlungsdauer."
                    facts={summaryFacts}
                />
            </div>
        </div>
    </header>

    <!-- Service groups -->
    <section class="section section--ivory" aria-labelledby="groups-title">
        <div class="container">
            <div class="section-head">
                <div>
                    <p class="eyebrow eyebrow--rule">Behandlungsbereiche</p>
                    <h2 id="groups-title">Von Hautpflege bis <em>Haarentfernung</em></h2>
                    <p class="lead groups-lead">Haut und Gesicht stehen bei uns im Mittelpunkt. Ergänzend finden Sie an der Bahnhofstrasse alles für gepflegte Details: <a href="/behandlungen/laser-haarentfernung-zuerich/">Laser-Haarentfernung Zürich</a>, <a href="/behandlungen/waxing-zuerich/">Waxing Zürich</a> sowie Wimpern, Brauen, Make-up und Massage.</p>
                </div>
            </div>
            <ul class="index-grid">
                {SERVICE_GROUPS.map((group) => (
                    <li>
                        <a href={group.href} class="group-link scroll-anim">
                            <h3>{group.label}</h3>
                            <p>{group.description}</p>
                            <span class="card-arrow">{groupAnchor(group)} &rarr;</span>
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <!-- Signature treatments -->
    <section class="section" aria-labelledby="signature-title">
        <div class="container">
            <div class="section-head">
                <div>
                    <p class="eyebrow eyebrow--rule">Signature-Behandlungen</p>
                    <h2 id="signature-title">Haut im <em>Fokus</em></h2>
                </div>
            </div>
            <ul class="signature-grid">
                {signatureTreatments.map((treatment, index) => (
                    <li class:list={['signature-card', index === 0 && 'is-featured']}>
                        <a href={treatment.href} class="signature-link scroll-anim">
                            <span class:list={['media', 'signature-media', index === 0 ? 'media--portrait' : 'media--landscape']}>
                                <Image
                                    src={treatment.image}
                                    widths={widthsFor(treatment.image)}
                                    sizes={index === 0 ? featuredSizes(treatment.image) : cardSizes}
                                    format="webp"
                                    quality="high"
                                    loading="lazy"
                                    alt={treatment.alt}
                                />
                            </span>
                            <h3>{treatment.name}</h3>
                            <p>{treatment.text}</p>
                            <span class="card-arrow">Details erfahren &rarr;</span>
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <!-- Guide -->
    <section class="section section--sand" aria-labelledby="guide-title">
        <div class="container">
            <div class="section-head">
                <div>
                    <p class="eyebrow eyebrow--rule">Ihr persönlicher Guide</p>
                    <h2 id="guide-title">Welche Behandlung passt zu <em>mir</em>?</h2>
                    <p class="lead">Jedes Hautbild ist einzigartig. Finden Sie die passende Behandlung für Ihr persönliches Hautpflegeziel.</p>
                </div>
                <a href="/behandlungen/vergleich/" class="btn-link">Ausführlicher Behandlungsvergleich</a>
            </div>
            <LinkList items={guide} />
        </div>
    </section>

    <!-- FAQ -->
    <section class="section overview-faq" aria-label="Häufige Fragen">
        <div class="container">
            <FaqBlock>
                <Fragment slot="title">Gut zu <em>wissen</em></Fragment>
                {pageFaqs.map((faq) => (
                    <details class="faq-item">
                        <summary><h3>{faq.question}</h3></summary>
                        <div class="faq-answer">
                            <div class="faq-answer-inner">
                                <p set:html={faq.answer} />
                            </div>
                        </div>
                    </details>
                ))}
            </FaqBlock>
        </div>
    </section>

    <!-- FAQ JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />

    <!-- Closing CTA -->
    <section class="cta-band" aria-labelledby="cta-title">
        <div class="cta-band-inner">
            <div>
                <p class="eyebrow eyebrow--rule">Termin</p>
                <h2 id="cta-title">Bereit für Ihr neues <em>Hautbild</em>?</h2>
                <p>Buchen Sie Ihren Termin direkt online — unkompliziert und in wenigen Klicks.</p>
            </div>
            <div class="btn-row">
                <a href="/termin/" class="btn">Termin buchen</a>
            </div>
        </div>
    </section>
</Base>

<style>
    .d-1 { --d: 1; }
    .d-2 { --d: 2; }
    .d-3 { --d: 3; }
    .d-4 { --d: 4; }
    .d-5 { --d: 5; }

    .overview-hero .page-hero-copy :global(.breadcrumbs) {
        padding: 0;
    }

    .overview-hero h1 {
        max-width: 13ch;
    }

    .overview-hero .btn-row {
        margin-top: 8px;
    }

    .groups-lead a,
    .overview-faq :global(.faq-answer a) {
        color: var(--espresso);
        text-decoration: underline;
        text-decoration-color: var(--rule-strong);
        text-underline-offset: 4px;
        transition: color 0.3s ease, text-decoration-color 0.3s ease;
    }

    .groups-lead a:hover,
    .overview-faq :global(.faq-answer a:hover) {
        color: var(--bronze);
        text-decoration-color: currentColor;
    }

    .group-link {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 12px;
        color: inherit;
    }

    .group-link :global(.card-arrow) {
        margin-top: auto;
        padding-top: 8px;
    }

    .group-link:hover :global(.card-arrow) {
        transform: translateX(5px);
        color: var(--bronze);
    }

    /* Signature: one featured portrait beside a 2 x 2 of landscape cards */
    .signature-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr) minmax(0, 1fr);
        gap: clamp(40px, 5vw, 72px) clamp(24px, 3vw, 48px);
    }

    .signature-card.is-featured {
        grid-row: span 2;
    }

    .signature-link {
        display: flex;
        flex-direction: column;
        gap: 14px;
        height: 100%;
        color: inherit;
    }

    .signature-media {
        display: block;
        margin-bottom: 8px;
    }

    .is-featured .signature-media :global(img) {
        object-position: 62% 50%;
    }

    .signature-link h3 {
        font-size: var(--fs-h3);
        transition: color 0.35s ease;
    }

    .is-featured h3 {
        font-size: var(--fs-h2);
    }

    .signature-link p {
        margin: 0;
    }

    .signature-link :global(.card-arrow) {
        margin-top: auto;
    }

    .is-featured .signature-link :global(.card-arrow) {
        margin-top: 4px;
    }

    .signature-link:hover h3 {
        color: var(--bronze);
    }

    @media (max-width: 900px) {
        .signature-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .signature-card.is-featured {
            grid-column: 1 / -1;
            grid-row: auto;
        }

        .is-featured .signature-media {
            aspect-ratio: 3 / 2;
        }
    }

    @media (max-width: 600px) {
        .signature-grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
