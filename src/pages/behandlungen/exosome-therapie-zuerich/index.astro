---
import { absoluteUrl, bookingLinkForService } from '../../../../shared/site';
import Base from '../../../layouts/Base.astro';
import BookingCta from '../../../components/BookingCta.astro';
import TreatmentHero from '../../../components/treatment/TreatmentHero.astro';
import TreatmentSplit from '../../../components/treatment/TreatmentSplit.astro';
import BenefitList from '../../../components/treatment/BenefitList.astro';
import TreatmentSteps from '../../../components/treatment/TreatmentSteps.astro';
import RuledList from '../../../components/treatment/RuledList.astro';
import FaqBlock from '../../../components/treatment/FaqBlock.astro';
import RelatedTreatments from '../../../components/treatment/RelatedTreatments.astro';
import { treatmentHeroPreload } from '../../../components/treatment/images';
import { consultationTrust, spaFacialTreatment, spaProducts } from '../../../lib/site-images';
import consultation from '../../../assets/lp/aquafacial/hautanalyse-beratung-zuerich.webp';
import { beautySalonRef } from '../../../lib/schema';

const pagePath = '/behandlungen/exosome-therapie-zuerich/';
const bookingHref = bookingLinkForService('Exosome Therapie');
const heroPreload = await treatmentHeroPreload(spaProducts);

const canonicalUrl = absoluteUrl(pagePath);

// What exosomes are — cautious, compliance-oriented wording.
const background = [
    { title: 'Natürliche Exosomen', text: 'Winzige extrazelluläre Vesikel, die Zellen zur Kommunikation nutzen und die Proteine, Lipide und Nukleinsäuren transportieren können.' },
    { title: 'Biomimetische Wirkstoffe', text: 'In der Kosmetik häufig pflanzlich, vegan oder biomimetisch – nicht identisch mit menschlichen körpereigenen Exosomen, aber als Trägersysteme für pflegende Wirkstoffe einsetzbar.' },
    { title: 'Kosmetisch statt medizinisch', text: 'Im Vordergrund stehen Feuchtigkeit, Glow, Hautbarriere und Textur – keine Krankheitsbehandlung, keine permanente Verjüngung, keine Stammzellwirkung.' },
];

const benefits = [
    { title: 'Feuchtigkeit & Glow', text: 'In Kombination mit Hyaluronsäure kann die Behandlung ein pralleres, frischer wirkendes Hautgefühl unterstützen.' },
    { title: 'Ruhigere Hautbarriere', text: 'Beruhigende, antioxidative und hydratisierende Wirkstoffe können helfen, die Hautbarriere nach ästhetischen Behandlungen zu pflegen.' },
    { title: 'Feinere Hautstruktur', text: 'Bei einer Behandlungsserie kann die Hautoberfläche ebenmässiger wirken – die individuelle Wirkung kann variieren.' },
];

const steps = [
    { title: 'Hautanalyse', text: 'Hauttyp, Empfindlichkeit, aktuelle Pflege, Hautziele und mögliche Gegenanzeigen werden besprochen.' },
    { title: 'Vorbereitung', text: 'Die Haut wird gereinigt und je nach Bedarf sanft vorbereitet, etwa mit einem Facial oder einer Hydration.' },
    { title: 'Serum-Anwendung', text: 'Das Exosomen Serum beziehungsweise exosomenähnliche Wirkstoffserum wird sorgfältig aufgetragen.' },
    { title: 'Beruhigung', text: 'Eine abschliessende Pflege unterstützt Feuchtigkeit und Hautbarriere; Sonnenschutz ist Teil der Nachsorge.' },
];

const suitedFor = [
    'Fahle, müde oder gestresste Haut',
    'Trockenheitsgefühl und geschwächte Hautbarriere',
    'Feine Linien, Elastizitätsverlust und unruhige Textur',
    'Pflege nach Microneedling, wenn die Haut dafür geeignet ist',
];

const faqs = [
    {
        question: 'Was ist eine Exosome Therapie?',
        answer: 'Eine kosmetisch-ästhetische Gesichtsbehandlung, bei der ein Exosomen-Serum beziehungsweise exosomenähnliche Wirkstofftechnologie auf die vorbereitete Haut aufgetragen wird. Sie ersetzt keine ärztliche Therapie und ist keine Stammzell-Injektion.',
    },
    {
        question: 'Was sind Exosomen in der Hautpflege?',
        answer: 'Natürliche Exosomen sind sehr kleine extrazelluläre Vesikel, die Zellen zur Kommunikation nutzen. In der Kosmetik werden häufig biomimetische, pflanzliche oder vegane exosomenähnliche Wirkstoffsysteme eingesetzt – sie sind nicht identisch mit körpereigenen menschlichen Exosomen.',
    },
    {
        question: 'Wie läuft die Exosome Gesichtsbehandlung bei Beauty Face Lift ab?',
        answer: 'Nach Hautanalyse, Reinigung und Vorbereitung wird ein abgestimmtes Exosomen Serum oder exosomenähnliches Serum mit Hyaluronsäure und beruhigenden Wirkstoffen aufgetragen. Zum Abschluss erhält die Haut beruhigende Pflege und Sonnenschutz.',
    },
    {
        question: 'Ist Microneedling mit Exosomen sinnvoll?',
        answer: 'Microneedling kann die Haut für Wirkstoffe vorübergehend aufnahmefähiger machen. Ob die Kombination sinnvoll ist, hängt von Hautzustand, Empfindlichkeit und Behandlungszielen ab – eine persönliche Beratung ist wichtig.',
    },
    {
        question: 'Welche Ergebnisse sind realistisch?',
        answer: 'Realistisch sind ein frischer wirkender Teint, mehr Feuchtigkeitsgefühl, ein ruhigeres Hautbild und eine feinere Hautstruktur. Die individuelle Wirkung variiert; garantierte, permanente oder medizinische Regenerationsergebnisse versprechen wir nicht.',
    },
    {
        question: 'Ist eine Exosome Behandlung sicher?',
        answer: 'Bei kosmetischer Anwendung mit geeigneten, qualitätsgeprüften Produkten ist die Behandlung in der Regel gut verträglich. Vorübergehende Rötung, Wärme- oder Spannungsgefühl sind möglich, besonders mit Microneedling. Allergien, Hautinfektionen und offene Stellen klären wir vorab ab.',
    },
    {
        question: 'Für wen eignet sich die Exosome Therapie Gesicht?',
        answer: 'Für fahle, trockene, gestresste oder unebenmässige Haut, erste Linien oder zur beruhigenden Pflege nach einer professionellen Behandlung. Nicht geeignet ist sie bei offenen Wunden, aktiven Infektionen, akutem Herpes, unklaren Hautreaktionen oder bekannten Allergien gegen Inhaltsstoffe.',
    },
    {
        question: 'Wie viele Sitzungen werden empfohlen?',
        answer: 'Das hängt vom Hautzustand und vom Ziel ab. Häufig wird eine Serie im Abstand von einigen Wochen geplant, anschliessend können Erhaltungstermine sinnvoll sein.',
    },
    {
        question: 'Bietet Beauty Face Lift Exosome Therapie in der Schweiz an?',
        answer: 'Ja, als kosmetisch-ästhetische Gesichtsbehandlung in Zürich an der Bahnhofstrasse 94. Kundinnen und Kunden aus Zürich, dem Kanton Zürich und der Schweiz können online einen Beratungstermin buchen.',
    },
];

const structuredData = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "Service",
            "@id": `${canonicalUrl}#service`,
            "name": "Exosome Therapie Zürich",
            "alternateName": [
                "Exosome Behandlung",
                "Exosome Gesichtsbehandlung",
                "Exosomen Behandlung Gesicht",
                "Microneedling mit Exosomen"
            ],
            "serviceType": "Exosome Therapie Gesicht",
            "category": "Kosmetisch-ästhetische Gesichtsbehandlung",
            "url": canonicalUrl,
            "image": absoluteUrl('/assets/spa_products.png'),
            "description": "Kosmetisch-ästhetische Exosome Therapie in Zürich mit Exosomen-Serum beziehungsweise exosomenähnlicher Wirkstofftechnologie, Hyaluronsäure und persönlicher Hautanalyse. Ziel ist ein frischer, hydratisierter und ebenmässiger wirkendes Hautbild ohne übertriebene medizinische Versprechen.",
            "provider": beautySalonRef(),
            "areaServed": [
                "Zürich",
                "Kanton Zürich",
                "Schweiz"
            ]
        }
    ]
};
---

<Base
    title="Exosome Therapie Zürich | Beauty Face Lift Bahnhofstrasse"
    description="Exosome Gesichtsbehandlung in Zürich: Exosomen Serum, Hyaluronsäure und persönliche Hautanalyse bei Beauty Face Lift, Bahnhofstrasse. Beratung buchen."
    canonical={canonicalUrl}
    preloadImage={heroPreload}
    ogImage={absoluteUrl('/assets/spa_products.png')}
    structuredData={structuredData}
>
    <TreatmentHero
        treatment="Exosome Therapie"
        breadcrumb="Exosome Therapie Zürich"
        lead="Exosome Therapie in Zürich: eine kosmetisch-ästhetische Gesichtsbehandlung mit Exosomen Serum beziehungsweise exosomenähnlicher Wirkstofftechnologie."
        bookingHref={bookingHref}
        image={spaProducts}
        alt="Exosome Therapie Zürich mit regenerativem Serum bei Beauty Face Lift"
        focus="right"
        price="Persönliche Beratung"
        duration="Plan nach Hautanalyse"
    >Exosome Therapie <em>Zürich</em></TreatmentHero>

    <!-- What exosomes are -->
    <section class="section section--flush-top" aria-labelledby="intro-title">
        <div class="container">
            <TreatmentSplit image={spaFacialTreatment} alt="Exosome Gesichtsbehandlung mit professioneller Hautanalyse in Zürich">
                <h2 id="intro-title">Was sind Exosomen?</h2>
                <p class="lead">Exosomen sind ein spannendes Feld der regenerativen Hautpflege, aber kein Wundermittel.</p>
                <BenefitList items={background} />
                <div class="btn-row">
                    <a href={bookingHref} class="btn btn-secondary btn-arrow" data-treatment="Exosome Therapie" data-button-location="exosome_skin_analysis">Persönliche Hautanalyse buchen</a>
                </div>
            </TreatmentSplit>
        </div>
    </section>

    <!-- What it can support -->
    <section class="section section--shell" aria-labelledby="benefits-title">
        <div class="container">
            <div class="section-head">
                <div>
                    <h2 id="benefits-title">Was die Behandlung unterstützen kann</h2>
                    <p class="lead">Ziel ist ein hydratisierter, ruhiger und ebenmässiger wirkendes Hautbild – als eigenständiges Facial oder kombiniert mit Microneedling.</p>
                </div>
            </div>
            <BenefitList items={benefits} columns />
        </div>
    </section>

    <!-- Process -->
    <section class="section" aria-labelledby="process-title">
        <div class="container">
            <div class="section-head">
                <div>
                    <h2 id="process-title">So läuft die Behandlung ab</h2>
                    <p class="lead">Teresa stimmt Vorbereitung, Intensität und Wirkstoffauswahl auf Ihr Hautbild ab.</p>
                </div>
            </div>
            <TreatmentSteps steps={steps} />
        </div>
    </section>

    <!-- Suitability & limits -->
    <section class="section section--flush-top" aria-labelledby="suitability-title">
        <div class="container">
            <TreatmentSplit image={consultationTrust} alt="Persönliche Beratung für Exosome Therapie Zürich bei Teresa Stimac" quality="high" reverse>
                <h2 id="suitability-title">Für wen ist die Exosome Therapie geeignet?</h2>
                <p class="lead">Wenn Sie sich regenerative Hautpflege mit natürlichem Finish wünschen – ohne aggressive Versprechen oder starke Ausfallzeit.</p>
                <RuledList items={suitedFor} />
                <p class="split-note">Nicht geeignet bei offenen Wunden, aktiven Infektionen, akutem Herpes, unklaren Hautreaktionen oder bekannten Allergien gegen Inhaltsstoffe. Die Behandlung ersetzt keine ärztliche Therapie.</p>
            </TreatmentSplit>
        </div>
    </section>

    <!-- FAQ -->
    <section class="section section--shell" aria-label="Häufige Fragen">
        <div class="container">
            <FaqBlock items={faqs}>
                <Fragment slot="title">Fragen zur Exosome Therapie</Fragment>
            </FaqBlock>
        </div>
    </section>

    <!-- Booking -->
    <section class="section" id="buchen">
        <div class="container">
            <BookingCta
                treatment="Exosome Therapie"
                href={bookingHref}
                title="Exosome Therapie in Zürich besprechen"
                text="Teresa analysiert Ihre Haut persönlich und klärt, ob Exosome Therapie, Microneedling mit Exosomen oder eine andere Behandlung zu Ihrem Hautziel passt."
                image={consultation}
                alt="Teresa Stimac bespricht mit einer Kundin die Hautanalyse"
            />
        </div>
    </section>

    <RelatedTreatments current={pagePath} />
</Base>
