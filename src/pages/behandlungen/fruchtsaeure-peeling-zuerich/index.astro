---

import Base from '../../../layouts/Base.astro';
import Marquee from '../../../components/Marquee.astro';
import TreatmentLinkCard from '../../../components/TreatmentLinkCard.astro';
import BookingWidget from '../../../components/booking/BookingWidget';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';

const structuredData = {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Fruchtsäure Peeling Zürich",
    "provider": {
        "@type": "HealthAndBeautyBusiness",
        "name": "Beauty Face Lift",
        "address": {
            "@type": "PostalAddress",
            "streetAddress": "Bahnhofstrasse 94",
            "addressLocality": "Zürich",
            "postalCode": "8001",
            "addressCountry": "CH"
        }
    },
    "description": "Erneuerndes Skin Peeling für eine tiefengereinigte und strahlende Hautstruktur in Zürich.",
    "areaServed": "Zürich"
};

const faqData = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{
        "@type": "Question",
        "name": "Brennt ein Fruchtsäure Peeling?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ein leichtes Brennen oder Kribbeln ist normal und ein gewolltes Wirksamkeitszeichen. Die Säure wird von unseren Kosmetikerinnen anschliessend stets fachgerecht neutralisiert."
        }
    }, {
        "@type": "Question",
        "name": "Pellt man sich extrem nach der Behandlung?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nein, moderne Rezepturen führen meist nur zu einer oberflächlichen, fast unsichtbaren Mikroschuppung, sodass keine gesellschaftlichen Ausfallzeiten bestehen."
        }
    }, {
        "@type": "Question",
        "name": "Wie oft sollte man ein Fruchtsäure Peeling machen?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Für beste Ergebnisse empfehlen wir eine Kur von 4 bis 6 Behandlungen im Abstand von 2 bis 4 Wochen. Danach genügen Erhaltungsbehandlungen alle 6 bis 8 Wochen."
        }
    }, {
        "@type": "Question",
        "name": "Kann man Fruchtsäure Peeling im Sommer machen?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Grundsätzlich ja, allerdings ist konsequenter Sonnenschutz nach der Behandlung absolut notwendig. Wir beraten Sie individuell zur optimalen Jahreszeit für Ihre Behandlung."
        }
    }]
};
---

<Base
    title="Fruchtsäure Peeling Zürich | Medical Skin Peeling"
    description="Tiefenreinigendes Fruchtsäure Peeling in Zürich. Premium Medical Spa Behandlung gegen Akne, grobporige Haut und feine Fältchen an der Bahnhofstrasse."
    preloadImage="/assets/spa_interior.png"
    navVariant="treatment"
    structuredData={structuredData}
>
    <!-- Editorial Hero with Background Image -->
    <header class="treatment-hero">
        <div class="treatment-hero-media">
            <img src="/assets/spa_interior.png" alt="Fruchtsäure Peeling Medical Spa Zürich" id="treatment-hero-img">
        </div>
        <div class="hero-titles">
            <div class="sub-display text-reveal-wrapper margin-bottom-sm">
                <span class="text-reveal" style="color: rgba(237, 235, 230, 0.7);">Hauterneuerung • Zürich</span>
            </div>
            <h1 class="sr-only">Fruchtsäure Peeling Zürich — Klärende Medical Spa Behandlung</h1>
            <div class="title-line text-reveal-wrapper" aria-hidden="true">
                <span class="display-text text-reveal" style="color: var(--text-inverse); font-size: clamp(3.5rem, 8vw, 8rem);">Fruchtsäure</span>
            </div>
            <div class="title-line title-right text-reveal-wrapper" aria-hidden="true">
                <span class="display-text text-reveal" style="color: var(--text-inverse); font-style: italic; font-size: clamp(3.5rem, 8vw, 8rem);">Peeling</span>
            </div>
        </div>
    </header>

    <div class="container" style="padding-top: 1rem;">
        <Breadcrumbs items={[
            { label: "Home", href: "/" },
            { label: "Behandlungen", href: "/behandlungen/" },
            { label: "Fruchtsäure Peeling Zürich" }
        ]} />
    </div>

    <Marquee items={["AHA Peeling", "Hauterneuerung", "Porenverfeinerung", "Strahlender Teint"]} />

    <!-- Content Split -->
    <section class="about-editorial pad-y container">
        <div class="split-layout align-center">
            <div class="about-text scroll-anim">
                <div class="sub-display margin-bottom-md">01 / Die Methode</div>
                <h2 style="font-size: clamp(2rem, 3.5vw, 3.5rem); text-transform: none; margin-bottom: 2rem;">"Tiefenreinigung.<br>Kompromisslos klar."</h2>
                <p class="margin-bottom-md">Das medizinische Fruchtsäure Peeling ist die bewährteste Methode, um das Hautbild fundamental zu erneuern. Hochwertige Alpha-Hydroxysäuren (AHA) tragen die verhornten Hautzellen sanft aber bestimmt ab. Ideal bei Unreinheiten, Akne-Narben, grossporiger Haut oder Grauschleier. Erleben Sie das Gefühl von völlig freier, atmender Haut direkt an der Zürcher Bahnhofstrasse.</p>
                <a href="#buchen" class="pill-btn pill-btn-outline">Termin vereinbaren</a>
            </div>
            <div class="about-image scroll-anim">
                <div class="service-image-mask" style="padding-bottom: 120%;">
                    <img src="/assets/spa_interior.png" alt="Fruchtsäure Peeling Spa Ambience" class="anim-img" loading="lazy">
                </div>
            </div>
        </div>
    </section>

    <!-- Highlights Grid -->
    <section class="container" style="padding-bottom: 15vh;">
        <div class="sub-display margin-bottom-lg" style="text-align: center;">02 / Vorteile</div>
        <div class="highlights-grid">
            <div class="highlight-item scroll-anim">
                <div class="highlight-number">01</div>
                <h4>Tiefenwirkung</h4>
                <p>AHA-Säuren dringen in tiefe Hautschichten vor und lösen abgestorbene Zellen — für echte Erneuerung.</p>
            </div>
            <div class="highlight-item scroll-anim">
                <div class="highlight-number">02</div>
                <h4>Anti-Akne</h4>
                <p>Reduziert Unreinheiten, verfeinert Poren und mildert Akne-Narben nachhaltig.</p>
            </div>
            <div class="highlight-item scroll-anim">
                <div class="highlight-number">03</div>
                <h4>Ebenmässiger Teint</h4>
                <p>Grauschleier und Hyperpigmentierung verschwinden. Ihr Hautbild wirkt klar und lebendig.</p>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-section pad-y container">
        <div class="sub-display margin-bottom-lg" style="text-align: center;">03 / Häufig gestellte Fragen</div>
        <div class="faq-list">
            <details class="faq-item scroll-anim">
                <summary><h3>Brennt ein Fruchtsäure Peeling?</h3></summary>
                <div class="faq-answer"><div class="faq-answer-inner">
                    <p>Ein kurzes, intensiveres Prickeln oder leichtes Brennen ist während des Peelings spürbar — das ist ein Zeichen der Wirksamkeit. Wir neutralisieren die Säure jedoch rasch fachgerecht, sodass die Haut sofort wieder beruhigt wird.</p>
                </div></div>
            </details>
            <details class="faq-item scroll-anim">
                <summary><h3>Pellt man sich extrem nach der Behandlung?</h3></summary>
                <div class="faq-answer"><div class="faq-answer-inner">
                    <p>Moderne, professionelle Fruchtsäure Peelings rufen keine massive, plakative Schuppung hervor. Sie haben meist lediglich eine feine, kleieförmige Schuppung, die im Zürcher Stadtalltag nicht störend auffällt.</p>
                </div></div>
            </details>
            <details class="faq-item scroll-anim">
                <summary><h3>Wie oft sollte man ein Fruchtsäure Peeling machen?</h3></summary>
                <div class="faq-answer"><div class="faq-answer-inner">
                    <p>Für ein optimal ebenmässiges Hautbild empfehlen wir eine Kur von 4 bis 6 Behandlungen im Abstand von 2 bis 4 Wochen. Danach reichen Erhaltungsbehandlungen alle 6 bis 8 Wochen aus, um das Ergebnis langfristig zu bewahren.</p>
                </div></div>
            </details>
            <details class="faq-item scroll-anim">
                <summary><h3>Kann man Fruchtsäure Peeling im Sommer machen?</h3></summary>
                <div class="faq-answer"><div class="faq-answer-inner">
                    <p>Grundsätzlich ja, allerdings ist konsequenter Sonnenschutz (SPF 50+) nach der Behandlung absolut notwendig, da die erneuerte Haut empfindlicher auf UV-Strahlung reagiert. Wir beraten Sie individuell und passen die Säurekonzentration saisonal an.</p>
                </div></div>
            </details>
        </div>
        <script type="application/ld+json" set:html={JSON.stringify(faqData)} />
    </section>

    <!-- Booking Widget -->
    <section class="container pad-y">
        <BookingWidget client:visible preselectedCategory="Peeling" />
    </section>

    <!-- More Treatments -->
    <section class="container" style="padding-bottom: 15vh;">
        <div class="more-treatments">
            <div class="sub-display margin-bottom-lg">Weitere Behandlungen</div>
            <div class="more-treatments-grid">
                <TreatmentLinkCard
                    href="/behandlungen/hydrafacial-zuerich/"
                    title="Hydra Facial"
                    description="Tiefenreinigung, Vitalisierung und Glow. Die ultimative Pflege für den perfekten Selfie-Look."
                />
                <TreatmentLinkCard
                    href="/behandlungen/microneedling-zuerich/"
                    title="Micro Needling"
                    description="Das natürliche Face-Lift ohne OP. Kollagenstimulation für ein verfeinertes Hautbild."
                />
            </div>
        </div>
    </section>
</Base>
