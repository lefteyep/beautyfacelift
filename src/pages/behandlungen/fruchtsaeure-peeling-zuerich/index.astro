---
import Base from '../../../layouts/Base.astro';
import BookingCta from '../../../components/BookingCta.astro';
import TreatmentHero from '../../../components/treatment/TreatmentHero.astro';
import TreatmentSplit from '../../../components/treatment/TreatmentSplit.astro';
import BenefitList from '../../../components/treatment/BenefitList.astro';
import PriceMenu from '../../../components/treatment/PriceMenu.astro';
import TreatmentSteps from '../../../components/treatment/TreatmentSteps.astro';
import RuledList from '../../../components/treatment/RuledList.astro';
import ReviewQuote from '../../../components/treatment/ReviewQuote.astro';
import FaqBlock from '../../../components/treatment/FaqBlock.astro';
import RelatedTreatments from '../../../components/treatment/RelatedTreatments.astro';
import { treatmentHeroPreload } from '../../../components/treatment/images';
import { peelingCard, spaFacialTreatment } from '../../../lib/site-images';
import peelingStill from '../../../assets/marketing/peeling_treatment_new.png';
import consultation from '../../../assets/lp/aquafacial/hautanalyse-beratung-zuerich.webp';
import { absoluteUrl, bookingLinkForService } from '../../../../shared/site';
import { beautySalonRef } from '../../../lib/schema';

const pagePath = '/behandlungen/fruchtsaeure-peeling-zuerich/';
const bookingHref = bookingLinkForService('Peeling');
const heroPreload = await treatmentHeroPreload(peelingCard);

const benefits = [
    { title: 'Sanfte Erneuerung', text: 'Kontrollierte Exfoliation entfernt oberflächliche Hornzellen und kann die Hauterneuerung unterstützen.' },
    { title: 'Freiere Poren', text: 'Kann Talg und Verhornungen in den Poren lösen – für ein feineres, reineres Hautbild.' },
    { title: 'Ebenmässiger Teint', text: 'Kann Grauschleier und Pigmentflecken mildern – der Teint wirkt klarer und frischer.' },
];

const priceItems = [
    { name: 'Fruchtsäure Peeling', duration: '45 Min.', price: 'CHF 150', note: 'Intensive Hauterneuerung mit AHA-Säuren für einen klaren Teint.' },
    { name: 'BDR Fruchtsäurebehandlung', duration: '60 Min.', price: 'CHF 150', note: 'Für kontrollierte Hauterneuerung, verfeinerte Poren und einen ebenmässigeren Teint.' },
];

const steps = [
    { title: 'Hautanalyse & Vorbereitung', text: 'Säureart und Konzentration werden bestimmt, die Haut gereinigt und entfettet.' },
    { title: 'Auftragen der Fruchtsäure', text: 'Glykol-, Milch- oder Mandelsäure – je nach Hautzustand und Behandlungsstufe.' },
    { title: 'Einwirkzeit & Neutralisation', text: 'In der Regel 3 bis 10 Minuten unter laufender Beobachtung, danach fachgerecht neutralisiert.' },
    { title: 'Beruhigung & Sonnenschutz', text: 'Eine kühlende Maske, Sonnenschutz mit SPF 50+ und Ihr persönlicher Nachpflegeplan.' },
];

const suitedFor = [
    'Akne und Unreinheiten',
    'Akne-Narben',
    'Hyperpigmentierung und Altersflecken',
    'Grauschleier und müde Haut',
    'Vergrösserte Poren',
    'Sonnenschäden und ungleichmässiger Teint',
];

const faqs = [
    {
        question: 'Brennt ein Fruchtsäure Peeling?',
        answer: 'Ein leichtes Brennen oder Kribbeln während der Behandlung ist normal. Wir arbeiten mit stufenweise aufbauenden Konzentrationen; nach der Einwirkzeit wird die Säure neutralisiert, und eine beruhigende Maske lindert Empfindungen in der Regel.',
    },
    {
        question: 'Pellt man sich extrem nach der Behandlung?',
        answer: 'Nein. In der Regel entsteht eine feine, kaum sichtbare Mikroschuppung, die etwa 2 bis 5 Tage nach der Behandlung einsetzt und sich mit einer reichhaltigen Feuchtigkeitscreme pflegen lässt.',
    },
    {
        question: 'Wie oft sollte man ein Fruchtsäure Peeling machen?',
        answer: 'Wir empfehlen eine Kur von 4 bis 6 Behandlungen im Abstand von 2 bis 4 Wochen, danach Erhaltungsbehandlungen alle 6 bis 8 Wochen. Teresa stimmt den Plan auf Ihre Ziele ab.',
    },
    {
        question: 'Kann man Fruchtsäure Peeling im Sommer machen?',
        answer: 'Ja, mit konsequentem Sonnenschutz SPF 50+. Im Sommer passen wir die Säurekonzentration an und wählen hautschonende Formulierungen wie Milch- oder Mandelsäure; intensive Sonnenbäder meiden Sie mindestens eine Woche.',
    },
    {
        question: 'Was kostet ein Fruchtsäure Peeling in Zürich?',
        answer: 'Die Gesichtsbehandlung Fruchtsäure kostet CHF 150 und dauert 45 Minuten, die BDR Fruchtsäurebehandlung kostet ebenfalls CHF 150 und dauert 60 Minuten – inklusive Hautanalyse, professioneller Nachpflege und Sonnenschutz-Empfehlung.',
    },
    {
        question: 'Fruchtsäure Peeling oder Microneedling – was wirkt besser gegen Akne?',
        answer: 'Das Peeling löst oberflächliche Verhornungen, befreit verstopfte Poren und kann das Hautbild klären. Microneedling eignet sich eher für die kosmetische Verbesserung von Narbenoptik und Hautstruktur. Teresa entscheidet nach Hautzustand, ob eine Behandlung oder eine Kombination sinnvoll ist.',
    },
    {
        question: 'Wie pflege ich meine Haut nach dem Peeling?',
        answer: 'In den ersten 48 Stunden milde, parfümfreie Reinigung und eine reichhaltige Feuchtigkeitscreme; Retinol, Vitamin C und weitere Säuren mindestens eine Woche meiden. Sonnenschutz mit SPF 50+ ist täglich Pflicht.',
    },
    {
        question: 'Gibt es Gegenanzeigen für ein Fruchtsäure Peeling?',
        answer: 'Ja: aktive Herpes-Infektionen, offene Wunden oder Entzündungen, Schwangerschaft und Stillzeit, Isotretinoin in den letzten 6 Monaten sowie frische Sonnenbrände. Bei sehr empfindlicher Haut oder Rosazea ist Vorsicht geboten – wir klären alles bei der Hautanalyse.',
    },
];

const structuredData = {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Fruchtsäure Peeling Zürich",
    "serviceType": "Fruchtsäure Peeling",
    "category": "Gesichtsbehandlung",
    "url": absoluteUrl(pagePath),
    "image": absoluteUrl('/assets/peeling_treatment_editorial.png'),
    "provider": beautySalonRef(),
    "description": "Professionelles Fruchtsäure Peeling (AHA-Peeling) in Zürich. Kosmetische Hautbildpflege bei Unreinheiten, Pigmentflecken und Grauschleier an der Bahnhofstrasse.",
    "areaServed": "Zürich"
};
---

<Base
    title="Fruchtsäurepeeling Zürich – CHF 150 | Beauty Face Lift"
    description="Fruchtsäure Peeling in Zürich für CHF 150: AHA-Peeling bei Unreinheiten, Pigmentflecken und Grauschleier, an der Bahnhofstrasse. Jetzt Termin buchen."
    preloadImage={heroPreload}
    structuredData={structuredData}
>
    <TreatmentHero
        treatment="Fruchtsäure Peeling"
        breadcrumb="Fruchtsäure Peeling Zürich"
        lead="Fruchtsäure Peeling in Zürich: Ein professionelles AHA-Peeling löst abgestorbene Hornzellen und kann ein klareres, ebenmässiger wirkendes Hautbild unterstützen."
        bookingHref={bookingHref}
        image={peelingCard}
        alt="Fruchtsäure Peeling bei Beauty Face Lift an der Bahnhofstrasse Zürich"
        price="CHF 150"
        duration="45–60 Minuten"
    >Fruchtsäure Peeling <em>Zürich</em></TreatmentHero>

    <!-- What it is & benefits -->
    <section class="section section--flush-top" aria-labelledby="intro-title">
        <div class="container">
            <TreatmentSplit image={peelingStill} alt="Zitronenscheiben und eine Schale mit Peeling-Lösung auf hellem Marmor">
                <h2 id="intro-title">Für einen klaren, ebenmässigen Teint</h2>
                <p class="lead">Säureart und Einwirkzeit werden individuell an Hautzustand und Verträglichkeit angepasst.</p>
                <BenefitList items={benefits} />
            </TreatmentSplit>
        </div>
    </section>

    <!-- Prices -->
    <section class="section section--shell" id="preise" aria-label="Preise und Dauer">
        <div class="container">
            <PriceMenu items={priceItems} note="Inklusive Hautanalyse, professioneller Nachpflege und Sonnenschutz. Kur-Rabatt bei 4+ Behandlungen auf Anfrage.">
                <Fragment slot="title">Fruchtsäure Peeling Preise</Fragment>
                <a slot="actions" href={bookingHref} class="btn btn-arrow" data-treatment="Fruchtsäure Peeling" data-button-location="treatment_prices">Termin buchen</a>
            </PriceMenu>
        </div>
    </section>

    <!-- Process -->
    <section class="section" aria-labelledby="process-title">
        <div class="container">
            <div class="section-head">
                <div>
                    <h2 id="process-title">Ablauf in vier Schritten</h2>
                    <p class="lead">Die Konzentration wird über den Behandlungsverlauf schrittweise gesteigert.</p>
                </div>
            </div>
            <TreatmentSteps steps={steps} />
        </div>
    </section>

    <!-- Suitability -->
    <section class="section section--flush-top" aria-labelledby="suitability-title">
        <div class="container">
            <TreatmentSplit image={spaFacialTreatment} alt="Kundin erhält eine Gesichtsbehandlung bei Beauty Face Lift Zürich" reverse>
                <h2 id="suitability-title">Für wen eignet sich ein Fruchtsäure Peeling?</h2>
                <p class="lead">Häufig besprechen wir das Peeling bei diesen Hautanliegen – die Eignung klärt Teresa bei der Hautanalyse.</p>
                <RuledList items={suitedFor} />
                <p class="split-note">Nicht bei aktivem Herpes, offenen Wunden oder Entzündungen, in Schwangerschaft und Stillzeit, nach Isotretinoin in den letzten 6 Monaten oder bei frischem Sonnenbrand.</p>
            </TreatmentSplit>
        </div>
    </section>

    <!-- Review -->
    <section class="section section--shell" aria-label="Kundenstimme">
        <div class="container">
            <ReviewQuote quote="Eine professionelle Behandlung, die wunderbar ist, tiefgehend wirkt und gleichzeitig entspannt." author="Pascale" detail="Gesichtsbehandlung Kundin" stars />
        </div>
    </section>

    <!-- FAQ -->
    <section class="section" aria-label="Häufige Fragen">
        <div class="container">
            <FaqBlock items={faqs}>
                <Fragment slot="title">Fragen zum Peeling</Fragment>
            </FaqBlock>
        </div>
    </section>

    <!-- Booking -->
    <section class="section section--flush-top" id="buchen">
        <div class="container">
            <BookingCta treatment="Fruchtsäure Peeling" href={bookingHref} image={consultation} alt="Teresa Stimac bespricht mit einer Kundin die Hautanalyse" />
        </div>
    </section>

    <RelatedTreatments current={pagePath} />
</Base>
