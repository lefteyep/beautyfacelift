---
import Base from '../../../layouts/Base.astro';
import TreatmentLinkCard from '../../../components/TreatmentLinkCard.astro';
import BookingCta from '../../../components/BookingCta.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import TreatmentActionBar from '../../../components/TreatmentActionBar.astro';
import AiSummary from '../../../components/AiSummary.astro';
import { Image, getImage } from 'astro:assets';
import { peelingCard, peelingTreatment, spaFacialTreatment, spaInterior } from '../../../lib/site-images';
import { absoluteUrl, bookingLinkForService } from '../../../../shared/site';

const treatmentHeroSizes = '100vw';
const treatmentContentSizes = '(min-width: 1240px) 540px, (min-width: 901px) 42vw, 100vw';
const bookingHref = bookingLinkForService('Peeling');
const peelingHeroPreload = await getImage({
    src: peelingCard,
    widths: [768, 1024, 1440, 1536],
    sizes: treatmentHeroSizes,
    format: 'webp',
    quality: 'high',
});

const summaryFacts = [
    { label: 'Dauer', value: '45 bis 60 Minuten' },
    { label: 'Preis', value: 'CHF 150' },
    { label: 'Downtime', value: 'mögliche feine Schuppung für 2 bis 5 Tage' },
    { label: 'Nachpflege', value: 'milde Pflege und konsequenter Sonnenschutz' },
];

const structuredData = {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Fruchtsäure Peeling Zürich",
    "serviceType": "Fruchtsäure Peeling",
    "category": "Gesichtsbehandlung",
    "url": absoluteUrl('/behandlungen/fruchtsaeure-peeling-zuerich/'),
    "image": absoluteUrl('/assets/peeling_treatment_editorial.png'),
    "provider": {
        "@type": "BeautySalon",
        "name": "Beauty Face Lift Zürich",
        "url": absoluteUrl('/'),
        "address": {
            "@type": "PostalAddress",
            "streetAddress": "Bahnhofstrasse 94",
            "addressLocality": "Zürich",
            "postalCode": "8001",
            "addressCountry": "CH"
        }
    },
    "description": "Professionelles Fruchtsäure Peeling (AHA-Peeling) in Zürich. Kosmetische Hautbildpflege bei Unreinheiten, Pigmentflecken und Grauschleier an der Bahnhofstrasse.",
    "areaServed": "Zürich"
};

const faqData = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{
        "@type": "Question",
        "name": "Brennt ein Fruchtsäure Peeling?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ein leichtes Brennen oder Kribbeln während der Behandlung ist vollkommen normal und sogar ein gewünschtes Zeichen der Wirksamkeit. Die Intensität hängt von der gewählten Säurekonzentration und Ihrem individuellen Hauttyp ab. Bei Beauty Face Lift arbeiten wir mit stufenweise aufbauenden Konzentrationen, sodass Ihre Haut sich schrittweise an die Behandlung gewöhnt. Die Säure wird nach der exakten Einwirkzeit fachgerecht neutralisiert, und eine beruhigende Maske lindert Empfindungen in der Regel."
        }
    }, {
        "@type": "Question",
        "name": "Pellt man sich extrem nach der Behandlung?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nein, moderne professionelle Fruchtsäure Peelings verursachen keine massive oder entstellende Schuppung. Sie erleben in der Regel eine feine, kaum sichtbare Mikroschuppung, die etwa 2 bis 5 Tage nach der Behandlung einsetzt und sich einfach mit einer reichhaltigen Feuchtigkeitscreme pflegen lässt. Im Zürcher Alltag fällt diese Erneuerungsphase niemandem auf. Die Intensität wird individuell auf Ihre Haut abgestimmt und bleibt kontrolliert."
        }
    }, {
        "@type": "Question",
        "name": "Wie oft sollte man ein Fruchtsäure Peeling machen?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Für ein möglichst ebenmässiges und klares Hautbild empfehlen wir eine Kur von 4 bis 6 Behandlungen im Abstand von 2 bis 4 Wochen. Diese regelmässigen Intervalle ermöglichen es, die Säurekonzentration schrittweise zu steigern und tiefere Hautschichten zu erreichen. Nach Abschluss der Kur genügen Erhaltungsbehandlungen alle 6 bis 8 Wochen, um das Ergebnis langfristig zu bewahren. Teresa berät Sie bei Beauty Face Lift individuell zum passenden Behandlungsplan."
        }
    }, {
        "@type": "Question",
        "name": "Kann man Fruchtsäure Peeling im Sommer machen?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Grundsätzlich ja, allerdings ist konsequenter Sonnenschutz mit SPF 50+ nach der Behandlung absolut unverzichtbar, da die erneuerte Haut empfindlicher auf UV-Strahlung reagiert. In den Sommermonaten passen wir bei Beauty Face Lift die Säurekonzentration entsprechend an und wählen besonders hautschonende Formulierungen. Wir empfehlen zudem, intensive Sonnenbäder für mindestens eine Woche nach der Behandlung zu vermeiden und stets einen breitbandigen Sonnenschutz aufzutragen."
        }
    }, {
        "@type": "Question",
        "name": "Was kostet ein Fruchtsäure Peeling in Zürich?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bei Beauty Face Lift an der Bahnhofstrasse Zürich kostet die Gesichtsbehandlung Fruchtsäure aktuell CHF 150 und dauert 45 Minuten. Die BDR Fruchtsäurebehandlung kostet ebenfalls CHF 150 und dauert 60 Minuten. Der Preis versteht sich inklusive persönlicher Hautanalyse, professioneller Nachpflege und Sonnenschutz-Empfehlung."
        }
    }, {
        "@type": "Question",
        "name": "Fruchtsäure Peeling oder Microneedling — was wirkt besser gegen Akne?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Beide Behandlungen können bei unreiner Haut oder unebenem Hautbild sinnvoll sein, setzen jedoch an unterschiedlichen Stellen an. Das Fruchtsäure Peeling löst oberflächliche Verhornungen, befreit verstopfte Poren und kann das Hautbild klären. Microneedling kann die natürliche Hauterneuerung und Kollagenbildung unterstützen und eignet sich eher für die kosmetische Verbesserung von Narbenoptik und Hautstruktur. Teresa entscheidet nach Hautzustand, ob eine einzelne Behandlung oder eine abgestimmte Kombination sinnvoll ist."
        }
    }, {
        "@type": "Question",
        "name": "Wie pflege ich meine Haut nach dem Peeling?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Die richtige Nachpflege ist entscheidend für das Ergebnis Ihres Fruchtsäure Peelings. In den ersten 48 Stunden nach der Behandlung verwenden Sie ausschliesslich milde, parfümfreie Reinigungsmittel und eine reichhaltige Feuchtigkeitscreme. Verzichten Sie auf aktive Wirkstoffe wie Retinol, Vitamin C oder weitere Säuren für mindestens eine Woche. Sonnenschutz mit SPF 50+ ist täglich Pflicht, auch bei bewölktem Himmel. Wir stellen Ihnen bei Beauty Face Lift einen individuellen Nachpflegeplan zusammen."
        }
    }, {
        "@type": "Question",
        "name": "Gibt es Gegenanzeigen für ein Fruchtsäure Peeling?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja, bestimmte Gegenanzeigen schliessen ein Fruchtsäure Peeling vorübergehend oder dauerhaft aus. Dazu zählen aktive Herpes-simplex-Infektionen, offene Wunden oder Entzündungen im Behandlungsareal, eine Schwangerschaft oder Stillzeit, die Einnahme von Isotretinoin (Accutane) in den letzten 6 Monaten sowie frische Sonnenbrände. Auch bei sehr empfindlicher Haut oder Rosazea ist Vorsicht geboten. Bei der Hautanalyse vor jeder Behandlung bei Beauty Face Lift klären wir alle individuellen Gegenanzeigen sorgfältig ab."
        }
    }]
};
---

<Base
    title="Fruchtsäurepeeling Zürich | Beauty Face Lift Zürich"
    description="Professionelles Fruchtsäure Peeling in Zürich für CHF 150. AHA-Peeling gegen Akne, Hyperpigmentierung und Grauschleier. Premium Kosmetikinstitut an der Bahnhofstrasse."
    preloadImage={{
        href: peelingHeroPreload.src,
        imagesrcset: peelingHeroPreload.srcSet.attribute,
        imagesizes: treatmentHeroSizes,
        type: 'image/webp',
        fetchpriority: 'high',
    }}
    navVariant="treatment"
    bodyClass="treatment-page"
    structuredData={structuredData}
>
    <!-- Editorial Hero with Background Image -->
    <header class="treatment-hero">
        <div class="treatment-hero-media">
            <Image
                src={peelingCard}
                widths={[768, 1024, 1440, 1536]}
                sizes={treatmentHeroSizes}
                format="webp"
                quality="high"
                priority
                alt="Fruchtsäure Peeling im Premium Kosmetikinstitut Beauty Face Lift Zürich"
                id="treatment-hero-img"
            />
        </div>
        <div class="hero-titles">
            <div class="sub-display text-reveal-wrapper margin-bottom-sm">
                <span class="text-reveal" style="color: rgba(237, 235, 230, 0.7);">Hauterneuerung • Zürich</span>
            </div>
            <h1 class="sr-only">Fruchtsäure Peeling Zürich — Professionelles AHA-Peeling an der Bahnhofstrasse</h1>
            <div class="title-line text-reveal-wrapper" aria-hidden="true">
                <span class="display-text text-reveal" style="color: var(--text-inverse); font-size: clamp(3.5rem, 8vw, 8rem);">Fruchtsäure</span>
            </div>
            <div class="title-line title-right text-reveal-wrapper" aria-hidden="true">
                <span class="display-text text-reveal" style="color: var(--gold); font-weight: 300; font-size: clamp(3.5rem, 8vw, 8rem);">Peeling</span>
            </div>
        </div>
    </header>

    <div class="container treatment-breadcrumbs">
        <Breadcrumbs items={[
            { label: "Home", href: "/" },
            { label: "Behandlungen", href: "/behandlungen/" },
            { label: "Fruchtsäure Peeling Zürich" }
        ]} />
    </div>

    <TreatmentActionBar treatment="Fruchtsäure Peeling" href={bookingHref} />

    <AiSummary
        title="Fruchtsäure Peeling Zürich"
        intro="Ein Fruchtsäure Peeling ist ein professionelles AHA-Peeling, das abgestorbene Hornzellen löst und ein klareres, ebenmässiger wirkendes Hautbild unterstützen kann. Die Säureart und Einwirkzeit werden bei Beauty Face Lift individuell an Hautzustand und Verträglichkeit angepasst."
        facts={summaryFacts}
    />

    <!-- Die Methode — Content Split -->
    <section class="about-editorial pad-y">
        <div class="split-layout align-center">
            <div class="about-text scroll-anim">
                <span class="sub-display">Die Methode</span>
                <h2 style="font-size: clamp(2rem, 3.5vw, 3.5rem); text-transform: none; margin-bottom: 2rem;">"Tiefenreinigung.<br>Kompromisslos klar."</h2>
                <p class="margin-bottom-md">Ein Fruchtsäure Peeling (auch AHA-Peeling oder Chemical Peel genannt) ist eine professionelle kosmetische Behandlung, bei der Alpha-Hydroxysäuren wie Glykolsäure, Milchsäure oder Mandelsäure in kontrollierter Konzentration auf die Haut aufgetragen werden. Bei Beauty Face Lift an der Bahnhofstrasse Zürich arbeitet Teresa mit professionellen, sorgfältig dosierten Peelings. Sie lösen oberflächliche Verhornungen, können die kosmetische Hauterneuerung unterstützen und das Hautbild glatter, ebenmässiger und klarer wirken lassen.</p>
                <p class="margin-bottom-md">Anders als oberflächliche Peelings aus der Drogerie arbeiten wir mit professionellen Säurekonzentrationen von bis zu 70 %, die ausschliesslich von geschulten Kosmetikerinnen angewendet werden dürfen. Die Behandlung wird individuell auf Ihren Hautzustand, Ihren Hauttyp und Ihre spezifischen Anliegen abgestimmt — ob Akne, Hyperpigmentierung, Sonnenschäden oder die ersten Zeichen der Hautalterung. In unserem Premium Kosmetikinstitut mitten in Zürich erleben Sie das Gefühl von völlig freier, atmender Haut in einem Ambiente, das höchsten Ansprüchen gerecht wird.</p>
                <a href={bookingHref} class="pill-btn pill-btn-outline">Termin vereinbaren</a>
            </div>
            <div class="about-image scroll-anim">
                <div class="service-image-mask" style="padding-bottom: 120%;">
                    <Image
                        src={spaInterior}
                        widths={[360, 540, 720, 960]}
                        sizes={treatmentContentSizes}
                        format="webp"
                        quality="mid"
                        alt="Fruchtsäure Peeling Behandlungsraum Beauty Face Lift Zürich Bahnhofstrasse"
                        class="anim-img"
                        loading="lazy"
                    />
                </div>
            </div>
        </div>
    </section>

    <!-- Vorteile — Highlights Grid -->
    <section class="container" style="padding-bottom: 15vh;">
        <div class="sub-display margin-bottom-lg" style="text-align: center;">Vorteile</div>
        <div class="highlights-grid">
            <div class="highlight-item scroll-anim">
                <div class="highlight-number">01</div>
                <h4>Tiefenwirkung</h4>
                <p>Alpha-Hydroxysäuren wie Glykolsäure dringen tief in die Epidermis vor und lösen die Bindungen zwischen abgestorbenen Hornzellen. Diese kontrollierte Exfoliation entfernt oberflächliche Hornzellen und kann die kosmetische Hauterneuerung unterstützen — für ein glatter und klarer wirkendes Hautbild.</p>
            </div>
            <div class="highlight-item scroll-anim">
                <div class="highlight-number">02</div>
                <h4>Anti-Akne & Porenverfeinerung</h4>
                <p>Verstopfte Poren sind die Hauptursache für Unreinheiten und Akne. Das Fruchtsäure Peeling befreit die Porenkanäle von Talg und Verhornungen, reduziert Entzündungen und mildert bestehende Akne-Narben sichtbar. Mit jeder Behandlung wird das Hautbild feiner und reiner.</p>
            </div>
            <div class="highlight-item scroll-anim">
                <div class="highlight-number">03</div>
                <h4>Ebenmässiger Teint</h4>
                <p>Grauschleier, Sonnenschäden und Hyperpigmentierungen entstehen durch ungleichmässige Melaninverteilung in der oberen Hautschicht. Das AHA-Peeling entfernt diese pigmentreichen Zellschichten kontrolliert und fördert die Bildung gleichmässig gefärbter, neuer Haut. Ihr Teint wirkt klar, frisch und lebendig.</p>
            </div>
            <div class="highlight-item scroll-anim">
                <div class="highlight-number">04</div>
                <h4>Anti-Aging Wirkung</h4>
                <p>Regelmässige Fruchtsäure Peelings regen die Kollagen- und Elastinsynthese in der Dermis an. Feine Linien und Fältchen werden sichtbar gemindert, die Hautstruktur wird dichter und elastischer. Das Ergebnis ist ein jugendlicheres, strafferes Erscheinungsbild — ganz ohne invasive Eingriffe.</p>
            </div>
        </div>
    </section>

    <!-- Ablauf der Behandlung -->
    <section class="about-editorial pad-y">
        <div class="split-layout align-center">
            <div class="about-image scroll-anim" style="order: -1;">
                <div class="service-image-mask" style="padding-bottom: 120%;">
                    <Image
                        src={peelingTreatment}
                        widths={[360, 540, 720, 960]}
                        sizes={treatmentContentSizes}
                        format="webp"
                        quality="high"
                        alt="Professionelles Fruchtsäure Peeling Behandlung Ablauf Zürich"
                        class="anim-img"
                        loading="lazy"
                    />
                </div>
            </div>
            <div class="about-text scroll-anim">
                <span class="sub-display">Ablauf der Behandlung</span>
                <h2 style="font-size: clamp(2rem, 3.5vw, 3.5rem); text-transform: none; margin-bottom: 2rem;">Vier Schritte zu<br>erneuerter Haut</h2>
                <div class="margin-bottom-md">
                    <p style="margin-bottom: 1.5rem;"><strong style="color: var(--accent);">Schritt 1 — Hautanalyse & Vorbereitung</strong><br>Jede Behandlung beginnt mit einer gründlichen Hautanalyse. Wir beurteilen Ihren aktuellen Hautzustand, besprechen Ihre Anliegen und Ziele und bestimmen die passende Säureart und Konzentration. Anschliessend wird die Haut sorgfältig gereinigt und entfettet, um eine gleichmässige Aufnahme der Säure zu gewährleisten.</p>
                    <p style="margin-bottom: 1.5rem;"><strong style="color: var(--accent);">Schritt 2 — Auftragen der Fruchtsäure</strong><br>Die individuell abgestimmte Säurelösung wird gleichmässig auf die Haut aufgetragen. Je nach Behandlungsstufe verwenden wir Glykolsäure für intensive Exfoliation, Milchsäure für empfindliche Haut oder Mandelsäure für eine besonders sanfte Exfoliation. Die Konzentration wird über den Behandlungsverlauf hinweg schrittweise gesteigert.</p>
                    <p style="margin-bottom: 1.5rem;"><strong style="color: var(--accent);">Schritt 3 — Einwirkzeit & Neutralisation</strong><br>Die Säure wirkt für eine präzise festgelegte Dauer auf der Haut ein — in der Regel 3 bis 10 Minuten, abhängig von Konzentration und Hautzustand. Während dieser Phase überwachen wir die Hautreaktion kontinuierlich. Anschliessend wird die Säure mit einer alkalischen Lösung fachgerecht neutralisiert, um den Peeling-Prozess sofort zu stoppen.</p>
                    <p><strong style="color: var(--accent);">Schritt 4 — Beruhigung & Sonnenschutz</strong><br>Zum Abschluss tragen wir eine kühlende, beruhigende Maske auf, die Rötungen lindert und die Hautbarriere sofort stärkt. Ein professioneller Sonnenschutz mit SPF 50+ schützt die frisch erneuerte Haut vor UV-Strahlung. Sie erhalten zudem einen persönlichen Nachpflegeplan für die kommenden Tage.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Preise -->
    <section class="container" style="padding-bottom: 10vh;">
        <div class="sub-display margin-bottom-lg" style="text-align: center;">Preise</div>
        <div class="pricing-grid pricing-grid-two">
            <div class="pricing-card pricing-card-accent scroll-anim">
                <div class="pricing-label">Fruchtsäure Peeling</div>
                <h4>Gesichtsbehandlung - Fruchtsäure</h4>
                <div class="pricing-price">CHF 150</div>
                <div class="pricing-duration">45 Minuten</div>
                <p>Intensive Hauterneuerung mit AHA-Säuren für einen klaren Teint. Die Säurekonzentration und Nachpflege werden individuell auf Ihre Haut abgestimmt.</p>
            </div>
            <div class="pricing-card scroll-anim">
                <div class="pricing-label">BDR Fruchtsäurebehandlung</div>
                <h4>BDR Treatment</h4>
                <div class="pricing-price">CHF 150</div>
                <div class="pricing-duration">60 Minuten</div>
                <p>BDR Fruchtsäurebehandlung für kontrollierte Hauterneuerung, verfeinerte Poren und einen ebenmässigeren Teint.</p>
            </div>
        </div>
        <p style="text-align: center; margin-top: 2rem; opacity: 0.7; font-size: 0.9rem;">Alle Preise inklusive Hautanalyse, professioneller Nachpflege und Sonnenschutz. Kur-Rabatt bei 4+ Behandlungen auf Anfrage.</p>
    </section>

    <!-- Wer profitiert -->
    <section class="about-editorial pad-y">
        <div class="split-layout align-center">
            <div class="about-text scroll-anim">
                <span class="sub-display">Für wen ist das Peeling geeignet?</span>
                <h2 style="font-size: clamp(2rem, 3.5vw, 3.5rem); text-transform: none; margin-bottom: 2rem;">Wer profitiert von<br>einem Fruchtsäure Peeling?</h2>
                <p class="margin-bottom-md">Das Fruchtsäure Peeling ist eine der vielseitigsten Behandlungen in der professionellen Kosmetik und eignet sich für zahlreiche Hautanliegen. Häufig besprechen wir das Peeling bei folgenden Hautanliegen:</p>
                <ul style="list-style: none; padding: 0; margin-bottom: 2rem;">
                    <li style="padding: 0.75rem 0; border-bottom: 1px solid rgba(0,0,0,0.08);"><strong>Akne & Unreinheiten</strong> — Verstopfte Poren werden befreit, entzündliche Läsionen reduziert und die Talgproduktion reguliert.</li>
                    <li style="padding: 0.75rem 0; border-bottom: 1px solid rgba(0,0,0,0.08);"><strong>Akne-Narben</strong> — Eingesunkene und verfärbte Narben werden durch wiederholte Peelings nach und nach gemildert.</li>
                    <li style="padding: 0.75rem 0; border-bottom: 1px solid rgba(0,0,0,0.08);"><strong>Hyperpigmentierung & Altersflecken</strong> — Übermässige Melanineinlagerungen werden Schicht für Schicht abgetragen und ausgeglichen.</li>
                    <li style="padding: 0.75rem 0; border-bottom: 1px solid rgba(0,0,0,0.08);"><strong>Grauschleier & müde Haut</strong> — Die Entfernung abgestorbener Hautzellen bringt die natürliche Leuchtkraft der Haut zurück.</li>
                    <li style="padding: 0.75rem 0; border-bottom: 1px solid rgba(0,0,0,0.08);"><strong>Vergrösserte Poren</strong> — Regelmässige AHA-Peelings verfeinern die Porenstruktur sichtbar, je nach Hautzustand.</li>
                    <li style="padding: 0.75rem 0; border-bottom: 1px solid rgba(0,0,0,0.08);"><strong>Sonnenschäden</strong> — UV-bedingte Hautunebenheiten und vorzeitige Alterungszeichen werden kosmetisch begleitet.</li>
                    <li style="padding: 0.75rem 0;"><strong>Ungleichmässiger Teint</strong> — Für ein harmonisches, ebenmässiges Hautbild ohne Flecken und Verfärbungen.</li>
                </ul>
                <p class="margin-bottom-md">Bei Beauty Face Lift an der Zürcher Bahnhofstrasse führen wir vor jeder Behandlung eine ausführliche Hautanalyse durch, um Säureart, Konzentration und Behandlungsdauer individuell für Sie zu bestimmen. So bleibt die Behandlung nachvollziehbar, hautgerecht und auf realistische Ziele abgestimmt.</p>
            </div>
            <div class="about-image scroll-anim">
                <div class="service-image-mask" style="padding-bottom: 120%;">
                    <Image
                        src={spaFacialTreatment}
                        widths={[360, 540, 720, 960]}
                        sizes={treatmentContentSizes}
                        format="webp"
                        quality="mid"
                        alt="Kundin erhält Fruchtsäure Peeling Behandlung bei Beauty Face Lift Zürich"
                        class="anim-img"
                        loading="lazy"
                    />
                </div>
            </div>
        </div>
    </section>

    <!-- Kombination mit anderen Behandlungen -->
    <section class="container" style="padding-bottom: 10vh;">
        <div class="sub-display margin-bottom-lg" style="text-align: center;">Sinnvolle Kombinationen</div>
        <div class="split-layout align-center" style="gap: 4rem;">
            <div class="scroll-anim" style="flex: 1;">
                <h2 style="font-size: clamp(2rem, 3.5vw, 3.5rem); text-transform: none; margin-bottom: 2rem;">Kombinationsbehandlungen<br>für abgestimmte Ergebnisse</h2>
                <p class="margin-bottom-md">Ein Fruchtsäure Peeling kann besonders sinnvoll sein, wenn es passend mit komplementären Behandlungen kombiniert wird. Bei Beauty Face Lift erstellen wir individuelle Behandlungspläne, die mehrere Methoden gezielt aufeinander abstimmen.</p>
                <div style="margin-bottom: 2rem;">
                    <h4 style="margin-bottom: 0.5rem;"><a href="/behandlungen/aquafacial-zuerich/" style="color: var(--accent); text-decoration: none;">Fruchtsäure Peeling + Aquafacial</a></h4>
                    <p>Eine sinnvolle Kombination für einen frischen Glow. Das Fruchtsäure Peeling bereitet die Haut sorgfältig vor, indem es abgestorbene Zellschichten entfernt. Das anschliessende Aquafacial versorgt die gereinigte Haut mit professionellen Seren. Das Ergebnis kann eine hydratisierte, strahlender wirkende Haut mit gezielter Wirkstoffpflege sein.</p>
                </div>
                <div style="margin-bottom: 2rem;">
                    <h4 style="margin-bottom: 0.5rem;"><a href="/behandlungen/microneedling-zuerich/" style="color: var(--accent); text-decoration: none;">Fruchtsäure Peeling + Microneedling</a></h4>
                    <p>Eine mögliche Kombination bei Akne-Narben und unebenmässiger Haut. Während das Peeling an der Oberfläche arbeitet und Pigmentflecken optisch mildern kann, unterstützt Microneedling die kosmetische Verbesserung von Hautstruktur und Narbenoptik. Gemeinsam können diese Methoden ein insgesamt gepflegteres Hautbild fördern.</p>
                </div>
                <div style="margin-bottom: 2rem;">
                    <h4 style="margin-bottom: 0.5rem;"><a href="/behandlungen/coldplasma-zuerich/" style="color: var(--accent); text-decoration: none;">Fruchtsäure Peeling + ColdPlasma</a></h4>
