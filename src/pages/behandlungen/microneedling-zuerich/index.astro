---
import Base from '../../../layouts/Base.astro';
import BookingCta from '../../../components/BookingCta.astro';
import TreatmentHero from '../../../components/treatment/TreatmentHero.astro';
import TreatmentSplit from '../../../components/treatment/TreatmentSplit.astro';
import BenefitList from '../../../components/treatment/BenefitList.astro';
import PriceMenu from '../../../components/treatment/PriceMenu.astro';
import TreatmentSteps from '../../../components/treatment/TreatmentSteps.astro';
import RuledList from '../../../components/treatment/RuledList.astro';
import ReviewQuote from '../../../components/treatment/ReviewQuote.astro';
import FaqBlock from '../../../components/treatment/FaqBlock.astro';
import RelatedTreatments from '../../../components/treatment/RelatedTreatments.astro';
import { treatmentHeroPreload } from '../../../components/treatment/images';
import { consultationTrust, microneedlingCard } from '../../../lib/site-images';
import microneedlingStill from '../../../assets/marketing/microneedling_treatment.png';
import consultation from '../../../assets/lp/aquafacial/hautanalyse-beratung-zuerich.webp';
import { absoluteUrl, bookingLinkForService } from '../../../../shared/site';
import { beautySalonRef } from '../../../lib/schema';

const pagePath = '/behandlungen/microneedling-zuerich/';
const bookingHref = bookingLinkForService('Microneedling');
const heroPreload = await treatmentHeroPreload(microneedlingCard);

const benefits = [
    { title: 'Kollagen-Boost', text: 'Kann die natürliche Kollagen- und Elastinbildung unterstützen – Veränderungen bauen sich über Wochen auf.' },
    { title: 'Narben & Poren verfeinern', text: 'Akne-Narben und vergrösserte Poren können sich nach einer Serie sichtbar verbessern.' },
    { title: 'Ohne Operation', text: 'Minimal-invasiv, mit kurzer Regenerationszeit von 24 bis 48 Stunden.' },
];

const priceItems = [
    { name: 'Microneedling', duration: '90 Min.', price: 'CHF 210', note: 'Bei feinen Linien, vergrösserten Poren, Narben und unebenmässiger Hautstruktur.' },
    { name: 'Anti Aging mit coldPLASMA', duration: '90 Min.', price: 'CHF 220', note: 'Microneedling kombiniert mit coldPLASMA für ein beruhigtes Finish.' },
    { name: 'Carbon Laser + Microneedling', duration: '90 Min.', price: 'CHF 250', note: 'Carbon Laser Peeling und Microneedling in einer Sitzung.' },
];

const steps = [
    { title: 'Hautanalyse & Reinigung', text: 'Teresa prüft Ihren Hautzustand, bespricht Ihre Ziele und reinigt die Haut gründlich.' },
    { title: 'Betäubungscreme (optional)', text: 'Auf Wunsch reduziert eine Betäubungscreme nach circa 20 Minuten Einwirkzeit das Schmerzempfinden.' },
    { title: 'Microneedling', text: 'Nadeltiefe (0,5 bis 2,5 mm) und Geschwindigkeit werden je Zone angepasst, Wirkstoffe wie Hyaluronsäure eingearbeitet.' },
    { title: 'Beruhigung & Nachpflege', text: 'Eine beruhigende Maske, Hyaluronsäure-Serum und Sonnenschutz – dazu Ihr persönlicher Nachpflegeplan.' },
];

const suitedFor = [
    'Feine Linien und Elastizitätsverlust',
    'Akne-Narben und Pickelmale',
    'Vergrösserte Poren',
    'Hyperpigmentierung',
];

const faqs = [
    {
        question: 'Tut Microneedling weh?',
        answer: 'Die meisten Kundinnen beschreiben ein leichtes Kribbeln oder Piksen. Auf Wunsch reduziert eine betäubende Creme das Schmerzempfinden deutlich, und Teresa passt die Nadeltiefe an Ihre Schmerztoleranz und Ihren Hautzustand an.',
    },
    {
        question: 'Gibt es eine Ausfallzeit nach dem Microneedling?',
        answer: 'Eine Rötung wie bei einem leichten Sonnenbrand ist normal und klingt in der Regel innert 24 bis 48 Stunden ab. Meiden Sie in dieser Zeit direkte Sonne, intensiven Sport, Sauna sowie Pflege mit Retinol oder Säuren; Make-up frühestens nach 12 Stunden.',
    },
    {
        question: 'Wie viele Sitzungen braucht man für sichtbare Ergebnisse?',
        answer: 'Für Anti-Aging-Ziele, eine feinere Narbenoptik oder Hyperpigmentierung empfehlen wir häufig 3 bis 5 Sitzungen im Abstand von 4 bis 6 Wochen. Danach können Erhaltungsbehandlungen alle 2 bis 3 Monate sinnvoll sein.',
    },
    {
        question: 'Kann man Microneedling mit anderen Behandlungen kombinieren?',
        answer: 'Ja. Ein vorbereitendes Aquafacial reinigt die Poren, ColdPlasma kann im Nachgang je nach Hautzustand beruhigend ergänzen, und ein leichtes Fruchtsäure Peeling einige Tage vorher kann sinnvoll sein. Teresa berät Sie individuell.',
    },
    {
        question: 'Microneedling oder Aquafacial – was ist besser?',
        answer: 'Aquafacial ist eine sanfte Tiefenreinigung mit Glow-Effekt, meist ohne Ausfallzeit. Microneedling kann die natürliche Hauterneuerung und Kollagenbildung unterstützen und passt eher zu Hautstruktur, Poren, feinen Linien oder Narbenoptik.',
    },
    {
        question: 'Was kostet Microneedling in Zürich?',
        answer: 'Microneedling kostet CHF 210, Microneedling Anti Aging mit coldPLASMA CHF 220 und Carbon Laser Peeling + Microneedling CHF 250 – jeweils 90 Minuten, inklusive Hautanalyse, Reinigung, Nachpflege und individueller Beratung.',
    },
    {
        question: 'Wie pflege ich meine Haut nach dem Microneedling?',
        answer: 'In den ersten 24 Stunden nur sanfte, parfümfreie Pflege; Retinol, AHA/BHA-Säuren, hochdosiertes Vitamin C und alkoholhaltige Produkte mindestens 48 bis 72 Stunden meiden. Täglich Sonnenschutz mit mindestens LSF 50 – Teresa gibt Ihnen einen individuellen Nachpflegeplan mit.',
    },
    {
        question: 'Ab welchem Alter ist Microneedling sinnvoll?',
        answer: 'Grundsätzlich ab dem 18. Lebensjahr. Ab Mitte 20 stehen oft Akne-Narben, Poren oder ein unregelmässiges Hautbild im Vordergrund, ab Mitte 30 die präventive Anti-Aging-Pflege. Teresa berät Sie individuell.',
    },
];

const structuredData = {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Microneedling Behandlung Zürich",
    "serviceType": "Microneedling",
    "category": "Gesichtsbehandlung",
    "url": absoluteUrl(pagePath),
    "image": absoluteUrl('/assets/microneedling_treatment_editorial.png'),
    "provider": beautySalonRef(),
    "description": "Microneedling in Zürich an der Bahnhofstrasse: Feine Nadeln setzen kontrollierte Mikrokanäle und können Hauterneuerung und Kollagenbildung unterstützen – bei feinen Linien, Narbenoptik und vergrösserten Poren.",
    "areaServed": "Zürich"
};
---

<Base
    title="Microneedling Zürich ab CHF 210 | Beauty Face Lift"
    description="Microneedling in Zürich an der Bahnhofstrasse: kosmetische Hautbildpflege bei feinen Linien, Narbenoptik und grossen Poren. Ab CHF 210 – Termin buchen."
    preloadImage={heroPreload}
    structuredData={structuredData}
    ogImage={microneedlingCard}
>
    <TreatmentHero
        treatment="Microneedling"
        breadcrumb="Microneedling Zürich"
        lead="Microneedling in Zürich: Feine Nadeln setzen kontrollierte Mikrokanäle und können Hauterneuerung und Kollagenbildung unterstützen."
        bookingHref={bookingHref}
        image={microneedlingCard}
        alt="Microneedling Behandlung im Kosmetikinstitut Beauty Face Lift Zürich"
        focus="left"
        price="ab CHF 210"
        duration="90 Minuten"
    >Microneedling <em>Zürich</em></TreatmentHero>

    <!-- What it is & benefits -->
    <section class="section section--flush-top" aria-labelledby="intro-title">
        <div class="container">
            <TreatmentSplit image={microneedlingStill} alt="Microneedling-Pen und Serum auf hellem Marmor">
                <h2 id="intro-title">Für feinere Poren und eine glattere Struktur</h2>
                <p class="lead">Teresa arbeitet mit professionellen Microneedling-Pens – Nadeltiefe und Geschwindigkeit passt sie an Hautzustand, Zone und Ziel an.</p>
                <BenefitList items={benefits} />
            </TreatmentSplit>
        </div>
    </section>

    <!-- Prices -->
    <section class="section section--shell" id="preise" aria-label="Preise und Dauer">
        <div class="container">
            <PriceMenu items={priceItems} note="Inklusive Hautanalyse, Reinigung, Nachpflege und individueller Beratung. Paketpreise für Behandlungsserien auf Anfrage.">
                <Fragment slot="title">Microneedling Preise</Fragment>
                <a slot="actions" href={bookingHref} class="btn btn-arrow" data-treatment="Microneedling" data-button-location="treatment_prices">Termin buchen</a>
            </PriceMenu>
        </div>
    </section>

    <!-- Process -->
    <section class="section" aria-labelledby="process-title">
        <div class="container">
            <div class="section-head">
                <div>
                    <h2 id="process-title">Ablauf in vier Schritten</h2>
                    <p class="lead">Eine Sitzung dauert circa 90 Minuten – inklusive Vorbereitung und Nachpflege.</p>
                </div>
            </div>
            <TreatmentSteps steps={steps} />
        </div>
    </section>

    <!-- Suitability -->
    <section class="section section--flush-top" aria-labelledby="suitability-title">
        <div class="container">
            <TreatmentSplit image={consultationTrust} alt="Persönliche Hautanalyse vor dem Microneedling bei Beauty Face Lift Zürich" quality="high" reverse>
                <h2 id="suitability-title">Für wen ist Microneedling geeignet?</h2>
                <p class="lead">Ab dem 18. Lebensjahr möglich – die Eignung prüft Teresa vor Ort anhand Ihres Hautzustands.</p>
                <RuledList items={suitedFor} />
                <p class="split-note">Nicht geeignet bei offenen Wunden, aktiven Infektionen, akut entzündeter Haut oder Schwangerschaft.</p>
            </TreatmentSplit>
        </div>
    </section>

    <!-- Review -->
    <section class="section section--shell" aria-label="Kundenstimme">
        <div class="container">
            <ReviewQuote quote="Nur zum empfehlen" author="Andjela" detail="Microneedling Kundin" stars />
        </div>
    </section>

    <!-- FAQ -->
    <section class="section" aria-label="Häufige Fragen">
        <div class="container">
            <FaqBlock items={faqs}>
                <Fragment slot="title">Fragen zu Microneedling</Fragment>
            </FaqBlock>
        </div>
    </section>

    <!-- Booking -->
    <section class="section section--flush-top" id="buchen">
        <div class="container">
            <BookingCta treatment="Microneedling" href={bookingHref} image={consultation} alt="Teresa Stimac bespricht mit einer Kundin die Hautanalyse" />
        </div>
    </section>

    <RelatedTreatments current={pagePath} />
</Base>
