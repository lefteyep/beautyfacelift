---
import Base from '../../../layouts/Base.astro';
import BookingCta from '../../../components/BookingCta.astro';
import TreatmentHero from '../../../components/treatment/TreatmentHero.astro';
import TreatmentSplit from '../../../components/treatment/TreatmentSplit.astro';
import BenefitList from '../../../components/treatment/BenefitList.astro';
import PriceMenu from '../../../components/treatment/PriceMenu.astro';
import TreatmentSteps from '../../../components/treatment/TreatmentSteps.astro';
import RuledList from '../../../components/treatment/RuledList.astro';
import ReviewQuote from '../../../components/treatment/ReviewQuote.astro';
import FaqBlock from '../../../components/treatment/FaqBlock.astro';
import RelatedTreatments from '../../../components/treatment/RelatedTreatments.astro';
import { treatmentHeroPreload } from '../../../components/treatment/images';
import { coldplasmaCard, consultationTrust, teresaPortrait } from '../../../lib/site-images';
import consultation from '../../../assets/lp/aquafacial/hautanalyse-beratung-zuerich.webp';
import { absoluteUrl, bookingLinkForService } from '../../../../shared/site';

const pagePath = '/behandlungen/coldplasma-zuerich/';
const bookingHref = bookingLinkForService('ColdPlasma');
const heroPreload = await treatmentHeroPreload(coldplasmaCard);

const benefits = [
    { title: 'Ergänzende Wirkstoffpflege', text: 'Kann die Haut auf professionelle Seren vorbereiten – wie stark sie reagiert, hängt vom Hautzustand ab.' },
    { title: 'Bei unreiner Haut', text: 'Antimikrobielle Eigenschaften können die Pflege bei Unreinheiten und Akne ergänzen.' },
    { title: 'Meist angenehm & non-invasiv', text: 'Leichtes Kribbeln oder Wärmegefühl ist möglich; empfindliche Haut prüft Teresa vorher individuell.' },
];

const priceItems = [
    { name: 'coldPLASMA Akne/unreine Haut', duration: '90 Min.', price: 'CHF 180', note: 'Für unreine Haut, Akne-Neigung und ein ruhigeres Hautbild.' },
    { name: 'Anti Aging Behandlung', duration: '90 Min.', price: 'CHF 220', note: 'Mit Anti-Aging-Fokus für beruhigende Wirkstoffpflege.' },
    { name: 'Stabilisierung Hautbarriere', duration: '90 Min.', price: 'CHF 220', note: 'Für beanspruchte, empfindliche oder aus dem Gleichgewicht geratene Haut.' },
    { name: 'Aquafacial + coldPLASMA', duration: '90 Min.', price: 'CHF 280', note: 'Aquafacial Reinigung kombiniert mit coldPLASMA, besonders bei Akne.' },
];

const steps = [
    { title: 'Hautanalyse & Vorbereitung', text: 'Teresa analysiert Ihren Hautzustand, wählt die passenden Seren und reinigt die Haut schonend.' },
    { title: 'ColdPlasma-Applikation', text: 'Das ionisierte Gas wird kontrolliert und gleichmässig auf die Hautoberfläche appliziert.' },
    { title: 'Serum-Infusion', text: 'Wirkstoffe wie Hyaluronsäure, Peptide oder Antioxidantien werden nach Hautzustand aufgetragen.' },
    { title: 'Abschluss & Pflege', text: 'Eine beruhigende Abschlusspflege schützt die Hautbarriere – mit Pflegetipps für die nächsten 24 bis 48 Stunden.' },
];

const suitedFor = [
    'Feine Linien, Elastizitätsverlust und fahler Teint',
    'Unreinheiten und Akne',
    'Müde, gestresste Haut',
    'Empfindliche Haut',
    'Nach Microneedling oder Aquafacial',
    'Vor Hochzeiten, Fotoshootings oder Business-Events',
];

const faqs = [
    {
        question: 'Was ist ColdPlasma und wie wirkt es auf die Haut?',
        answer: 'ColdPlasma ist ein ionisiertes Gas, das bei niedriger Temperatur auf die Haut einwirkt. In der Kosmetik wird es zur unterstützenden Pflege bei unreiner Haut, Hautbarriere-Themen und zur Vorbereitung auf professionelle Seren eingesetzt. Wirkung und Verträglichkeit hängen vom individuellen Hautzustand ab.',
    },
    {
        question: 'Ist die ColdPlasma Behandlung schmerzhaft?',
        answer: 'In der Regel nicht: Sie spüren ein leichtes Kribbeln oder ein sanftes Wärmegefühl, vergleichbar mit einem feinen Luftstrom. Da das Plasma bei niedriger Temperatur arbeitet, ist das Risiko einer thermischen Reizung bei fachgerechter Anwendung gering.',
    },
    {
        question: 'Für wen ist ColdPlasma geeignet?',
        answer: 'ColdPlasma kann für verschiedene Hauttypen infrage kommen, besonders bei unreiner, fahler oder empfindlicher Haut sowie als Ergänzung zu Aquafacial oder Microneedling. Teresa klärt im Vorgespräch, ob die Behandlung passt und welche Intensität sinnvoll ist.',
    },
    {
        question: 'Wie viele ColdPlasma Sitzungen braucht man?',
        answer: 'Viele Kundinnen planen ColdPlasma als Serie, wenn Hautbarriere, Unreinheiten oder ein fahler Teint längerfristig begleitet werden sollen. Anzahl und Abstand hängen vom Hautzustand, von Kombinationen und der Verträglichkeit ab.',
    },
    {
        question: 'Was kostet ColdPlasma in Zürich?',
        answer: 'coldPLASMA Akne/unreine Haut kostet CHF 180, die Anti Aging Behandlung und die Stabilisierung der Hautbarriere jeweils CHF 220, Aquafacial + coldPLASMA für Akne CHF 280 – jeweils 90 Minuten, inklusive MwSt. und persönlicher Hautanalyse.',
    },
    {
        question: 'Kann man ColdPlasma mit Microneedling kombinieren?',
        answer: 'Ja, je nach Hautzustand. Ob ColdPlasma direkt im Anschluss oder mit Abstand sinnvoll ist, entscheidet Teresa nach Hautanalyse, Empfindlichkeit und Behandlungsziel.',
    },
    {
        question: 'Gibt es Nebenwirkungen bei ColdPlasma?',
        answer: 'ColdPlasma ist in der Regel gut verträglich. Vorübergehende Rötung, Wärmegefühl, Kribbeln oder leichte Empfindlichkeit können auftreten. Teresa bespricht vor jeder Behandlung mögliche Kontraindikationen.',
    },
];

const structuredData = {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "ColdPlasma Behandlung Zürich",
    "url": absoluteUrl(pagePath),
    "image": absoluteUrl('/assets/coldplasma_treatment_editorial.png'),
    "serviceType": "ColdPlasma",
    "category": "Gesichtsbehandlung",
    "provider": {
        "@type": "BeautySalon",
        "name": "Beauty Face Lift Zürich",
        "url": absoluteUrl('/'),
        "address": {
            "@type": "PostalAddress",
            "streetAddress": "Bahnhofstrasse 94",
            "addressLocality": "Zürich",
            "postalCode": "8001",
            "addressCountry": "CH"
        }
    },
    "description": "ColdPlasma ist eine kosmetisch-ästhetische Behandlung mit ionisiertem Gas bei niedriger Temperatur. Bei Beauty Face Lift an der Bahnhofstrasse Zürich wird jede Behandlung von Inhaberin Teresa Stimac persönlich durchgeführt.",
    "areaServed": "Zürich"
};
---

<Base
    title="ColdPlasma Zürich ab CHF 180 | Beauty Face Lift"
    description="ColdPlasma Behandlung in Zürich ab CHF 180: kosmetische Plasma-Technologie für unreine Haut, Hautbarriere und Wirkstoffpflege. Jetzt Termin buchen."
    preloadImage={heroPreload}
    structuredData={structuredData}
>
    <TreatmentHero
        treatment="ColdPlasma"
        breadcrumb="ColdPlasma Zürich"
        lead="ColdPlasma in Zürich: kosmetische Behandlung mit ionisiertem Gas bei niedriger Temperatur – zur Unterstützung bei unreiner, fahler oder empfindlicher Haut."
        bookingHref={bookingHref}
        image={coldplasmaCard}
        alt="ColdPlasma Behandlung bei Beauty Face Lift an der Bahnhofstrasse Zürich"
        price="ab CHF 180"
        duration="90 Minuten"
    >ColdPlasma <em>Zürich</em></TreatmentHero>

    <!-- What it is & benefits -->
    <section class="section section--flush-top" aria-labelledby="intro-title">
        <div class="container">
            <TreatmentSplit image={teresaPortrait} alt="Teresa Stimac in ihrem Studio an der Bahnhofstrasse Zürich" focus="center">
                <h2 id="intro-title">Ruhiger wirkende Haut, meist ohne Ausfallzeit</h2>
                <p class="lead">Jede ColdPlasma Behandlung führt Teresa Stimac persönlich durch – individuell dosiert und auf Ihren Hauttyp abgestimmt.</p>
                <BenefitList items={benefits} />
            </TreatmentSplit>
        </div>
    </section>

    <!-- Prices -->
    <section class="section section--shell" id="preise" aria-label="Preise und Dauer">
        <div class="container">
            <PriceMenu items={priceItems} note="Alle Preise inkl. MwSt. Individuelle Beratung und Hautanalyse inklusive.">
                <Fragment slot="title">ColdPlasma Preise</Fragment>
                <a slot="actions" href={bookingHref} class="btn btn-arrow" data-treatment="ColdPlasma" data-button-location="treatment_prices">Termin buchen</a>
            </PriceMenu>
        </div>
    </section>

    <!-- Process -->
    <section class="section" aria-labelledby="process-title">
        <div class="container">
            <div class="section-head">
                <div>
                    <h2 id="process-title">Ablauf in vier Schritten</h2>
                    <p class="lead">Non-invasiv und meist angenehm – Sie können direkt danach in den Alltag zurück.</p>
                </div>
            </div>
            <TreatmentSteps steps={steps} />
        </div>
    </section>

    <!-- Suitability -->
    <section class="section section--flush-top" aria-labelledby="suitability-title">
        <div class="container">
            <TreatmentSplit image={consultationTrust} alt="Persönliche Hautanalyse vor der ColdPlasma Behandlung in Zürich" quality="high" reverse>
                <h2 id="suitability-title">Für wen ist ColdPlasma geeignet?</h2>
                <p class="lead">ColdPlasma kann für verschiedene Hauttypen infrage kommen – ob es passt, klärt Teresa im Vorgespräch.</p>
                <RuledList items={suitedFor} />
                <p class="split-note">Mögliche Kontraindikationen bespricht Teresa vor jeder Behandlung mit Ihnen.</p>
            </TreatmentSplit>
        </div>
    </section>

    <!-- Review -->
    <section class="section section--shell" aria-label="Kundenstimme">
        <div class="container">
            <ReviewQuote quote="Stammkunde seit 2008, immer wieder begeistert." author="Daniel" detail="Stammkunde" />
        </div>
    </section>

    <!-- FAQ -->
    <section class="section" aria-label="Häufige Fragen">
        <div class="container">
            <FaqBlock items={faqs}>
                <Fragment slot="title">Fragen zu ColdPlasma</Fragment>
            </FaqBlock>
        </div>
    </section>

    <!-- Booking -->
    <section class="section section--flush-top" id="buchen">
        <div class="container">
            <BookingCta treatment="ColdPlasma" href={bookingHref} image={consultation} alt="Teresa Stimac bespricht mit einer Kundin die Hautanalyse" />
        </div>
    </section>

    <RelatedTreatments current={pagePath} />
</Base>
