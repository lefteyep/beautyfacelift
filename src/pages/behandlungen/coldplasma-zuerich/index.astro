---
import Base from '../../../layouts/Base.astro';
import TreatmentLinkCard from '../../../components/TreatmentLinkCard.astro';
import BookingCta from '../../../components/BookingCta.astro';
import AiSummary from '../../../components/AiSummary.astro';
import TreatmentHero from '../../../components/treatment/TreatmentHero.astro';
import TreatmentSplit from '../../../components/treatment/TreatmentSplit.astro';
import RuledList from '../../../components/treatment/RuledList.astro';
import PriceMenu from '../../../components/treatment/PriceMenu.astro';
import ReviewQuote from '../../../components/treatment/ReviewQuote.astro';
import FaqBlock from '../../../components/treatment/FaqBlock.astro';
import LinkList from '../../../components/treatment/LinkList.astro';
import { treatmentHeroPreload } from '../../../components/treatment/images';
import { coldplasmaCard, spaInterior, spaProducts } from '../../../lib/site-images';
import { absoluteUrl, bookingLinkForService } from '../../../../shared/site';

const bookingHref = bookingLinkForService('ColdPlasma');
const heroPreload = await treatmentHeroPreload(coldplasmaCard);

const summaryFacts = [
    { label: 'Dauer', value: '90 Minuten' },
    { label: 'Preis', value: 'ab CHF 180' },
    { label: 'Gefühl', value: 'meist leichtes Kribbeln oder Wärmegefühl' },
    { label: 'Einsatz', value: 'unreine Haut, Hautbarriere, beruhigende Wirkstoffpflege' },
];

const audiences = [
    { term: 'Hautalterung', text: 'feine Linien, Elastizitätsverlust, fahler Teint' },
    { term: 'Unreinheiten & Akne', text: 'antimikrobielle Eigenschaften können die Pflege ergänzen' },
    { term: 'Müde, gestresste Haut', text: 'frischer wirkendes Hautgefühl' },
    { term: 'Empfindliche Haut', text: 'sanft und non-invasiv, ideal für sensible Hauttypen' },
    { term: 'Post-Treatment Boost', text: 'nach Microneedling oder Aquafacial für ergänzende Wirkstoffpflege' },
    { term: 'Vor besonderen Anlässen', text: 'Hochzeit, Fotoshooting, Business-Events' },
];

const combinations = [
    {
        href: '/behandlungen/aquafacial-zuerich/',
        title: 'ColdPlasma + Aquafacial',
        text: 'Eine sinnvolle Kombination: Aquafacial reinigt und hydratisiert die Haut als Vorbereitung, ColdPlasma kann anschliessend die Wirkstoffpflege je nach Hautzustand ergänzen. Ideal in einer Sitzung oder im Abstand von wenigen Tagen.',
    },
    {
        href: '/behandlungen/microneedling-zuerich/',
        title: 'ColdPlasma + Microneedling',
        text: 'Microneedling erzeugt feine Mikrokanäle und kann die Kollagenbildung unterstützen. ColdPlasma kann danach als beruhigende Wirkstoffpflege eingeplant werden, wenn der Hautzustand passt.',
    },
    {
        href: '/behandlungen/fruchtsaeure-peeling-zuerich/',
        title: 'ColdPlasma + Fruchtsäure Peeling',
        text: 'Ein Fruchtsäure Peeling entfernt abgestorbene Hautzellen und bereitet die Hautoberfläche sorgfältig vor. ColdPlasma im Anschluss kann die anschliessende Wirkstoffpflege ergänzen — bitte mit Teresa abstimmen.',
    },
];

const priceItems = [
    { name: 'coldPLASMA Akne/unreine Haut', duration: '90 Minuten', price: 'CHF 180', note: 'Für unreine Haut, Akne-Neigung und ein ruhigeres Hautbild. Die Behandlung wird individuell auf Hautzustand und Ziel abgestimmt.' },
    { name: 'Anti Aging Behandlung', duration: '90 Minuten', price: 'CHF 220', note: 'coldPLASMA mit Anti-Aging-Fokus für beruhigende Wirkstoffpflege und sichtbar frischere Haut.' },
    { name: 'Stabilisierung Hautbarriere', duration: '90 Minuten', price: 'CHF 220', note: 'Stabilisierende coldPLASMA Behandlung für beanspruchte, empfindliche oder aus dem Gleichgewicht geratene Haut.' },
    { name: 'Aquafacial + coldPLASMA', duration: '90 Minuten', price: 'CHF 280', note: 'Aquafacial Reinigung kombiniert mit coldPLASMA, besonders bei Akne und unreiner Haut.' },
];

const structuredData = {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "ColdPlasma Behandlung Zürich",
    "url": absoluteUrl('/behandlungen/coldplasma-zuerich/'),
    "image": absoluteUrl('/assets/coldplasma_treatment_editorial.png'),
    "serviceType": "ColdPlasma",
    "category": "Gesichtsbehandlung",
    "provider": {
        "@type": "BeautySalon",
        "name": "Beauty Face Lift Zürich",
        "url": absoluteUrl('/'),
        "address": {
            "@type": "PostalAddress",
            "streetAddress": "Bahnhofstrasse 94",
            "addressLocality": "Zürich",
            "postalCode": "8001",
            "addressCountry": "CH"
        }
    },
    "description": "ColdPlasma ist eine kosmetisch-ästhetische Behandlung mit ionisiertem Gas bei niedriger Temperatur. Bei Beauty Face Lift an der Bahnhofstrasse Zürich wird jede Behandlung von Inhaberin Teresa Stimac persönlich durchgeführt.",
    "areaServed": "Zürich"
};

const faqData = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{
        "@type": "Question",
        "name": "Was ist ColdPlasma und wie wirkt es auf die Haut?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "ColdPlasma ist ein ionisiertes Gas, das bei niedriger Temperatur auf die Haut einwirkt. In der Kosmetik wird es zur unterstützenden Pflege bei unreiner Haut, Hautbarriere-Themen und zur Vorbereitung auf professionelle Seren eingesetzt. Die Wirkung und Verträglichkeit hängen vom individuellen Hautzustand ab."
        }
    }, {
        "@type": "Question",
        "name": "Ist die ColdPlasma Behandlung schmerzhaft?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nein, die ColdPlasma Behandlung bei Beauty Face Lift ist in der Regel angenehm. Während der Applikation spüren Sie lediglich ein leichtes, angenehmes Kribbeln oder ein sanftes Wärmegefühl auf der Haut — vergleichbar mit einem feinen Luftstrom. Da das Plasma bei niedriger Temperatur arbeitet (daher der Name 'Cold' Plasma), ist das Risiko einer thermischen Reizung gering, wenn fachgerecht gearbeitet wird. ColdPlasma wird meist als angenehm empfunden und kann auch für empfindlichere Haut interessant sein, wenn keine Gegenanzeigen vorliegen."
        }
    }, {
        "@type": "Question",
        "name": "Für wen ist ColdPlasma geeignet?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "ColdPlasma kann für verschiedene Hauttypen infrage kommen, besonders bei unreiner, fahler oder empfindlicher Haut sowie als Ergänzung zu Aquafacial oder Microneedling. Teresa klärt im Vorgespräch, ob die Behandlung für Ihren Hautzustand geeignet ist und welche Intensität sinnvoll ist."
        }
    }, {
        "@type": "Question",
        "name": "Wie viele ColdPlasma Sitzungen braucht man?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Viele Kundinnen planen ColdPlasma als Serie, wenn Hautbarriere, Unreinheiten oder ein fahler Teint längerfristig begleitet werden sollen. Anzahl und Abstand der Sitzungen hängen vom Hautzustand, der Kombination mit anderen Behandlungen und der Verträglichkeit ab."
        }
    }, {
        "@type": "Question",
        "name": "Was kostet ColdPlasma in Zürich?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bei Beauty Face Lift an der Bahnhofstrasse 94 in Zürich kostet coldPLASMA Akne/unreine Haut aktuell CHF 180 und dauert 90 Minuten. Die Anti Aging Behandlung und die Stabilisierung der Hautbarriere kosten jeweils CHF 220 für 90 Minuten. Aquafacial + coldPLASMA für Akne kostet CHF 280 für 90 Minuten."
        }
    }, {
        "@type": "Question",
        "name": "Kann man ColdPlasma mit Microneedling kombinieren?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja, ColdPlasma kann je nach Hautzustand mit Microneedling kombiniert werden. Ob es direkt im Anschluss oder mit Abstand sinnvoll ist, entscheidet Teresa nach Hautanalyse, Empfindlichkeit und Behandlungsziel."
        }
    }, {
        "@type": "Question",
        "name": "Gibt es Nebenwirkungen bei ColdPlasma?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "ColdPlasma ist in der Regel gut verträglich. Vorübergehende Rötung, Wärmegefühl, Kribbeln oder leichte Empfindlichkeit können auftreten. Teresa bespricht vor jeder Behandlung mögliche Kontraindikationen und passt die Anwendung an Ihren Hautzustand an."
        }
    }]
};
---

<Base
    title="ColdPlasma Behandlung Zürich | Beauty Face Lift Bahnhofstrasse"
    description="ColdPlasma Behandlung in Zürich ab CHF 180 — kosmetische Plasma-Technologie für unreine Haut, Hautbarriere und professionelle Wirkstoffpflege."
    preloadImage={heroPreload}
    structuredData={structuredData}
>
    <TreatmentHero
        treatment="ColdPlasma"
        breadcrumb="ColdPlasma Zürich"
        eyebrow="Plasma-Technologie · Bahnhofstrasse 94"
        lead="ColdPlasma ist eine kosmetisch-ästhetische Behandlung mit ionisiertem Gas bei niedriger Temperatur."
        bookingHref={bookingHref}
        image={coldplasmaCard}
        alt="ColdPlasma Behandlung Zürich — Innovative Hautbildpflege an der Bahnhofstrasse"
    >ColdPlasma <em>Zürich</em></TreatmentHero>

    <AiSummary
        title="ColdPlasma kurz erklärt"
        intro="Die Behandlung kann die professionelle Wirkstoffpflege bei unreiner, fahler oder empfindlicher Haut unterstützen; Ergebnisse und Verträglichkeit sind individuell unterschiedlich."
        facts={summaryFacts}
    />

    <!-- Innovation -->
    <section class="section section--ivory" aria-labelledby="innovation-title">
        <div class="container">
            <TreatmentSplit image={spaInterior} alt="ColdPlasma Behandlung im Beauty Face Lift Zürich">
                <p class="eyebrow eyebrow--rule">Die Innovation</p>
                <h2 id="innovation-title">„Zukunft der<br /><em>Hautpflege</em>.“</h2>
                <p>ColdPlasma ist eine kosmetisch-ästhetische Behandlung mit ionisiertem Gas bei niedriger Temperatur. Sie kann die professionelle Wirkstoffpflege bei unreiner, fahler oder empfindlicher Haut unterstützen und wird individuell dosiert. Bei Beauty Face Lift an der Bahnhofstrasse Zürich wird jede ColdPlasma Behandlung von Inhaberin Teresa Stimac persönlich durchgeführt und individuell auf Ihren Hauttyp abgestimmt. Ziel ist ein frischer, ruhiger wirkendes Hautbild, meist ohne relevante Ausfallzeit.</p>
                <div class="btn-row">
                    <a href={bookingHref} class="btn-link">Termin vereinbaren</a>
                </div>
            </TreatmentSplit>
        </div>
    </section>

    <!-- Benefits -->
    <section class="section" aria-labelledby="benefits-title">
        <div class="container">
            <div class="section-head">
                <div>
                    <p class="eyebrow eyebrow--rule">Vorteile</p>
                    <h2 id="benefits-title">Was ColdPlasma <em>leisten</em> kann</h2>
                </div>
            </div>
            <ul class="index-grid">
                <li class="scroll-anim">
                    <h3>Zellerneuerung</h3>
                    <p>Kann die professionelle Wirkstoffpflege unterstützen; die Haut wirkt je nach Ausgangszustand frischer und ruhiger.</p>
                </li>
                <li class="scroll-anim">
                    <h3>Wirkstoffpflege</h3>
                    <p>Kann die Haut auf professionelle Seren vorbereiten. Ob und wie stark die Haut reagiert, hängt vom individuellen Hautzustand ab.</p>
                </li>
                <li class="scroll-anim">
                    <h3>Meist angenehm &amp; non-invasiv</h3>
                    <p>Non-invasiv und meist angenehm. Leichtes Kribbeln, Wärmegefühl oder vorübergehende Rötung sind möglich; Teresa prüft empfindliche Haut vorher individuell.</p>
                </li>
            </ul>
        </div>
    </section>

    <!-- Process -->
    <section class="section section--sand" aria-labelledby="process-title">
        <div class="container">
            <div class="section-head">
                <div>
                    <p class="eyebrow eyebrow--rule">Ablauf der Behandlung</p>
                    <h2 id="process-title">Ablauf in vier <em>Schritten</em></h2>
                </div>
            </div>
            <ol class="steps">
                <li class="scroll-anim">
                    <h3>Hautanalyse &amp; Vorbereitung</h3>
                    <p>Teresa analysiert Ihren Hautzustand und bespricht Ihre individuellen Ziele. Basierend auf der Analyse wird eine passende Serenkombination ausgewählt und Ihre Haut schonend gereinigt und vorbereitet.</p>
                </li>
                <li class="scroll-anim">
                    <h3>ColdPlasma-Applikation</h3>
                    <p>Das ionisierte Gas wird kontrolliert und gleichmässig auf die Hautoberfläche appliziert. Die Plasmaenergie wird kontrolliert eingesetzt und kann die Haut auf nachfolgende professionelle Seren vorbereiten.</p>
                </li>
                <li class="scroll-anim">
                    <h3>Serum-Infusion</h3>
                    <p>Professionelle Wirkstoffe wie Hyaluronsäure, Peptide, Vitamine oder Antioxidantien werden nach Hautzustand ausgewählt und aufgetragen. Die Aufnahme kann nach der Vorbereitung vorübergehend verbessert sein.</p>
                </li>
                <li class="scroll-anim">
                    <h3>Abschluss &amp; Pflege</h3>
                    <p>Eine beruhigende Abschlusspflege schützt die Hautbarriere. Teresa gibt Ihnen individuelle Pflegetipps für die nächsten 24 bis 48 Stunden mit.</p>
                </li>
            </ol>
        </div>
    </section>

    <!-- Suitability -->
    <section class="section" aria-labelledby="suitability-title">
        <div class="container">
            <TreatmentSplit image={spaProducts} alt="Premium Seren und Wirkstoffe für ColdPlasma Behandlung in Zürich" ratio="square" reverse>
                <p class="eyebrow eyebrow--rule">Für wen?</p>
                <h2 id="suitability-title">Wer profitiert von <em>ColdPlasma</em>?</h2>
                <p>ColdPlasma kann für verschiedene Hauttypen infrage kommen. Besonders häufig wird die Behandlung besprochen bei:</p>
                <RuledList items={audiences} />
                <p>Teresa berät Sie im Vorgespräch individuell und empfiehlt die passende Behandlungsoption für Ihren Hauttyp und Ihre Ziele.</p>
            </TreatmentSplit>
        </div>
    </section>

    <!-- Combinations -->
    <section class="section section--ivory" aria-labelledby="combinations-title">
        <div class="container">
            <div class="section-head">
                <div>
                    <p class="eyebrow eyebrow--rule">Behandlungskombinationen</p>
                    <h2 id="combinations-title">ColdPlasma kombinieren für gezielte <em>Wirkung</em></h2>
                </div>
            </div>
            <LinkList items={combinations} />
        </div>
    </section>

    <!-- Prices -->
    <section class="section" aria-label="Preise">
        <div class="container">
            <PriceMenu items={priceItems} note="Alle Preise inkl. MwSt. Individuelle Beratung und Hautanalyse inklusive.">
                <Fragment slot="title">ColdPlasma <em>Preise</em></Fragment>
            </PriceMenu>
        </div>
    </section>

    <!-- Testimonial -->
    <section class="section section--sand" aria-label="Kundenstimme">
        <div class="container">
            <ReviewQuote quote="Stammkundin seit 2008 — Teresa versteht meine Haut wie keine andere." author="Daniel" detail="Stammkunde" />
        </div>
    </section>

    <!-- FAQ -->
    <section class="section" aria-label="Häufige Fragen">
        <div class="container">
            <FaqBlock>
                <Fragment slot="title">Fragen zu <em>ColdPlasma</em></Fragment>
                <details class="faq-item">
                    <summary><h3>Was ist ColdPlasma und wie wirkt es auf die Haut?</h3></summary>
                    <div class="faq-answer"><div class="faq-answer-inner">
                        <p>ColdPlasma — auch kaltes Atmosphärenplasma oder Non-Thermal Plasma genannt — ist ein ionisiertes Gas, das bei niedriger Temperatur auf die Haut einwirkt. Das ionisierte Gas kann die Hauterneuerung kosmetisch unterstützen, wird in der Kosmetik wegen antimikrobieller Eigenschaften eingesetzt gegen Bakterien und Unreinheiten, und kann die Hautbarriere temporär für ergänzende Wirkstoffpflege vorbereiten. Bei Beauty Face Lift in Zürich setzen wir ColdPlasma gezielt ein, um professionelle Seren sorgfältig einzuarbeiten — für ein frischer und ruhiger wirkendes Hautbild.</p>
                    </div></div>
                </details>
                <details class="faq-item">
                    <summary><h3>Ist die ColdPlasma Behandlung schmerzhaft?</h3></summary>
                    <div class="faq-answer"><div class="faq-answer-inner">
                        <p>Nein, die ColdPlasma Behandlung bei Beauty Face Lift ist in der Regel angenehm. Während der Applikation spüren Sie lediglich ein leichtes, angenehmes Kribbeln oder ein sanftes Wärmegefühl auf der Haut — vergleichbar mit einem feinen Luftstrom. Da das Plasma bei niedriger Temperatur arbeitet (daher der Name „Cold“ Plasma), ist das Risiko einer thermischen Reizung gering, wenn fachgerecht gearbeitet wird. ColdPlasma wird meist als angenehm empfunden und kann auch für empfindlichere Haut interessant sein, wenn keine Gegenanzeigen vorliegen.</p>
                    </div></div>
                </details>
                <details class="faq-item">
                    <summary><h3>Für wen ist ColdPlasma geeignet?</h3></summary>
                    <div class="faq-answer"><div class="faq-answer-inner">
                        <p>ColdPlasma kann für verschiedene Hauttypen infrage kommen, besonders bei unreiner, fahler oder empfindlicher Haut sowie als Ergänzung zu Aquafacial oder Microneedling. Teresa klärt im Vorgespräch, ob die Behandlung für Ihren Hautzustand geeignet ist und welche Intensität sinnvoll ist.</p>
                    </div></div>
                </details>
                <details class="faq-item">
                    <summary><h3>Wie viele ColdPlasma Sitzungen braucht man?</h3></summary>
                    <div class="faq-answer"><div class="faq-answer-inner">
                        <p>Viele Kundinnen planen ColdPlasma als Serie, wenn Hautbarriere, Unreinheiten oder ein fahler Teint längerfristig begleitet werden sollen. Anzahl und Abstand der Sitzungen hängen vom Hautzustand, der Kombination mit anderen Behandlungen und der Verträglichkeit ab.</p>
                    </div></div>
                </details>
                <details class="faq-item">
                    <summary><h3>Was kostet ColdPlasma in Zürich?</h3></summary>
                    <div class="faq-answer"><div class="faq-answer-inner">
                        <p>Bei Beauty Face Lift an der Bahnhofstrasse 94 in Zürich kostet coldPLASMA Akne/unreine Haut aktuell CHF 180 und dauert 90 Minuten. Die Anti Aging Behandlung und die Stabilisierung der Hautbarriere kosten jeweils CHF 220 für 90 Minuten. Aquafacial + coldPLASMA für Akne kostet CHF 280 für 90 Minuten. Alle Preise verstehen sich inklusive MwSt., persönlicher Hautanalyse, Beratung durch Teresa und abgestimmter Wirkstoffpflege.</p>
                    </div></div>
                </details>
                <details class="faq-item">
                    <summary><h3>Kann man ColdPlasma mit Microneedling kombinieren?</h3></summary>
                    <div class="faq-answer"><div class="faq-answer-inner">
                        <p>Ja, die Kombination von ColdPlasma und Microneedling ist eine mögliche Kombination, die Teresa nach Hautanalyse bewertet. Microneedling erzeugt feine Mikrokanäle in der Haut und kann die natürliche Hauterneuerung und Kollagenbildung unterstützen, während ColdPlasma die Wirkstoffpflege je nach Hautzustand ergänzen kann. Ob ColdPlasma direkt im Anschluss oder mit Abstand sinnvoll ist, entscheidet Teresa nach Hautzustand, Empfindlichkeit und Behandlungsziel.</p>
                    </div></div>
                </details>
                <details class="faq-item">
                    <summary><h3>Gibt es Nebenwirkungen bei ColdPlasma?</h3></summary>
                    <div class="faq-answer"><div class="faq-answer-inner">
                        <p>ColdPlasma ist in der Regel gut verträglich. Vorübergehende Rötung, Wärmegefühl, Kribbeln oder leichte Empfindlichkeit können auftreten. Teresa bespricht vor jeder Behandlung mögliche Kontraindikationen und passt die Anwendung an Ihren Hautzustand an.</p>
                    </div></div>
                </details>
            </FaqBlock>
        </div>
        <script type="application/ld+json" set:html={JSON.stringify(faqData)} />
    </section>

    <!-- Booking -->
    <section class="section section--tight section--flush-top" id="buchen">
        <div class="container">
            <BookingCta treatment="ColdPlasma" href={bookingHref} />
        </div>
    </section>

    <!-- Related -->
    <section class="section section--tight section--rule" aria-labelledby="related-title">
        <div class="container">
            <div class="section-head">
                <div>
                    <p class="eyebrow eyebrow--rule">Weitere Behandlungen</p>
                    <h2 id="related-title">Mehr für Ihre <em>Haut</em></h2>
                </div>
                <a href="/behandlungen/" class="btn-link">Alle Behandlungen</a>
            </div>
            <div class="index-grid">
                <TreatmentLinkCard
                    href="/behandlungen/aquafacial-zuerich/"
                    title="Aquafacial"
                    description="Tiefenreinigung, Vitalisierung und Glow. Professionelle Pflege für den frischen Selfie-Look."
                />
                <TreatmentLinkCard
                    href="/behandlungen/microneedling-zuerich/"
                    title="Microneedling"
                    description="Kosmetische Hautbildverbesserung ohne OP. Kollagenstimulation für ein verfeinertes Hautbild."
                />
                <TreatmentLinkCard
                    href="/behandlungen/fruchtsaeure-peeling-zuerich/"
                    title="Fruchtsäure Peeling"
                    description="Tiefenreinigung und Hauterneuerung für einen kompromisslos klaren Teint."
                />
            </div>
        </div>
    </section>
</Base>
