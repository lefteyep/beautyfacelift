---
import Base from '../../../layouts/Base.astro';
import TreatmentLinkCard from '../../../components/TreatmentLinkCard.astro';
import BookingWidget from '../../../components/booking/BookingWidget';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import TreatmentActionBar from '../../../components/TreatmentActionBar.astro';
import { Image, getImage } from 'astro:assets';
import { coldplasmaCard, spaInterior, spaProducts } from '../../../lib/site-images';

const treatmentHeroSizes = '100vw';
const treatmentContentSizes = '(min-width: 1240px) 540px, (min-width: 901px) 42vw, 100vw';
const coldPlasmaHeroPreload = await getImage({
    src: coldplasmaCard,
    widths: [768, 1024, 1440, 1536],
    sizes: treatmentHeroSizes,
    format: 'webp',
    quality: 'high',
});

const structuredData = {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "ColdPlasma Behandlung Zürich",
    "url": "https://beautyfacelift.ch/behandlungen/coldplasma-zuerich/",
    "image": "https://beautyfacelift.ch/assets/coldplasma_treatment_editorial.png",
    "serviceType": "ColdPlasma",
    "category": "Gesichtsbehandlung",
    "provider": {
        "@type": "HealthAndBeautyBusiness",
        "name": "Beauty Face Lift",
        "address": {
            "@type": "PostalAddress",
            "streetAddress": "Bahnhofstrasse 94",
            "addressLocality": "Zürich",
            "postalCode": "8001",
            "addressCountry": "CH"
        }
    },
    "description": "ColdPlasma (auch kaltes Atmosphärenplasma oder Non-Thermal Plasma genannt) ist eine innovative Technologie aus der medizinischen Forschung, bei der Gas bei niedriger Temperatur ionisiert wird und auf die Hautoberfläche einwirkt. Bei Beauty Face Lift an der Bahnhofstrasse Zürich wird jede Behandlung von Inhaberin Teresa Stimac persönlich durchgeführt.",
    "areaServed": "Zürich",
    "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "CHF",
        "lowPrice": "180",
        "highPrice": "280",
        "offerCount": "4"
    },
    "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.8",
        "reviewCount": "240",
        "bestRating": "5"
    }
};

const faqData = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [{
        "@type": "Question",
        "name": "Was ist ColdPlasma und wie wirkt es auf die Haut?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "ColdPlasma — auch kaltes Atmosphärenplasma oder Non-Thermal Plasma genannt — ist ein ionisiertes Gas, das bei niedriger Temperatur auf die Haut einwirkt. Die Technologie stammt ursprünglich aus der medizinischen Wundbehandlung und wird heute erfolgreich in der ästhetischen Dermatologie eingesetzt. Das ionisierte Gas stimuliert die Zellerneuerung auf molekularer Ebene, wirkt nachweislich antimikrobiell gegen Bakterien und Unreinheiten, und öffnet die Hautbarriere temporär für eine bis zu 300% verbesserte Wirkstoffaufnahme. Bei Beauty Face Lift in Zürich setzen wir ColdPlasma gezielt ein, um hochkonzentrierte Seren tief in die Haut einzuschleusen — für sichtbar jüngere, reinere und strahlendere Haut."
        }
    }, {
        "@type": "Question",
        "name": "Ist die ColdPlasma Behandlung schmerzhaft?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nein, die ColdPlasma Behandlung bei Beauty Face Lift ist vollkommen schmerzfrei. Während der Applikation spüren Sie lediglich ein leichtes, angenehmes Kribbeln oder ein sanftes Wärmegefühl auf der Haut — vergleichbar mit einem feinen Luftstrom. Da das Plasma bei niedriger Temperatur arbeitet (daher der Name 'Cold' Plasma), besteht keinerlei Verbrennungsgefahr. ColdPlasma ist eine der angenehmsten Anti-Aging Behandlungen in unserem Zürcher Spa und eignet sich hervorragend auch für empfindliche Hauttypen, die auf invasivere Verfahren empfindlich reagieren."
        }
    }, {
        "@type": "Question",
        "name": "Für wen ist ColdPlasma geeignet?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "ColdPlasma eignet sich für alle Hauttypen und praktisch jedes Alter. Besonders wirksam ist die Behandlung bei ersten Zeichen der Hautalterung wie feinen Linien und Elastizitätsverlust, bei Unreinheiten und Akne dank der antimikrobiellen Wirkung, bei fahler und müder Haut ohne natürlichen Glow sowie bei empfindlicher Haut, die andere intensive Behandlungen nicht verträgt. ColdPlasma ist zudem eine ideale Ergänzung nach Hydrafacial oder Microneedling, da es die Wirkstoffaufnahme massiv verstärkt. Teresa berät Sie im Vorgespräch individuell, welche Option für Ihren Hauttyp optimal ist."
        }
    }, {
        "@type": "Question",
        "name": "Wie viele ColdPlasma Sitzungen braucht man?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bereits nach der ersten ColdPlasma Sitzung bei Beauty Face Lift in Zürich ist ein sichtbarer Unterschied erkennbar — die Haut wirkt frischer, glatter und aufnahmefähiger. Für langanhaltende Anti-Aging-Ergebnisse empfehlen wir eine Kur von 4 bis 6 Sitzungen im Abstand von jeweils 2 bis 4 Wochen. Dieser Rhythmus ermöglicht eine kumulative Wirkung auf die Kollagenproduktion und Zellerneuerung. Nach Abschluss der Kur genügt eine monatliche Erhaltungsbehandlung, um die Ergebnisse dauerhaft zu bewahren. Teresa erstellt für Sie einen individuellen Behandlungsplan basierend auf Ihrem Hautzustand und Ihren Zielen."
        }
    }, {
        "@type": "Question",
        "name": "Was kostet ColdPlasma in Zürich?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bei Beauty Face Lift an der Bahnhofstrasse 94 in Zürich kostet coldPLASMA Akne/unreine Haut aktuell CHF 180 und dauert 90 Minuten. Die Anti Aging Luxus Behandlung und die Stabilisierung der Hautbarriere kosten jeweils CHF 220 für 90 Minuten. Hydra4Face + coldPLASMA für Akne kostet CHF 280 für 90 Minuten."
        }
    }, {
        "@type": "Question",
        "name": "Kann man ColdPlasma mit Microneedling kombinieren?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja, die Kombination von ColdPlasma und Microneedling ist eine der wirkungsvollsten Behandlungsstrategien, die wir bei Beauty Face Lift in Zürich anbieten. Microneedling erzeugt feine Mikrokanäle in der Haut und stimuliert die Kollagenproduktion, während ColdPlasma die Hautbarriere zusätzlich öffnet und die Wirkstoffaufnahme um bis zu 300% steigert. Wir empfehlen, ColdPlasma direkt im Anschluss an das Microneedling durchzuführen, um die frisch geöffneten Kanäle optimal zu nutzen. Alternativ können beide Behandlungen im Abstand von 1 bis 2 Wochen durchgeführt werden. Teresa berät Sie individuell zur optimalen Reihenfolge und Intervallen."
        }
    }, {
        "@type": "Question",
        "name": "Gibt es Nebenwirkungen bei ColdPlasma?",
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "ColdPlasma ist eine der sichersten und nebenwirkungsärmsten Behandlungen in der modernen Ästhetik. Da das Plasma bei niedriger Temperatur arbeitet und die Haut nicht mechanisch verletzt wird, treten in der Regel keine ernsthaften Nebenwirkungen auf. Unmittelbar nach der Behandlung kann eine leichte Rötung auftreten, die typischerweise innert 30 bis 60 Minuten vollständig abklingt. In seltenen Fällen kann die Haut für einige Stunden leicht empfindlicher reagieren. Es gibt keinerlei Ausfallzeit — Sie können direkt nach der Behandlung zurück in Ihren Alltag, Make-up auftragen und Ihren normalen Aktivitäten nachgehen. Teresa bespricht vor jeder Behandlung mögliche Kontraindikationen mit Ihnen."
        }
    }]
};
---

<Base
    title="ColdPlasma Behandlung Zürich | Hautverjüngung an der Bahnhofstrasse"
    description="ColdPlasma Behandlung in Zürich ab CHF 180 — innovative Plasma-Technologie zur Hautverjüngung, Zellerneuerung und Wirkstoffeinschleusung."
    preloadImage={{
        href: coldPlasmaHeroPreload.src,
        imagesrcset: coldPlasmaHeroPreload.srcSet.attribute,
        imagesizes: treatmentHeroSizes,
        type: 'image/webp',
        fetchpriority: 'high',
    }}
    navVariant="treatment"
    bodyClass="treatment-page"
    structuredData={structuredData}
>
    <!-- Editorial Hero with Background Image -->
    <header class="treatment-hero">
        <div class="treatment-hero-media">
            <Image
                src={coldplasmaCard}
                widths={[768, 1024, 1440, 1536]}
                sizes={treatmentHeroSizes}
                format="webp"
                quality="high"
                priority
                alt="ColdPlasma Behandlung Zürich — Innovative Hautverjüngung an der Bahnhofstrasse"
                id="treatment-hero-img"
            />
        </div>
        <div class="hero-titles">
            <div class="sub-display text-reveal-wrapper margin-bottom-sm">
                <span class="text-reveal" style="color: rgba(237, 235, 230, 0.7);">Plasma Technologie • Zürich</span>
            </div>
            <h1 class="sr-only">ColdPlasma Behandlung Zürich — Innovative Hautverjüngung an der Bahnhofstrasse</h1>
            <div class="title-line text-reveal-wrapper" aria-hidden="true">
                <span class="display-text text-reveal" style="color: var(--text-inverse); font-size: clamp(3.5rem, 8vw, 8rem);">Cold</span>
            </div>
            <div class="title-line title-right text-reveal-wrapper" aria-hidden="true">
                <span class="display-text text-reveal" style="color: var(--gold); font-weight: 300; font-size: clamp(3.5rem, 8vw, 8rem);">Plasma</span>
            </div>
        </div>
    </header>

    <div class="container treatment-breadcrumbs">
        <Breadcrumbs items={[
            { label: "Home", href: "/" },
            { label: "Behandlungen", href: "/behandlungen/" },
            { label: "ColdPlasma Zürich" }
        ]} />
    </div>

    <TreatmentActionBar treatment="ColdPlasma" />

    <!-- Content Split -->
    <section class="about-editorial pad-y">
        <div class="split-layout align-center">
            <div class="about-text scroll-anim">
                <span class="sub-display">Die Innovation</span>
                <h2 style="font-size: clamp(2rem, 3.5vw, 3.5rem); text-transform: none; margin-bottom: 2rem;">"Zukunft der<br>Hautpflege."</h2>
                <p class="margin-bottom-md">ColdPlasma (auch kaltes Atmosphärenplasma oder Non-Thermal Plasma genannt) ist eine innovative Technologie aus der medizinischen Forschung, bei der Gas bei niedriger Temperatur ionisiert wird und auf die Hautoberfläche einwirkt. Das ionisierte Gas stimuliert die Zellerneuerung auf molekularer Ebene, wirkt antimikrobiell und öffnet die Hautbarriere temporär für eine bis zu 300% verbesserte Wirkstoffaufnahme. Bei Beauty Face Lift an der Bahnhofstrasse Zürich wird jede ColdPlasma Behandlung von Inhaberin Teresa Stimac persönlich durchgeführt und individuell auf Ihren Hauttyp abgestimmt. Das Ergebnis: sichtbar jüngere, reinere und strahlendere Haut — ganz ohne Nadeln, ohne Chemie und ohne Downtime.</p>
                <a href="#buchen" class="pill-btn pill-btn-outline">Termin vereinbaren</a>
            </div>
            <div class="about-image scroll-anim">
                <div class="service-image-mask" style="padding-bottom: 120%;">
                    <Image
                        src={spaInterior}
                        widths={[360, 540, 720, 960]}
                        sizes={treatmentContentSizes}
                        format="webp"
                        quality="mid"
                        alt="ColdPlasma Behandlung im Beauty Face Lift Zürich"
                        class="anim-img"
                        loading="lazy"
                    />
                </div>
            </div>
        </div>
    </section>

    <!-- Highlights Grid -->
    <section class="container" style="padding-bottom: 10vh;">
        <div class="sub-display margin-bottom-lg" style="text-align: center;">Vorteile</div>
        <div class="highlights-grid">
            <div class="highlight-item scroll-anim">
                <div class="highlight-number">01</div>
                <h4>Zellerneuerung</h4>
                <p>Stimuliert die natürliche Regeneration der Hautzellen auf molekularer Ebene für ein sichtbar frischeres, jüngeres Erscheinungsbild — bereits nach der ersten Sitzung.</p>
            </div>
            <div class="highlight-item scroll-anim">
                <div class="highlight-number">02</div>
                <h4>Wirkstoff-Boost</h4>
                <p>Öffnet die Hautbarriere temporär und ermöglicht eine bis zu 300% bessere Aufnahme von Seren und Wirkstoffen. Die ideale Ergänzung zu jeder Pflegebehandlung.</p>
            </div>
            <div class="highlight-item scroll-anim">
                <div class="highlight-number">03</div>
                <h4>Schmerzfrei & Non-Invasiv</h4>
                <p>Komplett non-invasiv und angenehm. Kein Piksen, keine Nadeln, keine Ausfallzeit — direkt zurück in den Alltag. Ideal auch für empfindliche Hauttypen.</p>
            </div>
        </div>
    </section>

    <!-- Pricing Section -->
    <section class="container" style="padding-bottom: 10vh;">
        <div class="sub-display margin-bottom-lg" style="text-align: center;">Preise</div>
        <div class="pricing-grid">
            <div class="pricing-card pricing-card-accent scroll-anim">
                <div class="pricing-label">coldPLASMA Akne/unreine Haut</div>
                <div class="pricing-price">CHF 180</div>
                <div class="pricing-duration">90 Minuten</div>
                <p>Für unreine Haut, Akne-Neigung und ein ruhigeres Hautbild. Die Behandlung wird individuell auf Hautzustand und Ziel abgestimmt.</p>
            </div>
            <div class="pricing-card scroll-anim">
                <div class="pricing-label">Anti Aging Luxus Behandlung</div>
                <div class="pricing-price">CHF 220</div>
                <div class="pricing-duration">90 Minuten</div>
                <p>coldPLASMA mit Anti-Aging-Fokus für Regeneration, Wirkstoffaufnahme und sichtbar frischere Haut.</p>
            </div>
            <div class="pricing-card scroll-anim">
                <div class="pricing-label">Stabilisierung Hautbarriere</div>
                <div class="pricing-price">CHF 220</div>
                <div class="pricing-duration">90 Minuten</div>
                <p>Stabilisierende coldPLASMA Behandlung für beanspruchte, empfindliche oder aus dem Gleichgewicht geratene Haut.</p>
            </div>
            <div class="pricing-card scroll-anim">
                <div class="pricing-label">Hydra4Face + coldPLASMA</div>
                <div class="pricing-price">CHF 280</div>
                <div class="pricing-duration">90 Minuten</div>
                <p>Hydra4Face Reinigung kombiniert mit coldPLASMA, besonders bei Akne und unreiner Haut.</p>
            </div>
        </div>
        <p style="text-align: center; margin: 2rem auto; font-size: 0.9rem;">Alle Preise inkl. MwSt. Individuelle Beratung und Hautanalyse inklusive.</p>
    </section>

    <!-- Treatment Process -->
    <section class="container" style="padding-bottom: 10vh;">
        <div class="sub-display margin-bottom-lg" style="text-align: center;">Ablauf der Behandlung</div>
        <div class="process-grid">
            <div class="process-step scroll-anim">
                <div class="highlight-number">01</div>
                <h4>Hautanalyse & Vorbereitung</h4>
                <p>Teresa analysiert Ihren Hautzustand und bespricht Ihre individuellen Ziele. Basierend auf der Analyse wird die optimale Serenkombination ausgewählt und Ihre Haut schonend gereinigt und vorbereitet.</p>
            </div>
            <div class="process-step scroll-anim">
                <div class="highlight-number">02</div>
                <h4>ColdPlasma-Applikation</h4>
                <p>Das ionisierte Gas wird kontrolliert und gleichmässig auf die Hautoberfläche appliziert. Die Plasmaenergie stimuliert die Zellerneuerung, wirkt antimikrobiell und öffnet die Hautbarriere für die nachfolgende Serum-Infusion.</p>
            </div>
            <div class="process-step scroll-anim">
                <div class="highlight-number">03</div>
                <h4>Serum-Infusion</h4>
                <p>Hochkonzentrierte Wirkstoffe — Hyaluronsäure, Peptide, Vitamine und Antioxidantien — werden in die durch ColdPlasma geöffnete Haut eingeschleust. Die Aufnahme ist jetzt bis zu 300% höher als bei herkömmlicher Applikation.</p>
            </div>
            <div class="process-step scroll-anim">
                <div class="highlight-number">04</div>
                <h4>Abschluss & Pflege</h4>
                <p>Ein schützender Serum-Cocktail versiegelt die Behandlung und bewahrt die eingeschleusten Wirkstoffe. Teresa gibt Ihnen individuelle Pflegetipps für die nächsten 24 bis 48 Stunden mit — Ihre Haut strahlt sofort.</p>
            </div>
        </div>
    </section>

    <!-- Target Audience Section -->
    <section class="about-editorial" style="padding-bottom: 10vh;">
        <div class="split-layout align-center">
            <div class="about-text scroll-anim">
                <span class="sub-display">Für wen?</span>
                <h2 style="font-size: clamp(1.8rem, 3vw, 2.8rem); text-transform: none; margin-bottom: 2rem;">Wer profitiert von ColdPlasma?</h2>
                <p class="margin-bottom-md">ColdPlasma eignet sich für alle Hauttypen und jedes Alter. Die Behandlung ist besonders empfehlenswert bei:</p>
                <ul style="list-style: none; padding: 0; margin-bottom: 2rem;">
                    <li style="padding: 0.5rem 0; border-bottom: 1px solid var(--border-subtle); font-size: 1.0625rem; color: var(--text-secondary);">• Hautalterung — feine Linien, Elastizitätsverlust, fahler Teint</li>
                    <li style="padding: 0.5rem 0; border-bottom: 1px solid var(--border-subtle); font-size: 1.0625rem; color: var(--text-secondary);">• Unreinheiten & Akne — antimikrobielle Plasmawirkung bekämpft Bakterien gezielt</li>
                    <li style="padding: 0.5rem 0; border-bottom: 1px solid var(--border-subtle); font-size: 1.0625rem; color: var(--text-secondary);">• Müde, gestresste Haut — sofortige Revitalisierung und natürlicher Glow</li>
                    <li style="padding: 0.5rem 0; border-bottom: 1px solid var(--border-subtle); font-size: 1.0625rem; color: var(--text-secondary);">• Empfindliche Haut — sanft und non-invasiv, ideal für sensible Hauttypen</li>
                    <li style="padding: 0.5rem 0; border-bottom: 1px solid var(--border-subtle); font-size: 1.0625rem; color: var(--text-secondary);">• Post-Treatment Boost — nach Microneedling oder Hydrafacial für verstärkte Wirkstoffaufnahme</li>
                    <li style="padding: 0.5rem 0; font-size: 1.0625rem; color: var(--text-secondary);">• Vor besonderen Anlässen — Hochzeit, Fotoshooting, Business-Events</li>
                </ul>
                <p>Teresa berät Sie im Vorgespräch individuell und empfiehlt die optimale Behandlungsoption für Ihren Hauttyp und Ihre Ziele.</p>
            </div>
            <div class="about-image scroll-anim">
                <div class="service-image-mask" style="padding-bottom: 100%;">
                    <Image
                        src={spaProducts}
                        widths={[360, 540, 720, 960]}
                        sizes={treatmentContentSizes}
                        format="webp"
                        quality="mid"
                        alt="Premium Seren und Wirkstoffe für ColdPlasma Behandlung in Zürich"
                        class="anim-img"
                        loading="lazy"
                    />
                </div>
            </div>
        </div>
    </section>

    <!-- Combination Section -->
    <section class="container" style="padding-bottom: 10vh;">
        <div class="sub-display margin-bottom-lg" style="text-align: center;">Behandlungskombinationen</div>
        <h2 style="text-align: center; font-size: clamp(1.8rem, 3vw, 2.5rem); text-transform: none; margin-bottom: 3rem;">ColdPlasma kombinieren für maximale Wirkung</h2>
        <div class="highlights-grid">
            <div class="highlight-item scroll-anim">
                <h4>ColdPlasma + <a href="/behandlungen/hydrafacial-zuerich/" style="color: var(--accent); text-decoration: underline;">Hydrafacial</a></h4>
                <p>Die kraftvolle Kombination: Hydrafacial reinigt und hydratisiert die Haut als Vorbereitung, ColdPlasma verstärkt anschliessend die Wirkstoffaufnahme um bis zu 300%. Ideal in einer Sitzung oder im Abstand von wenigen Tagen.</p>
            </div>
            <div class="highlight-item scroll-anim">
                <h4>ColdPlasma + <a href="/behandlungen/microneedling-zuerich/" style="color: var(--accent); text-decoration: underline;">Microneedling</a></h4>
                <p>Microneedling erzeugt feine Mikrokanäle und stimuliert die Kollagenproduktion. ColdPlasma direkt danach öffnet die Hautbarriere zusätzlich und schleust Wirkstoffe noch tiefer ein — für sichtbar jüngere Haut.</p>
            </div>
            <div class="highlight-item scroll-anim">
                <h4>ColdPlasma + <a href="/behandlungen/fruchtsaeure-peeling-zuerich/" style="color: var(--accent); text-decoration: underline;">Fruchtsäure Peeling</a></h4>
                <p>Ein Fruchtsäure Peeling entfernt abgestorbene Hautzellen und bereitet die Hautoberfläche optimal vor. ColdPlasma im Anschluss nutzt die erneuerte Haut für eine maximale Serum-Infusion — bitte mit Teresa absprechen.</p>
            </div>
        </div>
    </section>

    <!-- Testimonial Section -->
    <section class="container" style="padding-bottom: 10vh;">
        <div class="sub-display margin-bottom-lg" style="text-align: center;">Kundenstimmen</div>
        <div style="max-width: 700px; margin: 0 auto; text-align: center;">
            <blockquote style="font-family: var(--font-serif); font-size: clamp(1.4rem, 2.5vw, 2rem); font-weight: 300; color: var(--text-primary); line-height: 1.5; margin: 0 0 1.5rem 0; padding: 0;">
                "Stammkundin seit 2008 — Teresa versteht meine Haut wie keine andere."
            </blockquote>
            <p style="color: var(--text-secondary); font-size: 1rem; margin-bottom: 0.5rem;">— Daniel, Stammkunde</p>
            <p style="color: var(--accent); font-size: var(--text-sm); font-weight: 500;">4.8 von 5 Sternen aus 240+ verifizierten Bewertungen</p>
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-section">
        <div class="faq-label">Häufig gestellte Fragen</div>
        <div class="faq-list">
            <details class="faq-item scroll-anim">
                <summary><h3>Was ist ColdPlasma und wie wirkt es auf die Haut?</h3></summary>
                <div class="faq-answer"><div class="faq-answer-inner">
                    <p>ColdPlasma — auch kaltes Atmosphärenplasma oder Non-Thermal Plasma genannt — ist ein ionisiertes Gas, das bei niedriger Temperatur auf die Haut einwirkt. Die Technologie stammt ursprünglich aus der medizinischen Wundbehandlung und wird heute erfolgreich in der ästhetischen Dermatologie eingesetzt. Das ionisierte Gas stimuliert die Zellerneuerung auf molekularer Ebene, wirkt nachweislich antimikrobiell gegen Bakterien und Unreinheiten, und öffnet die Hautbarriere temporär für eine bis zu 300% verbesserte Wirkstoffaufnahme. Bei Beauty Face Lift in Zürich setzen wir ColdPlasma gezielt ein, um hochkonzentrierte Seren tief in die Haut einzuschleusen — für sichtbar jüngere, reinere und strahlendere Haut.</p>
                </div></div>
            </details>
            <details class="faq-item scroll-anim">
                <summary><h3>Ist die ColdPlasma Behandlung schmerzhaft?</h3></summary>
                <div class="faq-answer"><div class="faq-answer-inner">
                    <p>Nein, die ColdPlasma Behandlung bei Beauty Face Lift ist vollkommen schmerzfrei. Während der Applikation spüren Sie lediglich ein leichtes, angenehmes Kribbeln oder ein sanftes Wärmegefühl auf der Haut — vergleichbar mit einem feinen Luftstrom. Da das Plasma bei niedriger Temperatur arbeitet (daher der Name "Cold" Plasma), besteht keinerlei Verbrennungsgefahr. ColdPlasma ist eine der angenehmsten Anti-Aging Behandlungen in unserem Zürcher Spa und eignet sich hervorragend auch für empfindliche Hauttypen, die auf invasivere Verfahren empfindlich reagieren.</p>
                </div></div>
            </details>
            <details class="faq-item scroll-anim">
                <summary><h3>Für wen ist ColdPlasma geeignet?</h3></summary>
                <div class="faq-answer"><div class="faq-answer-inner">
