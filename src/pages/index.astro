---
import { absoluteUrl } from '../../shared/site';
import Base from '../layouts/Base.astro';
import Marquee from '../components/Marquee.astro';
import { Image, getImage } from 'astro:assets';
import {
    carbonTreatmentTeresa,
    coldplasmaCard,
    heroCenter,
    heroRight,
    hydrafacialCard,
    microneedlingCard,
    peelingCard,
    spaProducts,
    teresaPortrait,
} from '../lib/site-images';

const heroMainSizes = '(min-width: 1240px) 396px, (min-width: 901px) 32vw, 88vw';
const heroSecondarySizes = '(min-width: 1240px) 307px, (min-width: 901px) 24vw, 54vw';
const cardSizes = '(min-width: 1240px) 760px, (min-width: 901px) 56vw, 100vw';
const portraitSizes = '(min-width: 1240px) 540px, (min-width: 901px) 42vw, 100vw';

const homepageHeroPreload = await getImage({
    src: carbonTreatmentTeresa,
    widths: [480, 720, 960, 1122],
    sizes: heroMainSizes,
    format: 'webp',
    quality: 'high',
});

const businessStructuredData = {
    "@context": "https://schema.org",
    "@type": "BeautySalon",
    "name": "Beauty Face Lift Zürich",
    "url": absoluteUrl('/'),
    "address": {
        "@type": "PostalAddress",
        "streetAddress": "Bahnhofstrasse 94",
        "addressLocality": "Zürich",
        "postalCode": "8001",
        "addressCountry": "CH"
    },
    "areaServed": [
        "Zürich",
        "Switzerland"
    ],
    "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Gesichtsbehandlungen",
        "itemListElement": [
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Hydrafacial", "url": absoluteUrl('/behandlungen/hydrafacial-zuerich/') } },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Microneedling", "url": absoluteUrl('/behandlungen/microneedling-zuerich/') } },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Fruchtsäure Peeling", "url": absoluteUrl('/behandlungen/fruchtsaeure-peeling-zuerich/') } },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "ColdPlasma", "url": absoluteUrl('/behandlungen/coldplasma-zuerich/') } },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Exosome Therapie", "url": absoluteUrl('/behandlungen/exosome-therapie-zuerich/') } }
        ]
    },
};

const websiteStructuredData = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Beauty Face Lift Zürich",
    "url": absoluteUrl('/'),
};

const structuredData = [businessStructuredData, websiteStructuredData];

const faqData = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
        {
            "@type": "Question",
            "name": "Was ist ein Kosmetikinstitut?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Ein Kosmetikinstitut vereint kosmetisch-ästhetische Behandlungen mit der Entspannung eines hochwertigen Spa-Erlebnisses. Bei Beauty Face Lift in Zürich bieten wir nicht-chirurgische Behandlungen wie Hydrafacial, Microneedling, Fruchtsäure Peeling, ColdPlasma und Exosome Therapie an. Anders als in einem klassischen Kosmetikstudio setzen wir auf professionelle Geräte, hochwertige Wirkstoffe und persönliche Beratung — ganz ohne chirurgische Eingriffe."
            }
        },
        {
            "@type": "Question",
            "name": "Welche Behandlung passt zu mir?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Die ideale Behandlung hängt von Ihren individuellen Hautbedürfnissen ab. Hydrafacial eignet sich hervorragend für frischen Glow und intensive Feuchtigkeit. Microneedling ist eine Option bei Anti-Aging, feinen Linien und Narben. Fruchtsäure Peeling empfehlen wir bei Unreinheiten, Akne und unebenmässiger Hauttextur. ColdPlasma und Exosome Therapie können die professionelle Wirkstoffpflege ergänzen. Teresa berät Sie persönlich in einem Erstgespräch und erstellt einen massgeschneiderten Behandlungsplan für Ihre Haut."
            }
        },
        {
            "@type": "Question",
            "name": "Brauche ich eine Beratung vor der ersten Behandlung?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Eine kurze persönliche Beratung ist fester Bestandteil jeder Erstbehandlung bei Beauty Face Lift. Teresa nimmt sich Zeit, Ihren Hauttyp sorgfältig zu analysieren, eventuelle Empfindlichkeiten zu besprechen und die passende Behandlung für Ihre individuellen Bedürfnisse zu empfehlen. Diese Beratung ist kostenlos und unverbindlich. So stellen wir sicher, dass Sie von Anfang an die bestmöglichen Ergebnisse erzielen und sich bei uns rundum wohlfühlen."
            }
        },
        {
            "@type": "Question",
            "name": "Kann ich mehrere Behandlungen kombinieren?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Ja, viele unserer Behandlungen ergänzen sich hervorragend und können für möglichst gute Ergebnisse miteinander kombiniert werden. Besonders beliebt ist die Kombination aus Hydrafacial und ColdPlasma — die Tiefenreinigung des Hydrafacials bereitet die Haut ideal auf die regenerierende Wirkung des ColdPlasma vor. Auch Microneedling und Fruchtsäure Peeling lassen sich in einem abgestimmten Behandlungsplan integrieren. Teresa empfiehlt Ihnen die ideale Kombination basierend auf Ihrem Hautbild."
            }
        },
        {
            "@type": "Question",
            "name": "Sind die Behandlungen für empfindliche Haut geeignet?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Ja, alle unsere Behandlungen sind individuell auf Ihren Hauttyp anpassbar. Besonders Hydrafacial und ColdPlasma zeichnen sich durch ihre sanfte Wirkungsweise aus und sind hervorragend für empfindliche Haut geeignet. Die Intensität wird bei jeder Behandlung an Ihre persönliche Hautempfindlichkeit angepasst. Bei der Erstberatung bespricht Teresa allfällige Allergien oder Unverträglichkeiten mit Ihnen, damit wir die Behandlung sorgfältig auf Ihre Bedürfnisse abstimmen können."
            }
        },
        {
            "@type": "Question",
            "name": "Wo befindet sich Beauty Face Lift?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Unser Studio befindet sich an der Bahnhofstrasse 94, 8001 Zürich — im Herzen der Stadt, nur wenige Schritte vom Paradeplatz entfernt. Die zentrale Lage ist hervorragend mit öffentlichen Verkehrsmitteln erreichbar: Die Tram-Haltestellen Paradeplatz und Börsenstrasse liegen in unmittelbarer Nähe. Auch mit dem Auto ist das Studio gut zugänglich, mit mehreren Parkhäusern in der Umgebung. Wir freuen uns auf Ihren Besuch in unserer Beauty Oase an Zürichs bekanntester Einkaufsstrasse."
            }
        }
    ]
};
---

<Base
    title="Beauty Face Lift Zürich | Kosmetikstudio an der Bahnhofstrasse"
    description="Kosmetikstudio in Zürich an der Bahnhofstrasse 94 für Gesichtsbehandlungen, Hydra Facial, Microneedling, Fruchtsäurepeeling, Laser Haarentfernung, Waxing, Massage und Make-up."
    preloadImage={{
        href: homepageHeroPreload.src,
        imagesrcset: homepageHeroPreload.srcSet.attribute,
        imagesizes: heroMainSizes,
        type: 'image/webp',
        fetchpriority: 'high',
    }}
    structuredData={structuredData}
>
    <!-- Hero — Conversion-optimized -->
    <header class="hero-editorial">
        <div class="hero-content">
            <div class="hero-sub-display sub-display text-reveal-wrapper">
                <span class="text-reveal">Premium Kosmetikstudio ·<br class="hero-sub-mobile-break"> Bahnhofstrasse Zürich</span>
            </div>

            <div class="hero-mobile-actions" aria-label="Schneller Einstieg zur Buchung">
                <a href="/termin/" class="pill-btn">Termin buchen</a>
                <span class="hero-mobile-proof">Teresa persönlich · Bahnhofstrasse 94</span>
            </div>

            <h1 class="hero-display text-reveal-wrapper">
                <span class="display-text text-reveal">Beauty Face Lift Zürich</span>
            </h1>

            <p class="hero-body">Kosmetikstudio an der Bahnhofstrasse 94 in 8001 Zürich für Gesichtsbehandlungen, Hydra Facial, Microneedling, Fruchtsäurepeeling, Laser Haarentfernung, Waxing, Massage und Make-up. Persönliche Beratung durch Teresa Stimac an der Bahnhofstrasse.</p>

            <div class="hero-ctas">
                <a href="/termin/" class="pill-btn hero-cta">Jetzt Termin buchen</a>
                <a href="/behandlungen/" class="pill-btn pill-btn-ghost hero-cta-secondary">Behandlungen entdecken</a>
            </div>
        </div>

        <div class="hero-media" id="hero-media">
            <div class="hero-media-main">
                <Image
                    src={carbonTreatmentTeresa}
                    widths={[480, 720, 960, 1122]}
                    sizes={heroMainSizes}
                    format="webp"
                    quality="high"
                    priority
                    class="hero-img-inner"
                    id="hero-img-1"
                    alt="Teresa Stimac bei einer Carbon Peeling Behandlung im Studio an der Bahnhofstrasse Zürich"
                />
            </div>
            <div class="hero-media-overlap" id="hero-float-1">
                <Image
                    src={heroRight}
                    widths={[320, 480, 640]}
                    sizes={heroSecondarySizes}
                    format="webp"
                    quality="mid"
                    loading="lazy"
                    fetchpriority="low"
                    id="hero-img-2"
                    alt="Professionelle Gesichtsbehandlung bei Beauty Face Lift Zürich"
                />
            </div>
            <div class="hero-media-overlap-bottom" id="hero-float-2">
                <Image
                    src={heroCenter}
                    widths={[320, 480, 640]}
                    sizes={heroSecondarySizes}
                    format="webp"
                    quality="mid"
                    loading="lazy"
                    fetchpriority="low"
                    id="hero-img-3"
                    alt="Frau mit natürlicher, strahlender Haut in einem warmen Premium Kosmetikstudio"
                />
            </div>
        </div>

        <div class="scroll-indicator" aria-hidden="true">
            <span class="scroll-indicator-line"></span>
            <span class="scroll-indicator-label">Scroll</span>
        </div>
    </header>

    <!-- Marquee -->
    <Marquee items={["Hydrafacial", "Microneedling", "ColdPlasma", "Fruchtsäure Peeling", "Exosome Therapie"]} />

    <!-- Services -->
    <section id="expertise" class="services-section">
        <div class="services-wrapper">
            <!-- Left Sticky -->
            <div class="services-sticky">
                <span class="sub-display">Behandlungen</span>
                <h2>Unsere<br>Expertise</h2>
                <p>Kosmetisch-ästhetische Gesichtsbehandlungen mit modernster Technologie. Persönliche Beratung und individuelle Behandlungspläne für jedes Hautbild — direkt an der Bahnhofstrasse Zürich.</p>
                <a href="/behandlungen/" class="pill-btn pill-btn-outline">Alle Behandlungen</a>
            </div>

            <!-- Right Scrolling -->
            <div class="services-list">
                <div class="service-card">
                    <span class="number-accent">01</span>
                    <h3>Hydrafacial</h3>
                    <div class="service-image-mask service-image-tall">
                        <Image
                            src={hydrafacialCard}
                            widths={[360, 540, 720, 960]}
                            sizes={cardSizes}
                            format="webp"
                            quality="high"
                            alt="Hydrafacial Behandlung Zürich — Tiefenreinigung und Glow"
                            class="anim-img"
                            loading="lazy"
                        />
                    </div>
                    <p>Die beliebteste Gesichtsbehandlung der Welt — jetzt an der Bahnhofstrasse Zürich. Hydrafacial kombiniert Tiefenreinigung, sanftes Peeling und intensive Feuchtigkeitspflege in einer meist gut verträglichen 60-Minuten-Behandlung. Frischeres Hautbild, meist keine Ausfallzeit.</p>
                    <a href="/behandlungen/hydrafacial-zuerich/" class="pill-btn pill-btn-outline pill-btn-sm">Hydrafacial entdecken</a>
                </div>

                <div class="service-card">
                    <span class="number-accent">02</span>
                    <h3>Microneedling</h3>
                    <div class="service-image-mask service-image-tall">
                        <Image
                            src={microneedlingCard}
                            widths={[360, 540, 720, 960]}
                            sizes={cardSizes}
                            format="webp"
                            quality="high"
                            alt="Microneedling Zürich — Anti-Aging und Kollagenbooster"
                            class="anim-img"
                            loading="lazy"
                        />
                    </div>
                    <p>Kosmetische Anti-Aging-Pflege für anspruchsvolle Haut. Microneedling stimuliert die körpereigene Kollagenproduktion und kann die Hauterneuerung unterstützen — für ein sichtbar verfeinertes Hautbild, verfeinerte Poren und feinere Linien.</p>
                    <a href="/behandlungen/microneedling-zuerich/" class="pill-btn pill-btn-outline pill-btn-sm">Microneedling entdecken</a>
                </div>

                <div class="service-card">
                    <span class="number-accent">03</span>
                    <h3>Fruchtsäure Peeling</h3>
                    <div class="service-image-mask service-image-tall">
                        <Image
                            src={peelingCard}
                            widths={[360, 540, 720, 960]}
                            sizes={cardSizes}
                            format="webp"
                            quality="high"
                            alt="Fruchtsäure Peeling Zürich — Chemisches Peeling für reine Haut"
                            class="anim-img"
                            loading="lazy"
                        />
                    </div>
                    <p>Das professionelle chemische Peeling für einen ebenmässigen, strahlenden Teint. AHA-Fruchtsäuren lösen abgestorbene Hautzellen und mildern Unreinheiten, Akne und Hyperpigmentierung.</p>
                    <a href="/behandlungen/fruchtsaeure-peeling-zuerich/" class="pill-btn pill-btn-outline pill-btn-sm">Peeling entdecken</a>
                </div>

                <div class="service-card">
                    <span class="number-accent">04</span>
                    <h3>ColdPlasma</h3>
                    <div class="service-image-mask service-image-tall">
                        <Image
                            src={coldplasmaCard}
                            widths={[360, 540, 720, 960]}
                            sizes={cardSizes}
                            format="webp"
                            quality="high"
                            alt="ColdPlasma Behandlung Zürich — Innovative Hautregeneration"
                            class="anim-img"
                            loading="lazy"
                        />
                    </div>
                    <p>Die Innovation der Hautpflege. ColdPlasma-Technologie kann die professionelle Wirkstoffpflege unterstützen und steigert die Wirkstoffaufnahme je nach Hautzustand.</p>
                    <a href="/behandlungen/coldplasma-zuerich/" class="pill-btn pill-btn-outline pill-btn-sm">ColdPlasma entdecken</a>
                </div>

                <div class="service-card">
                    <span class="number-accent">05</span>
                    <h3>Exosome Therapie</h3>
                    <div class="service-image-mask service-image-tall">
                        <Image
                            src={spaProducts}
                            widths={[360, 540, 720, 960]}
                            sizes={cardSizes}
                            format="webp"
                            quality="high"
                            alt="Exosome Therapie Zürich — regeneratives Serum und Hyaluronsäure"
                            class="anim-img"
                            loading="lazy"
                        />
                    </div>
                    <p>Regenerative Kosmetik mit Exosomen Serum beziehungsweise exosomenähnlicher Wirkstofftechnologie. Für Feuchtigkeit, Hautbarriere, Glow und ein ruhigeres Hautbild — mit ehrlicher Beratung und realistischen Erwartungen.</p>
                    <a href="/behandlungen/exosome-therapie-zuerich/" class="pill-btn pill-btn-outline pill-btn-sm">Exosome Therapie entdecken</a>
                </div>
            </div>
        </div>
    </section>

    <div class="section-divider"></div>

    <!-- About -->
    <section id="about" class="about-editorial pad-y">
        <div class="split-layout align-center">
            <div class="about-image scroll-anim">
                <div class="about-portrait">
                    <Image
                        src={teresaPortrait}
                        widths={[360, 540, 720]}
                        sizes={portraitSizes}
                        format="webp"
                        quality="high"
                        alt="Teresa Stimac, Gründerin von Beauty Face Lift Zürich"
                        class="anim-img"
                        loading="lazy"
                    />
                </div>
            </div>
            <div class="about-text">
                <span class="sub-display">Über Teresa</span>
                <blockquote class="about-quote">
                    <p>"Die Haut ist 90% von<br>deinem Selfie."</p>
                </blockquote>
                <p>Im Zentrum der Stadt Zürich an der berühmten Bahnhofstrasse befindet sich unsere Beauty Oase. Geleitet von Teresa Stimac — seit über 20 Jahren selbstständige Kosmetikerin in Zürich mit einer treuen Stammkundschaft, die sich auf ihre Erfahrung und Expertise verlässt.</p>
                <a href="/ueber-uns/" class="pill-btn pill-btn-outline">Teresa Kennenlernen</a>
            </div>
        </div>
    </section>

    <div class="section-divider"></div>

    <!-- Testimonials -->
    <section class="testimonials-section">
        <div class="testimonials-label">Kundenstimmen</div>
        <div class="testimonials-grid">
            <div class="testimonial-card">
                <span class="testimonial-stars">★ ★ ★ ★ ★</span>
                <p class="testimonial-quote">"Wie immer eine wunderbare Verwöhnzeit!"</p>
                <span class="testimonial-author">Emina — Hydrafacial · verifizierte Bewertung</span>
            </div>
            <div class="testimonial-card">
                <span class="testimonial-stars">★ ★ ★ ★ ★</span>
                <p class="testimonial-quote">"Stammkunde seit 2008 — immer wieder begeistert."</p>
                <span class="testimonial-author">Daniel — Stammkunde · verifizierte Bewertung</span>
            </div>
            <div class="testimonial-card">
                <span class="testimonial-stars">★ ★ ★ ★ ★</span>
                <p class="testimonial-quote">"Teresa ist charmant, warm und absolut professionell."</p>
                <span class="testimonial-author">Andreas — Gesichtsbehandlung · verifizierte Bewertung</span>
            </div>
        </div>
    </section>

    <!-- Rating Line -->
    <div class="rating-line">
        <p style="text-align: center; margin: 0 auto; font-size: var(--text-xs); color: var(--text-muted); letter-spacing: 0.03em;">4.8 von 5 Sternen aus 248+ verifizierten Bewertungen</p>
    </div>

    <!-- Trust Strip -->
    <div class="trust-strip" aria-label="Vertrauensindikatoren">
        <span class="trust-strip-item">Bahnhofstrasse Zürich</span>
        <span class="trust-strip-item">248+ verifizierte Bewertungen</span>
        <span class="trust-strip-item">20+ Jahre Erfahrung</span>
        <span class="trust-strip-item">Persönliche Betreuung</span>
    </div>

    <div class="section-divider"></div>

    <!-- FAQ Section -->
    <section class="faq-section">
        <div class="faq-label">Häufig gestellte Fragen</div>
        <div class="faq-list">
            <details class="faq-item">
                <summary>Was ist ein Kosmetikinstitut?</summary>
                <p>Ein Kosmetikinstitut vereint kosmetisch-ästhetische Behandlungen mit der Entspannung eines hochwertigen Spa-Erlebnisses. Bei Beauty Face Lift in Zürich bieten wir nicht-chirurgische Behandlungen wie Hydrafacial, Microneedling, Fruchtsäure Peeling, ColdPlasma und Exosome Therapie an. Anders als in einem klassischen Kosmetikstudio setzen wir auf professionelle Geräte, hochwertige Wirkstoffe und persönliche Beratung — ganz ohne chirurgische Eingriffe.</p>
            </details>
            <details class="faq-item">
                <summary>Welche Behandlung passt zu mir?</summary>
                <p>Die ideale Behandlung hängt von Ihren individuellen Hautbedürfnissen ab. Hydrafacial eignet sich hervorragend für frischen Glow und intensive Feuchtigkeit. Microneedling ist eine Option bei Anti-Aging, feinen Linien und Narben. Fruchtsäure Peeling empfehlen wir bei Unreinheiten, Akne und unebenmässiger Hauttextur. ColdPlasma und Exosome Therapie können die professionelle Wirkstoffpflege ergänzen. Teresa berät Sie persönlich in einem Erstgespräch und erstellt einen massgeschneiderten Behandlungsplan für Ihre Haut.</p>
            </details>
            <details class="faq-item">
                <summary>Brauche ich eine Beratung vor der ersten Behandlung?</summary>
                <p>Eine kurze persönliche Beratung ist fester Bestandteil jeder Erstbehandlung bei Beauty Face Lift. Teresa nimmt sich Zeit, Ihren Hauttyp sorgfältig zu analysieren, eventuelle Empfindlichkeiten zu besprechen und die passende Behandlung für Ihre individuellen Bedürfnisse zu empfehlen. Diese Beratung ist kostenlos und unverbindlich. So stellen wir sicher, dass Sie von Anfang an die bestmöglichen Ergebnisse erzielen und sich bei uns rundum wohlfühlen.</p>
            </details>
            <details class="faq-item">
                <summary>Kann ich mehrere Behandlungen kombinieren?</summary>
                <p>Ja, viele unserer Behandlungen ergänzen sich hervorragend und können für möglichst gute Ergebnisse miteinander kombiniert werden. Besonders beliebt ist die Kombination aus Hydrafacial und ColdPlasma — die Tiefenreinigung des Hydrafacials bereitet die Haut ideal auf die regenerierende Wirkung des ColdPlasma vor. Auch Microneedling und Fruchtsäure Peeling lassen sich in einem abgestimmten Behandlungsplan integrieren. Teresa empfiehlt Ihnen die ideale Kombination basierend auf Ihrem Hautbild.</p>
            </details>
            <details class="faq-item">
                <summary>Sind die Behandlungen für empfindliche Haut geeignet?</summary>
                <p>Ja, alle unsere Behandlungen sind individuell auf Ihren Hauttyp anpassbar. Besonders Hydrafacial und ColdPlasma zeichnen sich durch ihre sanfte Wirkungsweise aus und sind hervorragend für empfindliche Haut geeignet. Die Intensität wird bei jeder Behandlung an Ihre persönliche Hautempfindlichkeit angepasst. Bei der Erstberatung bespricht Teresa allfällige Allergien oder Unverträglichkeiten mit Ihnen, damit wir die Behandlung sorgfältig auf Ihre Bedürfnisse abstimmen können.</p>
            </details>
            <details class="faq-item">
                <summary>Wo befindet sich Beauty Face Lift?</summary>
                <p>Unser Studio befindet sich an der Bahnhofstrasse 94, 8001 Zürich — im Herzen der Stadt, nur wenige Schritte vom Paradeplatz entfernt. Die zentrale Lage ist hervorragend mit öffentlichen Verkehrsmitteln erreichbar: Die Tram-Haltestellen Paradeplatz und Börsenstrasse liegen in unmittelbarer Nähe. Auch mit dem Auto ist das Studio gut zugänglich, mit mehreren Parkhäusern in der Umgebung. Wir freuen uns auf Ihren Besuch in unserer Beauty Oase an Zürichs bekanntester Einkaufsstrasse.</p>
            </details>
        </div>
        <script type="application/ld+json" set:html={JSON.stringify(faqData)} />
    </section>
</Base>
