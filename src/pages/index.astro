---
import { absoluteUrl, SERVICE_GROUPS } from '../../shared/site';
import Base from '../layouts/Base.astro';
import Marquee from '../components/Marquee.astro';
import { Image, getImage } from 'astro:assets';
import {
    carbonTreatmentTeresa,
    coldplasmaCard,
    heroCenter,
    heroRight,
    aquafacialCard,
    microneedlingCard,
    peelingCard,
    spaProducts,
    teresaPortrait,
} from '../lib/site-images';

const heroMainSizes = '(min-width: 1240px) 396px, (min-width: 901px) 32vw, 88vw';
const heroSecondarySizes = '(min-width: 1240px) 307px, (min-width: 901px) 24vw, 54vw';
const cardSizes = '(min-width: 1240px) 760px, (min-width: 901px) 56vw, 100vw';
const portraitSizes = '(min-width: 1240px) 540px, (min-width: 901px) 42vw, 100vw';

const homepageHeroPreload = await getImage({
    src: carbonTreatmentTeresa,
    widths: [480, 720, 960, 1122],
    sizes: heroMainSizes,
    format: 'webp',
    quality: 'high',
});

const businessStructuredData = {
    "@context": "https://schema.org",
    "@type": "BeautySalon",
    "name": "Beauty Face Lift Zürich",
    "url": absoluteUrl('/'),
    "address": {
        "@type": "PostalAddress",
        "streetAddress": "Bahnhofstrasse 94",
        "addressLocality": "Zürich",
        "postalCode": "8001",
        "addressCountry": "CH"
    },
    "areaServed": [
        "Zürich",
        "Switzerland"
    ],
    "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Kosmetische Behandlungen",
        "itemListElement": SERVICE_GROUPS.flatMap((group) => group.services.map((service) => ({
            "@type": "Offer",
            "category": group.label,
            "itemOffered": {
                "@type": "Service",
                "name": service.label,
                "url": absoluteUrl(service.href),
                "description": service.description
            }
        })))
    },
};

const websiteStructuredData = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Beauty Face Lift Zürich",
    "url": absoluteUrl('/'),
};

const structuredData = [businessStructuredData, websiteStructuredData];

const faqData = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
        {
            "@type": "Question",
            "name": "Was ist ein Kosmetikinstitut?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Ein Kosmetikinstitut verbindet professionelle kosmetische Behandlungen mit einer ruhigen, persönlichen Studio-Erfahrung. Bei Beauty Face Lift in Zürich bieten wir Behandlungen wie Aquafacial, Microneedling, Fruchtsäure Peeling, ColdPlasma und Exosome Therapie an — ohne chirurgische Eingriffe und mit persönlicher Beratung."
            }
        },
        {
            "@type": "Question",
            "name": "Welche Behandlung passt zu mir?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Die passende Behandlung hängt von Hauttyp, Ziel und Verträglichkeit ab. Aquafacial eignet sich für Glow und Feuchtigkeit, Microneedling kann Hautstruktur und feine Linien unterstützen, Fruchtsäure Peeling kann bei Unreinheiten und unebenem Teint sinnvoll sein. Teresa berät Sie persönlich und empfiehlt einen realistischen nächsten Schritt."
            }
        },
        {
            "@type": "Question",
            "name": "Brauche ich eine Beratung vor der ersten Behandlung?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Eine kurze persönliche Beratung ist fester Bestandteil jeder Erstbehandlung bei Beauty Face Lift. Teresa nimmt sich Zeit, Hauttyp, Empfindlichkeiten und Ziel zu besprechen, damit die Behandlung passend und realistisch geplant wird."
            }
        },
        {
            "@type": "Question",
            "name": "Kann ich mehrere Behandlungen kombinieren?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Ja, viele Behandlungen können sinnvoll kombiniert oder in einer Serie geplant werden. Aquafacial, ColdPlasma, Microneedling und Fruchtsäure Peeling werden je nach Hautzustand, Verträglichkeit und Ziel abgestimmt. Teresa empfiehlt Ihnen nur Kombinationen, die für Ihr Hautbild nachvollziehbar sind."
            }
        },
        {
            "@type": "Question",
            "name": "Sind die Behandlungen für empfindliche Haut geeignet?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Viele Behandlungen lassen sich an empfindliche Haut anpassen. Welche Behandlung sinnvoll ist, hängt von Hautzustand, Empfindlichkeit und möglichen Unverträglichkeiten ab. Diese Punkte bespricht Teresa vor dem Termin persönlich mit Ihnen."
            }
        },
        {
            "@type": "Question",
            "name": "Wo befindet sich Beauty Face Lift?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Unser Studio befindet sich an der Bahnhofstrasse 94, 8001 Zürich — im Herzen der Stadt, nur wenige Schritte vom Paradeplatz entfernt. Die zentrale Lage ist hervorragend mit öffentlichen Verkehrsmitteln erreichbar: Die Tram-Haltestellen Paradeplatz und Börsenstrasse liegen in unmittelbarer Nähe. Auch mit dem Auto ist das Studio gut zugänglich, mit mehreren Parkhäusern in der Umgebung. Wir freuen uns auf Ihren Besuch in unserer Beauty Oase an Zürichs bekanntester Einkaufsstrasse."
            }
        }
    ]
};
---

<Base
    title="Beauty Face Lift Zürich | Premium Kosmetik an der Bahnhofstrasse"
    description="Premium Kosmetik in Zürich an der Bahnhofstrasse: Gesichtsbehandlung, Aquafacial, Microneedling, Laser-Haarentfernung und persönliche Beratung bei Beauty Face Lift."
    preloadImage={{
        href: homepageHeroPreload.src,
        imagesrcset: homepageHeroPreload.srcSet.attribute,
        imagesizes: heroMainSizes,
        type: 'image/webp',
        fetchpriority: 'high',
    }}
    structuredData={structuredData}
>
    <!-- Hero — Conversion-optimized -->
    <header class="hero-editorial">
        <div class="hero-content">
            <div class="hero-sub-display sub-display text-reveal-wrapper">
                <span class="text-reveal">Premium Kosmetik ·<br class="hero-sub-mobile-break"> Bahnhofstrasse Zürich</span>
            </div>

            <h1 class="hero-display text-reveal-wrapper">
                <span class="display-text text-reveal">Premium Kosmetik in Zürich für gepflegte, natürlich strahlende Haut</span>
            </h1>

            <p class="hero-body">Professionelle kosmetische Behandlungen an der Bahnhofstrasse 94 — persönlich abgestimmt von Teresa Stimac, Kosmetikerin mit über 20 Jahren Erfahrung.</p>

            <ul class="hero-trust-list" aria-label="Vertrauenssignale">
                <li>Bahnhofstrasse 94, Zürich</li>
                <li>4.8/5 Treatwell Bewertung</li>
                <li>Persönliche Beratung</li>
            </ul>

            <div class="hero-ctas">
                <a href="/termin/" class="pill-btn hero-cta">Jetzt Termin buchen</a>
                <a href="/behandlungen/" class="pill-btn pill-btn-ghost hero-cta-secondary">Behandlungen entdecken</a>
            </div>
        </div>

        <div class="hero-media" id="hero-media">
            <div class="hero-media-main">
                <Image
                    src={carbonTreatmentTeresa}
                    widths={[480, 720, 960, 1122]}
                    sizes={heroMainSizes}
                    format="webp"
                    quality="high"
                    priority
                    class="hero-img-inner"
                    id="hero-img-1"
                    alt="Teresa Stimac bei einer Carbon Peeling Behandlung im Studio an der Bahnhofstrasse Zürich"
                />
            </div>
            <div class="hero-media-overlap" id="hero-float-1">
                <Image
                    src={heroRight}
                    widths={[320, 480, 640]}
                    sizes={heroSecondarySizes}
                    format="webp"
                    quality="mid"
                    loading="lazy"
                    fetchpriority="low"
                    id="hero-img-2"
                    alt="Professionelle Gesichtsbehandlung bei Beauty Face Lift Zürich"
                />
            </div>
            <div class="hero-media-overlap-bottom" id="hero-float-2">
                <Image
                    src={heroCenter}
                    widths={[320, 480, 640]}
                    sizes={heroSecondarySizes}
                    format="webp"
                    quality="mid"
                    loading="lazy"
                    fetchpriority="low"
                    id="hero-img-3"
                    alt="Frau mit natürlicher, strahlender Haut in einem warmen Premium Kosmetikstudio"
                />
            </div>
        </div>

        <div class="scroll-indicator" aria-hidden="true">
            <span class="scroll-indicator-line"></span>
            <span class="scroll-indicator-label">Scroll</span>
        </div>
    </header>

    <!-- Marquee -->
    <Marquee items={["Aquafacial", "Microneedling", "ColdPlasma", "Fruchtsäure Peeling", "Exosome Therapie"]} />

    <section class="container" style="padding-top: 56px; padding-bottom: 72px;">
        <span class="sub-display">Kosmetikstudio Zürich Bahnhofstrasse</span>
        <h2 style="font-size: clamp(2rem, 4vw, 3.6rem); margin: 1rem 0; text-transform: none;">Kosmetik in Zürich für Haut, Schönheit und gepflegte Details</h2>
        <p style="max-width: 760px;">Beauty Face Lift ist auf hochwertige Gesichtsbehandlung Zürich spezialisiert und bietet darüber hinaus belegte Beauty-Leistungen wie Laser-Haarentfernung Zürich, Waxing Zürich, {'Wimpern & Brauen Zürich'}, Make-up Zürich und Massage Zürich Bahnhofstrasse. Hautbehandlungen bleiben der fachliche Schwerpunkt; ergänzende Leistungen werden diskret, sorgfältig und persönlich durch Teresa Stimac geplant.</p>

        <div class="highlights-grid highlights-grid--4col" style="margin-top: 2.5rem;">
            {SERVICE_GROUPS.map((group, index) => (
                <a href={group.href} class="highlight-item scroll-anim" style="text-decoration: none; color: inherit;">
                    <div class="highlight-number">{String(index + 1).padStart(2, '0')}</div>
                    <h4>{group.label}</h4>
                    <p>{group.description}</p>
                </a>
            ))}
        </div>
    </section>

    <section id="hautziele" class="container home-goal-guide">
        <span class="sub-display">Hautziele</span>
        <h2>Welche Behandlung passt zu Ihrem Hautziel?</h2>
        <p>
            Starten Sie mit dem, was Sie verändern oder unterstützen möchten. Teresa klärt bei Bedarf persönlich, welche Behandlung zu Hauttyp, Verträglichkeit und Ziel passt.
        </p>

        <div class="highlights-grid highlights-grid--4col home-goal-grid">
            <a href="/behandlungen/aquafacial-zuerich/" class="highlight-item" style="text-decoration: none; color: inherit;">
                <div class="highlight-number">01</div>
                <h4>Glow & Feuchtigkeit</h4>
                <p>Aquafacial für Tiefenreinigung, sanftes Peeling und ein frischeres Hautgefühl.</p>
            </a>
            <a href="/behandlungen/microneedling-zuerich/" class="highlight-item" style="text-decoration: none; color: inherit;">
                <div class="highlight-number">02</div>
                <h4>Struktur & feine Linien</h4>
                <p>Microneedling kann die natürliche Hauterneuerung unterstützen und das Hautbild verfeinern.</p>
            </a>
            <a href="/behandlungen/fruchtsaeure-peeling-zuerich/" class="highlight-item" style="text-decoration: none; color: inherit;">
                <div class="highlight-number">03</div>
                <h4>Unreinheiten & Teint</h4>
                <p>Fruchtsäure Peeling kann bei unebenem Teint, Poren und Unreinheiten kosmetisch unterstützen.</p>
            </a>
            <a href="/kontakt/#kontaktformular" class="highlight-item home-goal-card-accent" style="text-decoration: none; color: inherit;">
                <div class="highlight-number">04</div>
                <h4>Noch unsicher?</h4>
                <p>Beschreiben Sie Ihr Hautziel kurz und fragen Sie Teresa nach einer persönlichen Empfehlung.</p>
            </a>
        </div>
    </section>

    <!-- Services -->
    <section id="expertise" class="services-section">
        <div class="services-wrapper">
            <!-- Left Sticky -->
            <div class="services-sticky">
                <span class="sub-display">Behandlungen</span>
                <h2>Unsere<br>Expertise</h2>
                <p>Kosmetisch-ästhetische Gesichtsbehandlungen mit modernster Technologie. Persönliche Beratung und individuelle Behandlungspläne für jedes Hautbild — direkt an der Bahnhofstrasse Zürich.</p>
                <a href="/behandlungen/" class="pill-btn pill-btn-outline">Alle Behandlungen</a>
            </div>

            <!-- Right Scrolling -->
            <div class="services-list">
                <div class="service-card">
                    <span class="number-accent">01</span>
                    <h3>Aquafacial</h3>
                    <div class="service-image-mask service-image-tall">
                        <Image
                            src={aquafacialCard}
                            widths={[360, 540, 720, 960]}
                            sizes={cardSizes}
                            format="webp"
                            quality="high"
                            alt="Aquafacial Behandlung Zürich — Tiefenreinigung und Glow"
                            class="anim-img"
                            loading="lazy"
                        />
                    </div>
                    <p>Aquafacial kombiniert Tiefenreinigung, sanftes Peeling und intensive Feuchtigkeitspflege in einer meist gut verträglichen Behandlung. Ideal, wenn die Haut frischer, gepflegter und hydratisierter wirken soll.</p>
                    <a href="/behandlungen/aquafacial-zuerich/" class="pill-btn pill-btn-outline pill-btn-sm">Aquafacial entdecken</a>
                </div>

                <div class="service-card">
                    <span class="number-accent">02</span>
                    <h3>Microneedling</h3>
                    <div class="service-image-mask service-image-tall">
                        <Image
                            src={microneedlingCard}
                            widths={[360, 540, 720, 960]}
                            sizes={cardSizes}
                            format="webp"
                            quality="high"
                            alt="Microneedling Zürich — Hautstruktur und kosmetische Anti-Aging-Pflege"
                            class="anim-img"
                            loading="lazy"
                        />
                    </div>
                    <p>Kosmetische Anti-Aging-Pflege für anspruchsvolle Haut. Microneedling kann die natürliche Hauterneuerung und Kollagenbildung unterstützen — für ein sichtbar verfeinertes Hautbild, verfeinerte Poren und feinere Linien.</p>
                    <a href="/behandlungen/microneedling-zuerich/" class="pill-btn pill-btn-outline pill-btn-sm">Microneedling entdecken</a>
                </div>

                <div class="service-card">
                    <span class="number-accent">03</span>
                    <h3>Fruchtsäure Peeling</h3>
                    <div class="service-image-mask service-image-tall">
                        <Image
                            src={peelingCard}
                            widths={[360, 540, 720, 960]}
                            sizes={cardSizes}
                            format="webp"
                            quality="high"
                            alt="Fruchtsäure Peeling Zürich — Chemisches Peeling für reine Haut"
                            class="anim-img"
                            loading="lazy"
                        />
                    </div>
                    <p>Professionelles AHA-Peeling für ein ebenmässiger wirkendes Hautbild. Fruchtsäuren lösen abgestorbene Hautzellen und können Unreinheiten, Poren und Pigmentunregelmässigkeiten kosmetisch unterstützen.</p>
                    <a href="/behandlungen/fruchtsaeure-peeling-zuerich/" class="pill-btn pill-btn-outline pill-btn-sm">Peeling entdecken</a>
                </div>

                <div class="service-card">
                    <span class="number-accent">04</span>
                    <h3>ColdPlasma</h3>
                    <div class="service-image-mask service-image-tall">
                        <Image
                            src={coldplasmaCard}
                            widths={[360, 540, 720, 960]}
                            sizes={cardSizes}
                            format="webp"
                            quality="high"
                            alt="ColdPlasma Behandlung Zürich — Innovative Hautregeneration"
                            class="anim-img"
                            loading="lazy"
                        />
                    </div>
                    <p>Die Innovation der Hautpflege. ColdPlasma-Technologie kann die professionelle Wirkstoffpflege unterstützen und steigert die Wirkstoffaufnahme je nach Hautzustand.</p>
                    <a href="/behandlungen/coldplasma-zuerich/" class="pill-btn pill-btn-outline pill-btn-sm">ColdPlasma entdecken</a>
                </div>

                <div class="service-card">
                    <span class="number-accent">05</span>
                    <h3>Exosome Therapie</h3>
                    <div class="service-image-mask service-image-tall">
                        <Image
                            src={spaProducts}
                            widths={[360, 540, 720, 960]}
                            sizes={cardSizes}
                            format="webp"
                            quality="high"
                            alt="Exosome Therapie Zürich — regeneratives Serum und Hyaluronsäure"
                            class="anim-img"
                            loading="lazy"
                        />
                    </div>
                    <p>Regenerative Kosmetik mit Exosomen Serum beziehungsweise exosomenähnlicher Wirkstofftechnologie. Für Feuchtigkeit, Hautbarriere, Glow und ein ruhigeres Hautbild — mit ehrlicher Beratung und realistischen Erwartungen.</p>
                    <a href="/behandlungen/exosome-therapie-zuerich/" class="pill-btn pill-btn-outline pill-btn-sm">Exosome Therapie entdecken</a>
                </div>
            </div>
        </div>
    </section>

    <div class="section-divider"></div>

    <!-- About -->
    <section id="about" class="about-editorial pad-y">
        <div class="split-layout align-center">
            <div class="about-image scroll-anim">
                <div class="about-portrait">
                    <Image
                        src={teresaPortrait}
                        widths={[360, 540, 720]}
                        sizes={portraitSizes}
                        format="webp"
                        quality="high"
                        alt="Teresa Stimac, Gründerin von Beauty Face Lift Zürich"
                        class="anim-img"
                        loading="lazy"
                    />
                </div>
            </div>
            <div class="about-text">
                <span class="sub-display">Über Teresa</span>
                <blockquote class="about-quote">
                    <p>"Die Haut ist 90% von<br>deinem Selfie."</p>
                </blockquote>
                <p>Im Zentrum der Stadt Zürich an der berühmten Bahnhofstrasse befindet sich unsere Beauty Oase. Geleitet von Teresa Stimac — seit über 20 Jahren selbstständige Kosmetikerin in Zürich mit einer treuen Stammkundschaft, die sich auf ihre Erfahrung und Expertise verlässt.</p>
                <a href="/ueber-mich/" class="pill-btn pill-btn-outline">Teresa kennenlernen</a>
            </div>
        </div>
    </section>

    <div class="section-divider"></div>

    <section class="container home-process-section">
        <span class="sub-display">Ablauf</span>
        <h2>Ruhig geplant, persönlich begleitet</h2>
        <div class="process-grid">
            <div class="process-step">
                <div class="highlight-number">01</div>
                <h4>Hautziel klären</h4>
                <p>Sie nennen Ihr Ziel, Teresa prüft Hautzustand, Empfindlichkeit und passende Behandlung.</p>
            </div>
            <div class="process-step">
                <div class="highlight-number">02</div>
                <h4>Behandlung abstimmen</h4>
                <p>Intensität, Wirkstoffe und Ablauf werden individuell und realistisch auf Sie abgestimmt.</p>
            </div>
            <div class="process-step">
                <div class="highlight-number">03</div>
                <h4>Nachpflege einordnen</h4>
                <p>Sie erhalten klare Hinweise, was direkt nach dem Termin sinnvoll ist und wann die nächste Behandlung passt.</p>
            </div>
        </div>
    </section>

    <div class="section-divider"></div>

    <section class="container home-location-section">
        <div>
            <span class="sub-display">Zürich</span>
            <h2>Beauty Face Lift an der Bahnhofstrasse 94</h2>
            <p>
                Das Studio liegt zentral in Zürich, wenige Minuten vom Paradeplatz entfernt. Die Lage eignet sich für geplante Hautbehandlungen, kurze Beauty-Termine und eine persönliche Beratung mitten in der Stadt.
            </p>
        </div>
        <div class="home-location-card">
            <h3>Zentrale Lage</h3>
            <p>Bahnhofstrasse 94, 8001 Zürich</p>
            <a href="/kontakt/" class="pill-btn pill-btn-outline">Kontakt & Anfahrt</a>
        </div>
    </section>

    <div class="section-divider"></div>

    <!-- Testimonials -->
    <section class="testimonials-section">
        <div class="testimonials-label">Kundenstimmen</div>
        <div class="testimonials-grid">
            <div class="testimonial-card">
                <span class="testimonial-stars">★ ★ ★ ★ ★</span>
                <p class="testimonial-quote">"Wie immer eine wunderbare Verwöhnzeit!"</p>
                <span class="testimonial-author">Emina — Aquafacial · verifizierte Bewertung</span>
            </div>
            <div class="testimonial-card">
                <span class="testimonial-stars">★ ★ ★ ★ ★</span>
                <p class="testimonial-quote">"Stammkunde seit 2008 — immer wieder begeistert."</p>
                <span class="testimonial-author">Daniel — Stammkunde · verifizierte Bewertung</span>
            </div>
            <div class="testimonial-card">
                <span class="testimonial-stars">★ ★ ★ ★ ★</span>
                <p class="testimonial-quote">"Teresa ist charmant, warm und absolut professionell."</p>
                <span class="testimonial-author">Andreas — Gesichtsbehandlung · verifizierte Bewertung</span>
            </div>
        </div>
    </section>

    <!-- Rating Line -->
    <div class="rating-line">
        <p style="text-align: center; margin: 0 auto; font-size: var(--text-xs); color: var(--text-muted); letter-spacing: 0.03em;">4.8 von 5 Sternen aus 248+ verifizierten Bewertungen</p>
    </div>

    <!-- Trust Strip -->
    <div class="trust-strip" aria-label="Vertrauensindikatoren">
        <span class="trust-strip-item">Bahnhofstrasse Zürich</span>
        <span class="trust-strip-item">248+ verifizierte Bewertungen</span>
        <span class="trust-strip-item">20+ Jahre Erfahrung</span>
        <span class="trust-strip-item">Persönliche Betreuung</span>
    </div>

    <div class="section-divider"></div>

    <!-- FAQ Section -->
    <section class="faq-section">
        <div class="faq-label">Häufig gestellte Fragen</div>
        <div class="faq-list">
            <details class="faq-item">
                <summary>Was ist ein Kosmetikinstitut?</summary>
                <p>Ein Kosmetikinstitut verbindet professionelle kosmetische Behandlungen mit einer ruhigen, persönlichen Studio-Erfahrung. Bei Beauty Face Lift in Zürich bieten wir Behandlungen wie Aquafacial, Microneedling, Fruchtsäure Peeling, ColdPlasma und Exosome Therapie an — ohne chirurgische Eingriffe und mit persönlicher Beratung.</p>
            </details>
            <details class="faq-item">
                <summary>Welche Behandlung passt zu mir?</summary>
                <p>Die passende Behandlung hängt von Hauttyp, Ziel und Verträglichkeit ab. Aquafacial eignet sich für Glow und Feuchtigkeit, Microneedling kann Hautstruktur und feine Linien unterstützen, Fruchtsäure Peeling kann bei Unreinheiten und unebenem Teint sinnvoll sein. Teresa berät Sie persönlich und empfiehlt einen realistischen nächsten Schritt.</p>
            </details>
            <details class="faq-item">
                <summary>Brauche ich eine Beratung vor der ersten Behandlung?</summary>
                <p>Eine kurze persönliche Beratung ist fester Bestandteil jeder Erstbehandlung bei Beauty Face Lift. Teresa nimmt sich Zeit, Hauttyp, Empfindlichkeiten und Ziel zu besprechen, damit die Behandlung passend und realistisch geplant wird.</p>
            </details>
            <details class="faq-item">
                <summary>Kann ich mehrere Behandlungen kombinieren?</summary>
                <p>Ja, viele Behandlungen können sinnvoll kombiniert oder in einer Serie geplant werden. Aquafacial, ColdPlasma, Microneedling und Fruchtsäure Peeling werden je nach Hautzustand, Verträglichkeit und Ziel abgestimmt. Teresa empfiehlt Ihnen nur Kombinationen, die für Ihr Hautbild nachvollziehbar sind.</p>
            </details>
            <details class="faq-item">
                <summary>Sind die Behandlungen für empfindliche Haut geeignet?</summary>
