---

import Base from '../layouts/Base.astro';
import Marquee from '../components/Marquee.astro';

const structuredData = {
    "@context": "https://schema.org",
    "@type": "HealthAndBeautyBusiness",
    "name": "Beauty Face Lift",
    "image": "https://beautyfacelift.ch/assets/spa_interior.png",
    "@id": "https://beautyfacelift.ch",
    "url": "https://beautyfacelift.ch",
    "telephone": "+41792143462",
    "email": "info@beautyfacelift.ch",
    "address": {
        "@type": "PostalAddress",
        "streetAddress": "Bahnhofstrasse 94",
        "addressLocality": "Zürich",
        "postalCode": "8001",
        "addressCountry": "CH"
    },
    "geo": {
        "@type": "GeoCoordinates",
        "latitude": 47.3753,
        "longitude": 8.5385
    },
    "priceRange": "$$$$",
    "openingHoursSpecification": [
        { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "09:00", "closes": "18:00" },
        { "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "10:00", "closes": "16:00" }
    ],
    "sameAs": [
        "https://www.instagram.com/beautyfacelift.zh/",
        "https://www.treatwell.ch/ort/beauty-face-lift/"
    ],
    "potentialAction": {
        "@type": "ReserveAction",
        "target": "https://beautyfacelift.ch/termin/",
        "result": { "@type": "Reservation", "name": "Termin buchen" }
    },
    "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+41792143462",
        "email": "info@beautyfacelift.ch",
        "contactType": "customer service",
        "areaServed": "CH",
        "availableLanguage": ["de", "en"]
    },
    "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Gesichtsbehandlungen",
        "itemListElement": [
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Hydrafacial", "url": "https://beautyfacelift.ch/behandlungen/hydrafacial-zuerich/" } },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Microneedling", "url": "https://beautyfacelift.ch/behandlungen/microneedling-zuerich/" } },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Fruchtsäure Peeling", "url": "https://beautyfacelift.ch/behandlungen/fruchtsaeure-peeling-zuerich/" } },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "ColdPlasma", "url": "https://beautyfacelift.ch/behandlungen/coldplasma-zuerich/" } }
        ]
    },
    "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.8",
        "reviewCount": "240",
        "bestRating": "5"
    },
    "review": [
        {
            "@type": "Review",
            "author": { "@type": "Person", "name": "Emina" },
            "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
            "reviewBody": "Wie immer eine wunderbare Verwöhnzeit!"
        },
        {
            "@type": "Review",
            "author": { "@type": "Person", "name": "Daniel" },
            "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
            "reviewBody": "Stammkunde seit 2008 — absolut zuverlässig und professionell."
        }
    ]
};

const faqData = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
        {
            "@type": "Question",
            "name": "Was ist ein Medical Spa?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Ein Medical Spa vereint medizinisch-ästhetische Behandlungen mit der Entspannung eines hochwertigen Spa-Erlebnisses. Bei Beauty Face Lift in Zürich bieten wir nicht-invasive Behandlungen wie Hydrafacial, Microneedling, Fruchtsäure Peeling und ColdPlasma an. Anders als in einem klassischen Kosmetikstudio setzen wir auf professionelle Geräte und medizinisch geprüfte Wirkstoffe, die tiefgreifende und langanhaltende Ergebnisse erzielen — ganz ohne chirurgische Eingriffe."
            }
        },
        {
            "@type": "Question",
            "name": "Welche Behandlung passt zu mir?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Die ideale Behandlung hängt von Ihren individuellen Hautbedürfnissen ab. Hydrafacial eignet sich hervorragend für sofortigen Glow und intensive Feuchtigkeit. Microneedling ist die beste Wahl bei Anti-Aging, feinen Linien und Narben. Fruchtsäure Peeling empfehlen wir bei Unreinheiten, Akne und unebenmässiger Hauttextur. ColdPlasma fördert die Zellregeneration und strafft das Gewebe. Teresa berät Sie persönlich in einem kostenlosen Erstgespräch und erstellt einen massgeschneiderten Behandlungsplan für Ihre Haut."
            }
        },
        {
            "@type": "Question",
            "name": "Brauche ich eine Beratung vor der ersten Behandlung?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Eine kurze persönliche Beratung ist fester Bestandteil jeder Erstbehandlung bei Beauty Face Lift. Teresa nimmt sich Zeit, Ihren Hauttyp sorgfältig zu analysieren, eventuelle Empfindlichkeiten zu besprechen und die optimale Behandlung für Ihre individuellen Bedürfnisse zu empfehlen. Diese Beratung ist kostenlos und unverbindlich. So stellen wir sicher, dass Sie von Anfang an die bestmöglichen Ergebnisse erzielen und sich bei uns rundum wohlfühlen."
            }
        },
        {
            "@type": "Question",
            "name": "Kann ich mehrere Behandlungen kombinieren?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Ja, viele unserer Behandlungen ergänzen sich hervorragend und können für optimale Ergebnisse miteinander kombiniert werden. Besonders beliebt ist die Kombination aus Hydrafacial und ColdPlasma — die Tiefenreinigung des Hydrafacials bereitet die Haut ideal auf die regenerierende Wirkung des ColdPlasma vor. Auch Microneedling und Fruchtsäure Peeling lassen sich in einem abgestimmten Behandlungsplan integrieren. Teresa empfiehlt Ihnen die ideale Kombination basierend auf Ihrem Hautbild."
            }
        },
        {
            "@type": "Question",
            "name": "Sind die Behandlungen für empfindliche Haut geeignet?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Ja, alle unsere Behandlungen sind individuell auf Ihren Hauttyp anpassbar. Besonders Hydrafacial und ColdPlasma zeichnen sich durch ihre sanfte Wirkungsweise aus und sind hervorragend für empfindliche Haut geeignet. Die Intensität wird bei jeder Behandlung an Ihre persönliche Hautempfindlichkeit angepasst. Bei der Erstberatung bespricht Teresa allfällige Allergien oder Unverträglichkeiten mit Ihnen, damit wir die Behandlung perfekt auf Ihre Bedürfnisse abstimmen können."
            }
        },
        {
            "@type": "Question",
            "name": "Wo befindet sich Beauty Face Lift?",
            "acceptedAnswer": {
                "@type": "Answer",
                "text": "Unser Studio befindet sich an der Bahnhofstrasse 94, 8001 Zürich — im Herzen der Stadt, nur wenige Schritte vom Paradeplatz entfernt. Die zentrale Lage ist hervorragend mit öffentlichen Verkehrsmitteln erreichbar: Die Tram-Haltestellen Paradeplatz und Börsenstrasse liegen in unmittelbarer Nähe. Auch mit dem Auto ist das Studio gut zugänglich, mit mehreren Parkhäusern in der Umgebung. Wir freuen uns auf Ihren Besuch in unserer Beauty Oase an Zürichs bekanntester Einkaufsstrasse."
            }
        }
    ]
};
---

<Base
    title="Beauty Face Lift | Kosmetikstudio Zürich Bahnhofstrasse — Hydrafacial, Microneedling & Peeling"
    description="Beauty Face Lift ★ 4.8/5 — Premium Gesichtsbehandlungen an der Bahnhofstrasse Zürich: Hydrafacial ab CHF 190, Microneedling, Fruchtsäure Peeling & ColdPlasma. Jetzt online buchen."
    preloadImage="/assets/spa_interior.png"
    structuredData={structuredData}
>
    <!-- Hero — Conversion-optimized -->
    <header class="hero-editorial">
        <h1 class="sr-only">Gesichtsbehandlungen Zürich — Hydrafacial, Microneedling & Peeling an der Bahnhofstrasse</h1>

        <div class="hero-sub-display sub-display text-reveal-wrapper">
            <span class="text-reveal">Premium Kosmetikstudio  ·  Bahnhofstrasse Zürich</span>
        </div>

        <div class="hero-display-beauty text-reveal-wrapper" aria-hidden="true">
            <span class="display-text text-reveal">Dein Weg zu</span>
        </div>
        <div class="hero-display-facelift text-reveal-wrapper" aria-hidden="true">
            <span class="display-text text-reveal" style="font-style: italic;">natürlicher Schönheit</span>
        </div>

        <p class="hero-body">Professionelle Gesichtsbehandlungen für strahlende Haut — Hydrafacial, Microneedling, Peeling & ColdPlasma. Persönliche Beratung durch Teresa Stimac, seit 20 Jahren an der Bahnhofstrasse.</p>

        <a href="/termin/" class="pill-btn hero-cta">Jetzt Termin buchen</a>

        <!-- Growing Media Container via GSAP -->
        <div class="hero-media-container" id="hero-media">
            <img src="/assets/hero_center.png" width="1200" height="800" class="hero-img-inner" id="hero-img-1" alt="Beauty Face Lift Kosmetikstudio Zürich Bahnhofstrasse — Premium Gesichtsbehandlungen">
        </div>

        <!-- Floating accent image — overlaps background image -->
        <div class="hero-floating-image" id="hero-float-1">
            <img src="/assets/hero_right.png" width="600" height="800" id="hero-img-2" alt="Professionelle Gesichtsbehandlung bei Beauty Face Lift Zürich">
        </div>

        <div class="scroll-indicator" aria-hidden="true">
            <span class="scroll-indicator-line"></span>
            <span class="scroll-indicator-label">Scroll</span>
        </div>
    </header>

    <!-- Marquee -->
    <Marquee items={["Hydrafacial", "Microneedling", "ColdPlasma", "Fruchtsäure Peeling"]} />

    <!-- Services -->
    <section id="expertise" class="services-section">
        <div class="services-wrapper">
            <!-- Left Sticky -->
            <div class="services-sticky">
                <span class="sub-display">Behandlungen</span>
                <h2>Unsere<br>Expertise</h2>
                <p>Medizinisch-ästhetische Gesichtsbehandlungen mit modernster Technologie. Persönliche Beratung und individuelle Behandlungspläne für jedes Hautbild — direkt an der Bahnhofstrasse Zürich.</p>
                <a href="/behandlungen/" class="pill-btn pill-btn-outline">Alle Behandlungen</a>
            </div>

            <!-- Right Scrolling -->
            <div class="services-list">
                <div class="service-card">
                    <span class="number-accent">01</span>
                    <h3>Hydrafacial</h3>
                    <div class="service-image-mask service-image-tall">
                        <img src="/assets/hydrafacial_treatment.png" width="600" height="500" alt="Hydrafacial Behandlung Zürich — Tiefenreinigung und Glow" class="anim-img" loading="lazy">
                    </div>
                    <p>Die beliebteste Gesichtsbehandlung der Welt — jetzt an der Bahnhofstrasse Zürich. Hydrafacial kombiniert Tiefenreinigung, sanftes Peeling und intensive Feuchtigkeitspflege in einer schmerzfreien 60-Minuten-Behandlung. Sofort sichtbarer Glow, keine Ausfallzeit.</p>
                    <a href="/behandlungen/hydrafacial-zuerich/" class="pill-btn pill-btn-outline pill-btn-sm">Hydrafacial entdecken</a>
                </div>

                <div class="service-card">
                    <span class="number-accent">02</span>
                    <h3>Microneedling</h3>
                    <div class="service-image-mask service-image-tall">
                        <img src="/assets/microneedling_treatment.png" width="600" height="500" alt="Microneedling Zürich — Anti-Aging und Kollagenbooster" class="anim-img" loading="lazy">
                    </div>
                    <p>Der natürliche Anti-Aging-Booster für anspruchsvolle Haut. Microneedling stimuliert die körpereigene Kollagenproduktion und regt die Zellerneuerung an — für sichtbar straffere Haut, verfeinerte Poren und weniger Falten.</p>
                    <a href="/behandlungen/microneedling-zuerich/" class="pill-btn pill-btn-outline pill-btn-sm">Microneedling entdecken</a>
                </div>

                <div class="service-card">
                    <span class="number-accent">03</span>
                    <h3>Fruchtsäure Peeling</h3>
                    <div class="service-image-mask service-image-tall">
                        <img src="/assets/peeling_treatment_new.png" width="600" height="500" alt="Fruchtsäure Peeling Zürich — Chemisches Peeling für reine Haut" class="anim-img" loading="lazy">
                    </div>
                    <p>Das professionelle chemische Peeling für einen ebenmässigen, strahlenden Teint. AHA-Fruchtsäuren lösen abgestorbene Hautzellen und mildern Unreinheiten, Akne und Hyperpigmentierung.</p>
                    <a href="/behandlungen/fruchtsaeure-peeling-zuerich/" class="pill-btn pill-btn-outline pill-btn-sm">Peeling entdecken</a>
                </div>

                <div class="service-card">
                    <span class="number-accent">04</span>
                    <h3>ColdPlasma</h3>
                    <div class="service-image-mask service-image-tall">
                        <img src="/assets/coldplasma_treatment.png" width="600" height="500" alt="ColdPlasma Behandlung Zürich — Innovative Hautregeneration" class="anim-img" loading="lazy">
                    </div>
                    <p>Die Innovation der Hautpflege. ColdPlasma-Technologie aktiviert die Zellregeneration auf molekularer Ebene und steigert die Wirkstoffaufnahme um bis zu 300%.</p>
                    <a href="/behandlungen/coldplasma-zuerich/" class="pill-btn pill-btn-outline pill-btn-sm">ColdPlasma entdecken</a>
                </div>
            </div>
        </div>
    </section>

    <div class="section-divider"></div>

    <!-- About -->
    <section id="about" class="about-editorial pad-y container">
        <div class="split-layout align-center">
            <div class="about-image scroll-anim">
                <div class="about-portrait">
                    <img src="/assets/teresa_portrait.jpg" width="540" height="650" alt="Teresa Stimac — Gründerin und Kosmetikerin Beauty Face Lift Zürich" class="anim-img" loading="lazy">
                </div>
            </div>
            <div class="about-text">
                <span class="sub-display">Über Teresa</span>
                <blockquote class="about-quote">
                    <p>"Die Haut ist 90% von<br>deinem Selfie."</p>
                </blockquote>
                <p>Im Zentrum der Stadt Zürich an der berühmten Bahnhofstrasse befindet sich unsere Beauty Oase. Geleitet von Teresa Stimac — seit über 20 Jahren selbstständige Kosmetikerin in Zürich mit einer treuen Stammkundschaft, die sich auf ihre Erfahrung und Expertise verlässt.</p>
                <a href="/ueber-uns/" class="pill-btn pill-btn-outline">Teresa Kennenlernen</a>
            </div>
        </div>
    </section>

    <div class="section-divider"></div>

    <!-- Testimonials -->
    <section class="testimonials-section">
        <div class="testimonials-label">Kundenstimmen</div>
        <div class="testimonials-grid">
            <div class="testimonial-card">
                <span class="testimonial-stars">★ ★ ★ ★ ★</span>
                <p class="testimonial-quote">"Wie immer eine wunderbare Verwöhnzeit!"</p>
                <span class="testimonial-author">Emina — Hydrafacial · Treatwell verifiziert</span>
            </div>
            <div class="testimonial-card">
                <span class="testimonial-stars">★ ★ ★ ★ ★</span>
                <p class="testimonial-quote">"Stammkunde seit 2008 — immer wieder begeistert."</p>
                <span class="testimonial-author">Daniel — Stammkunde · Treatwell verifiziert</span>
            </div>
            <div class="testimonial-card">
                <span class="testimonial-stars">★ ★ ★ ★ ★</span>
                <p class="testimonial-quote">"Teresa ist charmant, warm und absolut professionell."</p>
                <span class="testimonial-author">Andreas — Gesichtsbehandlung · Treatwell verifiziert</span>
            </div>
        </div>
    </section>

    <!-- Rating Line -->
    <div class="rating-line">
        <p style="text-align: center; margin: 0 auto; font-size: 12px; color: var(--text-muted); letter-spacing: 0.03em;">4.8 von 5 Sternen auf <a href="https://www.treatwell.ch/ort/beauty-face-lift/" target="_blank" rel="noopener" style="color: var(--text-primary); font-weight: 400;">Treatwell</a> · 240+ Bewertungen</p>
    </div>

    <!-- Trust Strip -->
    <div class="trust-strip" aria-label="Vertrauensindikatoren">
        <span class="trust-strip-item">Bahnhofstrasse Zürich</span>
        <span class="trust-strip-item">4.8 auf Treatwell</span>
        <span class="trust-strip-item">20+ Jahre Erfahrung</span>
        <span class="trust-strip-item">Persönliche Betreuung</span>
    </div>

    <div class="section-divider"></div>

    <!-- FAQ Section -->
    <section class="faq-section">
        <div class="faq-label">Häufig gestellte Fragen</div>
        <div class="faq-list">
            <details class="faq-item">
                <summary>Was ist ein Medical Spa?</summary>
                <p>Ein Medical Spa vereint medizinisch-ästhetische Behandlungen mit der Entspannung eines hochwertigen Spa-Erlebnisses. Bei Beauty Face Lift in Zürich bieten wir nicht-invasive Behandlungen wie Hydrafacial, Microneedling, Fruchtsäure Peeling und ColdPlasma an. Anders als in einem klassischen Kosmetikstudio setzen wir auf professionelle Geräte und medizinisch geprüfte Wirkstoffe, die tiefgreifende und langanhaltende Ergebnisse erzielen — ganz ohne chirurgische Eingriffe.</p>
            </details>
            <details class="faq-item">
                <summary>Welche Behandlung passt zu mir?</summary>
                <p>Die ideale Behandlung hängt von Ihren individuellen Hautbedürfnissen ab. Hydrafacial eignet sich hervorragend für sofortigen Glow und intensive Feuchtigkeit. Microneedling ist die beste Wahl bei Anti-Aging, feinen Linien und Narben. Fruchtsäure Peeling empfehlen wir bei Unreinheiten, Akne und unebenmässiger Hauttextur. ColdPlasma fördert die Zellregeneration und strafft das Gewebe. Teresa berät Sie persönlich in einem kostenlosen Erstgespräch und erstellt einen massgeschneiderten Behandlungsplan für Ihre Haut.</p>
            </details>
            <details class="faq-item">
                <summary>Brauche ich eine Beratung vor der ersten Behandlung?</summary>
                <p>Eine kurze persönliche Beratung ist fester Bestandteil jeder Erstbehandlung bei Beauty Face Lift. Teresa nimmt sich Zeit, Ihren Hauttyp sorgfältig zu analysieren, eventuelle Empfindlichkeiten zu besprechen und die optimale Behandlung für Ihre individuellen Bedürfnisse zu empfehlen. Diese Beratung ist kostenlos und unverbindlich. So stellen wir sicher, dass Sie von Anfang an die bestmöglichen Ergebnisse erzielen und sich bei uns rundum wohlfühlen.</p>
            </details>
            <details class="faq-item">
                <summary>Kann ich mehrere Behandlungen kombinieren?</summary>
                <p>Ja, viele unserer Behandlungen ergänzen sich hervorragend und können für optimale Ergebnisse miteinander kombiniert werden. Besonders beliebt ist die Kombination aus Hydrafacial und ColdPlasma — die Tiefenreinigung des Hydrafacials bereitet die Haut ideal auf die regenerierende Wirkung des ColdPlasma vor. Auch Microneedling und Fruchtsäure Peeling lassen sich in einem abgestimmten Behandlungsplan integrieren. Teresa empfiehlt Ihnen die ideale Kombination basierend auf Ihrem Hautbild.</p>
            </details>
            <details class="faq-item">
                <summary>Sind die Behandlungen für empfindliche Haut geeignet?</summary>
                <p>Ja, alle unsere Behandlungen sind individuell auf Ihren Hauttyp anpassbar. Besonders Hydrafacial und ColdPlasma zeichnen sich durch ihre sanfte Wirkungsweise aus und sind hervorragend für empfindliche Haut geeignet. Die Intensität wird bei jeder Behandlung an Ihre persönliche Hautempfindlichkeit angepasst. Bei der Erstberatung bespricht Teresa allfällige Allergien oder Unverträglichkeiten mit Ihnen, damit wir die Behandlung perfekt auf Ihre Bedürfnisse abstimmen können.</p>
            </details>
            <details class="faq-item">
                <summary>Wo befindet sich Beauty Face Lift?</summary>
                <p>Unser Studio befindet sich an der Bahnhofstrasse 94, 8001 Zürich — im Herzen der Stadt, nur wenige Schritte vom Paradeplatz entfernt. Die zentrale Lage ist hervorragend mit öffentlichen Verkehrsmitteln erreichbar: Die Tram-Haltestellen Paradeplatz und Börsenstrasse liegen in unmittelbarer Nähe. Auch mit dem Auto ist das Studio gut zugänglich, mit mehreren Parkhäusern in der Umgebung. Wir freuen uns auf Ihren Besuch in unserer Beauty Oase an Zürichs bekanntester Einkaufsstrasse.</p>
            </details>
        </div>
        <script type="application/ld+json" set:html={JSON.stringify(faqData)} />
    </section>
</Base>
