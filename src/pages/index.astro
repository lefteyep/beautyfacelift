---
import { absoluteUrl, CONTACT_WHATSAPP_URL, SERVICE_GROUPS, TREATWELL_URL } from '../../shared/site';
import Base from '../layouts/Base.astro';
import { Image, getImage } from 'astro:assets';
import {
    carbonTreatmentTeresa,
    coldplasmaCard,
    aquafacialCard,
    microneedlingCard,
    peelingCard,
    spaProducts,
} from '../lib/site-images';
import teresaWithClient from '../assets/lp/aquafacial/aquafacial-behandlung-zuerich.webp';
import glowPortrait from '../assets/lp/aquafacial/post-treatment-glow-zuerich.webp';
import consultation from '../assets/lp/aquafacial/hautanalyse-beratung-zuerich.webp';
import zurichView from '../assets/lp/aquafacial/personal-treatment-zuerich.webp';
import { JOURNAL_POSTS } from './blog/_posts';

const heroSizes = '(min-width: 1280px) 520px, (min-width: 901px) 40vw, 82vw';

const homepageHeroPreload = await getImage({
    src: teresaWithClient,
    widths: [420, 640, 860, 1100],
    sizes: heroSizes,
    format: 'webp',
    quality: 'high',
});

const signatureTreatments = [
    { href: '/behandlungen/aquafacial-zuerich/', name: 'Aquafacial', text: 'Tiefenreinigung, sanftes Peeling und intensive Feuchtigkeit.', meta: 'ab CHF 180', image: aquafacialCard, alt: 'Aquafacial Behandlung mit Handstück an der Wange' },
    { href: '/behandlungen/microneedling-zuerich/', name: 'Microneedling', text: 'Für Hautstruktur, Poren und ein verfeinertes Hautbild.', meta: 'ab CHF 210', image: microneedlingCard, alt: 'Microneedling Behandlung im Gesicht' },
    { href: '/behandlungen/fruchtsaeure-peeling-zuerich/', name: 'Fruchtsäure Peeling', text: 'Für einen klaren, ebenmässigen Teint.', meta: 'CHF 150', image: peelingCard, alt: 'Fruchtsäure Peeling wird mit dem Pinsel aufgetragen' },
    { href: '/behandlungen/coldplasma-zuerich/', name: 'ColdPlasma', text: 'Plasma-Technologie als Unterstützung der Wirkstoffpflege.', meta: 'ab CHF 180', image: coldplasmaCard, alt: 'ColdPlasma Handstück an der Schläfe' },
    { href: '/behandlungen/exosome-therapie-zuerich/', name: 'Exosome Therapie', text: 'Regenerative Wirkstoffpflege für Feuchtigkeit und Glow.', meta: '', image: spaProducts, alt: 'Serumflaschen mit Pipette auf hellem Stein' },
];

const marqueeWords = ['Aquafacial', 'Microneedling', 'Fruchtsäure Peeling', 'ColdPlasma', 'Exosome Therapie', 'Laser-Haarentfernung', 'Waxing', 'Wimpern & Brauen', 'Make-up', 'Massage'];

// Exact-match anchor text for each service hub (internal-linking plan, checked by scripts/seo-plan-smoke.mjs).
const hubAnchors: Record<string, string> = {
    '/behandlungen/gesichtsbehandlung-zuerich/': 'Gesichtsbehandlung Zürich',
    '/behandlungen/laser-haarentfernung-zuerich/': 'Laser-Haarentfernung Zürich',
    '/behandlungen/waxing-zuerich/': 'Waxing Zürich',
    '/behandlungen/wimpern-brauen-zuerich/': 'Wimpern & Brauen Zürich',
    '/behandlungen/make-up-zuerich/': 'Make-up Zürich',
    '/behandlungen/massage-zuerich-bahnhofstrasse/': 'Massage Zürich Bahnhofstrasse',
};

const priceList = [
    { name: 'Gesichtsbehandlungen', price: 'ab CHF 150' },
    { name: 'Aquafacial', price: 'ab CHF 180' },
    { name: 'Microneedling', price: 'ab CHF 210' },
    { name: 'Fruchtsäure Peeling', price: 'CHF 150' },
    { name: 'ColdPlasma', price: 'ab CHF 180' },
    { name: 'Weitere Beauty-Leistungen', price: 'ab CHF 20' },
];

const reviews = [
    { quote: 'Wie immer eine wunderbare Verwöhnzeit!', author: 'Emina', detail: 'Aquafacial' },
    { quote: 'Stammkunde seit 2008, immer wieder begeistert.', author: 'Daniel', detail: 'Stammkunde' },
    { quote: 'Teresa ist charmant, warm und absolut professionell.', author: 'Andreas', detail: 'Gesichtsbehandlung' },
];

const journal = JOURNAL_POSTS.slice(0, 3);
const formatDate = (iso: string) => new Date(iso).toLocaleDateString('de-CH', { day: 'numeric', month: 'long', year: 'numeric' });

const businessStructuredData = {
    "@context": "https://schema.org",
    "@type": "BeautySalon",
    "name": "Beauty Face Lift Zürich",
    "url": absoluteUrl('/'),
    "address": {
        "@type": "PostalAddress",
        "streetAddress": "Bahnhofstrasse 94",
        "addressLocality": "Zürich",
        "postalCode": "8001",
        "addressCountry": "CH"
    },
    "areaServed": [
        "Zürich",
        "Switzerland"
    ],
    "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Kosmetische Behandlungen",
        "itemListElement": SERVICE_GROUPS.flatMap((group) => group.services.map((service) => ({
            "@type": "Offer",
            "category": group.label,
            "itemOffered": {
                "@type": "Service",
                "name": service.label,
                "url": absoluteUrl(service.href),
                "description": service.description
            }
        })))
    },
};

const websiteStructuredData = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Beauty Face Lift Zürich",
    "url": absoluteUrl('/'),
};

const structuredData = [businessStructuredData, websiteStructuredData];

// First-visit questions lead; the definitional question stays for search but moves last.
const faqs = [
    {
        q: 'Brauche ich eine Beratung vor der ersten Behandlung?',
        a: 'Eine kurze persönliche Beratung ist fester Bestandteil jeder Erstbehandlung bei Beauty Face Lift. Teresa nimmt sich Zeit, Ihren Hauttyp sorgfältig zu analysieren, eventuelle Empfindlichkeiten zu besprechen und die passende Behandlung für Ihre individuellen Bedürfnisse zu empfehlen. Diese Beratung ist kostenlos und unverbindlich. So stellen wir sicher, dass Sie von Anfang an die bestmöglichen Ergebnisse erzielen und sich bei uns rundum wohlfühlen.',
    },
    {
        q: 'Welche Behandlung passt zu mir?',
        a: 'Die ideale Behandlung hängt von Ihren individuellen Hautbedürfnissen ab. Aquafacial eignet sich hervorragend für frischen Glow und intensive Feuchtigkeit. Microneedling ist eine Option bei Anti-Aging, feinen Linien und Narben. Fruchtsäure Peeling empfehlen wir bei Unreinheiten, Akne und unebenmässiger Hauttextur. ColdPlasma und Exosome Therapie können die professionelle Wirkstoffpflege ergänzen. Teresa berät Sie persönlich in einem Erstgespräch und erstellt einen massgeschneiderten Behandlungsplan für Ihre Haut.',
    },
    {
        q: 'Kann ich mehrere Behandlungen kombinieren?',
        a: 'Ja, viele unserer Behandlungen ergänzen sich hervorragend und können für möglichst gute Ergebnisse miteinander kombiniert werden. Besonders beliebt ist die Kombination aus Aquafacial und ColdPlasma — die Tiefenreinigung des Aquafacials bereitet die Haut ideal auf die regenerierende Wirkung des ColdPlasma vor. Auch Microneedling und Fruchtsäure Peeling lassen sich in einem abgestimmten Behandlungsplan integrieren. Teresa empfiehlt Ihnen die ideale Kombination basierend auf Ihrem Hautbild.',
    },
    {
        q: 'Sind die Behandlungen für empfindliche Haut geeignet?',
        a: 'Ja, alle unsere Behandlungen sind individuell auf Ihren Hauttyp anpassbar. Besonders Aquafacial und ColdPlasma zeichnen sich durch ihre sanfte Wirkungsweise aus und sind hervorragend für empfindliche Haut geeignet. Die Intensität wird bei jeder Behandlung an Ihre persönliche Hautempfindlichkeit angepasst. Bei der Erstberatung bespricht Teresa allfällige Allergien oder Unverträglichkeiten mit Ihnen, damit wir die Behandlung sorgfältig auf Ihre Bedürfnisse abstimmen können.',
    },
    {
        q: 'Wo befindet sich Beauty Face Lift?',
        a: 'Unser Studio befindet sich an der Bahnhofstrasse 94, 8001 Zürich — im Herzen der Stadt, nur wenige Schritte vom Paradeplatz entfernt. Die zentrale Lage ist hervorragend mit öffentlichen Verkehrsmitteln erreichbar: Die Tram-Haltestellen Paradeplatz und Börsenstrasse liegen in unmittelbarer Nähe. Auch mit dem Auto ist das Studio gut zugänglich, mit mehreren Parkhäusern in der Umgebung. Wir freuen uns auf Ihren Besuch in unserer Beauty Oase an Zürichs bekanntester Einkaufsstrasse.',
    },
    {
        q: 'Was ist ein Kosmetikinstitut?',
        a: 'Ein Kosmetikinstitut vereint kosmetisch-ästhetische Behandlungen mit der Entspannung eines hochwertigen Spa-Erlebnisses. Bei Beauty Face Lift in Zürich bieten wir nicht-chirurgische Behandlungen wie Aquafacial, Microneedling, Fruchtsäure Peeling, ColdPlasma und Exosome Therapie an. Anders als in einem klassischen Kosmetikstudio setzen wir auf professionelle Geräte, hochwertige Wirkstoffe und persönliche Beratung — ganz ohne chirurgische Eingriffe.',
    },
];

const faqData = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((item) => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": item.a
        }
    }))
};
---

<Base
    title="Beauty Face Lift Zürich | Kosmetikstudio an der Bahnhofstrasse"
    description="Kosmetikstudio Zürich Bahnhofstrasse: Beauty Face Lift bietet Gesichtsbehandlung, Aquafacial, Microneedling, Laser-Haarentfernung, Waxing, Wimpern, Brauen, Make-up und Massage."
    preloadImage={{
        href: homepageHeroPreload.src,
        imagesrcset: homepageHeroPreload.srcSet.attribute,
        imagesizes: heroSizes,
        type: 'image/webp',
        fetchpriority: 'high',
    }}
    structuredData={structuredData}
>
    <!-- 1 · Hero: founder-led split with collage -->
    <header class="hx">
        <div class="container hx-grid">
            <div class="hx-copy">
                <span class="eyebrow eyebrow--pill reveal-up">Kosmetikstudio an der Bahnhofstrasse 94</span>
                <h1 class="hx-title reveal-up" style="--d: 1">Ihre Schönheitsadresse an der <em>Bahnhofstrasse</em> Zürich</h1>
                <p class="lead reveal-up" style="--d: 2">Hochwertige kosmetisch-ästhetische Behandlungen, persönlich abgestimmt von Teresa Stimac, Kosmetikerin mit über 20 Jahren Erfahrung.</p>
                <div class="btn-row reveal-up" style="--d: 3">
                    <a href="/termin/" class="btn btn-lg hero-cta" data-button-location="home_hero">Termin buchen</a>
                    <a href="/behandlungen/" class="btn btn-secondary btn-lg">Behandlungen entdecken</a>
                </div>
                <a class="hx-proof reveal-up" style="--d: 4" href={TREATWELL_URL} target="_blank" rel="noopener">
                    <span class="hx-stars" aria-hidden="true">★★★★★</span>
                    <span><strong>4,8 / 5</strong> aus 248+ Bewertungen auf Treatwell</span>
                </a>
            </div>

            <div class="hx-media">
                <div class="arch hx-arch reveal-media">
                    <Image
                        src={teresaWithClient}
                        widths={[420, 640, 860, 1100]}
                        sizes={heroSizes}
                        format="webp"
                        quality="high"
                        priority
                        alt="Teresa Stimac bei einer Gesichtsbehandlung im Studio an der Bahnhofstrasse Zürich"
                    />
                </div>
                <div class="media hx-thumb">
                    <Image
                        src={glowPortrait}
                        widths={[240, 360, 480]}
                        sizes="(min-width: 901px) 200px, 34vw"
                        format="webp"
                        quality="mid"
                        alt="Frau mit frischer, gepflegter Haut nach der Behandlung"
                    />
                </div>
                <div class="float-card hx-float reveal-up" style="--d: 5">
                    <span class="icon-dot" aria-hidden="true">✦</span>
                    <span><strong>Persönlich von Teresa</strong>Jeder Termin, seit über 20 Jahren</span>
                </div>
                <div class="ring-badge hx-ring" aria-hidden="true">
                    <svg viewBox="0 0 120 120"><defs><path id="hx-ring-path" d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0" /></defs><text><textPath href="#hx-ring-path" textLength="286" lengthAdjust="spacing">Jahre Erfahrung · Bahnhofstrasse ·</textPath></text></svg>
                    <span>20+</span>
                </div>
            </div>
        </div>
    </header>

    <!-- 2 · Italic marquee -->
    <div class="word-marquee" aria-hidden="true">
        <div class="word-marquee-track">
            {[...marqueeWords, ...marqueeWords].map((word) => <span>{word}</span>)}
        </div>
    </div>

    <!-- 3 · Studio intro + stats -->
    <section class="section" aria-labelledby="studio-title">
        <div class="container">
            <div class="hm-intro">
                <div class="hm-intro-head">
                    <span class="eyebrow">Das Studio</span>
                    <h2 id="studio-title">Haut im Mittelpunkt, <em>Schönheit</em> im Detail</h2>
                </div>
                <div class="hm-intro-copy">
                    <p class="lead">Beauty Face Lift ist auf hochwertige Gesichtsbehandlungen in Zürich spezialisiert. Ergänzend bietet Teresa Stimac an der Bahnhofstrasse Laser-Haarentfernung, Waxing, Wimpern &amp; Brauen, Make-up und Massage an, jede Leistung diskret, sorgfältig und persönlich geplant.</p>
                    <a href="/ueber-mich/" class="btn-link">Mehr über das Studio</a>
                </div>
            </div>
            <div class="stats-bar scroll-anim">
                <div><strong>4,8</strong><span>von 5 Sternen auf Treatwell</span></div>
                <div><strong>248+</strong><span>Bewertungen von Kundinnen</span></div>
                <div><strong>20+</strong><span>Jahre Erfahrung in Zürich</span></div>
                <div><strong>{SERVICE_GROUPS.length}</strong><span>Behandlungsbereiche</span></div>
            </div>
        </div>
    </section>

    <!-- 4 · Signature treatments -->
    <section class="section section--flush-top" id="expertise" aria-labelledby="signature-title">
        <div class="container">
            <div class="section-head">
                <div>
                    <span class="eyebrow">Signature-Behandlungen</span>
                    <h2 id="signature-title">Behandlungen für sichtbar <em>frische</em> Haut</h2>
                </div>
                <a href="/behandlungen/" class="btn-link">Alle Behandlungen</a>
            </div>
            <ul class="hm-tiles">
                {signatureTreatments.map((treatment) => (
                    <li>
                        <a href={treatment.href} class="hm-tile scroll-anim">
                            <span class="media hm-tile-media">
                                <Image src={treatment.image} widths={[360, 540, 720]} sizes="(min-width: 1280px) 410px, (min-width: 901px) 31vw, 92vw" format="webp" quality="mid" loading="lazy" alt={treatment.alt} />
                                {treatment.meta && <span class="hm-tile-price">{treatment.meta}</span>}
                            </span>
                            <span class="hm-tile-body">
                                <span>
                                    <h3>{treatment.name}</h3>
                                    <p>{treatment.text}</p>
                                </span>
                                <span class="hm-tile-arrow" aria-hidden="true">&#8599;</span>
                            </span>
                        </a>
                    </li>
                ))}
                <li>
                    <div class="hm-tile hm-tile--cta scroll-anim">
                        <span class="eyebrow">Erstberatung</span>
                        <h3>Unsicher, welche Behandlung <em>passt</em>?</h3>
                        <p>Teresa analysiert Ihre Haut und empfiehlt die passende Behandlung. Die Erstberatung ist kostenlos und unverbindlich.</p>
                        <div class="btn-row">
                            <a href="/kontakt/" class="btn" data-button-location="home_consultation_tile">Beratung anfragen</a>
                        </div>
                    </div>
                </li>
            </ul>
        </div>
    </section>

    <!-- 5 · Services + price menu -->
    <section class="section section--shell" aria-labelledby="services-title">
        <div class="container hm-services">
            <div class="hm-services-copy">
                <span class="eyebrow">Behandlungsbereiche</span>
                <h2 id="services-title">Alles für gepflegte <em>Details</em></h2>
                <p class="lead">Neben Gesicht und Haut finden Sie im Studio an der Bahnhofstrasse die Leistungen, die Ihren Auftritt abrunden.</p>
                <ul class="hm-groups">
                    {SERVICE_GROUPS.map((group) => (
                        <li>
                            <a href={group.href} class="hm-group">
                                <span>
                                    <strong>{group.label}</strong>
                                    <small>{hubAnchors[group.href] ?? group.label}</small>
                                </span>
                                <span class="hm-group-arrow" aria-hidden="true">&#8599;</span>
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
            <aside class="hm-menu scroll-anim" aria-labelledby="menu-title">
                <span class="eyebrow">Preise</span>
                <h3 id="menu-title" class="hm-menu-title">Auf einen <em>Blick</em></h3>
                <dl class="price-list">
                    {priceList.map((row) => (
                        <div class="price-list-row"><dt>{row.name}</dt><span class="leader" aria-hidden="true"></span><dd>{row.price}</dd></div>
                    ))}
                </dl>
                <p class="hm-menu-note">Die genauen Preise und Dauer finden Sie auf den Behandlungsseiten.</p>
                <a href="/termin/" class="btn btn-block" data-button-location="home_price_menu">Termin buchen</a>
            </aside>
        </div>
    </section>

    <!-- 6 · Teresa -->
    <section class="section" id="about" aria-labelledby="teresa-title">
        <div class="container hm-teresa">
            <div class="hm-teresa-media scroll-anim">
                <div class="arch hm-teresa-arch">
                    <Image src={carbonTreatmentTeresa} widths={[420, 640, 900]} sizes="(min-width: 1280px) 500px, (min-width: 901px) 40vw, 92vw" format="webp" quality="high" loading="lazy" alt="Teresa Stimac bei einer Carbon Peeling Behandlung im Studio" />
                </div>
                <div class="float-card hm-teresa-float">
                    <span class="icon-dot" aria-hidden="true">✦</span>
                    <span><strong>Seit 2008</strong>begleitet Teresa einige Kundinnen</span>
                </div>
            </div>
            <div class="hm-teresa-copy">
                <span class="eyebrow">Über Teresa</span>
                <h2 id="teresa-title">Persönlich betreut von <em>Teresa Stimac</em></h2>
                <figure class="quote">
                    <blockquote>„Die Haut ist 90 Prozent von deinem Selfie.“</blockquote>
                    <figcaption>Teresa Stimac, Gründerin</figcaption>
                </figure>
                <p>Im Zentrum von Zürich, an der Bahnhofstrasse, liegt das Studio von Teresa Stimac. Seit über 20 Jahren ist sie selbstständige Kosmetikerin in Zürich, mit einer treuen Stammkundschaft, die sich auf ihre Erfahrung und Expertise verlässt.</p>
                <ul class="hm-chips">
                    <li>Über 20 Jahre selbstständig</li>
                    <li>Jeder Termin persönlich</li>
                    <li>Bahnhofstrasse 94</li>
                </ul>
                <a href="/ueber-mich/" class="btn btn-secondary">Teresa kennenlernen</a>
            </div>
        </div>
    </section>

    <!-- 7 · First visit -->
    <section class="section section--flush-top" aria-labelledby="visit-title">
        <div class="container hm-visit">
            <div class="hm-visit-head">
                <span class="eyebrow">Ihr erster Besuch</span>
                <h2 id="visit-title">Gut vorbereitet zum <em>ersten</em> Termin</h2>
                <div class="media hm-visit-media scroll-anim">
                    <Image src={consultation} widths={[480, 720, 960]} sizes="(min-width: 1280px) 560px, (min-width: 901px) 44vw, 92vw" format="webp" quality="mid" loading="lazy" alt="Teresa bespricht mit einer Kundin die Hautanalyse" />
                    <div class="float-card hm-visit-float">
                        <span class="icon-dot" aria-hidden="true">✓</span>
                        <span><strong>Erstberatung</strong>kostenlos und unverbindlich</span>
                    </div>
                </div>
            </div>
            <ol class="steps hm-steps">
                <li>
                    <h3>Termin wählen</h3>
                    <p>Bequem online buchen oder per WhatsApp anfragen, wenn Sie vorab eine Frage haben.</p>
                </li>
                <li>
                    <h3>Beratung &amp; Hautanalyse</h3>
                    <p>Teresa nimmt sich Zeit für Hauttyp, Ziele und Empfindlichkeiten.</p>
                </li>
                <li>
                    <h3>Ihre Behandlung</h3>
                    <p>Persönlich durchgeführt und auf Ihre Haut abgestimmt, in ruhiger Atmosphäre.</p>
                </li>
                <li>
                    <h3>Pflege danach</h3>
                    <p>Mit Pflegehinweisen für zu Hause und, wenn sinnvoll, einem persönlichen Behandlungsplan.</p>
                </li>
            </ol>
        </div>
    </section>

    <!-- 8 · Reviews -->
    <section class="section section--shell" aria-labelledby="reviews-title">
        <div class="container">
            <div class="section-head section-head--center">
                <div>
                    <span class="eyebrow">Kundenstimmen</span>
                    <h2 id="reviews-title">Was Kundinnen über uns <em>sagen</em></h2>
                </div>
            </div>
            <div class="hm-reviews">
                <div class="hm-rating">
                    <span class="hm-rating-score">4,8</span>
                    <span class="hx-stars" aria-label="4,8 von 5 Sternen">★★★★★</span>
                    <p>aus 248+ Bewertungen auf Treatwell</p>
                    <a href={TREATWELL_URL} class="btn-link" target="_blank" rel="noopener">Bewertungen ansehen</a>
                </div>
                {reviews.map((review) => (
                    <figure class="testimonial-card">
                        <span class="testimonial-stars" aria-label="5 von 5 Sternen">★★★★★</span>
                        <blockquote class="testimonial-quote">„{review.quote}“</blockquote>
                        <figcaption class="testimonial-author"><strong>{review.author}</strong> · {review.detail}</figcaption>
                    </figure>
                ))}
            </div>
        </div>
    </section>

    <!-- 9 · Journal -->
    <section class="section" aria-labelledby="journal-title">
        <div class="container">
            <div class="section-head">
                <div>
                    <span class="eyebrow">Journal</span>
                    <h2 id="journal-title">Wissen rund um Ihre <em>Haut</em></h2>
                </div>
                <a href="/blog/" class="btn-link">Alle Beiträge</a>
            </div>
            <ul class="hm-journal">
                {journal.map((post) => (
                    <li>
                        <a href={post.href} class="hm-post scroll-anim">
                            <span class="media media--landscape">
                                <Image src={post.image} widths={[360, 540, 720]} sizes="(min-width: 1280px) 410px, (min-width: 901px) 31vw, 92vw" format="webp" quality="mid" loading="lazy" alt={post.imageAlt} />
                            </span>
                            <span class="hm-post-meta"><span class="hm-post-tag">{post.category}</span>{formatDate(post.publishDate)} · {post.readingTime}</span>
                            <h3>{post.title}</h3>
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <!-- 10 · FAQ -->
    <section class="section section--flush-top" aria-labelledby="faq-title">
        <div class="container hm-faq">
            <div class="hm-faq-head">
                <span class="eyebrow">Häufige Fragen</span>
                <h2 id="faq-title">Gut zu <em>wissen</em></h2>
                <p>Noch Fragen? Teresa beantwortet sie gerne persönlich, per WhatsApp oder im Studio.</p>
                <a href="/haeufige-fragen/" class="btn btn-secondary">Alle Fragen</a>
            </div>
            <div class="faq-list">
                {faqs.map((item) => (
                    <details class="faq-item">
                        <summary>{item.q}</summary>
                        <p>{item.a}</p>
                    </details>
                ))}
            </div>
        </div>
        <script type="application/ld+json" set:html={JSON.stringify(faqData)} />
    </section>

    <!-- 11 · Closing CTA over photography -->
