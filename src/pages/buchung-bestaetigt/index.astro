---

import Base from '../../layouts/Base.astro';
---

<Base
    title="Buchungsstatus | Beauty Face Lift Zürich"
    description="Hinweis zu einer älteren Beauty Face Lift Buchung."
    noindex={true}
>
    <section class="confirmation-page" aria-labelledby="confirmation-title">
        <div class="container container--text confirmation-inner">
            <p class="eyebrow eyebrow--rule">Ihre Buchung</p>
            <h1 id="confirmation-title">Buchungshinweis</h1>
            <p class="lead confirmation-subtitle">Neue Termine buchen Sie bequem und sicher online über unseren Partner Treatwell.</p>

            <div id="booking-details" class="confirmation-details">
                <p class="confirmation-id caption" id="details-loading">Buchungsdetails werden geladen...</p>
            </div>

            <div class="confirmation-info">
                <p>Falls Sie eine ältere Bestätigung geöffnet haben, bleiben die Angaben hier nur zur Orientierung sichtbar.</p>
                <p>Bei Fragen erreichen Sie uns unter <a href="tel:+41792143462">+41 79 214 34 62</a> oder <a href="mailto:info@beautyfacelift.ch">info@beautyfacelift.ch</a>.</p>
            </div>

            <div class="btn-row confirmation-actions">
                <a href="/termin/" class="btn" data-button-location="legacy_confirmation_booking">Zur neuen Buchung</a>
                <a href="/behandlungen/" class="btn-link">Weitere Behandlungen</a>
                <a href="/" class="btn-link">Zur Startseite</a>
            </div>
        </div>
    </section>
</Base>

<script is:inline>
    (function() {
        var params = new URLSearchParams(window.location.search);
        var bookingId = params.get('id');
        var loadingEl = document.getElementById('details-loading');

        if (bookingId && loadingEl) {
            // Built with textContent so the URL parameter is never parsed as HTML.
            var idValue = document.createElement('strong');
            idValue.textContent = bookingId.substring(0, 8) + '...';
            loadingEl.textContent = 'Buchungs-ID: ';
            loadingEl.appendChild(idValue);
        } else if (loadingEl) {
            loadingEl.textContent = '';
        }
    })();
</script>

<style>
    .confirmation-page {
        min-height: 78vh;
        display: flex;
        align-items: center;
        padding-top: calc(var(--nav-h) + clamp(48px, 8vw, 120px));
        padding-bottom: clamp(72px, 9vw, 136px);
    }

    .confirmation-inner {
        display: grid;
        gap: 24px;
        justify-items: start;
    }

    .confirmation-details {
        width: 100%;
    }

    .confirmation-details:has(.confirmation-id:empty) {
        display: none;
    }

    .confirmation-id {
        padding-block: 14px;
        border-top: 1px solid var(--rule-strong);
        border-bottom: 1px solid var(--rule);
        max-width: none;
    }

    .confirmation-details :global(strong) {
        font-weight: 600;
        color: var(--espresso);
        font-variant-numeric: tabular-nums;
    }

    .confirmation-info {
        display: grid;
        gap: 10px;
    }

    .confirmation-info a {
        color: var(--espresso);
        border-bottom: 1px solid var(--rule-strong);
        transition: color 0.3s ease, border-color 0.3s ease;
    }

    .confirmation-info a:hover {
        color: var(--bronze);
        border-color: currentColor;
    }

    .confirmation-actions {
        margin-top: 12px;
    }
</style>
