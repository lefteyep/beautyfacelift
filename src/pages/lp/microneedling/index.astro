---

import LandingPage from '../../../layouts/LandingPage.astro';
import BookingCta from '../../../components/BookingCta.astro';
import { Image, getImage } from 'astro:assets';
import { bookingLinkForService } from '../../../../shared/site';
import { microneedlingCard } from '../../../lib/site-images';

const bookingHref = bookingLinkForService('Microneedling');

const heroSizes = '(min-width: 1320px) 600px, (min-width: 901px) 46vw, 100vw';
const heroWidths = [640, 960, 1280];
const heroPreload = await getImage({
    src: microneedlingCard,
    widths: heroWidths,
    sizes: heroSizes,
    format: 'webp',
    quality: 'high',
});

const benefits = [
    { title: 'Kollagen-Boost', text: 'Stimuliert natürliche Kollagen- und Elastinproduktion.' },
    { title: 'Narben reduzieren', text: 'Akne-Narben verblassen sichtbar nach wenigen Sitzungen.' },
    { title: 'Ohne Operation', text: 'Kosmetisch-ästhetisch und individuell dosiert.' },
];
---

<LandingPage
    title="Microneedling Zürich — Jetzt Termin buchen"
    description="Microneedling an der Bahnhofstrasse Zürich. Kosmetische Hautbildverbesserung ohne OP."
    preloadImage={{
        href: heroPreload.src,
        imagesrcset: heroPreload.srcSet.attribute,
        imagesizes: heroSizes,
        type: 'image/webp',
        fetchpriority: 'high',
    }}
>
    <main class="lp-simple">
        <section class="lp-simple-hero" aria-labelledby="lp-simple-title">
            <div class="container lp-simple-hero-grid">
                <div class="lp-simple-hero-copy">
                    <p class="eyebrow eyebrow--rule">Premium Kosmetikinstitut · Zürich</p>
                    <h1 class="lp-simple-title" id="lp-simple-title">Micro<em>needling</em></h1>
                    <p class="lead">Kosmetische Hautbildverbesserung ohne OP. Kollagenstimulation für ein verfeinertes Hautbild – an der Bahnhofstrasse.</p>
                    <div class="btn-row">
                        <a href={bookingHref} class="btn" data-treatment="Microneedling" data-button-location="lp_hero">Termin buchen</a>
                    </div>
                </div>
                <figure class="lp-simple-hero-media">
                    <Image
                        src={microneedlingCard}
                        widths={heroWidths}
                        sizes={heroSizes}
                        format="webp"
                        quality="high"
                        priority
                        alt="Microneedling Behandlung im Gesicht"
                    />
                </figure>
            </div>
        </section>

        <section class="lp-simple-benefits" aria-label="Vorteile">
            <div class="container">
                <ul class="index-grid">
                    {benefits.map((benefit) => (
                        <li>
                            <h2 class="lp-simple-benefit-title">{benefit.title}</h2>
                            <p>{benefit.text}</p>
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <section id="buchen" class="container lp-simple-booking">
            <BookingCta
                treatment="Microneedling"
                href={bookingHref}
                text="Buche deinen Wunschtermin bequem online. Teresa klärt Details und Eignung vor der Behandlung persönlich mit dir."
            />
        </section>
    </main>
</LandingPage>

<style>
    .lp-simple-hero {
        padding-block: clamp(40px, 6vw, 96px) clamp(48px, 6vw, 88px);
    }

    .lp-simple-hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
        align-items: center;
        gap: clamp(40px, 6vw, 104px);
    }

    .lp-simple-hero-copy {
        display: grid;
        justify-items: start;
        gap: 28px;
    }

    .lp-simple-title {
        font-size: var(--fs-display);
        line-height: 0.98;
        letter-spacing: -0.025em;
    }

    .lp-simple-hero-media {
        position: relative;
        aspect-ratio: 3 / 2;
        overflow: hidden;
        margin: 0;
        background: var(--stone);
    }

    .lp-simple-hero-media :global(img) {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .lp-simple-benefits {
        padding-bottom: clamp(56px, 7vw, 104px);
    }

    .lp-simple-benefit-title {
        font-size: var(--fs-h3);
        line-height: 1.15;
    }

    .lp-simple-booking {
        padding-bottom: clamp(56px, 8vw, 120px);
    }

    @media (max-width: 900px) {
        .lp-simple-hero {
            padding-top: 0;
        }

        .lp-simple-hero-grid {
            grid-template-columns: minmax(0, 1fr);
            gap: 32px;
        }

        .lp-simple-hero-media {
            order: -1;
            aspect-ratio: 16 / 10;
            margin-inline: calc(-1 * var(--gutter));
        }

        .lp-simple-hero-copy .btn-row,
        .lp-simple-hero-copy .btn {
            width: 100%;
        }
    }
</style>
