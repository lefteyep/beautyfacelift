---
import LandingPage from '../../../layouts/LandingPage.astro';
import BookingCta from '../../../components/BookingCta.astro';
import OfferBox from '../../../components/lp/OfferBox.astro';
import WhatsAppButton from '../../../components/lp/WhatsAppButton.astro';
import FAQAccordion from '../../../components/lp/FAQAccordion.astro';
import TestimonialStrip from '../../../components/lp/TestimonialStrip.astro';
import TrustStrip from '../../../components/lp/TrustStrip.astro';
import StickyOfferBar from '../../../components/lp/StickyOfferBar.astro';
import { Image, getImage } from 'astro:assets';
import { carbonTreatmentTeresa, microneedlingCard, teresaPortrait } from '../../../lib/site-images';
import { absoluteUrl, bookingLinkForService } from '../../../../shared/site';

const PROMO_PRICE = 169;
const REGULAR_PRICE = 220;
const SAVINGS_LABEL = 'Sie sparen CHF 51.–';
const bookingHref = `${bookingLinkForService('Carbon Microneedling')}&offer=glow-up-aktion&price=${PROMO_PRICE}`;
// The square hero photo is cover-cropped to a tall frame on desktop, so the requested
// width follows the frame height there; on phones it fills the viewport width.
const lpHeroWidths = [480, 720, 960, 1254];
const lpHeroSizes = '(min-width: 1440px) 900px, (min-width: 901px) 62vw, 100vw';
const lpHalfSizes = '(min-width: 1440px) 640px, (min-width: 901px) 46vw, 100vw';
const lpHeroPreload = await getImage({
  src: carbonTreatmentTeresa,
  widths: lpHeroWidths,
  sizes: lpHeroSizes,
  format: 'webp',
  quality: 'high',
});

const whatsappMessage = 'Hallo Teresa, ich interessiere mich für die Glow-Up Aktion: Carbon Peeling + Microneedling für CHF 169 statt CHF 220.';

const heroBullets = [
  'Poren wirken feiner',
  'Frischer wirkender Glow',
  '90 Minuten inkl. Hautanalyse, Carbon Peeling, Microneedling & Hyaluron-Finish',
  '20+ Jahre Erfahrung · 4,8/5 aus 248+ Bewertungen',
];

const problemItems = [
  { title: 'Feiner wirkende Poren', text: 'Das Ziel ist ein ruhigeres, gepflegteres Hautbild.' },
  { title: 'Ebenmässigere Textur', text: 'Die Behandlung ist auf eine glatter wirkende Hautoberfläche ausgerichtet.' },
  { title: 'Frischerer Teint', text: 'Carbon Peeling und Hyaluron-Finish unterstützen einen gepflegten Glow.' },
  { title: 'Intensiveres Pflegegefühl', text: 'Die Behandlung verbindet Hautvorbereitung, Microneedling und Wirkstoffpflege.' },
];

const benefits = [
  { title: 'Hydratisiertes Hautgefühl', text: 'Hyaluron & Vitamine pflegen die Haut intensiv nach der Behandlung.' },
  { title: 'Frischer Glow', text: 'Die Haut kann direkt frischer, klarer und gepflegter wirken.' },
  { title: 'Weichere Linien', text: 'Feine Linien können optisch sanfter erscheinen, ohne unrealistische Versprechen.' },
  { title: 'Regenerations-Impuls', text: 'Microneedling unterstützt die natürliche Hauterneuerung und Struktur.' },
  { title: 'Feiner wirkende Poren', text: 'Carbon Peeling hilft, die Haut optisch zu klären und Poren feiner wirken zu lassen.' },
  { title: 'Bessere Pflegeaufnahme', text: 'Die vorbereitete Haut nimmt hochwertige Wirkstoffe besonders gut auf.' },
];

const includedItems = [
  'Reinigung & Hautanalyse',
  'Carbon-Aktivkohle-Peeling',
  'Microneedling mit professionellem Pen',
  'Hyaluron- & Vitamin-Infusion',
  'Beruhigende Abschlussmaske',
  'Persönliche After-Care-Beratung',
];

const phases = [
  { title: 'Carbon Peeling', text: 'Die Haut wird gründlich vorbereitet. Überschüssiger Talg und abgestorbene Hautschüppchen werden sanft gelöst.' },
  { title: 'Microneedling', text: 'Der professionelle Pen setzt mikrofeine Impulse und kann die natürliche Regeneration sowie eine glatter wirkende Textur unterstützen.' },
  { title: 'Hyaluron Finish', text: 'Hyaluron, Vitamine und eine beruhigende Maske runden die Behandlung mit einem gepflegten Hautgefühl ab.' },
];

const comparisonItems = [
  { title: 'Klären', text: 'Carbon Peeling bereitet die Haut vor und entfernt überschüssigen Talg sowie Hautschüppchen.' },
  { title: 'Struktur unterstützen', text: 'Microneedling kann die natürliche Regeneration und ein glatter wirkendes Hautbild unterstützen.' },
  { title: 'Beruhigen & pflegen', text: 'Hyaluron, Vitamine und Abschlussmaske sorgen für ein gepflegtes Finish.' },
];

const expectationItems = [
  { title: 'Direkt danach', text: 'Die Haut kann frischer wirken und leicht gerötet sein.' },
  { title: '24–48 Stunden', text: 'Rötungen beruhigen sich meist; die Haut fühlt sich gepflegter an.' },
  { title: 'Danach', text: 'Die Hautstruktur kann glatter und der Teint ebenmässiger erscheinen.' },
];

const processSteps = [
  { title: 'Termin über Treatwell wählen', text: 'Ein Klick führt Sie direkt zur Online-Buchung bei Treatwell.' },
  { title: 'Studio an der Bahnhofstrasse besuchen', text: 'Beauty Face Lift befindet sich zentral an der Bahnhofstrasse 94 in Zürich.' },
  { title: '90 Minuten Glow-Up Behandlung', text: 'Teresa führt Hautanalyse, Carbon Peeling, Microneedling und Finish persönlich durch.' },
  { title: 'After-Care mitnehmen', text: 'Sie erhalten klare Hinweise, wie Sie Ihre Haut nach der Behandlung pflegen.' },
];

const aboutFacts = [
  'Bahnhofstrasse 94 · 8001 Zürich',
  'Ausgebildete Kosmetikerin mit Spezialisierung auf Microneedling',
  '248+ Bewertungen',
  'Mo–Fr 10:00–20:00 · Sa 09:00–16:00',
];

const testimonials = [
  {
    text: 'Nach nur einer Sitzung hatte ich wirklich diesen frischen Glow. Teresa nimmt sich Zeit und erklärt jeden Schritt.',
    name: 'Laura M.',
    role: 'Zürich',
  },
  {
    text: 'Die Kombi aus Carbon und Microneedling hat mein Hautbild gepflegt und feiner wirken lassen. Absolut empfehlenswert!',
    name: 'Sandra B.',
    role: 'Zollikon',
  },
  {
    text: 'Professionell, sauber, meist keine Ausfallzeit. Ich war am Abend wieder gesellschaftsfähig — mit besserer Haut.',
    name: 'Marina K.',
    role: 'Zürich',
  },
  // TODO: real testimonial #4 — Teresa to supply { text, name, role } before campaign launch
  // TODO: real testimonial #5 — Teresa to supply { text, name, role } before campaign launch
];

const faqs = [
  {
    q: 'Ist die Behandlung schmerzhaft?',
    a: 'Vor dem Microneedling wird eine betäubende Creme aufgetragen. Die meisten Kundinnen spüren nur ein leichtes Kribbeln oder Druckgefühl.',
  },
  {
    q: 'Wie lange ist die Haut gerötet?',
    a: 'Die Haut kann direkt nach der Behandlung gerötet sein. Das beruhigt sich meist innert Stunden, je nach Hauttyp auch innerhalb von 24-48 Stunden.',
  },
  {
    q: 'Wie viele Sitzungen brauche ich?',
    a: 'Eine Sitzung kann bereits frischer wirken lassen. Für längerfristige Hautziele empfiehlt Teresa je nach Hautbild eine Serie mehrerer Behandlungen.',
  },
  {
    q: 'Für wen ist Carbon Microneedling geeignet?',
    a: 'Teresa prüft das Hautbild vor Ort und bespricht, ob die Kombination zu den gewünschten Behandlungszielen passt. Nicht empfohlen bei akuter Akne, Schwangerschaft oder offenen Hautstellen.',
  },
  {
    q: 'Was ist im Preis inbegriffen?',
    a: `Die komplette 90-Minuten-Behandlung: Reinigung, Hautanalyse, Carbon Peeling, Microneedling, Hyaluron-Finish, beruhigende Abschlussmaske und After-Care-Beratung. Die Glow-Up Aktion kostet CHF ${PROMO_PRICE} statt CHF ${REGULAR_PRICE}.`,
  },
  {
    q: 'Wo buche ich den Termin?',
    a: 'Die finale Terminbuchung läuft über Treatwell. Ihre Behandlungsangabe wird über unsere Buchungsseite übernommen.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      '@id': absoluteUrl('/lp/carbon-microneedling/#product'),
      name: 'Carbon Microneedling — Glow-Up-Methode',
      description: `Glow-Up Aktion in Zürich: Carbon Peeling + Microneedling + Hyaluron-Finish für CHF ${PROMO_PRICE} statt CHF ${REGULAR_PRICE}.`,
      image: absoluteUrl('/assets/microneedling_treatment_editorial.png'),
      brand: { '@type': 'Brand', name: 'Beauty Face Lift' },
      offers: {
        '@type': 'Offer',
        priceCurrency: 'CHF',
        price: PROMO_PRICE.toFixed(2),
        availability: 'https://schema.org/InStock',
        url: absoluteUrl('/lp/carbon-microneedling/'),
        priceValidUntil: '2026-12-31',
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<LandingPage
  title="Glow-Up Aktion Zürich — CHF 169 statt CHF 220 | Beauty Face Lift"
  description="Carbon Peeling + Microneedling an der Bahnhofstrasse Zürich. Glow-Up Aktion für feinere Poren, frischen Glow und glatter wirkende Haut: CHF 169 statt CHF 220."
  preloadImage={{
    href: lpHeroPreload.src,
    imagesrcset: lpHeroPreload.srcSet.attribute,
    imagesizes: lpHeroSizes,
    type: 'image/webp',
    fetchpriority: 'high',
  }}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main class="lp-page">
    <!-- HERO -->
    <section class="lp-hero" aria-labelledby="lp-hero-title">
      <div class="container lp-hero-grid">
        <div class="lp-hero-content">
          <p class="eyebrow eyebrow--rule lp-eyebrow">Glow-Up Aktion · Bahnhofstrasse Zürich</p>
          <h1 id="lp-hero-title" class="lp-title">Carbon Peeling + Microneedling für frischer wirkende, feinere Haut</h1>
          <p class="lp-subtitle">
            Die 2-in-1 Premium-Gesichtsbehandlung für verfeinerte Poren, glatter wirkende
            Hauttextur und einen frischen Glow. Persönlich bei Teresa Stimac in Zürich.
          </p>

          <div class="lp-hero-offer" role="group" aria-label="Glow-Up Aktion">
            <p class="lp-hero-offer-price">
              <span class="lp-hero-offer-label">Glow-Up Aktion</span>
              <strong>CHF {PROMO_PRICE}.–</strong>
              <span class="lp-hero-offer-old">statt <s>CHF {REGULAR_PRICE}.–</s></span>
            </p>
            <p class="lp-hero-offer-note">{SAVINGS_LABEL} · Buchung über Treatwell</p>
          </div>

          <div class="lp-hero-ctas">
            <a href={bookingHref} class="btn lp-hero-primary" data-treatment="Carbon Microneedling" data-button-location="lp_hero">Termin für CHF 169 sichern</a>
            <WhatsAppButton variant="inline" message={whatsappMessage} source="hero" label="Frage per WhatsApp" />
          </div>

          <div class="lp-hero-trust">
            <TrustStrip variant="rating" rating="4,8" align="left" />
          </div>

          <ul class="lp-hero-bullets">
            {heroBullets.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>

        <figure class="lp-hero-media">
          <Image
            src={carbonTreatmentTeresa}
            widths={lpHeroWidths}
            sizes={lpHeroSizes}
            format="webp"
            quality="high"
            priority
            alt="Teresa Stimac bei der Carbon-Microneedling-Behandlung mit Aktivkohle-Maske im Beauty Face Lift Studio Zürich"
          />
        </figure>
      </div>
    </section>

    <!-- PROBLEM -->
    <section class="lp-section lp-section--rule lp-problem">
      <div class="container">
        <div class="lp-head lp-head--single">
          <h2 class="lp-section-title">Typische Behandlungsziele</h2>
        </div>
        <ul class="lp-grid lp-grid--4">
          {problemItems.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- VALUE BREAKDOWN -->
    <section class="lp-section lp-band--ivory lp-included">
      <div class="container">
        <div class="lp-head">
          <div class="lp-head-title">
            <p class="eyebrow eyebrow--rule">Enthalten im Preis</p>
            <h2 class="lp-section-title">Was Sie bei jeder Sitzung erhalten</h2>
          </div>
          <p class="lp-section-lead">
            90 Minuten. Sechs Schritte. Eine klare Glow-Up Aktion für CHF {PROMO_PRICE}.–
            statt CHF {REGULAR_PRICE}.–.
          </p>
        </div>
        <ul class="lp-checks lp-checks--grid">
          {includedItems.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- SOLUTION / 3-PHASE PROCESS -->
    <section class="lp-section lp-solution">
      <div class="container">
        <div class="lp-head">
          <div class="lp-head-title">
            <p class="eyebrow eyebrow--rule">Die Glow-Up-Methode</p>
            <h2 class="lp-section-title">3 Phasen. 90 Minuten. Ein gepflegter <em>Glow</em>.</h2>
          </div>
          <p class="lp-section-lead">
            Carbon Peeling klärt die Haut optisch, Microneedling unterstützt die Hautstruktur,
            und das Hyaluron-Finish beruhigt und pflegt.
          </p>
        </div>
        <div class="lp-solution-grid">
          <figure class="media lp-solution-media">
            <Image
              src={microneedlingCard}
              widths={[360, 540, 720, 960, 1200]}
              sizes={lpHalfSizes}
              format="webp"
              quality="mid"
              loading="lazy"
              alt="Microneedling Behandlung mit professionellem Pen"
            />
          </figure>
          <ol class="lp-sequence">
            {phases.map((phase) => (
              <li>
                <h3>{phase.title}</h3>
                <p>{phase.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- WHY 2-IN-1 -->
    <section class="lp-section lp-section--rule lp-combo">
      <div class="container">
        <div class="lp-head">
          <div class="lp-head-title">
            <p class="eyebrow eyebrow--rule">Warum die 2-in-1 Kombi</p>
            <h2 class="lp-section-title">Erst klären. Dann stimulieren. Dann pflegen.</h2>
          </div>
          <p class="lp-section-lead">
            Die Kombination ist ideal, wenn Sie nicht nur einen kurzen Frischemoment möchten,
            sondern eine intensivere Behandlung für Teint, Poren und Hautstruktur.
          </p>
        </div>
        <ul class="lp-grid lp-grid--3">
          {comparisonItems.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ul>
        <div class="btn-row lp-section-cta">
          <a href={bookingHref} class="btn" data-treatment="Carbon Microneedling" data-button-location="combo_section">2-in-1 Behandlung buchen</a>
        </div>
      </div>
    </section>

    <!-- BENEFITS -->
    <section class="lp-section lp-section--rule lp-benefits-section">
      <div class="container">
        <div class="lp-head">
          <div class="lp-head-title">
            <p class="eyebrow eyebrow--rule">Ihr Glow-Up</p>
            <h2 class="lp-section-title">6 Gründe für Carbon Peeling + Microneedling</h2>
          </div>
          <p class="lp-section-lead">
            Das Ziel: ein frischerer, glatter wirkender Teint, feiner erscheinende Poren
            und ein gepflegtes Hautgefühl.
          </p>
        </div>
        <ul class="lp-grid lp-grid--3">
          {benefits.map((b) => (
            <li>
              <h3>{b.title}</h3>
              <p>{b.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- OFFER BLOCK -->
    <section class="lp-section lp-offer">
      <div class="container">
        <OfferBox
          variant="box"
          eyebrow="Glow-Up Aktion Zürich"
          oldPrice={REGULAR_PRICE}
          newPrice={PROMO_PRICE}
          discountLabel={SAVINGS_LABEL}
          urgency={`statt CHF ${REGULAR_PRICE}.– · 90 Minuten · Buchung über Treatwell`}
          ctaText="Termin für CHF 169 sichern"
          ctaHref={bookingHref}
        />
        <p class="lp-offer-footnote">
          Carbon Peeling + Microneedling für CHF {PROMO_PRICE}.– statt CHF {REGULAR_PRICE}.–.
          Die Terminbuchung läuft über Treatwell – Teresa bestätigt Details und Eignung persönlich.
        </p>
      </div>
    </section>

    <!-- TESTIMONIALS -->
    <section class="lp-section lp-section--rule lp-testimonials">
      <div class="container">
        <div class="lp-head">
          <div class="lp-head-title">
            <p class="eyebrow eyebrow--rule">Echte Ergebnisse</p>
            <h2 class="lp-section-title">Das sagen unsere <em>Kundinnen</em></h2>
          </div>
          <p class="lp-rating-line"><span class="lp-stars" aria-hidden="true">★★★★★</span> 4,8 / 5 aus 248+ Bewertungen</p>
        </div>
        <TestimonialStrip testimonials={testimonials} rating="4,8" />
      </div>
    </section>

    <!-- RESULT EXPECTATION -->
    <section class="lp-section lp-section--rule lp-expectation">
      <div class="container">
        <div class="lp-head">
          <div class="lp-head-title">
            <p class="eyebrow eyebrow--rule">Realistische Erwartung</p>
            <h2 class="lp-section-title">Was nach der Behandlung möglich ist</h2>
          </div>
          <p class="lp-section-lead">
            Die Haut kann frischer wirken und sich glatter anfühlen. Leichte Rötungen sind möglich
            und beruhigen sich meist innerhalb von 24–48 Stunden.
          </p>
        </div>
        <ul class="lp-grid lp-grid--3">
          {expectationItems.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ABOUT / TRUST -->
    <section class="lp-section lp-band--sand lp-about">
      <div class="container lp-about-grid">
        <figure class="media lp-about-media">
          <Image
            src={teresaPortrait}
            widths={[360, 540, 720, 960, 1023]}
            sizes={lpHalfSizes}
            format="webp"
            quality="high"
            alt="Teresa Stimac, Gründerin von Beauty Face Lift Zürich"
            loading="lazy"
          />
        </figure>
        <div class="lp-about-content">
          <p class="eyebrow eyebrow--rule">Ihre Expertin</p>
          <h2 class="lp-section-title">Teresa Stimac — <em>20+ Jahre Erfahrung</em></h2>
          <figure class="lp-quote">
            <blockquote>„Ich nehme mir Zeit für jede Kundin. Diskretion, Präzision und ein Ergebnis, das natürlich gepflegt wirkt.“</blockquote>
          </figure>
          <p>
            Seit über 20 Jahren widmet sich Teresa der modernen Ästhetik. In ihrem Studio an der
            Bahnhofstrasse 94 verbindet sie professionelle Präzision mit einer persönlichen,
            diskreten Betreuung.
          </p>
          <ul class="lp-dashes">
            {aboutFacts.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- PROCESS -->
    <section class="lp-section lp-band--ivory lp-process">
      <div class="container">
        <div class="lp-head">
          <div class="lp-head-title">
            <p class="eyebrow eyebrow--rule">Ablauf</p>
            <h2 class="lp-section-title">So funktioniert Ihre Buchung</h2>
          </div>
          <p class="lp-section-lead">
            Der schnellste Weg zur Glow-Up Aktion führt über die Online-Buchung bei Treatwell.
            Teresa bestätigt Details und Eignung persönlich.
          </p>
        </div>
        <ol class="steps lp-steps">
          {processSteps.map((step) => (
            <li>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>
        <div class="btn-row lp-section-cta">
          <a href={bookingHref} class="btn" data-treatment="Carbon Microneedling" data-button-location="process_section">Freien Termin wählen</a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="lp-section lp-faq" aria-labelledby="lp-faq-title">
      <div class="container lp-faq-grid">
        <div class="lp-faq-head">
          <p class="eyebrow eyebrow--rule">Häufige Fragen</p>
          <h2 id="lp-faq-title" class="lp-section-title">Alles, was Sie wissen sollten</h2>
        </div>
        <FAQAccordion items={faqs} />
      </div>
    </section>

    <!-- RISK REVERSAL STRIP (above booking) -->
    <section class="lp-reassurance">
      <div class="container">
        <TrustStrip variant="promises" align="center" />
      </div>
    </section>

    <!-- BOOKING -->
    <section class="lp-section lp-booking" id="buchen">
      <div class="container">
        <div class="lp-head">
          <div class="lp-head-title">
            <p class="eyebrow eyebrow--rule">Termin buchen</p>
            <h2 class="lp-section-title">Sichern Sie sich Ihre Glow-Up-Sitzung</h2>
          </div>
          <p class="lp-section-lead">Die Terminbuchung läuft online über Treatwell.</p>
        </div>
        <BookingCta
          treatment="Carbon Microneedling"
          href={bookingHref}
          title="Carbon Peeling + Microneedling Termin buchen"
          ctaText="Termin für CHF 169 sichern"
        />
      </div>
    </section>

    <!-- FINAL CTA (espresso band) -->
    <section class="lp-final-dark on-dark" aria-labelledby="lp-final-title">
      <div class="container lp-final-inner">
        <div class="lp-final-copy">
          <p class="eyebrow eyebrow--rule lp-final-eyebrow">Glow-Up Aktion</p>
          <h2 id="lp-final-title" class="lp-final-title">Sichern Sie sich Ihre <em>Behandlung</em>.</h2>
          <p class="lp-final-lead">
            Sichern Sie sich Ihre Glow-Up Aktion in Zürich: Carbon Peeling + Microneedling
            für CHF {PROMO_PRICE}.– statt CHF {REGULAR_PRICE}.–. Persönlich behandelt
            bei Beauty Face Lift an der Bahnhofstrasse.
          </p>
        </div>
        <div class="lp-final-ctas">
          <a href={bookingHref} class="btn" data-treatment="Carbon Microneedling" data-button-location="lp_final_booking">Termin für CHF 169 sichern</a>
          <WhatsAppButton variant="inline" message={whatsappMessage} source="final" label="Frage per WhatsApp" />
          <a href="tel:+41792143462" class="btn-link" data-button-location="lp_final_phone">+41 79 214 34 62</a>
        </div>
        <p class="lp-final-address">
          Beauty Face Lift · Bahnhofstrasse 94 · 8001 Zürich<br>
          Mo–Fr 10:00–20:00 · Sa 09:00–16:00
        </p>
      </div>
    </section>

    <WhatsAppButton variant="sticky" message={whatsappMessage} source="sticky" />
    <StickyOfferBar oldPrice={REGULAR_PRICE} newPrice={PROMO_PRICE} href={bookingHref} ctaText="Termin sichern" />
  </main>

  <script>
    // Reveal the mobile offer bar only once the hero (with its own price + CTA) has scrolled away.
    const heroSection = document.querySelector('.lp-hero');
    const stickyQuery = window.matchMedia('(max-width: 900px)');

    const updateStickyOfferBar = () => {
      if (!heroSection || !stickyQuery.matches) {
        document.body.classList.remove('lp-sticky-visible');
        return;
      }

      const heroRect = heroSection.getBoundingClientRect();
      document.body.classList.toggle('lp-sticky-visible', heroRect.bottom <= window.innerHeight * 0.92);
    };

    if (heroSection) {
      updateStickyOfferBar();
      window.addEventListener('scroll', updateStickyOfferBar, { passive: true });
      window.addEventListener('resize', updateStickyOfferBar);
      stickyQuery.addEventListener('change', updateStickyOfferBar);
    }
  </script>
</LandingPage>

