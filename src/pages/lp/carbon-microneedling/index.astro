---
import LandingPage from '../../../layouts/LandingPage.astro';
import BookingWidget from '../../../components/booking/BookingWidget';
import OfferBox from '../../../components/lp/OfferBox.astro';
import WhatsAppButton from '../../../components/lp/WhatsAppButton.astro';
import FAQAccordion from '../../../components/lp/FAQAccordion.astro';
import TestimonialStrip from '../../../components/lp/TestimonialStrip.astro';
import BenefitIcon from '../../../components/lp/BenefitIcon.astro';
import TrustStrip from '../../../components/lp/TrustStrip.astro';
import StickyOfferBar from '../../../components/lp/StickyOfferBar.astro';
import { Image, getImage } from 'astro:assets';
import { carbonTreatmentTeresa, microneedlingCard, teresaPortrait } from '../../../lib/site-images';

const OFFICIAL_PRICE = 250;
const lpHeroMainSizes = '(min-width: 1101px) 32vw, (min-width: 601px) 340px, 62vw';
const lpHeroOverlapSizes = '(min-width: 1101px) 24vw, (min-width: 601px) 260px, 48vw';
const lpAboutSizes = '(min-width: 1101px) 48vw, (min-width: 601px) 520px, 100vw';
const lpHeroPreload = await getImage({
  src: microneedlingCard,
  widths: [480, 720, 960, 1200, 1536],
  sizes: lpHeroMainSizes,
  format: 'webp',
  quality: 'high',
});

const whatsappMessage = `Hallo Teresa, ich interessiere mich für Carbon Laser Peeling + Microneedling (CHF ${OFFICIAL_PRICE}).`;

const benefits = [
  { icon: 'droplet' as const, title: 'Intensive Hydration', text: 'Hyaluron & Vitamine ziehen bis in die tieferen Hautschichten ein.' },
  { icon: 'sun' as const, title: 'Sofortiger Glow', text: 'Sichtbarer Frische-Effekt bereits nach der ersten Behandlung.' },
  { icon: 'leaf' as const, title: 'Anti-Aging', text: 'Feine Linien und erste Fältchen werden sichtbar reduziert.' },
  { icon: 'activity' as const, title: 'Kollagen-Boost', text: 'Mikrokanäle aktivieren die körpereigene Kollagenbildung.' },
  { icon: 'target' as const, title: 'Verfeinerte Poren', text: 'Carbon-Peeling säubert und strafft vergrösserte Poren.' },
  { icon: 'trending-up' as const, title: 'Bessere Wirkstoff-Aufnahme', text: 'Deutlich erhöhte Absorption hochwertiger Seren.' },
];

const includedItems = [
  'Reinigung & Hautanalyse',
  'Carbon-Aktivkohle-Peeling',
  'Microneedling mit medizinischem Pen',
  'Hyaluron- & Vitamin-Infusion',
  'Beruhigende Abschlussmaske',
  'Persönliche After-Care-Beratung',
];

const testimonials = [
  {
    text: 'Nach nur einer Sitzung hatte ich wirklich diesen sofortigen Glow. Teresa nimmt sich Zeit und erklärt jeden Schritt.',
    name: 'Laura M.',
    role: 'Zürich',
  },
  {
    text: 'Die Kombi aus Carbon und Microneedling hat meine Poren sichtbar verfeinert. Absolut empfehlenswert!',
    name: 'Sandra B.',
    role: 'Zollikon',
  },
  {
    text: 'Professionell, sauber, keine Ausfallzeit. Ich war am Abend wieder gesellschaftsfähig — mit besserer Haut.',
    name: 'Marina K.',
    role: 'Zürich',
  },
  // TODO: real testimonial #4 — Teresa to supply { text, name, role } before campaign launch
  // TODO: real testimonial #5 — Teresa to supply { text, name, role } before campaign launch
];

const faqs = [
  {
    q: 'Ist die Behandlung schmerzhaft?',
    a: 'Nein. Vor dem Microneedling trage ich eine betäubende Creme auf. Die meisten Kundinnen spüren nur ein leichtes Kribbeln.',
  },
  {
    q: 'Wie lange dauert die Ausfallzeit?',
    a: 'Kaum eine. Die Haut kann kurz gerötet wirken, das legt sich meist innert Stunden. Am nächsten Tag sind Sie wieder voll einsatzbereit.',
  },
  {
    q: 'Wie viele Sitzungen brauche ich?',
    a: 'Schon eine Sitzung bringt sichtbare Ergebnisse. Für nachhaltige Effekte empfehlen wir 3 Behandlungen im Abstand von je 4 Wochen.',
  },
  {
    q: 'Für wen ist Carbon Microneedling geeignet?',
    a: 'Für alle Hauttypen ab 25 Jahren, die Poren verfeinern, Linien reduzieren oder den Teint aufhellen möchten. Nicht empfohlen bei akuter Akne, Schwangerschaft oder offenen Hautstellen.',
  },
  {
    q: 'Was ist im Preis inbegriffen?',
    a: 'Die komplette 90-Minuten-Behandlung: Reinigung, Carbon-Peeling, Microneedling, Hyaluron-Infusion und beruhigende Abschlussmaske. Ohne versteckte Kosten.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      '@id': 'https://beautyfacelift.ch/lp/carbon-microneedling/#product',
      name: 'Carbon Microneedling — Glow-Up-Methode',
      description: 'Premium Carbon Microneedling an der Bahnhofstrasse Zürich. Carbon-Peeling + Microneedling + Hyaluron-Finish in einer 90-minütigen Sitzung.',
      image: 'https://beautyfacelift.ch/assets/microneedling_treatment_editorial.png',
      brand: { '@type': 'Brand', name: 'Beauty Face Lift' },
      offers: {
        '@type': 'Offer',
        priceCurrency: 'CHF',
        price: OFFICIAL_PRICE.toFixed(2),
        availability: 'https://schema.org/InStock',
        url: 'https://beautyfacelift.ch/lp/carbon-microneedling/',
      },
      aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.8', reviewCount: '230' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<LandingPage
  title="Carbon Microneedling Zürich — CHF 250 | Beauty Face Lift"
  description="Carbon Laser Peeling + Microneedling an der Bahnhofstrasse Zürich. Glow-Up-Methode für straffe, porenreine Haut. Offizieller Preis CHF 250."
  preloadImage={{
    href: lpHeroPreload.src,
    imagesrcset: lpHeroPreload.srcSet.attribute,
    imagesizes: lpHeroMainSizes,
    type: 'image/webp',
    fetchpriority: 'high',
  }}
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!-- HERO -->
  <section class="container lp-hero">
    <div class="lp-hero-grid">
      <div class="lp-hero-content">
        <div class="sub-display lp-eyebrow">
          <span class="deco-line" aria-hidden="true"></span>
          Die Glow-Up-Methode · Zürich
        </div>
        <h1 class="lp-title display-text">Endlich porenreine,<br><em>straffe Haut</em></h1>
        <p class="lp-subtitle">
          Die Kombination aus Carbon-Peeling und Microneedling — für sichtbar festere, strahlendere Haut.
          Ohne Ausfallzeit. An der Bahnhofstrasse.
        </p>

        <div class="lp-hero-offer">
          <OfferBox
            variant="chip"
            newPrice={OFFICIAL_PRICE}
            discountLabel="Offizieller Preis"
          />
        </div>

        <div class="lp-hero-ctas">
          <a href="#buchen" class="pill-btn lp-hero-primary">Termin buchen</a>
          <WhatsAppButton variant="inline" message={whatsappMessage} source="hero" label="WhatsApp" />
        </div>

        <div class="lp-hero-trust">
          <TrustStrip variant="rating" align="left" />
        </div>
      </div>

      <div class="lp-hero-media">
        <div class="lp-hero-media-main">
          <Image
            src={microneedlingCard}
            widths={[360, 540, 720, 960, 1122]}
            sizes={lpHeroMainSizes}
            format="webp"
            quality="high"
            priority
            alt="Microneedling Behandlung mit medizinischem Pen bei Beauty Face Lift Zürich"
          />
        </div>
        <div class="lp-hero-media-overlap">
          <Image
            src={carbonTreatmentTeresa}
            widths={[320, 480, 640, 800]}
            sizes={lpHeroOverlapSizes}
            format="webp"
            quality="high"
            loading="eager"
            alt="Teresa Stimac bei der Carbon-Microneedling-Behandlung mit Aktivkohle-Maske im Beauty Face Lift Studio Zürich"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- PROBLEM -->
  <section class="container lp-section lp-problem">
    <h2 class="lp-section-title">Kennst du das?</h2>
    <div class="lp-problem-grid">
      <div class="lp-problem-item">
        <strong>Vergrösserte Poren</strong>
        <p>Kein Make-up deckt sie wirklich ab.</p>
      </div>
      <div class="lp-problem-item">
        <strong>Feine Linien</strong>
        <p>Erste Fältchen, die sich einfach nicht wegcremen lassen.</p>
      </div>
      <div class="lp-problem-item">
        <strong>Stumpfer Teint</strong>
        <p>Die Haut wirkt müde, obwohl du gut schläfst.</p>
      </div>
      <div class="lp-problem-item">
        <strong>Teure Seren</strong>
        <p>Produkte, die angeblich wirken sollen — aber nicht einziehen.</p>
      </div>
    </div>
  </section>

  <div class="lp-divider" aria-hidden="true"><span class="deco-line"></span></div>

  <!-- VALUE BREAKDOWN -->
  <section class="container lp-section lp-included">
    <div class="lp-section-head">
      <div class="sub-display">Enthalten im Preis</div>
      <h2 class="lp-section-title">Was du bei jeder Sitzung bekommst</h2>
      <p class="lp-section-lead">
        90 Minuten. Sechs Schritte. Ein offizieller Preis — ohne Überraschungen auf der Rechnung.
      </p>
    </div>
    <ul class="lp-included-list">
      {includedItems.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </section>

  <!-- SOLUTION / 3-PHASE PROCESS -->
  <section class="container lp-section lp-solution">
    <div class="lp-section-head">
      <div class="sub-display">Die Glow-Up-Methode</div>
      <h2 class="lp-section-title">3 Phasen. 90 Minuten. Ein sichtbares Ergebnis.</h2>
      <p class="lp-section-lead">
        Carbon Microneedling kombiniert zwei Goldstandard-Behandlungen in einer einzigen Sitzung.
        Das Ergebnis: Haut, die du spürst.
      </p>
    </div>

    <div class="lp-phases">
      <div class="lp-phase">
        <div class="lp-phase-no">01</div>
        <h3>Carbon Cleaning</h3>
        <p>Eine Aktivkohle-Maske zieht tief in die Poren. Unreinheiten, Talg und abgestorbene Zellen werden sanft entfernt — die Haut atmet auf.</p>
      </div>
      <div class="lp-phase">
        <div class="lp-phase-no">02</div>
        <h3>Deep Repair</h3>
        <p>Der Microneedling-Pen setzt tausende mikrofeine Kanäle — sie aktivieren die körpereigene Kollagen- und Elastinbildung.</p>
      </div>
      <div class="lp-phase">
        <div class="lp-phase-no">03</div>
        <h3>Hyaluron Finish</h3>
        <p>Hochkonzentrierte Hyaluronsäure und Vitamine werden eingeschleust, eine beruhigende Maske besiegelt den Glow.</p>
      </div>
    </div>
  </section>

  <div class="lp-divider" aria-hidden="true"><span class="deco-line"></span></div>

  <!-- BENEFITS -->
  <section class="container lp-section lp-benefits-section">
    <div class="lp-section-head">
      <div class="sub-display">Was du bekommst</div>
      <h2 class="lp-section-title">6 Gründe für Carbon Microneedling</h2>
    </div>
    <div class="lp-benefits-grid">
      {benefits.map((b) => (
        <div class="lp-benefit">
          <div class="lp-benefit-icon-wrap">
            <BenefitIcon name={b.icon} size={28} />
          </div>
          <strong>{b.title}</strong>
          <p>{b.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- OFFER BLOCK -->
  <section class="container lp-section lp-offer">
    <OfferBox
      variant="box"
      eyebrow="Offizieller Preis"
      newPrice={OFFICIAL_PRICE}
      discountLabel="Treatwell-Katalog"
      urgency="90 Minuten · Carbon Laser Peeling + Microneedling"
      ctaText="Jetzt Platz sichern"
      ctaHref="#buchen"
    />
    <p class="lp-offer-footnote">
      Offizieller Preis laut Treatwell-Katalog: CHF {OFFICIAL_PRICE}.- für Carbon Laser Peeling + Microneedling.
    </p>
  </section>

  <div class="lp-divider" aria-hidden="true"><span class="deco-line"></span></div>

  <!-- TESTIMONIALS -->
  <section class="container lp-section lp-testimonials">
    <div class="lp-section-head">
      <div class="sub-display">Echte Ergebnisse</div>
      <h2 class="lp-section-title">Das sagen unsere Kundinnen</h2>
    </div>
    <TestimonialStrip testimonials={testimonials} />
  </section>

  <!-- ABOUT / TRUST -->
  <section class="container lp-section lp-about">
    <div class="lp-about-grid">
      <div class="lp-about-media">
        <Image
          src={teresaPortrait}
          widths={[360, 540, 720, 960, 1023]}
          sizes={lpAboutSizes}
          format="webp"
          quality="high"
          alt="Teresa Stimac, Gründerin von Beauty Face Lift Zürich"
          loading="eager"
        />
      </div>
      <div class="lp-about-content">
        <div class="sub-display margin-bottom-md">Deine Expertin</div>
        <h2 class="lp-section-title">Teresa Stimac — <em>20+ Jahre Erfahrung</em></h2>

        <blockquote class="lp-about-quote">
          <p>„Ich behandle jede Kundin wie eine Freundin. Diskretion, Präzision und ein Ergebnis, das du selbst siehst."</p>
        </blockquote>

        <p>
          Seit über 20 Jahren widmet sich Teresa der modernen Ästhetik. In ihrem Studio an der
          Bahnhofstrasse 94 verbindet sie medizinische Präzision mit einer persönlichen,
          diskreten Betreuung.
        </p>
        <ul class="lp-about-list">
          <li>Bahnhofstrasse 94 · 8001 Zürich</li>
          <li>Ausgebildete Kosmetikerin mit Spezialisierung auf Microneedling</li>
          <li>230+ fünf-Sterne-Bewertungen</li>
          <li>Mo–Fr 10:00–20:00 · Sa 09:00–16:00</li>
        </ul>
      </div>
    </div>
  </section>

  <div class="lp-divider" aria-hidden="true"><span class="deco-line"></span></div>

  <!-- FAQ -->
  <section class="container lp-section lp-faq">
    <div class="lp-section-head">
      <div class="sub-display">Häufige Fragen</div>
      <h2 class="lp-section-title">Alles, was du wissen musst</h2>
    </div>
    <FAQAccordion items={faqs} />
  </section>

  <!-- RISK REVERSAL STRIP (above booking) -->
  <section class="container lp-section lp-reassurance">
    <TrustStrip variant="promises" align="center" />
  </section>

  <!-- BOOKING -->
  <section class="container lp-section" id="buchen">
    <div class="lp-section-head">
      <div class="sub-display">Termin buchen</div>
      <h2 class="lp-section-title">Sichere dir deine Glow-Up-Sitzung</h2>
      <p class="lp-section-lead">Wähle Datum & Uhrzeit — wir bestätigen deinen Termin per E-Mail.</p>
    </div>
    <BookingWidget client:load preselectedCategory="Carbon Microneedling" />
  </section>

  <!-- FINAL CTA (full-bleed dark) -->
  <section class="lp-final-dark">
    <div class="lp-final-inner">
      <div class="sub-display lp-final-eyebrow">Noch Fragen?</div>
      <h2 class="lp-final-title">Schreib uns direkt.</h2>
      <p class="lp-final-lead">
        Kein passender Termin? Unsicher, ob die Behandlung zu dir passt? Melde dich bei Teresa —
        sie nimmt sich die Zeit und findet eine Lösung.
      </p>
      <div class="lp-final-ctas">
        <WhatsAppButton variant="inline" message={whatsappMessage} source="final" />
        <a href="tel:+41792143462" class="pill-btn pill-btn-dark">+41 79 214 34 62</a>
      </div>
      <p class="lp-final-address">
        Beauty Face Lift · Bahnhofstrasse 94 · 8001 Zürich<br>
        Mo–Fr 10:00–20:00 · Sa 09:00–16:00
      </p>
    </div>
  </section>

  <WhatsAppButton variant="sticky" message={whatsappMessage} source="sticky" />
  <StickyOfferBar newPrice={OFFICIAL_PRICE} />
</LandingPage>

<script>
  import { trackPageView, trackLead } from '../../../lib/track';

  trackPageView();

  // Surface trackLead for BookingWidget to call after a successful booking.
  (window as any).__bflTrackLead = trackLead;
</script>

<style>
  /* ═══════════════════════════════════════════════════════════════
     HERO
     ═══════════════════════════════════════════════════════════════ */
  .lp-hero {
    padding-top: 12vh;
    padding-bottom: 8vh;
  }
  .lp-hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .lp-hero-content {
    max-width: 580px;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .lp-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
  }
  .lp-eyebrow .deco-line {
    display: inline-block;
    width: 32px;
  }
  .lp-title {
    margin: 0;
    letter-spacing: 0;
    font-family: var(--font-serif);
    font-weight: 400;
    color: var(--ink);
  }
  .lp-title em {
    font-style: normal;
    font-weight: 400;
    color: var(--accent-text);
  }
  .lp-subtitle {
    font-size: 1.15rem;
    color: var(--text-secondary);
    max-width: 520px;
    margin: 0;
    line-height: 1.6;
  }
  .lp-hero-offer {
    position: relative;
    padding: 1.1rem 0 1.1rem 1.25rem;
    margin: 0.25rem 0;
    border-left: 1px solid var(--accent);
  }
  .lp-hero-ctas {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    align-items: stretch;
  }
  .lp-hero-primary {
    flex: 1 1 220px;
    min-width: 220px;
  }
  .lp-hero-ctas > :global(.wa-inline) {
    flex: 0 1 auto;
    min-width: 0;
    justify-content: center;
    text-align: center;
    white-space: nowrap;
  }
  .lp-hero-trust {
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-subtle);
    margin-top: 0.5rem;
  }
  .lp-hero-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    max-width: 640px;
    justify-self: end;
  }
  .lp-hero-media-main {
    position: absolute;
    left: 0;
    top: 8%;
    width: 62%;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-2);
    transition: transform 0.8s var(--ease-expo), box-shadow 0.5s ease;
  }
  .lp-hero-media-main img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .lp-hero-media-overlap {
    position: absolute;
    right: 0;
    top: 0;
    width: 48%;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-card);
    overflow: hidden;
    z-index: 2;
    box-shadow: var(--shadow-2);
    border: 3px solid var(--bg-primary);
    transition: transform 0.8s var(--ease-expo), box-shadow 0.5s ease;
  }
  .lp-hero-media-overlap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .lp-hero-media:hover .lp-hero-media-main {
    transform: translateY(-4px);
  }
  .lp-hero-media:hover .lp-hero-media-overlap {
    transform: translateY(-6px);
  }

  /* ═══════════════════════════════════════════════════════════════
     SECTIONS (shared)
     ═══════════════════════════════════════════════════════════════ */
  .lp-section { padding-block: 8vh; }
  .lp-section-head {
    max-width: 740px;
    margin: 0 auto 3.5rem;
    text-align: center;
  }
  .lp-section-title {
    font-size: clamp(2.2rem, 5vw, 56px);
    line-height: 1.08;
    letter-spacing: 0;
    margin-bottom: 1rem;
  }
  .lp-section-title em {
    font-style: normal;
    font-weight: 300;
    color: var(--accent-text);
  }
  .lp-section-lead {
    color: var(--text-secondary);
    font-size: 1.1rem;
    line-height: 1.65;
    max-width: 620px;
    margin: 0 auto;
  }

  /* Decorative divider between sections */
  .lp-divider {
    display: flex;
    justify-content: center;
    padding: 2vh 0;
  }
  .lp-divider .deco-line {
    width: 48px;
  }

  /* ═══════════════════════════════════════════════════════════════
     PROBLEM
     ═══════════════════════════════════════════════════════════════ */
  .lp-problem .lp-section-title {
    text-align: center;
    margin-bottom: 3rem;
  }
  .lp-problem-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 3rem;
    max-width: 1040px;
    margin: 0 auto;
  }
  .lp-problem-item {
    padding-top: 1rem;
    border-top: 1px solid var(--accent);
  }
  .lp-problem-item strong {
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2vw, 1.6rem);
    font-weight: 400;
    display: block;
    margin-bottom: 0.4rem;
    color: var(--text-primary);
    letter-spacing: 0;
  }
  .lp-problem-item p {
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.6;
    margin: 0;
  }

  /* ═══════════════════════════════════════════════════════════════
     VALUE BREAKDOWN
     ═══════════════════════════════════════════════════════════════ */
  .lp-included-list {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    max-width: 820px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem 3rem;
  }
  .lp-included-list li {
    position: relative;
    padding-left: 1.9rem;
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 300;
    color: var(--text-primary);
    line-height: 1.5;
  }
  .lp-included-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0;
    width: 22px;
    height: 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    color: #fff;
    background: var(--gold-gradient);
    border-radius: 50%;
    font-weight: 600;
  }

  /* ═══════════════════════════════════════════════════════════════
     3-PHASE SOLUTION
     ═══════════════════════════════════════════════════════════════ */
  .lp-phases {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .lp-phase {
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
