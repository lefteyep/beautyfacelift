      </div>
    </section>

    <!-- 7 · FAQ -->
    <section class="lp-section lp-section--rule lp-faq" aria-labelledby="lp-faq-title">
      <div class="container lp-faq-grid">
        <div class="lp-faq-head">
          <h2 id="lp-faq-title" class="lp-section-title">Häufige Fragen zur Behandlung</h2>
        </div>
        <FAQAccordion items={faqs} />
      </div>
    </section>

    <!-- 8 · Studio and directions; the map loads only on request (≈500 KB of scripts, data to Google) -->
    <section class="lp-section lp-section--rule lp-location" id="anfahrt" aria-labelledby="lp-location-title">
      <div class="container lp-location-grid">
        <div class="lp-location-copy">
          <h2 id="lp-location-title" class="lp-section-title">Bahnhofstrasse 94 · Zürich</h2>
          <p class="lp-section-lead">
            Beauty Face Lift liegt zentral in {ADDRESS.postalCode} {ADDRESS.city}, wenige Gehminuten vom
            Hauptbahnhof entfernt.
          </p>
          <dl class="lp-location-info" aria-label="Anfahrt und Öffnungszeiten">
            <div class="lp-location-item">
              <dt>Anreise</dt>
              <dd>Vom Zürich HB sind es wenige Gehminuten; die Tram-Haltestelle Bahnhofstrasse/HB liegt direkt in der Nähe. Parkhäuser gibt es in der Umgebung.</dd>
            </div>
            <div class="lp-location-item lp-location-hours">
              <dt>Öffnungszeiten</dt>
              <dd>
                <dl>
                  {OPENING_HOURS.map((item) => (
                    <>
                      <dt>{item.label}</dt>
                      <dd>{item.value}</dd>
                    </>
                  ))}
                </dl>
              </dd>
            </div>
          </dl>
          <a
            href={googleMapsDirectionsUrl}
            class="btn btn-secondary lp-location-route"
            target="_blank"
            rel="noopener"
            data-track-contact="maps"
            data-source="carbon_location"
          >
            Route in Google Maps öffnen
          </a>
        </div>

        <div class="lp-map-panel" id="studio-map" data-map-embed={googleMapsEmbedUrl}>
          <div class="lp-map-placeholder" data-map-placeholder>
            <button type="button" class="btn btn-secondary" data-map-load data-button-location="location_map_load">Karte laden</button>
            <p class="lp-map-note">Beim Laden der Karte werden Daten an Google übertragen.</p>
          </div>
