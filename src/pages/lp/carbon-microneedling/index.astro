---
import LandingPage from '../../../layouts/LandingPage.astro';
import FAQAccordion from '../../../components/lp/FAQAccordion.astro';
import WhatsAppButton from '../../../components/lp/WhatsAppButton.astro';
import { Image, getImage } from 'astro:assets';
// Placeholder images until the generated Carbon series lands in src/assets/lp/carbon/ (WebP).
// IMAGE SWAP 1 · hero (4:5 arch, 16:9 band on phones), also the schema and Open Graph image.
import heroCarbonImage from '../../../assets/marketing/carbon_treatment_teresa.png';
import heroCarbonUrl from '../../../assets/marketing/carbon_treatment_teresa.png?url';
// IMAGE SWAP 2 · included (skin analysis).
import hautanalyseImage from '../../../assets/marketing/consultation_trust.png';
// IMAGE SWAP 3–5 · the three steps: Carbon-Lotion, Microneedling, Nachsorge.
import carbonStepImage from '../../../assets/marketing/peeling_treatment_editorial.png';
import microneedlingStepImage from '../../../assets/marketing/microneedling_treatment_editorial.png';
import nachsorgeStepImage from '../../../assets/marketing/spa_products.png';
// IMAGE SWAP 6 · trust block: studio without a person (no portrait until its origin is clear).
import studioImage from '../../../assets/marketing/spa_interior.png';
import { ADDRESS, OPENING_HOURS, TREATWELL_URL, absoluteUrl, bookingLinkForService } from '../../../../shared/site';

const PROMO_PRICE = 175;
const REGULAR_PRICE = 250;
const SAVINGS_LABEL = 'Sie sparen CHF 75.–';
// Treatwell: Carbon Laser Peeling + Microneedling, 90 Min.
const DURATION_LABEL = '90 Min.';
// Last day of the campaign offer. Swiss price-indication rules: a "statt" price must be time-limited.
// Change only this ISO date; the visible label, FAQ 1, the closing band and the schema follow it.
const OFFER_VALID_UNTIL = '2026-11-30';
// "30. November 2026", with a no-break space so the day never stands alone at a line end.
const OFFER_VALID_UNTIL_LABEL = new Intl.DateTimeFormat('de-CH', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })
  .format(new Date(`${OFFER_VALID_UNTIL}T00:00:00Z`))
  .replace(' ', ' ');
const OFFER_LABEL = 'Carbon-Peeling + Microneedling Aktion';
const OFFER_SLUG = 'carbon-microneedling-aktion';
// One primary action on the whole page: the request form. WhatsApp is the secondary path,
// Treatwell booking the tertiary one (after success, in the FAQ and in the closing band).
const PRIMARY_CTA_LABEL = 'Unverbindlich Termin anfragen';
const STICKY_CTA_LABEL = 'Termin anfragen';
const SECONDARY_CTA_LABEL = 'Per WhatsApp anfragen';
const BOOKING_CTA_LABEL = 'Direkt online buchen';
const BOOKING_SERVICE = 'Carbon Microneedling';
// Must be one of CONTACT_TOPICS (shared/site.ts), or the Worker rejects the form (checked by qa:contact).
const CONTACT_TOPIC = 'Ich möchte einen Termin buchen';
// Exempt from Turnstile in worker/routes/contact.ts: this page has no Turnstile widget.
const CONTACT_CAMPAIGN = 'carbon_microneedling';
const CONTACT_SOURCE = 'carbon-microneedling-lp';
const LANDING_PAGE_PATH = '/lp/carbon-microneedling/';
const LEAD_FORM_ID = 'anfrage';
const LEAD_FORM_TARGET_ID = 'anfrage-form';
const bookingHref = `${bookingLinkForService(BOOKING_SERVICE)}&offer=${OFFER_SLUG}&price=${PROMO_PRICE}`;
const whatsappMessage = 'Hallo Teresa, ich interessiere mich für die Aktion Carbon-Peeling + Microneedling für CHF 175 statt CHF 250. Passt die Behandlung zu meiner Haut?';
// Desktop: the photo is cover-cropped into a 4:5 arch. Stacked (≤ 900px) it is a full-bleed 16:9 band.
const lpHeroWidths = [480, 720, 960, 1254];
const lpHeroSizes = '(min-width: 1320px) 540px, (min-width: 901px) 40vw, 100vw';
const lpHeroQuality = 86;
const lpHalfSizes = '(min-width: 1440px) 640px, (min-width: 901px) 46vw, 100vw';
const lpStepSizes = '(min-width: 1320px) 300px, (min-width: 901px) 24vw, (min-width: 421px) 38vw, 100vw';
// Word joiner after the en dash keeps "24–48" on one line.
const HOURS_24_48 = '24–⁠48 Stunden';
const studioAddress = `${ADDRESS.street}, ${ADDRESS.postalCode} ${ADDRESS.city}`;
const googleMapsEmbedUrl = `https://www.google.com/maps?q=${encodeURIComponent(`Beauty Face Lift ${studioAddress}`)}&output=embed`;
const googleMapsDirectionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(studioAddress)}`;

const lpHeroPreload = await getImage({
  src: heroCarbonImage,
  widths: lpHeroWidths,
  sizes: lpHeroSizes,
  format: 'webp',
  quality: lpHeroQuality,
});

// What is included, the outcome, who treats you. Shown on every screen size.
const heroBullets = [
  'Hautanalyse, Carbon-Peeling, Microneedling und Nachsorge-Hinweise',
  'Für einen frischer wirkenden Teint und optisch feinere Poren',
  'Persönlich durch Teresa Stimac, seit über 20 Jahren im Beruf',
];

// In treatment order, built only from the treatment description (user, 2026-10-31).
const includedItems = [
  'Hautanalyse und persönliche Abstimmung',
  'Carbon-Lotion und Laserbehandlung',
  'Microneedling, Tiefe passend zu Ihrem Hauttyp',
  'Nachsorge-Hinweise für die Tage danach',
];

// The three steps of the appointment, each with its photo.
const steps = [
  {
    title: 'Carbon-Peeling',
    text: 'Eine Carbon-Lotion wird aufgetragen und mit dem Laser behandelt. Das löst abgestorbene Hautschüppchen und kann die Poren optisch klären.',
    image: carbonStepImage,
    alt: 'Eine Lotion wird mit dem Pinsel auf das Gesicht aufgetragen',
    crop: 'lp-crop-carbon',
  },
  {
    title: 'Microneedling',
    text: 'Feine Mikroimpulse können die natürliche Hauterneuerung und ein glatter wirkendes Hautbild unterstützen. Die Tiefe wird an Ihren Hauttyp angepasst.',
    image: microneedlingStepImage,
    alt: 'Kosmetisches Microneedling mit professionellem Pen',
    crop: 'lp-crop-needling',
  },
  {
    title: 'Nachsorge',
    text: 'Sie erhalten klare Hinweise für die Tage danach: Sonnenschutz, Feuchtigkeit und eine kurze Pause von Hitze und Sport.',
    image: nachsorgeStepImage,
    alt: 'Pflegeprodukte für die Nachsorge',
    crop: 'lp-crop-aftercare',
  },
];

// Treatment goals (neutral framing, cautious claims; results vary).
const goalItems = [
  { title: 'Feiner wirkende Poren', text: 'Das Carbon-Peeling klärt die Haut optisch und kann Poren feiner wirken lassen.' },
  { title: 'Ebenmässigere Textur', text: 'Microneedling kann die natürliche Hauterneuerung und ein glatter wirkendes Hautbild unterstützen.' },
  { title: 'Frischerer Teint', text: 'Direkt nach der Behandlung kann die Haut frischer, klarer und gepflegter wirken.' },
];

// Studio facts in one hairline row; the review line links to its source (Treatwell, 261 reviews on 2026-10-31).
const studioFacts = [
  { text: '4,8 aus 260+ Bewertungen auf Treatwell', href: TREATWELL_URL },
  { text: `${ADDRESS.street}, ${ADDRESS.postalCode} ${ADDRESS.city}` },
];

// What happens after the request: two lines, shown right above the fields.
const nextSteps = [
  'Sie senden Ihren Terminwunsch – ohne Online-Zahlung.',
  'Teresa Stimac meldet sich persönlich per Telefon, WhatsApp oder E-Mail, klärt Ihre Fragen und bestätigt den Termin.',
];

const skinGoals = ['Poren', 'Hautstruktur', 'Frischer Teint', 'Ich bin unsicher'];

// Objections in the order people raise them: content and price, payment, sensation, fit, redness,
// after-care, sessions, online booking.
const faqs = [
  {
    q: 'Was ist im Angebot enthalten?',
    a: `Für CHF ${PROMO_PRICE}.– statt CHF ${REGULAR_PRICE}.– erhalten Sie eine Behandlung von ${DURATION_LABEL} mit Hautanalyse, Carbon-Peeling, Microneedling und Nachsorge-Hinweisen. Das Angebot gilt bis ${OFFER_VALID_UNTIL_LABEL}.`,
  },
  {
    q: 'Muss ich jetzt schon bezahlen?',
    a: 'Nein. Sie fragen unverbindlich an, ohne Online-Zahlung. Das Studio meldet sich bei Ihnen, bevor der Termin bestätigt wird.',
  },
  {
    q: 'Ist die Behandlung schmerzhaft?',
    a: 'Viele empfinden das Microneedling als leichtes Piksen, Druckgefühl oder Wärme. Die Intensität wird kontrolliert und individuell angepasst.',
  },
  {
    q: 'Für wen ist die Behandlung nicht geeignet?',
    a: 'Nicht bei aktiven Infektionen, entzündeter Akne, gereizter oder verletzter Haut und nicht in der Schwangerschaft. Teresa prüft die Haut vor der Behandlung und passt die Microneedling-Tiefe an Ihren Hauttyp an.',
  },
  {
    q: 'Wie lange ist die Haut gerötet?',
    a: `Direkt nach der Behandlung kann die Haut leicht gerötet sein. Je nach Hauttyp beruhigt sie sich meist schrittweise innerhalb von Stunden bis ${HOURS_24_48}.`,
  },
  {
    q: 'Was muss ich nach der Behandlung beachten?',
    a: `Täglich Sonnenschutz mit SPF 30–50, die Haut gut mit Feuchtigkeit versorgen, einige Tage keine Retinol-, Säure- oder Peelingprodukte, ${HOURS_24_48} keine Sauna, Hitze oder intensiven Sport.`,
  },
  {
    q: 'Wie viele Sitzungen sind sinnvoll?',
    a: 'Eine Sitzung kann die Haut bereits frischer wirken lassen. Für längerfristige Hautziele kann eine Serie sinnvoll sein. Das wird vor Ort realistisch eingeordnet.',
  },
  {
    q: 'Kann ich auch direkt online buchen?',
    a: 'Ja, über Treatwell. Für den ersten Besuch empfehlen wir die unverbindliche Anfrage, damit die Behandlung vorab auf Ihre Haut abgestimmt wird.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      '@id': absoluteUrl('/lp/carbon-microneedling/#product'),
      name: 'Carbon-Peeling + Microneedling Zürich',
      description: `Carbon-Peeling und Microneedling in einer Sitzung von 90 Minuten in Zürich, mit Hautanalyse und Nachsorge-Hinweisen. Aktion CHF ${PROMO_PRICE}.– statt CHF ${REGULAR_PRICE}.–.`,
      image: absoluteUrl(heroCarbonUrl),
      brand: { '@type': 'Brand', name: 'Beauty Face Lift' },
      offers: {
        '@type': 'Offer',
        priceCurrency: 'CHF',
        price: PROMO_PRICE.toFixed(2),
        availability: 'https://schema.org/InStock',
        url: absoluteUrl('/lp/carbon-microneedling/'),
        priceValidUntil: OFFER_VALID_UNTIL,
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<LandingPage
  title={`Carbon-Peeling + Microneedling Zürich | CHF ${PROMO_PRICE} statt CHF ${REGULAR_PRICE}`}
  description={`Carbon-Peeling und Microneedling in einer Sitzung von 90 Minuten an der Bahnhofstrasse 94 in Zürich. Aktion CHF ${PROMO_PRICE} statt CHF ${REGULAR_PRICE}, gültig bis ${OFFER_VALID_UNTIL_LABEL}. Unverbindlich anfragen.`}
  ogImage={heroCarbonImage}
  preloadImage={{
    href: lpHeroPreload.src,
    imagesrcset: lpHeroPreload.srcSet.attribute,
    imagesizes: lpHeroSizes,
    type: 'image/webp',
    fetchpriority: 'high',
  }}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main class="lp-page" id="main-content">
    <!-- 1 · Hero: copy left, treatment photo in the arch right (phones: message, price and CTA first, then the photo band) -->
    <section class="lp-hero" aria-labelledby="lp-hero-title" data-lp-hero>
      <div class="container lp-hero-grid">
        <div class="lp-hero-content">
          <p class="eyebrow eyebrow--rule lp-eyebrow">Aktion: Carbon-Peeling + Microneedling in Zürich</p>
          <h1 id="lp-hero-title" class="lp-title">Carbon-Peeling + Microneedling: zwei Behandlungen in einer Sitzung</h1>
          <p class="lp-subtitle">
            Erst Carbon-Peeling, dann Microneedling, persönlich von Teresa Stimac an der Bahnhofstrasse&nbsp;94 in Zürich.
          </p>

          <p class="lp-hero-offer">
            <span class="lp-hero-offer-label">Aktion · {DURATION_LABEL}</span>
            <span class="lp-hero-offer-price">CHF {PROMO_PRICE}.–</span>
            <span class="lp-hero-offer-old"><span aria-hidden="true">· </span>statt CHF {REGULAR_PRICE}.–</span>
            <span class="lp-hero-offer-old lp-hero-offer-save"><span aria-hidden="true">· </span>{SAVINGS_LABEL}</span>
            <span class="lp-hero-offer-until">Angebot gültig bis {OFFER_VALID_UNTIL_LABEL}</span>
          </p>

          <ul class="lp-hero-bullets lp-checks">
            {heroBullets.map((item) => (
              <li>{item}</li>
            ))}
          </ul>

          <div class="lp-hero-ctas">
            <a href={`#${LEAD_FORM_ID}`} class="btn lp-hero-primary" data-treatment={BOOKING_SERVICE} data-button-location="lp_hero_lead" data-lead-cta>{PRIMARY_CTA_LABEL}</a>
            <WhatsAppButton variant="link" message={whatsappMessage} source="carbon_hero" label={SECONDARY_CTA_LABEL} />
          </div>

          <p class="lp-hero-proof"><span class="lp-stars" aria-hidden="true">★★★★★</span><a href={TREATWELL_URL} target="_blank" rel="noopener noreferrer" data-button-location="lp_hero_reviews"><strong>4,8</strong> aus 260+ Bewertungen auf Treatwell</a></p>
        </div>

        <figure class="lp-hero-media" aria-label={OFFER_LABEL}>
          <Image
            src={heroCarbonImage}
            widths={lpHeroWidths}
            sizes={lpHeroSizes}
            format="webp"
            quality={lpHeroQuality}
            loading="eager"
            decoding="async"
            fetchpriority="high"
            alt="Carbon-Maske wird aufgetragen, Beauty Face Lift Zürich"
          />
        </figure>
      </div>
    </section>

    <!-- 2 · What is included -->
    <section class="lp-section lp-section--rule lp-offer" aria-labelledby="lp-offer-title">
      <div class="container lp-offer-grid">
        <figure class="lp-offer-media">
          <Image
            src={hautanalyseImage}
            widths={[360, 540, 720, 960, 1122]}
            sizes={lpStepSizes}
            format="webp"
            quality={82}
            alt="Persönliche Hautanalyse im Beauty Face Lift Studio Zürich"
            loading="lazy"
          />
        </figure>
        <div class="lp-offer-copy">
          <h2 class="lp-section-title" id="lp-offer-title">Das ist inbegriffen</h2>
          <p class="lp-section-lead">
            {DURATION_LABEL} in einer Sitzung, Schritt für Schritt auf Ihre Haut abgestimmt –
            persönlich durchgeführt von Teresa Stimac.
          </p>
          <ul class="lp-checks lp-included-list">
            {includedItems.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <div class="lp-section-cta">
            <a href={`#${LEAD_FORM_ID}`} class="btn" data-treatment={BOOKING_SERVICE} data-button-location="offer_section_lead" data-lead-cta>{PRIMARY_CTA_LABEL}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 3 · The three steps of the appointment -->
    <section class="lp-section lp-steps-section" aria-labelledby="lp-steps-title">
      <div class="container">
        <div class="lp-section-head">
          <h2 class="lp-section-title" id="lp-steps-title">So läuft die Behandlung ab</h2>
          <p class="lp-section-lead">
            Erst Carbon-Peeling, dann Microneedling, danach klare Nachsorge – drei Schritte in einem Termin.
          </p>
        </div>
        <ol class="lp-steps">
          {steps.map((step) => (
            <li class="lp-step">
              <figure class="lp-step-media">
                <Image
                  src={step.image}
                  widths={[360, 540, 720, 960, 1122]}
                  sizes={lpStepSizes}
                  format="webp"
                  quality={82}
                  alt={step.alt}
                  loading="lazy"
                  class={step.crop}
                />
              </figure>
              <div class="lp-step-copy">
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 4 · Treatment goals -->
    <section class="lp-section lp-goals" aria-labelledby="lp-goals-title">
      <div class="container">
        <div class="lp-section-head">
          <h2 id="lp-goals-title" class="lp-section-title">Typische Behandlungsziele</h2>
          <p class="lp-section-lead">
            Das Ziel ist ein ruhigeres, gepflegteres Hautbild. Weil jede Haut anders reagiert, wird das Ergebnis vor Ort ehrlich eingeordnet.
          </p>
        </div>
        <ul class="lp-rows">
          {goalItems.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 5 · Trust -->
    <section class="lp-section lp-trust" aria-labelledby="lp-trust-title">
      <div class="container lp-trust-grid">
        <figure class="lp-trust-media">
          <Image
            src={studioImage}
            widths={[360, 540, 720, 960, 1200]}
            sizes={lpHalfSizes}
            format="webp"
            quality={82}
            alt="Behandlungsraum im Beauty Face Lift Studio Zürich"
            loading="lazy"
          />
        </figure>
        <div class="lp-trust-content">
          <h2 id="lp-trust-title" class="lp-section-title">Persönlich behandelt von Teresa Stimac</h2>
          <p>
            Dipl. Visagistin &amp; Kosmetikerin, seit über 20 Jahren im Beruf und selbstständig. In ihrem Studio an der
            Bahnhofstrasse&nbsp;94 verbindet sie Präzision mit persönlicher, diskreter Betreuung.
          </p>
          <ul class="lp-checks lp-facts" aria-label="Studio und Bewertungen">
            {studioFacts.map((item) => (
              <li>
                {item.href ? (
                  <a href={item.href} target="_blank" rel="noopener noreferrer" data-button-location="trust_reviews">{item.text}</a>
                ) : (
                  <span>{item.text}</span>
                )}
              </li>
            ))}
          </ul>
          <div class="lp-section-cta">
            <a href={`#${LEAD_FORM_ID}`} class="btn" data-treatment={BOOKING_SERVICE} data-button-location="trust_section_lead" data-lead-cta>{PRIMARY_CTA_LABEL}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 6 · Lead form -->
    <section class="container lp-section lp-lead" id={LEAD_FORM_ID} aria-labelledby="lp-lead-title" tabindex="-1">
      <div class="lp-lead-grid">
        <div class="lp-lead-header">
          <h2 id="lp-lead-title" class="lp-section-title">Termin für Carbon-Peeling + Microneedling anfragen</h2>
          <p class="lp-section-lead">
            Kurz ausfüllen – Teresa Stimac meldet sich persönlich, klärt Ihre Fragen und bestätigt den Termin.
          </p>
        </div>

        <div class="lp-form-shell">
          <div class="lp-form-status" data-lead-status role="alert" hidden></div>
          <div class="lp-form-success" data-lead-success tabindex="-1" hidden>
            <h3>Vielen Dank! Ihre Anfrage ist eingegangen.</h3>
            <p>Teresa Stimac meldet sich zeitnah bei Ihnen, um den Termin für Carbon-Peeling + Microneedling abzustimmen.</p>
            <a class="lp-secondary-link" href={bookingHref} data-treatment={BOOKING_SERVICE} data-button-location="form_success_booking">{BOOKING_CTA_LABEL}</a>
          </div>

          <form id={LEAD_FORM_TARGET_ID} class="lp-lead-form" action="/api/contact" method="post" data-lead-form novalidate>
            <input type="hidden" name="topic" value={CONTACT_TOPIC} />
            <input type="hidden" name="source" value={CONTACT_SOURCE} />
            <input type="hidden" name="campaign" value={CONTACT_CAMPAIGN} />
            <input type="hidden" name="offer" value={OFFER_SLUG} />
            <input type="hidden" name="treatment" value={BOOKING_SERVICE} />
            <input type="hidden" name="landing_page" value={LANDING_PAGE_PATH} />
            <input type="hidden" name="page_path" value={LANDING_PAGE_PATH} />
            <input type="hidden" name="page_url" value="" />
            <input type="hidden" name="referrer" value="" />
            <input type="hidden" name="utm_source" value="" />
            <input type="hidden" name="utm_medium" value="" />
            <input type="hidden" name="utm_campaign" value="" />
            <input type="hidden" name="utm_content" value="" />
            <input type="hidden" name="utm_term" value="" />
            <input type="hidden" name="fbclid" value="" />
            <input type="hidden" name="gclid" value="" />
            <input type="hidden" name="msclkid" value="" />

            <ol class="lp-next-steps" aria-label="So geht es weiter">
              {nextSteps.map((step) => (
                <li>{step}</li>
              ))}
            </ol>

            <div class="lp-form-row">
              <label for="carbon-lead-name">Vor- und Nachname <span aria-hidden="true">*</span></label>
              <input id="carbon-lead-name" name="name" type="text" maxlength="120" autocomplete="name" required aria-describedby="carbon-lead-name-error" />
              <p id="carbon-lead-name-error" class="lp-field-error" data-field-error="name" hidden></p>
            </div>

            <div class="lp-form-row-grid">
              <div class="lp-form-row">
                <label for="carbon-lead-phone">Telefon / WhatsApp <span aria-hidden="true">*</span></label>
                <input id="carbon-lead-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+41 79 000 00 00" required aria-describedby="carbon-lead-phone-error" />
                <p id="carbon-lead-phone-error" class="lp-field-error" data-field-error="phone" hidden></p>
              </div>
              <div class="lp-form-row">
                <label for="carbon-lead-email">E-Mail <span class="lp-optional">(optional)</span></label>
                <input id="carbon-lead-email" name="email" type="email" inputmode="email" autocomplete="email" placeholder="name@email.ch" aria-describedby="carbon-lead-email-error" />
                <p id="carbon-lead-email-error" class="lp-field-error" data-field-error="email" hidden></p>
              </div>
            </div>

            <div class="lp-form-row-grid">
              <div class="lp-form-row">
                <label for="carbon-lead-goal">Was möchten Sie verbessern? <span class="lp-optional">(optional)</span></label>
                <div class="lp-select">
                  <select id="carbon-lead-goal" name="skinGoal">
                    <option value="">Bitte auswählen</option>
                    {skinGoals.map((goal) => (
                      <option value={goal}>{goal}</option>
                    ))}
                  </select>
                </div>
              </div>
              <div class="lp-form-row">
                <label for="carbon-lead-date">Terminwunsch <span class="lp-optional">(optional)</span></label>
                <input id="carbon-lead-date" name="preferred_date" type="date" />
              </div>
            </div>

            <div class="lp-form-row">
              <label for="carbon-lead-note">Kurze Nachricht <span class="lp-optional">(optional)</span></label>
              <textarea id="carbon-lead-note" name="leadNote" maxlength="3800" rows="3" placeholder="z. B. empfindliche Haut, wichtige Termine, bisherige Erfahrungen"></textarea>
            </div>

            <div class="lp-honeypot" aria-hidden="true" inert>
              <label for="carbon-lead-company">Firma</label>
              <input id="carbon-lead-company" name="company" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
            </div>

            <label class="lp-checkbox" for="carbon-lead-privacy">
              <input id="carbon-lead-privacy" name="privacyConsent" type="checkbox" value="yes" required aria-describedby="carbon-lead-privacy-error" />
              <span>Ich habe die <a href="/datenschutz/" target="_blank" rel="noopener">Datenschutzerklärung</a> gelesen und bin einverstanden, dass Beauty Face Lift mich zu meiner Anfrage kontaktiert.</span>
            </label>
            <p id="carbon-lead-privacy-error" class="lp-field-error" data-field-error="privacyConsent" hidden></p>

            <div class="lp-form-submit">
              <button type="submit" class="btn lp-submit" data-lead-submit data-button-location="lead_form_submit">
                <span data-submit-label>{PRIMARY_CTA_LABEL}</span>
              </button>
              <p class="lp-form-note">Keine Online-Zahlung. Das Studio meldet sich persönlich bei Ihnen.</p>
            </div>
