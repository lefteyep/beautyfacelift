    </section>

    <!-- 9 · Closing band -->
    <section class="lp-final-dark on-dark" aria-labelledby="lp-final-title">
      <div class="lp-final-inner">
        <div class="lp-final-copy">
          <h2 id="lp-final-title" class="lp-final-title">Carbon-Peeling + Microneedling für CHF&nbsp;{PROMO_PRICE}.– statt CHF&nbsp;{REGULAR_PRICE}.–</h2>
          <p class="lp-final-lead">
            Das Angebot gilt bis {OFFER_VALID_UNTIL_LABEL}. Senden Sie Ihren Terminwunsch unverbindlich – Teresa Stimac stimmt die Behandlung persönlich
            auf Ihre Haut ab.
          </p>
        </div>
        <div class="lp-final-actions">
          <div class="lp-final-ctas">
            <a href={`#${LEAD_FORM_ID}`} class="btn" data-treatment={BOOKING_SERVICE} data-button-location="lp_final_lead" data-lead-cta>{PRIMARY_CTA_LABEL}</a>
            <WhatsAppButton variant="link" message={whatsappMessage} source="carbon_final" label={SECONDARY_CTA_LABEL} />
          </div>
          <a href={bookingHref} class="lp-final-booking" data-treatment={BOOKING_SERVICE} data-button-location="lp_final_booking">{BOOKING_CTA_LABEL}</a>
          <p class="lp-final-address">Beauty Face Lift · {ADDRESS.street} · {ADDRESS.postalCode}&nbsp;{ADDRESS.city}</p>
        </div>
      </div>
    </section>

    <div class="lp-mobile-sticky on-dark" role="complementary" aria-label="Carbon-Peeling + Microneedling anfragen" data-mobile-sticky inert>
      <div class="lp-mobile-sticky-offer">
        <span>CHF {PROMO_PRICE} statt CHF {REGULAR_PRICE}</span>
        <strong>Carbon-Peeling + Microneedling</strong>
      </div>
      <a href={`#${LEAD_FORM_ID}`} class="btn lp-mobile-sticky-cta" data-treatment={BOOKING_SERVICE} data-button-location="sticky_lead" data-lead-cta>{STICKY_CTA_LABEL}</a>
    </div>

    <WhatsAppButton variant="sticky" message={whatsappMessage} source="carbon_floating_whatsapp" label="Per WhatsApp anfragen" />
  </main>

  <script>
    const attributionKeys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'fbclid', 'gclid', 'msclkid'];

    const fieldMessages = {
      name: 'Bitte geben Sie Ihren Namen an.',
      phone: 'Bitte geben Sie eine gültige Telefonnummer an.',
      email: 'Bitte geben Sie eine gültige E-Mail-Adresse an.',
      privacyConsent: 'Bitte bestätigen Sie die Datenschutzerklärung.',
    };
    const SEND_ERROR = 'Ihre Anfrage konnte gerade nicht gesendet werden. Bitte versuchen Sie es erneut oder schreiben Sie uns direkt per WhatsApp.';

    function getStoredAttribution(): Record<string, string> {
      try {
        return JSON.parse(sessionStorage.getItem('bfl_utm') || '{}') || {};
      } catch {
        return {};
      }
    }

    function fieldValue(form: HTMLFormElement, name: string) {
      const field = form.elements.namedItem(name);
      if (!field) return '';
      if (field instanceof RadioNodeList) return String(field.value || '').trim();
      return String((field as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement).value || '').trim();
    }

    function setFieldError(form: HTMLFormElement, name: string, message: string) {
      const error = form.querySelector<HTMLElement>(`[data-field-error="${name}"]`);
      const field = form.elements.namedItem(name);
      if (error) {
        error.textContent = message;
        error.hidden = !message;
      }
      if (field instanceof HTMLElement) field.setAttribute('aria-invalid', message ? 'true' : 'false');
    }

    function clearErrors(form: HTMLFormElement) {
      Object.keys(fieldMessages).forEach((name) => setFieldError(form, name, ''));
    }

    // Same rules as the Worker, so the browser never accepts what the server would reject.
    function isValidEmail(email: string) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    }

    function isValidPhone(phone: string) {
      const digits = phone.replace(/\D/g, '');
      return digits.length >= 8 && digits.length <= 15;
    }

    function validateLeadForm(form: HTMLFormElement) {
      clearErrors(form);
      let valid = true;

      if (!fieldValue(form, 'name')) {
        setFieldError(form, 'name', fieldMessages.name);
        valid = false;
      }

      const phone = fieldValue(form, 'phone');
      if (!phone || !isValidPhone(phone)) {
        setFieldError(form, 'phone', fieldMessages.phone);
        valid = false;
      }

      const email = fieldValue(form, 'email');
      if (email && !isValidEmail(email)) {
        setFieldError(form, 'email', fieldMessages.email);
        valid = false;
      }

      const privacy = form.elements.namedItem('privacyConsent');
      if (!(privacy instanceof HTMLInputElement) || !privacy.checked) {
        setFieldError(form, 'privacyConsent', fieldMessages.privacyConsent);
        valid = false;
      }

      return valid;
    }

    function setHiddenValue(form: HTMLFormElement, name: string, value: string) {
      const input = form.elements.namedItem(name);
      if (input instanceof HTMLInputElement) input.value = value || '';
    }

    function fillAttribution(form: HTMLFormElement) {
      const params = new URLSearchParams(window.location.search);
      const stored = getStoredAttribution();
      attributionKeys.forEach((key) => {
        setHiddenValue(form, key, params.get(key) || stored[key] || '');
      });
      setHiddenValue(form, 'page_path', window.location.pathname);
      setHiddenValue(form, 'page_url', window.location.href);
      setHiddenValue(form, 'referrer', document.referrer);
    }

    // The Worker reads the JSON keys below; the free-text fields are folded into one message.
    function formPayload(form: HTMLFormElement) {
      const data = new FormData(form);
      const payload: Record<string, string> = {};
      data.forEach((value, key) => {
        payload[key] = typeof value === 'string' ? value : '';
      });
      const skinGoal = (payload.skinGoal || '').trim();
      const note = (payload.leadNote || '').trim();
      payload.message = [
        'Carbon-Peeling + Microneedling Terminwunsch',
        skinGoal ? `Hautziel: ${skinGoal}` : '',
        note ? `Nachricht: ${note}` : '',
      ].filter(Boolean).join('\n');
      payload.preferredDate = payload.preferred_date || '';
      payload.skinConcern = skinGoal;
      return payload;
    }

    function initLeadForm() {
      const form = document.querySelector('[data-lead-form]');
      if (!(form instanceof HTMLFormElement)) return;

      const status = document.querySelector('[data-lead-status]');
      const success = document.querySelector('[data-lead-success]');
      const submit = form.querySelector('[data-lead-submit]');
      const submitLabel = form.querySelector('[data-submit-label]');
      const idleLabel = submitLabel?.textContent || '';
      let pending = false;
      let tracked = false;

      fillAttribution(form);

      const dateInput = form.querySelector('#carbon-lead-date');
      if (dateInput instanceof HTMLInputElement) {
        const today = new Date();
        dateInput.min = [today.getFullYear(), String(today.getMonth() + 1).padStart(2, '0'), String(today.getDate()).padStart(2, '0')].join('-');
      }

      // Typing in a field clears only that field's message; the others stay until fixed.
      const clearOwnError = (event: Event) => {
        const target = event.target;
        if (target instanceof HTMLInputElement || target instanceof HTMLSelectElement || target instanceof HTMLTextAreaElement) {
          if (target.name in fieldMessages) setFieldError(form, target.name, '');
        }
      };
      form.addEventListener('input', clearOwnError);
      form.addEventListener('change', clearOwnError);

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (pending) return;
        fillAttribution(form);

        if (!validateLeadForm(form)) {
          const firstInvalid = form.querySelector('[aria-invalid="true"]');
          if (firstInvalid instanceof HTMLElement) firstInvalid.focus();
          return;
        }

        pending = true;
        if (status instanceof HTMLElement) status.hidden = true;
        if (submit instanceof HTMLButtonElement) submit.disabled = true;
        if (submitLabel instanceof HTMLElement) submitLabel.textContent = 'Anfrage wird gesendet ...';

        try {
          const payload = formPayload(form);
          const response = await fetch(form.action, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
            },
            body: JSON.stringify(payload),
          });

          if (!response.ok) {
            // The Worker answers with its own German message (validation, rate limit); show it when present.
            let serverMessage = '';
            try {
              const body = await response.json();
              if (body && typeof body.error === 'string') serverMessage = body.error.trim();
            } catch { /* no JSON body */ }
            throw new Error(serverMessage || SEND_ERROR);
          }

          form.hidden = true;
          if (success instanceof HTMLElement) {
            success.hidden = false;
            success.focus();
          }
          document.body.classList.add('lp-lead-success');

          // The lead counts only once the server accepted the enquiry.
          if (!tracked) {
            tracked = true;
            void window.bflTracking?.trackLead?.({
              source: 'carbon_microneedling_lp_form',
              value: 175,
              currency: 'CHF',
              email: payload.email || '',
              phone: payload.phone || '',
            });
          }
        } catch (error) {
          if (status instanceof HTMLElement) {
            status.textContent = error instanceof Error ? error.message : SEND_ERROR;
            status.hidden = false;
            status.tabIndex = -1;
            status.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' });
            status.focus({ preventScroll: true });
          }
        } finally {
          pending = false;
          if (!form.hidden && submit instanceof HTMLButtonElement) submit.disabled = false;
          if (!form.hidden && submitLabel instanceof HTMLElement) submitLabel.textContent = idleLabel;
        }
      });
    }

    function initLeadScroll() {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.querySelectorAll<HTMLAnchorElement>('[data-lead-cta]').forEach((link) => {
        link.addEventListener('click', (event) => {
          window.dataLayer?.push({
            event: 'cta_click_lead_form',
            button_location: link.getAttribute('data-button-location') || 'carbon_lp',
            treatment_name: 'Carbon Microneedling',
          });
          const target = document.querySelector('#anfrage');
          if (!(target instanceof HTMLElement)) return;
          event.preventDefault();
          target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
          // Keyboard and screen-reader users continue inside the form, not from the button they left.
          target.focus({ preventScroll: true });
        });
      });
    }

    // Floating UI rules, as on /lp/aquafacial-microneedling/: the sticky bar appears once the hero has left the
    // viewport; the floating WhatsApp disc after 25 % scroll depth (WhatsAppButton). Both step aside
    // while the lead form is on screen and stay hidden while the consent banner is open (CSS).
    function initFloatingUi() {
      const body = document.body;
      const hero = document.querySelector('[data-lp-hero]');
      const leadSection = document.querySelector('#anfrage');
      const sticky = document.querySelector('[data-mobile-sticky]');
      let pastHero = false;
      let formInView = false;

      function syncSticky() {
        const visible = pastHero && !formInView;
        body.classList.toggle('lp-sticky-visible', visible);
        if (sticky instanceof HTMLElement) sticky.inert = !visible;
      }

      if (!('IntersectionObserver' in window)) return;
      if (hero) {
        new IntersectionObserver((entries) => {
          const entry = entries[entries.length - 1];
          pastHero = !entry.isIntersecting && entry.boundingClientRect.top < 0;
          syncSticky();
        }).observe(hero);
      }
      if (leadSection) {
        new IntersectionObserver((entries) => {
          const entry = entries[entries.length - 1];
          formInView = entry.isIntersecting;
          body.classList.toggle('lp-form-in-view', formInView);
          syncSticky();
        }).observe(leadSection);
      }
    }

    // Click-to-load map, as on /kontakt/.
    function initMap() {
      document.querySelectorAll<HTMLButtonElement>('[data-map-load]').forEach((button) => {
        button.addEventListener('click', () => {
          const panel = button.closest<HTMLElement>('[data-map-embed]');
          if (!panel) return;
          const frame = document.createElement('iframe');
          frame.title = 'Karte mit Beauty Face Lift an der Bahnhofstrasse 94 in Zürich';
          frame.src = panel.dataset.mapEmbed || '';
          frame.referrerPolicy = 'no-referrer-when-downgrade';
          frame.allowFullscreen = true;
          frame.loading = 'lazy';
          panel.querySelector('[data-map-placeholder]')?.remove();
          panel.appendChild(frame);
          frame.focus();
        });
      });
    }

    initLeadForm();
    initLeadScroll();
    initFloatingUi();
    initMap();
  </script>
</LandingPage>

<style>
