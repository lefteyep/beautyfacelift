---
import LandingPage from '../../../layouts/LandingPage.astro';
import BookingCta from '../../../components/BookingCta.astro';
import OfferBox from '../../../components/lp/OfferBox.astro';
import WhatsAppButton from '../../../components/lp/WhatsAppButton.astro';
import FAQAccordion from '../../../components/lp/FAQAccordion.astro';
import TestimonialStrip from '../../../components/lp/TestimonialStrip.astro';
import BenefitIcon from '../../../components/lp/BenefitIcon.astro';
import TrustStrip from '../../../components/lp/TrustStrip.astro';
import StickyOfferBar from '../../../components/lp/StickyOfferBar.astro';
import { Image, getImage } from 'astro:assets';
import { carbonTreatmentTeresa, microneedlingCard, teresaPortrait } from '../../../lib/site-images';
import { absoluteUrl, bookingLinkForService } from '../../../../shared/site';

const PROMO_PRICE = 169;
const REGULAR_PRICE = 220;
const SAVINGS_LABEL = 'Sie sparen CHF 51.-';
const bookingHref = `${bookingLinkForService('Carbon Microneedling')}&offer=glow-up-aktion&price=${PROMO_PRICE}`;
const lpHeroMainSizes = '(min-width: 1101px) 32vw, (min-width: 601px) 340px, 62vw';
const lpHeroOverlapSizes = '(min-width: 1101px) 24vw, (min-width: 601px) 260px, 48vw';
const lpAboutSizes = '(min-width: 1101px) 48vw, (min-width: 601px) 520px, 100vw';
const lpHeroPreload = await getImage({
  src: microneedlingCard,
  widths: [480, 720, 960, 1200, 1536],
  sizes: lpHeroMainSizes,
  format: 'webp',
  quality: 'high',
});

const whatsappMessage = 'Hallo Teresa, ich interessiere mich für die Glow-Up Aktion: Carbon Peeling + Microneedling für CHF 169 statt CHF 220.';

const heroBullets = [
  'Poren wirken feiner',
  'Frischer wirkender Glow',
  '90 Minuten inkl. Hautanalyse, Carbon Peeling, Microneedling & Hyaluron-Finish',
  '20+ Jahre Erfahrung · 4.8/5 aus 248+ Bewertungen',
];

const benefits = [
  { icon: 'droplet' as const, title: 'Hydratisiertes Hautgefühl', text: 'Hyaluron & Vitamine pflegen die Haut intensiv nach der Behandlung.' },
  { icon: 'sun' as const, title: 'Frischer Glow', text: 'Die Haut kann direkt frischer, klarer und gepflegter wirken.' },
  { icon: 'leaf' as const, title: 'Weichere Linien', text: 'Feine Linien können optisch sanfter erscheinen, ohne unrealistische Versprechen.' },
  { icon: 'activity' as const, title: 'Regenerations-Impuls', text: 'Microneedling unterstützt die natürliche Hauterneuerung und Struktur.' },
  { icon: 'target' as const, title: 'Feiner wirkende Poren', text: 'Carbon Peeling hilft, die Haut optisch zu klären und Poren feiner wirken zu lassen.' },
  { icon: 'trending-up' as const, title: 'Bessere Pflegeaufnahme', text: 'Die vorbereitete Haut nimmt hochwertige Wirkstoffe besonders gut auf.' },
];

const includedItems = [
  'Reinigung & Hautanalyse',
  'Carbon-Aktivkohle-Peeling',
  'Microneedling mit professionellem Pen',
  'Hyaluron- & Vitamin-Infusion',
  'Beruhigende Abschlussmaske',
  'Persönliche After-Care-Beratung',
];

const comparisonItems = [
  { title: 'Klären', text: 'Carbon Peeling bereitet die Haut vor und entfernt überschüssigen Talg sowie Hautschüppchen.' },
  { title: 'Struktur unterstützen', text: 'Microneedling kann die natürliche Regeneration und ein glatter wirkendes Hautbild unterstützen.' },
  { title: 'Beruhigen & pflegen', text: 'Hyaluron, Vitamine und Abschlussmaske sorgen für ein gepflegtes Finish.' },
];

const expectationItems = [
  { title: 'Direkt danach', text: 'Die Haut kann frischer wirken und leicht gerötet sein.' },
  { title: '24-48 Stunden', text: 'Rötungen beruhigen sich meist; die Haut fühlt sich gepflegter an.' },
  { title: 'Danach', text: 'Die Hautstruktur kann glatter und der Teint ebenmässiger erscheinen.' },
];

const processSteps = [
  { title: 'Termin über Treatwell wählen', text: 'Sie gelangen über unsere Tracking-Brücke direkt zur finalen Treatwell-Buchung.' },
  { title: 'Studio an der Bahnhofstrasse besuchen', text: 'Beauty Face Lift befindet sich zentral an der Bahnhofstrasse 94 in Zürich.' },
  { title: '90 Minuten Glow-Up Behandlung', text: 'Teresa führt Hautanalyse, Carbon Peeling, Microneedling und Finish persönlich durch.' },
  { title: 'After-Care mitnehmen', text: 'Sie erhalten klare Hinweise, wie Sie Ihre Haut nach der Behandlung pflegen.' },
];

const testimonials = [
  {
    text: 'Nach nur einer Sitzung hatte ich wirklich diesen frischen Glow. Teresa nimmt sich Zeit und erklärt jeden Schritt.',
    name: 'Laura M.',
    role: 'Zürich',
  },
  {
    text: 'Die Kombi aus Carbon und Microneedling hat mein Hautbild gepflegt und feiner wirken lassen. Absolut empfehlenswert!',
    name: 'Sandra B.',
    role: 'Zollikon',
  },
  {
    text: 'Professionell, sauber, meist keine Ausfallzeit. Ich war am Abend wieder gesellschaftsfähig — mit besserer Haut.',
    name: 'Marina K.',
    role: 'Zürich',
  },
  // TODO: real testimonial #4 — Teresa to supply { text, name, role } before campaign launch
  // TODO: real testimonial #5 — Teresa to supply { text, name, role } before campaign launch
];

const faqs = [
  {
    q: 'Ist die Behandlung schmerzhaft?',
    a: 'Vor dem Microneedling wird eine betäubende Creme aufgetragen. Die meisten Kundinnen spüren nur ein leichtes Kribbeln oder Druckgefühl.',
  },
  {
    q: 'Wie lange ist die Haut gerötet?',
    a: 'Die Haut kann direkt nach der Behandlung gerötet sein. Das beruhigt sich meist innert Stunden, je nach Hauttyp auch innerhalb von 24-48 Stunden.',
  },
  {
    q: 'Wie viele Sitzungen brauche ich?',
    a: 'Eine Sitzung kann bereits frischer wirken lassen. Für längerfristige Hautziele empfiehlt Teresa je nach Hautbild eine Serie mehrerer Behandlungen.',
  },
  {
    q: 'Für wen ist Carbon Microneedling geeignet?',
    a: 'Teresa prüft das Hautbild vor Ort und bespricht, ob die Kombination zu den gewünschten Behandlungszielen passt. Nicht empfohlen bei akuter Akne, Schwangerschaft oder offenen Hautstellen.',
  },
  {
    q: 'Was ist im Preis inbegriffen?',
    a: `Die komplette 90-Minuten-Behandlung: Reinigung, Hautanalyse, Carbon Peeling, Microneedling, Hyaluron-Finish, beruhigende Abschlussmaske und After-Care-Beratung. Die Glow-Up Aktion kostet CHF ${PROMO_PRICE} statt CHF ${REGULAR_PRICE}.`,
  },
  {
    q: 'Wo buche ich den Termin?',
    a: 'Die finale Terminbuchung läuft über Treatwell. Ihre Behandlungsangabe wird über unsere Buchungsseite übernommen.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      '@id': absoluteUrl('/lp/carbon-microneedling/#product'),
      name: 'Carbon Microneedling — Glow-Up-Methode',
      description: `Glow-Up Aktion in Zürich: Carbon Peeling + Microneedling + Hyaluron-Finish für CHF ${PROMO_PRICE} statt CHF ${REGULAR_PRICE}.`,
      image: absoluteUrl('/assets/microneedling_treatment_editorial.png'),
      brand: { '@type': 'Brand', name: 'Beauty Face Lift' },
      offers: {
        '@type': 'Offer',
        priceCurrency: 'CHF',
        price: PROMO_PRICE.toFixed(2),
        availability: 'https://schema.org/InStock',
        url: absoluteUrl('/lp/carbon-microneedling/'),
        priceValidUntil: '2026-12-31',
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<LandingPage
  title="Glow-Up Aktion Zürich — CHF 169 statt CHF 220 | Beauty Face Lift"
  description="Carbon Peeling + Microneedling an der Bahnhofstrasse Zürich. Glow-Up Aktion für feinere Poren, frischen Glow und glatter wirkende Haut: CHF 169 statt CHF 220."
  preloadImage={{
    href: lpHeroPreload.src,
    imagesrcset: lpHeroPreload.srcSet.attribute,
    imagesizes: lpHeroMainSizes,
    type: 'image/webp',
    fetchpriority: 'high',
  }}
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!-- HERO -->
  <section class="container lp-hero">
    <div class="lp-hero-grid">
      <div class="lp-hero-content">
        <div class="sub-display lp-eyebrow">
          <span class="deco-line" aria-hidden="true"></span>
          Glow-Up Aktion · Bahnhofstrasse Zürich
        </div>
        <h1 class="lp-title display-text">Carbon Peeling + Microneedling für frischer wirkende, feinere Haut</h1>
        <p class="lp-subtitle">
          Die 2-in-1 Premium-Gesichtsbehandlung für verfeinerte Poren, glatter wirkende
          Hauttextur und einen frischen Glow. Persönlich bei Teresa Stimac in Zürich.
        </p>

        <div class="lp-hero-offer">
          <OfferBox
            variant="chip"
            oldPrice={REGULAR_PRICE}
            newPrice={PROMO_PRICE}
            discountLabel="Glow-Up Aktion"
            urgency={`statt CHF ${REGULAR_PRICE}.- · ${SAVINGS_LABEL} · Buchung über Treatwell`}
          />
        </div>

        <div class="lp-hero-ctas">
          <a href={bookingHref} class="pill-btn lp-hero-primary" data-treatment="Carbon Microneedling" data-button-location="lp_hero">Termin für CHF 169 sichern</a>
          <WhatsAppButton variant="inline" message={whatsappMessage} source="hero" label="Frage per WhatsApp" />
        </div>

        <div class="lp-hero-trust">
          <TrustStrip variant="rating" align="left" />
        </div>

        <ul class="lp-hero-bullets">
          {heroBullets.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>

      <div class="lp-hero-media">
        <div class="lp-hero-media-main">
          <Image
            src={microneedlingCard}
            widths={[360, 540, 720, 960, 1122]}
            sizes={lpHeroMainSizes}
            format="webp"
            quality="high"
            priority
            alt="Microneedling Behandlung mit professionellem Pen bei Beauty Face Lift Zürich"
          />
        </div>
        <div class="lp-hero-media-overlap">
          <Image
            src={carbonTreatmentTeresa}
            widths={[320, 480, 640, 800]}
            sizes={lpHeroOverlapSizes}
            format="webp"
            quality="high"
            loading="eager"
            alt="Teresa Stimac bei der Carbon-Microneedling-Behandlung mit Aktivkohle-Maske im Beauty Face Lift Studio Zürich"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- PROBLEM -->
  <section class="container lp-section lp-problem">
    <h2 class="lp-section-title">Typische Behandlungsziele</h2>
    <div class="lp-problem-grid">
      <div class="lp-problem-item">
        <strong>Feiner wirkende Poren</strong>
        <p>Das Ziel ist ein ruhigeres, gepflegteres Hautbild.</p>
      </div>
      <div class="lp-problem-item">
        <strong>Ebenmässigere Textur</strong>
        <p>Die Behandlung ist auf eine glatter wirkende Hautoberfläche ausgerichtet.</p>
      </div>
      <div class="lp-problem-item">
        <strong>Frischerer Teint</strong>
        <p>Carbon Peeling und Hyaluron-Finish unterstützen einen gepflegten Glow.</p>
      </div>
      <div class="lp-problem-item">
        <strong>Intensiveres Pflegegefühl</strong>
        <p>Die Behandlung verbindet Hautvorbereitung, Microneedling und Wirkstoffpflege.</p>
      </div>
    </div>
  </section>

  <div class="lp-divider" aria-hidden="true"><span class="deco-line"></span></div>

  <!-- VALUE BREAKDOWN -->
  <section class="container lp-section lp-included">
    <div class="lp-section-head">
      <div class="sub-display">Enthalten im Preis</div>
      <h2 class="lp-section-title">Was Sie bei jeder Sitzung erhalten</h2>
      <p class="lp-section-lead">
        90 Minuten. Sechs Schritte. Eine klare Glow-Up Aktion für CHF {PROMO_PRICE}.–
        statt CHF {REGULAR_PRICE}.–.
      </p>
    </div>
    <ul class="lp-included-list">
      {includedItems.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </section>

  <!-- SOLUTION / 3-PHASE PROCESS -->
  <section class="container lp-section lp-solution">
    <div class="lp-section-head">
      <div class="sub-display">Die Glow-Up-Methode</div>
      <h2 class="lp-section-title">3 Phasen. 90 Minuten. Ein gepflegter Glow.</h2>
      <p class="lp-section-lead">
        Carbon Peeling klärt die Haut optisch, Microneedling unterstützt die Hautstruktur,
        und das Hyaluron-Finish beruhigt und pflegt.
      </p>
    </div>

    <div class="lp-phases">
      <div class="lp-phase">
        <div class="lp-phase-no">01</div>
        <h3>Carbon Peeling</h3>
        <p>Die Haut wird gründlich vorbereitet. Überschüssiger Talg und abgestorbene Hautschüppchen werden sanft gelöst.</p>
      </div>
      <div class="lp-phase">
        <div class="lp-phase-no">02</div>
        <h3>Microneedling</h3>
        <p>Der professionelle Pen setzt mikrofeine Impulse und kann die natürliche Regeneration sowie eine glatter wirkende Textur unterstützen.</p>
      </div>
      <div class="lp-phase">
        <div class="lp-phase-no">03</div>
        <h3>Hyaluron Finish</h3>
        <p>Hyaluron, Vitamine und eine beruhigende Maske runden die Behandlung mit einem gepflegten Hautgefühl ab.</p>
      </div>
    </div>
  </section>

  <!-- WHY 2-IN-1 -->
  <section class="container lp-section lp-combo">
    <div class="lp-section-head">
      <div class="sub-display">Warum die 2-in-1 Kombi</div>
      <h2 class="lp-section-title">Erst klären. Dann stimulieren. Dann pflegen.</h2>
      <p class="lp-section-lead">
        Die Kombination ist ideal, wenn Sie nicht nur einen kurzen Frischemoment möchten,
        sondern eine intensivere Behandlung für Teint, Poren und Hautstruktur.
      </p>
    </div>
    <div class="lp-combo-grid">
      {comparisonItems.map((item) => (
        <div class="lp-combo-card">
          <strong>{item.title}</strong>
          <p>{item.text}</p>
        </div>
      ))}
    </div>
    <div class="lp-section-cta">
      <a href={bookingHref} class="pill-btn" data-treatment="Carbon Microneedling" data-button-location="combo_section">2-in-1 Behandlung buchen</a>
    </div>
  </section>

  <div class="lp-divider" aria-hidden="true"><span class="deco-line"></span></div>

  <!-- BENEFITS -->
  <section class="container lp-section lp-benefits-section">
    <div class="lp-section-head">
      <div class="sub-display">Ihr Glow-Up</div>
      <h2 class="lp-section-title">6 Gründe für Carbon Peeling + Microneedling</h2>
      <p class="lp-section-lead">
        Das Ziel: ein frischerer, glatter wirkender Teint, feiner erscheinende Poren
        und ein gepflegtes Hautgefühl.
      </p>
    </div>
    <div class="lp-benefits-grid">
      {benefits.map((b) => (
        <div class="lp-benefit">
          <div class="lp-benefit-icon-wrap">
            <BenefitIcon name={b.icon} size={28} />
          </div>
          <strong>{b.title}</strong>
          <p>{b.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- OFFER BLOCK -->
  <section class="container lp-section lp-offer">
    <OfferBox
      variant="box"
      eyebrow="Glow-Up Aktion Zürich"
      oldPrice={REGULAR_PRICE}
      newPrice={PROMO_PRICE}
      discountLabel={SAVINGS_LABEL}
      urgency={`statt CHF ${REGULAR_PRICE}.- · 90 Minuten · Buchung über Treatwell`}
      ctaText="Termin für CHF 169 sichern"
      ctaHref={bookingHref}
    />
    <p class="lp-offer-footnote">
      Carbon Peeling + Microneedling für CHF {PROMO_PRICE}.– statt CHF {REGULAR_PRICE}.–.
      Die Terminbuchung läuft über Treatwell. Ihre Behandlungsangabe wird übernommen.
    </p>
  </section>

  <div class="lp-divider" aria-hidden="true"><span class="deco-line"></span></div>

  <!-- TESTIMONIALS -->
  <section class="container lp-section lp-testimonials">
    <div class="lp-section-head">
      <div class="sub-display">Echte Ergebnisse</div>
      <h2 class="lp-section-title">Das sagen unsere Kundinnen</h2>
    </div>
    <TestimonialStrip testimonials={testimonials} />
  </section>

  <!-- RESULT EXPECTATION -->
  <section class="container lp-section lp-expectation">
    <div class="lp-section-head">
      <div class="sub-display">Realistische Erwartung</div>
      <h2 class="lp-section-title">Was nach der Behandlung möglich ist</h2>
      <p class="lp-section-lead">
        Die Haut kann frischer wirken und sich glatter anfühlen. Leichte Rötungen sind möglich
        und beruhigen sich meist innerhalb von 24-48 Stunden.
      </p>
    </div>
    <div class="lp-expectation-grid">
      {expectationItems.map((item) => (
        <div class="lp-expectation-card">
          <strong>{item.title}</strong>
          <p>{item.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ABOUT / TRUST -->
  <section class="container lp-section lp-about">
    <div class="lp-about-grid">
      <div class="lp-about-media">
        <Image
          src={teresaPortrait}
          widths={[360, 540, 720, 960, 1023]}
          sizes={lpAboutSizes}
          format="webp"
          quality="high"
          alt="Teresa Stimac, Gründerin von Beauty Face Lift Zürich"
          loading="eager"
        />
      </div>
      <div class="lp-about-content">
        <div class="sub-display margin-bottom-md">Ihre Expertin</div>
        <h2 class="lp-section-title">Teresa Stimac — <em>20+ Jahre Erfahrung</em></h2>

        <blockquote class="lp-about-quote">
          <p>„Ich nehme mir Zeit für jede Kundin. Diskretion, Präzision und ein Ergebnis, das natürlich gepflegt wirkt."</p>
        </blockquote>

        <p>
          Seit über 20 Jahren widmet sich Teresa der modernen Ästhetik. In ihrem Studio an der
          Bahnhofstrasse 94 verbindet sie professionelle Präzision mit einer persönlichen,
          diskreten Betreuung.
        </p>
        <ul class="lp-about-list">
          <li>Bahnhofstrasse 94 · 8001 Zürich</li>
          <li>Ausgebildete Kosmetikerin mit Spezialisierung auf Microneedling</li>
          <li>248+ Bewertungen</li>
          <li>Mo–Fr 10:00–20:00 · Sa 09:00–16:00</li>
        </ul>
      </div>
    </div>
  </section>

  <div class="lp-divider" aria-hidden="true"><span class="deco-line"></span></div>

  <!-- PROCESS -->
  <section class="container lp-section lp-process">
    <div class="lp-section-head">
      <div class="sub-display">Ablauf</div>
      <h2 class="lp-section-title">So funktioniert Ihre Buchung</h2>
      <p class="lp-section-lead">
        Der schnellste Weg zur Glow-Up Aktion führt über Treatwell. Unsere Seite übergibt
        die Behandlungsangabe und Ihre Kampagnenparameter an die finale Buchung.
      </p>
    </div>
    <div class="lp-process-grid">
      {processSteps.map((step, index) => (
        <div class="lp-process-step">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <strong>{step.title}</strong>
          <p>{step.text}</p>
        </div>
      ))}
    </div>
    <div class="lp-section-cta">
      <a href={bookingHref} class="pill-btn" data-treatment="Carbon Microneedling" data-button-location="process_section">Freien Termin wählen</a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="container lp-section lp-faq">
    <div class="lp-section-head">
      <div class="sub-display">Häufige Fragen</div>
      <h2 class="lp-section-title">Alles, was Sie wissen sollten</h2>
    </div>
    <FAQAccordion items={faqs} />
  </section>

  <!-- RISK REVERSAL STRIP (above booking) -->
  <section class="container lp-section lp-reassurance">
    <TrustStrip variant="promises" align="center" />
  </section>

  <!-- BOOKING -->
  <section class="container lp-section" id="buchen">
    <div class="lp-section-head">
      <div class="sub-display">Termin buchen</div>
      <h2 class="lp-section-title">Sichern Sie sich Ihre Glow-Up-Sitzung</h2>
      <p class="lp-section-lead">Die Terminbuchung läuft über Treatwell. Ihre Behandlungsangabe wird übernommen.</p>
    </div>
    <BookingCta
      treatment="Carbon Microneedling"
      href={bookingHref}
      title="Carbon Peeling + Microneedling Termin buchen"
      text="Die Terminbuchung läuft über Treatwell. Ihre Behandlungsangabe wird übernommen."
      ctaText="Termin für CHF 169 sichern"
    />
  </section>

  <!-- FINAL CTA (full-bleed dark) -->
  <section class="lp-final-dark">
    <div class="lp-final-inner">
      <div class="sub-display lp-final-eyebrow">Glow-Up Aktion</div>
      <h2 class="lp-final-title">Sichern Sie sich Ihre Behandlung.</h2>
      <p class="lp-final-lead">
        Sichern Sie sich Ihre Glow-Up Aktion in Zürich: Carbon Peeling + Microneedling
        für CHF {PROMO_PRICE}.– statt CHF {REGULAR_PRICE}.–. Persönlich behandelt
        bei Beauty Face Lift an der Bahnhofstrasse.
      </p>
      <div class="lp-final-ctas">
        <a href={bookingHref} class="pill-btn" data-treatment="Carbon Microneedling" data-button-location="lp_final_booking">Termin für CHF 169 sichern</a>
        <WhatsAppButton variant="inline" message={whatsappMessage} source="final" label="Frage per WhatsApp" />
        <a href="tel:+41792143462" class="pill-btn pill-btn-dark" data-button-location="lp_final_phone">+41 79 214 34 62</a>
      </div>
      <p class="lp-final-address">
        Beauty Face Lift · Bahnhofstrasse 94 · 8001 Zürich<br>
        Mo–Fr 10:00–20:00 · Sa 09:00–16:00
      </p>
    </div>
  </section>

  <WhatsAppButton variant="sticky" message={whatsappMessage} source="sticky" />
  <StickyOfferBar oldPrice={REGULAR_PRICE} newPrice={PROMO_PRICE} href={bookingHref} ctaText="Termin sichern" />
</LandingPage>

<style>
  /* ═══════════════════════════════════════════════════════════════
     HERO
     ═══════════════════════════════════════════════════════════════ */
  .lp-hero {
    padding-top: 4vh;
    padding-bottom: 5vh;
  }
  .lp-hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .lp-hero-content {
    max-width: 660px;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .lp-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
  }
  .lp-eyebrow .deco-line {
    display: inline-block;
    width: 32px;
  }
  .lp-title {
