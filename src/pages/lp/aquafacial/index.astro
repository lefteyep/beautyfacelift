---
import LandingPage from '../../../layouts/LandingPage.astro';
import BookingCta from '../../../components/BookingCta.astro';
import OfferBox from '../../../components/lp/OfferBox.astro';
import FAQAccordion from '../../../components/lp/FAQAccordion.astro';
import BenefitIcon from '../../../components/lp/BenefitIcon.astro';
import TrustStrip from '../../../components/lp/TrustStrip.astro';
import StickyOfferBar from '../../../components/lp/StickyOfferBar.astro';
import WhatsAppButton from '../../../components/lp/WhatsAppButton.astro';
import { Image } from 'astro:assets';
import heroAquafacialImage from '../../../assets/lp/aquafacial/hero-image-aquafacial.webp';
import aquafacialCloseUpImage from '../../../assets/lp/aquafacial/aquafacial-close-up-zuerich.webp';
import aquafacialCloseUpUrl from '../../../assets/lp/aquafacial/aquafacial-close-up-zuerich.webp?url';
import postTreatmentGlowImage from '../../../assets/lp/aquafacial/post-treatment-glow-zuerich.webp';
import hautanalyseBeratungImage from '../../../assets/lp/aquafacial/hautanalyse-beratung-zuerich.webp';
import abschlusspflegeAftercareImage from '../../../assets/lp/aquafacial/abschlusspflege-aftercare-zuerich.webp';
import personalTreatmentImage from '../../../assets/lp/aquafacial/personal-treatment-zuerich.webp';
import {
  ADDRESS,
  CONTACT_PHONE_DISPLAY,
  OPENING_HOURS,
  absoluteUrl,
} from '../../../../shared/site';

const PROMO_PRICE = 99;
const REGULAR_PRICE = 180;
const DURATION_LABEL = '1 Std.';
const OFFER_LABEL = 'Aquafacial Aktion';
const SAVINGS_LABEL = 'Sie sparen CHF 81.-';
const PRIMARY_CTA_LABEL = 'Jetzt Termin sichern';
const BOOKING_CTA_LABEL = 'Jetzt Termin sichern';
const SECONDARY_CTA_LABEL = 'Frage per WhatsApp';
const bookingHref = 'https://buchung.treatwell.ch/ort/beauty-face-lift/?service=Aquafacial+Aktion&offer=aquafacial-aktion&price=99#serviceDetails=TR4122487';
const whatsappMessage = `Guten Tag, ich interessiere mich für die Aquafacial Aktion CHF ${PROMO_PRICE} statt CHF ${REGULAR_PRICE}.`;
const studioAddress = `${ADDRESS.street}, ${ADDRESS.postalCode} ${ADDRESS.city}`;
const googleMapsEmbedUrl = `https://www.google.com/maps?q=${encodeURIComponent(`Beauty Face Lift ${studioAddress}`)}&output=embed`;
const googleMapsDirectionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(studioAddress)}`;
const lpHeroSizes = '(min-width: 1101px) 46vw, (min-width: 761px) 660px, 100vw';
const lpVisualSizes = '(min-width: 1101px) 30vw, (min-width: 761px) 48vw, 100vw';
const lpAboutSizes = '(min-width: 1101px) 44vw, (min-width: 601px) 520px, 100vw';

const includedItems = [
  'Kurze persönliche Hautabstimmung',
  'Cleansing für ein saubereres Hautgefühl',
  'Sanftes Fruchtsäurepeeling',
  'Hyaluron Booster',
  'Beruhigende Abschlusspflege',
  'Pflegehinweise nach der Behandlung',
];

const desireItems = [
  { title: 'Müder, fahler Teint', text: 'Wenn die Haut wacher, frischer und gepflegter wirken soll.' },
  { title: 'Verstopft wirkende Poren', text: 'Wenn Sie sich eine professionelle Reinigung wünschen, die über die Routine zu Hause hinausgeht.' },
  { title: 'Trockenheit & unruhige Textur', text: 'Wenn die Haut mehr Feuchtigkeit braucht und der Teint glatter wirken soll.' },
];

const phases = [
  { title: 'Sorgfältig reinigen', text: 'Die Haut wird vorbereitet und gründlich gereinigt, damit sie sich sauberer und gepflegter anfühlt.' },
  { title: 'Sanft peelen', text: 'Ein Fruchtsäurepeeling hilft, abgestorbene Hautzellen zu lösen und den Teint frischer wirken zu lassen.' },
  { title: 'Feuchtigkeit spenden & beruhigen', text: 'Der Hyaluron Booster und die Abschlusspflege unterstützen ein besser versorgtes Hautbild.' },
];

const aquafacialReasons = [
  { title: 'Reinigung als Basis', text: 'Cleansing und Peeling helfen, Rückstände zu lösen und die Haut klarer wirken zu lassen.' },
  { title: 'Feuchtigkeit im Fokus', text: 'Der Hyaluron Booster unterstützt ein angenehmeres, praller wirkendes Pflegegefühl.' },
  { title: 'Ruhige Einordnung', text: 'Teresa stimmt die Pflege auf Hautzustand, Empfindlichkeit und Ziel ab.' },
];

const visualStoryItems = [
  {
    image: aquafacialCloseUpImage,
    alt: 'Aquafacial Behandlung zur Reinigung und Feuchtigkeitspflege',
    title: 'Cleansing & Peeling',
    text: 'Die Haut wird sorgfältig gereinigt und mit einem sanften Fruchtsäurepeeling vorbereitet.',
  },
  {
    image: hautanalyseBeratungImage,
    alt: 'Persönliche Hautabstimmung bei Beauty Face Lift Zürich',
    title: 'Persönliche Hautabstimmung',
    text: 'Teresa ordnet Hautzustand, Empfindlichkeit und Behandlungsziel vor Ort realistisch ein.',
  },
  {
    image: abschlusspflegeAftercareImage,
    alt: 'Beruhigende Abschlusspflege nach der Aquafacial Behandlung',
    title: 'Hyaluron Booster & Pflege',
    text: 'Zum Abschluss wird die Haut hydratisiert, beruhigt und Sie erhalten klare Pflegehinweise.',
  },
];

const benefits = [
  { icon: 'sun' as const, title: 'Frischerer Glow', text: 'Die Haut kann direkt nach der Behandlung wacher und gepflegter wirken.' },
  { icon: 'target' as const, title: 'Saubereres Hautgefühl', text: 'Ideal, wenn die Haut belastet, verstopft oder unruhig erscheint.' },
  { icon: 'droplet' as const, title: 'Besser versorgte Haut', text: 'Der Hyaluron Booster unterstützt ein angenehmeres, praller wirkendes Hautgefühl.' },
  { icon: 'leaf' as const, title: 'Meist direkt alltagstauglich', text: 'Leichte Rötung ist möglich, eine längere Ausfallzeit ist meist nicht zu erwarten.' },
];

const proofItems = [
  { value: '20+ Jahre', label: 'Kosmetische Erfahrung' },
  { value: '4.8/5', label: 'Bewertungsschnitt aus 248+ Bewertungen' },
  { value: '8001 Zürich', label: `${ADDRESS.street}, zentral erreichbar` },
];

const trustItems = [
  'Persönliche Behandlung durch Teresa Stimac',
  'Zentrale Lage an der Bahnhofstrasse 94',
  'Ruhige Beratung und klare Pflegehinweise',
  'Realistische Erwartungen statt übertriebener Ergebnisversprechen',
];

const expectationItems = [
  { title: 'Direkt danach', text: 'Die Haut kann frischer, sauberer und gut versorgt wirken. Leichte Rötung ist möglich.' },
  { title: 'Am selben Tag', text: 'Sanfte Pflege und Sonnenschutz sind empfehlenswert. Verzichten Sie möglichst auf starke Peelings, Sauna und intensive Sonne.' },
  { title: 'Danach', text: 'Das Hautbild kann glatter, ruhiger und gepflegter erscheinen. Die Ausprägung hängt vom individuellen Hautzustand ab.' },
];

const processSteps = [
  { title: 'Jetzt Termin sichern', text: 'Der Button führt zur Buchung. Service, Angebot und Preis sind bereits vorbereitet.' },
  { title: 'Ankommen in Zürich', text: 'Beauty Face Lift befindet sich zentral an der Bahnhofstrasse 94, gut erreichbar in der Innenstadt.' },
  { title: 'Kurze Hautabstimmung', text: 'Teresa prüft vor Ort, was Ihre Haut aktuell braucht und ob die Behandlung sinnvoll ist.' },
  { title: '1 Stunde Aquafacial Pflege', text: 'Cleansing, Fruchtsäurepeeling, Hyaluron Booster und Abschlusspflege in einem strukturierten Termin.' },
];

const locationItems = [
  {
    number: '01',
    title: 'Adresse',
    text: `${ADDRESS.street}\n${ADDRESS.postalCode} ${ADDRESS.city}`,
  },
  {
    number: '02',
    title: 'Mit dem ÖV',
    text: 'Das Studio liegt zentral an der Bahnhofstrasse. Paradeplatz und Börsenstrasse sind in wenigen Minuten zu Fuss erreichbar; vom Zürich HB fahren Tramverbindungen direkt in die Innenstadt.',
  },
  {
    number: '03',
    title: 'Mit dem Auto',
    text: 'Innenstadt-Parkhäuser rund um Paradeplatz, Bleicherweg und Urania liegen in der Nähe. Planen Sie für die Anfahrt ins Zentrum etwas Puffer ein.',
  },
];

const faqs = [
  {
    q: 'Was ist in der Aquafacial Aktion enthalten?',
    a: `Enthalten sind Cleansing, ein sanftes Fruchtsäurepeeling, Hyaluron Booster, Abschlusspflege und eine kurze persönliche Hautabstimmung. Die Behandlung dauert ca. ${DURATION_LABEL}.`,
  },
  {
    q: 'Wie lange dauert die Behandlung?',
    a: `Planen Sie ca. ${DURATION_LABEL} ein. Wenn Sie zum ersten Mal bei Beauty Face Lift sind, lohnt sich ein paar Minuten Puffer für Ankommen und kurze Abstimmung.`,
  },
  {
    q: 'Für wen ist Aquafacial geeignet?',
    a: 'Aquafacial eignet sich für viele Hauttypen, besonders bei fahl wirkender, trockener, unruhiger oder verstopft wirkender Haut. Vor Ort wird geprüft, ob die Behandlung zu Ihrem aktuellen Hautzustand passt.',
  },
  {
    q: 'Gibt es Ausfallzeit?',
    a: 'Meist gibt es keine längere Ausfallzeit. Die Haut kann kurzzeitig leicht gerötet oder empfindlich sein. Teresa gibt Ihnen passende Pflegehinweise.',
  },
  {
    q: `Wie funktioniert das Angebot CHF ${PROMO_PRICE} statt CHF ${REGULAR_PRICE}?`,
    a: `Das ist ein aktuelles Kampagnenangebot für die Aquafacial Behandlung in Zürich. Sie erhalten die ${DURATION_LABEL} Behandlung zum Aktionspreis von CHF ${PROMO_PRICE}.– statt CHF ${REGULAR_PRICE}.–.`,
  },
  {
    q: 'Ist Aquafacial vor einem Event geeignet?',
    a: 'Für viele Kundinnen und Kunden ist Aquafacial vor einem Anlass interessant, weil die Haut frischer und gepflegter wirken kann. Bei sehr empfindlicher Haut empfehlen wir, nicht direkt am selben Tag zu planen.',
  },
  {
    q: 'Wie oft sollte man Aquafacial machen?',
    a: 'Für regelmässige Pflege kann ein Rhythmus von etwa 4 bis 6 Wochen sinnvoll sein. Teresa empfiehlt Ihnen nach der Behandlung ehrlich, was zu Haut und Ziel passt.',
  },
  {
    q: 'Was sollte ich nach der Behandlung beachten?',
    a: 'Nutzen Sie sanfte Pflege und Sonnenschutz. Verzichten Sie am Behandlungstag möglichst auf intensive Sonne, Sauna, starke Peelings oder Retinol.',
  },
  {
    q: 'Wo ist das Studio in Zürich?',
    a: `Beauty Face Lift befindet sich an der ${ADDRESS.street}, ${ADDRESS.postalCode} ${ADDRESS.city}, zentral gelegen und gut erreichbar in der Nähe von Paradeplatz und Börsenstrasse.`,
  },
  {
    q: 'Wie kann ich buchen?',
    a: 'Sie können direkt über den Button buchen. Die Buchung läuft über Treatwell; Ihre Behandlungs- und Kampagnenangaben werden über unsere Buchungsseite übergeben. Bei Fragen können Sie uns vorab per WhatsApp schreiben.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      '@id': absoluteUrl('/lp/aquafacial/#product'),
      name: OFFER_LABEL,
      description: `Aktionsangebot in Zürich: Aquafacial, ${DURATION_LABEL}, CHF ${PROMO_PRICE} statt CHF ${REGULAR_PRICE}. Cleansing, Fruchtsäurepeeling und Hyaluron Booster.`,
      image: absoluteUrl('/assets/aquafacial_treatment.png'),
      brand: { '@type': 'Brand', name: 'Beauty Face Lift' },
      offers: {
        '@type': 'Offer',
        priceCurrency: 'CHF',
        price: PROMO_PRICE.toFixed(2),
        availability: 'https://schema.org/InStock',
        url: absoluteUrl('/lp/aquafacial/'),
        priceValidUntil: '2026-12-31',
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<LandingPage
  title={`Aquafacial Aktion Zürich - CHF ${PROMO_PRICE} statt CHF ${REGULAR_PRICE} | Beauty Face Lift`}
  description={`Aquafacial Aktion an der Bahnhofstrasse Zürich: ${DURATION_LABEL}, Cleansing, Fruchtsäurepeeling und Hyaluron Booster für CHF ${PROMO_PRICE} statt CHF ${REGULAR_PRICE}.`}
  ogImage="/assets/aquafacial_treatment.png"
  preloadImage={{
    href: aquafacialCloseUpUrl,
    type: 'image/webp',
    fetchpriority: 'high',
  }}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main class="lp-page">
    <section class="container lp-hero">
      <div class="lp-hero-grid">
        <div class="lp-hero-content">
          <div class="lp-eyebrow">In Zürich nur für kurze Zeit!</div>
          <h1 class="lp-title display-text">Aquafacial Angebot für frischer, klarer und gepflegter wirkende Haut</h1>
          <p class="lp-subtitle">
            1 Stunde professionelle Aquafacial Pflege bei Beauty Face Lift an der Bahnhofstrasse:
            Cleansing, sanftes Fruchtsäurepeeling und Hyaluron Booster - persönlich abgestimmt von Teresa Stimac.
          </p>

          <div class="lp-hero-offer-card" aria-label="Aktionsangebot">
            <span>Aktionspreis</span>
            <strong>CHF {PROMO_PRICE}.–</strong>
            <s>statt CHF {REGULAR_PRICE}.–</s>
            <em>{DURATION_LABEL} · {SAVINGS_LABEL} · Buchung über Treatwell</em>
          </div>

          <div class="lp-hero-ctas">
            <a href={bookingHref} class="pill-btn lp-hero-primary" data-treatment="Aquafacial Aktion" data-button-location="lp_hero">{PRIMARY_CTA_LABEL}</a>
            <WhatsAppButton variant="inline" message={whatsappMessage} source="aquafacial_hero" label={SECONDARY_CTA_LABEL} />
            <p class="lp-hero-note">CHF {PROMO_PRICE}.– statt CHF {REGULAR_PRICE}.– · Beauty Face Lift Zürich</p>
          </div>

          <div class="lp-hero-trust">
            <TrustStrip variant="rating" align="left" />
          </div>
        </div>

        <div class="lp-hero-media" aria-label={OFFER_LABEL}>
          <div class="lp-hero-image-stack">
            <div class="lp-hero-image-card lp-hero-image-card-main">
              <Image
                src={heroAquafacialImage}
                widths={[480, 720, 960, 1200, 1440]}
                sizes={lpHeroSizes}
                format="webp"
                quality={86}
                loading="eager"
                decoding="async"
                fetchpriority="high"
                alt="Aquafacial Behandlung mit Teresa Stimac bei Beauty Face Lift Zürich"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="container lp-section lp-desire" id="details">
      <div class="lp-section-head">
        <div class="sub-display">Behandlungsziel</div>
        <h2 class="lp-section-title">Wenn die Haut müde, fahl oder verstopft wirkt</h2>
        <p class="lp-section-lead">
          Die Behandlung richtet sich an Kundinnen und Kunden in Zürich, die sich einen frischeren,
          gepflegteren Teint, professionelle Reinigung und eine klare persönliche Einschätzung wünschen.
        </p>
      </div>
      <div class="lp-desire-grid">
        {desireItems.map((item) => (
          <div class="lp-desire-item">
            <strong>{item.title}</strong>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="container lp-section lp-treatment-plan">
      <div class="lp-section-head">
        <div class="sub-display">Die Sitzung</div>
        <h2 class="lp-section-title">Was passiert in 1 Stunde?</h2>
        <p class="lp-section-lead">
          Ein ruhiger Ablauf mit Hautabstimmung, Cleansing, sanftem Fruchtsäurepeeling,
          Hyaluron Booster und Abschlusspflege. Der Fokus liegt auf einem sichtbar gepflegten
          Hautbild ohne übertriebene Versprechen.
        </p>
      </div>
      <div class="lp-treatment-grid">
        <div class="lp-phases">
          {phases.map((phase, index) => (
            <div class="lp-phase">
              <div class="lp-phase-no">{String(index + 1).padStart(2, '0')}</div>
              <h3>{phase.title}</h3>
              <p>{phase.text}</p>
            </div>
          ))}
        </div>
        <div class="lp-included-panel">
          <h3>Enthalten im Aktionspreis</h3>
          <p>CHF {PROMO_PRICE}.– statt CHF {REGULAR_PRICE}.– für {DURATION_LABEL} Behandlung.</p>
          <ul class="lp-included-list">
            {includedItems.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="container lp-section lp-visual-story" aria-label="Behandlungsablauf">
      <div class="lp-section-head">
        <div class="sub-display">Behandlungsablauf</div>
        <h2 class="lp-section-title">Mehr als eine schnelle Reinigung</h2>
        <p class="lp-section-lead">
          Die Aquafacial Aktion macht den Aktionspreis konkret: Reinigung, sanftes Peeling,
          Feuchtigkeit und eine persönliche Einordnung in einem ruhigen Studiotermin.
        </p>
      </div>
      <div class="lp-visual-grid">
        {visualStoryItems.map((item) => (
          <article class="lp-visual-card">
            <div class="lp-visual-card-media">
              <Image
                src={item.image}
                widths={[360, 540, 720, 960, 1122]}
                sizes={lpVisualSizes}
                format="webp"
                quality={82}
                alt={item.alt}
                loading="lazy"
              />
            </div>
            <div class="lp-visual-card-body">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="container lp-section lp-combination">
      <div class="lp-combination-grid">
        <div class="lp-combination-copy">
          <div class="sub-display margin-bottom-md">Was ist Aquafacial?</div>
          <h2 class="lp-section-title">Reinigung, Peeling und Feuchtigkeit in einem Treatment</h2>
          <p>
            Aquafacial ist eine professionelle kosmetische Gesichtsbehandlung, die Reinigung,
            sanftes Peeling und Feuchtigkeitspflege in einem Termin verbindet. Die Haut wird
            vorbereitet, von Rückständen und abgestorbenen Hautzellen befreit und anschliessend
            mit einem Hyaluron Booster gepflegt.
          </p>
          <div class="lp-reason-list">
            {aquafacialReasons.map((item) => (
              <div class="lp-reason-item">
                <strong>{item.title}</strong>
                <p>{item.text}</p>
              </div>
            ))}
          </div>
          <div class="lp-section-cta lp-section-cta-left">
            <a href={bookingHref} class="pill-btn" data-treatment="Aquafacial Aktion" data-button-location="what_section">{PRIMARY_CTA_LABEL}</a>
          </div>
        </div>
        <div class="lp-combination-media">
          <Image
            src={personalTreatmentImage}
            widths={[360, 540, 720, 960, 1122]}
            sizes={lpAboutSizes}
            format="webp"
            quality={82}
            alt="Persönliche Aquafacial Behandlung im Beauty Face Lift Studio Zürich"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <section class="container lp-section lp-benefits-section">
      <div class="lp-section-head">
        <div class="sub-display">Ihre Vorteile</div>
        <h2 class="lp-section-title">Was die Aquafacial Behandlung leisten soll</h2>
        <p class="lp-section-lead">
          Vier klare Gründe für alle, die Glow, professionelle Reinigung und ein hydratisierter
          wirkendes Hautgefühl in einem strukturierten Termin verbinden möchten.
        </p>
      </div>
      <div class="lp-benefits-grid">
        {benefits.map((b) => (
          <div class="lp-benefit">
            <div class="lp-benefit-icon-wrap">
              <BenefitIcon name={b.icon} size={26} />
            </div>
            <strong>{b.title}</strong>
            <p>{b.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="container lp-section lp-trust">
      <div class="lp-trust-grid">
        <div class="lp-trust-media">
          <Image
            src={hautanalyseBeratungImage}
            widths={[360, 540, 720, 960, 1200]}
            sizes={lpAboutSizes}
            format="webp"
            quality={82}
            alt="Persönliche Hautabstimmung und Beratung in Zürich"
            loading="lazy"
          />
        </div>
        <div class="lp-trust-content">
          <div class="sub-display margin-bottom-md">Qualität & Vertrauen</div>
          <h2 class="lp-section-title">Vertrauen vor der Buchung</h2>
          <blockquote class="lp-about-quote">
            <p>„Ich nehme mir Zeit, erkläre die Behandlung und stimme die Pflege auf die Haut ab."</p>
          </blockquote>
          <p>
            Beauty Face Lift ist ein Premium Kosmetikinstitut an der Bahnhofstrasse 94 in Zürich.
            Teresa Stimac arbeitet seit über 20 Jahren in der Kosmetik und behandelt die Aquafacial
            Aktion persönlich mit ruhiger, realistischer Beratung.
          </p>
          <ul class="lp-trust-list">
            {trustItems.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <div class="lp-proof-grid" aria-label="Vertrauenssignale">
            {proofItems.map((item) => (
              <div class="lp-proof-item">
                <strong>{item.value}</strong>
                <span>{item.label}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="container lp-section lp-offer">
      <OfferBox
        variant="box"
        eyebrow="Aktionsangebot Zürich"
        oldPrice={REGULAR_PRICE}
        newPrice={PROMO_PRICE}
        discountLabel={OFFER_LABEL}
        urgency={`${DURATION_LABEL} · Cleansing · Fruchtsäurepeeling · Hyaluron Booster · Buchung über Treatwell`}
        ctaText={BOOKING_CTA_LABEL}
        ctaHref={bookingHref}
      />
      <p class="lp-offer-footnote">
        Aquafacial Aktion für CHF {PROMO_PRICE}.– statt CHF {REGULAR_PRICE}.–.
        Die Terminbuchung läuft über Treatwell; Service und Angebot sind vorbereitet.
      </p>
    </section>

    <section class="container lp-section lp-expectation">
      <div class="lp-section-head">
        <div class="sub-display">Realistische Erwartung</div>
        <h2 class="lp-section-title">Realistische Ergebnisse statt übertriebener Versprechen</h2>
        <p class="lp-section-lead">
          Die Haut kann frischer, sauberer und gepflegter wirken. Weil jeder Hautzustand
          unterschiedlich reagiert, wird das Ergebnis vor Ort ehrlich eingeordnet.
        </p>
      </div>
      <div class="lp-expectation-grid">
        {expectationItems.map((item) => (
          <div class="lp-expectation-card">
            <strong>{item.title}</strong>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
      <div class="lp-expectation-visual">
        <Image
          src={postTreatmentGlowImage}
          widths={[480, 720, 960, 1200]}
          sizes="(min-width: 901px) 68vw, 100vw"
          format="webp"
          quality={82}
          alt="Frisch gepflegte Haut nach kosmetischer Gesichtsbehandlung"
          loading="lazy"
        />
      </div>
    </section>

    <section class="container lp-section lp-process">
      <div class="lp-section-head">
        <div class="sub-display">Buchung</div>
