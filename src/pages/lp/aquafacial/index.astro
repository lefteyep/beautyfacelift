    </section>

    <!-- 7 · FAQ -->
    <section class="lp-section lp-faq" aria-labelledby="lp-faq-title">
      <div class="container lp-faq-grid">
        <div class="lp-faq-head">
          <h2 class="lp-section-title" id="lp-faq-title">Häufige Fragen zur Aquafacial Aktion</h2>
        </div>
        <FAQAccordion items={faqs} />
      </div>
    </section>

    <!-- 8 · Closing band -->
    <section class="lp-final-dark on-dark" aria-labelledby="lp-final-title">
      <div class="lp-final-inner">
        <div class="lp-final-copy">
          <h2 class="lp-final-title" id="lp-final-title">Bereit für frischen Glow?</h2>
          <p class="lp-final-lead">
            Aquafacial zum Kennenlernpreis von CHF {PROMO_PRICE} statt CHF {REGULAR_PRICE} – unverbindlich anfragen, Beauty Face Lift meldet sich persönlich bei dir.
          </p>
        </div>
        <div class="lp-final-actions">
          <div class="lp-final-ctas">
            <a href="#aquafacial-lead-form" class="btn" data-button-location="final_cta" data-aquafacial-scroll>{PRIMARY_CTA_LABEL}</a>
            <a href={whatsappHref} class="btn-link" target="_blank" rel="noopener noreferrer" data-treatment={OFFER_LABEL} data-button-location="lp_final_whatsapp" data-source="lp_final">Kurze Frage? Per WhatsApp</a>
          </div>
          <p class="lp-final-address">Beauty Face Lift · Bahnhofstrasse 94 · 8001 Zürich</p>
        </div>
      </div>
    </section>

    <div class="aquafacial-sticky on-dark" data-aquafacial-sticky role="complementary" aria-label="Aquafacial Aktion anfragen">
      <div class="aquafacial-sticky-offer">
        <span>CHF {PROMO_PRICE} statt CHF {REGULAR_PRICE}</span>
        <strong>{OFFER_LABEL}</strong>
      </div>
      <a href="#aquafacial-lead-form" class="btn aquafacial-sticky-cta" aria-label="Termin anfragen" data-button-location="mobile_sticky_lead" data-aquafacial-scroll>Termin anfragen</a>
    </div>
  </main>

  <script>
    import { trackAquafacialLeadSubmit } from '../../../lib/track';

    // Network Information API (incl. vendor prefixes) is not part of lib.dom.
    declare global {
      interface Navigator {
        connection?: { saveData?: boolean };
        mozConnection?: { saveData?: boolean };
        webkitConnection?: { saveData?: boolean };
      }
    }

    const attributionKeys = [
      'utm_source',
      'utm_medium',
      'utm_campaign',
      'utm_content',
      'utm_term',
      'fbclid',
      'gclid',
      'msclkid',
    ];

    const fieldMessages = {
      name: 'Bitte gib deinen Namen ein.',
      phone: 'Bitte gib eine gültige Telefonnummer ein.',
      email: 'Bitte gib eine gültige E-Mail-Adresse ein.',
      privacy_consent: 'Bitte bestätige die Datenschutzerklärung.',
    };

    function getStoredAttribution() {
      try {
        return JSON.parse(sessionStorage.getItem('bfl_utm') || '{}') || {};
      } catch {
        return {};
      }
    }

    function fieldValue(form: HTMLFormElement, name: string) {
      const field = form.elements.namedItem(name);
      if (!field) return '';
      if (field instanceof RadioNodeList) return String(field.value || '').trim();
      return String((field as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement).value || '').trim();
    }

    function setFieldError(form: HTMLFormElement, name: string, message: string) {
      const error = form.querySelector<HTMLElement>(`[data-field-error="${name}"]`);
      const field = form.elements.namedItem(name);
      if (error) {
        error.textContent = message;
        error.hidden = !message;
      }
      if (field instanceof RadioNodeList) {
        Array.from(field).forEach((input) => {
          if (input instanceof HTMLElement) input.setAttribute('aria-invalid', message ? 'true' : 'false');
        });
      } else if (field instanceof HTMLElement) {
        field.setAttribute('aria-invalid', message ? 'true' : 'false');
      }
    }

    function clearErrors(form: HTMLFormElement) {
      Object.keys(fieldMessages).forEach((name) => setFieldError(form, name, ''));
    }

    function isValidEmail(email: string) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    }

    function isValidPhone(phone: string) {
      const digits = phone.replace(/\D/g, '');
      return digits.length >= 8 && digits.length <= 15;
    }

    function validateLeadForm(form: HTMLFormElement) {
      clearErrors(form);
      let valid = true;

      if (!fieldValue(form, 'name')) {
        setFieldError(form, 'name', fieldMessages.name);
        valid = false;
      }

      const phone = fieldValue(form, 'phone');
      if (!phone || !isValidPhone(phone)) {
        setFieldError(form, 'phone', fieldMessages.phone);
        valid = false;
      }

      const email = fieldValue(form, 'email');
      if (!email || !isValidEmail(email)) {
        setFieldError(form, 'email', fieldMessages.email);
        valid = false;
      }

      const privacy = form.elements.namedItem('privacy_consent');
      if (!(privacy instanceof HTMLInputElement) || !privacy.checked) {
        setFieldError(form, 'privacy_consent', fieldMessages.privacy_consent);
        valid = false;
      }

      return valid;
    }

    function setHiddenValue(form: HTMLFormElement, name: string, value: string) {
      const input = form.elements.namedItem(name);
      if (input instanceof HTMLInputElement) input.value = value || '';
    }

    function fillAttribution(form: HTMLFormElement) {
      const params = new URLSearchParams(window.location.search);
      const stored = getStoredAttribution();
      attributionKeys.forEach((key) => {
        setHiddenValue(form, key, params.get(key) || stored[key] || '');
      });
      setHiddenValue(form, 'page_path', window.location.pathname);
      setHiddenValue(form, 'page_url', window.location.href);
      setHiddenValue(form, 'referrer', document.referrer);
    }

    function formPayload(form: HTMLFormElement) {
      const data = new FormData(form);
      const payload = Object.fromEntries(data.entries());
      payload.preferredCallbackTime = payload.preferred_time || '';
      payload.preferredDate = payload.preferred_date || '';
      payload.privacyConsent = payload.privacy_consent || '';
      return payload;
    }

    function initLeadForm() {
      const form = document.querySelector('[data-aquafacial-lead-form]');
      if (!(form instanceof HTMLFormElement)) return;

      const status = document.querySelector('[data-aquafacial-status]');
      const success = document.querySelector('[data-aquafacial-success]');
      const submit = form.querySelector('[data-aquafacial-submit]');
      const submitLabel = form.querySelector('[data-submit-label]');
      let pending = false;
      let tracked = false;

      fillAttribution(form);

      const dateInput = form.querySelector('#aquafacial-date');
      if (dateInput instanceof HTMLInputElement) {
        const today = new Date();
        dateInput.min = [today.getFullYear(), String(today.getMonth() + 1).padStart(2, '0'), String(today.getDate()).padStart(2, '0')].join('-');
      }

      // Typing in a field clears only that field's message; the others stay until fixed.
      const clearOwnError = (event: Event) => {
        const target = event.target;
        if (target instanceof HTMLInputElement || target instanceof HTMLSelectElement || target instanceof HTMLTextAreaElement) {
          if (target.name in fieldMessages) setFieldError(form, target.name, '');
        }
      };
      form.addEventListener('input', clearOwnError);
      form.addEventListener('change', clearOwnError);

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (pending) return;
        fillAttribution(form);

        if (!validateLeadForm(form)) {
          const firstInvalid = form.querySelector('[aria-invalid="true"]');
          if (firstInvalid instanceof HTMLElement) firstInvalid.focus();
          return;
        }

        pending = true;
        if (status instanceof HTMLElement) status.hidden = true;
        if (submit instanceof HTMLButtonElement) submit.disabled = true;
        if (submitLabel instanceof HTMLElement) submitLabel.textContent = 'Anfrage wird gesendet ...';

        try {
          const payload = formPayload(form);
          const response = await fetch(form.action, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
            },
            body: JSON.stringify(payload),
          });

          if (!response.ok) {
            // The Worker answers with its own German message (validation, rate limit); show it when present.
            let serverMessage = '';
            try {
              const body = await response.json();
              if (body && typeof body.error === 'string') serverMessage = body.error.trim();
            } catch { /* no JSON body */ }
            throw new Error(serverMessage || 'Leider konnte deine Anfrage gerade nicht gesendet werden. Bitte versuche es erneut oder kontaktiere uns direkt per WhatsApp.');
          }

          form.hidden = true;
          if (success instanceof HTMLElement) {
            success.hidden = false;
            success.focus();
          }
          document.body.classList.add('aquafacial-lead-success');

          if (!tracked) {
            tracked = true;
            void trackAquafacialLeadSubmit({ email: String(payload.email || ''), phone: String(payload.phone || '') });
          }
        } catch (error) {
          if (status instanceof HTMLElement) {
            status.textContent = error instanceof Error ? error.message : 'Leider konnte deine Anfrage gerade nicht gesendet werden. Bitte versuche es erneut oder kontaktiere uns direkt per WhatsApp.';
            status.hidden = false;
            status.tabIndex = -1;
            status.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' });
            status.focus({ preventScroll: true });
          }
        } finally {
          pending = false;
          if (!form.hidden && submit instanceof HTMLButtonElement) submit.disabled = false;
          if (!form.hidden && submitLabel instanceof HTMLElement) submitLabel.textContent = 'Unverbindlich Termin anfragen';
        }
      });
    }

    function initLeadScroll() {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.querySelectorAll('[data-aquafacial-scroll]').forEach((link) => {
        link.addEventListener('click', (event) => {
          const target = document.querySelector('#aquafacial-lead-form');
          if (!(target instanceof HTMLElement)) return;
          event.preventDefault();
          target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
          // Keyboard and screen-reader users continue inside the form, not from the button they left.
          target.focus({ preventScroll: true });
        });
      });
    }

    // Floating UI rules: the sticky offer bar appears only once the hero has left the
    // viewport; the floating WhatsApp button appears after 25 % scroll depth. Both step
    // aside while the lead form (fields + submit) is on screen and stay hidden while the
    // consent banner is open (see CSS), so they never cover the form or the banner.
    function initFloatingUi() {
      const body = document.body;
      const hero = document.querySelector('[data-aquafacial-hero]');
      const leadSection = document.querySelector('#aquafacial-lead-form');
      let pastHero = false;
      let formInView = false;

      function syncSticky() {
        body.classList.toggle('aquafacial-sticky-on', pastHero && !formInView);
      }

      if ('IntersectionObserver' in window) {
        if (hero) {
          new IntersectionObserver((entries) => {
            const entry = entries[entries.length - 1];
            pastHero = !entry.isIntersecting && entry.boundingClientRect.top < 0;
            syncSticky();
          }).observe(hero);
        }
        if (leadSection) {
          new IntersectionObserver((entries) => {
            const entry = entries[entries.length - 1];
            formInView = entry.isIntersecting;
            body.classList.toggle('aquafacial-form-in-view', formInView);
            syncSticky();
          }).observe(leadSection);
        }
      }

      let ticking = false;
      function syncScrollDepth() {
        ticking = false;
        const scrollable = document.documentElement.scrollHeight - window.innerHeight;
        body.classList.toggle('aquafacial-scrolled', scrollable > 0 && window.scrollY / scrollable >= 0.25);
      }
      window.addEventListener('scroll', () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(syncScrollDepth);
      }, { passive: true });
      syncScrollDepth();
    }

    function initHeroVideo() {
      const cardElement = document.querySelector('[data-hero-video-card]');
      const videoElement = document.querySelector('[data-hero-video]');
      const toggle = document.querySelector('[data-hero-video-toggle]');
      if (!(cardElement instanceof HTMLElement) || !(videoElement instanceof HTMLVideoElement)) return;
      // Narrowed aliases so the nested function declarations below see non-null types.
      const card = cardElement;
      const video = videoElement;

      const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
      const connection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
      const saveData = Boolean(connection && connection.saveData);
      if (reducedMotionQuery.matches || saveData) return;

      let sourcesLoaded = false;

      function setToggleState() {
        if (!(toggle instanceof HTMLButtonElement)) return;
        const isPaused = video.paused;
        toggle.setAttribute('aria-label', isPaused ? 'Video abspielen' : 'Video pausieren');
        toggle.dataset.state = isPaused ? 'paused' : 'playing';
      }

      function addVideoSource(src: string | undefined, type: string) {
        if (!src) return;
        const source = document.createElement('source');
        source.src = src;
        source.type = type;
        video.append(source);
      }

      function hideVideoControls() {
        card.classList.remove('is-video-ready', 'is-video-playing');
        if (toggle instanceof HTMLButtonElement) toggle.hidden = true;
      }

      function loadVideoSources() {
        if (sourcesLoaded) return;
        sourcesLoaded = true;

        const mobileVideoQuery = window.matchMedia('(max-width: 760px)');
        const mp4Source = mobileVideoQuery.matches ? video.dataset.mobileMp4 : video.dataset.desktopMp4;
        if (!mobileVideoQuery.matches) addVideoSource(video.dataset.desktopWebm, 'video/webm');
        addVideoSource(mp4Source, 'video/mp4');

        if (!video.children.length) return;
        video.preload = 'metadata';
        video.load();

        const playRequest = video.play();
        if (playRequest && typeof playRequest.catch === 'function') {
          playRequest.catch(() => {
            hideVideoControls();
          });
        }
      }

      function scheduleVideoLoad() {
        const runWhenIdle = () => {
          if ('requestIdleCallback' in window) {
            window.requestIdleCallback(loadVideoSources, { timeout: 1800 });
          } else {
            (window as Window).setTimeout(loadVideoSources, 450);
          }
        };

        if (document.readyState === 'complete') {
          runWhenIdle();
        } else {
          window.addEventListener('load', runWhenIdle, { once: true });
        }
      }

      video.addEventListener('canplay', () => {
        card.classList.add('is-video-ready');
      }, { once: true });

      video.addEventListener('playing', () => {
        card.classList.add('is-video-playing');
        if (toggle instanceof HTMLButtonElement) toggle.hidden = false;
        setToggleState();
      });

      video.addEventListener('pause', setToggleState);
      video.addEventListener('error', hideVideoControls);

      if (typeof reducedMotionQuery.addEventListener === 'function') {
        reducedMotionQuery.addEventListener('change', (event) => {
          if (event.matches) {
            video.pause();
            hideVideoControls();
          }
        });
      }

      if (toggle instanceof HTMLButtonElement) {
        toggle.addEventListener('click', async () => {
          if (video.paused) {
            try {
              await video.play();
            } catch {
              hideVideoControls();
            }
          } else {
            video.pause();
          }
          setToggleState();
        });
      }

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            observer.disconnect();
            scheduleVideoLoad();
          }
        }, { rootMargin: '160px 0px', threshold: 0.2 });
        observer.observe(card);
      } else {
        scheduleVideoLoad();
      }
    }

    initHeroVideo();
    initLeadForm();
    initLeadScroll();
    initFloatingUi();
  </script>
</LandingPage>

