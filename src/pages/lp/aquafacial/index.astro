---
import LandingPage from '../../../layouts/LandingPage.astro';
import FAQAccordion from '../../../components/lp/FAQAccordion.astro';
import AquafacialResultsSection from '../../../components/lp/AquafacialResultsSection.astro';
import { Image, getImage } from 'astro:assets';
import { teresaPortrait } from '../../../lib/site-images';
import { absoluteUrl, CONTACT_PHONE, TREATWELL_URL } from '../../../../shared/site';
import heroTreatmentPhoto from '../../../assets/lp/aquafacial/aquafacial-behandlung-zuerich.webp';
import resultGlowFace from '../../../assets/lp/aquafacial/results/aquafacial-result-glow-face.jpg';
import resultHydratedSkin from '../../../assets/lp/aquafacial/results/aquafacial-result-hydrated-skin.jpg';
import resultCleanerSkin from '../../../assets/lp/aquafacial/results/aquafacial-result-cleaner-skin.jpg';

const PROMO_PRICE = 99;
const REGULAR_PRICE = 180;
const OFFER_LABEL = 'Aquafacial Aktion';
const CAMPAIGN = 'aquafacial_aktion';
const OFFER_SLUG = 'aquafacial_aktion_99';
const LANDING_PAGE_PATH = '/lp/aquafacial/';
const DURATION_LABEL = '1 Stunde';
const PRIMARY_CTA_LABEL = 'Unverbindlich Termin anfragen';
const SEO_TITLE = 'Aquafacial Aktion Zürich | CHF 99 statt CHF 180 | Beauty Face Lift';
const META_DESCRIPTION = 'Professionelle Aquafacial Behandlung in Zürich: Cleansing, Fruchtsäurepeeling und Hyaluron Booster für CHF 99 statt CHF 180. Jetzt unverbindlich anfragen.';
const OG_DESCRIPTION = '1-stündige Aquafacial Behandlung mit Cleansing, Fruchtsäurepeeling und Hyaluron Booster bei Beauty Face Lift Zürich. Jetzt unverbindlich anfragen.';
const TREATWELL_SUCCESS_HREF = 'https://buchung.treatwell.ch/ort/beauty-face-lift/?service=Aquafacial+Aktion&offer=aquafacial-aktion&price=99#serviceDetails=TR4122487';
const WHATSAPP_MESSAGE = 'Hallo Beauty Face Lift, ich interessiere mich für die Aquafacial Aktion für CHF 99 statt CHF 180 und möchte gerne einen Termin anfragen.';
const whatsappHref = `https://wa.me/${CONTACT_PHONE.replace(/\D/g, '')}?${new URLSearchParams({ text: WHATSAPP_MESSAGE }).toString()}`;

const HERO_VIDEO_POSTER = '/assets/lp-aquafacial/hero-poster-1080.webp';
const HERO_VIDEO_POSTER_MOBILE = '/assets/lp-aquafacial/hero-poster-720.webp';
const HERO_VIDEO_MP4 = '/assets/lp-aquafacial/hero-video.mp4';
const HERO_VIDEO_MOBILE_MP4 = '/assets/lp-aquafacial/hero-video-mobile.mp4';
const HERO_VIDEO_WEBM = '/assets/lp-aquafacial/hero-video.webm';
const lpHeroPosterSizes = '(min-width: 1320px) 400px, (min-width: 901px) 32vw, calc(100vw - 40px)';
const lpAboutSizes = '(min-width: 1101px) 44vw, (min-width: 601px) 520px, 100vw';

// Hero photo: Teresa at an Aquafacial treatment. Desktop shows the full 4:5 frame in the arch,
// Phones frame the intact portrait as a lower-focused 2:1 band under the CTAs.
// Keep both the client's forehead and chin visible without changing the real source photo.
const heroPortraitSizes = '(min-width: 1320px) 540px, 40vw';
const heroPortrait = await getImage({
  src: heroTreatmentPhoto,
  widths: [560, 840, 1120],
  format: 'webp',
  quality: 'high',
});
const heroBand = await getImage({
  src: heroTreatmentPhoto,
  width: 1200,
  widths: [600, 900, 1200],
  format: 'webp',
  quality: 'mid',
});

// Hero facts: how long, what you get, who treats you. Rating proof sits under the CTAs.
const heroBullets = [
  `${DURATION_LABEL} an der Bahnhofstrasse 94, Zürich`,
  'Cleansing, Fruchtsäurepeeling & Hyaluron Booster',
  'Persönlich durch Teresa Stimac, 20+ Jahre Erfahrung',
];

// In treatment order, so the list reads like the appointment itself.
const includedItems = [
  'Kurze persönliche Hautabstimmung',
  'Cleansing',
  'Sanftes Fruchtsäurepeeling',
  'Hyaluron Booster',
  'Beruhigende Abschlusspflege',
  'Pflegehinweise für zu Hause',
];

// Four outcomes people book for; claims stay cautious (results vary).
const benefits = [
  { title: 'Frischer Glow', text: 'Nach der Behandlung kann deine Haut frischer, praller und ebenmässiger wirken.' },
  { title: 'Gründlich gereinigt', text: 'Cleansing und sanftes Fruchtsäurepeeling für ein klares, gepflegtes Hautgefühl.' },
  { title: 'Feuchtigkeit mit Hyaluron', text: 'Der Hyaluron Booster kann ein angenehm hydratisiertes Hautgefühl unterstützen.' },
  { title: 'Meist keine Ausfallzeit', text: 'Make-up kannst du direkt danach auftragen – ideal vor einem besonderen Anlass.' },
];

// Studio facts in one hairline row; the review line links to its source.
const studioFacts = [
  { text: '20+ Jahre Erfahrung' },
  { text: '4,8 aus 248+ Bewertungen auf Treatwell', href: TREATWELL_URL },
  { text: 'Bahnhofstrasse 94, 8001 Zürich' },
];

// What happens after the request: two lines, shown right above the fields.
const nextSteps = [
  'Du sendest deinen Terminwunsch – ohne Online-Zahlung.',
  'Beauty Face Lift meldet sich persönlich per Telefon, WhatsApp oder E-Mail und bestätigt den Termin mit dir.',
];

const resultExamples = [
  {
    image: {
      src: resultGlowFace,
      alt: 'Aquafacial Ergebnisbeispiel mit frischer wirkender Haut',
    },
    caption: 'Frischer Glow nach der Behandlung',
    note: 'Ein Beispiel dafür, wie die Haut nach professioneller Pflege glatter und frischer wirken kann.',
  },
  {
    image: {
      src: resultHydratedSkin,
      alt: 'Aquafacial Ergebnisbeispiel mit gepflegt und hydratisiert wirkendem Hautbild',
    },
    caption: 'Gepflegteres und hydratisierter wirkendes Hautbild',
    note: 'Die Haut kann nach der Aquafacial Behandlung sichtbar frischer und gepflegter wirken.',
  },
  {
    image: {
      src: resultCleanerSkin,
      alt: 'Aquafacial Ergebnisbeispiel mit frischer wirkendem Hautbild',
    },
    caption: 'Professionelle Reinigung für ein frisches Hautgefühl',
    note: 'Gründliche Reinigung und Feuchtigkeitspflege für ein sauberes, frisches Hautgefühl.',
  },
];

// Objections in the order people raise them: content, fit, sensation, payment, next steps, place, limits, when to postpone, online booking.
const faqs = [
  {
    q: 'Was ist in der CHF 99 Aquafacial Aktion enthalten?',
    a: 'Eine 1-stündige Aquafacial Behandlung: kurze persönliche Hautabstimmung, Cleansing, sanftes Fruchtsäurepeeling, Hyaluron Booster und beruhigende Abschlusspflege – dazu Pflegehinweise für zu Hause.',
  },
  {
    q: 'Ist Aquafacial für meine Haut geeignet?',
    a: 'Aquafacial eignet sich für viele Hauttypen, besonders wenn die Haut fahl, trocken, unruhig oder verstopft wirkt. Teresa schätzt vor der Behandlung ehrlich ein, ob sie zu deinem aktuellen Hautzustand passt.',
  },
  {
    q: 'Tut Aquafacial weh oder wird die Haut rot?',
    a: 'Die Behandlung wird meist als angenehm empfunden. Eine leichte Rötung direkt danach ist möglich und klingt in der Regel schnell ab. Make-up kannst du danach auftragen.',
  },
  {
    q: 'Muss ich jetzt schon bezahlen?',
    a: 'Nein. Du fragst die Aktion unverbindlich an – ohne Online-Zahlung. Beauty Face Lift meldet sich bei dir, bevor dein Termin bestätigt wird.',
  },
  {
    q: 'Wie geht es nach meiner Anfrage weiter?',
    a: 'Beauty Face Lift meldet sich zeitnah persönlich per Telefon, WhatsApp oder E-Mail. Dabei wird dein Termin abgestimmt und du kannst alle Fragen stellen, bevor er bestätigt wird. Für sehr kurzfristige Wünsche erreichst du das Studio auch direkt per WhatsApp.',
  },
  {
    q: 'Wo befindet sich das Studio?',
    a: 'An der Bahnhofstrasse 94, 8001 Zürich – zentral, nur wenige Gehminuten vom Hauptbahnhof.',
  },
  {
    q: 'Ist die Aktion limitiert?',
    a: 'Die Aquafacial Aktion kann zeitlich oder nach freien Terminen begrenzt sein. Sende deine Anfrage, dann prüft das Studio deinen Wunschtermin.',
  },
  {
    q: 'Wann sollte ich den Termin verschieben?',
    a: 'Bei stark gereizter Haut, frischem Sonnenbrand, akuten Entzündungen oder Unsicherheit zu Hautreaktionen besprichst du den Termin am besten vorher mit Teresa.',
  },
  {
    q: 'Kann ich auch direkt online buchen?',
    a: 'Ja. Nach dem Absenden deiner Anfrage kannst du optional direkt online buchen. Für den ersten Besuch ist die unverbindliche Anfrage der empfohlene Weg, damit dein Termin persönlich abgestimmt wird.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      '@id': absoluteUrl('/lp/aquafacial/#product'),
      name: OFFER_LABEL,
      description: `Aquafacial Aktion in Zürich: ${DURATION_LABEL} Behandlung mit Cleansing, Fruchtsäurepeeling und Hyaluron Booster für CHF ${PROMO_PRICE} statt CHF ${REGULAR_PRICE}.`,
      image: absoluteUrl('/assets/aquafacial_treatment.png'),
      brand: { '@type': 'Brand', name: 'Beauty Face Lift' },
      offers: {
        '@type': 'Offer',
        priceCurrency: 'CHF',
        price: PROMO_PRICE.toFixed(2),
        availability: 'https://schema.org/InStock',
        url: absoluteUrl('/lp/aquafacial/'),
        priceValidUntil: '2026-12-31',
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<LandingPage
  title={SEO_TITLE}
  description={META_DESCRIPTION}
  ogDescription={OG_DESCRIPTION}
  ogImage="/assets/aquafacial_treatment.png"
  ogImageSize={{ width: 1200, height: 630 }}
  preloadImage={[
    {
      href: heroBand.src,
      imagesrcset: heroBand.srcSet.attribute,
      imagesizes: '100vw',
      media: '(max-width: 900px)',
      type: 'image/webp',
      fetchpriority: 'high',
    },
    {
      href: heroPortrait.src,
      imagesrcset: heroPortrait.srcSet.attribute,
      imagesizes: heroPortraitSizes,
      media: '(min-width: 901px)',
      type: 'image/webp',
      fetchpriority: 'high',
    },
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main class="lp-page" id="main-content">
    <a
      href={whatsappHref}
      class="lp-floating-whatsapp wa-sticky"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Per WhatsApp Termin zur Aquafacial Aktion anfragen"
      data-treatment={OFFER_LABEL}
      data-button-location="floating_whatsapp"
      data-source="floating_whatsapp"
      data-aquafacial-whatsapp
      data-whatsapp-placement="floating_whatsapp"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.946L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" />
      </svg>
    </a>

    <!-- 1 · Hero: copy left, treatment photo in the arch right (phones: message, price and CTA first, then the photo band) -->
    <section class="lp-hero" aria-labelledby="lp-hero-title" data-aquafacial-hero>
      <div class="container lp-hero-grid">
        <div class="lp-hero-copy">
          <p class="lp-hero-kicker eyebrow eyebrow--rule">Aquafacial Aktion · Bahnhofstrasse 94, Zürich</p>
          <h1 class="lp-title" id="lp-hero-title">Aquafacial in Zürich: frischer <em>Glow</em> in 60 Minuten</h1>
          <p class="lp-subtitle">
            Cleansing, sanftes Fruchtsäurepeeling und Hyaluron Booster – persönlich von Teresa Stimac, für Haut, die fahl, trocken oder unruhig wirkt.
          </p>

          <p class="lp-hero-price">
            <span class="lp-hero-price-label">Kennenlernpreis</span>
            <span class="lp-hero-price-value">CHF {PROMO_PRICE}.–</span>
            <span class="lp-hero-price-regular"><span aria-hidden="true">· </span>statt CHF {REGULAR_PRICE}.–</span>
          </p>

          <ul class="lp-hero-benefits">
            {heroBullets.map((item) => (
              <li>{item}</li>
            ))}
          </ul>

          <div class="lp-hero-ctas">
            <a href="#aquafacial-lead-form" class="btn lp-hero-primary" data-button-location="lp_hero" data-aquafacial-scroll>{PRIMARY_CTA_LABEL}</a>
            <a href={whatsappHref} class="btn-link lp-hero-secondary" target="_blank" rel="noopener noreferrer" data-treatment={OFFER_LABEL} data-button-location="lp_hero_whatsapp" data-source="lp_hero">Kurze Frage? Per WhatsApp</a>
          </div>

          <p class="lp-hero-proof"><span class="lp-stars" aria-hidden="true">★★★★★</span><a href={TREATWELL_URL} target="_blank" rel="noopener noreferrer" data-button-location="lp_hero_reviews"><strong>4,8</strong> aus 248+ Bewertungen auf Treatwell</a></p>
        </div>

        <figure class="lp-hero-media">
          <picture>
            <source
              media="(max-width: 900px)"
              srcset={heroBand.srcSet.attribute}
              sizes="100vw"
              type="image/webp"
            />
            <img
              src={heroPortrait.src}
              srcset={heroPortrait.srcSet.attribute}
              sizes={heroPortraitSizes}
              width="1350"
              height="1688"
              alt="Teresa Stimac bei einer Aquafacial Behandlung mit Handstück an der Stirn"
              decoding="async"
              loading="eager"
              fetchpriority="high"
            />
          </picture>
        </figure>
      </div>
    </section>

    <!-- 2 · What the offer includes, with the campaign video card beside it -->
    <section class="lp-section lp-section--rule lp-offer-detail" aria-labelledby="lp-offer-title">
      <div class="container lp-offer-grid">
        <div class="lp-offer-media">
          <div class="lp-hero-video-card" data-hero-video-card>
            <picture class="lp-hero-video-poster" data-hero-video-poster>
              <source
                media="(max-width: 760px)"
                srcset={HERO_VIDEO_POSTER_MOBILE}
                type="image/webp"
              />
              <img
                src={HERO_VIDEO_POSTER}
                width="1080"
                height="1080"
                sizes={lpHeroPosterSizes}
                alt="Aquafacial Aktion bei Beauty Face Lift Zürich"
                decoding="async"
                loading="lazy"
              />
            </picture>
            <video
              class="lp-hero-video"
              data-hero-video
              data-desktop-mp4={HERO_VIDEO_MP4}
              data-mobile-mp4={HERO_VIDEO_MOBILE_MP4}
              data-desktop-webm={HERO_VIDEO_WEBM}
              poster={HERO_VIDEO_POSTER}
              preload="none"
              muted
              playsinline
              loop
              aria-hidden="true"
              disablepictureinpicture
              controlslist="nodownload noplaybackrate noremoteplayback"
            ></video>
            <button
              type="button"
              class="lp-hero-video-toggle"
              data-hero-video-toggle
              aria-label="Video pausieren"
              hidden
            >
              <span class="lp-hero-video-toggle-icon" aria-hidden="true"></span>
            </button>
          </div>
        </div>

        <div class="lp-offer-copy">
          <h2 class="lp-section-title" id="lp-offer-title">Das ist in deiner Aquafacial Aktion enthalten</h2>
          <p class="lp-section-lead">
            1 Stunde professionelle Pflege, Schritt für Schritt auf deine Haut abgestimmt – persönlich von Teresa Stimac.
          </p>
          <ul class="lp-included-list">
            {includedItems.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <div class="lp-section-cta">
            <a href="#aquafacial-lead-form" class="btn" data-button-location="what_section" data-aquafacial-scroll>{PRIMARY_CTA_LABEL}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 3 · Benefits: four outcomes in one ruled row -->
    <section class="lp-section lp-benefits-section" aria-labelledby="lp-benefits-title">
      <div class="container">
        <div class="lp-section-head">
          <div class="lp-section-head-title">
            <h2 class="lp-section-title" id="lp-benefits-title">Was deine Haut davon hat</h2>
          </div>
          <p class="lp-section-lead">
            Für Haut, die fahl, trocken oder unruhig wirkt – Teresa stimmt die Behandlung auf dich ab.
          </p>
        </div>
        <ul class="lp-benefits-grid">
          {benefits.map((b) => (
            <li class="lp-benefit">
              <h3>{b.title}</h3>
              <p>{b.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 4 · Teresa / trust -->
    <section class="lp-section lp-trust" aria-labelledby="lp-trust-title">
      <div class="container lp-trust-grid">
        <div class="lp-trust-media">
          <Image
            src={teresaPortrait}
            widths={[360, 540, 720, 960, 1023]}
            sizes={lpAboutSizes}
            format="webp"
            quality="high"
            alt="Teresa Stimac von Beauty Face Lift Zürich"
            loading="lazy"
          />
        </div>
        <div class="lp-trust-content">
          <h2 class="lp-section-title" id="lp-trust-title">Persönlich behandelt von Teresa Stimac</h2>
          <p>
            Teresa Stimac behandelt seit über 20 Jahren selbst und schätzt ehrlich ein, was zu deiner Haut passt.
          </p>
          <p>
            Kein Druck, keine Sofortbuchung: Du kannst die Aquafacial Aktion zuerst anfragen, Fragen stellen und deinen Terminwunsch persönlich abstimmen.
          </p>
          <ul class="lp-facts" aria-label="Studio und Bewertungen">
            {studioFacts.map((item) => (
              <li>
                {item.href ? (
                  <a href={item.href} target="_blank" rel="noopener noreferrer" data-button-location="trust_reviews">{item.text}</a>
                ) : (
                  <span>{item.text}</span>
                )}
              </li>
            ))}
          </ul>
          <div class="lp-section-cta">
            <a href="#aquafacial-lead-form" class="btn" data-button-location="trust_section" data-aquafacial-scroll>{PRIMARY_CTA_LABEL}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 5 · Results, directly before the form -->
    <AquafacialResultsSection
      eyebrow="Aquafacial Ergebnisse"
      headline="Sichtbar frischeres Hautgefühl nach der Aquafacial Behandlung"
      intro="Die Beispiele zeigen, wie die Haut nach einer professionellen Aquafacial Behandlung sichtbar frischer, gepflegter und hydratisierter wirken kann."
      examples={resultExamples}
      disclaimer="Individuelle Ergebnisse können variieren. Die Beispielbilder dienen zur Orientierung und ersetzen keine persönliche Einschätzung vor Ort."
      ctaLabel="Unverbindlich Termin anfragen"
      ctaTarget="#aquafacial-lead-form"
    />

    <!-- 6 · Lead form -->
    <section class="container lp-section lp-lead" id="aquafacial-lead-form" tabindex="-1">
      <div class="lp-lead-grid">
        <div class="lp-lead-header">
          <p class="lp-eyebrow">Termin unverbindlich anfragen</p>
          <h2 class="lp-section-title">Aquafacial zum Kennenlernpreis anfragen</h2>
        </div>

        <div class="lp-form-shell">
          <div class="lp-form-status" data-aquafacial-status role="alert" hidden></div>
          <div class="lp-form-success" data-aquafacial-success tabindex="-1" hidden>
            <h3>Vielen Dank! Deine Anfrage ist eingegangen.</h3>
            <p>Beauty Face Lift meldet sich zeitnah bei dir, um deinen Terminwunsch für die Aquafacial Aktion zu besprechen.</p>
            <a class="lp-secondary-link" href={TREATWELL_SUCCESS_HREF} target="_blank" rel="noopener noreferrer" data-treatment={OFFER_LABEL} data-button-location="form_success_treatwell">Direkt online buchen</a>
          </div>

          <form class="lp-lead-form" action="/api/contact" method="post" novalidate data-aquafacial-lead-form>
            <input type="hidden" name="topic" value="Ich möchte einen Termin buchen" />
            <input type="hidden" name="campaign" value={CAMPAIGN} />
            <input type="hidden" name="source" value="aquafacial-lp" />
            <input type="hidden" name="offer" value={OFFER_SLUG} />
            <input type="hidden" name="treatment" value={OFFER_LABEL} />
            <input type="hidden" name="landing_page" value={LANDING_PAGE_PATH} />
            <input type="hidden" name="page_path" value={LANDING_PAGE_PATH} />
            <input type="hidden" name="page_url" value="" />
            <input type="hidden" name="referrer" value="" />
            <input type="hidden" name="utm_source" value="" />
            <input type="hidden" name="utm_medium" value="" />
            <input type="hidden" name="utm_campaign" value="" />
            <input type="hidden" name="utm_content" value="" />
            <input type="hidden" name="utm_term" value="" />
            <input type="hidden" name="fbclid" value="" />
            <input type="hidden" name="gclid" value="" />
            <input type="hidden" name="msclkid" value="" />

            <ol class="lp-next-steps" aria-label="So geht es weiter">
              {nextSteps.map((step) => (
                <li>{step}</li>
              ))}
            </ol>

            <div class="lp-form-row">
              <label for="aquafacial-name">Vor- und Nachname<span aria-hidden="true">*</span></label>
              <input id="aquafacial-name" name="name" type="text" autocomplete="name" required aria-describedby="aquafacial-name-error" />
              <p id="aquafacial-name-error" class="lp-field-error" data-field-error="name" hidden></p>
            </div>

            <div class="lp-form-row-grid">
              <div class="lp-form-row">
                <label for="aquafacial-phone">Telefonnummer <span aria-hidden="true">*</span></label>
                <input id="aquafacial-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+41 79 000 00 00" required aria-describedby="aquafacial-phone-error" />
                <p id="aquafacial-phone-error" class="lp-field-error" data-field-error="phone" hidden></p>
              </div>
              <div class="lp-form-row">
