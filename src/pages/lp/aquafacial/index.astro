---
import LandingPage from '../../../layouts/LandingPage.astro';
import FAQAccordion from '../../../components/lp/FAQAccordion.astro';
import BenefitIcon from '../../../components/lp/BenefitIcon.astro';
import AquafacialResultsSection from '../../../components/lp/AquafacialResultsSection.astro';
import { Image, getImage } from 'astro:assets';
import { aquafacialCard, consultationTrust, spaInterior, teresaPortrait } from '../../../lib/site-images';
import { absoluteUrl, CONTACT_PHONE } from '../../../../shared/site';
import resultGlowFace from '../../../assets/lp/aquafacial/results/aquafacial-result-glow-face.jpg';
import resultHydratedSkin from '../../../assets/lp/aquafacial/results/aquafacial-result-hydrated-skin.jpg';
import resultCleanerSkin from '../../../assets/lp/aquafacial/results/aquafacial-result-cleaner-skin.jpg';

const PROMO_PRICE = 99;
const REGULAR_PRICE = 180;
const OFFER_LABEL = 'Aquafacial Aktion';
const CAMPAIGN = 'aquafacial_aktion';
const OFFER_SLUG = 'aquafacial_aktion_99';
const LANDING_PAGE_PATH = '/lp/aquafacial/';
const DURATION_LABEL = '1 Stunde';
const SEO_TITLE = 'Aquafacial Aktion Zürich | CHF 99 statt CHF 180 | Beauty Face Lift';
const META_DESCRIPTION = 'Professionelle Aquafacial Behandlung in Zürich: Cleansing, Fruchtsäurepeeling und Hyaluron Booster für CHF 99 statt CHF 180. Jetzt unverbindlich anfragen.';
const OG_DESCRIPTION = '1-stündige Aquafacial Behandlung mit Cleansing, Fruchtsäurepeeling und Hyaluron Booster bei Beauty Face Lift Zürich. Jetzt unverbindlich anfragen.';
const TREATWELL_SUCCESS_HREF = 'https://buchung.treatwell.ch/ort/beauty-face-lift/?service=Aquafacial+Aktion&offer=aquafacial-aktion&price=99#serviceDetails=TR4122487';
const WHATSAPP_MESSAGE = 'Hallo Beauty Face Lift, ich interessiere mich für die Aquafacial Aktion für CHF 99 statt CHF 180 und möchte gerne einen Termin anfragen.';
const whatsappHref = `https://wa.me/${CONTACT_PHONE.replace(/\D/g, '')}?${new URLSearchParams({ text: WHATSAPP_MESSAGE }).toString()}`;

const lpHeroMainSizes = '(min-width: 1101px) 34vw, (min-width: 601px) 380px, 76vw';
const lpHeroOverlapSizes = '(min-width: 1101px) 24vw, (min-width: 601px) 260px, 54vw';
const lpAboutSizes = '(min-width: 1101px) 44vw, (min-width: 601px) 520px, 100vw';
const lpHeroPreload = await getImage({
  src: aquafacialCard,
  widths: [480, 720, 960, 1200, 1536],
  sizes: lpHeroMainSizes,
  format: 'webp',
  quality: 'high',
});

const heroBullets = [
  `CHF ${PROMO_PRICE} statt CHF ${REGULAR_PRICE}`,
  `${DURATION_LABEL} Behandlung`,
  'Cleansing, Fruchtsäurepeeling & Hyaluron Booster',
  'Persönlich bei Beauty Face Lift an der Bahnhofstrasse 94',
];

const trustItems = [
  'Beauty Face Lift Zürich',
  'Bahnhofstrasse 94, 8001 Zürich',
  'Professionelles Kosmetikinstitut',
  'Persönliche Behandlung durch Teresa Stimac',
  '4.8/5 Bewertungsschnitt bei 249 Bewertungen',
  '20+ Jahre Erfahrung',
];

const includedItems = [
  'Cleansing',
  'Sanftes Fruchtsäurepeeling',
  'Hyaluron Booster',
  'Beruhigende Abschlusspflege',
  'Kurze persönliche Hautabstimmung',
  'Pflegehinweise nach der Behandlung',
];

const benefits = [
  { icon: 'sun' as const, title: 'Frischer, gepflegter wirkender Glow', text: 'Die Haut kann je nach Hautzustand frischer und wacher wirken.' },
  { icon: 'target' as const, title: 'Saubereres Hautgefühl', text: 'Professionelle Reinigung unterstützt ein klareres, gepflegteres Hautgefühl.' },
  { icon: 'droplet' as const, title: 'Hyaluron Booster', text: 'Der Booster kann ein angenehm hydratisierteres Hautgefühl unterstützen.' },
  { icon: 'leaf' as const, title: 'Pflege vor Events', text: 'Geeignet als ruhiges Pflege-Treatment vor einem Anlass, wenn der Zeitpunkt passt.' },
  { icon: 'activity' as const, title: 'Ruhiges Studioerlebnis', text: 'Die Behandlung findet in persönlicher Atmosphäre an der Bahnhofstrasse statt.' },
  { icon: 'trending-up' as const, title: 'Persönliche Einschätzung', text: 'Teresa schätzt vor Ort ehrlich ein, was zu deinem aktuellen Hautzustand passt.' },
];

const trustProof = [
  { value: '20+ Jahre', label: 'Kosmetische Erfahrung' },
  { value: '4.8/5', label: 'Bewertungsschnitt' },
  { value: '249', label: 'Bewertungen' },
];

const processSteps = [
  { title: 'Aktion anfragen', text: 'Fülle das kurze Formular aus und sende deinen Terminwunsch.' },
  { title: 'Studio meldet sich', text: 'Beauty Face Lift kontaktiert dich per Telefon, WhatsApp oder E-Mail.' },
  { title: 'Termin abstimmen', text: 'Gemeinsam wird ein passender Termin für die Aquafacial Aktion bestätigt.' },
  { title: 'Aquafacial geniessen', text: 'Du kommst zur 1-stündigen Behandlung an die Bahnhofstrasse 94 in Zürich.' },
];

const resultExamples = [
  {
    image: {
      src: resultGlowFace,
      alt: 'Aquafacial Ergebnisbeispiel mit frischer wirkender Haut',
    },
    caption: 'Frischer Glow nach der Behandlung',
    note: 'Ein Beispiel dafür, wie die Haut nach professioneller Pflege glatter und frischer wirken kann.',
  },
  {
    image: {
      src: resultHydratedSkin,
      alt: 'Aquafacial Ergebnisbeispiel mit gepflegt und hydratisiert wirkendem Hautbild',
    },
    caption: 'Gepflegteres und hydratisierter wirkendes Hautbild',
    note: 'Die Haut kann nach der Aquafacial Behandlung sichtbar frischer und gepflegter wirken.',
  },
  {
    image: {
      src: resultCleanerSkin,
      alt: 'Aquafacial Ergebnisbeispiel mit frischer wirkendem Hautbild',
    },
    caption: 'Professionelle Reinigung für ein frisches Hautgefühl',
    note: 'Aquafacial unterstützt professionelle Reinigung und Feuchtigkeitspflege ohne aggressive Versprechen.',
  },
];

const faqs = [
  {
    q: 'Was ist in der CHF 99 Aquafacial Aktion enthalten?',
    a: 'Enthalten sind Cleansing, ein sanftes Fruchtsäurepeeling, Hyaluron Booster, beruhigende Abschlusspflege und eine kurze persönliche Hautabstimmung. Die Behandlung dauert ca. 1 Stunde.',
  },
  {
    q: 'Muss ich sofort online bezahlen?',
    a: 'Nein. Auf dieser Landing Page fragst du die Aquafacial Aktion unverbindlich an. Beauty Face Lift meldet sich bei dir, bevor dein Termin final bestätigt wird.',
  },
  {
    q: 'Wie lange dauert die Behandlung?',
    a: 'Die Aquafacial Behandlung dauert ca. 1 Stunde. Plane beim ersten Besuch ein paar Minuten zusätzlich für Ankommen und kurze Abstimmung ein.',
  },
  {
    q: 'Ist Aquafacial für mich geeignet?',
    a: 'Aquafacial eignet sich für viele Hauttypen, besonders wenn die Haut fahl, trocken, unruhig oder verstopft wirkt. Vor Ort wird ehrlich eingeschätzt, ob die Behandlung zu deinem aktuellen Hautzustand passt.',
  },
  {
    q: 'Wo befindet sich das Studio?',
    a: 'Beauty Face Lift befindet sich an der Bahnhofstrasse 94, 8001 Zürich, zentral gelegen in der Nähe von Paradeplatz und Börsenstrasse.',
  },
  {
    q: 'Kann ich vor der Terminbestätigung Fragen stellen?',
    a: 'Ja. Genau dafür ist die Anfrage gedacht. Du kannst im Formular eine Nachricht hinterlassen oder angeben, wie Beauty Face Lift dich kontaktieren darf.',
  },
  {
    q: 'Wie schnell werde ich kontaktiert?',
    a: 'Beauty Face Lift meldet sich zeitnah bei dir. Bei sehr kurzfristigen Terminwünschen kannst du zusätzlich WhatsApp nutzen.',
  },
  {
    q: 'Ist die Aktion limitiert?',
    a: 'Die Aquafacial Aktion ist ein Kampagnenangebot für Zürich und kann zeitlich oder nach Verfügbarkeit begrenzt sein. Sende deine Anfrage, damit das Studio deinen Terminwunsch prüfen kann.',
  },
  {
    q: 'Kann ich auch direkt online buchen?',
    a: 'Ja. Wenn du bereits sicher bist, kannst du nach dem Absenden deiner Anfrage optional direkt online buchen. Die Hauptempfehlung für neue Kundinnen ist jedoch zuerst die unverbindliche Anfrage.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      '@id': absoluteUrl('/lp/aquafacial/#product'),
      name: OFFER_LABEL,
      description: `Aquafacial Aktion in Zürich: ${DURATION_LABEL} Behandlung mit Cleansing, Fruchtsäurepeeling und Hyaluron Booster für CHF ${PROMO_PRICE} statt CHF ${REGULAR_PRICE}.`,
      image: absoluteUrl('/assets/aquafacial_treatment.png'),
      brand: { '@type': 'Brand', name: 'Beauty Face Lift' },
      offers: {
        '@type': 'Offer',
        priceCurrency: 'CHF',
        price: PROMO_PRICE.toFixed(2),
        availability: 'https://schema.org/InStock',
        url: absoluteUrl('/lp/aquafacial/'),
        priceValidUntil: '2026-12-31',
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<LandingPage
  title={SEO_TITLE}
  description={META_DESCRIPTION}
  ogDescription={OG_DESCRIPTION}
  ogImage="/assets/aquafacial_treatment.png"
  preloadImage={{
    href: lpHeroPreload.src,
    imagesrcset: lpHeroPreload.srcSet.attribute,
    imagesizes: lpHeroMainSizes,
    type: 'image/webp',
    fetchpriority: 'high',
  }}
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main class="lp-page">
    <a
      href={whatsappHref}
      class="lp-floating-whatsapp wa-sticky"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Per WhatsApp Termin zur Aquafacial Aktion anfragen"
      data-treatment={OFFER_LABEL}
      data-button-location="floating_whatsapp"
      data-source="floating_whatsapp"
      data-aquafacial-whatsapp
      data-whatsapp-placement="floating_whatsapp"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.946L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" />
      </svg>
    </a>

    <section class="container lp-hero">
      <div class="lp-hero-grid">
        <div class="lp-hero-content">
          <p class="lp-eyebrow">In Zürich nur für kurze Zeit</p>
          <h1 class="lp-title display-text">Aquafacial Aktion in Zürich: Frischer Glow für CHF 99 statt CHF 180</h1>
          <p class="lp-subtitle">
            Professionelle 1-stündige Aquafacial Behandlung mit Cleansing, Fruchtsäurepeeling und Hyaluron Booster - jetzt unverbindlich anfragen.
          </p>

          <div class="lp-hero-offer-card" aria-label="Aktionsangebot">
            <span>Aktionspreis</span>
            <strong>CHF {PROMO_PRICE}</strong>
            <s>statt CHF {REGULAR_PRICE}</s>
            <em>{DURATION_LABEL} · Cleansing · Fruchtsäurepeeling · Hyaluron Booster</em>
          </div>

          <ul class="lp-hero-bullets">
            {heroBullets.map((item) => (
              <li>{item}</li>
            ))}
          </ul>

          <div class="lp-hero-ctas">
            <a href="#aquafacial-lead-form" class="pill-btn lp-hero-primary" data-button-location="lp_hero" data-aquafacial-scroll>Jetzt Termin sichern</a>
            <a href={whatsappHref} class="pill-btn pill-btn-outline lp-hero-secondary" target="_blank" rel="noopener noreferrer" data-treatment={OFFER_LABEL} data-button-location="lp_hero_whatsapp" data-source="lp_hero">Frage per WhatsApp</a>
          </div>
          <p class="lp-hero-note">Keine Online-Zahlung auf dieser Seite. Beauty Face Lift meldet sich persönlich bei dir.</p>
          <p class="lp-whatsapp-note">Du hast eine kurze Frage oder möchtest schneller einen Terminwunsch senden? Schreibe uns direkt per WhatsApp.</p>
        </div>

        <div class="lp-hero-media" aria-label={OFFER_LABEL}>
          <div class="lp-hero-media-main">
            <Image
              src={aquafacialCard}
              widths={[360, 540, 720, 960, 1122]}
              sizes={lpHeroMainSizes}
              format="webp"
              quality="high"
              priority
              alt="Aquafacial Behandlung im Beauty Face Lift Studio Zürich"
            />
          </div>
          <div class="lp-hero-media-overlap">
            <Image
              src={spaInterior}
              widths={[320, 480, 640, 800]}
              sizes={lpHeroOverlapSizes}
              format="webp"
              quality="high"
              loading="eager"
              alt="Ruhiges Behandlungszimmer bei Beauty Face Lift Zürich"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="lp-trustbar" aria-label="Vertrauen und Standort">
      <div class="container lp-trustbar-inner">
        {trustItems.map((item) => (
          <span>{item}</span>
        ))}
      </div>
    </section>

    <section class="container lp-section lp-offer-detail">
      <div class="lp-section-head">
        <h2 class="lp-section-title">Was ist in der Aquafacial Aktion enthalten?</h2>
        <p class="lp-section-lead">
          Die Aktion umfasst eine professionelle 1-stündige Aquafacial Behandlung bei Beauty Face Lift Zürich - sorgfältig abgestimmt auf dein Hautgefühl und dein Behandlungsziel.
        </p>
      </div>
      <div class="lp-offer-grid">
        <div class="lp-offer-price">
          <span>Aktionspreis</span>
          <strong>CHF {PROMO_PRICE}</strong>
          <s>statt CHF {REGULAR_PRICE}</s>
          <p>{DURATION_LABEL} bei Beauty Face Lift Zürich</p>
        </div>
        <div class="lp-included-panel">
          <ul class="lp-included-list">
            {includedItems.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <div class="lp-section-cta lp-section-cta-left">
            <a href="#aquafacial-lead-form" class="pill-btn" data-button-location="what_section" data-aquafacial-scroll>Jetzt Termin sichern</a>
          </div>
        </div>
      </div>
    </section>

    <AquafacialResultsSection
      eyebrow="Aquafacial Ergebnisse"
      headline="Sichtbar frischeres Hautgefühl nach der Aquafacial Behandlung"
      intro="Die Beispiele zeigen, wie die Haut nach einer professionellen Aquafacial Behandlung sichtbar frischer, gepflegter und hydratisierter wirken kann."
      examples={resultExamples}
      disclaimer="Individuelle Ergebnisse können variieren. Die Beispielbilder dienen zur Orientierung und ersetzen keine persönliche Einschätzung vor Ort."
      ctaLabel="Aquafacial Termin sichern"
      ctaTarget="#aquafacial-lead-form"
    />

    <section class="container lp-section lp-lead" id="aquafacial-lead-form">
      <div class="lp-lead-grid">
        <div class="lp-lead-header">
          <p class="lp-eyebrow">Termin unverbindlich anfragen</p>
          <h2 class="lp-section-title">Sichern dir jetzt einen Aquafacial-Termin zum Kennenlernpreis!</h2>
        </div>

        <div class="lp-form-shell">
          <div class="lp-form-status" data-aquafacial-status role="alert" aria-live="polite" hidden></div>
          <div class="lp-form-success" data-aquafacial-success tabindex="-1" hidden>
            <h3>Vielen Dank! Deine Anfrage ist eingegangen.</h3>
            <p>Beauty Face Lift meldet sich zeitnah bei dir, um deinen Terminwunsch für die Aquafacial Aktion zu besprechen.</p>
            <a class="lp-secondary-link" href={TREATWELL_SUCCESS_HREF} target="_blank" rel="noopener noreferrer" data-treatment={OFFER_LABEL} data-button-location="form_success_treatwell">Direkt online buchen</a>
          </div>

          <form class="lp-lead-form" action="/api/contact" method="post" novalidate data-aquafacial-lead-form>
            <input type="hidden" name="topic" value="Ich möchte einen Termin buchen" />
            <input type="hidden" name="campaign" value={CAMPAIGN} />
            <input type="hidden" name="offer" value={OFFER_SLUG} />
            <input type="hidden" name="treatment" value={OFFER_LABEL} />
            <input type="hidden" name="landing_page" value={LANDING_PAGE_PATH} />
            <input type="hidden" name="page_path" value={LANDING_PAGE_PATH} />
            <input type="hidden" name="page_url" value="" />
            <input type="hidden" name="referrer" value="" />
            <input type="hidden" name="utm_source" value="" />
            <input type="hidden" name="utm_medium" value="" />
            <input type="hidden" name="utm_campaign" value="" />
            <input type="hidden" name="utm_content" value="" />
            <input type="hidden" name="utm_term" value="" />
            <input type="hidden" name="fbclid" value="" />
            <input type="hidden" name="gclid" value="" />
            <input type="hidden" name="msclkid" value="" />

            <div class="lp-form-row">
              <label for="aquafacial-name">Vor- und Nachname<span aria-hidden="true">*</span></label>
              <input id="aquafacial-name" name="name" type="text" autocomplete="name" required aria-describedby="aquafacial-name-error" />
              <p id="aquafacial-name-error" class="lp-field-error" data-field-error="name" hidden></p>
            </div>

            <div class="lp-form-row-grid">
              <div class="lp-form-row">
                <label for="aquafacial-phone">Telefonnummer <span aria-hidden="true">*</span></label>
                <input id="aquafacial-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+41 79 000 00 00" required aria-describedby="aquafacial-phone-error" />
                <p id="aquafacial-phone-error" class="lp-field-error" data-field-error="phone" hidden></p>
              </div>
              <div class="lp-form-row">
                <label for="aquafacial-email">E-Mail-Adresse <span aria-hidden="true">*</span></label>
                <input id="aquafacial-email" name="email" type="email" autocomplete="email" placeholder="name@email.ch" required aria-describedby="aquafacial-email-error" />
                <p id="aquafacial-email-error" class="lp-field-error" data-field-error="email" hidden></p>
              </div>
            </div>

            <div class="lp-form-row-grid">
              <div class="lp-form-row">
                <label for="aquafacial-time">Wann erreichen wir dich telefonisch?</label>
                <select id="aquafacial-time" name="preferred_time">
                  <option value="">Bitte wählen</option>
                  <option>Vormittags</option>
                  <option>Mittags</option>
                  <option>Nachmittags</option>
                </select>
              </div>
              <div class="lp-form-row">
                <label for="aquafacial-date">Terminwunsch</label>
                <input id="aquafacial-date" name="preferred_date" type="date" />
              </div>
            </div>

            <div class="lp-honeypot" aria-hidden="true" inert>
              <label for="aquafacial-company">Firma</label>
              <input id="aquafacial-company" name="company" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
            </div>

            <label class="lp-checkbox" for="aquafacial-privacy">
              <input id="aquafacial-privacy" name="privacy_consent" type="checkbox" value="yes" required aria-describedby="aquafacial-privacy-error" />
              <span>Ich habe die <a href="/datenschutz/" target="_blank" rel="noopener">Datenschutzerklärung</a> gelesen und bin einverstanden, dass Beauty Face Lift meine Angaben zur Kontaktaufnahme bezüglich der Aquafacial Aktion verarbeitet.</span>
            </label>
            <p id="aquafacial-privacy-error" class="lp-field-error" data-field-error="privacy_consent" hidden></p>

            <button type="submit" class="pill-btn lp-submit" data-aquafacial-submit>
              <span data-submit-label>Jetzt Termin sichern</span>
            </button>
          </form>
        </div>
      </div>
    </section>

    <section class="container lp-section lp-benefits-section">
      <div class="lp-section-head">
        <h2 class="lp-section-title">Warum Kundinnen die Aquafacial Behandlung anfragen</h2>
        <p class="lp-section-lead">
          Die Behandlung verbindet professionelle Pflege mit einer persönlichen Einschätzung - ohne übertriebene Versprechen und ohne Druck zur Sofortentscheidung.
        </p>
      </div>
      <div class="lp-benefits-grid">
        {benefits.map((b) => (
          <div class="lp-benefit">
            <div class="lp-benefit-icon-wrap">
              <BenefitIcon name={b.icon} size={26} />
            </div>
            <strong>{b.title}</strong>
            <p>{b.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="container lp-section lp-trust">
      <div class="lp-trust-grid">
        <div class="lp-trust-media">
          <Image
            src={teresaPortrait}
            widths={[360, 540, 720, 960, 1023]}
            sizes={lpAboutSizes}
            format="webp"
            quality="high"
            alt="Teresa Stimac von Beauty Face Lift Zürich"
            loading="lazy"
          />
        </div>
        <div class="lp-trust-content">
          <h2 class="lp-section-title">Premium Kosmetikstudio an der Bahnhofstrasse 94</h2>
          <p>
            Bei Beauty Face Lift wirst du nicht in eine Sofortbuchung gedrängt. Du kannst die Aquafacial Aktion zuerst anfragen, Fragen stellen und deinen Terminwunsch persönlich abstimmen.
          </p>
          <p>
            Teresa Stimac behandelt persönlich, ordnet Erwartungen realistisch ein und achtet auf eine ruhige Studioatmosphäre im Zentrum von Zürich.
          </p>
          <div class="lp-proof-grid" aria-label="Vertrauenssignale">
            {trustProof.map((item) => (
              <div class="lp-proof-item">
                <strong>{item.value}</strong>
                <span>{item.label}</span>
              </div>
            ))}
          </div>
          <div class="lp-section-cta lp-section-cta-left">
