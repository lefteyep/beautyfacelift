            <label class="lp-checkbox" for="aquafacial-privacy">
              <input id="aquafacial-privacy" name="privacy_consent" type="checkbox" value="yes" required aria-describedby="aquafacial-privacy-error" />
              <span>Ich habe die <a href="/datenschutz/" target="_blank" rel="noopener">Datenschutzerklärung</a> gelesen und bin einverstanden, dass Beauty Face Lift mich zu meiner Anfrage kontaktiert.</span>
            </label>
            <p id="aquafacial-privacy-error" class="lp-field-error" data-field-error="privacy_consent" hidden></p>

            <div class="lp-form-submit">
              <button type="submit" class="btn lp-submit" data-aquafacial-submit>
                <span data-submit-label>Unverbindlich Termin anfragen</span>
              </button>
              <p class="lp-form-note">Keine Online-Zahlung, keine Verpflichtung. Wir melden uns zur Terminbestätigung.</p>
            </div>
          </form>
