---

import LandingPage from '../../../layouts/LandingPage.astro';
import BookingCta from '../../../components/BookingCta.astro';
import { bookingLinkForService } from '../../../../shared/site';

const bookingHref = bookingLinkForService('Hydrafacial');
---

<LandingPage
    title="Hydrafacial Zürich — Jetzt Termin buchen"
    description="Premium Hydrafacial an der Bahnhofstrasse Zürich. Frischeres Hautbild, meist keine Ausfallzeit."
>
    <section class="container lp-hero">
        <div class="sub-display margin-bottom-md">Premium Kosmetikinstitut • Zürich</div>
        <h1 class="lp-title">Hydrafacial<br><em>Zürich</em></h1>
        <p class="lp-subtitle">Tiefenreinigung, Vitalisierung und frischeres Hautbild — ganz ohne Ausfallzeit. An der Bahnhofstrasse.</p>
    </section>

    <section class="container lp-benefits">
        <div class="highlights-grid">
            <div class="highlight-item">
                <div class="highlight-number">01</div>
                <h4>Sofort sichtbar</h4>
                <p>Strahlender Glow direkt nach der ersten Sitzung.</p>
            </div>
            <div class="highlight-item">
                <div class="highlight-number">02</div>
                <h4>Meist keine Ausfallzeit</h4>
                <p>Zurück in den Alltag innert Minuten.</p>
            </div>
            <div class="highlight-item">
                <div class="highlight-number">03</div>
                <h4>Individuell abgestimmt</h4>
                <p>Seren werden auf Ihren Hauttyp massgeschneidert.</p>
            </div>
        </div>
    </section>

    <section id="buchen" class="container" style="padding-bottom: 10vh;">
        <BookingCta treatment="Hydrafacial" href={bookingHref} />
    </section>
</LandingPage>

<style>
    .lp-hero {
        padding-top: 16vh;
        padding-bottom: 6vh;
        text-align: center;
    }
    .lp-title {
        font-size: clamp(3rem, 8vw, 6rem);
        margin-bottom: 1.5rem;
        text-transform: uppercase;
    }
    .lp-title em {
        font-style: normal;
        font-weight: 300;
        color: var(--gold);
    }
    .lp-subtitle {
        font-size: 1.15rem;
        max-width: 550px;
        margin: 0 auto;
    }
    .lp-benefits {
        padding-bottom: 6vh;
    }
</style>
