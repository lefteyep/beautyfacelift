---
import LandingPage from '../../../layouts/LandingPage.astro';
import BookingCta from '../../../components/BookingCta.astro';
import OfferBox from '../../../components/lp/OfferBox.astro';
import FAQAccordion from '../../../components/lp/FAQAccordion.astro';
import TrustStrip from '../../../components/lp/TrustStrip.astro';
import WhatsAppButton from '../../../components/lp/WhatsAppButton.astro';
import { Image, getImage } from 'astro:assets';
import heroAquafacialMicroneedlingImage from '../../../assets/lp/aquafacial/hero-aquafacial-microneedling-zuerich.webp';
import heroAquafacialMicroneedlingUrl from '../../../assets/lp/aquafacial/hero-aquafacial-microneedling-zuerich.webp?url';
import aquafacialCloseUpImage from '../../../assets/lp/aquafacial/aquafacial-close-up-zuerich.webp';
import aquafacialMicroneedlingInfographicImage from '../../../assets/lp/aquafacial/aquafacial-microneedling-infografik-zuerich.webp';
import postTreatmentGlowImage from '../../../assets/lp/aquafacial/post-treatment-glow-zuerich.webp';
import hautanalyseBeratungImage from '../../../assets/lp/aquafacial/hautanalyse-beratung-zuerich.webp';
import abschlusspflegeAftercareImage from '../../../assets/lp/aquafacial/abschlusspflege-aftercare-zuerich.webp';
import microneedlingCloseUpImage from '../../../assets/lp/aquafacial/microneedling-close-up-zuerich.webp';
import personalTreatmentImage from '../../../assets/lp/aquafacial/personal-treatment-zuerich.webp';
import { ADDRESS, CONTACT_PHONE, CONTACT_PHONE_DISPLAY, OPENING_HOURS, absoluteUrl, bookingLinkForService } from '../../../../shared/site';

const PROMO_PRICE = 170;
const REGULAR_PRICE = 250;
const DURATION_LABEL = '1 Std. 30 Min.';
const OFFER_LABEL = 'Aquafacial + Microneedling Kombi-Angebot';
const OFFER_SLUG = 'aquafacial-microneedling-aktion';
const PRIMARY_CTA_LABEL = 'Jetzt Termin buchen';
const LEAD_CTA_LABEL = 'Hautanalyse & Termin anfragen';
const SECONDARY_CTA_LABEL = 'Per WhatsApp anfragen';
const BOOKING_CTA_LABEL = 'Kombi-Behandlung buchen';
const FORM_CTA_LABEL = 'Terminwunsch senden';
const BOOKING_SERVICE = 'Aquafacial + Microneedling';
const CONTACT_TOPIC = 'Ich möchte eine Behandlungsempfehlung';
const LEAD_FORM_ID = 'anfrage';
const LEAD_FORM_TARGET_ID = 'anfrage-form';
const bookingHref = `${bookingLinkForService(BOOKING_SERVICE)}&offer=${OFFER_SLUG}&price=${PROMO_PRICE}`;
const whatsappMessage = 'Hallo Teresa, ich interessiere mich für Aquafacial + Microneedling in Zürich. Ist die Kombi-Behandlung für mein Hautziel geeignet?';
// The landscape hero photo is cover-cropped to a tall frame on desktop, so the requested
// width follows the frame height there; stacked (≤ 900px) it is a full-bleed 16:9 band.
const lpHeroWidths = [480, 720, 960, 1200, 1440, 1672];
const lpHeroSizes = '(min-width: 1440px) 1440px, 100vw';
const lpHeroQuality = 86;
const lpHalfSizes = '(min-width: 1440px) 640px, (min-width: 901px) 46vw, 100vw';
const lpThirdSizes = '(min-width: 1440px) 420px, (min-width: 901px) 31vw, 100vw';
const lpWideSizes = '(min-width: 1440px) 1300px, 100vw';
const studioAddress = `${ADDRESS.street}, ${ADDRESS.postalCode} ${ADDRESS.city}`;
const googleMapsEmbedUrl = `https://www.google.com/maps?q=${encodeURIComponent(`Beauty Face Lift ${studioAddress}`)}&output=embed`;
const googleMapsDirectionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(studioAddress)}`;

const lpHeroPreload = await getImage({
  src: heroAquafacialMicroneedlingImage,
  widths: lpHeroWidths,
  sizes: lpHeroSizes,
  format: 'webp',
  quality: lpHeroQuality,
});

const heroBullets = [
  'Für frischer, gepflegter und wacher wirkende Haut',
  'Für optisch feinere Poren und glattere Hautstruktur',
  'Persönlich abgestimmt auf Hautzustand und Empfindlichkeit',
  'Klare Pflegehinweise für die ersten 24–48 Stunden',
];

const includedItems = [
  'Hautanalyse und persönliche Abstimmung',
  'Gründliche Aquafacial Pflege',
  'Intensive Feuchtigkeit für einen gepflegten Glow',
  'Kosmetisches Microneedling mit professionellem Pen',
  'Beruhigende Abschlusspflege',
  'After-Care-Hinweise für die ersten 24–48 Stunden',
];

const desireItems = [
  { title: 'Frischerer Glow', text: 'Wenn die Haut wieder gepflegter, wacher und besser versorgt wirken soll.' },
  { title: 'Glatter wirkendes Hautbild', text: 'Wenn Unebenheiten und unruhige Struktur optisch feiner erscheinen sollen.' },
  { title: 'Optisch feinere Poren', text: 'Wenn Poren sichtbarer wirken und Sie eine professionelle Einschätzung möchten.' },
  { title: 'Mehr Feuchtigkeit', text: 'Wenn sich die Haut trocken anfühlt oder Make-up nicht mehr gleichmässig liegt.' },
  { title: 'Ruhige Durchführung', text: 'Wenn Sie eine Behandlung wünschen, die individuell und ohne Druck durchgeführt wird.' },
];

const benefits = [
  { title: 'Frischerer Teint', text: 'Die Haut kann nach der Behandlung gepflegter, wacher und besser mit Feuchtigkeit versorgt wirken.' },
  { title: 'Glatter wirkende Struktur', text: 'Microneedling kann die natürliche Hauterneuerung kosmetisch unterstützen und die Haut optisch verfeinern.' },
  { title: 'Glow ohne schwere Pflege', text: 'Aquafacial verbindet Reinigung und Feuchtigkeit in einem professionellen Behandlungsschritt.' },
  { title: 'Persönliche Anpassung', text: 'Die Behandlung wird auf Hautzustand, Empfindlichkeit und Ziel abgestimmt – nicht nach starrem Standardprogramm.' },
];

const phases = [
  { title: 'Aquafacial bereitet vor', text: 'Die Haut wird sanft gereinigt, mit Feuchtigkeit versorgt und gepflegt. Das schafft eine frische, ruhige Basis vor dem zweiten Schritt.' },
  { title: 'Microneedling setzt Mikroimpulse', text: 'Der professionelle Pen arbeitet kontrolliert und individuell dosiert. Das kann die natürliche Hauterneuerung kosmetisch unterstützen.' },
  { title: 'Abschlusspflege beruhigt', text: 'Zum Schluss erhält die Haut eine abgestimmte Pflege. Sie bekommen klare Hinweise für die nächsten 24–48 Stunden.' },
];

const combinationReasons = [
  { title: 'Reinigung und Feuchtigkeit', text: 'Aquafacial pflegt die Hautoberfläche und sorgt für eine hydratisierte, angenehm vorbereitete Basis.' },
  { title: 'Kontrollierte Mikroimpulse', text: 'Microneedling ergänzt die Pflege gezielt, wenn Struktur, Poren oder ein fahler Teint kosmetisch verfeinert werden sollen.' },
  { title: 'Eine ruhige 90-Minuten-Sitzung', text: 'Analyse, Pflege, Needling, Abschlusspflege und After-Care sind in einem klaren Termin gebündelt.' },
];

const visualStoryItems = [
  {
    image: aquafacialCloseUpImage,
    alt: 'Aquafacial Behandlung zur Reinigung und Feuchtigkeitspflege',
    title: 'Aquafacial Pflege',
    text: 'Reinigung und Feuchtigkeit bereiten die Haut ruhig auf die weiteren Schritte vor.',
    crop: 'lp-crop-aquafacial',
  },
  {
    image: microneedlingCloseUpImage,
    alt: 'Kosmetisches Microneedling mit professionellem Pen',
    title: 'Kontrollierte Mikroimpulse',
    text: 'Microneedling wird individuell dosiert und passend zum Hautzustand eingesetzt.',
    crop: 'lp-crop-needling',
  },
  {
    image: abschlusspflegeAftercareImage,
    alt: 'Beruhigende Abschlusspflege nach der Behandlung',
    title: 'Beruhigende Abschlusspflege',
    text: 'Zum Abschluss wird die Haut gepflegt und Sie erhalten klare After-Care-Hinweise.',
    crop: 'lp-crop-aftercare',
  },
];

const treatmentFocus = [
  {
    title: 'Aquafacial: reinigen, hydratisieren, Glow aufbauen',
    text: 'Aquafacial ist der pflegende Teil der Kombi-Behandlung. Die Haut wird gründlich gereinigt, mit Feuchtigkeit versorgt und auf die anschliessenden Schritte vorbereitet.',
    items: ['Müde oder fahl wirkende Haut', 'Trockene oder feuchtigkeitsarme Haut', 'Wunsch nach mehr Glow', 'Gepflegteres Hautgefühl', 'Sanfte Vorbereitung vor dem Microneedling'],
  },
  {
    title: 'Microneedling: gezielte Mikroimpulse für feinere Hautstruktur',
    text: 'Microneedling ergänzt die Aquafacial Pflege mit kontrollierten Mikroimpulsen. Die Intensität wird individuell angepasst – besonders bei empfindlicher Haut oder der ersten Needling-Erfahrung.',
    items: ['Unruhige Hautstruktur', 'Optisch vergrössert wirkende Poren', 'Unebenheiten', 'Erste Linien und müde wirkendes Hautbild', 'Gezielte kosmetische Hautverfeinerung'],
  },
];

const proofItems = [
  { value: '4,8/5', label: 'Bewertungsschnitt aus 248+ Bewertungen' },
  { value: '20+ Jahre', label: 'Kosmetische Erfahrung' },
  { value: '8001 Zürich', label: 'Bahnhofstrasse 94, zentral erreichbar' },
];

const trustItems = [
  'Persönliche Durchführung durch Teresa Stimac',
  'Zentrale Lage an der Bahnhofstrasse 94',
  'Ruhige Beratung und klare After-Care',
  'Realistische Erwartungen statt übertriebener Ergebnisversprechen',
];

const expectationItems = [
  { title: 'Direkt danach', text: 'Die Haut kann frischer, gepflegter und gut versorgt wirken. Nach dem Microneedling sind Rötungen möglich.' },
  { title: '24–48 Stunden', text: 'Die Haut beruhigt sich je nach Hauttyp schrittweise. Sanfte Pflege und konsequenter Sonnenschutz sind in dieser Zeit besonders wichtig.' },
  { title: 'Weitere Sitzungen', text: 'Für Glow kann eine einzelne Sitzung interessant sein. Bei Strukturthemen kann vor Ort eine Serie sinnvoll eingeordnet werden.' },
];

const processSteps = [
  { title: 'Termin anfragen oder buchen', text: 'Sie senden Ihren Terminwunsch oder wählen direkt einen freien Termin für die Kombi-Behandlung.' },
  { title: 'Hautanalyse vor Ort', text: 'Vor der Behandlung werden Hautzustand, Empfindlichkeit, Ziel und mögliche Reaktionen kurz eingeschätzt.' },
  { title: 'Aquafacial + Microneedling', text: 'Die Haut wird gereinigt, hydratisiert und danach mit kontrollierten Mikroimpulsen behandelt.' },
  { title: 'Abschlusspflege und After-Care', text: 'Zum Schluss wird die Haut beruhigt. Sie erhalten klare Hinweise zu Make-up, Sonne, Sport, Sauna und Pflegeprodukten.' },
];

const locationItems = [
  {
    title: 'Adresse',
    text: `${ADDRESS.street}\n${ADDRESS.postalCode} ${ADDRESS.city}`,
  },
  {
    title: 'Mit dem ÖV',
    text: 'Das Studio liegt zentral an der Bahnhofstrasse. Paradeplatz und Börsenstrasse sind in wenigen Minuten zu Fuss erreichbar; vom Zürich HB fahren Tramverbindungen direkt in die Innenstadt.',
  },
  {
    title: 'Mit dem Auto',
    text: 'Innenstadt-Parkhäuser rund um Paradeplatz, Bleicherweg und Urania liegen in der Nähe. Planen Sie für die Anfahrt ins Zentrum etwas Puffer ein.',
  },
];

const faqs = [
  {
    q: 'Muss ich schon wissen, ob Aquafacial oder Microneedling besser für mich ist?',
    a: 'Nein. Genau dafür ist die persönliche Einschätzung da. Vor Ort wird angeschaut, was Ihre Haut aktuell braucht und wie intensiv die Behandlung sinnvoll ist.',
  },
  {
    q: 'Für wen ist Aquafacial + Microneedling geeignet?',
    a: 'Die Kombination kann für viele Kundinnen und Kunden interessant sein, die sich mehr Glow, Feuchtigkeit und ein optisch feineres Hautbild wünschen. Ob sie zu Ihrem Hautzustand passt, wird vor der Behandlung geprüft.',
  },
  {
    q: 'Wie lange dauert die Behandlung?',
    a: 'Die Kombi-Behandlung dauert ca. 90 Minuten. Enthalten sind Hautanalyse, Aquafacial, Microneedling, Abschlusspflege und After-Care-Hinweise.',
  },
  {
    q: 'Was kostet die Behandlung?',
    a: `Das aktuelle Kombi-Angebot beträgt CHF ${PROMO_PRICE}.– statt CHF ${REGULAR_PRICE}.– für 90 Minuten.`,
  },
  {
    q: 'Gibt es Ausfallzeit?',
    a: 'Nach Aquafacial ist die Haut oft schnell wieder alltagstauglich. Durch Microneedling können Rötungen oder Empfindlichkeit entstehen. Je nach Hauttyp beruhigt sich die Haut meist schrittweise innerhalb von Stunden bis 24-48 Stunden.',
  },
  {
    q: 'Ist Microneedling schmerzhaft?',
    a: 'Viele empfinden es als leichtes Piksen, Druckgefühl oder Wärme. Die Intensität wird kontrolliert und individuell angepasst.',
  },
  {
    q: 'Wann sehe ich Ergebnisse?',
    a: 'Viele Kundinnen und Kunden empfinden die Haut nach der Behandlung als frischer und gepflegter. Die optische Veränderung hängt vom Hautzustand, der Reaktion der Haut und der Nachpflege ab.',
  },
  {
    q: 'Wie viele Sitzungen sind sinnvoll?',
    a: 'Für einen Frische- und Glow-Effekt kann eine einzelne Sitzung interessant sein. Bei Strukturthemen kann eine Behandlungsserie sinnvoll sein. Das wird vor Ort realistisch eingeordnet.',
  },
  {
    q: 'Was sollte ich nach der Behandlung beachten?',
    a: 'Für 24-48 Stunden sind sanfte Pflege, konsequenter Sonnenschutz und der Verzicht auf Sauna, intensive Sonne, Peelings, Retinol und schweisstreibenden Sport empfehlenswert. Teresa gibt Ihnen konkrete Hinweise mit.',
  },
  {
    q: 'Kann ich danach Make-up tragen?',
    a: 'Nach Microneedling ist es meist sinnvoll, die Haut zunächst in Ruhe zu lassen und Make-up für die ersten Stunden zu vermeiden. Teresa gibt Ihnen passend zu Ihrer Haut konkrete Hinweise.',
  },
  {
    q: 'Wann sollte ich den Termin verschieben?',
    a: 'Bei stark gereizter Haut, frischem Sonnenbrand, akuten Entzündungen oder Unsicherheit zu Hautreaktionen sollte die Behandlung vorher besprochen oder verschoben werden.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      '@id': absoluteUrl('/lp/aquafacial-microneedling/#product'),
      name: 'Aquafacial + Microneedling Zürich',
      description: `90 Minuten Aquafacial + Microneedling in Zürich mit Hautanalyse, Abschlusspflege und After-Care-Hinweisen. Kombi-Angebot CHF ${PROMO_PRICE}.– statt CHF ${REGULAR_PRICE}.–.`,
      image: absoluteUrl(heroAquafacialMicroneedlingUrl),
      brand: { '@type': 'Brand', name: 'Beauty Face Lift' },
      offers: {
        '@type': 'Offer',
        priceCurrency: 'CHF',
        price: PROMO_PRICE.toFixed(2),
        availability: 'https://schema.org/InStock',
        url: absoluteUrl('/lp/aquafacial-microneedling/'),
        priceValidUntil: '2026-12-31',
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<LandingPage
  title={`Aquafacial + Microneedling Zürich | CHF ${PROMO_PRICE} statt CHF ${REGULAR_PRICE}`}
  description="90 Min. Aquafacial + Microneedling in Zürich: Hautanalyse, Glow, Feuchtigkeit und optisch feinere Hautstruktur. Persönlich bei Beauty Face Lift an der Bahnhofstrasse."
  ogImage={heroAquafacialMicroneedlingUrl}
  preloadImage={{
    href: lpHeroPreload.src,
    imagesrcset: lpHeroPreload.srcSet.attribute,
    imagesizes: lpHeroSizes,
    type: 'image/webp',
    fetchpriority: 'high',
  }}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main class="lp-page">
    <!-- 1 · Hero -->
    <section class="lp-hero" aria-labelledby="lp-hero-title">
      <div class="container lp-hero-grid">
        <div class="lp-hero-content">
          <p class="eyebrow eyebrow--rule lp-eyebrow">Aktion: Aquafacial + Microneedling in Zürich</p>
          <h1 id="lp-hero-title" class="lp-title">Ganzheitliche Kombi-Behandlung für sichtbar strahlende, straffere und regenerierte Haut.</h1>
          <p class="lp-subtitle">
            Die Kombi-Behandlung verbindet gründliche Aquafacial Pflege, intensive Feuchtigkeit
            und kontrolliertes Microneedling. Ideal, wenn Ihre Haut müde, fahl oder unruhig wirkt –
            und Sie sich eine ehrliche Einschätzung vor der Behandlung wünschen.
          </p>

          <div class="lp-hero-offer" role="group" aria-label="Kombi-Angebot">
            <p class="lp-hero-offer-price">
              <span class="lp-hero-offer-label">Kombi-Angebot</span>
              <strong>CHF {PROMO_PRICE}.–</strong>
              <span class="lp-hero-offer-old">statt <s>CHF {REGULAR_PRICE}.–</s></span>
            </p>
            <p class="lp-hero-offer-note">{DURATION_LABEL}<span class="lp-hero-offer-incl"> inklusive Hautanalyse, Aquafacial, Microneedling, beruhigender Abschlusspflege und After-Care-Hinweisen.</span></p>
          </div>

          <div class="lp-hero-ctas">
            <a href={bookingHref} class="btn lp-hero-primary" data-treatment="Aquafacial + Microneedling" data-button-location="lp_hero_booking">{PRIMARY_CTA_LABEL}</a>
            <WhatsAppButton variant="inline" message={whatsappMessage} source="aquafacial_hero" label={SECONDARY_CTA_LABEL} />
          </div>

          <p class="lp-hero-trust">
            <span class="lp-stars" aria-hidden="true">★★★★★</span>
            <strong>4,8/5</strong>
            <span>248+ Bewertungen</span>
            <span>20+ Jahre Erfahrung</span>
            <span>{ADDRESS.street}, {ADDRESS.postalCode} {ADDRESS.city}</span>
          </p>

          <ul class="lp-hero-bullets">
            {heroBullets.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>

        <figure class="lp-hero-media" aria-label={OFFER_LABEL}>
          <Image
            src={heroAquafacialMicroneedlingImage}
            widths={lpHeroWidths}
            sizes={lpHeroSizes}
            format="webp"
            quality={lpHeroQuality}
            loading="eager"
            decoding="async"
            fetchpriority="high"
            alt="Aquafacial und Microneedling Behandlung bei Beauty Face Lift Zürich"
          />
        </figure>
      </div>
    </section>

    <!-- 2 · Desire -->
    <section class="lp-section lp-section--rule lp-desire" id="details">
      <div class="container">
        <div class="lp-head">
          <div class="lp-head-title">
            <p class="eyebrow eyebrow--rule">Behandlungsziel</p>
            <h2 class="lp-section-title">Wenn Ihre Haut mehr braucht als Pflege zu Hause</h2>
          </div>
          <p class="lp-section-lead">
            Manchmal wirkt die Haut trotz guter Routine müde, trocken oder unruhig. Make-up liegt
            nicht mehr so gleichmässig auf, Poren erscheinen sichtbarer und der Teint verliert an
            Frische. Genau hier setzt die Kombination aus Aquafacial und Microneedling an.
          </p>
        </div>
        <ul class="lp-rows">
          {desireItems.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 3 · Treatment plan + included -->
    <section class="lp-section lp-band--ivory lp-treatment-plan">
      <div class="container">
        <div class="lp-head">
          <div class="lp-head-title">
            <p class="eyebrow eyebrow--rule">Die Sitzung</p>
            <h2 class="lp-section-title">Warum Aquafacial und Microneedling zusammen sinnvoll sein können</h2>
          </div>
          <p class="lp-section-lead">
            Aquafacial und Microneedling haben unterschiedliche Aufgaben. In der Kombination entsteht
            ein strukturierter Termin für Reinigung, Feuchtigkeit, Glow und optische Hautverfeinerung.
          </p>
        </div>
        <div class="lp-treatment-grid">
          <ol class="lp-sequence">
            {phases.map((phase) => (
              <li>
                <h3>{phase.title}</h3>
                <p>{phase.text}</p>
              </li>
            ))}
          </ol>
          <div class="lp-included-panel">
            <h3>Enthalten im Aktionspreis</h3>
            <p class="lp-included-price"><strong>CHF {PROMO_PRICE}.–</strong> statt <s>CHF {REGULAR_PRICE}.–</s> <span class="lp-nowrap">für {DURATION_LABEL}</span> Behandlung.</p>
            <ul class="lp-checks">
              {includedItems.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- 4 · Combination -->
    <section class="lp-section lp-combination">
      <div class="container lp-combination-grid">
        <div class="lp-combination-copy">
          <p class="eyebrow eyebrow--rule">Warum diese Kombination?</p>
          <h2 class="lp-section-title">Reinigung, Feuchtigkeit und Mikroimpulse in einem Termin</h2>
          <p class="lp-combination-text">
            Aquafacial und Microneedling sprechen unterschiedliche Bedürfnisse an. Erst wird die
            Haut gepflegt vorbereitet, danach kann Microneedling die natürliche Hauterneuerung
            kosmetisch unterstützen.
          </p>
          <ul class="lp-rows lp-rows--stacked">
            {combinationReasons.map((item) => (
              <li>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </li>
            ))}
          </ul>
        </div>
        <figure class="lp-combination-media lp-combination-infographic">
          <Image
            src={aquafacialMicroneedlingInfographicImage}
            widths={[360, 540, 720, 960, 1122]}
            sizes={lpHalfSizes}
            format="webp"
            quality={82}
            alt="Infografik zur Wirkung von Aquafacial und Microneedling"
            loading="lazy"
          />
        </figure>
      </div>
    </section>

    <!-- 5 · Visual story -->
    <section class="lp-section lp-section--rule lp-visual-story" aria-label="Behandlungsablauf">
      <div class="container">
        <div class="lp-head">
          <div class="lp-head-title">
            <p class="eyebrow eyebrow--rule">Behandlungsablauf</p>
            <h2 class="lp-section-title">Professionelle Pflege und <em>Anti-Aging</em></h2>
          </div>
          <p class="lp-section-lead">
            Freuen Sie sich auf eine ruhige Studio-Atmosphäre, in der alle Behandlungsschritte auf Sie
            abgestimmt sind – von der Vorbereitung bis zur beruhigenden Abschlusspflege.
          </p>
        </div>
        <div class="lp-gallery">
          {visualStoryItems.map((item) => (
            <article class="lp-gallery-item">
              <div class="media lp-gallery-media">
                <Image
                  src={item.image}
                  widths={[360, 540, 720, 960, 1122]}
                  sizes={lpThirdSizes}
                  format="webp"
                  quality={82}
                  alt={item.alt}
                  loading="lazy"
                  class={item.crop}
                />
              </div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 6 · Two-step focus -->
    <section class="lp-section lp-section--rule lp-treatment-focus">
      <div class="container">
        <div class="lp-head">
          <div class="lp-head-title">
            <p class="eyebrow eyebrow--rule">Aquafacial + Microneedling</p>
