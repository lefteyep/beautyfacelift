    font-size: var(--fs-h4);
  }

  .lp-grid p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
  }

  /* Ruled rows: title left, text right */
  .lp-rows {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule-strong);
  }

  .lp-rows > li {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    align-items: baseline;
    gap: 6px clamp(20px, 3vw, 40px);
    padding-block: 20px;
    border-bottom: 1px solid var(--rule);
  }

