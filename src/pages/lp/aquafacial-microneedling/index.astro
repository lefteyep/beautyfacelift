  }

  .lp-rows--stacked h3 {
    font-size: var(--fs-h4);
  }

  /* Ruled column grid */
  .lp-grid {
    display: grid;
    column-gap: clamp(24px, 3.5vw, 56px);
  }

  .lp-grid--3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .lp-grid--4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .lp-grid > li {
    display: grid;
    align-content: start;
    gap: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--rule-strong);
  }

  .lp-grid h3 {
    font-size: var(--fs-h4);
  }

  .lp-grid p {
    margin: 0;
  }

  /* Numbered sequence (real order only) */
  .lp-sequence {
    counter-reset: lp-step;
    border-top: 1px solid var(--rule-strong);
  }

  .lp-sequence > li {
    counter-increment: lp-step;
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 10px 24px;
    padding-block: clamp(24px, 2.8vw, 34px);
    border-bottom: 1px solid var(--rule);
  }

  .lp-sequence > li::before {
    content: counter(lp-step, decimal-leading-zero);
    grid-row: 1 / span 2;
    font-family: var(--f-display);
    font-size: 2rem;
    line-height: 1;
    color: var(--bronze);
    font-variant-numeric: lining-nums;
  }

  .lp-sequence h3 {
    font-size: var(--fs-h3);
  }

  .lp-sequence p {
    margin: 0;
  }

  .lp-steps {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    row-gap: 40px;
  }

  /* Hairline check list */
  .lp-checks > li {
    position: relative;
    padding: 12px 0 12px 30px;
    border-bottom: 1px solid var(--rule);
    color: var(--espresso);
    line-height: 1.5;
  }

  .lp-checks > li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: calc(12px + 0.42em);
    width: 11px;
    height: 6px;
    border-left: 1px solid var(--bronze);
    border-bottom: 1px solid var(--bronze);
    transform: rotate(-45deg);
  }

  /* Dash list */
  .lp-dashes {
    display: grid;
    gap: 10px;
  }

  .lp-dashes > li {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    align-items: baseline;
    color: var(--umber);
    line-height: 1.55;
  }

  .lp-dashes > li::before {
    content: '';
    width: 12px;
    height: 1px;
    background: var(--bronze);
    transform: translateY(-0.3em);
  }

  /* Secondary WhatsApp button (shared LP component) on light surfaces */
  .lp-page :global(.wa-inline) {
    gap: 0.6rem;
    min-height: 52px;
    padding: 0 1.6rem;
    background: transparent;
    color: var(--espresso);
    border: 1px solid var(--espresso);
    border-radius: 0;
    box-shadow: none;
  }

  .lp-page :global(.wa-inline:hover) {
    background: var(--espresso);
    color: var(--porcelain);
    border-color: var(--espresso);
    box-shadow: none;
  }

  /* ═══ 1 · Hero ═══════════════════════════════════════════════ */
  .lp-hero {
    padding-top: clamp(24px, 3.5vw, 56px);
    padding-bottom: clamp(56px, 7vw, 104px);
  }

  .lp-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: start;
    gap: clamp(40px, 6vw, 96px);
  }

  .lp-hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }

  .lp-title {
    max-width: 19ch;
    font-size: clamp(2.4rem, 3.9vw, 3.6rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
  }

  .lp-subtitle {
    margin: 0;
    font-size: var(--fs-lead);
    line-height: 1.6;
    color: var(--umber);
    max-width: 52ch;
  }

  .lp-hero-offer {
    width: 100%;
    max-width: 560px;
    padding-block: 18px;
    border-top: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule);
  }

  .lp-hero-offer-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 18px;
    margin: 0;
    max-width: none;
  }

  .lp-hero-offer-label {
    flex-basis: 100%;
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--bronze);
  }

  .lp-hero-offer-price strong {
    font-family: var(--f-display);
    font-size: clamp(2rem, 2.6vw, 2.5rem);
    font-weight: 400;
    line-height: 1;
    color: var(--espresso);
    font-variant-numeric: lining-nums;
  }

  .lp-hero-offer-old {
    font-size: var(--fs-small);
    color: var(--taupe);
  }

  .lp-hero-offer-note {
    margin: 10px 0 0;
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--taupe);
  }

  .lp-hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .lp-hero-trust {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 22px;
    margin: 0;
    max-width: none;
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--taupe);
  }

  .lp-hero-trust .lp-stars {
    letter-spacing: 0.2em;
    color: var(--bronze);
  }

  .lp-hero-trust strong {
    color: var(--espresso);
    font-weight: 600;
  }

  .lp-hero-bullets {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 32px;
    width: 100%;
    padding-top: 22px;
    border-top: 1px solid var(--rule);
  }

  .lp-hero-bullets li {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    align-items: baseline;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--umber);
  }

  .lp-hero-bullets li::before {
    content: '';
    width: 12px;
    height: 1px;
    background: var(--bronze);
    transform: translateY(-0.3em);
  }

  /* The image column runs the full height of the copy column. */
  .lp-hero-media {
    position: relative;
    align-self: stretch;
    min-height: 560px;
    max-height: 880px;
    overflow: hidden;
    background: var(--stone);
  }

  .lp-hero-media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 50%;
  }

  /* ═══ 3 · Treatment plan ═════════════════════════════════════ */
  .lp-treatment-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: start;
    gap: clamp(40px, 6vw, 96px);
  }

  .lp-included-panel {
    padding: clamp(28px, 3.5vw, 44px);
    background: var(--porcelain);
    border: 1px solid var(--rule);
  }

  .lp-included-panel h3 {
    font-size: var(--fs-h3);
  }

  .lp-included-price {
    margin: 12px 0 20px;
    color: var(--umber);
  }

  .lp-included-price strong {
    font-family: var(--f-display);
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--espresso);
  }

  .lp-included-price s {
    color: var(--taupe);
  }

  .lp-nowrap {
    white-space: nowrap;
  }

  .lp-included-panel .lp-checks {
    border-top: 1px solid var(--rule-strong);
  }

  /* ═══ 4 · Combination ════════════════════════════════════════ */
  .lp-combination-grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    align-items: center;
    gap: clamp(40px, 7vw, 120px);
  }

  .lp-combination-copy {
    display: grid;
    gap: 24px;
    justify-items: start;
  }

  .lp-combination-copy .lp-section-title {
    max-width: 18ch;
  }

  .lp-combination-text {
    margin: 0;
    font-size: var(--fs-lead);
    line-height: 1.6;
  }

  .lp-combination-copy .lp-rows {
    width: 100%;
    margin-top: 8px;
  }

  .lp-combination-infographic {
    aspect-ratio: 1122 / 1402;
    background: var(--ivory);
  }

  .lp-combination-infographic :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* ═══ 5 · Visual story ═══════════════════════════════════════ */
  .lp-gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px clamp(24px, 3vw, 48px);
  }

  .lp-gallery-item {
    display: grid;
    align-content: start;
    gap: 12px;
  }

  .lp-gallery-media {
    aspect-ratio: 4 / 5;
    margin-bottom: 12px;
  }

  .lp-gallery :global(img.lp-crop-aquafacial) {
    object-position: 50% 40%;
  }

  .lp-gallery :global(img.lp-crop-needling) {
    object-position: 56% 50%;
  }

  .lp-gallery :global(img.lp-crop-aftercare) {
    object-position: 48% 50%;
  }

  .lp-gallery-item h3 {
    font-size: var(--fs-h4);
  }

  .lp-gallery-item p {
    margin: 0;
  }

  /* ═══ 6 · Two-step focus ═════════════════════════════════════ */
  .lp-focus-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--rule-strong);
  }

  .lp-focus-item {
    display: grid;
    align-content: start;
    gap: 18px;
    padding: clamp(28px, 3.5vw, 48px) clamp(24px, 4vw, 64px) 0 0;
  }

  .lp-focus-item + .lp-focus-item {
    padding-left: clamp(24px, 4vw, 64px);
    padding-right: 0;
    border-left: 1px solid var(--rule);
  }

  .lp-focus-item h3 {
    font-size: var(--fs-h3);
    max-width: 22ch;
  }

  .lp-focus-item p {
    margin: 0;
  }

  .lp-focus-item .lp-checks {
    border-top: 1px solid var(--rule);
  }

  /* ═══ 8 · Trust ══════════════════════════════════════════════ */
  .lp-trust-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    align-items: center;
    gap: clamp(40px, 7vw, 120px);
  }

  .lp-trust-media {
    aspect-ratio: 1 / 1;
  }

  .lp-trust-media :global(img) {
    object-position: 50% 45%;
  }

  .lp-trust-content {
    display: grid;
    gap: 24px;
    justify-items: start;
  }

  .lp-trust-content > p {
    margin: 0;
  }

  .lp-quote {
    display: grid;
    gap: 14px;
    padding-left: 24px;
    border-left: 1px solid var(--bronze);
  }

  .lp-quote blockquote {
    font-family: var(--f-display);
    font-style: italic;
    font-size: clamp(1.4rem, 2.2vw, 1.85rem);
    line-height: 1.3;
    color: var(--espresso);
    max-width: 30ch;
  }

  .lp-quote figcaption {
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--taupe);
  }

  .lp-proof {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
    margin-top: 8px;
    border-top: 1px solid var(--rule-strong);
  }

  .lp-proof > div {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 20px 20px 0 0;
  }

  .lp-proof > div + div {
    padding-left: 20px;
    border-left: 1px solid var(--rule-strong);
  }

  .lp-proof dt {
    font-family: var(--f-display);
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    line-height: 1;
    color: var(--espresso);
    font-variant-numeric: lining-nums;
  }

  .lp-proof dd {
    margin: 0;
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--taupe);
  }

  /* ═══ 9 · Offer (shared OfferBox, refined in place) ══════════ */
  .lp-offer :global(.offer-box) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "eyebrow prices"
      "badge prices"
      "urgency cta";
    align-items: end;
    gap: 14px clamp(32px, 6vw, 96px);
    max-width: none;
    margin: 0;
    padding: clamp(32px, 4.5vw, 64px);
    text-align: left;
    background: var(--ivory);
    border: 1px solid var(--rule-strong);
    border-radius: 0;
    box-shadow: none;
  }

  .lp-offer :global(.offer-eyebrow) {
    grid-area: eyebrow;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--bronze);
  }

  .lp-offer :global(.offer-eyebrow)::before {
    content: '';
    width: 28px;
    height: 1px;
    background: currentColor;
  }

  .lp-offer :global(.offer-badge) {
    grid-area: badge;
    margin: 0;
    font-family: var(--f-display);
    font-size: var(--fs-h2);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -0.015em;
    text-transform: none;
    color: var(--espresso);
  }

  .lp-offer :global(.offer-urgency) {
    grid-area: urgency;
    margin: 0;
    font-size: var(--fs-small);
    color: var(--taupe);
  }

  .lp-offer :global(.offer-box-prices) {
    grid-area: prices;
    display: grid;
    justify-content: end;
    justify-items: end;
    gap: 6px;
    margin: 0;
  }

  .lp-offer :global(.offer-old) {
    font-family: var(--f-body);
    font-size: var(--fs-small);
    color: var(--taupe);
  }

  .lp-offer :global(.offer-new) {
    font-family: var(--f-display);
    font-size: clamp(2.75rem, 5vw, 4.25rem);
    font-weight: 400;
    line-height: 1;
    color: var(--espresso);
    font-variant-numeric: lining-nums;
  }

  .lp-offer :global(.offer-cta) {
    grid-area: cta;
    display: inline-flex;
    justify-self: end;
  }

  .lp-offer-footnote {
    margin: 20px 0 0;
    font-size: var(--fs-small);
    color: var(--taupe);
  }

  /* ═══ 10 · Expectation ═══════════════════════════════════════ */
  .lp-expectation-visual {
    aspect-ratio: 16 / 7;
    margin-top: clamp(48px, 6vw, 88px);
  }

  .lp-expectation-visual :global(img) {
    object-position: 60% 40%;
  }

  /* ═══ 12 · Lead form ═════════════════════════════════════════ */
  .lp-lead-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    align-items: start;
    gap: clamp(40px, 6vw, 96px);
  }

  .lp-lead-copy {
    display: grid;
    gap: 24px;
    justify-items: start;
  }

  .lp-lead-copy .lp-section-title {
    max-width: 18ch;
  }

  .lp-lead-copy > p {
    margin: 0;
  }

  .lp-lead-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    width: 100%;
  }

  .lp-lead-visual {
    width: 100%;
    aspect-ratio: 4 / 3;
    margin-top: 8px;
  }

  .lp-lead-visual :global(img) {
    object-position: 50% 30%;
  }

  .lp-lead-form {
    display: grid;
    gap: 20px;
    padding: clamp(28px, 4vw, 52px);
    background: var(--porcelain);
    border: 1px solid var(--rule);
    scroll-margin-top: 24px;
  }

  .lp-form-title {
    margin: 0;
    font-family: var(--f-display);
    font-size: var(--fs-h3);
    line-height: 1.15;
    color: var(--espresso);
  }

  .lp-form-error {
    margin: 0;
    padding: 12px 16px;
    border-left: 2px solid var(--bronze);
    background: var(--ivory);
    font-size: var(--fs-small);
    color: var(--espresso);
  }

  .lp-form-error[hidden] {
    display: none;
  }

  .lp-field-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .lp-field {
    position: relative;
    display: grid;
    gap: 8px;
    align-content: start;
  }

  .lp-field--full {
    grid-column: 1 / -1;
  }

  .lp-field label {
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.35;
    text-transform: uppercase;
    color: var(--espresso);
  }

  .lp-field label span,
  .lp-checkbox > span > span {
    color: var(--bronze);
  }

  .lp-field input,
  .lp-field select,
  .lp-field textarea {
    width: 100%;
    min-height: 52px;
    padding: 13px 16px;
    font: inherit;
    font-size: 1rem;
    line-height: 1.4;
    color: var(--espresso);
    background: var(--ivory);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-input);
    transition: border-color 0.25s ease;
  }

  .lp-field select {
    appearance: none;
    padding-right: 44px;
    cursor: pointer;
  }

  /* Chevron shares the select's grid cell so inline error text never displaces it. */
  .lp-field--select label {
    grid-row: 1;
  }

  .lp-field--select select {
    grid-row: 2;
    grid-column: 1;
  }

  .lp-field--select::after {
    content: '';
    grid-row: 2;
    grid-column: 1;
    justify-self: end;
    align-self: center;
    width: 7px;
    height: 7px;
    margin-right: 20px;
    border-right: 1px solid var(--espresso);
    border-bottom: 1px solid var(--espresso);
    transform: translateY(-2px) rotate(45deg);
    pointer-events: none;
  }

  .lp-field textarea {
    min-height: 120px;
    resize: vertical;
  }

  .lp-field input::placeholder,
  .lp-field textarea::placeholder {
    color: var(--taupe);
  }

  .lp-field input:hover,
  .lp-field select:hover,
  .lp-field textarea:hover {
    border-color: var(--taupe);
  }

  .lp-field input:focus-visible,
  .lp-field select:focus-visible,
  .lp-field textarea:focus-visible {
    border-color: var(--espresso);
    outline: 1px solid var(--bronze);
    outline-offset: 2px;
  }

  .lp-lead-form.is-validated .lp-field :is(input, select, textarea):invalid {
    border-color: var(--bronze);
    border-bottom-width: 2px;
  }

  .lp-lead-form.is-validated .lp-field:has(:invalid) label {
    color: var(--bronze);
  }

  .lp-lead-form.is-validated .lp-field:has(:invalid)::before {
    content: 'Bitte ausfüllen';
    order: 3;
    font-size: 0.82rem;
    line-height: 1.3;
    color: var(--bronze);
  }

  .lp-lead-form.is-validated .lp-field:has(input[type="email"]:invalid)::before {
    content: 'Bitte eine gültige E-Mail-Adresse angeben';
  }

  .lp-checkbox {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--umber);
    cursor: pointer;
  }

  .lp-checkbox input {
    width: 18px;
    height: 18px;
    margin-top: 2px;
    accent-color: var(--espresso);
  }

  .lp-lead-form.is-validated .lp-checkbox:has(:invalid) {
    color: var(--bronze);
  }

  .lp-lead-form.is-validated .lp-checkbox input:invalid {
    outline: 1px solid var(--bronze);
    outline-offset: 2px;
  }

  .lp-checkbox a {
    color: var(--espresso);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .lp-honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .lp-lead-submit {
    margin-top: 4px;
  }

  .lp-form-note {
    margin: 0;
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--taupe);
  }

  /* ═══ 13 · FAQ (shared accordion, refined in place) ══════════ */
  .lp-faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    align-items: start;
    gap: clamp(40px, 7vw, 120px);
  }

  .lp-faq-head {
    display: grid;
    gap: 20px;
    justify-items: start;
    position: sticky;
    top: 40px;
  }

  .lp-faq :global(.faq-accordion-lp) {
    max-width: none;
    margin: 0;
  }

  .lp-faq :global(.faq-item-lp) {
    border-bottom: 1px solid var(--rule);
  }

  .lp-faq :global(.faq-item-lp:first-child) {
    border-top: 1px solid var(--rule-strong);
  }

  .lp-faq :global(.faq-item-lp summary) {
    padding-block: clamp(20px, 2.4vw, 28px);
  }

  .lp-faq :global(.faq-item-lp summary h3) {
    font-family: var(--f-display);
    font-size: clamp(1.2rem, 1.7vw, 1.4rem);
    font-weight: 400;
    line-height: 1.3;
    color: var(--espresso);
  }

