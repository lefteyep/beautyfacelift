---
import LandingPage from '../../../layouts/LandingPage.astro';
import FAQAccordion from '../../../components/lp/FAQAccordion.astro';
import WhatsAppButton from '../../../components/lp/WhatsAppButton.astro';
import { Image, getImage } from 'astro:assets';
import heroAquafacialMicroneedlingImage from '../../../assets/lp/aquafacial/hero-aquafacial-microneedling-zuerich.webp';
import heroAquafacialMicroneedlingUrl from '../../../assets/lp/aquafacial/hero-aquafacial-microneedling-zuerich.webp?url';
import aquafacialCloseUpImage from '../../../assets/lp/aquafacial/aquafacial-close-up-zuerich.webp';
import microneedlingCloseUpImage from '../../../assets/lp/aquafacial/microneedling-close-up-zuerich.webp';
import abschlusspflegeAftercareImage from '../../../assets/lp/aquafacial/abschlusspflege-aftercare-zuerich.webp';
import hautanalyseBeratungImage from '../../../assets/lp/aquafacial/hautanalyse-beratung-zuerich.webp';
import postTreatmentGlowImage from '../../../assets/lp/aquafacial/post-treatment-glow-zuerich.webp';
import personalTreatmentImage from '../../../assets/lp/aquafacial/personal-treatment-zuerich.webp';
import teresaPortraitImage from '../../../assets/marketing/teresa_portrait.jpg';
import { ADDRESS, OPENING_HOURS, TREATWELL_URL, absoluteUrl, bookingLinkForService } from '../../../../shared/site';

const PROMO_PRICE = 170;
const REGULAR_PRICE = 250;
const DURATION_LABEL = '1 Std. 30 Min.';
const OFFER_LABEL = 'Aquafacial + Microneedling Kombi-Angebot';
const OFFER_SLUG = 'aquafacial-microneedling-aktion';
// One primary action on the whole page: the request form. WhatsApp is the secondary path,
// Treatwell booking the tertiary one (after success, in the FAQ and in the closing band).
const PRIMARY_CTA_LABEL = 'Unverbindlich Termin anfragen';
const STICKY_CTA_LABEL = 'Termin anfragen';
const SECONDARY_CTA_LABEL = 'Per WhatsApp anfragen';
const BOOKING_CTA_LABEL = 'Direkt online buchen';
const BOOKING_SERVICE = 'Aquafacial + Microneedling';
// Must be one of CONTACT_TOPICS (shared/site.ts), or the Worker rejects the form (checked by qa:contact).
const CONTACT_TOPIC = 'Ich möchte einen Termin buchen';
// Exempt from Turnstile in worker/routes/contact.ts: this page has no Turnstile widget.
const CONTACT_CAMPAIGN = 'aquafacial_microneedling';
const CONTACT_SOURCE = 'aquafacial-microneedling-lp';
const LANDING_PAGE_PATH = '/lp/aquafacial-microneedling/';
const LEAD_FORM_ID = 'anfrage';
const LEAD_FORM_TARGET_ID = 'anfrage-form';
const bookingHref = `${bookingLinkForService(BOOKING_SERVICE)}&offer=${OFFER_SLUG}&price=${PROMO_PRICE}`;
const whatsappMessage = 'Hallo Teresa, ich interessiere mich für Aquafacial + Microneedling in Zürich. Ist die Kombi-Behandlung für mein Hautziel geeignet?';
// Desktop: the landscape photo is cover-cropped into a 4:5 arch, so the requested width
// follows the frame height (≈ 1.78 × its width). Stacked (≤ 900px) it is a full-bleed 16:9 band.
const lpHeroWidths = [480, 720, 960, 1200, 1440, 1672];
const lpHeroSizes = '(min-width: 1320px) 1100px, (min-width: 901px) 80vw, 100vw';
const lpHeroQuality = 86;
const lpHalfSizes = '(min-width: 1440px) 640px, (min-width: 901px) 46vw, 100vw';
const lpStepSizes = '(min-width: 1320px) 300px, (min-width: 901px) 24vw, (min-width: 421px) 38vw, 100vw';
// Word joiner after the en dash keeps "24–48" on one line.
const HOURS_24_48 = '24–⁠48 Stunden';
const studioAddress = `${ADDRESS.street}, ${ADDRESS.postalCode} ${ADDRESS.city}`;
const googleMapsEmbedUrl = `https://www.google.com/maps?q=${encodeURIComponent(`Beauty Face Lift ${studioAddress}`)}&output=embed`;
const googleMapsDirectionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(studioAddress)}`;

const lpHeroPreload = await getImage({
  src: heroAquafacialMicroneedlingImage,
  widths: lpHeroWidths,
  sizes: lpHeroSizes,
  format: 'webp',
  quality: lpHeroQuality,
});

// What is included, the outcome, who treats you. Shown on every screen size.
const heroBullets = [
  'Hautanalyse, Aquafacial, Microneedling und Abschlusspflege',
  'Für mehr Glow, optisch feinere Poren und glatter wirkende Haut',
  'Persönlich durch Teresa Stimac, 20+ Jahre Erfahrung',
];

// In treatment order, so the list reads like the appointment itself.
const includedItems = [
  'Hautanalyse und persönliche Abstimmung',
  'Gründliche Aquafacial Pflege',
  'Intensive Feuchtigkeit für einen gepflegten Glow',
  'Kosmetisches Microneedling mit professionellem Pen',
  'Beruhigende Abschlusspflege',
  `After-Care-Hinweise für die ersten ${HOURS_24_48}`,
];

// The three steps of the appointment, each with its photo and, for the two treatment steps,
// the skin situations it is meant for.
const steps = [
  {
    title: 'Aquafacial bereitet vor',
    text: 'Sanfte Reinigung und intensive Feuchtigkeit schaffen eine frische, ruhige Basis für den zweiten Schritt.',
    fit: ['Müde oder fahl wirkende Haut', 'Trockene oder feuchtigkeitsarme Haut', 'Wunsch nach mehr Glow'],
    image: aquafacialCloseUpImage,
    alt: 'Aquafacial Behandlung zur Reinigung und Feuchtigkeitspflege',
    crop: 'lp-crop-aquafacial',
  },
  {
    title: 'Microneedling setzt Mikroimpulse',
    text: 'Der professionelle Pen arbeitet kontrolliert und individuell dosiert. Das kann die natürliche Hauterneuerung kosmetisch unterstützen.',
    fit: ['Unruhige Hautstruktur', 'Optisch vergrössert wirkende Poren', 'Erste Linien und müde wirkendes Hautbild'],
    image: microneedlingCloseUpImage,
    alt: 'Kosmetisches Microneedling mit professionellem Pen',
    crop: 'lp-crop-needling',
  },
  {
    title: 'Abschlusspflege beruhigt',
    text: `Eine abgestimmte Pflege beruhigt die Haut. Dazu erhalten Sie klare Hinweise für die nächsten ${HOURS_24_48}.`,
    fit: [],
    image: abschlusspflegeAftercareImage,
    alt: 'Beruhigende Abschlusspflege nach der Behandlung',
    crop: 'lp-crop-aftercare',
  },
];

const expectationItems = [
  { title: 'Direkt danach', text: 'Die Haut kann frischer und gepflegter wirken. Nach dem Microneedling sind Rötungen möglich.' },
  { title: '24–48 Stunden', text: 'Die Haut beruhigt sich je nach Hauttyp schrittweise. Sanfte Pflege und konsequenter Sonnenschutz sind jetzt besonders wichtig.' },
  { title: 'Weitere Sitzungen', text: 'Für Glow kann eine einzelne Sitzung interessant sein. Bei Strukturthemen wird eine Serie vor Ort realistisch eingeordnet.' },
];

// Studio facts in one hairline row; the review line links to its source.
const studioFacts = [
  { text: '20+ Jahre Erfahrung' },
  { text: '4,8 aus 248+ Bewertungen auf Treatwell', href: TREATWELL_URL },
  { text: `${ADDRESS.street}, ${ADDRESS.postalCode} ${ADDRESS.city}` },
];

// What happens after the request: two lines, shown right above the fields.
const nextSteps = [
  'Sie senden Ihren Terminwunsch – ohne Online-Zahlung.',
  'Teresa Stimac meldet sich persönlich per Telefon, WhatsApp oder E-Mail, klärt Ihre Fragen und bestätigt den Termin.',
];

const skinGoals = ['Glow', 'Poren', 'Hautstruktur', 'Trockenheit', 'Frischer aussehen', 'Ich bin unsicher'];

// Objections in the order people raise them: content and price, payment, fit, sensation, downtime,
// after-care, results, sessions, when to postpone, online booking.
const faqs = [
  {
    q: 'Was ist im Kombi-Angebot enthalten?',
    a: `Für CHF ${PROMO_PRICE}.– statt CHF ${REGULAR_PRICE}.– erhalten Sie eine Behandlung von ${DURATION_LABEL} mit Hautanalyse, Aquafacial, Microneedling, beruhigender Abschlusspflege und After-Care-Hinweisen.`,
  },
  {
    q: 'Muss ich jetzt schon bezahlen?',
    a: 'Nein. Sie fragen unverbindlich an, ohne Online-Zahlung. Das Studio meldet sich bei Ihnen, bevor der Termin bestätigt wird.',
  },
  {
    q: 'Muss ich schon wissen, ob Aquafacial oder Microneedling besser für mich ist?',
    a: 'Nein. Genau dafür ist die persönliche Einschätzung da. Vor Ort wird angeschaut, was Ihre Haut aktuell braucht, ob die Kombination zu Ihrem Hautzustand passt und wie intensiv die Behandlung sinnvoll ist.',
  },
  {
    q: 'Ist Microneedling schmerzhaft?',
    a: 'Viele empfinden es als leichtes Piksen, Druckgefühl oder Wärme. Die Intensität wird kontrolliert und individuell angepasst.',
  },
  {
    q: 'Gibt es Ausfallzeit?',
    a: 'Nach Aquafacial ist die Haut oft schnell wieder alltagstauglich. Durch Microneedling können Rötungen oder Empfindlichkeit entstehen. Je nach Hauttyp beruhigt sich die Haut meist schrittweise innerhalb von Stunden bis 24–48 Stunden.',
  },
  {
    q: 'Was sollte ich nach der Behandlung beachten?',
    a: 'Für 24–48 Stunden sind sanfte Pflege, konsequenter Sonnenschutz und der Verzicht auf Sauna, intensive Sonne, Peelings, Retinol und schweisstreibenden Sport empfehlenswert. Make-up vermeiden Sie in den ersten Stunden am besten. Teresa gibt Ihnen konkrete Hinweise mit.',
  },
  {
    q: 'Wann sehe ich Ergebnisse?',
    a: 'Viele Kundinnen und Kunden empfinden die Haut nach der Behandlung als frischer und gepflegter. Die optische Veränderung hängt vom Hautzustand, der Reaktion der Haut und der Nachpflege ab.',
  },
  {
    q: 'Wie viele Sitzungen sind sinnvoll?',
    a: 'Für einen Frische- und Glow-Effekt kann eine einzelne Sitzung interessant sein. Bei Strukturthemen kann eine Behandlungsserie sinnvoll sein. Das wird vor Ort realistisch eingeordnet.',
  },
  {
    q: 'Wann sollte ich den Termin verschieben?',
    a: 'Bei stark gereizter Haut, frischem Sonnenbrand, akuten Entzündungen oder Unsicherheit zu Hautreaktionen sollte die Behandlung vorher besprochen oder verschoben werden.',
  },
  {
    q: 'Kann ich auch direkt online buchen?',
    a: 'Ja, über Treatwell. Für den ersten Besuch empfehlen wir die unverbindliche Anfrage, damit die Behandlung vorab auf Ihre Haut abgestimmt wird.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      '@id': absoluteUrl('/lp/aquafacial-microneedling/#product'),
      name: 'Aquafacial + Microneedling Zürich',
      description: `90 Minuten Aquafacial + Microneedling in Zürich mit Hautanalyse, Abschlusspflege und After-Care-Hinweisen. Kombi-Angebot CHF ${PROMO_PRICE}.– statt CHF ${REGULAR_PRICE}.–.`,
      image: absoluteUrl(heroAquafacialMicroneedlingUrl),
      brand: { '@type': 'Brand', name: 'Beauty Face Lift' },
      offers: {
        '@type': 'Offer',
        priceCurrency: 'CHF',
        price: PROMO_PRICE.toFixed(2),
        availability: 'https://schema.org/InStock',
        url: absoluteUrl('/lp/aquafacial-microneedling/'),
        priceValidUntil: '2026-12-31',
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<LandingPage
  title={`Aquafacial + Microneedling Zürich | CHF ${PROMO_PRICE} statt CHF ${REGULAR_PRICE}`}
  description="90 Min. Aquafacial + Microneedling in Zürich: Hautanalyse, Glow, Feuchtigkeit und optisch feinere Hautstruktur. Persönlich bei Beauty Face Lift an der Bahnhofstrasse."
  ogImage={heroAquafacialMicroneedlingUrl}
  preloadImage={{
    href: lpHeroPreload.src,
    imagesrcset: lpHeroPreload.srcSet.attribute,
    imagesizes: lpHeroSizes,
    type: 'image/webp',
    fetchpriority: 'high',
  }}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main class="lp-page" id="main-content">
    <!-- 1 · Hero: copy left, treatment photo in the arch right (phones: message, price and CTA first, then the photo band) -->
    <section class="lp-hero" aria-labelledby="lp-hero-title" data-lp-hero>
      <div class="container lp-hero-grid">
        <div class="lp-hero-content">
          <p class="eyebrow eyebrow--rule lp-eyebrow">Aktion: Aquafacial + Microneedling in Zürich</p>
          <h1 id="lp-hero-title" class="lp-title">Aquafacial + Microneedling: frischer <em>Glow</em>, glatter wirkende Haut</h1>
          <p class="lp-subtitle">
            {DURATION_LABEL} mit Hautanalyse, Aquafacial, kosmetischem Microneedling und Abschlusspflege –
            persönlich von Teresa Stimac in Zürich.
          </p>

          <p class="lp-hero-offer">
            <span class="lp-hero-offer-label">Kombi-Angebot · {DURATION_LABEL}</span>
            <span class="lp-hero-offer-price">CHF {PROMO_PRICE}.–</span>
            <span class="lp-hero-offer-old"><span aria-hidden="true">· </span>statt CHF {REGULAR_PRICE}.–</span>
          </p>

          <ul class="lp-hero-bullets lp-checks">
            {heroBullets.map((item) => (
              <li>{item}</li>
            ))}
          </ul>

          <div class="lp-hero-ctas">
            <a href={`#${LEAD_FORM_ID}`} class="btn lp-hero-primary" data-treatment={BOOKING_SERVICE} data-button-location="lp_hero_lead" data-lead-cta>{PRIMARY_CTA_LABEL}</a>
            <WhatsAppButton variant="link" message={whatsappMessage} source="aquafacial_hero" label={SECONDARY_CTA_LABEL} />
          </div>

          <p class="lp-hero-proof"><span class="lp-stars" aria-hidden="true">★★★★★</span><a href={TREATWELL_URL} target="_blank" rel="noopener noreferrer" data-button-location="lp_hero_reviews"><strong>4,8</strong> aus 248+ Bewertungen auf Treatwell</a></p>
        </div>

        <figure class="lp-hero-media" aria-label={OFFER_LABEL}>
          <Image
            src={heroAquafacialMicroneedlingImage}
            widths={lpHeroWidths}
            sizes={lpHeroSizes}
            format="webp"
            quality={lpHeroQuality}
            loading="eager"
            decoding="async"
            fetchpriority="high"
            alt="Aquafacial und Microneedling Behandlung bei Beauty Face Lift Zürich"
          />
        </figure>
      </div>
    </section>

    <!-- 2 · What is included -->
    <section class="lp-section lp-section--rule lp-offer" aria-labelledby="lp-offer-title">
      <div class="container lp-offer-grid">
        <figure class="lp-offer-media">
          <Image
            src={personalTreatmentImage}
            widths={[360, 540, 720, 960, 1122]}
            sizes={lpStepSizes}
            format="webp"
            quality={82}
            alt="Persönliche Behandlung im Beauty Face Lift Studio Zürich"
            loading="lazy"
          />
        </figure>
        <div class="lp-offer-copy">
          <h2 class="lp-section-title" id="lp-offer-title">Das ist im Kombi-Angebot enthalten</h2>
          <p class="lp-section-lead">
            {DURATION_LABEL} professionelle Pflege, Schritt für Schritt auf Ihre Haut abgestimmt –
            persönlich durchgeführt von Teresa Stimac.
          </p>
          <ul class="lp-checks lp-included-list">
            {includedItems.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <div class="lp-section-cta">
            <a href={`#${LEAD_FORM_ID}`} class="btn" data-treatment={BOOKING_SERVICE} data-button-location="offer_section_lead" data-lead-cta>{PRIMARY_CTA_LABEL}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 3 · Why the combination works: the three steps of the appointment, with the skin situations each one is for -->
    <section class="lp-section lp-steps-section" aria-labelledby="lp-steps-title">
      <div class="container">
        <div class="lp-section-head">
          <h2 class="lp-section-title" id="lp-steps-title">Warum Aquafacial und Microneedling zusammen sinnvoll sein können</h2>
          <p class="lp-section-lead">
            Aquafacial reinigt und hydratisiert, Microneedling setzt kontrollierte Mikroimpulse, die
            Abschlusspflege beruhigt – drei Schritte in einem Termin.
          </p>
        </div>
        <ol class="lp-steps">
          {steps.map((step) => (
            <li class="lp-step">
              <figure class="lp-step-media">
                <Image
                  src={step.image}
                  widths={[360, 540, 720, 960, 1122]}
                  sizes={lpStepSizes}
                  format="webp"
                  quality={82}
                  alt={step.alt}
                  loading="lazy"
                  class={step.crop}
                />
              </figure>
              <div class="lp-step-copy">
                <h3>{step.title}</h3>
                <p>{step.text}</p>
                {step.fit.length > 0 && (
                  <ul class="lp-checks lp-step-fit" aria-label={`Geeignet bei – ${step.title}`}>
                    {step.fit.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 4 · What to expect -->
    <section class="lp-section lp-expectation" aria-labelledby="lp-expectation-title">
      <div class="container lp-expectation-grid">
        <div class="lp-expectation-copy">
          <h2 id="lp-expectation-title" class="lp-section-title">Realistische Ergebnisse statt übertriebener Versprechen</h2>
          <p class="lp-section-lead">
            Die Haut kann frischer, glatter und gepflegter wirken. Weil jede Haut anders reagiert,
            wird das Ergebnis vor Ort ehrlich eingeordnet.
          </p>
          <ul class="lp-rows">
            {expectationItems.map((item) => (
              <li>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </li>
            ))}
          </ul>
        </div>
        <figure class="lp-expectation-visual">
          <Image
            src={postTreatmentGlowImage}
            widths={[480, 720, 960, 1200, 1448]}
            sizes={lpHalfSizes}
            format="webp"
            quality={82}
            alt="Frisch gepflegte Haut nach kosmetischer Gesichtsbehandlung"
            loading="lazy"
          />
        </figure>
      </div>
    </section>

    <!-- 5 · Trust -->
    <section class="lp-section lp-trust" aria-labelledby="lp-trust-title">
      <div class="container lp-trust-grid">
        <figure class="lp-trust-media">
          <Image
            src={hautanalyseBeratungImage}
            widths={[360, 540, 720, 960, 1200, 1448]}
            sizes={lpHalfSizes}
            format="webp"
            quality={82}
            alt="Persönliche Hautanalyse und Beratung in Zürich"
            loading="lazy"
          />
        </figure>
        <div class="lp-trust-content">
          <h2 id="lp-trust-title" class="lp-section-title">Persönliche Behandlung statt Standardprogramm</h2>
          <div class="lp-practitioner">
            <Image
              src={teresaPortraitImage}
              widths={[128, 256]}
              sizes="128px"
              format="webp"
              quality={82}
              alt="Teresa Stimac, Inhaberin von Beauty Face Lift Zürich"
              loading="lazy"
              class="lp-practitioner-portrait"
            />
            <figure class="lp-quote">
              <blockquote>„Ich nehme mir Zeit, erkläre jeden Schritt und stimme die Behandlung auf die Haut ab.“</blockquote>
              <figcaption>Teresa Stimac</figcaption>
            </figure>
          </div>
          <p>
            Teresa Stimac führt die Kombi-Behandlung an der Bahnhofstrasse&nbsp;94 persönlich durch – mit
            ruhiger Beratung, klarer After-Care und realistischen Erwartungen.
          </p>
          <ul class="lp-checks lp-facts" aria-label="Studio und Bewertungen">
            {studioFacts.map((item) => (
              <li>
                {item.href ? (
                  <a href={item.href} target="_blank" rel="noopener noreferrer" data-button-location="trust_reviews">{item.text}</a>
                ) : (
                  <span>{item.text}</span>
                )}
              </li>
            ))}
          </ul>
          <div class="lp-section-cta">
            <a href={`#${LEAD_FORM_ID}`} class="btn" data-treatment={BOOKING_SERVICE} data-button-location="trust_section_lead" data-lead-cta>{PRIMARY_CTA_LABEL}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 6 · Lead form -->
    <section class="container lp-section lp-lead" id={LEAD_FORM_ID} aria-labelledby="lp-lead-title" tabindex="-1">
      <div class="lp-lead-grid">
        <div class="lp-lead-header">
          <h2 id="lp-lead-title" class="lp-section-title">Termin für Aquafacial + Microneedling anfragen</h2>
          <p class="lp-section-lead">
            Kurz ausfüllen – Teresa Stimac meldet sich persönlich, klärt Ihre Fragen und bestätigt den Termin.
          </p>
        </div>

        <div class="lp-form-shell">
          <div class="lp-form-status" data-lead-status role="alert" hidden></div>
          <div class="lp-form-success" data-lead-success tabindex="-1" hidden>
            <h3>Vielen Dank! Ihre Anfrage ist eingegangen.</h3>
            <p>Teresa Stimac meldet sich zeitnah bei Ihnen, um den Termin für Aquafacial + Microneedling abzustimmen.</p>
            <a class="lp-secondary-link" href={bookingHref} data-treatment={BOOKING_SERVICE} data-button-location="form_success_booking">{BOOKING_CTA_LABEL}</a>
          </div>

          <form id={LEAD_FORM_TARGET_ID} class="lp-lead-form" action="/api/contact" method="post" data-lead-form novalidate>
            <input type="hidden" name="topic" value={CONTACT_TOPIC} />
            <input type="hidden" name="source" value={CONTACT_SOURCE} />
            <input type="hidden" name="campaign" value={CONTACT_CAMPAIGN} />
            <input type="hidden" name="offer" value={OFFER_SLUG} />
            <input type="hidden" name="treatment" value={BOOKING_SERVICE} />
            <input type="hidden" name="landing_page" value={LANDING_PAGE_PATH} />
            <input type="hidden" name="page_path" value={LANDING_PAGE_PATH} />
            <input type="hidden" name="page_url" value="" />
            <input type="hidden" name="referrer" value="" />
            <input type="hidden" name="utm_source" value="" />
            <input type="hidden" name="utm_medium" value="" />
            <input type="hidden" name="utm_campaign" value="" />
            <input type="hidden" name="utm_content" value="" />
            <input type="hidden" name="utm_term" value="" />
            <input type="hidden" name="fbclid" value="" />
            <input type="hidden" name="gclid" value="" />
            <input type="hidden" name="msclkid" value="" />

            <ol class="lp-next-steps" aria-label="So geht es weiter">
              {nextSteps.map((step) => (
                <li>{step}</li>
              ))}
            </ol>

            <div class="lp-form-row">
              <label for="aqua-lead-name">Vor- und Nachname <span aria-hidden="true">*</span></label>
              <input id="aqua-lead-name" name="name" type="text" maxlength="120" autocomplete="name" required aria-describedby="aqua-lead-name-error" />
              <p id="aqua-lead-name-error" class="lp-field-error" data-field-error="name" hidden></p>
            </div>

            <div class="lp-form-row-grid">
              <div class="lp-form-row">
                <label for="aqua-lead-phone">Telefon / WhatsApp <span aria-hidden="true">*</span></label>
                <input id="aqua-lead-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+41 79 000 00 00" required aria-describedby="aqua-lead-phone-error" />
                <p id="aqua-lead-phone-error" class="lp-field-error" data-field-error="phone" hidden></p>
              </div>
              <div class="lp-form-row">
                <label for="aqua-lead-email">E-Mail <span class="lp-optional">(optional)</span></label>
                <input id="aqua-lead-email" name="email" type="email" inputmode="email" autocomplete="email" placeholder="name@email.ch" aria-describedby="aqua-lead-email-error" />
                <p id="aqua-lead-email-error" class="lp-field-error" data-field-error="email" hidden></p>
              </div>
            </div>

            <div class="lp-form-row-grid">
              <div class="lp-form-row">
                <label for="aqua-lead-goal">Was möchten Sie verbessern? <span class="lp-optional">(optional)</span></label>
                <div class="lp-select">
                  <select id="aqua-lead-goal" name="skinGoal">
                    <option value="">Bitte auswählen</option>
                    {skinGoals.map((goal) => (
                      <option value={goal}>{goal}</option>
                    ))}
                  </select>
                </div>
              </div>
              <div class="lp-form-row">
                <label for="aqua-lead-date">Terminwunsch <span class="lp-optional">(optional)</span></label>
                <input id="aqua-lead-date" name="preferred_date" type="date" />
              </div>
            </div>

            <div class="lp-form-row">
              <label for="aqua-lead-note">Kurze Nachricht <span class="lp-optional">(optional)</span></label>
              <textarea id="aqua-lead-note" name="leadNote" maxlength="3800" rows="3" placeholder="z. B. empfindliche Haut, wichtige Termine, bisherige Erfahrungen"></textarea>
            </div>

            <div class="lp-honeypot" aria-hidden="true" inert>
              <label for="aqua-lead-company">Firma</label>
              <input id="aqua-lead-company" name="company" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
            </div>

            <label class="lp-checkbox" for="aqua-lead-privacy">
              <input id="aqua-lead-privacy" name="privacyConsent" type="checkbox" value="yes" required aria-describedby="aqua-lead-privacy-error" />
              <span>Ich habe die <a href="/datenschutz/" target="_blank" rel="noopener">Datenschutzerklärung</a> gelesen und bin einverstanden, dass Beauty Face Lift mich zu meiner Anfrage kontaktiert.</span>
            </label>
            <p id="aqua-lead-privacy-error" class="lp-field-error" data-field-error="privacyConsent" hidden></p>

            <div class="lp-form-submit">
              <button type="submit" class="btn lp-submit" data-lead-submit data-button-location="lead_form_submit">
                <span data-submit-label>{PRIMARY_CTA_LABEL}</span>
              </button>
              <p class="lp-form-note">Keine Online-Zahlung. Das Studio meldet sich persönlich bei Ihnen.</p>
            </div>
          </form>
        </div>
      </div>
    </section>

    <!-- 7 · FAQ -->
    <section class="lp-section lp-section--rule lp-faq" aria-labelledby="lp-faq-title">
      <div class="container lp-faq-grid">
        <div class="lp-faq-head">
          <h2 id="lp-faq-title" class="lp-section-title">Häufige Fragen zur Kombi-Behandlung</h2>
        </div>
        <FAQAccordion items={faqs} />
      </div>
    </section>

    <!-- 8 · Studio and directions; the map loads only on request (≈500 KB of scripts, data to Google) -->
    <section class="lp-section lp-section--rule lp-location" id="anfahrt" aria-labelledby="lp-location-title">
      <div class="container lp-location-grid">
        <div class="lp-location-copy">
          <h2 id="lp-location-title" class="lp-section-title">Bahnhofstrasse 94 · Zürich</h2>
          <p class="lp-section-lead">
            Beauty Face Lift liegt zentral in {ADDRESS.postalCode} {ADDRESS.city}, wenige Gehminuten vom
            Hauptbahnhof entfernt.
          </p>
          <dl class="lp-location-info" aria-label="Anfahrt und Öffnungszeiten">
            <div class="lp-location-item">
              <dt>Anreise</dt>
              <dd>Vom Zürich HB sind es wenige Gehminuten; die Tram-Haltestelle Bahnhofstrasse/HB liegt direkt in der Nähe. Parkhäuser gibt es in der Umgebung.</dd>
            </div>
            <div class="lp-location-item lp-location-hours">
              <dt>Öffnungszeiten</dt>
              <dd>
                <dl>
                  {OPENING_HOURS.map((item) => (
                    <>
                      <dt>{item.label}</dt>
                      <dd>{item.value}</dd>
                    </>
                  ))}
                </dl>
              </dd>
            </div>
          </dl>
          <a
            href={googleMapsDirectionsUrl}
            class="btn btn-secondary lp-location-route"
            target="_blank"
            rel="noopener"
            data-track-contact="maps"
            data-source="aquafacial_location"
          >
            Route in Google Maps öffnen
          </a>
        </div>

        <div class="lp-map-panel" id="studio-map" data-map-embed={googleMapsEmbedUrl}>
          <div class="lp-map-placeholder" data-map-placeholder>
            <button type="button" class="btn btn-secondary" data-map-load data-button-location="location_map_load">Karte laden</button>
            <p class="lp-map-note">Beim Laden der Karte werden Daten an Google übertragen.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 9 · Closing band -->
    <section class="lp-final-dark on-dark" aria-labelledby="lp-final-title">
      <div class="lp-final-inner">
        <div class="lp-final-copy">
          <h2 id="lp-final-title" class="lp-final-title">Aquafacial + Microneedling für CHF&nbsp;{PROMO_PRICE}.– statt CHF&nbsp;{REGULAR_PRICE}.–</h2>
          <p class="lp-final-lead">
            Senden Sie Ihren Terminwunsch unverbindlich – Teresa Stimac stimmt die Behandlung persönlich
            auf Ihre Haut ab.
          </p>
        </div>
        <div class="lp-final-actions">
          <div class="lp-final-ctas">
            <a href={`#${LEAD_FORM_ID}`} class="btn" data-treatment={BOOKING_SERVICE} data-button-location="lp_final_lead" data-lead-cta>{PRIMARY_CTA_LABEL}</a>
            <WhatsAppButton variant="link" message={whatsappMessage} source="aquafacial_final" label={SECONDARY_CTA_LABEL} />
          </div>
          <a href={bookingHref} class="lp-final-booking" data-treatment={BOOKING_SERVICE} data-button-location="lp_final_booking">{BOOKING_CTA_LABEL}</a>
          <p class="lp-final-address">Beauty Face Lift · {ADDRESS.street} · {ADDRESS.postalCode}&nbsp;{ADDRESS.city}</p>
        </div>
      </div>
    </section>

    <div class="lp-mobile-sticky on-dark" role="complementary" aria-label="Aquafacial + Microneedling anfragen" data-mobile-sticky inert>
      <div class="lp-mobile-sticky-offer">
        <span>CHF {PROMO_PRICE} statt CHF {REGULAR_PRICE}</span>
        <strong>Aquafacial + Microneedling</strong>
      </div>
      <a href={`#${LEAD_FORM_ID}`} class="btn lp-mobile-sticky-cta" data-treatment={BOOKING_SERVICE} data-button-location="sticky_lead" data-lead-cta>{STICKY_CTA_LABEL}</a>
    </div>

    <WhatsAppButton variant="sticky" message={whatsappMessage} source="aquafacial_floating_whatsapp" label="Per WhatsApp anfragen" />
  </main>

  <script>
    const attributionKeys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'fbclid', 'gclid', 'msclkid'];

    const fieldMessages = {
      name: 'Bitte geben Sie Ihren Namen an.',
      phone: 'Bitte geben Sie eine gültige Telefonnummer an.',
      email: 'Bitte geben Sie eine gültige E-Mail-Adresse an.',
      privacyConsent: 'Bitte bestätigen Sie die Datenschutzerklärung.',
    };
    const SEND_ERROR = 'Ihre Anfrage konnte gerade nicht gesendet werden. Bitte versuchen Sie es erneut oder schreiben Sie uns direkt per WhatsApp.';

    function getStoredAttribution(): Record<string, string> {
      try {
        return JSON.parse(sessionStorage.getItem('bfl_utm') || '{}') || {};
      } catch {
        return {};
      }
    }

    function fieldValue(form: HTMLFormElement, name: string) {
      const field = form.elements.namedItem(name);
      if (!field) return '';
      if (field instanceof RadioNodeList) return String(field.value || '').trim();
      return String((field as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement).value || '').trim();
    }

    function setFieldError(form: HTMLFormElement, name: string, message: string) {
      const error = form.querySelector<HTMLElement>(`[data-field-error="${name}"]`);
      const field = form.elements.namedItem(name);
      if (error) {
        error.textContent = message;
        error.hidden = !message;
      }
      if (field instanceof HTMLElement) field.setAttribute('aria-invalid', message ? 'true' : 'false');
    }

    function clearErrors(form: HTMLFormElement) {
      Object.keys(fieldMessages).forEach((name) => setFieldError(form, name, ''));
    }

    // Same rules as the Worker, so the browser never accepts what the server would reject.
    function isValidEmail(email: string) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    }

    function isValidPhone(phone: string) {
      const digits = phone.replace(/\D/g, '');
      return digits.length >= 8 && digits.length <= 15;
    }

    function validateLeadForm(form: HTMLFormElement) {
      clearErrors(form);
      let valid = true;

      if (!fieldValue(form, 'name')) {
        setFieldError(form, 'name', fieldMessages.name);
        valid = false;
      }

      const phone = fieldValue(form, 'phone');
      if (!phone || !isValidPhone(phone)) {
        setFieldError(form, 'phone', fieldMessages.phone);
        valid = false;
      }

      const email = fieldValue(form, 'email');
      if (email && !isValidEmail(email)) {
        setFieldError(form, 'email', fieldMessages.email);
        valid = false;
      }

      const privacy = form.elements.namedItem('privacyConsent');
      if (!(privacy instanceof HTMLInputElement) || !privacy.checked) {
        setFieldError(form, 'privacyConsent', fieldMessages.privacyConsent);
        valid = false;
      }

      return valid;
    }

    function setHiddenValue(form: HTMLFormElement, name: string, value: string) {
      const input = form.elements.namedItem(name);
      if (input instanceof HTMLInputElement) input.value = value || '';
    }

    function fillAttribution(form: HTMLFormElement) {
      const params = new URLSearchParams(window.location.search);
      const stored = getStoredAttribution();
      attributionKeys.forEach((key) => {
        setHiddenValue(form, key, params.get(key) || stored[key] || '');
      });
      setHiddenValue(form, 'page_path', window.location.pathname);
      setHiddenValue(form, 'page_url', window.location.href);
      setHiddenValue(form, 'referrer', document.referrer);
    }

    // The Worker reads the JSON keys below; the free-text fields are folded into one message.
    function formPayload(form: HTMLFormElement) {
      const data = new FormData(form);
      const payload: Record<string, string> = {};
      data.forEach((value, key) => {
        payload[key] = typeof value === 'string' ? value : '';
      });
      const skinGoal = (payload.skinGoal || '').trim();
      const note = (payload.leadNote || '').trim();
      payload.message = [
        'Aquafacial + Microneedling Terminwunsch',
        skinGoal ? `Hautziel: ${skinGoal}` : '',
        note ? `Nachricht: ${note}` : '',
      ].filter(Boolean).join('\n');
      payload.preferredDate = payload.preferred_date || '';
      payload.skinConcern = skinGoal;
      return payload;
    }

    function initLeadForm() {
      const form = document.querySelector('[data-lead-form]');
      if (!(form instanceof HTMLFormElement)) return;

      const status = document.querySelector('[data-lead-status]');
      const success = document.querySelector('[data-lead-success]');
      const submit = form.querySelector('[data-lead-submit]');
      const submitLabel = form.querySelector('[data-submit-label]');
      const idleLabel = submitLabel?.textContent || '';
      let pending = false;
      let tracked = false;

      fillAttribution(form);

      const dateInput = form.querySelector('#aqua-lead-date');
      if (dateInput instanceof HTMLInputElement) {
        const today = new Date();
        dateInput.min = [today.getFullYear(), String(today.getMonth() + 1).padStart(2, '0'), String(today.getDate()).padStart(2, '0')].join('-');
      }

      // Typing in a field clears only that field's message; the others stay until fixed.
      const clearOwnError = (event: Event) => {
        const target = event.target;
        if (target instanceof HTMLInputElement || target instanceof HTMLSelectElement || target instanceof HTMLTextAreaElement) {
          if (target.name in fieldMessages) setFieldError(form, target.name, '');
        }
      };
      form.addEventListener('input', clearOwnError);
      form.addEventListener('change', clearOwnError);

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (pending) return;
        fillAttribution(form);

        if (!validateLeadForm(form)) {
          const firstInvalid = form.querySelector('[aria-invalid="true"]');
          if (firstInvalid instanceof HTMLElement) firstInvalid.focus();
          return;
        }

        pending = true;
        if (status instanceof HTMLElement) status.hidden = true;
        if (submit instanceof HTMLButtonElement) submit.disabled = true;
        if (submitLabel instanceof HTMLElement) submitLabel.textContent = 'Anfrage wird gesendet ...';

        try {
          const payload = formPayload(form);
          const response = await fetch(form.action, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
            },
            body: JSON.stringify(payload),
          });

          if (!response.ok) {
            // The Worker answers with its own German message (validation, rate limit); show it when present.
            let serverMessage = '';
            try {
              const body = await response.json();
              if (body && typeof body.error === 'string') serverMessage = body.error.trim();
            } catch { /* no JSON body */ }
            throw new Error(serverMessage || SEND_ERROR);
          }

          form.hidden = true;
          if (success instanceof HTMLElement) {
            success.hidden = false;
            success.focus();
          }
          document.body.classList.add('lp-lead-success');

          // The lead counts only once the server accepted the enquiry.
          if (!tracked) {
            tracked = true;
            void window.bflTracking?.trackLead?.({
              source: 'aquafacial_microneedling_lp_form',
              value: 170,
              currency: 'CHF',
              email: payload.email || '',
              phone: payload.phone || '',
            });
          }
        } catch (error) {
          if (status instanceof HTMLElement) {
            status.textContent = error instanceof Error ? error.message : SEND_ERROR;
            status.hidden = false;
            status.tabIndex = -1;
            status.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' });
            status.focus({ preventScroll: true });
          }
        } finally {
          pending = false;
          if (!form.hidden && submit instanceof HTMLButtonElement) submit.disabled = false;
          if (!form.hidden && submitLabel instanceof HTMLElement) submitLabel.textContent = idleLabel;
        }
      });
    }

    function initLeadScroll() {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.querySelectorAll<HTMLAnchorElement>('[data-lead-cta]').forEach((link) => {
        link.addEventListener('click', (event) => {
          window.dataLayer?.push({
            event: 'cta_click_lead_form',
            button_location: link.getAttribute('data-button-location') || 'aquafacial_lp',
            treatment_name: 'Aquafacial + Microneedling',
          });
          const target = document.querySelector('#anfrage');
          if (!(target instanceof HTMLElement)) return;
          event.preventDefault();
          target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
          // Keyboard and screen-reader users continue inside the form, not from the button they left.
          target.focus({ preventScroll: true });
        });
      });
    }

    // Floating UI rules, as on /lp/aquafacial/: the sticky bar appears once the hero has left the
    // viewport; the floating WhatsApp disc after 25 % scroll depth (WhatsAppButton). Both step aside
    // while the lead form is on screen and stay hidden while the consent banner is open (CSS).
    function initFloatingUi() {
      const body = document.body;
      const hero = document.querySelector('[data-lp-hero]');
      const leadSection = document.querySelector('#anfrage');
      const sticky = document.querySelector('[data-mobile-sticky]');
      let pastHero = false;
      let formInView = false;

      function syncSticky() {
        const visible = pastHero && !formInView;
        body.classList.toggle('lp-sticky-visible', visible);
        if (sticky instanceof HTMLElement) sticky.inert = !visible;
      }

      if (!('IntersectionObserver' in window)) return;
      if (hero) {
        new IntersectionObserver((entries) => {
          const entry = entries[entries.length - 1];
          pastHero = !entry.isIntersecting && entry.boundingClientRect.top < 0;
          syncSticky();
        }).observe(hero);
      }
      if (leadSection) {
        new IntersectionObserver((entries) => {
          const entry = entries[entries.length - 1];
          formInView = entry.isIntersecting;
          body.classList.toggle('lp-form-in-view', formInView);
          syncSticky();
        }).observe(leadSection);
      }
    }

    // Click-to-load map, as on /kontakt/.
    function initMap() {
      document.querySelectorAll<HTMLButtonElement>('[data-map-load]').forEach((button) => {
        button.addEventListener('click', () => {
          const panel = button.closest<HTMLElement>('[data-map-embed]');
          if (!panel) return;
          const frame = document.createElement('iframe');
          frame.title = 'Karte mit Beauty Face Lift an der Bahnhofstrasse 94 in Zürich';
          frame.src = panel.dataset.mapEmbed || '';
          frame.referrerPolicy = 'no-referrer-when-downgrade';
          frame.allowFullscreen = true;
          frame.loading = 'lazy';
          panel.querySelector('[data-map-placeholder]')?.remove();
          panel.appendChild(frame);
          frame.focus();
        });
      });
    }

    initLeadForm();
    initLeadScroll();
    initFloatingUi();
    initMap();
  </script>
</LandingPage>

<style>
