  <script>
    const form = document.querySelector('[data-lead-form]');
    const messageInput = document.querySelector('[data-lead-message]');
    const leadCtas = document.querySelectorAll('[data-lead-cta]');
    const mobileSticky = document.querySelector('[data-mobile-sticky]');
    const heroSection = document.querySelector('.lp-hero');
    const stickyQuery = window.matchMedia('(max-width: 900px)');

    const setMobileStickyVisible = (visible: boolean) => {
      document.body.classList.toggle('lp-sticky-visible', visible);
      mobileSticky?.setAttribute('aria-hidden', visible ? 'false' : 'true');
    };

    const updateMobileSticky = () => {
      if (!heroSection || !stickyQuery.matches) {
        setMobileStickyVisible(false);
        return;
      }

      const heroRect = heroSection.getBoundingClientRect();
      const heroBottomThreshold = window.innerHeight * 0.92;
      // Step aside while the lead form (fields + submit) is on screen, as on /lp/aquafacial/.
      const formRect = form?.getBoundingClientRect();
      const formInView = Boolean(formRect && formRect.top < window.innerHeight && formRect.bottom > 0);
      setMobileStickyVisible(heroRect.bottom <= heroBottomThreshold && !formInView);
    };

    if (mobileSticky && heroSection) {
      updateMobileSticky();
      window.addEventListener('scroll', updateMobileSticky, { passive: true });
      window.addEventListener('resize', updateMobileSticky);
      stickyQuery.addEventListener('change', updateMobileSticky);
    }

    leadCtas.forEach((link) => {
      link.addEventListener('click', () => {
        window.dataLayer?.push({
          event: 'cta_click_lead_form',
          button_location: link.getAttribute('data-button-location') || 'aquafacial_lp',
          treatment_name: 'Aquafacial + Microneedling',
        });
      });
    });

    if (form instanceof HTMLFormElement && messageInput instanceof HTMLInputElement) {
      const formError = form.querySelector<HTMLElement>('.lp-form-error');
      const validatedFields = form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input:not([type="hidden"]), select, textarea');

      const emailInput = form.querySelector<HTMLInputElement>('#aqua-lead-email');
      const phoneInput = form.querySelector<HTMLInputElement>('#aqua-lead-phone');
      // Same rules as the Worker, so the browser never accepts what the server would reject.
      const applyServerRules = () => {
        const email = emailInput?.value.trim() ?? '';
        emailInput?.setCustomValidity(email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) ?'Bitte geben Sie eine gültige E-Mail-Adresse an.' : '');
        const phone = phoneInput?.value.trim() ?? '';
        const digits = phone.replace(/\D/g, '');
        phoneInput?.setCustomValidity(phone && (digits.length < 8 || digits.length > 15) ? 'Bitte geben Sie eine gültige Telefonnummer an.' : '');
      };

      const attributionKeys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'fbclid', 'gclid', 'msclkid'];
      const setHidden = (name: string, value: string) => {
        const input = form.elements.namedItem(name);
        if (input instanceof HTMLInputElement) input.value = value || '';
      };
      const fillAttribution = () => {
        const params = new URLSearchParams(window.location.search);
        let stored: Record<string, string> = {};
        try { stored = JSON.parse(sessionStorage.getItem('bfl_utm') || '{}') || {}; } catch { stored = {}; }
        attributionKeys.forEach((key) => setHidden(key, params.get(key) || stored[key] || ''));
        setHidden('page_url', window.location.href);
        setHidden('referrer', document.referrer);
      };
      fillAttribution();

      // The form keeps `novalidate` (no native bubbles); invalid fields are marked inline instead.
      const markInvalidFields = () => {
        validatedFields.forEach((field) => {
          if (field.validity.valid) field.removeAttribute('aria-invalid');
          else field.setAttribute('aria-invalid', 'true');
        });
        if (formError) formError.hidden = form.checkValidity();
      };

      form.addEventListener('input', () => {
        applyServerRules();
        if (form.classList.contains('is-validated')) markInvalidFields();
      });
      form.addEventListener('change', () => {
        if (form.classList.contains('is-validated')) markInvalidFields();
      });

      form.addEventListener('submit', (event) => {
        applyServerRules();
        fillAttribution();
        if (!form.checkValidity()) {
          event.preventDefault();
          form.classList.add('is-validated');
          markInvalidFields();
          form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
          return;
        }

        const data = new FormData(form);
        const skinGoal = String(data.get('skinGoal') || '').trim();
        const preferredTime = String(data.get('preferredCallbackTime') || '').trim();
        const note = String(data.get('leadNote') || '').trim();
        const parts = [
          'Aquafacial + Microneedling Terminwunsch',
          skinGoal ? `Hautziel: ${skinGoal}` : '',
          preferredTime ? `Terminpräferenz: ${preferredTime}` : '',
          note ? `Nachricht: ${note}` : '',
        ].filter(Boolean);

        messageInput.value = parts.join('\n');
        window.bflTracking?.trackLead?.({
          source: 'aquafacial_microneedling_lp_form',
          value: 170,
          currency: 'CHF',
          email: String(data.get('email') || ''),
          phone: String(data.get('phone') || ''),
        });
      });
    }
  </script>
</LandingPage>

<style>
  /* ═══ Page frame ═════════════════════════════════════════════ */
  .lp-page {
    color: var(--text);
    background: var(--porcelain);
  }

  .lp-section {
    padding-block: clamp(72px, 9vw, 136px);
  }

  .lp-section--rule {
    border-top: 1px solid var(--rule);
  }

  /* Section head: H2 left, one short lead right */
  .lp-head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: end;
    gap: 24px clamp(40px, 6vw, 104px);
    margin-bottom: clamp(40px, 5vw, 72px);
  }

