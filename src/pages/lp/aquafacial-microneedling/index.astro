  .lp-hero-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 32px;
    margin-top: clamp(22px, 2.4vw, 30px);
  }

  .lp-hero-proof {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    max-width: none;
    margin: 18px 0 0;
    color: var(--text);
    font-size: 0.92rem;
  }

  .lp-hero-proof strong {
    color: var(--cocoa);
    font-weight: 600;
  }

  .lp-stars {
    color: var(--gold);
    font-size: 0.9rem;
    letter-spacing: 0.1em;
  }

  /* Treatment photo in the site's arch frame */
  .lp-hero-media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    margin: 0;
    border-radius: var(--r-pill) var(--r-pill) var(--r-lg) var(--r-lg);
    background: var(--stone);
  }

  .lp-hero-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 50%;
  }

  /* ═══ 2 · Offer ══════════════════════════════════════════════ */
  .lp-offer-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: start;
    gap: clamp(40px, 6vw, 96px);
  }

  .lp-offer-copy .lp-section-lead {
    margin-top: 20px;
  }

  .lp-included-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(24px, 3vw, 48px);
    margin-top: clamp(28px, 3vw, 40px);
    border-top: 1px solid var(--rule-strong);
  }

  .lp-offer-card {
    display: grid;
    gap: 22px;
  }

  /* Shared TrustStrip under the card: the four promises in two columns. */
  .lp-offer-card :global(.trust-strip-lp) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 20px;
    padding-inline: 8px;
  }


  /* ═══ 4 · Steps of the appointment (image cards) ═════════════ */
  .lp-phases-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px clamp(24px, 3vw, 48px);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: lp-phase;
  }

  .lp-phase {
    counter-increment: lp-phase;
    display: grid;
    align-content: start;
    gap: 20px;
  }

  .lp-phase-media {
    aspect-ratio: 4 / 5;
  }

  .lp-phase-copy {
    display: grid;
    gap: 10px;
  }

  .lp-phase h3 {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: var(--fs-h4);
  }

  .lp-phase h3::before {
    content: counter(lp-phase);
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: var(--r-pill);
    background: var(--clay);
    color: var(--paper);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .lp-phase p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
  }

  .lp-phases-list :global(img.lp-crop-aquafacial) {
    object-position: 50% 40%;
  }

  .lp-phases-list :global(img.lp-crop-needling) {
    object-position: 56% 50%;
  }

  .lp-phases-list :global(img.lp-crop-aftercare) {
    object-position: 48% 50%;
  }

  /* ═══ 5 · Two-step focus ═════════════════════════════════════ */
  .lp-focus-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: 40px clamp(28px, 3.5vw, 56px);
  }

  .lp-combination-infographic {
    margin: 0;
    aspect-ratio: 1122 / 1402;
    background: var(--paper);
  }

  .lp-combination-infographic :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .lp-focus-item {
    display: grid;
    align-content: start;
    gap: 14px;
    padding-top: 22px;
    border-top: 1px solid var(--rule-strong);
  }

  .lp-focus-item h3 {
    max-width: 24ch;
    font-size: var(--fs-h4);
  }

  .lp-focus-item p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
  }

  .lp-focus-item .lp-checks {
    margin-top: 6px;
    border-top: 1px solid var(--rule);
  }

  /* ═══ 6 · Trust ══════════════════════════════════════════════ */
  .lp-trust-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    align-items: center;
    gap: clamp(40px, 7vw, 120px);
  }

  .lp-trust-media {
    margin: 0;
    aspect-ratio: 4 / 5;
  }

  .lp-trust-media :global(img) {
    object-position: 50% 45%;
  }

  .lp-trust-content {
    display: grid;
    justify-items: start;
    gap: 24px;
  }

  .lp-trust-content > p {
    max-width: 52ch;
    margin: 0;
  }

  .lp-quote {
    display: grid;
    gap: 12px;
    margin: 0;
  }

  .lp-quote blockquote {
    max-width: 30ch;
    margin: 0;
    color: var(--espresso);
    font-family: var(--f-display);
    font-size: clamp(1.5rem, 2.2vw, 1.9rem);
    line-height: 1.25;
  }

  .lp-quote figcaption {
    color: var(--clay);
    font-size: var(--fs-label);
    font-weight: 500;
  }

  .lp-proof-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule);
  }

  .lp-proof-item {
    display: grid;
    gap: 8px;
    padding: 20px 18px 20px 0;
  }

  .lp-proof-item + .lp-proof-item {
    padding-left: 22px;
    border-left: 1px solid var(--rule);
  }

  .lp-proof-item strong {
    color: var(--espresso);
    font-family: var(--f-display);
    font-size: clamp(1.6rem, 2.4vw, 2.1rem);
    font-weight: 400;
    line-height: 1;
    font-variant-numeric: lining-nums;
  }

  .lp-proof-item span {
    color: var(--muted);
    font-size: var(--fs-label);
    line-height: 1.4;
  }

  /* ═══ 7 · Expectation ════════════════════════════════════════ */
  .lp-expectation-grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    align-items: center;
    gap: clamp(40px, 7vw, 120px);
  }

  .lp-expectation-copy {
    display: grid;
    justify-items: start;
    gap: 22px;
  }

  .lp-expectation-copy .lp-rows {
    width: 100%;
    margin-top: 10px;
  }

  .lp-expectation-visual {
    margin: 0;
    aspect-ratio: 4 / 5;
  }

  .lp-expectation-visual :global(img) {
    object-position: 58% 40%;
  }

  /* ═══ 8 · Process ════════════════════════════════════════════ */
  .lp-steps {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 0;
  }

  /* ═══ 9 · Lead form ══════════════════════════════════════════ */
  .lp-lead-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    align-items: start;
    gap: clamp(40px, 6vw, 96px);
  }

  .lp-lead-copy {
    display: grid;
    justify-items: start;
    gap: 24px;
  }

  .lp-lead-copy .lp-section-title {
    max-width: 16ch;
  }

  .lp-lead-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
  }

  .lp-lead-visual {
    width: 100%;
    aspect-ratio: 4 / 3;
    margin: 8px 0 0;
  }

  .lp-lead-visual :global(img) {
    object-position: 50% 30%;
  }

  .lp-lead-form {
    display: grid;
    gap: 20px;
    padding: clamp(24px, 4vw, 52px);
    background: var(--ivory);
    border: 1px solid var(--rule);
    border-radius: var(--r-xl);
    scroll-margin-top: 24px;
  }

  .lp-form-title {
    margin: 0;
    color: var(--espresso);
    font-family: var(--f-display);
    font-size: clamp(1.7rem, 2.4vw, 2.1rem);
    line-height: 1.1;
  }

  /* Form-level error: the contact page's error panel. */
  .lp-form-error {
    max-width: none;
    margin: 0;
    padding: 16px 20px;
    border-radius: var(--r);
    background: color-mix(in srgb, var(--error) 8%, transparent);
    color: var(--error);
    font-size: var(--fs-small);
    font-weight: 500;
    line-height: 1.5;
  }

  .lp-form-error[hidden] {
    display: none;
  }

  .lp-field-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .lp-field {
    position: relative;
    display: grid;
    gap: 8px;
    align-content: start;
  }

  .lp-field--full {
    grid-column: 1 / -1;
  }

  .lp-field label {
    color: var(--cocoa);
    font-size: var(--fs-small);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0;
    text-transform: none;
  }

  .lp-field label span,
  .lp-checkbox > span > span {
    color: var(--clay);
  }

  .lp-field input,
  .lp-field select,
  .lp-field textarea {
    width: 100%;
    min-height: 52px;
    padding: 13px 16px;
    color: var(--espresso);
    font: inherit;
    font-size: 1rem;
    line-height: 1.4;
    background: var(--porcelain);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-input);
    transition: border-color 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease;
  }

  .lp-field select {
    appearance: none;
    padding-right: 44px;
    cursor: pointer;
  }

  /* Chevron shares the select's grid cell so inline error text never displaces it. */
  .lp-field--select label {
    grid-row: 1;
  }

  .lp-field--select select {
    grid-row: 2;
    grid-column: 1;
  }

  .lp-field--select::after {
    content: '';
    grid-row: 2;
    grid-column: 1;
    justify-self: end;
    align-self: center;
    width: 7px;
    height: 7px;
    margin-right: 20px;
    border-right: 1px solid var(--espresso);
    border-bottom: 1px solid var(--espresso);
    transform: translateY(-2px) rotate(45deg);
    pointer-events: none;
  }

  .lp-field textarea {
    min-height: 120px;
    resize: vertical;
  }

  .lp-field input::placeholder,
  .lp-field textarea::placeholder {
    color: var(--muted);
    opacity: 0.8;
  }

  .lp-field input:hover,
  .lp-field select:hover,
  .lp-field textarea:hover {
    border-color: var(--taupe);
  }

  .lp-field input:focus-visible,
  .lp-field select:focus-visible,
  .lp-field textarea:focus-visible {
    border-color: var(--clay);
    outline: none;
    background: var(--ivory);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--clay) 14%, transparent);
  }

  /* Field errors as on master: the script sets aria-invalid, focuses the first invalid
     field and shows the role="alert" summary; fields and labels turn bronze. */
  .lp-lead-form.is-validated .lp-field :is(input, select, textarea):invalid {
    border-color: var(--bronze);
    border-bottom-width: 2px;
  }

  .lp-lead-form.is-validated .lp-field:has(:invalid) label {
    color: var(--bronze);
  }

  .lp-checkbox {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    align-items: start;
    gap: 12px;
    padding-top: 18px;
    border-top: 1px solid var(--rule);
    color: var(--umber);
    font-size: var(--fs-small);
    line-height: 1.5;
    cursor: pointer;
  }

  .lp-checkbox input {
    width: 18px;
    height: 18px;
    margin-top: 2px;
    accent-color: var(--clay);
  }

  .lp-lead-form.is-validated .lp-checkbox:has(:invalid) {
    color: var(--bronze);
  }

  .lp-lead-form.is-validated .lp-checkbox input:invalid {
    outline: 1px solid var(--bronze);
    outline-offset: 2px;
  }

  .lp-checkbox a {
    color: var(--espresso);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .lp-honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .lp-lead-submit {
    min-height: 54px;
    margin-top: 4px;
  }

  .lp-form-note {
    max-width: none;
    margin: 0;
    color: var(--muted);
    font-size: var(--fs-small);
    line-height: 1.5;
    text-align: center;
  }

  /* ═══ 10 · FAQ (shared accordion keeps its own look) ═════════ */
  .lp-faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    align-items: start;
    gap: clamp(40px, 7vw, 120px);
  }

  .lp-faq-head {
    position: sticky;
    top: 40px;
  }

  .lp-faq :global(.faq-accordion-lp) {
    max-width: none;
    margin: 0;
  }

  /* ═══ 11 · Booking ═══════════════════════════════════════════ */
  .lp-booking {
    padding-top: 0;
  }

  .lp-booking :global(.booking-cta) {
    margin: 0;
  }

  /* ═══ 12 · Location ══════════════════════════════════════════ */
  .lp-location-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    align-items: stretch;
    gap: clamp(40px, 6vw, 96px);
  }

  .lp-location-copy {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 20px;
  }

  .lp-location-kicker {
    margin: 0;
  }

  .lp-location-copy .lp-section-title {
    max-width: none;
    text-wrap: wrap;
  }

  .lp-location-info {
    width: 100%;
    margin: 8px 0 0;
    border-top: 1px solid var(--rule-strong);
  }

  .lp-location-item {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: 6px 24px;
    padding-block: 16px;
    border-bottom: 1px solid var(--rule);
  }

  .lp-location-item > dt {
    color: var(--cocoa);
    font-weight: 500;
  }

  .lp-location-item > dd {
    margin: 0;
    color: var(--umber);
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .lp-location-hours dd dl {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 4px 16px;
    margin: 0;
  }

  .lp-location-hours dd dt {
    white-space: nowrap;
  }

  .lp-location-hours dd dd {
    margin: 0;
    color: var(--espresso);
    text-align: right;
  }

  .lp-location-route {
    margin-top: 8px;
  }

  .lp-map-panel {
    min-height: 420px;
    overflow: hidden;
    border-radius: var(--r-lg);
    background: var(--stone);
  }

  .lp-map-panel iframe {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 420px;
    border: 0;
    filter: grayscale(0.35) contrast(0.96);
  }

  /* ═══ 13 · Closing band ══════════════════════════════════════ */
  .lp-final-dark {
    padding: clamp(72px, 9vw, 136px) var(--content-px);
  }

  .lp-final-inner {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: end;
    gap: 40px clamp(40px, 6vw, 104px);
    max-width: var(--container);
    margin: 0 auto;
  }

  .lp-final-title {
    max-width: 16ch;
    color: var(--porcelain);
    font-size: var(--fs-h2);
    line-height: 1.06;
    letter-spacing: -0.015em;
  }

  .lp-final-lead {
    max-width: 52ch;
    margin: 24px 0 0;
    color: var(--champagne);
  }

  .lp-final-actions {
    display: grid;
    justify-items: start;
    gap: 28px;
  }

  .lp-final-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }

  .lp-final-ctas .btn-link {
    flex-basis: 100%;
  }

  .lp-final-address {
    width: 100%;
    max-width: none;
    margin: 0;
    padding-top: 20px;
    border-top: 1px solid var(--rule-light);
    color: var(--champagne);
    font-size: var(--fs-small);
    font-weight: 400;
  }

  /* ═══ Mobile sticky bar ══════════════════════════════════════ */
  .lp-mobile-sticky {
    display: none;
  }

  /* ═══ Responsive ═════════════════════════════════════════════ */
  @media (max-width: 1100px) {
    .lp-grid--4,
    .lp-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 36px;
    }

    .lp-focus-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .lp-combination-infographic {
      grid-column: 1 / -1;
      width: min(100%, 440px);
    }

    .lp-included-list,
    .lp-offer-card :global(.trust-strip-lp) {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 900px) {
    .lp-head,
    .lp-hero-grid,
    .lp-offer-grid,
    .lp-trust-grid,
    .lp-expectation-grid,
    .lp-lead-grid,
    .lp-faq-grid,
    .lp-location-grid,
    .lp-final-inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .lp-head {
      align-items: start;
      gap: 20px;
    }

    /* Hero stacks: photo band on top, then kicker, H1, price, CTAs, proof, subtitle. */
    .lp-hero {
      padding-top: 0;
      padding-bottom: 40px;
    }

    .lp-hero-grid {
      gap: 24px;
    }

    .lp-hero-media {
      order: -1;
      aspect-ratio: 16 / 9;
      margin-inline: calc(-1 * var(--gutter));
      border-radius: 0;
    }

    .lp-hero-media :global(img) {
      object-position: 60% 40%;
    }

    .lp-subtitle {
      order: 1;
      margin-top: 22px;
    }

    .lp-hero-bullets {
      order: 3;
      margin-top: 12px;
    }

    .lp-hero-offer {
      margin-top: 16px;
      padding-block: 0;
      border: 0;
      gap: 4px 10px;
    }

    .lp-hero-offer-label {
      flex-basis: 100%;
    }

    .lp-hero-ctas {
      margin-top: 18px;
    }

    .lp-hero-proof {
      margin-top: 14px;
    }

    .lp-offer-card {
      max-width: 560px;
    }

    .lp-included-list,
    .lp-offer-card :global(.trust-strip-lp) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .lp-phases-list {
      column-gap: 20px;
    }

    .lp-phase h3 {
      align-items: flex-start;
    }

    .lp-trust-media {
      aspect-ratio: 4 / 4.4;
    }

    .lp-expectation-visual,
    .lp-lead-visual {
      aspect-ratio: 4 / 3;
    }

    .lp-expectation-visual {
      order: 2;
    }

    .lp-faq-head {
      position: static;
    }

    .lp-map-panel,
    .lp-map-panel iframe {
      min-height: 320px;
    }

    .lp-final-ctas {
      display: grid;
      justify-items: start;
      width: 100%;
    }

    /* Booking pill and the shared WhatsApp pill both run full width. */
    .lp-final-ctas :global(.btn) {
      width: 100%;
    }

    /* Mobile sticky bar — shown once the hero leaves the viewport */
    :global(body) {
      --lp-sticky-offer-height: 72px;
    }

    :global(body.bfl-consent-visible) {
      --lp-sticky-offer-height: 0px;
    }

    .lp-mobile-sticky {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 39;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 10px;
      min-height: var(--lp-sticky-offer-height);
      padding: 10px var(--gutter) calc(10px + env(safe-area-inset-bottom, 0px));
      border-top: 1px solid var(--rule-light-strong);
      opacity: 0;
      pointer-events: none;
      transform: translateY(calc(100% + 16px));
      transition: transform 0.35s var(--ease-expo), opacity 0.25s ease;
    }

    :global(body.lp-sticky-visible) .lp-mobile-sticky {
      opacity: 1;
      pointer-events: auto;
      transform: none;
    }

    :global(body.bfl-consent-visible) .lp-mobile-sticky {
      opacity: 0;
      pointer-events: none;
      transform: translateY(calc(100% + 16px));
    }

    .lp-mobile-sticky-price {
      display: grid;
      line-height: 1.1;
      white-space: nowrap;
    }

    .lp-mobile-sticky-price s {
      color: var(--champagne);
      font-size: 0.75rem;
    }

    .lp-mobile-sticky-price strong {
      color: var(--porcelain);
      font-family: var(--f-display);
      font-size: 1.4rem;
      font-weight: 400;
      font-variant-numeric: lining-nums;
    }

    .lp-mobile-sticky .btn {
      min-height: 46px;
      padding: 0 16px;
      font-size: 0.92rem;
      white-space: nowrap;
    }

    .lp-sticky-whatsapp {
      display: inline-grid;
      place-items: center;
      width: 46px;
      height: 46px;
