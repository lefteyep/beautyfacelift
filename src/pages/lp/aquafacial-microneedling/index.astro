---
import LandingPage from '../../../layouts/LandingPage.astro';
import BookingCta from '../../../components/BookingCta.astro';
import OfferBox from '../../../components/lp/OfferBox.astro';
import FAQAccordion from '../../../components/lp/FAQAccordion.astro';
import TrustStrip from '../../../components/lp/TrustStrip.astro';
import WhatsAppButton from '../../../components/lp/WhatsAppButton.astro';
import { Image, getImage } from 'astro:assets';
import heroAquafacialMicroneedlingImage from '../../../assets/lp/aquafacial/hero-aquafacial-microneedling-zuerich.webp';
import heroAquafacialMicroneedlingUrl from '../../../assets/lp/aquafacial/hero-aquafacial-microneedling-zuerich.webp?url';
import aquafacialCloseUpImage from '../../../assets/lp/aquafacial/aquafacial-close-up-zuerich.webp';
import aquafacialMicroneedlingInfographicImage from '../../../assets/lp/aquafacial/aquafacial-microneedling-infografik-zuerich.webp';
import postTreatmentGlowImage from '../../../assets/lp/aquafacial/post-treatment-glow-zuerich.webp';
import hautanalyseBeratungImage from '../../../assets/lp/aquafacial/hautanalyse-beratung-zuerich.webp';
import abschlusspflegeAftercareImage from '../../../assets/lp/aquafacial/abschlusspflege-aftercare-zuerich.webp';
import microneedlingCloseUpImage from '../../../assets/lp/aquafacial/microneedling-close-up-zuerich.webp';
import personalTreatmentImage from '../../../assets/lp/aquafacial/personal-treatment-zuerich.webp';
import { ADDRESS, CONTACT_PHONE, OPENING_HOURS, absoluteUrl, bookingLinkForService } from '../../../../shared/site';

const PROMO_PRICE = 170;
const REGULAR_PRICE = 250;
const DURATION_LABEL = '1 Std. 30 Min.';
const OFFER_LABEL = 'Aquafacial + Microneedling Kombi-Angebot';
const OFFER_SLUG = 'aquafacial-microneedling-aktion';
const PRIMARY_CTA_LABEL = 'Jetzt Termin buchen';
const LEAD_CTA_LABEL = 'Hautanalyse & Termin anfragen';
const SECONDARY_CTA_LABEL = 'Per WhatsApp anfragen';
const BOOKING_CTA_LABEL = 'Kombi-Behandlung buchen';
const FORM_CTA_LABEL = 'Terminwunsch senden';
const BOOKING_SERVICE = 'Aquafacial + Microneedling';
// Must be one of CONTACT_TOPICS (shared/site.ts), or the Worker rejects the form (checked by qa:contact).
const CONTACT_TOPIC = 'Ich möchte einen Termin buchen';
// Exempt from Turnstile in worker/routes/contact.ts: this page has no Turnstile widget.
const CONTACT_CAMPAIGN = 'aquafacial_microneedling';
const LEAD_FORM_ID = 'anfrage';
const LEAD_FORM_TARGET_ID = 'anfrage-form';
const bookingHref = `${bookingLinkForService(BOOKING_SERVICE)}&offer=${OFFER_SLUG}&price=${PROMO_PRICE}`;
const whatsappMessage = 'Hallo Teresa, ich interessiere mich für Aquafacial + Microneedling in Zürich. Ist die Kombi-Behandlung für mein Hautziel geeignet?';
const whatsappHref = `https://wa.me/${CONTACT_PHONE.replace('+', '')}?text=${encodeURIComponent(whatsappMessage)}`;
// Desktop: the landscape photo is cover-cropped into a 4:5 arch, so the requested width
// follows the frame height (≈ 1.78 × its width). Stacked (≤ 900px) it is a full-bleed 16:9 band.
const lpHeroWidths = [480, 720, 960, 1200, 1440, 1672];
const lpHeroSizes = '(min-width: 1320px) 1100px, (min-width: 901px) 80vw, 100vw';
const lpHeroQuality = 86;
const lpHalfSizes = '(min-width: 1440px) 640px, (min-width: 901px) 46vw, 100vw';
const lpThirdSizes = '(min-width: 1440px) 420px, (min-width: 901px) 31vw, 40vw';
const lpInfographicSizes = '(min-width: 1440px) 400px, (min-width: 1101px) 30vw, (min-width: 761px) 440px, 100vw';
// Word joiner after the en dash keeps "24–48" on one line.
const HOURS_24_48 = '24–⁠48 Stunden';
const studioAddress = `${ADDRESS.street}, ${ADDRESS.postalCode} ${ADDRESS.city}`;
const googleMapsEmbedUrl = `https://www.google.com/maps?q=${encodeURIComponent(`Beauty Face Lift ${studioAddress}`)}&output=embed`;
const googleMapsDirectionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(studioAddress)}`;

const lpHeroPreload = await getImage({
  src: heroAquafacialMicroneedlingImage,
  widths: lpHeroWidths,
  sizes: lpHeroSizes,
  format: 'webp',
  quality: lpHeroQuality,
});

// Desktop only (hidden on phones by QA): what is included, the outcome, who treats you.
const heroBullets = [
  'Hautanalyse, Aquafacial, Microneedling und Abschlusspflege',
  'Für mehr Glow, optisch feinere Poren und glatter wirkende Haut',
  'Persönlich durch Teresa Stimac, 20+ Jahre Erfahrung',
];

// In treatment order, so the list reads like the appointment itself.
const includedItems = [
  'Hautanalyse und persönliche Abstimmung',
  'Gründliche Aquafacial Pflege',
  'Intensive Feuchtigkeit für einen gepflegten Glow',
  'Kosmetisches Microneedling mit professionellem Pen',
  'Beruhigende Abschlusspflege',
  `After-Care-Hinweise für die ersten ${HOURS_24_48}`,
];

const desireItems = [
  { title: 'Frischerer Glow', text: 'Die Haut soll wieder gepflegter, wacher und besser versorgt wirken.' },
  { title: 'Glatter wirkendes Hautbild', text: 'Unebenheiten und unruhige Struktur sollen optisch feiner erscheinen.' },
  { title: 'Optisch feinere Poren', text: 'Poren wirken sichtbarer und Sie wünschen sich eine professionelle Einschätzung.' },
  { title: 'Mehr Feuchtigkeit', text: 'Die Haut fühlt sich trocken an oder Make-up liegt nicht mehr gleichmässig.' },
];

// The three steps of the appointment, each with its photo.
const phases = [
  {
    title: 'Aquafacial bereitet vor',
    text: 'Sanfte Reinigung und intensive Feuchtigkeit schaffen eine frische, ruhige Basis für den zweiten Schritt.',
    image: aquafacialCloseUpImage,
    alt: 'Aquafacial Behandlung zur Reinigung und Feuchtigkeitspflege',
    crop: 'lp-crop-aquafacial',
  },
  {
    title: 'Microneedling setzt Mikroimpulse',
    text: 'Der professionelle Pen arbeitet kontrolliert und individuell dosiert. Das kann die natürliche Hauterneuerung kosmetisch unterstützen.',
    image: microneedlingCloseUpImage,
    alt: 'Kosmetisches Microneedling mit professionellem Pen',
    crop: 'lp-crop-needling',
  },
  {
    title: 'Abschlusspflege beruhigt',
    text: `Eine abgestimmte Pflege beruhigt die Haut. Dazu erhalten Sie klare Hinweise für die nächsten ${HOURS_24_48}.`,
    image: abschlusspflegeAftercareImage,
    alt: 'Beruhigende Abschlusspflege nach der Behandlung',
    crop: 'lp-crop-aftercare',
  },
];

const treatmentFocus = [
  {
    title: 'Aquafacial: reinigen, hydratisieren, Glow aufbauen',
    text: 'Der pflegende Teil: Die Haut wird gründlich gereinigt, mit Feuchtigkeit versorgt und auf das Microneedling vorbereitet.',
    items: ['Müde oder fahl wirkende Haut', 'Trockene oder feuchtigkeitsarme Haut', 'Wunsch nach mehr Glow', 'Sanfte Vorbereitung vor dem Microneedling'],
  },
  {
    title: 'Microneedling: gezielte Mikroimpulse für feinere Hautstruktur',
    text: 'Kontrollierte Mikroimpulse, deren Intensität individuell angepasst wird – besonders bei empfindlicher Haut oder der ersten Needling-Erfahrung.',
    items: ['Unruhige Hautstruktur', 'Optisch vergrössert wirkende Poren', 'Unebenheiten', 'Erste Linien und müde wirkendes Hautbild'],
  },
];

const trustProof = [
  { value: '20+', label: 'Jahre Erfahrung' },
  { value: '4,8', label: 'Bewertung auf Treatwell' },
  { value: '248+', label: 'Bewertungen' },
];

const expectationItems = [
  { title: 'Direkt danach', text: 'Die Haut kann frischer und gepflegter wirken. Nach dem Microneedling sind Rötungen möglich.' },
  { title: '24–48 Stunden', text: 'Die Haut beruhigt sich je nach Hauttyp schrittweise. Sanfte Pflege und konsequenter Sonnenschutz sind jetzt besonders wichtig.' },
  { title: 'Weitere Sitzungen', text: 'Für Glow kann eine einzelne Sitzung interessant sein. Bei Strukturthemen wird eine Serie vor Ort realistisch eingeordnet.' },
];

const processSteps = [
  { title: 'Termin anfragen oder buchen', text: 'Direkt online einen freien Termin wählen oder zuerst Ihren Terminwunsch senden.' },
  { title: 'Hautanalyse vor Ort', text: 'Hautzustand, Empfindlichkeit und Ziel werden vor der Behandlung kurz eingeschätzt.' },
  { title: 'Aquafacial + Microneedling', text: 'Die Haut wird gereinigt, hydratisiert und danach mit kontrollierten Mikroimpulsen behandelt.' },
  { title: 'Abschlusspflege und After-Care', text: 'Die Haut wird beruhigt. Sie erhalten klare Hinweise zu Make-up, Sonne, Sport, Sauna und Pflegeprodukten.' },
];

const locationItems = [
  {
    title: 'Mit dem ÖV',
    text: 'Paradeplatz und Börsenstrasse sind in wenigen Minuten zu Fuss erreichbar; vom Zürich HB fahren Trams direkt in die Innenstadt.',
  },
  {
    title: 'Mit dem Auto',
    text: 'Parkhäuser rund um Paradeplatz, Bleicherweg und Urania liegen in der Nähe. Planen Sie für die Anfahrt etwas Puffer ein.',
  },
];

// Objections in the order people raise them: content and price, fit, sensation, downtime,
// after-care, results, sessions, when to postpone.
const faqs = [
  {
    q: 'Was ist im Kombi-Angebot enthalten?',
    a: `Für CHF ${PROMO_PRICE}.– statt CHF ${REGULAR_PRICE}.– erhalten Sie eine Behandlung von ${DURATION_LABEL} mit Hautanalyse, Aquafacial, Microneedling, beruhigender Abschlusspflege und After-Care-Hinweisen.`,
  },
  {
    q: 'Muss ich schon wissen, ob Aquafacial oder Microneedling besser für mich ist?',
    a: 'Nein. Genau dafür ist die persönliche Einschätzung da. Vor Ort wird angeschaut, was Ihre Haut aktuell braucht, ob die Kombination zu Ihrem Hautzustand passt und wie intensiv die Behandlung sinnvoll ist.',
  },
  {
    q: 'Ist Microneedling schmerzhaft?',
    a: 'Viele empfinden es als leichtes Piksen, Druckgefühl oder Wärme. Die Intensität wird kontrolliert und individuell angepasst.',
  },
  {
    q: 'Gibt es Ausfallzeit?',
    a: 'Nach Aquafacial ist die Haut oft schnell wieder alltagstauglich. Durch Microneedling können Rötungen oder Empfindlichkeit entstehen. Je nach Hauttyp beruhigt sich die Haut meist schrittweise innerhalb von Stunden bis 24–48 Stunden.',
  },
  {
    q: 'Was sollte ich nach der Behandlung beachten?',
    a: 'Für 24–48 Stunden sind sanfte Pflege, konsequenter Sonnenschutz und der Verzicht auf Sauna, intensive Sonne, Peelings, Retinol und schweisstreibenden Sport empfehlenswert. Make-up vermeiden Sie in den ersten Stunden am besten. Teresa gibt Ihnen konkrete Hinweise mit.',
  },
  {
    q: 'Wann sehe ich Ergebnisse?',
    a: 'Viele Kundinnen und Kunden empfinden die Haut nach der Behandlung als frischer und gepflegter. Die optische Veränderung hängt vom Hautzustand, der Reaktion der Haut und der Nachpflege ab.',
  },
  {
    q: 'Wie viele Sitzungen sind sinnvoll?',
    a: 'Für einen Frische- und Glow-Effekt kann eine einzelne Sitzung interessant sein. Bei Strukturthemen kann eine Behandlungsserie sinnvoll sein. Das wird vor Ort realistisch eingeordnet.',
  },
  {
    q: 'Wann sollte ich den Termin verschieben?',
    a: 'Bei stark gereizter Haut, frischem Sonnenbrand, akuten Entzündungen oder Unsicherheit zu Hautreaktionen sollte die Behandlung vorher besprochen oder verschoben werden.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      '@id': absoluteUrl('/lp/aquafacial-microneedling/#product'),
      name: 'Aquafacial + Microneedling Zürich',
      description: `90 Minuten Aquafacial + Microneedling in Zürich mit Hautanalyse, Abschlusspflege und After-Care-Hinweisen. Kombi-Angebot CHF ${PROMO_PRICE}.– statt CHF ${REGULAR_PRICE}.–.`,
      image: absoluteUrl(heroAquafacialMicroneedlingUrl),
      brand: { '@type': 'Brand', name: 'Beauty Face Lift' },
      offers: {
        '@type': 'Offer',
        priceCurrency: 'CHF',
        price: PROMO_PRICE.toFixed(2),
        availability: 'https://schema.org/InStock',
        url: absoluteUrl('/lp/aquafacial-microneedling/'),
        priceValidUntil: '2026-12-31',
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<LandingPage
  title={`Aquafacial + Microneedling Zürich | CHF ${PROMO_PRICE} statt CHF ${REGULAR_PRICE}`}
  description="90 Min. Aquafacial + Microneedling in Zürich: Hautanalyse, Glow, Feuchtigkeit und optisch feinere Hautstruktur. Persönlich bei Beauty Face Lift an der Bahnhofstrasse."
  ogImage={heroAquafacialMicroneedlingUrl}
  preloadImage={{
    href: lpHeroPreload.src,
    imagesrcset: lpHeroPreload.srcSet.attribute,
    imagesizes: lpHeroSizes,
    type: 'image/webp',
    fetchpriority: 'high',
  }}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main class="lp-page">
    <!-- 1 · Hero: copy left, treatment photo in the arch right (phones: full-bleed band on top) -->
    <section class="lp-hero" aria-labelledby="lp-hero-title">
      <div class="container lp-hero-grid">
        <div class="lp-hero-content">
          <p class="eyebrow eyebrow--rule lp-eyebrow">Aktion: Aquafacial + Microneedling in Zürich</p>
          <h1 id="lp-hero-title" class="lp-title">Ganzheitliche Kombi-Behandlung für sichtbar strahlende, straffere und regenerierte Haut.</h1>
          <p class="lp-subtitle">
            Gründliche Aquafacial Pflege, intensive Feuchtigkeit und kontrolliertes Microneedling
            in einem Termin – ideal, wenn Ihre Haut müde, fahl oder unruhig wirkt.
          </p>

          <p class="lp-hero-offer">
            <span class="lp-hero-offer-label">Kombi-Angebot · {DURATION_LABEL}</span>
            <span class="lp-hero-offer-price">CHF {PROMO_PRICE}.–</span>
            <span class="lp-hero-offer-old"><span aria-hidden="true">· </span>statt CHF {REGULAR_PRICE}.–</span>
          </p>

          <ul class="lp-hero-bullets lp-checks">
            {heroBullets.map((item) => (
              <li>{item}</li>
            ))}
          </ul>

          <div class="lp-hero-ctas">
            <a href={bookingHref} class="btn lp-hero-primary" data-treatment="Aquafacial + Microneedling" data-button-location="lp_hero_booking">{PRIMARY_CTA_LABEL}</a>
            <WhatsAppButton variant="link" message={whatsappMessage} source="aquafacial_hero" label={SECONDARY_CTA_LABEL} />
          </div>

          <p class="lp-hero-proof"><span class="lp-stars" aria-hidden="true">★★★★★</span><span><strong>4,8</strong> aus 248+ Bewertungen</span></p>
        </div>

        <figure class="lp-hero-media" aria-label={OFFER_LABEL}>
          <Image
            src={heroAquafacialMicroneedlingImage}
            widths={lpHeroWidths}
            sizes={lpHeroSizes}
            format="webp"
            quality={lpHeroQuality}
            loading="eager"
            decoding="async"
            fetchpriority="high"
            alt="Aquafacial und Microneedling Behandlung bei Beauty Face Lift Zürich"
          />
        </figure>
      </div>
    </section>

    <!-- 2 · Offer: what is included, the price card and the booking CTA -->
    <section class="lp-section lp-section--rule lp-offer" aria-labelledby="lp-offer-title">
      <div class="container lp-offer-grid">
        <div class="lp-offer-copy">
          <h2 class="lp-section-title" id="lp-offer-title">Das ist im Kombi-Angebot enthalten</h2>
          <p class="lp-section-lead">
            {DURATION_LABEL} professionelle Pflege, Schritt für Schritt auf Ihre Haut abgestimmt –
            persönlich durchgeführt von Teresa Stimac.
          </p>
          <ul class="lp-checks lp-included-list">
            {includedItems.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
        <div class="lp-offer-card">
          <OfferBox
            variant="box"
            oldPrice={REGULAR_PRICE}
            newPrice={PROMO_PRICE}
            discountLabel={OFFER_LABEL}
            urgency={`${DURATION_LABEL} · Hautanalyse inklusive`}
            ctaText={BOOKING_CTA_LABEL}
            ctaHref={bookingHref}
          />
          <TrustStrip variant="promises"
            align="left"
            promises={[
              { text: 'Persönliche Hautanalyse' },
              { text: 'Transparenter Aktionspreis' },
              { text: 'Zentrale Lage in Zürich' },
              { text: 'Realistische Beratung' },
            ]}
          />
        </div>
      </div>
    </section>

    <!-- 3 · Desire -->
    <section class="lp-section section--sand lp-desire" id="details" aria-labelledby="lp-desire-title">
      <div class="container">
        <div class="lp-head">
          <h2 class="lp-section-title" id="lp-desire-title">Wenn Ihre Haut mehr braucht als Pflege zu Hause</h2>
          <p class="lp-section-lead">
            Trotz guter Routine wirkt die Haut müde, trocken oder unruhig? Genau hier setzt die
            Kombination aus Aquafacial und Microneedling an.
          </p>
        </div>
        <ul class="lp-grid lp-grid--4">
          {desireItems.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 4 · Why the combination works: the three steps of the appointment -->
    <section class="lp-section lp-phases" aria-labelledby="lp-phases-title">
      <div class="container">
        <div class="lp-head">
          <h2 class="lp-section-title" id="lp-phases-title">Warum Aquafacial und Microneedling zusammen sinnvoll sein können</h2>
          <p class="lp-section-lead">
            Aquafacial pflegt und bereitet vor, Microneedling verfeinert gezielt – drei Schritte in
            einem ruhigen Termin.
          </p>
        </div>
        <ol class="lp-phases-list">
          {phases.map((phase) => (
            <li class="lp-phase">
              <div class="media lp-phase-media">
                <Image
                  src={phase.image}
                  widths={[360, 540, 720, 960, 1122]}
                  sizes={lpThirdSizes}
                  format="webp"
                  quality={82}
                  alt={phase.alt}
                  loading="lazy"
                  class={phase.crop}
                />
              </div>
              <div class="lp-phase-copy">
                <h3>{phase.title}</h3>
                <p>{phase.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 5 · Two-step focus with the infographic -->
    <section class="lp-section section--ivory lp-treatment-focus" aria-labelledby="lp-focus-title">
      <div class="container">
        <div class="lp-head">
          <h2 class="lp-section-title" id="lp-focus-title">Zwei Behandlungsschritte, ein klares Hautziel</h2>
          <p class="lp-section-lead">
            Aquafacial pflegt, Microneedling verfeinert. Wie intensiv die Behandlung sein soll,
            wird vor Ort nach der Hautanalyse festgelegt.
          </p>
        </div>
        <div class="lp-focus-grid">
          <figure class="media lp-combination-infographic">
            <Image
              src={aquafacialMicroneedlingInfographicImage}
              widths={[360, 540, 720, 960, 1122]}
              sizes={lpInfographicSizes}
              format="webp"
              quality={82}
              alt="Infografik zur Wirkung von Aquafacial und Microneedling"
              loading="lazy"
            />
          </figure>
          {treatmentFocus.map((item) => (
            <article class="lp-focus-item">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              <ul class="lp-checks">
                {item.items.map((focusItem) => (
                  <li>{focusItem}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 6 · Trust -->
    <section class="lp-section section--sand lp-trust" aria-labelledby="lp-trust-title">
      <div class="container lp-trust-grid">
        <figure class="media lp-trust-media">
          <Image
            src={hautanalyseBeratungImage}
            widths={[360, 540, 720, 960, 1200, 1448]}
            sizes={lpHalfSizes}
            format="webp"
            quality={82}
            alt="Persönliche Hautanalyse und Beratung in Zürich"
            loading="lazy"
          />
        </figure>
        <div class="lp-trust-content">
          <h2 id="lp-trust-title" class="lp-section-title">Persönliche Behandlung statt Standardprogramm</h2>
          <figure class="lp-quote">
            <blockquote>„Ich nehme mir Zeit, erkläre jeden Schritt und stimme die Behandlung auf die Haut ab.“</blockquote>
            <figcaption>Teresa Stimac</figcaption>
          </figure>
          <p>
            Teresa Stimac führt die Kombi-Behandlung an der Bahnhofstrasse&nbsp;94 persönlich durch – mit
            ruhiger Beratung, klarer After-Care und realistischen Erwartungen.
          </p>
          <ul class="lp-proof-grid" aria-label="Vertrauenssignale">
            {trustProof.map((item) => (
              <li class="lp-proof-item">
                <strong>{item.value}</strong>
                <span>{item.label}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- 7 · Expectation -->
    <section class="lp-section lp-expectation" aria-labelledby="lp-expectation-title">
      <div class="container lp-expectation-grid">
        <div class="lp-expectation-copy">
          <h2 id="lp-expectation-title" class="lp-section-title">Realistische Ergebnisse statt übertriebener Versprechen</h2>
          <p class="lp-section-lead">
            Die Haut kann frischer, glatter und gepflegter wirken. Weil jede Haut anders reagiert,
            wird das Ergebnis vor Ort ehrlich eingeordnet.
          </p>
          <ul class="lp-rows">
            {expectationItems.map((item) => (
              <li>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </li>
            ))}
          </ul>
        </div>
        <figure class="media lp-expectation-visual">
          <Image
            src={postTreatmentGlowImage}
            widths={[480, 720, 960, 1200, 1448]}
            sizes={lpHalfSizes}
            format="webp"
            quality={82}
            alt="Frisch gepflegte Haut nach kosmetischer Gesichtsbehandlung"
            loading="lazy"
          />
        </figure>
      </div>
    </section>

    <!-- 8 · Process -->
    <section class="lp-section section--sand lp-process" aria-labelledby="lp-process-title">
      <div class="container">
        <div class="lp-head">
          <h2 id="lp-process-title" class="lp-section-title">So läuft Ihr Termin in Zürich ab</h2>
          <p class="lp-section-lead">
            Direkt online buchen, wenn der Termin passt – oder zuerst per WhatsApp oder Formular
            nachfragen.
          </p>
        </div>
        <ol class="steps lp-steps">
          {processSteps.map((step) => (
            <li>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>
        <div class="btn-row lp-section-cta">
