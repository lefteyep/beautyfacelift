  .lp-section-lead {
    margin: 0;
    max-width: 48ch;
    color: var(--umber);
    font-size: var(--fs-lead);
    line-height: 1.6;
  }

  .lp-section-cta {
    margin-top: clamp(32px, 4vw, 48px);
  }

  /* ═══ Shared patterns ════════════════════════════════════════ */

  /* Tick list: the site marker, a shell disc (::after) carrying a hairline copper tick (::before). */
  .lp-checks {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lp-checks > li {
    position: relative;
    padding: var(--lp-check-pad, 13px) 0 var(--lp-check-pad, 13px) 32px;
    border-bottom: 1px solid var(--rule);
    color: var(--espresso);
    line-height: 1.5;
  }

  .lp-checks > li::before {
    content: '';
    position: absolute;
    z-index: 1;
    left: 5px;
    top: calc(var(--lp-check-pad, 13px) + 0.75em - 3.5px);
    width: 8px;
    height: 4px;
    border-left: 1px solid var(--bronze);
    border-bottom: 1px solid var(--bronze);
    transform: rotate(-45deg);
  }

  .lp-checks > li::after {
    content: '';
    position: absolute;
    left: 0;
    top: calc(var(--lp-check-pad, 13px) + 0.75em - 9px);
    width: 18px;
    height: 18px;
    border-radius: var(--r-pill);
    background: var(--shell);
  }

  /* Ruled column grid */
  .lp-grid {
    display: grid;
    column-gap: clamp(24px, 3.5vw, 56px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

