---

import LandingPage from '../../../layouts/LandingPage.astro';
import BookingCta from '../../../components/BookingCta.astro';
import { bookingLinkForService } from '../../../../shared/site';

const bookingHref = bookingLinkForService('Peeling');
---

<LandingPage
    title="Fruchtsäure Peeling Zürich — Jetzt Termin buchen"
    description="Fruchtsäure Peeling an der Bahnhofstrasse Zürich. Intensive Hauterneuerung für einen klaren Teint."
>
    <section class="container lp-hero">
        <div class="sub-display margin-bottom-md">Premium Kosmetikinstitut • Zürich</div>
        <h1 class="lp-title">Fruchtsäure<br><em>Peeling</em></h1>
        <p class="lp-subtitle">Intensive Hauterneuerung für einen ebenmässigen, strahlenden Teint. AHA-Behandlung an der Bahnhofstrasse.</p>
    </section>

    <section class="container lp-benefits">
        <div class="highlights-grid">
            <div class="highlight-item">
                <div class="highlight-number">01</div>
                <h4>Tiefenwirkung</h4>
                <p>AHA-Säuren lösen abgestorbene Zellen für echte Erneuerung.</p>
            </div>
            <div class="highlight-item">
                <div class="highlight-number">02</div>
                <h4>Anti-Akne</h4>
                <p>Kann Unreinheiten reduzieren und Poren längerfristig feiner wirken lassen.</p>
            </div>
            <div class="highlight-item">
                <div class="highlight-number">03</div>
                <h4>Klarer Teint</h4>
                <p>Fahler Teint kann klarer und lebendiger wirken.</p>
            </div>
        </div>
    </section>

    <section id="buchen" class="container" style="padding-bottom: 10vh;">
        <BookingCta treatment="Fruchtsäure Peeling" href={bookingHref} />
    </section>
</LandingPage>

<style>
    .lp-hero { padding-top: 16vh; padding-bottom: 6vh; text-align: center; }
    .lp-title { font-size: clamp(3rem, 8vw, 6rem); margin-bottom: 1.5rem; text-transform: uppercase; }
    .lp-title em { font-style: normal; font-weight: 300; color: var(--gold); }
    .lp-subtitle { font-size: 1.15rem; max-width: 550px; margin: 0 auto; }
    .lp-benefits { padding-bottom: 6vh; }
</style>
