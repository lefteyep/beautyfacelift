---
import LandingPage from '../../../layouts/LandingPage.astro';
import BookingCta from '../../../components/BookingCta.astro';
import OfferBox from '../../../components/lp/OfferBox.astro';
import FAQAccordion from '../../../components/lp/FAQAccordion.astro';
import BenefitIcon from '../../../components/lp/BenefitIcon.astro';
import TrustStrip from '../../../components/lp/TrustStrip.astro';
import WhatsAppButton from '../../../components/lp/WhatsAppButton.astro';
import { Image } from 'astro:assets';
import heroHydrofacialMicroneedlingImage from '../../../assets/lp/hydrofacial/hero-hydrofacial-microneedling-zuerich.webp';
import heroHydrofacialMicroneedlingUrl from '../../../assets/lp/hydrofacial/hero-hydrofacial-microneedling-zuerich.webp?url';
import hydrofacialCloseUpImage from '../../../assets/lp/hydrofacial/hydrofacial-close-up-zuerich.webp';
import hydrofacialMicroneedlingInfographicImage from '../../../assets/lp/hydrofacial/hydrofacial-microneedling-infografik-zuerich.webp';
import postTreatmentGlowImage from '../../../assets/lp/hydrofacial/post-treatment-glow-zuerich.webp';
import hautanalyseBeratungImage from '../../../assets/lp/hydrofacial/hautanalyse-beratung-zuerich.webp';
import abschlusspflegeAftercareImage from '../../../assets/lp/hydrofacial/abschlusspflege-aftercare-zuerich.webp';
import microneedlingCloseUpImage from '../../../assets/lp/hydrofacial/microneedling-close-up-zuerich.webp';
import personalTreatmentImage from '../../../assets/lp/hydrofacial/personal-treatment-zuerich.webp';
import { ADDRESS, CONTACT_PHONE, CONTACT_PHONE_DISPLAY, OPENING_HOURS, absoluteUrl, bookingLinkForService } from '../../../../shared/site';

const PROMO_PRICE = 170;
const REGULAR_PRICE = 250;
const DURATION_LABEL = '1 Std. 30 Min.';
const OFFER_LABEL = 'Hydrofacial + Microneedling Kombi-Angebot';
const OFFER_SLUG = 'hydrofacial-microneedling-aktion';
const PRIMARY_CTA_LABEL = 'Jetzt Termin buchen';
const LEAD_CTA_LABEL = 'Hautanalyse & Termin anfragen';
const SECONDARY_CTA_LABEL = 'Per WhatsApp anfragen';
const BOOKING_CTA_LABEL = 'Kombi-Behandlung buchen';
const FORM_CTA_LABEL = 'Terminwunsch senden';
const BOOKING_SERVICE = 'Hydrofacial + Microneedling';
const CONTACT_TOPIC = 'Ich möchte eine Behandlungsempfehlung';
const LEAD_FORM_ID = 'anfrage';
const LEAD_FORM_TARGET_ID = 'anfrage-form';
const bookingHref = `${bookingLinkForService(BOOKING_SERVICE)}&offer=${OFFER_SLUG}&price=${PROMO_PRICE}`;
const whatsappMessage = 'Hallo Teresa, ich interessiere mich für Hydrofacial + Microneedling in Zürich. Ist die Kombi-Behandlung für mein Hautziel geeignet?';
const lpHeroSizes = '(min-width: 1101px) 44vw, (min-width: 761px) 620px, 100vw';
const lpAboutSizes = '(min-width: 1101px) 44vw, (min-width: 601px) 520px, 100vw';
const lpCombinationSizes = '(min-width: 1101px) 42vw, 100vw';
const lpVisualSizes = '(min-width: 1101px) 30vw, (min-width: 761px) 48vw, 100vw';
const studioAddress = `${ADDRESS.street}, ${ADDRESS.postalCode} ${ADDRESS.city}`;
const googleMapsEmbedUrl = `https://www.google.com/maps?q=${encodeURIComponent(`Beauty Face Lift ${studioAddress}`)}&output=embed`;
const googleMapsDirectionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(studioAddress)}`;

const heroBullets = [
  'Für frischer, gepflegter und wacher wirkende Haut',
  'Für optisch feinere Poren und glattere Hautstruktur',
  'Persönlich abgestimmt auf Hautzustand und Empfindlichkeit',
  'Klare Pflegehinweise für die ersten 24-48 Stunden',
];

const includedItems = [
  'Hautanalyse und persönliche Abstimmung',
  'Gründliche Hydrofacial Pflege',
  'Intensive Feuchtigkeit für einen gepflegten Glow',
  'Kosmetisches Microneedling mit professionellem Pen',
  'Beruhigende Abschlusspflege',
  'After-Care-Hinweise für die ersten 24-48 Stunden',
];

const desireItems = [
  { title: 'Frischerer Glow', text: 'Wenn die Haut wieder gepflegter, wacher und besser versorgt wirken soll.' },
  { title: 'Glatter wirkendes Hautbild', text: 'Wenn Unebenheiten und unruhige Struktur optisch feiner erscheinen sollen.' },
  { title: 'Optisch feinere Poren', text: 'Wenn Poren sichtbarer wirken und Sie eine professionelle Einschätzung möchten.' },
  { title: 'Mehr Feuchtigkeit', text: 'Wenn sich die Haut trocken anfühlt oder Make-up nicht mehr gleichmässig liegt.' },
  { title: 'Ruhige Durchführung', text: 'Wenn Sie eine Behandlung wünschen, die individuell und ohne Druck durchgeführt wird.' },
];

const benefits = [
  { icon: 'droplet' as const, title: 'Frischerer Teint', text: 'Die Haut kann nach der Behandlung gepflegter, wacher und besser mit Feuchtigkeit versorgt wirken.' },
  { icon: 'activity' as const, title: 'Glatter wirkende Struktur', text: 'Microneedling kann die natürliche Hauterneuerung kosmetisch unterstützen und die Haut optisch verfeinern.' },
  { icon: 'leaf' as const, title: 'Glow ohne schwere Pflege', text: 'Hydrofacial verbindet Reinigung und Feuchtigkeit in einem professionellen Behandlungsschritt.' },
  { icon: 'target' as const, title: 'Persönliche Anpassung', text: 'Die Behandlung wird auf Hautzustand, Empfindlichkeit und Ziel abgestimmt - nicht nach starrem Standardprogramm.' },
];

const phases = [
  { title: 'Hydrofacial bereitet vor', text: 'Die Haut wird sanft gereinigt, mit Feuchtigkeit versorgt und gepflegt. Das schafft eine frische, ruhige Basis vor dem zweiten Schritt.' },
  { title: 'Microneedling setzt Mikroimpulse', text: 'Der professionelle Pen arbeitet kontrolliert und individuell dosiert. Das kann die natürliche Hauterneuerung kosmetisch unterstützen.' },
  { title: 'Abschlusspflege beruhigt', text: 'Zum Schluss erhält die Haut eine abgestimmte Pflege. Sie bekommen klare Hinweise für die nächsten 24-48 Stunden.' },
];

const combinationReasons = [
  { title: 'Reinigung und Feuchtigkeit', text: 'Hydrofacial pflegt die Hautoberfläche und sorgt für eine hydratisierte, angenehm vorbereitete Basis.' },
  { title: 'Kontrollierte Mikroimpulse', text: 'Microneedling ergänzt die Pflege gezielt, wenn Struktur, Poren oder ein fahler Teint kosmetisch verfeinert werden sollen.' },
  { title: 'Eine ruhige 90-Minuten-Sitzung', text: 'Analyse, Pflege, Needling, Abschlusspflege und After-Care sind in einem klaren Termin gebündelt.' },
];

const visualStoryItems = [
  {
    image: hydrofacialCloseUpImage,
    alt: 'Hydrofacial Behandlung zur Reinigung und Feuchtigkeitspflege',
    title: 'Hydrofacial Pflege',
    text: 'Reinigung und Feuchtigkeit bereiten die Haut ruhig auf die weiteren Schritte vor.',
  },
  {
    image: microneedlingCloseUpImage,
    alt: 'Kosmetisches Microneedling mit professionellem Pen',
    title: 'Kontrollierte Mikroimpulse',
    text: 'Microneedling wird individuell dosiert und passend zum Hautzustand eingesetzt.',
  },
  {
    image: abschlusspflegeAftercareImage,
    alt: 'Beruhigende Abschlusspflege nach der Behandlung',
    title: 'Beruhigende Abschlusspflege',
    text: 'Zum Abschluss wird die Haut gepflegt und Sie erhalten klare After-Care-Hinweise.',
  },
];

const treatmentFocus = [
  {
    title: 'Hydrofacial: reinigen, hydratisieren, Glow aufbauen',
    text: 'Hydrofacial ist der pflegende Teil der Kombi-Behandlung. Die Haut wird gründlich gereinigt, mit Feuchtigkeit versorgt und auf die anschliessenden Schritte vorbereitet.',
    items: ['Müde oder fahl wirkende Haut', 'Trockene oder feuchtigkeitsarme Haut', 'Wunsch nach mehr Glow', 'Gepflegteres Hautgefühl', 'Sanfte Vorbereitung vor dem Microneedling'],
  },
  {
    title: 'Microneedling: gezielte Mikroimpulse für feinere Hautstruktur',
    text: 'Microneedling ergänzt die Hydrofacial Pflege mit kontrollierten Mikroimpulsen. Die Intensität wird individuell angepasst - besonders bei empfindlicher Haut oder der ersten Needling-Erfahrung.',
    items: ['Unruhige Hautstruktur', 'Optisch vergrössert wirkende Poren', 'Unebenheiten', 'Erste Linien und müde wirkendes Hautbild', 'Gezielte kosmetische Hautverfeinerung'],
  },
];

const proofItems = [
  { value: '4.8/5', label: 'Bewertungsschnitt aus 248+ Bewertungen' },
  { value: '20+ Jahre', label: 'Kosmetische Erfahrung' },
  { value: '8001 Zürich', label: 'Bahnhofstrasse 94, zentral erreichbar' },
];

const trustItems = [
  'Persönliche Durchführung durch Teresa Stimac',
  'Zentrale Lage an der Bahnhofstrasse 94',
  'Ruhige Beratung und klare After-Care',
  'Realistische Erwartungen statt übertriebener Ergebnisversprechen',
];

const expectationItems = [
  { title: 'Direkt danach', text: 'Die Haut kann frischer, gepflegter und gut versorgt wirken. Nach dem Microneedling sind Rötungen möglich.' },
  { title: '24-48 Stunden', text: 'Die Haut beruhigt sich je nach Hauttyp schrittweise. Sanfte Pflege und konsequenter Sonnenschutz sind in dieser Zeit besonders wichtig.' },
  { title: 'Weitere Sitzungen', text: 'Für Glow kann eine einzelne Sitzung interessant sein. Bei Strukturthemen kann vor Ort eine Serie sinnvoll eingeordnet werden.' },
];

const processSteps = [
  { title: 'Termin anfragen oder buchen', text: 'Sie senden Ihren Terminwunsch oder wählen direkt einen freien Termin für die Kombi-Behandlung.' },
  { title: 'Hautanalyse vor Ort', text: 'Vor der Behandlung werden Hautzustand, Empfindlichkeit, Ziel und mögliche Reaktionen kurz eingeschätzt.' },
  { title: 'Hydrofacial + Microneedling', text: 'Die Haut wird gereinigt, hydratisiert und danach mit kontrollierten Mikroimpulsen behandelt.' },
  { title: 'Abschlusspflege und After-Care', text: 'Zum Schluss wird die Haut beruhigt. Sie erhalten klare Hinweise zu Make-up, Sonne, Sport, Sauna und Pflegeprodukten.' },
];

const locationItems = [
  {
    number: '01',
    title: 'Adresse',
    text: `${ADDRESS.street}\n${ADDRESS.postalCode} ${ADDRESS.city}`,
  },
  {
    number: '02',
    title: 'Mit dem ÖV',
    text: 'Das Studio liegt zentral an der Bahnhofstrasse. Paradeplatz und Börsenstrasse sind in wenigen Minuten zu Fuss erreichbar; vom Zürich HB fahren Tramverbindungen direkt in die Innenstadt.',
  },
  {
    number: '03',
    title: 'Mit dem Auto',
    text: 'Innenstadt-Parkhäuser rund um Paradeplatz, Bleicherweg und Urania liegen in der Nähe. Planen Sie für die Anfahrt ins Zentrum etwas Puffer ein.',
  },
];

const faqs = [
  {
    q: 'Muss ich schon wissen, ob Hydrofacial oder Microneedling besser für mich ist?',
    a: 'Nein. Genau dafür ist die persönliche Einschätzung da. Vor Ort wird angeschaut, was Ihre Haut aktuell braucht und wie intensiv die Behandlung sinnvoll ist.',
  },
  {
    q: 'Für wen ist Hydrofacial + Microneedling geeignet?',
    a: 'Die Kombination kann für viele Kundinnen und Kunden interessant sein, die sich mehr Glow, Feuchtigkeit und ein optisch feineres Hautbild wünschen. Ob sie zu Ihrem Hautzustand passt, wird vor der Behandlung geprüft.',
  },
  {
    q: 'Wie lange dauert die Behandlung?',
    a: 'Die Kombi-Behandlung dauert ca. 90 Minuten. Enthalten sind Hautanalyse, Hydrofacial, Microneedling, Abschlusspflege und After-Care-Hinweise.',
  },
  {
    q: 'Was kostet die Behandlung?',
    a: `Das aktuelle Kombi-Angebot beträgt CHF ${PROMO_PRICE}.– statt CHF ${REGULAR_PRICE}.– für 90 Minuten.`,
  },
  {
    q: 'Gibt es Ausfallzeit?',
    a: 'Nach Hydrofacial ist die Haut oft schnell wieder alltagstauglich. Durch Microneedling können Rötungen oder Empfindlichkeit entstehen. Je nach Hauttyp beruhigt sich die Haut meist schrittweise innerhalb von Stunden bis 24-48 Stunden.',
  },
  {
    q: 'Ist Microneedling schmerzhaft?',
    a: 'Viele empfinden es als leichtes Piksen, Druckgefühl oder Wärme. Die Intensität wird kontrolliert und individuell angepasst.',
  },
  {
    q: 'Wann sehe ich Ergebnisse?',
    a: 'Viele Kundinnen und Kunden empfinden die Haut nach der Behandlung als frischer und gepflegter. Die optische Veränderung hängt vom Hautzustand, der Reaktion der Haut und der Nachpflege ab.',
  },
  {
    q: 'Wie viele Sitzungen sind sinnvoll?',
    a: 'Für einen Frische- und Glow-Effekt kann eine einzelne Sitzung interessant sein. Bei Strukturthemen kann eine Behandlungsserie sinnvoll sein. Das wird vor Ort realistisch eingeordnet.',
  },
  {
    q: 'Was sollte ich nach der Behandlung beachten?',
    a: 'Für 24-48 Stunden sind sanfte Pflege, konsequenter Sonnenschutz und der Verzicht auf Sauna, intensive Sonne, Peelings, Retinol und schweisstreibenden Sport empfehlenswert. Teresa gibt Ihnen konkrete Hinweise mit.',
  },
  {
    q: 'Kann ich danach Make-up tragen?',
    a: 'Nach Microneedling ist es meist sinnvoll, die Haut zunächst in Ruhe zu lassen und Make-up für die ersten Stunden zu vermeiden. Teresa gibt Ihnen passend zu Ihrer Haut konkrete Hinweise.',
  },
  {
    q: 'Wann sollte ich den Termin verschieben?',
    a: 'Bei stark gereizter Haut, frischem Sonnenbrand, akuten Entzündungen oder Unsicherheit zu Hautreaktionen sollte die Behandlung vorher besprochen oder verschoben werden.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      '@id': absoluteUrl('/lp/hydrofacial-microneedling/#product'),
      name: 'Hydrofacial + Microneedling Zürich',
      description: `90 Minuten Hydrofacial + Microneedling in Zürich mit Hautanalyse, Abschlusspflege und After-Care-Hinweisen. Kombi-Angebot CHF ${PROMO_PRICE}.– statt CHF ${REGULAR_PRICE}.–.`,
      image: absoluteUrl(heroHydrofacialMicroneedlingUrl),
      brand: { '@type': 'Brand', name: 'Beauty Face Lift' },
      offers: {
        '@type': 'Offer',
        priceCurrency: 'CHF',
        price: PROMO_PRICE.toFixed(2),
        availability: 'https://schema.org/InStock',
        url: absoluteUrl('/lp/hydrofacial-microneedling/'),
        priceValidUntil: '2026-12-31',
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<LandingPage
  title={`Hydrofacial + Microneedling Zürich | CHF ${PROMO_PRICE} statt CHF ${REGULAR_PRICE}`}
  description="90 Min. Hydrofacial + Microneedling in Zürich: Hautanalyse, Glow, Feuchtigkeit und optisch feinere Hautstruktur. Persönlich bei Beauty Face Lift an der Bahnhofstrasse."
  ogImage={heroHydrofacialMicroneedlingUrl}
  preloadImage={{
    href: heroHydrofacialMicroneedlingUrl,
    type: 'image/webp',
    fetchpriority: 'high',
  }}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main class="lp-page">
    <section class="container lp-hero">
      <div class="lp-hero-grid">
        <div class="lp-hero-content">
          <div class="lp-eyebrow">Aktion: Hydrofacial + Microneedling in Zürich</div>
          <h1 class="lp-title display-text">Ganzheitliche Kombi-Behandlung für sichtbar strahlende, straffere und regenerierte Haut.</h1>
          <p class="lp-subtitle">
            Die Kombi-Behandlung verbindet gründliche Hydrofacial Pflege, intensive Feuchtigkeit
            und kontrolliertes Microneedling. Ideal, wenn Ihre Haut müde, fahl oder unruhig wirkt –
            und Sie sich eine ehrliche Einschätzung vor der Behandlung wünschen.
          </p>

          <div class="lp-hero-offer-card" aria-label="Kombi-Angebot">
            <span>Kombi-Angebot</span>
            <strong>CHF {PROMO_PRICE}.–</strong>
            <s>statt CHF {REGULAR_PRICE}.–</s>
            <em>{DURATION_LABEL} inklusive Hautanalyse, Hydrofacial, Microneedling, beruhigender Abschlusspflege und After-Care-Hinweisen.</em>
          </div>

          <div class="lp-hero-ctas">
            <a href={bookingHref} class="pill-btn lp-hero-primary" data-treatment="Hydrofacial + Microneedling" data-button-location="lp_hero_booking">{PRIMARY_CTA_LABEL}</a>
            <WhatsAppButton variant="inline" message={whatsappMessage} source="hydrofacial_hero" label={SECONDARY_CTA_LABEL} />
          </div>

          <div class="lp-hero-trust" aria-label="Vertrauenssignale">
            <span class="lp-stars" aria-hidden="true">★★★★★</span>
            <strong>4.8/5</strong>
            <span>248+ Bewertungen</span>
            <span>20+ Jahre Erfahrung</span>
            <span>{ADDRESS.street}, {ADDRESS.postalCode} {ADDRESS.city}</span>
          </div>

          <ul class="lp-hero-bullets">
            {heroBullets.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>

        <div class="lp-hero-media" aria-label={OFFER_LABEL}>
          <div class="lp-hero-image-stack">
            <div class="lp-hero-image-card lp-hero-image-card-main">
              <Image
                src={heroHydrofacialMicroneedlingImage}
                widths={[480, 720, 960, 1200, 1440, 1672]}
                sizes={lpHeroSizes}
                format="webp"
                quality={86}
                loading="eager"
                decoding="async"
                fetchpriority="high"
                alt="Hydrofacial und Microneedling Behandlung bei Beauty Face Lift Zürich"
              />
            </div>
            <div class="lp-hero-image-card lp-hero-image-card-hydro">
              <Image
                src={hydrofacialCloseUpImage}
                widths={[240, 360, 480, 640]}
                sizes="(max-width: 760px) 42vw, 260px"
                format="webp"
                quality={84}
                loading="lazy"
                decoding="async"
                alt="Hydrofacial Behandlung zur Reinigung und Feuchtigkeitspflege"
              />
            </div>
            <div class="lp-hero-image-card lp-hero-image-card-needling">
              <Image
                src={microneedlingCloseUpImage}
                widths={[240, 360, 480, 640]}
                sizes="(max-width: 760px) 47vw, 300px"
                format="webp"
                quality={84}
                loading="lazy"
                decoding="async"
                alt="Kosmetisches Microneedling mit professionellem Pen"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="container lp-section lp-desire" id="details">
      <div class="lp-section-head">
        <div class="sub-display">Behandlungsziel</div>
        <h2 class="lp-section-title">Wenn Ihre Haut mehr braucht als Pflege zu Hause</h2>
        <p class="lp-section-lead">
          Manchmal wirkt die Haut trotz guter Routine müde, trocken oder unruhig. Make-up liegt
          nicht mehr so gleichmässig auf, Poren erscheinen sichtbarer und der Teint verliert an
          Frische. Genau hier setzt die Kombination aus Hydrofacial und Microneedling an.
        </p>
      </div>
      <div class="lp-desire-grid">
        {desireItems.map((item) => (
          <div class="lp-desire-item">
            <strong>{item.title}</strong>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="container lp-section lp-treatment-plan">
      <div class="lp-section-head">
        <div class="sub-display">Die Sitzung</div>
        <h2 class="lp-section-title">Warum Hydrofacial und Microneedling zusammen sinnvoll sein können</h2>
        <p class="lp-section-lead">
          Hydrofacial und Microneedling haben unterschiedliche Aufgaben. In der Kombination entsteht
          ein strukturierter Termin für Reinigung, Feuchtigkeit, Glow und optische Hautverfeinerung.
        </p>
      </div>
      <div class="lp-treatment-grid">
        <div class="lp-phases">
          {phases.map((phase, index) => (
            <div class="lp-phase">
              <div class="lp-phase-no">{String(index + 1).padStart(2, '0')}</div>
              <h3>{phase.title}</h3>
              <p>{phase.text}</p>
            </div>
          ))}
        </div>
        <div class="lp-included-panel">
          <h3>Enthalten im Aktionspreis</h3>
          <p>CHF {PROMO_PRICE}.– statt CHF {REGULAR_PRICE}.– für {DURATION_LABEL} Behandlung.</p>
          <ul class="lp-included-list">
            {includedItems.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="container lp-section lp-combination">
      <div class="lp-combination-grid">
        <div class="lp-combination-copy">
          <div class="sub-display margin-bottom-md">Warum diese Kombination?</div>
          <h2 class="lp-section-title">Reinigung, Feuchtigkeit und Mikroimpulse in einem Termin</h2>
          <p>
            Hydrofacial und Microneedling sprechen unterschiedliche Bedürfnisse an. Erst wird die
            Haut gepflegt vorbereitet, danach kann Microneedling die natürliche Hauterneuerung
            kosmetisch unterstützen.
          </p>
          <div class="lp-reason-list">
            {combinationReasons.map((item) => (
              <div class="lp-reason-item">
                <strong>{item.title}</strong>
                <p>{item.text}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="lp-combination-media lp-combination-infographic">
          <Image
            src={hydrofacialMicroneedlingInfographicImage}
            widths={[360, 540, 720, 960, 1122]}
            sizes={lpCombinationSizes}
            format="webp"
            quality={82}
            alt="Infografik zur Wirkung von Hydrofacial und Microneedling"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <section class="container lp-section lp-visual-story" aria-label="Behandlungsablauf">
      <div class="lp-section-head">
        <div class="sub-display">Behandlungsablauf</div>
        <h2 class="lp-section-title">Professionelle Pflege und Anti-Aging</h2>
        <p class="lp-section-lead">
          Freuen Sie sich auf eine ruhige Studio-Atmosphäre indem alle Behandlungsschritte auf Sie
          abgestimmt sind - von der Vorbereitung bis zur beruhigenden Abschlusspflege.
        </p>
      </div>
      <div class="lp-visual-grid">
        {visualStoryItems.map((item) => (
          <article class="lp-visual-card">
            <div class="lp-visual-card-media">
              <Image
                src={item.image}
                widths={[360, 540, 720, 960, 1122]}
                sizes={lpVisualSizes}
                format="webp"
                quality={82}
                alt={item.alt}
                loading="lazy"
              />
            </div>
            <div class="lp-visual-card-body">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="container lp-section lp-treatment-focus">
      <div class="lp-section-head">
        <div class="sub-display">Hydrofacial + Microneedling</div>
        <h2 class="lp-section-title">Zwei Behandlungsschritte, ein klares Hautziel</h2>
        <p class="lp-section-lead">
          Die Kombination ist besonders hilfreich, wenn Sie Pflege, Feuchtigkeit und kosmetische
          Strukturverfeinerung verbinden möchten - aber eine ehrliche Einschätzung wünschen, wie
          intensiv die Behandlung für Ihre Haut sein sollte.
        </p>
      </div>
      <div class="lp-focus-grid">
