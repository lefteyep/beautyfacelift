    --gold: #8e6a2e;
    --gold-deep: #765725;
    --gold-soft: #e8d9b5;
    --bg-primary: var(--paper);
    --bg-secondary: var(--bone);
    --bg-warm: var(--paper-2);
    --bg-dark: var(--ink);
    --text-primary: var(--ink);
    --text-secondary: var(--ink-2);
    --text-muted: var(--ink-3);
    --accent: var(--gold);
    --accent-text: var(--gold-deep);
    --border-subtle: #e8e4df;
    --border-medium: #e8e4df;
    --radius-card: 16px;
