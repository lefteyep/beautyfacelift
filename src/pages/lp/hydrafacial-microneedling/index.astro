---
import LandingPage from '../../../layouts/LandingPage.astro';
import BookingCta from '../../../components/BookingCta.astro';
import OfferBox from '../../../components/lp/OfferBox.astro';
import FAQAccordion from '../../../components/lp/FAQAccordion.astro';
import BenefitIcon from '../../../components/lp/BenefitIcon.astro';
import TrustStrip from '../../../components/lp/TrustStrip.astro';
import StickyOfferBar from '../../../components/lp/StickyOfferBar.astro';
import { Image, getImage } from 'astro:assets';
import { hydrafacialCard, microneedlingCard, teresaPortrait } from '../../../lib/site-images';
import { absoluteUrl, bookingLinkForService } from '../../../../shared/site';

const PROMO_PRICE = 170;
const REGULAR_PRICE = 250;
const DURATION_LABEL = '1 Std. 30 Min.';
const OFFER_LABEL = 'HydraFacial + Microneedling Aktion';
const OFFER_SLUG = 'hydrafacial-microneedling-aktion';
const CTA_LABEL = 'Jetzt Termin buchen';
const SAVINGS_LABEL = 'Sie sparen CHF 80.-';
const BOOKING_SERVICE = 'Hydrafacial + Microneedling';
const bookingHref = `${bookingLinkForService(BOOKING_SERVICE)}&offer=${OFFER_SLUG}&price=${PROMO_PRICE}`;
const lpHeroMainSizes = '(min-width: 1101px) 34vw, (min-width: 601px) 380px, 74vw';
const lpHeroOverlapSizes = '(min-width: 1101px) 24vw, (min-width: 601px) 260px, 52vw';
const lpAboutSizes = '(min-width: 1101px) 44vw, (min-width: 601px) 520px, 100vw';
const lpHeroPreload = await getImage({
  src: hydrafacialCard,
  widths: [480, 720, 960, 1200, 1536],
  sizes: lpHeroMainSizes,
  format: 'webp',
  quality: 'high',
});

const heroBullets = [
  `${DURATION_LABEL} inklusive Hautanalyse, HydraFacial, Microneedling und Abschluss-Pflege`,
  `Aktionspreis CHF ${PROMO_PRICE}.– statt CHF ${REGULAR_PRICE}.–`,
  'Persönlich behandelt von Teresa Stimac an der Bahnhofstrasse 94',
];

const includedItems = [
  'Kurze Hautanalyse und persönliche Abstimmung',
  'HydraFacial Reinigung & Feuchtigkeitspflege',
  'Sanfte Vorbereitung der Hautoberfläche',
  'Microneedling mit professionellem Pen',
  'Beruhigende Wirkstoff- und Abschluss-Pflege',
  'After-Care-Hinweise für die nächsten 24-48 Stunden',
];

const desireItems = [
  { title: 'Müder, fahler Teint', text: 'Wenn die Haut gepflegter, frischer und wacher wirken soll.' },
  { title: 'Unruhige Hautstruktur', text: 'Wenn Poren, Trockenheit oder Unebenheiten optisch feiner erscheinen sollen.' },
  { title: 'Wunsch nach Glow', text: 'Wenn Sie Reinigung, Feuchtigkeit und kosmetische Hautverfeinerung verbinden möchten.' },
];

const benefits = [
  { icon: 'droplet' as const, title: 'Frischer Glow', text: 'HydraFacial reinigt und hydratisiert die Haut für ein gepflegtes, wacher wirkendes Hautbild.' },
  { icon: 'activity' as const, title: 'Feiner wirkende Struktur', text: 'Microneedling kann die natürliche Hauterneuerung unterstützen und die Haut optisch glatter wirken lassen.' },
  { icon: 'leaf' as const, title: 'Persönlich abgestimmt', text: 'Intensität, Pflege und After-Care richten sich nach Hautzustand, Empfindlichkeit und Ziel.' },
  { icon: 'target' as const, title: 'Realistische Ergebnisse', text: 'Klare Einschätzung, ruhige Durchführung und keine übertriebenen Ergebnisversprechen.' },
];

const phases = [
  { title: 'Reinigen & hydratisieren', text: 'Die Haut wird sanft vorbereitet, gereinigt und mit Feuchtigkeitspflege versorgt. So entsteht eine gepflegte Basis für den zweiten Schritt.' },
  { title: 'Kontrolliert needlen', text: 'Der professionelle Pen setzt feine Mikroimpulse. Das kann die natürliche Regeneration unterstützen und die Hautstruktur optisch verfeinern.' },
  { title: 'Beruhigen & schützen', text: 'Eine abgestimmte Wirkstoff- und Abschluss-Pflege beruhigt die Haut. Danach erhalten Sie klare Hinweise für die nächsten 24-48 Stunden.' },
];

const combinationReasons = [
  { title: 'HydraFacial bereitet vor', text: 'Reinigung und Feuchtigkeitspflege helfen, die Hautoberfläche gepflegt und ruhig in die Behandlung zu führen.' },
  { title: 'Microneedling ergänzt gezielt', text: 'Die kontrollierten Mikroimpulse sind auf optische Strukturverfeinerung und Hauterneuerung ausgerichtet.' },
  { title: 'Pflege schliesst ab', text: 'Die Abschluss-Pflege beruhigt und unterstützt ein angenehmes Hautgefühl nach der Sitzung.' },
];

const proofItems = [
  { value: '20+ Jahre', label: 'Kosmetische Erfahrung' },
  { value: '4.8/5', label: 'Bewertungsschnitt aus 248+ Bewertungen' },
  { value: '8001 Zürich', label: 'Bahnhofstrasse 94, zentral erreichbar' },
];

const expectationItems = [
  { title: 'Direkt danach', text: 'Die Haut kann frisch und gut versorgt wirken. Leichte Rötungen nach dem Microneedling sind möglich.' },
  { title: '24-48 Stunden', text: 'Die Haut beruhigt sich meist schrittweise. Sanfte Pflege und konsequenter Sonnenschutz sind in dieser Zeit besonders wichtig.' },
  { title: 'Danach', text: 'Das Hautbild kann ruhiger, glatter und gepflegter erscheinen. Die Ausprägung hängt vom individuellen Hautzustand ab.' },
];

const processSteps = [
  { title: CTA_LABEL, text: 'Der Button führt zur Buchung. Service, Angebot und Preis sind bereits vorbereitet.' },
  { title: 'Ankommen in Zürich', text: 'Beauty Face Lift befindet sich zentral an der Bahnhofstrasse 94, gut erreichbar in der Innenstadt.' },
  { title: 'Persönliche Behandlung', text: 'Teresa führt HydraFacial, Microneedling und Abschluss-Pflege persönlich und kontrolliert durch.' },
  { title: 'After-Care beachten', text: 'Sie erhalten klare Hinweise zu Pflege, Make-up, Sport, Sonne und möglichen Rötungen.' },
];

const faqs = [
  {
    q: 'Für wen ist HydraFacial + Microneedling geeignet?',
    a: 'Die Behandlung kann für viele Hauttypen interessant sein, wenn das Ziel ein frischeres, gepflegteres und optisch verfeinertes Hautbild ist. Teresa prüft vor Ort, ob die Kombination zu Ihrem Hautzustand passt.',
  },
  {
    q: 'Wie lange dauert die Behandlung?',
    a: `Die Behandlung dauert ${DURATION_LABEL}. Darin enthalten sind eine kurze Hautanalyse, HydraFacial Reinigung, Microneedling, Abschluss-Pflege und persönliche After-Care-Hinweise.`,
  },
  {
    q: 'Was kostet die Aktion?',
    a: `Der Aktionspreis beträgt CHF ${PROMO_PRICE} statt CHF ${REGULAR_PRICE}. Die Buchung läuft über Treatwell; die Behandlungsangabe wird über unsere Buchungsseite vorbereitet.`,
  },
  {
    q: 'Warum werden HydraFacial und Microneedling kombiniert?',
    a: 'HydraFacial reinigt und hydratisiert zuerst. Microneedling setzt danach kontrollierte Mikroimpulse. Zusammen entsteht eine Behandlung, die Pflege, Glow und optische Strukturverfeinerung in einer Sitzung verbindet.',
  },
  {
    q: 'Gibt es Ausfallzeit?',
    a: 'Nach HydraFacial ist die Haut meist direkt alltagstauglich. Durch das Microneedling kann sie jedoch gerötet oder empfindlich sein. Das beruhigt sich je nach Hauttyp meist innerhalb von Stunden bis 24-48 Stunden.',
  },
  {
    q: 'Ist Microneedling schmerzhaft?',
    a: 'Viele Kundinnen beschreiben das Gefühl als leichtes Piksen oder Druckgefühl. Die Intensität wird kontrolliert und individuell angepasst.',
  },
  {
    q: 'Wie viele Sitzungen sind sinnvoll?',
    a: 'Das hängt von Hautzustand, Ziel und Reaktion der Haut ab. Für einen Frische-Effekt kann eine einzelne Sitzung interessant sein; bei Strukturthemen kann Teresa vor Ort eine sinnvolle Behandlungsserie einordnen.',
  },
  {
    q: 'Was sollte ich nach der Behandlung beachten?',
    a: 'Für 24-48 Stunden sind sanfte Pflege, konsequenter Sonnenschutz und der Verzicht auf Sauna, intensive Sonne, Peelings, Retinol und schweisstreibenden Sport empfehlenswert. Teresa gibt Ihnen konkrete Hinweise mit.',
  },
  {
    q: 'Wann sollte ich die Behandlung verschieben?',
    a: 'Bei akuten Entzündungen, stark gereizter Haut, frischem Sonnenbrand oder Unsicherheit zu Hautreaktionen sollte die Behandlung vorab besprochen oder verschoben werden. Vor Ort wird geprüft, was für Ihre Haut sinnvoll ist.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      '@id': absoluteUrl('/lp/hydrafacial-microneedling/#product'),
      name: 'Hydrafacial + Microneedling',
      description: `Aktionsangebot in Zürich: Hydrafacial + Microneedling, ${DURATION_LABEL}, CHF ${PROMO_PRICE} statt CHF ${REGULAR_PRICE}.`,
      image: absoluteUrl('/assets/hydrafacial_treatment.png'),
      brand: { '@type': 'Brand', name: 'Beauty Face Lift' },
      offers: {
        '@type': 'Offer',
        priceCurrency: 'CHF',
        price: PROMO_PRICE.toFixed(2),
        availability: 'https://schema.org/InStock',
        url: absoluteUrl('/lp/hydrafacial-microneedling/'),
        priceValidUntil: '2026-12-31',
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<LandingPage
  title={`Hydrafacial + Microneedling Zürich - CHF ${PROMO_PRICE} statt CHF ${REGULAR_PRICE} | Beauty Face Lift`}
  description={`Hydrafacial + Microneedling an der Bahnhofstrasse Zürich. ${DURATION_LABEL}, Aktionspreis CHF ${PROMO_PRICE} statt CHF ${REGULAR_PRICE}. Frischer Glow und verfeinert wirkendes Hautbild.`}
  ogImage="/assets/hydrafacial_treatment.png"
  preloadImage={{
    href: lpHeroPreload.src,
    imagesrcset: lpHeroPreload.srcSet.attribute,
    imagesizes: lpHeroMainSizes,
    type: 'image/webp',
    fetchpriority: 'high',
  }}
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main class="lp-page">
    <section class="container lp-hero">
      <div class="lp-hero-grid">
        <div class="lp-hero-content">
          <h1 class="lp-title display-text">HydraFacial + Microneedling in Zürich für frischere, glatter wirkende Haut</h1>
          <p class="lp-subtitle">
            Eine 90-minütige Kombi-Behandlung an der Bahnhofstrasse: gründliche HydraFacial Pflege,
            kontrolliertes Microneedling und beruhigende Abschluss-Pflege, persönlich abgestimmt von
            Teresa Stimac.
          </p>

          <div class="lp-hero-offer-card" aria-label="Aktionsangebot">
            <span>Aktionspreis</span>
            <strong>CHF {PROMO_PRICE}.–</strong>
            <s>statt CHF {REGULAR_PRICE}.–</s>
            <em>{DURATION_LABEL} · {SAVINGS_LABEL} · Buchung über Treatwell</em>
          </div>

          <div class="lp-hero-ctas">
            <a href={bookingHref} class="pill-btn lp-hero-primary" data-treatment="Hydrafacial + Microneedling" data-button-location="lp_hero">{CTA_LABEL}</a>
            <p class="lp-hero-note">CHF {PROMO_PRICE}.– statt CHF {REGULAR_PRICE}.– · Beauty Face Lift Zürich</p>
          </div>

          <div class="lp-hero-trust">
            <TrustStrip variant="rating" align="left" />
          </div>

          <ul class="lp-hero-bullets">
            {heroBullets.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>

        <div class="lp-hero-media" aria-label={OFFER_LABEL}>
          <div class="lp-hero-media-main">
            <Image
              src={hydrafacialCard}
              widths={[360, 540, 720, 960, 1122]}
              sizes={lpHeroMainSizes}
              format="webp"
              quality="high"
              priority
              alt="HydraFacial Behandlung im Beauty Face Lift Studio Zürich"
            />
          </div>
          <div class="lp-hero-media-overlap">
            <Image
              src={microneedlingCard}
              widths={[320, 480, 640, 800]}
              sizes={lpHeroOverlapSizes}
              format="webp"
              quality="high"
              loading="eager"
              alt="Microneedling Behandlung mit professionellem Pen bei Beauty Face Lift Zürich"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="container lp-section lp-desire" id="details">
      <div class="lp-section-head">
        <div class="sub-display">Behandlungsziel</div>
        <h2 class="lp-section-title">Wenn die Haut müde, unruhig oder fahl wirkt</h2>
        <p class="lp-section-lead">
          Die Behandlung richtet sich an Kundinnen und Kunden in Zürich, die sich einen frischeren,
          gepflegteren Teint wünschen und eine klare, persönliche Einschätzung möchten.
        </p>
      </div>
      <div class="lp-desire-grid">
        {desireItems.map((item) => (
          <div class="lp-desire-item">
            <strong>{item.title}</strong>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="container lp-section lp-treatment-plan">
      <div class="lp-section-head">
        <div class="sub-display">Die Sitzung</div>
        <h2 class="lp-section-title">Was passiert in 90 Minuten?</h2>
        <p class="lp-section-lead">
          Ein ruhiger Ablauf mit Hautanalyse, HydraFacial, Microneedling und klarer Nachpflege.
          Der Fokus liegt auf einem sichtbar gepflegten Hautbild ohne übertriebene Versprechen.
        </p>
      </div>
      <div class="lp-treatment-grid">
        <div class="lp-phases">
          {phases.map((phase, index) => (
            <div class="lp-phase">
              <div class="lp-phase-no">{String(index + 1).padStart(2, '0')}</div>
              <h3>{phase.title}</h3>
              <p>{phase.text}</p>
            </div>
          ))}
        </div>
        <div class="lp-included-panel">
          <h3>Enthalten im Aktionspreis</h3>
          <p>CHF {PROMO_PRICE}.– statt CHF {REGULAR_PRICE}.– für {DURATION_LABEL} Behandlung.</p>
          <ul class="lp-included-list">
            {includedItems.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="container lp-section lp-combination">
      <div class="lp-combination-grid">
        <div class="lp-combination-copy">
          <div class="sub-display margin-bottom-md">Warum diese Kombination?</div>
          <h2 class="lp-section-title">Reinigung, Feuchtigkeit und Mikroimpulse in einem Termin</h2>
          <p>
            HydraFacial und Microneedling sprechen unterschiedliche Bedürfnisse an. Erst wird die
            Haut gepflegt vorbereitet, danach kann Microneedling die natürliche Hauterneuerung
            kosmetisch unterstützen.
          </p>
          <div class="lp-reason-list">
            {combinationReasons.map((item) => (
              <div class="lp-reason-item">
                <strong>{item.title}</strong>
                <p>{item.text}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="lp-combination-media">
          <Image
            src={microneedlingCard}
            widths={[360, 540, 720, 960, 1122]}
            sizes={lpAboutSizes}
            format="webp"
            quality="high"
            alt="Kosmetische Microneedling Behandlung bei Beauty Face Lift Zürich"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <section class="container lp-section lp-benefits-section">
      <div class="lp-section-head">
        <div class="sub-display">Ihre Vorteile</div>
        <h2 class="lp-section-title">Was die Kombi-Behandlung leisten soll</h2>
        <p class="lp-section-lead">
          Vier klare Gründe für alle, die Glow, Pflege und optische Hautverfeinerung
          in einem strukturierten Termin verbinden möchten.
        </p>
      </div>
      <div class="lp-benefits-grid">
        {benefits.map((b) => (
          <div class="lp-benefit">
            <div class="lp-benefit-icon-wrap">
              <BenefitIcon name={b.icon} size={26} />
            </div>
            <strong>{b.title}</strong>
            <p>{b.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="container lp-section lp-trust">
      <div class="lp-trust-grid">
        <div class="lp-trust-media">
          <Image
            src={teresaPortrait}
            widths={[360, 540, 720, 960, 1023]}
            sizes={lpAboutSizes}
            format="webp"
            quality="high"
            alt="Teresa Stimac, Gründerin von Beauty Face Lift Zürich"
            loading="lazy"
          />
        </div>
        <div class="lp-trust-content">
          <div class="sub-display margin-bottom-md">Qualität & Vertrauen</div>
          <h2 class="lp-section-title">Vertrauen vor der Buchung</h2>
          <blockquote class="lp-about-quote">
            <p>„Ich nehme mir Zeit, erkläre jeden Schritt und stimme die Behandlung auf die Haut ab."</p>
          </blockquote>
          <p>
            Beauty Face Lift ist ein Premium Kosmetikinstitut an der Bahnhofstrasse 94 in Zürich.
            Teresa Stimac arbeitet seit über 20 Jahren in der Kosmetik und behandelt diese Kombi
            persönlich.
          </p>
          <div class="lp-proof-grid" aria-label="Vertrauenssignale">
            {proofItems.map((item) => (
              <div class="lp-proof-item">
                <strong>{item.value}</strong>
                <span>{item.label}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="container lp-section lp-offer">
      <OfferBox
        variant="box"
        eyebrow="Aktionsangebot Zürich"
        oldPrice={REGULAR_PRICE}
        newPrice={PROMO_PRICE}
        discountLabel="HydraFacial + Microneedling"
        urgency={`${DURATION_LABEL} · ${SAVINGS_LABEL} · Buchung über Treatwell`}
        ctaText={CTA_LABEL}
        ctaHref={bookingHref}
      />
      <p class="lp-offer-footnote">
        HydraFacial + Microneedling für CHF {PROMO_PRICE}.– statt CHF {REGULAR_PRICE}.–.
        Die Terminbuchung läuft über Treatwell; Service und Angebot sind vorbereitet.
      </p>
    </section>

    <section class="container lp-section lp-expectation">
      <div class="lp-section-head">
        <div class="sub-display">Realistische Erwartung</div>
        <h2 class="lp-section-title">Realistische Ergebnisse statt übertriebener Versprechen</h2>
        <p class="lp-section-lead">
          Die Haut kann frischer, glatter und gepflegter wirken. Weil jeder Hautzustand
          unterschiedlich reagiert, wird das Ergebnis vor Ort ehrlich eingeordnet.
        </p>
      </div>
      <div class="lp-expectation-grid">
        {expectationItems.map((item) => (
          <div class="lp-expectation-card">
            <strong>{item.title}</strong>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="container lp-section lp-process">
      <div class="lp-section-head">
        <div class="sub-display">Buchung</div>
        <h2 class="lp-section-title">So funktioniert Ihre Buchung</h2>
        <p class="lp-section-lead">
          Der Button führt zur vorbereiteten Treatwell-Buchung. Dort wählen Sie Ihren freien
          Termin für die Kombi-Behandlung.
        </p>
      </div>
      <div class="lp-process-grid">
        {processSteps.map((step, index) => (
          <div class="lp-process-step">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{step.title}</strong>
            <p>{step.text}</p>
          </div>
        ))}
      </div>
      <div class="lp-section-cta">
        <a href={bookingHref} class="pill-btn" data-treatment="Hydrafacial + Microneedling" data-button-location="process_section">{CTA_LABEL}</a>
      </div>
    </section>

    <section class="container lp-section lp-faq">
      <div class="lp-section-head">
        <div class="sub-display">Häufige Fragen</div>
        <h2 class="lp-section-title">Alles, was Sie vor der Behandlung wissen sollten</h2>
      </div>
      <FAQAccordion items={faqs} />
    </section>

    <section class="container lp-section lp-reassurance">
      <TrustStrip variant="promises"
        align="center"
        promises={[
          { text: 'Persönliche Hautanalyse' },
          { text: 'Transparenter Aktionspreis' },
          { text: 'Zentrale Lage in Zürich' },
          { text: 'Realistische Beratung' },
        ]}
      />
    </section>

    <section class="container lp-section lp-booking" id="buchen">
      <div class="lp-section-head">
        <div class="sub-display">Termin buchen</div>
        <h2 class="lp-section-title">Sichern Sie sich Ihre HydraFacial + Microneedling Aktion</h2>
        <p class="lp-section-lead">Die Buchung läuft über Treatwell. Service, Angebot und Aktionspreis sind vorbereitet.</p>
      </div>
      <BookingCta
        treatment="Hydrafacial + Microneedling"
        href={bookingHref}
        ctaText={CTA_LABEL}
        text={`Aktionspreis CHF ${PROMO_PRICE} statt CHF ${REGULAR_PRICE}. Behandlungsdauer ${DURATION_LABEL}.`}
      />
    </section>

    <section class="lp-final-dark">
      <div class="lp-final-inner">
        <div class="sub-display lp-final-eyebrow">HydraFacial + Microneedling</div>
        <h2 class="lp-final-title">Frischer Glow. Ruhige Beratung. Ein klarer Termin.</h2>
        <p class="lp-final-lead">
          Buchen Sie die Kombi-Behandlung für CHF {PROMO_PRICE}.– statt CHF {REGULAR_PRICE}.–,
          persönlich durchgeführt bei Beauty Face Lift an der Bahnhofstrasse.
        </p>
        <div class="lp-final-ctas">
          <a href={bookingHref} class="pill-btn" data-treatment="Hydrafacial + Microneedling" data-button-location="lp_final_booking">{CTA_LABEL}</a>
          <a href="tel:+41792143462" class="pill-btn pill-btn-dark" data-button-location="lp_final_phone">+41 79 214 34 62</a>
        </div>
        <p class="lp-final-address">Beauty Face Lift · Bahnhofstrasse 94 · 8001 Zürich</p>
      </div>
    </section>

    <StickyOfferBar
      oldPrice={REGULAR_PRICE}
      newPrice={PROMO_PRICE}
      href={bookingHref}
      ctaText={CTA_LABEL}
    />
  </main>
</LandingPage>

<style>
  .lp-hero {
    padding-top: 6vh;
    padding-bottom: 6vh;
  }
  .lp-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.82fr);
    gap: 5rem;
    align-items: center;
  }
  .lp-hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.1rem;
    max-width: 720px;
  }
  .lp-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--accent-text);
  }
  .lp-title {
    margin: 0;
    letter-spacing: 0;
    font-family: var(--font-serif);
    font-weight: 500;
    color: var(--ink);
