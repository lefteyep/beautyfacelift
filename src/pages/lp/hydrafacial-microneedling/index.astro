---
import LandingPage from '../../../layouts/LandingPage.astro';
import BookingCta from '../../../components/BookingCta.astro';
import OfferBox from '../../../components/lp/OfferBox.astro';
import FAQAccordion from '../../../components/lp/FAQAccordion.astro';
import BenefitIcon from '../../../components/lp/BenefitIcon.astro';
import TrustStrip from '../../../components/lp/TrustStrip.astro';
import StickyOfferBar from '../../../components/lp/StickyOfferBar.astro';
import { Image, getImage } from 'astro:assets';
import { hydrafacialCard, microneedlingCard, teresaPortrait } from '../../../lib/site-images';
import { absoluteUrl, bookingLinkForService } from '../../../../shared/site';

const PROMO_PRICE = 170;
const REGULAR_PRICE = 250;
const DURATION_LABEL = '1 Std. 30 Min.';
const OFFER_LABEL = 'Hydrafacial + Microneedling Aktion';
const OFFER_SLUG = 'hydrafacial-microneedling-aktion';
const SAVINGS_LABEL = 'Sie sparen CHF 80.-';
const BOOKING_SERVICE = 'Hydrafacial + Microneedling';
const bookingHref = `${bookingLinkForService(BOOKING_SERVICE)}&offer=${OFFER_SLUG}&price=${PROMO_PRICE}`;
const lpHeroMainSizes = '(min-width: 1101px) 34vw, (min-width: 601px) 380px, 74vw';
const lpHeroOverlapSizes = '(min-width: 1101px) 24vw, (min-width: 601px) 260px, 52vw';
const lpAboutSizes = '(min-width: 1101px) 44vw, (min-width: 601px) 520px, 100vw';
const lpHeroPreload = await getImage({
  src: hydrafacialCard,
  widths: [480, 720, 960, 1200, 1536],
  sizes: lpHeroMainSizes,
  format: 'webp',
  quality: 'high',
});

const heroBullets = [
  'Hydrafacial Tiefenreinigung, Pflegephase und Microneedling in einer Sitzung',
  `${DURATION_LABEL} inklusive Hautanalyse, Reinigung, Needling und Abschluss-Pflege`,
  `Aktionspreis CHF ${PROMO_PRICE}.– statt CHF ${REGULAR_PRICE}.–`,
  '20+ Jahre Erfahrung · 4.8/5 aus 248+ Bewertungen',
];

const includedItems = [
  'Kurze Hautanalyse und persönliche Abstimmung',
  'Hydrafacial Reinigung & Feuchtigkeitspflege',
  'Sanfte Vorbereitung der Hautoberfläche',
  'Microneedling mit professionellem Pen',
  'Beruhigende Wirkstoff- und Abschluss-Pflege',
  'After-Care-Hinweise für die nächsten 24-48 Stunden',
];

const benefits = [
  { icon: 'droplet' as const, title: 'Intensive Feuchtigkeit', text: 'Hydrafacial versorgt die Haut mit Feuchtigkeit und unterstützt ein frisch gepflegtes Hautgefühl.' },
  { icon: 'sun' as const, title: 'Frischer Glow', text: 'Die Kombination ist auf einen wacher und strahlender wirkenden Teint ausgerichtet.' },
  { icon: 'activity' as const, title: 'Hautstruktur unterstützen', text: 'Microneedling kann die natürliche Hauterneuerung anregen und die Haut optisch glatter wirken lassen.' },
  { icon: 'target' as const, title: 'Feiner wirkende Poren', text: 'Die vorbereitende Reinigung hilft, das Hautbild ruhiger und klarer erscheinen zu lassen.' },
  { icon: 'leaf' as const, title: 'Individuell abgestimmt', text: 'Teresa passt Intensität und Pflege an Hautzustand, Verträglichkeit und Behandlungsziel an.' },
  { icon: 'trending-up' as const, title: 'Realistische Ergebnisse', text: 'Das Ziel ist sichtbar gepflegte Haut mit ehrlicher Einordnung statt übertriebener Versprechen.' },
];

const phases = [
  { title: 'Hydrafacial Reinigung', text: 'Die Haut wird gereinigt, sanft vorbereitet und mit Feuchtigkeitspflege versorgt. So entsteht eine gepflegte Basis für den zweiten Schritt.' },
  { title: 'Microneedling', text: 'Der professionelle Pen setzt feine Mikroimpulse. Das kann die natürliche Regeneration unterstützen und die Hautstruktur optisch verfeinern.' },
  { title: 'Beruhigen & pflegen', text: 'Eine abgestimmte Wirkstoff- und Abschluss-Pflege beruhigt die Haut und gibt klare Hinweise für die Nachpflege.' },
];

const expectationItems = [
  { title: 'Direkt danach', text: 'Die Haut kann frisch und gut versorgt wirken. Leichte Rötungen sind nach Microneedling möglich.' },
  { title: '24-48 Stunden', text: 'Die Haut beruhigt sich meist schrittweise. In dieser Zeit sind sanfte Pflege und Sonnenschutz besonders wichtig.' },
  { title: 'Danach', text: 'Das Hautbild kann glatter, ruhiger und gepflegter erscheinen. Die Ausprägung hängt vom individuellen Hautzustand ab.' },
];

const processSteps = [
  { title: 'Termin sichern', text: 'Der CTA führt über die bestehende Buchungsbrücke zur Treatwell-Buchung mit Kampagnenparametern.' },
  { title: 'Ankommen in Zürich', text: 'Beauty Face Lift befindet sich zentral an der Bahnhofstrasse 94, gut erreichbar in der Innenstadt.' },
  { title: '90 Minuten Behandlung', text: 'Teresa führt Hydrafacial, Microneedling und Abschluss-Pflege persönlich und kontrolliert durch.' },
  { title: 'After-Care beachten', text: 'Sie erhalten klare Hinweise zu Pflege, Make-up, Sport, Sonne und möglichen Rötungen.' },
];

const faqs = [
  {
    q: 'Für wen ist Hydrafacial + Microneedling geeignet?',
    a: 'Die Behandlung kann für viele Hauttypen interessant sein, wenn das Ziel ein frischeres, gepflegteres und optisch verfeinertes Hautbild ist. Teresa prüft vor Ort, ob die Kombination zu Ihrem Hautzustand passt.',
  },
  {
    q: 'Wie lange dauert die Behandlung?',
    a: `Die Behandlung dauert ${DURATION_LABEL}. Darin enthalten sind eine kurze Hautanalyse, Hydrafacial Reinigung, Microneedling, Abschluss-Pflege und persönliche After-Care-Hinweise.`,
  },
  {
    q: 'Was kostet die Aktion?',
    a: `Der Aktionspreis beträgt CHF ${PROMO_PRICE} statt CHF ${REGULAR_PRICE}. Die Buchung läuft über Treatwell; die Behandlungs- und Kampagnenangaben werden über unsere Buchungsseite weitergegeben.`,
  },
  {
    q: 'Gibt es Ausfallzeit?',
    a: 'Nach Hydrafacial ist die Haut meist direkt alltagstauglich. Durch das Microneedling kann sie jedoch gerötet oder empfindlich sein. Das beruhigt sich je nach Hauttyp meist innerhalb von Stunden bis 24-48 Stunden.',
  },
  {
    q: 'Ist Microneedling schmerzhaft?',
    a: 'Viele Kundinnen beschreiben das Gefühl als leichtes Piksen oder Druckgefühl. Die Intensität wird kontrolliert und individuell angepasst.',
  },
  {
    q: 'Was sollte ich nach der Behandlung beachten?',
    a: 'Für 24-48 Stunden sind sanfte Pflege, konsequenter Sonnenschutz und der Verzicht auf Sauna, intensive Sonne, Peelings, Retinol und schweisstreibenden Sport empfehlenswert. Teresa gibt Ihnen konkrete Hinweise mit.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      '@id': absoluteUrl('/lp/hydrafacial-microneedling/#product'),
      name: 'Hydrafacial + Microneedling',
      description: `Aktionsangebot in Zürich: Hydrafacial + Microneedling, ${DURATION_LABEL}, CHF ${PROMO_PRICE} statt CHF ${REGULAR_PRICE}.`,
      image: absoluteUrl('/assets/hydrafacial_treatment.png'),
      brand: { '@type': 'Brand', name: 'Beauty Face Lift' },
      offers: {
        '@type': 'Offer',
        priceCurrency: 'CHF',
        price: PROMO_PRICE.toFixed(2),
        availability: 'https://schema.org/InStock',
        url: absoluteUrl('/lp/hydrafacial-microneedling/'),
        priceValidUntil: '2026-12-31',
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<LandingPage
  title={`Hydrafacial + Microneedling Zürich - CHF ${PROMO_PRICE} statt CHF ${REGULAR_PRICE} | Beauty Face Lift`}
  description={`Hydrafacial + Microneedling an der Bahnhofstrasse Zürich. ${DURATION_LABEL}, Aktionspreis CHF ${PROMO_PRICE} statt CHF ${REGULAR_PRICE}. Frischer Glow und verfeinert wirkendes Hautbild.`}
  ogImage="/assets/hydrafacial_treatment.png"
  preloadImage={{
    href: lpHeroPreload.src,
    imagesrcset: lpHeroPreload.srcSet.attribute,
    imagesizes: lpHeroMainSizes,
    type: 'image/webp',
    fetchpriority: 'high',
  }}
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <section class="container lp-hero">
    <div class="lp-hero-grid">
      <div class="lp-hero-content">
        <div class="sub-display lp-eyebrow">
          <span class="deco-line" aria-hidden="true"></span>
          {OFFER_LABEL} · Bahnhofstrasse Zürich
        </div>
        <h1 class="lp-title display-text">Hydrafacial + Microneedling für frischen Glow und verfeinert wirkende Haut</h1>
        <p class="lp-subtitle">
          Die kombinierte Gesichtsbehandlung verbindet gründliche Hydrafacial Pflege mit
          Microneedling für ein frischeres, glatter wirkendes Hautbild. Persönlich bei
          Teresa Stimac in Zürich.
        </p>

        <div class="lp-hero-offer">
          <OfferBox
            variant="chip"
            oldPrice={REGULAR_PRICE}
            newPrice={PROMO_PRICE}
            discountLabel="Aktionspreis"
            urgency={`${DURATION_LABEL} · ${SAVINGS_LABEL} · Buchung über Treatwell`}
          />
        </div>

        <div class="lp-hero-ctas">
          <a href={bookingHref} class="pill-btn lp-hero-primary" data-treatment="Hydrafacial + Microneedling" data-button-location="lp_hero">Jetzt Termin sichern</a>
          <a href="#details" class="pill-btn pill-btn-outline lp-hero-secondary" data-button-location="lp_hero_details">Mehr erfahren</a>
        </div>

        <div class="lp-hero-trust">
          <TrustStrip variant="rating" align="left" />
        </div>

        <ul class="lp-hero-bullets">
          {heroBullets.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>

      <div class="lp-hero-media">
        <div class="lp-hero-media-main">
          <Image
            src={hydrafacialCard}
            widths={[360, 540, 720, 960, 1122]}
            sizes={lpHeroMainSizes}
            format="webp"
            quality="high"
            priority
            alt="Hydrafacial Behandlung im Beauty Face Lift Studio Zürich"
          />
        </div>
        <div class="lp-hero-media-overlap">
          <Image
            src={microneedlingCard}
            widths={[320, 480, 640, 800]}
            sizes={lpHeroOverlapSizes}
            format="webp"
            quality="high"
            loading="eager"
            alt="Microneedling Behandlung mit professionellem Pen bei Beauty Face Lift Zürich"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="container lp-section lp-problem" id="details">
    <h2 class="lp-section-title">Typische Behandlungsziele</h2>
    <div class="lp-problem-grid">
      <div class="lp-problem-item">
        <strong>Frischer wirkender Teint</strong>
        <p>Hydrafacial pflegt und hydratisiert, damit die Haut klarer und wacher erscheinen kann.</p>
      </div>
      <div class="lp-problem-item">
        <strong>Feiner wirkende Struktur</strong>
        <p>Microneedling kann die natürliche Hauterneuerung unterstützen und Textur optisch glätten.</p>
      </div>
      <div class="lp-problem-item">
        <strong>Gepflegte Ausstrahlung</strong>
        <p>Die Behandlung ist auf ein gepflegtes Hautgefühl und einen sanften Glow ausgerichtet.</p>
      </div>
      <div class="lp-problem-item">
        <strong>Persönliche Abstimmung</strong>
        <p>Intensität und Pflege werden nach Hautzustand, Empfindlichkeit und Ziel angepasst.</p>
      </div>
    </div>
  </section>

  <div class="lp-divider" aria-hidden="true"><span class="deco-line"></span></div>

  <section class="container lp-section lp-included">
    <div class="lp-section-head">
      <div class="sub-display">Enthalten im Preis</div>
      <h2 class="lp-section-title">Was Sie bei jeder Sitzung erhalten</h2>
      <p class="lp-section-lead">
        {DURATION_LABEL}. Sechs klare Behandlungsschritte. Aktionspreis CHF {PROMO_PRICE}.–
        statt CHF {REGULAR_PRICE}.–.
      </p>
    </div>
    <ul class="lp-included-list">
      {includedItems.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </section>

  <section class="container lp-section lp-solution">
    <div class="lp-section-head">
      <div class="sub-display">Die Kombi-Behandlung</div>
      <h2 class="lp-section-title">Erst reinigen. Dann stimulieren. Dann beruhigen.</h2>
      <p class="lp-section-lead">
        Hydrafacial bereitet die Haut pflegend vor, Microneedling setzt kontrollierte
        Mikroimpulse, und die Abschluss-Pflege unterstützt die Haut danach.
      </p>
    </div>
    <div class="lp-phases">
      {phases.map((phase, index) => (
        <div class="lp-phase">
          <div class="lp-phase-no">{String(index + 1).padStart(2, '0')}</div>
          <h3>{phase.title}</h3>
          <p>{phase.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container lp-section lp-benefits-section">
    <div class="lp-section-head">
      <div class="sub-display">Ihre Vorteile</div>
      <h2 class="lp-section-title">6 Gründe für Hydrafacial + Microneedling</h2>
      <p class="lp-section-lead">
        Für Kundinnen, die Reinigung, Feuchtigkeit und kosmetische Hautverfeinerung
        in einer abgestimmten 90-Minuten-Sitzung verbinden möchten.
      </p>
    </div>
    <div class="lp-benefits-grid">
      {benefits.map((b) => (
        <div class="lp-benefit">
          <div class="lp-benefit-icon-wrap">
            <BenefitIcon name={b.icon} size={28} />
          </div>
          <strong>{b.title}</strong>
          <p>{b.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container lp-section lp-offer">
    <OfferBox
      variant="box"
      eyebrow="Aktionsangebot Zürich"
      oldPrice={REGULAR_PRICE}
      newPrice={PROMO_PRICE}
      discountLabel="Hydrafacial + Microneedling"
      urgency={`${DURATION_LABEL} · ${SAVINGS_LABEL} · Buchung über Treatwell`}
      ctaText="Termin für CHF 170 sichern"
      ctaHref={bookingHref}
    />
    <p class="lp-offer-footnote">
      Hydrafacial + Microneedling für CHF {PROMO_PRICE}.– statt CHF {REGULAR_PRICE}.–.
      Die Terminbuchung läuft über Treatwell. Ihre Kampagnenparameter werden übernommen.
    </p>
  </section>

  <div class="lp-divider" aria-hidden="true"><span class="deco-line"></span></div>

  <section class="container lp-section lp-expectation">
    <div class="lp-section-head">
      <div class="sub-display">Realistische Erwartung</div>
      <h2 class="lp-section-title">Was nach der Behandlung möglich ist</h2>
      <p class="lp-section-lead">
        Die Haut kann frischer, glatter und gepflegter wirken. Da jeder Hautzustand
        unterschiedlich reagiert, werden Ergebnisse nie pauschal versprochen.
      </p>
    </div>
    <div class="lp-expectation-grid">
      {expectationItems.map((item) => (
        <div class="lp-expectation-card">
          <strong>{item.title}</strong>
          <p>{item.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container lp-section lp-about">
    <div class="lp-about-grid">
      <div class="lp-about-media">
        <Image
          src={teresaPortrait}
          widths={[360, 540, 720, 960, 1023]}
          sizes={lpAboutSizes}
          format="webp"
          quality="high"
          alt="Teresa Stimac, Gründerin von Beauty Face Lift Zürich"
          loading="eager"
        />
      </div>
      <div class="lp-about-content">
        <div class="sub-display margin-bottom-md">Qualität & Vertrauen</div>
        <h2 class="lp-section-title">Persönlich behandelt von Teresa Stimac</h2>
        <blockquote class="lp-about-quote">
          <p>„Ich nehme mir Zeit, erkläre jeden Schritt und stimme die Behandlung auf die Haut ab."</p>
        </blockquote>
        <p>
          Beauty Face Lift ist ein Premium Kosmetikinstitut an der Bahnhofstrasse 94
          in Zürich. Teresa arbeitet seit über 20 Jahren in der Kosmetik und legt Wert
          auf saubere Abläufe, diskrete Betreuung und realistische Beratung.
        </p>
        <ul class="lp-about-list">
          <li>Bahnhofstrasse 94 · 8001 Zürich</li>
          <li>20+ Jahre Erfahrung in kosmetisch-ästhetischen Behandlungen</li>
          <li>4.8/5 Sterne aus 248+ Bewertungen</li>
          <li>Behandlung persönlich durch Teresa Stimac</li>
        </ul>
      </div>
    </div>
  </section>

  <div class="lp-divider" aria-hidden="true"><span class="deco-line"></span></div>

  <section class="container lp-section lp-process">
    <div class="lp-section-head">
      <div class="sub-display">Ablauf</div>
      <h2 class="lp-section-title">So funktioniert Ihre Buchung</h2>
      <p class="lp-section-lead">
        Der schnellste Weg zur Aktion führt über die bestehende Treatwell-Buchung.
        Service, Angebot und Preis werden als Kampagnenparameter weitergegeben.
      </p>
    </div>
    <div class="lp-process-grid">
      {processSteps.map((step, index) => (
        <div class="lp-process-step">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <strong>{step.title}</strong>
          <p>{step.text}</p>
        </div>
      ))}
    </div>
    <div class="lp-section-cta">
      <a href={bookingHref} class="pill-btn" data-treatment="Hydrafacial + Microneedling" data-button-location="process_section">Freien Termin wählen</a>
    </div>
  </section>

  <section class="container lp-section lp-faq">
    <div class="lp-section-head">
      <div class="sub-display">Häufige Fragen</div>
      <h2 class="lp-section-title">Alles, was Sie wissen sollten</h2>
    </div>
    <FAQAccordion items={faqs} />
  </section>

  <section class="container lp-section lp-reassurance">
    <TrustStrip variant="promises"
      align="center"
      promises={[
        { text: 'Persönliche Hautanalyse' },
        { text: 'Transparenter Aktionspreis' },
        { text: 'Zentrale Lage in Zürich' },
        { text: 'Realistische Beratung' },
      ]}
    />
  </section>

  <section class="container lp-section" id="buchen">
    <div class="lp-section-head">
      <div class="sub-display">Termin buchen</div>
      <h2 class="lp-section-title">Sichern Sie sich Ihre Hydrafacial + Microneedling Aktion</h2>
      <p class="lp-section-lead">Die Terminbuchung läuft über Treatwell. Ihre Behandlungsangabe wird übernommen.</p>
    </div>
    <BookingCta
      treatment="Hydrafacial + Microneedling"
      href={bookingHref}
      ctaText="Termin für CHF 170 sichern"
      text={`Aktionspreis CHF ${PROMO_PRICE} statt CHF ${REGULAR_PRICE}. Behandlungsdauer ${DURATION_LABEL}.`}
    />
  </section>

  <section class="lp-final-dark">
    <div class="lp-final-inner">
      <div class="sub-display lp-final-eyebrow">Hydrafacial + Microneedling</div>
      <h2 class="lp-final-title">Frischer Glow. Klarer Plan.</h2>
      <p class="lp-final-lead">
        Buchen Sie die Kombi-Behandlung für CHF {PROMO_PRICE}.– statt CHF {REGULAR_PRICE}.–.
        Persönlich durchgeführt bei Beauty Face Lift an der Bahnhofstrasse.
      </p>
      <div class="lp-final-ctas">
        <a href={bookingHref} class="pill-btn" data-treatment="Hydrafacial + Microneedling" data-button-location="lp_final_booking">Termin für CHF 170 sichern</a>
        <a href="tel:+41792143462" class="pill-btn pill-btn-dark" data-button-location="lp_final_phone">+41 79 214 34 62</a>
      </div>
      <p class="lp-final-address">Beauty Face Lift · Bahnhofstrasse 94 · 8001 Zürich</p>
    </div>
  </section>

  <StickyOfferBar
    oldPrice={REGULAR_PRICE}
    newPrice={PROMO_PRICE}
    href={bookingHref}
    ctaText="Jetzt buchen"
  />
</LandingPage>

<style>
  .lp-hero {
    padding-top: 6vh;
    padding-bottom: 6vh;
  }
  .lp-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.82fr);
    gap: 5rem;
    align-items: center;
  }
  .lp-hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.1rem;
    max-width: 720px;
  }
  .lp-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--accent-text);
  }
  .lp-title {
    margin: 0;
    letter-spacing: 0;
    font-family: var(--font-serif);
    font-weight: 500;
    color: var(--ink);
    font-size: clamp(2.55rem, 4vw, 3.95rem);
    line-height: 1.02;
    text-wrap: balance;
  }
  .lp-subtitle {
    color: var(--text-secondary);
    font-size: 1.13rem;
    line-height: 1.62;
    max-width: 620px;
    margin: 0;
  }
  .lp-hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: stretch;
  }
  .lp-hero-ctas > :global(.pill-btn) {
    min-height: 56px;
    padding: 15px clamp(1.25rem, 2vw, 1.9rem);
    font-size: 0.82rem;
    line-height: 1;
    letter-spacing: 0.09em;
  }
  .lp-hero-primary {
    flex: 0 1 276px;
    min-width: min(100%, 240px);
    white-space: nowrap;
  }
  .lp-hero-secondary {
    justify-content: center;
  }
  .lp-hero-trust {
    padding-top: 0.35rem;
  }
  .lp-hero-bullets {
    list-style: none;
    padding: 1.25rem 0 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.65rem 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }
  .lp-hero-bullets li {
    position: relative;
    padding-left: 1.25rem;
    color: var(--text-secondary);
    font-size: 0.96rem;
    line-height: 1.45;
  }
  .lp-hero-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.68em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }
  .lp-hero-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    max-width: 620px;
    justify-self: end;
  }
  .lp-hero-media-main {
    position: absolute;
    left: 0;
    top: 7%;
    width: 64%;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-card);
    overflow: hidden;
