---

import Base from '../../layouts/Base.astro';
import BookingWidget from '../../components/booking/BookingWidget';

const structuredData = {
    "@context": "https://schema.org",
    "@type": "HealthAndBeautyBusiness",
    "name": "Beauty Face Lift",
    "url": "https://beautyfacelift.ch",
    "telephone": "+41792143462",
    "address": {
        "@type": "PostalAddress",
        "streetAddress": "Bahnhofstrasse 94",
        "addressLocality": "Zürich",
        "postalCode": "8001",
        "addressCountry": "CH"
    },
    "potentialAction": {
        "@type": "ReserveAction",
        "target": {
            "@type": "EntryPoint",
            "urlTemplate": "https://beautyfacelift.ch/termin/"
        },
        "result": {
            "@type": "Reservation",
            "name": "Termin buchen"
        }
    }
};
---

<Base
    title="Termin buchen | Beauty Face Lift Zürich — Online Buchung"
    description="Termin buchen bei Beauty Face Lift Zürich ★ 4.8/5 — Hydrafacial ab CHF 190, Microneedling, Peeling & ColdPlasma. Online Buchung in 3 Klicks. Bahnhofstrasse 94."
    structuredData={structuredData}
>
    <section class="container" style="padding-top: 16vh; padding-bottom: 2vh; text-align: center;">
        <h1 style="font-size: clamp(2.5rem, 5vw, 4rem); margin-bottom: 1rem; text-transform: none;">Termin buchen</h1>
        <p style="max-width: 600px; margin: 0 auto 1rem;">Wählen Sie Ihre gewünschte Behandlung, ein passendes Datum und Ihre Wunschzeit — die Bestätigung erhalten Sie sofort per E-Mail.</p>
        <p style="font-size: 0.85rem; color: var(--text-secondary); max-width: 500px; margin: 0 auto;">Bahnhofstrasse 94, 8001 Zürich • Mo–Fr 09–18 Uhr, Sa 10–16 Uhr</p>
    </section>
    <section class="container" style="padding-top: 2vh; padding-bottom: 10vh;">
        <BookingWidget client:load />
    </section>
</Base>
