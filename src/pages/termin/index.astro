---
import Base from '../../layouts/Base.astro';
import { absoluteUrl, AESTHETIKA_BOOKING_URL,
    BOOKING_FORWARD_KEYS, } from '../../../shared/site';

const bookingForwardKeys = [...BOOKING_FORWARD_KEYS];

const structuredData = {
    "@context": "https://schema.org",
    "@type": "BeautySalon",
    "name": "Beauty Face Lift",
    "url": absoluteUrl('/'),
    "telephone": "+41792143462",
    "address": {
        "@type": "PostalAddress",
        "streetAddress": "Bahnhofstrasse 94",
        "addressLocality": "Zürich",
        "postalCode": "8001",
        "addressCountry": "CH"
    },
    "potentialAction": {
        "@type": "ReserveAction",
        "target": {
            "@type": "EntryPoint",
            "urlTemplate": AESTHETIKA_BOOKING_URL
        },
        "result": {
            "@type": "Reservation",
            "name": "Termin buchen"
        }
    }
};
---

<Base
    title="Termin buchen | Beauty Face Lift Zürich"
    description="Termin buchen bei Beauty Face Lift Zürich. Die Online-Buchung läuft zentral über Aesthetika."
    structuredData={structuredData}
    noindex={true}
>
    <section class="booking-forward-page">
        <span class="sub-display">Online Buchen</span>
        <h1>Wir leiten Sie zur Buchung weiter.</h1>
        <p>
            Beauty Face Lift nutzt Aesthetika für die Online-Terminbuchung.
            Ihre Kampagnen- und Behandlungsangaben werden automatisch übernommen.
        </p>

        <div class="booking-forward-actions">
            <a
                id="aesthetika-booking-link"
                href={AESTHETIKA_BOOKING_URL}
                class="pill-btn"
                rel="noopener"
            >
                Buchung öffnen
            </a>
            <a href="/kontakt/" class="pill-btn pill-btn-outline">Kontakt aufnehmen</a>
        </div>

        <p id="booking-forward-status" class="booking-forward-note" aria-live="polite">
            Falls die Weiterleitung nicht automatisch startet, nutzen Sie den Buchungsbutton.
        </p>
    </section>
</Base>

<script is:inline define:vars={{ bookingTargetUrl: AESTHETIKA_BOOKING_URL, bookingForwardKeys }}>
    (function() {
        var fallbackLink = document.getElementById('aesthetika-booking-link');
        var status = document.getElementById('booking-forward-status');
        var currentParams = new URLSearchParams(window.location.search);
        var storedParams = {};

        try {
            storedParams = JSON.parse(sessionStorage.getItem('bfl_utm') || '{}') || {};
        } catch(e) {
            storedParams = {};
        }

        var target = new URL(bookingTargetUrl);
        bookingForwardKeys.forEach(function(key) {
            var value = currentParams.get(key);
            if (!value && typeof storedParams[key] === 'string') {
                value = storedParams[key];
            }
            if (value) {
                target.searchParams.set(key, value);
            }
        });

        var href = target.toString();
        if (fallbackLink) {
            fallbackLink.setAttribute('href', href);
        }
        if (status) {
            status.textContent = 'Weiterleitung zu Aesthetika wird vorbereitet...';
        }

        window.setTimeout(function() {
            window.location.replace(href);
        }, 650);
    })();
</script>

<style>
    .booking-forward-page {
        min-height: 68vh;
        padding: 18vh var(--content-px) 12vh;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .booking-forward-page h1 {
        max-width: 760px;
        margin: 1rem auto;
        font-size: clamp(2.3rem, 6vw, 4.8rem);
        line-height: 1.02;
        text-transform: none;
    }

    .booking-forward-page p {
        max-width: 620px;
        margin: 0 auto;
        color: var(--text-secondary);
    }

    .booking-forward-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem;
        margin: 2rem 0 1rem;
    }

    .booking-forward-note {
        font-size: 0.9rem;
    }
</style>
