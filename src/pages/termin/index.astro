---

import Base from '../../layouts/Base.astro';
import { TREATWELL_BOOKING_URL } from '../../../shared/site';

const structuredData = {
    "@context": "https://schema.org",
    "@type": "HealthAndBeautyBusiness",
    "name": "Beauty Face Lift",
    "url": "https://beautyfacelift.ch",
    "telephone": "+41792143462",
    "address": {
        "@type": "PostalAddress",
        "streetAddress": "Bahnhofstrasse 94",
        "addressLocality": "Zürich",
        "postalCode": "8001",
        "addressCountry": "CH"
    },
    "potentialAction": {
        "@type": "ReserveAction",
        "target": {
            "@type": "EntryPoint",
            "urlTemplate": TREATWELL_BOOKING_URL
        },
        "result": {
            "@type": "Reservation",
            "name": "Termin buchen"
        }
    }
};
---

<Base
    title="Termin buchen | Beauty Face Lift Zürich — Online Buchung"
    description="Termin buchen bei Beauty Face Lift Zürich ★ 4.8/5 — Hydra4Face ab CHF 180, Microneedling, Peeling & ColdPlasma. Online Buchung in 3 Klicks. Bahnhofstrasse 94."
    structuredData={structuredData}
    noindex
>
    <section style="padding: 80px 58px 40px; text-align: center;">
        <span class="sub-display" style="display: block; margin-bottom: 16px;">Online buchen</span>
        <h1 style="font-size: 42px; margin-bottom: 16px; text-transform: none;">Weiterleitung zur Buchung</h1>
        <p style="max-width: 600px; margin: 0 auto 24px;">Die Online-Buchung läuft aktuell über Treatwell.</p>
        <a href={TREATWELL_BOOKING_URL} class="pill-btn">Jetzt über Treatwell buchen</a>
    </section>

    <section style="padding: 0 58px 80px; text-align: center;">
        <p style="font-size: 13px; color: var(--text-secondary); max-width: 500px; margin: 0 auto;">Bahnhofstrasse 94 · Samstag Sonderöffnung · Persönliche Betreuung</p>
    </section>

    <script define:vars={{ bookingUrl: TREATWELL_BOOKING_URL }}>
        window.location.replace(bookingUrl);
    </script>
</Base>
