---
import Base from '../../layouts/Base.astro';
import { absoluteUrl, TREATWELL_BOOKING_URL,
    BOOKING_FORWARD_KEYS, } from '../../../shared/site';

const bookingForwardKeys = [...BOOKING_FORWARD_KEYS];

const structuredData = {
    "@context": "https://schema.org",
    "@type": "BeautySalon",
    "name": "Beauty Face Lift",
    "url": absoluteUrl('/'),
    "telephone": "+41792143462",
    "address": {
        "@type": "PostalAddress",
        "streetAddress": "Bahnhofstrasse 94",
        "addressLocality": "Zürich",
        "postalCode": "8001",
        "addressCountry": "CH"
    },
    "potentialAction": {
        "@type": "ReserveAction",
        "target": {
            "@type": "EntryPoint",
            "urlTemplate": TREATWELL_BOOKING_URL
        },
        "result": {
            "@type": "Reservation",
            "name": "Termin buchen"
        }
    }
};
---

<Base
    title="Termin buchen | Beauty Face Lift Zürich"
    description="Termin buchen bei Beauty Face Lift Zürich. Die Online-Buchung läuft vorübergehend über Treatwell."
    structuredData={structuredData}
    noindex={true}
>
    <section class="booking-forward-page">
        <span class="sub-display">Online Buchen</span>
        <h1>Wir leiten Sie zur Buchung weiter.</h1>
        <p>
            Beauty Face Lift nutzt vorübergehend Treatwell für die Online-Terminbuchung.
            Ihre Kampagnen- und Behandlungsangaben werden automatisch übernommen.
        </p>
        <p id="booking-forward-offer" class="booking-forward-offer" hidden></p>

        <div class="booking-forward-actions">
            <a
                id="treatwell-booking-link"
                href={TREATWELL_BOOKING_URL}
                class="pill-btn"
                rel="noopener"
            >
                Buchung öffnen
            </a>
            <a href="/kontakt/" class="pill-btn pill-btn-outline">Kontakt aufnehmen</a>
        </div>

        <p id="booking-forward-status" class="booking-forward-note" aria-live="polite">
            Falls die Weiterleitung nicht automatisch startet, nutzen Sie den Buchungsbutton.
        </p>
    </section>
</Base>

<script is:inline define:vars={{ bookingTargetUrl: TREATWELL_BOOKING_URL, bookingForwardKeys }}>
    (function() {
        var fallbackLink = document.getElementById('treatwell-booking-link');
        var status = document.getElementById('booking-forward-status');
        var offerNote = document.getElementById('booking-forward-offer');
        var currentParams = new URLSearchParams(window.location.search);
        var storedParams = {};
        var trackedOutbound = false;

        try {
            storedParams = JSON.parse(sessionStorage.getItem('bfl_utm') || '{}') || {};
        } catch(e) {
            storedParams = {};
        }

        var target = new URL(bookingTargetUrl);
        bookingForwardKeys.forEach(function(key) {
            var value = currentParams.get(key);
            if (!value && typeof storedParams[key] === 'string') {
                value = storedParams[key];
            }
            if (value) {
                target.searchParams.set(key, value);
            }
        });

        var href = target.toString();
        if (fallbackLink) {
            fallbackLink.setAttribute('href', href);
        }
        var offer = currentParams.get('offer') || storedParams.offer || '';
        var price = currentParams.get('price') || storedParams.price || '';
        if (offerNote && offer === 'glow-up-aktion' && price === '169') {
            offerNote.hidden = false;
            offerNote.textContent = 'Glow-Up Aktion: Carbon Peeling + Microneedling für CHF 169 statt CHF 220 wird an Treatwell übergeben.';
        }
        if (status) {
            status.textContent = 'Weiterleitung zu Treatwell wird vorbereitet...';
        }

        function randomId() {
            if (window.crypto && typeof window.crypto.randomUUID === 'function') return window.crypto.randomUUID();
            return String(Date.now()) + '-' + Math.random().toString(36).slice(2);
        }

        function readCookie(name) {
            var encodedName = encodeURIComponent(name) + '=';
            var cookie = document.cookie.split('; ').find(function(part) {
                return part.indexOf(encodedName) === 0;
            });
            return cookie ? decodeURIComponent(cookie.slice(encodedName.length)) : '';
        }

        function clean(payload) {
            var output = {};
            Object.keys(payload).forEach(function(key) {
                var value = payload[key];
                if (value !== undefined && value !== null && value !== '') output[key] = value;
            });
            return output;
        }

        function campaignParams() {
            var output = {};
            bookingForwardKeys.forEach(function(key) {
                var value = currentParams.get(key);
                if (!value && typeof storedParams[key] === 'string') value = storedParams[key];
                if (value) output[key] = value;
            });
            return output;
        }

        function postCapi(eventId, eventData) {
            if (window.location.protocol !== 'https:') return;
            try {
                var userData = {};
                var fbp = readCookie('_fbp');
                var fbc = readCookie('_fbc');
                if (fbp) userData.fbp = fbp;
                if (fbc) userData.fbc = fbc;

                fetch('/api/track', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    keepalive: true,
                    body: JSON.stringify({
                        event_name: 'TreatwellOutboundClick',
                        event_id: eventId,
                        event_source_url: window.location.href,
                        event_data: eventData,
                        user_data: userData
                    })
                }).catch(function() {});
            } catch(e) {}
        }

        function trackOutbound() {
            if (trackedOutbound) return;
            trackedOutbound = true;

            var service = currentParams.get('service') || storedParams.service || 'not_set';
            var eventId = randomId();
            var eventData = clean({
                event_id: eventId,
                treatment_name: service,
                service: service,
                button_location: 'booking_forward_auto_redirect',
                page_path: window.location.pathname,
                page_type: 'booking_forward',
                destination_url: href,
                link_domain: target.hostname,
                value: 10,
                currency: 'CHF'
            });
            var dataLayerPayload = clean(Object.assign({}, campaignParams(), eventData, {
                event: 'treatwell_outbound_click'
            }));

            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push(dataLayerPayload);

            if (typeof window.fbq === 'function') {
                window.fbq('trackCustom', 'TreatwellOutboundClick', eventData, { eventID: eventId });
            }

            postCapi(eventId, {
                treatment_name: eventData.treatment_name,
                service: eventData.service,
                button_location: eventData.button_location,
                page_path: eventData.page_path,
                page_type: eventData.page_type,
                destination_url: eventData.destination_url,
                link_domain: eventData.link_domain,
                value: eventData.value,
                currency: eventData.currency
            });
        }

        function safeTrackOutbound() {
            try {
                trackOutbound();
            } catch(e) {}
        }

        if (fallbackLink) {
            fallbackLink.addEventListener('click', function(event) {
                event.preventDefault();
                safeTrackOutbound();
                window.setTimeout(function() {
                    window.location.assign(href);
                }, 250);
            }, { capture: true });
        }

        window.setTimeout(function() {
            safeTrackOutbound();
            window.location.replace(href);
        }, 650);
    })();
</script>

<style>
    .booking-forward-page {
        min-height: 68vh;
        padding: 18vh var(--content-px) 12vh;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .booking-forward-page h1 {
        max-width: 760px;
        margin: 1rem auto;
        font-size: clamp(2.3rem, 6vw, 4.8rem);
        line-height: 1.02;
        text-transform: none;
    }

    .booking-forward-page p {
        max-width: 620px;
        margin: 0 auto;
        color: var(--text-secondary);
    }

    .booking-forward-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem;
        margin: 2rem 0 1rem;
    }

    .booking-forward-note {
        font-size: 0.9rem;
    }

    .booking-forward-offer {
        margin-top: 1rem !important;
        color: var(--accent-text) !important;
        font-size: 0.95rem;
        font-weight: 600;
    }
</style>
