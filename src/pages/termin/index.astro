---
import Base from '../../layouts/Base.astro';
import {
    absoluteUrl,
    ADDRESS,
    BOOKING_FORWARD_KEYS,
    CONTACT_EMAIL,
    CONTACT_PHONE,
    CONTACT_PHONE_DISPLAY,
    CONTACT_WHATSAPP_URL,
    FULL_ADDRESS,
    TREATWELL_BOOKING_URL,
} from '../../../shared/site';

const bookingForwardKeys = [...BOOKING_FORWARD_KEYS];
const treatwellServiceDetailsByService = {
    'Aquafacial + Microneedling': 'TR4124140',
};

const bookingPaths = [
    {
        title: 'Ich weiss, was ich buchen möchte',
        body: 'Öffnen Sie die Online-Buchung und wählen Sie Behandlung, Datum und Uhrzeit direkt bei Treatwell aus.',
        cta: 'Online-Termin öffnen',
        href: TREATWELL_BOOKING_URL,
        primary: true,
        dataBookingLink: true,
    },
    {
        title: 'Ich bin unsicher',
        body: 'Schreiben Sie kurz Ihr Hautziel oder Ihre Frage. Teresa empfiehlt Ihnen den passenden nächsten Schritt.',
        cta: 'Beratung anfragen',
        href: '/kontakt/#kontaktformular',
    },
    {
        title: 'Ich habe eine schnelle Frage',
        body: 'Für kurze Rückfragen, Terminänderungen oder eine schnelle Einschätzung ist WhatsApp meist der direkteste Weg.',
        cta: 'Frage stellen',
        href: CONTACT_WHATSAPP_URL,
        external: true,
    },
];

const processSteps = [
    {
        title: 'Behandlung oder Anliegen wählen',
        body: 'Buchen Sie direkt online oder senden Sie zuerst eine kurze Anfrage, wenn Sie eine Empfehlung wünschen.',
    },
    {
        title: 'Termin und Details klären',
        body: 'Bei der Buchung erhalten Sie die Bestätigung über Treatwell. Bei einer Anfrage meldet sich Teresa persönlich.',
    },
    {
        title: 'Ankommen an der Bahnhofstrasse',
        body: 'Das Studio befindet sich zentral an der Bahnhofstrasse 94 in Zürich, gut erreichbar beim Paradeplatz.',
    },
];

const trustItems = [
    'Zentral an der Bahnhofstrasse 94 in Zürich',
    'Persönliche Beratung durch Teresa Stimac',
    'Professionelle kosmetische Behandlungen',
    'Direkte Online-Buchung oder ruhige Vorabklärung',
];

const faqItems = [
    {
        question: 'Soll ich direkt buchen oder zuerst eine Beratung anfragen?',
        answer: 'Wenn Sie bereits wissen, welche Behandlung Sie möchten, können Sie direkt online buchen. Wenn Sie unsicher sind, beschreiben Sie kurz Ihr Hautziel über das Kontaktformular oder WhatsApp.',
    },
    {
        question: 'Wohin führt die Online-Buchung?',
        answer: 'Die Online-Buchung läuft aktuell über Treatwell. Kampagnen- und Behandlungsangaben werden, soweit vorhanden, an den Buchungslink übergeben.',
    },
    {
        question: 'Kann ich eine Behandlungsempfehlung bekommen?',
        answer: 'Ja. Teresa prüft Ihre Angaben persönlich und empfiehlt einen passenden nächsten Schritt je nach Hauttyp, Ziel und Verträglichkeit.',
    },
    {
        question: 'Wo findet der Termin statt?',
        answer: `Beauty Face Lift befindet sich an der ${FULL_ADDRESS}, zentral in Zürich in der Nähe von Paradeplatz und Börsenstrasse.`,
    },
];

const structuredData = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'WebPage',
            '@id': absoluteUrl('/termin/#webpage'),
            name: 'Termin buchen | Beauty Face Lift Zürich',
            url: absoluteUrl('/termin/'),
            description: 'Termin bei Beauty Face Lift Zürich buchen oder persönliche Beratung anfragen. Kosmetische Behandlungen zentral an der Bahnhofstrasse 94.',
            isPartOf: {
                '@type': 'WebSite',
                name: 'Beauty Face Lift Zürich',
                url: absoluteUrl('/'),
            },
        },
        {
            '@type': 'BeautySalon',
            '@id': absoluteUrl('/#beauty-salon'),
            name: 'Beauty Face Lift Zürich',
            url: absoluteUrl('/'),
            telephone: CONTACT_PHONE_DISPLAY,
            email: CONTACT_EMAIL,
            address: {
                '@type': 'PostalAddress',
                streetAddress: ADDRESS.street,
                addressLocality: ADDRESS.city,
                postalCode: ADDRESS.postalCode,
                addressCountry: ADDRESS.country,
            },
            potentialAction: {
                '@type': 'ReserveAction',
                target: {
                    '@type': 'EntryPoint',
                    urlTemplate: TREATWELL_BOOKING_URL,
                },
                result: {
                    '@type': 'Reservation',
                    name: 'Termin buchen',
                },
            },
        },
        {
            '@type': 'FAQPage',
            '@id': absoluteUrl('/termin/#faq'),
            mainEntity: faqItems.map((item) => ({
                '@type': 'Question',
                name: item.question,
                acceptedAnswer: {
                    '@type': 'Answer',
                    text: item.answer,
                },
            })),
        },
    ],
};
---

<Base
    title="Termin buchen | Beauty Face Lift Zürich"
    description="Termin bei Beauty Face Lift Zürich buchen oder persönliche Beratung anfragen. Kosmetische Behandlungen zentral an der Bahnhofstrasse 94."
    structuredData={structuredData}
    noindex={true}
>
    <main class="booking-hub-page">
        <section class="booking-hub-hero container" aria-labelledby="booking-heading">
            <div class="booking-hub-copy">
                <span class="sub-display">Termin buchen</span>
                <h1 id="booking-heading">Termin bei Beauty Face Lift Zürich buchen</h1>
                <p>
                    Wählen Sie den Weg, der zu Ihrem Anliegen passt: direkte Online-Buchung, persönliche Empfehlung oder eine kurze Frage vorab. Teresa stimmt die Behandlung ruhig und individuell auf Ihr Hautziel ab.
                </p>
                <ul class="booking-trust-list" aria-label="Vertrauenssignale">
                    {trustItems.map((item) => <li>{item}</li>)}
                </ul>
                <div class="booking-hero-actions">
                    <a
                        id="treatwell-booking-link"
                        href={TREATWELL_BOOKING_URL}
                        class="pill-btn"
                        data-booking-link
                        data-button-location="booking_hub_hero"
                    >
                        Termin buchen
                    </a>
                    <a href="/kontakt/#kontaktformular" class="pill-btn pill-btn-outline">
                        Beratung anfragen
                    </a>
                </div>
                <p id="booking-forward-offer" class="booking-forward-offer" hidden></p>
                <p id="booking-forward-status" class="booking-forward-note" aria-live="polite">
                    Die Buchung öffnet Treatwell. Wenn Sie unsicher sind, können Sie zuerst Teresa eine Frage senden.
                </p>
            </div>

            <aside class="booking-hub-panel" aria-label="Kontakt und Standort">
                <span class="booking-panel-kicker">Beauty Face Lift</span>
                <h2>Bahnhofstrasse 94, Zürich</h2>
                <p>Persönliche Kosmetik, Hautpflege und Beauty-Behandlungen in zentraler Lage.</p>
                <dl>
                    <div>
                        <dt>Telefon</dt>
                        <dd><a href={`tel:${CONTACT_PHONE}`}>{CONTACT_PHONE_DISPLAY}</a></dd>
                    </div>
                    <div>
                        <dt>E-Mail</dt>
                        <dd><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></dd>
                    </div>
                    <div>
                        <dt>Adresse</dt>
                        <dd>{FULL_ADDRESS}</dd>
                    </div>
                </dl>
            </aside>
        </section>

        <section class="booking-hub-section container" aria-labelledby="booking-paths-heading">
            <div class="booking-section-heading">
                <span class="sub-display">Ihr nächster Schritt</span>
                <h2 id="booking-paths-heading">Wählen Sie den passenden Weg</h2>
                <p>Der schnellste Weg hängt davon ab, ob Ihre Behandlung schon feststeht oder ob Sie zuerst eine persönliche Einschätzung wünschen.</p>
            </div>

            <div class="booking-path-grid">
                {bookingPaths.map((path, index) => (
                    <article class:list={['booking-path-card', path.primary && 'booking-path-card--primary']}>
                        <span class="booking-path-number">{String(index + 1).padStart(2, '0')}</span>
                        <h3>{path.title}</h3>
                        <p>{path.body}</p>
                        <a
                            href={path.href}
                            class:list={['pill-btn', !path.primary && 'pill-btn-outline']}
                            {...(path.external ? { target: '_blank', rel: 'noopener' } : {})}
                            {...(path.dataBookingLink ? { 'data-booking-link': true, 'data-button-location': 'booking_hub_path_card' } : {})}
                        >
                            {path.cta}
                        </a>
                    </article>
                ))}
            </div>
        </section>

        <section class="booking-hub-section booking-hub-section--soft" aria-labelledby="booking-process-heading">
            <div class="container">
                <div class="booking-section-heading">
                    <span class="sub-display">Ablauf</span>
                    <h2 id="booking-process-heading">So geht es nach Ihrer Anfrage weiter</h2>
                    <p>Klarer Ablauf, keine übertriebenen Versprechen: Sie erhalten den passenden Termin oder eine ehrliche Empfehlung für Ihre Haut und Ihr Ziel.</p>
                </div>

                <div class="booking-process-grid">
                    {processSteps.map((step, index) => (
                        <div class="booking-process-step">
                            <span>{String(index + 1).padStart(2, '0')}</span>
                            <h3>{step.title}</h3>
                            <p>{step.body}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <section class="booking-hub-section container" aria-labelledby="booking-faq-heading">
            <div class="booking-section-heading">
                <span class="sub-display">Häufige Fragen</span>
                <h2 id="booking-faq-heading">Gut zu wissen vor der Buchung</h2>
            </div>

            <div class="booking-faq-list">
                {faqItems.map((item) => (
                    <details>
                        <summary>{item.question}</summary>
                        <p>{item.answer}</p>
                    </details>
                ))}
            </div>
        </section>

        <section class="booking-final-cta container" aria-labelledby="booking-final-heading">
            <span class="sub-display">Persönliche Empfehlung</span>
            <h2 id="booking-final-heading">Nicht sicher, welche Behandlung passt?</h2>
            <p>Schreiben Sie Teresa kurz, was Sie sich für Ihre Haut wünschen. So bleibt der erste Schritt ruhig, passend und realistisch.</p>
            <div class="booking-final-actions">
                <a href="/kontakt/#kontaktformular" class="pill-btn">Beratung anfragen</a>
                <a href={CONTACT_WHATSAPP_URL} class="pill-btn pill-btn-outline" target="_blank" rel="noopener">Frage stellen</a>
            </div>
        </section>
    </main>
</Base>

<script is:inline define:vars={{ bookingTargetUrl: TREATWELL_BOOKING_URL, bookingForwardKeys, treatwellServiceDetailsByService }}>
    (function() {
        var bookingLinks = Array.prototype.slice.call(document.querySelectorAll('[data-booking-link]'));
        var status = document.getElementById('booking-forward-status');
        var offerNote = document.getElementById('booking-forward-offer');
        var currentParams = new URLSearchParams(window.location.search);
        var storedParams = {};
        var trackedOutbound = false;

        try {
            storedParams = JSON.parse(sessionStorage.getItem('bfl_utm') || '{}') || {};
        } catch(e) {
            storedParams = {};
        }

        var target = new URL(bookingTargetUrl);
        var metaCookieMaxAgeSeconds = 90 * 24 * 60 * 60;
        var metaClickIdPattern = /^[A-Za-z0-9._:-]{1,480}$/;
        var metaTestEventCodeStorageKey = 'bfl_meta_test_event_code';
        var metaTestEventCodePattern = /^TEST[A-Za-z0-9_-]{3,64}$/;

        bookingForwardKeys.forEach(function(key) {
            var value = currentParams.get(key);
            if (!value && typeof storedParams[key] === 'string') {
                value = storedParams[key];
            }
            if (value) {
                target.searchParams.set(key, value);
            }
        });

        var currentService = currentParams.get('service') || (typeof storedParams.service === 'string' ? storedParams.service : '');
        var serviceDetailsId = treatwellServiceDetailsByService[currentService];
        if (serviceDetailsId) {
            target.hash = 'serviceDetails=' + encodeURIComponent(serviceDetailsId);
        }

        var href = target.toString();
        bookingLinks.forEach(function(link) {
            link.setAttribute('href', href);
        });

        var offer = currentParams.get('offer') || storedParams.offer || '';
        var price = currentParams.get('price') || storedParams.price || '';
        if (offerNote && offer === 'glow-up-aktion' && price === '169') {
            offerNote.hidden = false;
            offerNote.textContent = 'Glow-Up Aktion: Carbon Peeling + Microneedling für CHF 169 statt CHF 220 wird an Treatwell übergeben.';
        } else if (offerNote && offer === 'aquafacial-microneedling-aktion' && price === '170') {
            offerNote.hidden = false;
            offerNote.textContent = 'Aktion: Aquafacial + Microneedling für CHF 170 statt CHF 250 wird an Treatwell übergeben.';
        }

        function randomId() {
            if (window.crypto && typeof window.crypto.randomUUID === 'function') return window.crypto.randomUUID();
            return String(Date.now()) + '-' + Math.random().toString(36).slice(2);
        }

        function readCookie(name) {
            var encodedName = encodeURIComponent(name) + '=';
            var cookie = document.cookie.split('; ').find(function(part) {
                return part.indexOf(encodedName) === 0;
            });
            return cookie ? decodeURIComponent(cookie.slice(encodedName.length)) : '';
        }

        function writeCookie(name, value, maxAgeSeconds) {
            var secure = window.location.protocol === 'https:' ? '; Secure' : '';
            document.cookie = encodeURIComponent(name) + '=' + encodeURIComponent(value) + '; Max-Age=' + maxAgeSeconds + '; Path=/; SameSite=Lax' + secure;
        }

        function hasMarketingConsent() {
            try {
                return localStorage.getItem('bfl_marketing_consent') === 'granted';
            } catch(e) {
                return false;
            }
        }

        function storedValue(key) {
            return currentParams.get(key) || (typeof storedParams[key] === 'string' ? storedParams[key] : '');
        }

        function metaRandomDigits() {
            if (window.crypto && typeof window.crypto.getRandomValues === 'function') {
                var values = new Uint32Array(2);
                window.crypto.getRandomValues(values);
                return (String(values[0]) + String(values[1])).slice(0, 16);
            }
            return String(Math.floor(Math.random() * 10000000000000000));
        }

        function ensureMetaBrowserIdCookie() {
            var existing = readCookie('_fbp');
            if (existing) return existing;
            if (!hasMarketingConsent()) return '';

            var fbp = 'fb.1.' + Date.now() + '.' + metaRandomDigits();
            writeCookie('_fbp', fbp, metaCookieMaxAgeSeconds);
            return fbp;
        }

        function ensureMetaClickIdCookie() {
            var existing = readCookie('_fbc');
            if (existing) return existing;
            if (!hasMarketingConsent()) return '';

            var fbclid = String(storedValue('fbclid')).trim();
            if (!metaClickIdPattern.test(fbclid)) return '';

            var fbc = 'fb.1.' + Date.now() + '.' + fbclid;
            writeCookie('_fbc', fbc, metaCookieMaxAgeSeconds);
            return fbc;
        }

        function normalizeMetaTestEventCode(value) {
            var code = String(value || '').trim();
            return metaTestEventCodePattern.test(code) ? code : '';
        }

        function getMetaTestEventCode() {
            var fromUrl = normalizeMetaTestEventCode(currentParams.get('test_event_code'));
            if (fromUrl) {
                try {
                    sessionStorage.setItem(metaTestEventCodeStorageKey, fromUrl);
                } catch(e) {}
                return fromUrl;
            }

            try {
                return normalizeMetaTestEventCode(sessionStorage.getItem(metaTestEventCodeStorageKey));
            } catch(e) {
                return '';
            }
        }

        function clean(payload) {
            var output = {};
            Object.keys(payload).forEach(function(key) {
                var value = payload[key];
                if (value !== undefined && value !== null && value !== '') output[key] = value;
            });
            return output;
        }

        function campaignParams() {
            var output = {};
            bookingForwardKeys.forEach(function(key) {
                var value = storedValue(key);
                if (value) output[key] = value;
            });
            return output;
        }

        function postCapi(eventName, eventId, eventData) {
            if (window.location.protocol !== 'https:') return;
            try {
                var userData = {};
                var fbp = ensureMetaBrowserIdCookie();
                var fbc = ensureMetaClickIdCookie();
                if (fbp) userData.fbp = fbp;
                if (fbc) userData.fbc = fbc;

                fetch('/api/track', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    keepalive: true,
                    body: JSON.stringify({
                        event_name: eventName,
                        event_id: eventId,
                        event_source_url: window.location.href,
                        event_data: eventData,
                        user_data: userData,
                        test_event_code: getMetaTestEventCode()
                    })
                }).catch(function() {});
            } catch(e) {}
        }

        function trackOutbound(buttonLocation) {
            if (!hasMarketingConsent()) return;
            if (trackedOutbound) return;
            trackedOutbound = true;

            var service = currentParams.get('service') || storedParams.service || 'not_set';
            var eventId = randomId();
            var scheduleEventId = eventId + '-schedule';
            var eventData = clean({
                event_id: eventId,
                treatment_name: service,
                service: service,
                button_location: buttonLocation || 'booking_hub_treatwell_click',
                page_path: window.location.pathname,
                page_type: 'booking_hub',
                destination_url: href,
                link_domain: target.hostname,
                value: 10,
                currency: 'CHF'
            });
            var dataLayerPayload = clean(Object.assign({}, campaignParams(), eventData, {
                event: 'treatwell_outbound_click'
            }));

            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push(dataLayerPayload);

            if (typeof window.fbq === 'function') {
                window.fbq('trackCustom', 'TreatwellOutboundClick', eventData, { eventID: eventId });
                window.fbq('track', 'Schedule', clean(Object.assign({}, eventData, {
                    event_id: scheduleEventId
                })), { eventID: scheduleEventId });
            }

            postCapi('TreatwellOutboundClick', eventId, {
                treatment_name: eventData.treatment_name,
                service: eventData.service,
                button_location: eventData.button_location,
                page_path: eventData.page_path,
                page_type: eventData.page_type,
                destination_url: eventData.destination_url,
                link_domain: eventData.link_domain,
                value: eventData.value,
                currency: eventData.currency
            });
            postCapi('Schedule', scheduleEventId, {
                treatment_name: eventData.treatment_name,
                service: eventData.service,
                button_location: eventData.button_location,
                page_path: eventData.page_path,
                page_type: eventData.page_type,
                destination_url: eventData.destination_url,
                link_domain: eventData.link_domain,
                value: eventData.value,
                currency: eventData.currency
            });
        }

        function safeTrackOutbound(buttonLocation) {
            try {
                trackOutbound(buttonLocation);
            } catch(e) {}
        }

        bookingLinks.forEach(function(link) {
            link.addEventListener('click', function(event) {
                event.preventDefault();
                safeTrackOutbound(link.getAttribute('data-button-location'));
                if (status) {
                    status.textContent = 'Treatwell wird geöffnet. Ihre Auswahl bleibt, soweit möglich, im Link erhalten.';
                }
                window.setTimeout(function() {
                    window.location.assign(href);
                }, 250);
            }, { capture: true });
        });

        window.setTimeout(function() {
            safeTrackOutbound('booking_hub_auto_redirect');
            window.location.replace(href);
        }, 900);
    })();
</script>

<style>
    .booking-hub-page {
        padding-top: 88px;
    }

    .booking-hub-hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(280px, 0.42fr);
        gap: clamp(36px, 6vw, 76px);
        align-items: center;
        padding-top: clamp(52px, 8vw, 116px);
        padding-bottom: clamp(58px, 8vw, 106px);
    }

    .booking-hub-copy h1,
    .booking-section-heading h2,
    .booking-final-cta h2 {
        text-transform: none;
        letter-spacing: 0;
    }

    .booking-hub-copy h1 {
        max-width: 920px;
        margin: 1rem 0 1.25rem;
        font-size: clamp(2.8rem, 6.4vw, 5.7rem);
        line-height: 0.98;
    }

    .booking-hub-copy > p {
        max-width: 690px;
        color: var(--text-secondary);
        font-size: clamp(17px, 1.4vw, 20px);
        line-height: 1.65;
    }

    .booking-trust-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px 18px;
        max-width: 780px;
        margin: 2rem 0 0;
        padding: 0;
        list-style: none;
    }

    .booking-trust-list li {
        position: relative;
        padding-left: 18px;
        color: var(--ink-2);
        font-size: 15px;
        line-height: 1.5;
    }

    .booking-trust-list li::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0.66em;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--gold);
    }

    .booking-hero-actions,
    .booking-final-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 2.25rem;
    }

    .booking-forward-note,
    .booking-forward-offer {
        max-width: 650px;
        margin-top: 1rem !important;
        font-size: 14px !important;
        color: var(--text-muted) !important;
    }

    .booking-forward-offer {
        color: var(--accent-text) !important;
        font-weight: 650;
    }

    .booking-hub-panel,
    .booking-path-card,
    .booking-process-step,
    .booking-faq-list details {
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-card);
        background: var(--bg-cream);
    }

    .booking-hub-panel {
        padding: clamp(26px, 3vw, 38px);
        box-shadow: var(--shadow-1);
    }

    .booking-panel-kicker,
    .booking-path-number {
        display: block;
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--accent-text);
        margin-bottom: 14px;
    }

    .booking-hub-panel h2 {
        margin: 0 0 12px;
        font-size: clamp(28px, 3vw, 38px);
        line-height: 1.1;
        text-transform: none;
        letter-spacing: 0;
    }

    .booking-hub-panel p {
        color: var(--text-secondary);
        line-height: 1.6;
    }

    .booking-hub-panel dl {
        display: grid;
        gap: 16px;
        margin: 28px 0 0;
    }

    .booking-hub-panel dt {
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--text-muted);
    }

    .booking-hub-panel dd {
        margin: 4px 0 0;
        color: var(--ink);
    }

    .booking-hub-panel a {
        color: inherit;
        text-decoration: underline;
        text-underline-offset: 4px;
    }

    .booking-hub-section {
        padding-top: clamp(58px, 7vw, 92px);
        padding-bottom: clamp(58px, 7vw, 92px);
    }

    .booking-hub-section--soft {
        background: var(--paper-2);
    }

    .booking-section-heading {
        max-width: 760px;
        margin-bottom: 34px;
    }

    .booking-section-heading h2 {
        margin: 0.85rem 0 1rem;
        font-size: clamp(2.15rem, 4vw, 3.8rem);
        line-height: 1.05;
    }

    .booking-section-heading p {
        color: var(--text-secondary);
