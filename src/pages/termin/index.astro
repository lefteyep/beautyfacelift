---

import Base from '../../layouts/Base.astro';
import BookingWidget from '../../components/booking/BookingWidget';

const structuredData = {
    "@context": "https://schema.org",
    "@type": "HealthAndBeautyBusiness",
    "name": "Beauty Face Lift",
    "url": "https://beautyfacelift.ch",
    "telephone": "+41792143462",
    "address": {
        "@type": "PostalAddress",
        "streetAddress": "Bahnhofstrasse 94",
        "addressLocality": "Zürich",
        "postalCode": "8001",
        "addressCountry": "CH"
    },
    "potentialAction": {
        "@type": "ReserveAction",
        "target": {
            "@type": "EntryPoint",
            "urlTemplate": "https://beautyfacelift.ch/termin/"
        },
        "result": {
            "@type": "Reservation",
            "name": "Termin buchen"
        }
    }
};
---

<Base
    title="Termin buchen | Beauty Face Lift Zürich — Online Buchung"
    description="Termin buchen bei Beauty Face Lift Zürich ★ 4.8/5 — Hydrafacial ab CHF 190, Microneedling, Peeling & ColdPlasma. Online Buchung in 3 Klicks. Bahnhofstrasse 94."
    structuredData={structuredData}
>
    <!-- Booking Header — design: centered, 80px 58px 40px -->
    <section style="padding: 80px 58px 40px; text-align: center;">
        <span class="sub-display" style="display: block; margin-bottom: 16px;">Online Buchen</span>
        <h1 style="font-size: 42px; margin-bottom: 16px; text-transform: none;">Termin vereinbaren</h1>
        <p style="max-width: 600px; margin: 0 auto;">Wählen Sie Ihre Behandlung und finden Sie Ihren Wunschtermin — unkompliziert und schnell.</p>
    </section>

    <div class="section-divider"></div>

    <section style="padding: 0 200px 80px;">
        <BookingWidget client:load />
    </section>

    <div class="section-divider"></div>

    <section style="padding: 0 58px 80px; text-align: center;">
        <p style="font-size: 13px; color: var(--text-secondary); max-width: 500px; margin: 0 auto;">Bahnhofstrasse 94 · Samstag Sonderöffnung · Persönliche Betreuung</p>
    </section>
</Base>
