---
interface Fact {
  label: string;
  value: string;
}

interface Props {
  title?: string;
  intro: string;
  facts?: Fact[];
}

const { title = 'Kurz erklärt', intro, facts = [] } = Astro.props;
const headingId = `summary-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<section class="ai-summary container" aria-labelledby={headingId}>
  <div class="ai-summary-inner">
    <div>
      <span class="sub-display">Kurz erklärt</span>
      <h2 id={headingId}>{title}</h2>
      <p>{intro}</p>
    </div>
    {facts.length > 0 && (
      <dl class="ai-summary-facts">
        {facts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
    )}
  </div>
</section>

<style>
  .ai-summary {
    padding-top: 48px;
    padding-bottom: 48px;
  }

  .ai-summary-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
    gap: clamp(24px, 5vw, 64px);
    align-items: start;
    border-top: 1px solid rgba(28, 26, 23, 0.12);
    border-bottom: 1px solid rgba(28, 26, 23, 0.12);
    padding: 32px 0;
  }

  .ai-summary h2 {
    margin: 0 0 16px;
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    text-transform: none;
  }

  .ai-summary p {
    max-width: 68ch;
  }

  .ai-summary-facts {
    display: grid;
    gap: 14px;
    margin: 0;
  }

  .ai-summary-facts div {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 16px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(28, 26, 23, 0.08);
  }

  .ai-summary-facts dt {
    color: var(--text-secondary);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .ai-summary-facts dd {
    margin: 0;
    color: var(--text-primary);
  }

  @media (max-width: 760px) {
    .ai-summary-inner {
      grid-template-columns: 1fr;
    }

    .ai-summary-facts div {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
