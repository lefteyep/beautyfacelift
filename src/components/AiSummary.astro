---
/**
 * "Auf einen Blick" summary: display heading, one short paragraph and
 * label/value facts on hairlines.
 *   variant="band"  — full-width section with its own container (default)
 *   variant="aside" — compact column, e.g. beside a page-hero
 */
interface Fact {
  label: string;
  value: string;
}

interface Props {
  title?: string;
  intro: string;
  facts?: Fact[];
  eyebrow?: string;
  variant?: 'band' | 'aside';
}

const {
  title = 'Kurz erklärt',
  intro,
  facts = [],
  eyebrow = 'Auf einen Blick',
  variant = 'band',
} = Astro.props;
const headingId = `summary-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

{variant === 'aside' ? (
  <aside class="ai-summary ai-summary--aside" aria-labelledby={headingId}>
    <p class="eyebrow">{eyebrow}</p>
    <h2 id={headingId}>{title}</h2>
    <p class="ai-summary-intro">{intro}</p>
    {facts.length > 0 && (
      <dl class="facts">
        {facts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
    )}
  </aside>
) : (
  <section class="ai-summary ai-summary--band" aria-labelledby={headingId}>
    <div class="container">
      <div class="ai-summary-inner">
        <div class="ai-summary-copy">
          <p class="eyebrow eyebrow--rule">{eyebrow}</p>
          <h2 id={headingId}>{title}</h2>
          <p class="ai-summary-intro">{intro}</p>
        </div>
        {facts.length > 0 && (
          <dl class="facts">
            {facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>
    </div>
  </section>
)}

<style>
  .ai-summary--band {
    padding-block: var(--section-y-tight);
  }

  .ai-summary-inner {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(32px, 7vw, 120px);
    align-items: start;
    padding-top: clamp(36px, 4vw, 56px);
    border-top: 1px solid var(--rule);
  }

  .ai-summary-copy {
    display: grid;
    gap: 20px;
  }

  .ai-summary h2 {
    font-size: clamp(1.9rem, 3vw, 2.75rem);
    max-width: 16ch;
  }

  .ai-summary-intro {
    font-size: var(--fs-lead);
    line-height: 1.6;
    max-width: 46ch;
  }

  .ai-summary--aside {
    display: grid;
    gap: 18px;
    align-content: start;
  }

  .ai-summary--aside h2 {
    font-size: var(--fs-h3);
  }

  .ai-summary--aside .ai-summary-intro {
    font-size: var(--fs-body);
  }

  .ai-summary--aside .facts {
    margin-top: 8px;
  }

  @media (max-width: 900px) {
    .ai-summary-inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
