---
import {
  ADDRESS,
  CONTACT_EMAIL,
  CONTACT_PHONE,
  CONTACT_PHONE_DISPLAY,
  CONTACT_WHATSAPP_URL,
  FULL_ADDRESS,
  TREATMENTS,
} from '../../shared/site';
---

<footer class="footer-editorial">
    <div class="footer-editorial-header">
        <span class="sub-display" style="color: var(--text-muted); margin-bottom: 16px; display: block;">{FULL_ADDRESS}</span>
        <h2 class="text-reveal-wrapper"><span class="text-reveal">Beauty Face Lift</span></h2>
    </div>

    <div class="footer-spacer"></div>

    <div class="footer-grid">
        <div class="footer-col">
            <h4>Besuchen Sie uns</h4>
            <p>{ADDRESS.street}</p>
            <p>{ADDRESS.postalCode} {ADDRESS.city}, {ADDRESS.country}</p>
            <p>Paradeplatz und Börsenstrasse in wenigen Minuten zu Fuss.</p>
        </div>
        <div class="footer-col">
            <h4>Kontakt</h4>
            <a href={`tel:${CONTACT_PHONE}`}>{CONTACT_PHONE_DISPLAY}</a>
            <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
            <a href={CONTACT_WHATSAPP_URL} target="_blank" rel="noopener">WhatsApp</a>
            <a href="/kontakt/">Alle Kontaktmöglichkeiten</a>
        </div>
        <div class="footer-col">
            <h4>Buchung</h4>
            <p>Erstberatung, Rückfragen oder Terminänderungen direkt über unsere Kontaktseite.</p>
            <a href="https://buchung.treatwell.ch/ort/beauty-face-lift/" class="pill-btn pill-btn-dark">Termin buchen</a>
        </div>
    </div>

    <div class="footer-links-grid">
        <div>
            <h4>Behandlungen</h4>
            {TREATMENTS.map((treatment) => (
                <a href={treatment.href}>{treatment.label}</a>
            ))}
            <a href="/behandlungen/vergleich/">Behandlungsvergleich</a>
        </div>
        <div>
            <h4>Wissen</h4>
            <a href="/blog/">Blog</a>
            <a href="/haeufige-fragen/">Häufige Fragen</a>
            <a href="/ueber-uns/">Über Teresa</a>
        </div>
        <div>
            <h4>Studio</h4>
            <a href="/kontakt/">Kontakt</a>
            <a href="https://buchung.treatwell.ch/ort/beauty-face-lift/">Termin buchen</a>
            <a href="https://www.instagram.com/beautyfacelift.zh/" target="_blank" rel="noopener">Instagram</a>
        </div>
    </div>

    <div class="footer-bottom">
        <span>&copy; {new Date().getFullYear()} Beauty Face Lift</span>
        <div class="footer-legal">
            <a href="/impressum/">Impressum</a>
            <a href="/datenschutz/">Datenschutz</a>
        </div>
    </div>
</footer>
