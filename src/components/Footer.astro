---
import {
  ADDRESS,
  CONTACT_EMAIL,
  CONTACT_PHONE,
  CONTACT_PHONE_DISPLAY,
  CONTACT_WHATSAPP_URL,
  SERVICE_GROUPS,
  TREATWELL_URL,
} from '../../shared/site';
---

<footer class="footer-editorial">
    <div class="footer-editorial-header">
        <p class="footer-wordmark text-reveal-wrapper" aria-hidden="true"><span class="text-reveal">Beauty Face Lift</span></p>
    </div>

    <div class="footer-grid">
        <div class="footer-col">
            <p class="footer-heading">Studio</p>
            <p>{ADDRESS.street}<br>{ADDRESS.postalCode} {ADDRESS.city}, {ADDRESS.country}</p>
            <p>Wenige Gehminuten vom Hauptbahnhof Zürich.</p>
            <a href="/termin/" class="btn btn-sm" data-button-location="footer_booking_column">Termin buchen</a>
        </div>
        <div class="footer-col">
            <p class="footer-heading">Kontakt</p>
            <a href={`tel:${CONTACT_PHONE}`} data-button-location="footer_phone">{CONTACT_PHONE_DISPLAY}</a>
            <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
            <a href={CONTACT_WHATSAPP_URL} target="_blank" rel="noopener" data-button-location="footer_whatsapp" data-source="footer">WhatsApp</a>
            <a href="/kontakt/">Alle Kontaktmöglichkeiten</a>
        </div>
        <div class="footer-col">
            <p class="footer-heading">Behandlungen</p>
            {SERVICE_GROUPS.map((group) => (
                <a href={group.href}>{group.label}</a>
            ))}
            <a href="/behandlungen/vergleich/">Behandlungsvergleich</a>
        </div>
        <div class="footer-col">
            <p class="footer-heading">Entdecken</p>
            <a href="/blog/">Wissen</a>
            <a href="/haeufige-fragen/">Häufige Fragen</a>
            <a href="/ueber-mich/">Über mich</a>
            <a href="https://www.instagram.com/beautyfacelift.zh/" target="_blank" rel="noopener">Instagram</a>
            <a href={TREATWELL_URL} target="_blank" rel="noopener">Bewertungen auf Treatwell</a>
        </div>
    </div>

    <div class="footer-bottom">
        <span>&copy; {new Date().getFullYear()} Beauty Face Lift · Teresa Stimac</span>
        <div class="footer-legal">
            <a href="/impressum/">Impressum</a>
            <a href="/datenschutz/">Datenschutz</a>
            <a href="#cookie-einstellungen" data-bfl-consent-open>Cookie-Einstellungen</a>
        </div>
    </div>
</footer>
