<footer id="contact" class="footer-editorial">
    <h2 class="text-reveal-wrapper"><span class="text-reveal">Kontakt</span></h2>

    <div class="footer-grid">
        <div class="footer-col">
            <h4>Besuchen Sie uns</h4>
            <p>Bahnhofstrasse 94</p>
            <p>8001 Zürich, CH</p>
        </div>
        <div class="footer-col">
            <h4>Kontakt</h4>
            <a href="tel:+41792143462">+41 79 214 34 62</a>
            <a href="mailto:info@beautyfacelift.ch">info@beautyfacelift.ch</a>
            <a href="https://www.instagram.com/beautyfacelift.zh/" target="_blank" rel="noopener" style="margin-top: 1rem;">Instagram</a>
        </div>
        <div class="footer-col">
            <h4>Buchung</h4>
            <a href="/termin/" class="pill-btn" style="background: white; color: black; border: none; margin-top: 1rem;">Termin buchen</a>
        </div>
    </div>

    <div class="footer-links" style="border-top: 1px solid rgba(237, 235, 230, 0.1); padding-top: 3vw; margin-top: 4vw; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2vw;">
        <div>
            <h4 style="font-family: var(--font-sans); font-size: 0.85rem; color: rgba(237, 235, 230, 0.5); margin-bottom: 1rem;">Behandlungen</h4>
            <a href="/behandlungen/hydrafacial-zuerich/" style="color: var(--text-inverse); display: block; margin-bottom: 0.5rem; font-size: 0.95rem;">Hydrafacial</a>
            <a href="/behandlungen/microneedling-zuerich/" style="color: var(--text-inverse); display: block; margin-bottom: 0.5rem; font-size: 0.95rem;">Microneedling</a>
            <a href="/behandlungen/fruchtsaeure-peeling-zuerich/" style="color: var(--text-inverse); display: block; margin-bottom: 0.5rem; font-size: 0.95rem;">Fruchtsäure Peeling</a>
            <a href="/behandlungen/coldplasma-zuerich/" style="color: var(--text-inverse); display: block; margin-bottom: 0.5rem; font-size: 0.95rem;">ColdPlasma</a>
            <a href="/behandlungen/vergleich/" style="color: var(--text-inverse); display: block; margin-bottom: 0.5rem; font-size: 0.95rem;">Behandlungsvergleich</a>
        </div>
        <div>
            <h4 style="font-family: var(--font-sans); font-size: 0.85rem; color: rgba(237, 235, 230, 0.5); margin-bottom: 1rem;">Wissen</h4>
            <a href="/blog/" style="color: var(--text-inverse); display: block; margin-bottom: 0.5rem; font-size: 0.95rem;">Blog</a>
            <a href="/haeufige-fragen/" style="color: var(--text-inverse); display: block; margin-bottom: 0.5rem; font-size: 0.95rem;">Häufige Fragen</a>
            <a href="/ueber-uns/" style="color: var(--text-inverse); display: block; margin-bottom: 0.5rem; font-size: 0.95rem;">Über Teresa</a>
        </div>
        <div>
            <h4 style="font-family: var(--font-sans); font-size: 0.85rem; color: rgba(237, 235, 230, 0.5); margin-bottom: 1rem;">Bewertungen</h4>
            <a href="https://www.treatwell.ch/ort/beauty-face-lift/" target="_blank" rel="noopener" style="color: var(--text-inverse); display: block; margin-bottom: 0.5rem; font-size: 0.95rem;">Treatwell ★ 4.8/5</a>
        </div>
    </div>

    <div class="footer-bottom">
        <span>&copy; {new Date().getFullYear()} Beauty Face Lift</span>
        <div class="footer-legal">
            <a href="/impressum/">Impressum</a>
            <a href="/datenschutz/">Datenschutz</a>
        </div>
    </div>
</footer>

<!-- Mobile Sticky Booking CTA -->
<a href="/termin/" class="pill-btn mobile-sticky-cta" style="width: calc(100% - 8vw);">Jetzt Termin buchen</a>
