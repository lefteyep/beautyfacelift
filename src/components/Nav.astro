---
import { Image } from 'astro:assets';
import {
  CONTACT_EMAIL,
  CONTACT_PHONE,
  CONTACT_PHONE_DISPLAY,
  FULL_ADDRESS,
  SERVICE_GROUPS,
} from '../../shared/site';
import consultationImage from '../assets/lp/aquafacial/hautanalyse-beratung-zuerich.webp';

interface Props {
  variant?: 'default' | 'treatment';
}

// The luxury system uses one light navigation everywhere; `variant` is kept for API compatibility.
const path = Astro.url.pathname;
const isCurrent = (prefix: string) => path.startsWith(prefix);

// Menu shows plain treatment names ("Waxing", not the SEO anchor "Waxing Zürich"):
// facial treatments in one column, every other service group in the second.
const menuName = (label: string) => label.replace(/\s+Zürich.*$/, '').replace('Fruchtsäure Peeling', 'Fruchtsäure-Peeling');
const [faceGroup, ...beautyGroups] = SERVICE_GROUPS;
const menuColumns = [
  {
    title: faceGroup.label,
    links: faceGroup.services.map((service) => ({ href: service.href, label: menuName(service.label) })),
  },
  {
    title: 'Beauty & Wellness',
    links: beautyGroups.map((group) => ({ href: group.href, label: group.label })),
  },
];
---

<nav class="nav-minimal" data-nav-root aria-label="Hauptnavigation">
    <a href="/" class="nav-brand" aria-label="Beauty Face Lift — Startseite">
        <img src="/assets/logo.png" alt="Beauty Face Lift" class="nav-logo" width="224" height="130">
    </a>

    <ul class="nav-links">
        <li class="nav-dropdown" data-nav-dropdown>
            <div class="nav-dropdown-header">
                <a href="/behandlungen/" class="nav-dropdown-link" aria-current={isCurrent('/behandlungen/') ? 'page' : undefined}>Behandlungen</a>
                <button
                    type="button"
                    class="nav-disclosure"
                    aria-expanded="false"
                    aria-controls="nav-submenu-desktop"
                    data-nav-disclosure
                >
                    <span class="sr-only">Untermenü Behandlungen öffnen</span>
                </button>
            </div>
            <div class="nav-submenu" id="nav-submenu-desktop">
                <div class="nav-menu-grid">
                    {menuColumns.map((column) => (
                        <div class="nav-menu-col">
                            <p class="nav-menu-title">{column.title}</p>
                            <ul>
                                {column.links.map((link) => (
                                    <li><a href={link.href} aria-current={path === link.href ? 'page' : undefined}>{link.label}</a></li>
                                ))}
                            </ul>
                        </div>
                    ))}
                    <a href="/kontakt/" class="nav-menu-feature" data-button-location="nav_menu_consultation">
                        <Image src={consultationImage} width={240} height={300} fit="cover" format="webp" quality="high" loading="lazy" alt="" />
                        <span>Kostenlose Erstberatung</span>
                    </a>
                </div>
                <a href="/behandlungen/" class="nav-menu-all">Übersicht aller Behandlungen</a>
            </div>
        </li>
        <li><a href="/ueber-mich/" aria-current={isCurrent('/ueber-mich/') ? 'page' : undefined}>Über mich</a></li>
        <li><a href="/blog/" aria-current={isCurrent('/blog/') ? 'page' : undefined}>Wissen</a></li>
        <li><a href="/kontakt/" aria-current={isCurrent('/kontakt/') ? 'page' : undefined}>Kontakt</a></li>
    </ul>

    <div class="nav-right">
        <a href="/termin/" class="btn nav-cta" data-button-location="nav_desktop">Termin buchen</a>
    </div>

    <button
        class="nav-hamburger"
        type="button"
        aria-label="Menü öffnen"
        aria-expanded="false"
        aria-controls="nav-mobile-overlay"
        data-nav-toggle
    >
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
    </button>
</nav>

<div
    class="nav-mobile-overlay"
    id="nav-mobile-overlay"
    aria-hidden="true"
    data-nav-overlay
    hidden
    inert
>
    <div class="nav-mobile-content">
        <ul class="nav-mobile-links">
            <li class="nav-mobile-group">
                <div class="nav-mobile-row">
                    <a href="/behandlungen/">Behandlungen</a>
                    <button
                        type="button"
                        class="nav-mobile-disclosure"
                        aria-expanded="false"
                        aria-controls="nav-mobile-treatments"
                        data-nav-mobile-disclosure
                    >
                        <span class="sr-only">Behandlungen in der Mobilnavigation anzeigen</span>
                    </button>
                </div>
                <div class="nav-mobile-submenu" id="nav-mobile-treatments" hidden>
                    {menuColumns.map((column) => (
                        <div class="nav-mobile-sub">
                            <p class="nav-menu-title">{column.title}</p>
                            <ul>
                                {column.links.map((link) => (
                                    <li><a href={link.href}>{link.label}</a></li>
                                ))}
                            </ul>
                        </div>
                    ))}
                    <a href="/behandlungen/" class="nav-menu-all">Übersicht aller Behandlungen</a>
                </div>
            </li>
            <li><a href="/ueber-mich/">Über mich</a></li>
            <li><a href="/blog/">Wissen</a></li>
            <li><a href="/haeufige-fragen/">Häufige Fragen</a></li>
            <li><a href="/kontakt/">Kontakt</a></li>
        </ul>
        <a href="/termin/" class="btn btn-lg nav-mobile-cta" data-button-location="nav_mobile">Termin buchen</a>
        <div class="nav-mobile-contact">
            <a href={`tel:${CONTACT_PHONE}`} data-button-location="nav_mobile_phone">{CONTACT_PHONE_DISPLAY}</a>
            <a href={`mailto:${CONTACT_EMAIL}`} data-button-location="nav_mobile_email">{CONTACT_EMAIL}</a>
            <span>{FULL_ADDRESS}</span>
        </div>
    </div>
</div>

<script>
    const nav = document.querySelector('[data-nav-root]');
    const dropdown = nav?.querySelector<HTMLElement>('[data-nav-dropdown]');
    const desktopDisclosure = nav?.querySelector<HTMLElement>('[data-nav-disclosure]');
    const desktopSubmenu = nav?.querySelector('#nav-submenu-desktop');
    const desktopFirstLink = desktopSubmenu?.querySelector('a');

    const hamburger = document.querySelector<HTMLElement>('[data-nav-toggle]');
    const overlay = document.querySelector<HTMLElement>('[data-nav-overlay]');
    const mobileDisclosure = overlay?.querySelector('[data-nav-mobile-disclosure]');
    const mobileSubmenu = overlay?.querySelector<HTMLElement>('#nav-mobile-treatments');
    const mobileLinks = overlay?.querySelectorAll('a');

    const isDesktop = () => window.matchMedia('(min-width: 901px)').matches;
    const focusableSelector = 'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';

    const setDesktopDropdown = (open: boolean) => {
        if (!dropdown || !desktopDisclosure) return;
        dropdown.classList.toggle('is-open', open);
        desktopDisclosure.setAttribute('aria-expanded', String(open));
    };

    if (dropdown && desktopDisclosure && desktopFirstLink) {
        desktopDisclosure.addEventListener('click', () => {
            if (!isDesktop()) return;
            const shouldOpen = !dropdown.classList.contains('is-open');
            setDesktopDropdown(shouldOpen);
            if (shouldOpen) desktopFirstLink.focus();
        });

        desktopDisclosure.addEventListener('keydown', (event) => {
            if (!isDesktop()) return;
            if (event.key === 'Enter' || event.key === ' ' || event.key === 'ArrowDown') {
                event.preventDefault();
                setDesktopDropdown(true);
                desktopFirstLink.focus();
            }
        });

        dropdown.querySelector<HTMLElement>('.nav-dropdown-link')?.addEventListener('keydown', (event) => {
            if (!isDesktop()) return;
            if (event.key === 'ArrowDown') {
                event.preventDefault();
                setDesktopDropdown(true);
                desktopFirstLink.focus();
            }
        });

        desktopSubmenu?.addEventListener('focusin', () => {
            // A link inside the visible menu got focus (menu open by hover or still fading out):
            // keep it open, so focus is not dropped when the pointer leaves.
            if (isDesktop()) setDesktopDropdown(true);
        });

        dropdown.addEventListener('focusout', (event) => {
            if (!dropdown.contains(event.relatedTarget as Node | null)) {
                setDesktopDropdown(false);
            }
        });

        dropdown.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
                setDesktopDropdown(false);
                dropdown.classList.add('is-dismissed');
                desktopDisclosure.focus();
            }
        });

        dropdown.addEventListener('pointerleave', () => dropdown.classList.remove('is-dismissed'));

        document.addEventListener('pointerdown', (event) => {
            if (isDesktop() && !dropdown.contains(event.target as Node | null)) {
                setDesktopDropdown(false);
            }
        });
    }

    const setBodyLock = (locked: boolean) => {
        document.documentElement.classList.toggle('nav-lock', locked);
        document.body.classList.toggle('nav-lock', locked);
    };

    const getFocusable = (container: HTMLElement) => Array.from(container.querySelectorAll<HTMLElement>(focusableSelector))
        .filter((element) => !element.hasAttribute('hidden') && !element.closest('[hidden]'));

    let closeOverlayTimeout: number | undefined;

    const openOverlay = () => {
        if (!hamburger || !overlay) return;
        window.clearTimeout(closeOverlayTimeout);
        overlay.hidden = false;
        overlay.inert = false;
        overlay.setAttribute('aria-hidden', 'false');
        requestAnimationFrame(() => overlay.classList.add('is-open'));
        nav?.classList.add('is-overlay-open');
        hamburger.classList.add('is-open');
        hamburger.setAttribute('aria-expanded', 'true');
        hamburger.setAttribute('aria-label', 'Menü schliessen');
        setBodyLock(true);
        getFocusable(overlay)[0]?.focus();
    };

    const closeOverlay = (restoreFocus = true) => {
        if (!hamburger || !overlay) return;
        overlay.classList.remove('is-open');
        nav?.classList.remove('is-overlay-open');
        hamburger.classList.remove('is-open');
        hamburger.setAttribute('aria-expanded', 'false');
        hamburger.setAttribute('aria-label', 'Menü öffnen');
        setBodyLock(false);
        closeOverlayTimeout = window.setTimeout(() => {
            overlay.hidden = true;
            overlay.inert = true;
            overlay.setAttribute('aria-hidden', 'true');
        }, 260);
        if (restoreFocus) hamburger.focus();
    };

    if (hamburger && overlay) {
        hamburger.addEventListener('click', () => {
            if (overlay.hidden) openOverlay();
            else closeOverlay(false);
        });

        overlay.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
                event.preventDefault();
                closeOverlay();
                return;
            }

            if (event.key !== 'Tab') return;
            const focusable = getFocusable(overlay);
            if (focusable.length === 0) return;

            const first = focusable[0];
            const last = focusable[focusable.length - 1];

            if (event.shiftKey && document.activeElement === first) {
                event.preventDefault();
                last.focus();
            } else if (!event.shiftKey && document.activeElement === last) {
                event.preventDefault();
                first.focus();
            }
        });

        mobileLinks?.forEach((link) => {
            link.addEventListener('click', () => closeOverlay(false));
        });
    }

    if (mobileDisclosure && mobileSubmenu) {
        mobileDisclosure.addEventListener('click', () => {
            const nextState = mobileSubmenu.hidden;
            mobileSubmenu.hidden = !nextState;
            mobileDisclosure.setAttribute('aria-expanded', String(nextState));
        });
    }

    if (nav) {
        window.addEventListener('scroll', () => {
            nav.classList.toggle('nav-scrolled', window.scrollY > 100);
        }, { passive: true });

        window.addEventListener('resize', () => {
            if (isDesktop() && overlay && !overlay.hidden) {
                closeOverlay(false);
            }
            if (isDesktop()) {
                if (mobileSubmenu) mobileSubmenu.hidden = true;
                mobileDisclosure?.setAttribute('aria-expanded', 'false');
            }
        });
    }
</script>
