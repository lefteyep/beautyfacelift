---
import {
  CONTACT_EMAIL,
  CONTACT_PHONE,
  CONTACT_PHONE_DISPLAY,
  FULL_ADDRESS,
  SERVICE_GROUPS,
} from '../../shared/site';

interface Props {
  variant?: 'default' | 'treatment';
}

const { variant = 'default' } = Astro.props;
const isTreatment = variant === 'treatment';
---

<nav class={`nav-minimal ${isTreatment ? 'nav-treatment' : ''}`} data-nav-root>
    <a href="/" class="nav-brand">
        <img src="/assets/logo.png" alt="Beauty Face Lift" class="nav-logo" width="224" height="130">
    </a>

    <ul class="nav-links">
        <li class="nav-dropdown" data-nav-dropdown>
            <div class="nav-dropdown-header">
                <a href="/behandlungen/" class="nav-dropdown-link">Behandlungen</a>
                <button
                    type="button"
                    class="nav-disclosure"
                    aria-expanded="false"
                    aria-controls="nav-submenu-desktop"
                    data-nav-disclosure
                >
                    <span class="sr-only">Untermenü Behandlungen öffnen</span>
                </button>
            </div>
            <ul class="nav-submenu nav-submenu-grouped" id="nav-submenu-desktop" aria-label="Behandlungen">
                {SERVICE_GROUPS.map((group) => (
                    <li class="nav-submenu-group">
                        <a href={group.href} class="nav-submenu-group-label">{group.label}</a>
                        <ul class="nav-submenu-group-list">
                            {group.services.map((service) => (
                                <li><a href={service.href}>{service.label}</a></li>
                            ))}
                        </ul>
                    </li>
                ))}
            </ul>
        </li>
        <li><a href="/ueber-uns/">Über uns</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="/kontakt/">Kontakt</a></li>
    </ul>

    <a href="/termin/" class="pill-btn nav-cta" data-button-location="nav_desktop">Termin buchen</a>

    <button
        class="nav-hamburger"
        type="button"
        aria-label="Menü öffnen"
        aria-expanded="false"
        aria-controls="nav-mobile-overlay"
        data-nav-toggle
    >
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
    </button>
</nav>

<div
    class="nav-mobile-overlay"
    id="nav-mobile-overlay"
    aria-hidden="true"
    data-nav-overlay
    hidden
    inert
>
    <div class="nav-mobile-content">
        <ul class="nav-mobile-links">
            <li class="nav-mobile-group">
                <div class="nav-mobile-row">
                    <a href="/behandlungen/">Behandlungen</a>
                    <button
                        type="button"
                        class="nav-mobile-disclosure"
                        aria-expanded="false"
                        aria-controls="nav-mobile-treatments"
                        data-nav-mobile-disclosure
                    >
                        <span class="sr-only">Behandlungen in der Mobilnavigation anzeigen</span>
                    </button>
                </div>
                <ul class="nav-mobile-submenu" id="nav-mobile-treatments" hidden>
                    {SERVICE_GROUPS.map((group) => (
                        <li class="nav-mobile-sub nav-mobile-sub-group">
                            <a href={group.href} class="nav-mobile-sub-heading">{group.label}</a>
                            <ul>
                                {group.services.map((service) => (
                                    <li><a href={service.href}>{service.label}</a></li>
                                ))}
                            </ul>
                        </li>
                    ))}
                </ul>
            </li>
            <li><a href="/ueber-uns/">Über uns</a></li>
            <li><a href="/blog/">Blog</a></li>
            <li><a href="/haeufige-fragen/">Häufige Fragen</a></li>
            <li><a href="/kontakt/">Kontakt</a></li>
        </ul>
        <a href="/termin/" class="pill-btn pill-btn-lg nav-mobile-cta" data-button-location="nav_mobile">Jetzt Termin buchen</a>
        <div class="nav-mobile-contact">
            <a href={`tel:${CONTACT_PHONE}`} data-button-location="nav_mobile_phone">{CONTACT_PHONE_DISPLAY}</a>
            <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
            <span>{FULL_ADDRESS}</span>
        </div>
    </div>
</div>

<script>
    const nav = document.querySelector('[data-nav-root]');
    const dropdown = nav?.querySelector('[data-nav-dropdown]');
    const desktopDisclosure = nav?.querySelector('[data-nav-disclosure]');
    const desktopSubmenu = nav?.querySelector('#nav-submenu-desktop');
    const desktopFirstLink = desktopSubmenu?.querySelector('a');

    const hamburger = document.querySelector('[data-nav-toggle]');
    const overlay = document.querySelector('[data-nav-overlay]');
    const mobileDisclosure = overlay?.querySelector('[data-nav-mobile-disclosure]');
    const mobileSubmenu = overlay?.querySelector('#nav-mobile-treatments');
    const mobileLinks = overlay?.querySelectorAll('a');

    const isDesktop = () => window.matchMedia('(min-width: 901px)').matches;
    const focusableSelector = 'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';

    const setDesktopDropdown = (open) => {
        if (!dropdown || !desktopDisclosure) return;
        dropdown.classList.toggle('is-open', open);
        desktopDisclosure.setAttribute('aria-expanded', String(open));
    };

    if (dropdown && desktopDisclosure && desktopFirstLink) {
        desktopDisclosure.addEventListener('click', () => {
            if (!isDesktop()) return;
            const shouldOpen = !dropdown.classList.contains('is-open');
            setDesktopDropdown(shouldOpen);
            if (shouldOpen) desktopFirstLink.focus();
        });

        desktopDisclosure.addEventListener('keydown', (event) => {
            if (!isDesktop()) return;
            if (event.key === 'Enter' || event.key === ' ' || event.key === 'ArrowDown') {
                event.preventDefault();
                setDesktopDropdown(true);
                desktopFirstLink.focus();
            }
        });

        dropdown.querySelector('.nav-dropdown-link')?.addEventListener('keydown', (event) => {
            if (!isDesktop()) return;
            if (event.key === 'ArrowDown') {
                event.preventDefault();
                setDesktopDropdown(true);
                desktopFirstLink.focus();
            }
        });

        dropdown.addEventListener('focusin', () => {
            if (isDesktop()) setDesktopDropdown(true);
        });

        dropdown.addEventListener('focusout', (event) => {
            if (!dropdown.contains(event.relatedTarget)) {
                setDesktopDropdown(false);
            }
        });

        dropdown.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
                setDesktopDropdown(false);
                desktopDisclosure.focus();
            }
        });

        document.addEventListener('pointerdown', (event) => {
            if (isDesktop() && !dropdown.contains(event.target)) {
                setDesktopDropdown(false);
            }
        });
    }

    const setBodyLock = (locked) => {
        document.documentElement.classList.toggle('nav-lock', locked);
        document.body.classList.toggle('nav-lock', locked);
    };

    const getFocusable = (container) => Array.from(container.querySelectorAll(focusableSelector))
        .filter((element) => !element.hasAttribute('hidden') && !element.closest('[hidden]'));

    let closeOverlayTimeout;

    const openOverlay = () => {
        if (!hamburger || !overlay) return;
        window.clearTimeout(closeOverlayTimeout);
        overlay.hidden = false;
        overlay.inert = false;
        overlay.setAttribute('aria-hidden', 'false');
        requestAnimationFrame(() => overlay.classList.add('is-open'));
        nav?.classList.add('is-overlay-open');
        hamburger.classList.add('is-open');
        hamburger.setAttribute('aria-expanded', 'true');
        hamburger.setAttribute('aria-label', 'Menü schliessen');
        setBodyLock(true);
        getFocusable(overlay)[0]?.focus();
    };

    const closeOverlay = (restoreFocus = true) => {
        if (!hamburger || !overlay) return;
        overlay.classList.remove('is-open');
        nav?.classList.remove('is-overlay-open');
        hamburger.classList.remove('is-open');
        hamburger.setAttribute('aria-expanded', 'false');
        hamburger.setAttribute('aria-label', 'Menü öffnen');
        setBodyLock(false);
        closeOverlayTimeout = window.setTimeout(() => {
            overlay.hidden = true;
            overlay.inert = true;
            overlay.setAttribute('aria-hidden', 'true');
        }, 260);
        if (restoreFocus) hamburger.focus();
    };

    if (hamburger && overlay) {
        hamburger.addEventListener('click', () => {
            if (overlay.hidden) openOverlay();
            else closeOverlay(false);
        });

        overlay.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
                event.preventDefault();
                closeOverlay();
                return;
            }

            if (event.key !== 'Tab') return;
            const focusable = getFocusable(overlay);
            if (focusable.length === 0) return;

            const first = focusable[0];
            const last = focusable[focusable.length - 1];

            if (event.shiftKey && document.activeElement === first) {
                event.preventDefault();
                last.focus();
            } else if (!event.shiftKey && document.activeElement === last) {
                event.preventDefault();
                first.focus();
            }
        });

        mobileLinks?.forEach((link) => {
            link.addEventListener('click', () => closeOverlay(false));
        });
    }

    if (mobileDisclosure && mobileSubmenu) {
        mobileDisclosure.addEventListener('click', () => {
            const nextState = mobileSubmenu.hidden;
            mobileSubmenu.hidden = !nextState;
            mobileDisclosure.setAttribute('aria-expanded', String(nextState));
        });
    }

    if (nav) {
        window.addEventListener('scroll', () => {
            nav.classList.toggle('nav-scrolled', window.scrollY > 100);
        }, { passive: true });

        window.addEventListener('resize', () => {
            if (isDesktop() && overlay && !overlay.hidden) {
                closeOverlay(false);
            }
            if (isDesktop()) {
                if (mobileSubmenu) mobileSubmenu.hidden = true;
                mobileDisclosure?.setAttribute('aria-expanded', 'false');
            }
        });
    }
</script>
