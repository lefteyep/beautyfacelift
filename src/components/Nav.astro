---
interface Props {
  variant?: 'default' | 'treatment';
}

const { variant = 'default' } = Astro.props;
const isTreatment = variant === 'treatment';

const treatments = [
  { href: '/behandlungen/hydrafacial-zuerich/',         label: 'Hydrafacial' },
  { href: '/behandlungen/microneedling-zuerich/',       label: 'Microneedling' },
  { href: '/behandlungen/fruchtsaeure-peeling-zuerich/', label: 'Fruchtsäure Peeling' },
  { href: '/behandlungen/coldplasma-zuerich/',          label: 'ColdPlasma' },
];
---

<nav class={`nav-minimal ${isTreatment ? 'nav-treatment' : ''}`}>
    <a href="/" class="nav-brand">
        <img src="/assets/logo.png" alt="Beauty Face Lift" class="nav-logo" width="224" height="130">
    </a>
    <ul class="nav-links">
        <li class="nav-dropdown">
            <a href="/behandlungen/" class="nav-dropdown-trigger" aria-haspopup="true" aria-expanded="false">Behandlungen</a>
            <ul class="nav-submenu" role="menu">
                {treatments.map(t => (
                    <li role="none"><a href={t.href} role="menuitem">{t.label}</a></li>
                ))}
            </ul>
        </li>
        <li><a href="/ueber-uns/">Über uns</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="/#contact">Kontakt</a></li>
    </ul>
    <a href="/termin/" class="pill-btn nav-cta">Termin buchen</a>

    <!-- Mobile Hamburger -->
    <button class="nav-hamburger" aria-label="Menü öffnen" aria-expanded="false">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
    </button>
</nav>

<!-- Mobile Overlay -->
<div class="nav-mobile-overlay" aria-hidden="true">
    <div class="nav-mobile-content">
        <ul class="nav-mobile-links">
            <li><a href="/behandlungen/">Behandlungen</a></li>
            {treatments.map(t => (
                <li class="nav-mobile-sub"><a href={t.href}>{t.label}</a></li>
            ))}
            <li><a href="/ueber-uns/">Über uns</a></li>
            <li><a href="/blog/">Blog</a></li>
            <li><a href="/haeufige-fragen/">Häufige Fragen</a></li>
            <li><a href="/#contact">Kontakt</a></li>
        </ul>
        <a href="/termin/" class="pill-btn pill-btn-lg nav-mobile-cta">Jetzt Termin buchen</a>
        <div class="nav-mobile-contact">
            <a href="tel:+41792143462">+41 79 214 34 62</a>
            <a href="mailto:info@beautyfacelift.ch">info@beautyfacelift.ch</a>
            <span>Bahnhofstrasse 94, 8001 Zürich</span>
        </div>
    </div>
</div>

<script>
    const hamburger = document.querySelector('.nav-hamburger');
    const overlay = document.querySelector('.nav-mobile-overlay');
    const nav = document.querySelector('.nav-minimal');

    if (hamburger && overlay) {
        hamburger.addEventListener('click', () => {
            const isOpen = hamburger.classList.toggle('is-open');
            overlay.classList.toggle('is-open');
            hamburger.setAttribute('aria-expanded', String(isOpen));
            overlay.setAttribute('aria-hidden', String(!isOpen));
            document.body.style.overflow = isOpen ? 'hidden' : '';
        });

        // Close on link click
        overlay.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', () => {
                hamburger.classList.remove('is-open');
                overlay.classList.remove('is-open');
                hamburger.setAttribute('aria-expanded', 'false');
                overlay.setAttribute('aria-hidden', 'true');
                document.body.style.overflow = '';
            });
        });
    }

    // Scroll-aware nav background
    if (nav) {
        window.addEventListener('scroll', () => {
            nav.classList.toggle('nav-scrolled', window.scrollY > 100);
        }, { passive: true });
    }

    // Desktop dropdown: keyboard + click-to-open on touch devices.
    const dropdownTrigger = document.querySelector('.nav-dropdown-trigger');
    const dropdown = document.querySelector('.nav-dropdown');
    if (dropdownTrigger && dropdown) {
        const setOpen = (open) => {
            dropdown.classList.toggle('is-open', open);
            dropdownTrigger.setAttribute('aria-expanded', String(open));
        };
        // Hover already works via CSS. Add focus-within + keyboard:
        dropdown.addEventListener('focusin',  () => setOpen(true));
        dropdown.addEventListener('focusout', (e) => {
            if (!dropdown.contains(e.relatedTarget)) setOpen(false);
        });
        dropdownTrigger.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                setOpen(true);
                const first = dropdown.querySelector('.nav-submenu a');
                first && first.focus();
            }
        });
        dropdown.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                setOpen(false);
                dropdownTrigger.focus();
            }
        });
    }
</script>
