---
interface Props {
  variant?: 'default' | 'treatment';
}

const { variant = 'default' } = Astro.props;
const isTreatment = variant === 'treatment';
---

<nav class={`nav-minimal ${isTreatment ? 'nav-treatment' : ''}`}>
    <a href="/" class="nav-brand">
        <img src="/assets/beautyfacelift-zurich-kosmetikstudio-logo.png" alt="Beauty Face Lift Zürich" style="height: 50px; width: auto;">
    </a>
    <ul class="nav-links">
        <li><a href="/behandlungen/">Behandlungen</a></li>
        <li><a href="/ueber-uns/">Über uns</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="/#contact">Kontakt</a></li>
    </ul>
    <a href="/termin/" class="pill-btn nav-cta">Termin buchen</a>

    <!-- Mobile Hamburger -->
    <button class="nav-hamburger" aria-label="Menü öffnen" aria-expanded="false">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
    </button>
</nav>

<!-- Mobile Overlay -->
<div class="nav-mobile-overlay" aria-hidden="true">
    <div class="nav-mobile-content">
        <ul class="nav-mobile-links">
            <li><a href="/behandlungen/">Behandlungen</a></li>
            <li><a href="/ueber-uns/">Über uns</a></li>
            <li><a href="/blog/">Blog</a></li>
            <li><a href="/#contact">Kontakt</a></li>
        </ul>
        <a href="/termin/" class="pill-btn nav-mobile-cta">Termin buchen</a>
    </div>
</div>

<script>
    const hamburger = document.querySelector('.nav-hamburger');
    const overlay = document.querySelector('.nav-mobile-overlay');
    const nav = document.querySelector('.nav-minimal');

    if (hamburger && overlay) {
        hamburger.addEventListener('click', () => {
            const isOpen = hamburger.classList.toggle('is-open');
            overlay.classList.toggle('is-open');
            hamburger.setAttribute('aria-expanded', String(isOpen));
            overlay.setAttribute('aria-hidden', String(!isOpen));
            document.body.style.overflow = isOpen ? 'hidden' : '';
        });

        // Close on link click
        overlay.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', () => {
                hamburger.classList.remove('is-open');
                overlay.classList.remove('is-open');
                hamburger.setAttribute('aria-expanded', 'false');
                overlay.setAttribute('aria-hidden', 'true');
                document.body.style.overflow = '';
            });
        });
    }

    // Scroll-aware nav background
    if (nav) {
        window.addEventListener('scroll', () => {
            nav.classList.toggle('nav-scrolled', window.scrollY > 100);
        }, { passive: true });
    }
</script>
