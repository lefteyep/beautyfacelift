---
import { CONTACT_WHATSAPP_URL } from '../../shared/site';

interface Props {
    treatment: string;
    href?: string;
}

const {
    treatment,
    href = '/termin/',
} = Astro.props;
---

<section class="treatment-action-bar container" aria-label={`${treatment} Termin und Beratung`}>
    <div class="treatment-action-copy">
        <span class="sub-display">Behandlung planen</span>
        <p>{treatment} an der Bahnhofstrasse 94 in Zürich. Wir stimmen Hautzustand, Ziel und Ablauf persönlich ab, damit die Behandlung zur Haut passt.</p>
    </div>
    <div class="treatment-action-buttons">
        <a href={href} class="pill-btn" data-treatment={treatment} data-button-location="treatment_action_bar">Termin buchen</a>
        <a
            href={CONTACT_WHATSAPP_URL}
            class="pill-btn pill-btn-outline"
            target="_blank"
            rel="noopener"
            data-treatment={treatment}
            data-button-location="treatment_action_bar_whatsapp"
            data-source="treatment_action_bar"
        >
            Frage per WhatsApp
        </a>
    </div>
</section>
