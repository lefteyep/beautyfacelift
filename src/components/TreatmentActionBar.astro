---
/**
 * Legacy booking bar. Treatment pages no longer render it under the hero
 * (TreatmentHero + BookingCta carry the CTA); kept for any remaining imports.
 */
import { CONTACT_WHATSAPP_URL } from '../../shared/site';

interface Props {
    treatment: string;
    href?: string;
}

const {
    treatment,
    href = '/termin/',
} = Astro.props;
---

<section class="treatment-action-bar container" aria-label={`${treatment} Termin und Beratung`}>
    <div class="treatment-action-copy">
        <span class="eyebrow">Behandlung planen</span>
        <p>{treatment} an der Bahnhofstrasse 94 in Zürich. Wir stimmen Hautzustand, Ziel und Ablauf persönlich ab, damit die Behandlung zur Haut passt.</p>
    </div>
    <div class="btn-row">
        <a href={href} class="btn" data-treatment={treatment} data-button-location="treatment_action_bar">Termin buchen</a>
        <a
            href={CONTACT_WHATSAPP_URL}
            class="btn-link"
            target="_blank"
            rel="noopener"
            data-treatment={treatment}
            data-button-location="treatment_action_bar_whatsapp"
            data-source="treatment_action_bar"
        >
            Frage per WhatsApp
        </a>
    </div>
</section>

<style>
    .treatment-action-bar {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: 24px clamp(32px, 6vw, 96px);
        padding-block: 32px;
        border-top: 1px solid var(--rule);
        border-bottom: 1px solid var(--rule);
    }

    .treatment-action-copy {
        display: grid;
        gap: 10px;
        max-width: 620px;
    }

    .treatment-action-copy p {
        margin: 0;
        font-size: var(--fs-small);
        color: var(--taupe);
    }

    @media (max-width: 900px) {
        .treatment-action-bar {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
