    gap: 1rem;
    align-items: center;
    max-width: 1080px;
    margin: 0 auto;
    padding: 1rem;
    background: rgba(246, 241, 234, 0.98);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-medium);
    color: var(--text-primary);
  }

  .marketing-consent[hidden] {
    display: none;
  }

  .marketing-consent p {
    margin: 0;
    max-width: none;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .marketing-consent p a {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }

  .marketing-consent-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.6rem;
  }

  .marketing-consent-actions .pill-btn {
    min-height: 42px;
    padding: 10px 18px;
    font-size: 0.68rem;
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .marketing-consent {
      bottom: calc(1rem + var(--lp-sticky-offer-height, 0px) + env(safe-area-inset-bottom, 0px));
      grid-template-columns: 1fr;
      align-items: stretch;
    }

    .marketing-consent-actions {
      justify-content: flex-start;
    }
  }

  /* Phones: keep the banner to roughly a quarter of the viewport so the hero price and CTA stay visible. */
  @media (max-width: 560px) {
    .marketing-consent {
      left: 0.5rem;
      right: 0.5rem;
      bottom: calc(0.5rem + var(--lp-sticky-offer-height, 0px) + env(safe-area-inset-bottom, 0px));
      gap: 0.65rem;
      padding: 0.75rem 0.85rem;
    }

    .marketing-consent p {
