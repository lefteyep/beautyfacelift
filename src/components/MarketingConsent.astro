<div id="bfl-marketing-consent" class="marketing-consent" role="dialog" aria-label="Cookie-Einstellungen" hidden>
  <p>
    Wir verwenden Marketing-Cookies nur mit Ihrer Einwilligung, um Kampagnen zu messen
    und relevante Anzeigen auszuspielen. <a href="/datenschutz/">Datenschutz</a>
  </p>
  <div class="marketing-consent-actions">
    <button type="button" class="pill-btn" data-bfl-consent-accept>Marketing akzeptieren</button>
    <button type="button" class="pill-btn pill-btn-outline" data-bfl-consent-deny>Ablehnen</button>
  </div>
</div>

<script is:inline>
  (function() {
    var key = 'bfl_marketing_consent';
    var banner = document.getElementById('bfl-marketing-consent');
    if (!banner) return;

    function choice() {
      try { return localStorage.getItem(key) || ''; } catch(e) { return ''; }
    }

    function hide() {
      banner.hidden = true;
      document.body.classList.remove('bfl-consent-visible');
      document.body.classList.add('bfl-consent-hidden');
    }

    function show() {
      banner.hidden = false;
      document.body.classList.add('bfl-consent-visible');
      document.body.classList.remove('bfl-consent-hidden');
    }

    function clearMetaCookies() {
      ['_fbp', '_fbc'].forEach(function(name) {
        document.cookie = name + '=; Max-Age=0; Path=/; SameSite=Lax';
      });
    }

    function setChoice(value) {
      var previous = choice();
      try { localStorage.setItem(key, value); } catch(e) {}
      hide();
      if (value !== 'granted' && previous === 'granted') {
        // The Meta pixel cannot be unloaded once running; reload so revocation takes effect immediately.
        clearMetaCookies();
        window.location.reload();
        return;
      }
      window.dispatchEvent(new CustomEvent(
        value === 'granted' ? 'bfl:marketing-consent-granted' : 'bfl:marketing-consent-denied'
      ));
    }

    var accept = banner.querySelector('[data-bfl-consent-accept]');
    var deny = banner.querySelector('[data-bfl-consent-deny]');
    if (accept) accept.addEventListener('click', function() { setChoice('granted'); });
    if (deny) deny.addEventListener('click', function() { setChoice('denied'); });

    // Any element with data-bfl-consent-open (e.g. the footer "Cookie-Einstellungen" link) reopens the banner.
    document.addEventListener('click', function(event) {
      var trigger = event.target instanceof Element ? event.target.closest('[data-bfl-consent-open]') : null;
      if (!trigger) return;
      event.preventDefault();
      show();
      if (accept) accept.focus();
    });

    if (!choice()) {
      show();
      return;
    }

    hide();
    if (choice() === 'granted') {
      window.setTimeout(function() {
        window.dispatchEvent(new CustomEvent('bfl:marketing-consent-granted'));
      }, 0);
    }
  })();
</script>

<style>
  .marketing-consent {
    position: fixed;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    z-index: 80;
    display: grid;
