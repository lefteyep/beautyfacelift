    }

    .marketing-consent-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
    }

    .marketing-consent-actions .pill-btn {
      min-height: 40px;
      padding: 8px 10px;
      font-size: 0.62rem;
    }
  }
</style>
