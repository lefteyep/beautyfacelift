---
import { bookingLinkForService } from '../../shared/site';

interface Props {
  treatment?: string;
  href?: string;
  title?: string;
  text?: string;
  ctaText?: string;
}

const {
  treatment,
  href,
  title = treatment ? `${treatment} an der Bahnhofstrasse` : 'Ihr Termin an der Bahnhofstrasse',
  text = 'Buchen Sie Ihren Wunschtermin bequem online. Teresa klärt Details und Eignung vor der Behandlung persönlich mit Ihnen.',
  ctaText = 'Termin buchen',
} = Astro.props;

const bookingHref = href || bookingLinkForService(treatment);
---

<section class="booking-cta" aria-label={title}>
  <div class="booking-cta-copy">
    <h2>{title}</h2>
    <p>{text}</p>
  </div>
  <div class="booking-cta-actions">
    <a
      href={bookingHref}
      class="btn"
      data-treatment={treatment}
      data-button-location="booking_cta"
    >
      {ctaText}
    </a>
    <a
      href="https://wa.me/41792143462?text=Guten%20Tag%2C%20ich%20habe%20eine%20Frage%20zu%20einer%20Behandlung%20bei%20Beauty%20Face%20Lift."
      class="btn-link"
      target="_blank"
      rel="noopener"
      data-treatment={treatment}
      data-button-location="booking_cta_whatsapp"
      data-source="booking_cta"
    >
      Frage per WhatsApp
    </a>
  </div>
</section>

<style>
  .booking-cta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 32px clamp(32px, 6vw, 96px);
    padding: clamp(40px, 6vw, 80px) clamp(24px, 5vw, 72px);
    background: var(--sand);
  }

  .booking-cta-copy {
    display: grid;
    gap: 18px;
  }

  .booking-cta h2 {
    font-size: var(--fs-h2);
    max-width: 18ch;
  }

  .booking-cta p {
    max-width: 52ch;
  }

  .booking-cta-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  @media (max-width: 760px) {
    .booking-cta {
      grid-template-columns: minmax(0, 1fr);
    }

    .booking-cta-actions .btn {
      width: 100%;
    }
  }
</style>
