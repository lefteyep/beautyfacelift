---
import { bookingLinkForService } from '../../shared/site';

interface Props {
  treatment?: string;
  href?: string;
  eyebrow?: string;
  title?: string;
  text?: string;
  ctaText?: string;
  whatsappHref?: string;
  whatsappText?: string;
}

const {
  treatment,
  href,
  eyebrow = 'Online buchen',
  title = treatment ? `${treatment} Termin buchen` : 'Termin buchen',
  text = 'Die Online-Buchung läuft vorübergehend über Treatwell. Ihre Auswahl wird mit Kampagnen- und Behandlungsangaben übergeben.',
  ctaText = 'Termin buchen',
  whatsappHref = 'https://wa.me/41792143462?text=Guten%20Tag%2C%20ich%20habe%20eine%20Frage%20zu%20einer%20Behandlung%20bei%20Beauty%20Face%20Lift.',
  whatsappText = 'Frage per WhatsApp',
} = Astro.props;

const bookingHref = href || bookingLinkForService(treatment);
---

<div class="booking-cta">
  <span class="booking-cta-kicker">{eyebrow}</span>
  <h2>{title}</h2>
  <p>{text}</p>
  <div class="booking-cta-actions">
    <a
      href={bookingHref}
      class="pill-btn"
      data-treatment={treatment}
      data-button-location="booking_cta"
    >
      {ctaText}
    </a>
    <a
      href={whatsappHref}
      class="pill-btn pill-btn-outline"
      target="_blank"
      rel="noopener"
      data-treatment={treatment}
      data-button-location="booking_cta_whatsapp"
      data-source="booking_cta"
    >
      {whatsappText}
    </a>
  </div>
</div>
