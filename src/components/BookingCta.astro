---
/**
 * Booking panel: heading, one line, booking + WhatsApp buttons.
 *   default      — light shell panel, copy left and buttons right
 *   image + alt  — dark panel with a photo beside the copy (treatment pages)
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { bookingLinkForService, CONTACT_WHATSAPP_URL } from '../../shared/site';
import { cardImageSizes, widthsFor } from './treatment/images';

interface Props {
  treatment?: string;
  href?: string;
  title?: string;
  text?: string;
  ctaText?: string;
  image?: ImageMetadata;
  alt?: string;
}

const {
  treatment,
  href,
  title = treatment ? `${treatment} an der Bahnhofstrasse` : 'Ihr Termin an der Bahnhofstrasse',
  text = 'Buchen Sie Ihren Wunschtermin bequem online. Teresa klärt Details und Eignung vor der Behandlung persönlich mit Ihnen.',
  ctaText = 'Termin buchen',
  image,
  alt = '',
} = Astro.props;

const bookingHref = href || bookingLinkForService(treatment);
---

<section class:list={['booking-cta', image ? 'booking-cta--media' : 'booking-cta--plain']} aria-label={title}>
  {image && (
    <div class="booking-cta-media">
      <Image
        src={image}
        widths={widthsFor(image)}
        sizes={cardImageSizes(image, 1, 560, 42, 92)}
        format="webp"
        quality="mid"
        loading="lazy"
        alt={alt}
      />
    </div>
  )}
  <div class="booking-cta-copy">
    <h2>{title}</h2>
    <p>{text}</p>
  </div>
  <div class="booking-cta-actions btn-row">
    <a
      href={bookingHref}
      class="btn btn-arrow"
      data-treatment={treatment}
      data-button-location="booking_cta"
    >{ctaText}</a>
    <a
      href={CONTACT_WHATSAPP_URL}
      class="btn btn-secondary"
      target="_blank"
      rel="noopener"
      data-treatment={treatment}
      data-button-location="booking_cta_whatsapp"
      data-source="booking_cta"
    >Frage per WhatsApp</a>
  </div>
</section>

<style>
  .booking-cta {
    display: grid;
    border-radius: var(--r-xl);
  }

  .booking-cta h2 {
    font-size: clamp(2.1rem, 3.6vw, 3.25rem);
    max-width: 16ch;
  }

  .booking-cta p {
    max-width: 46ch;
  }

  /* Light panel: copy left, buttons bottom right */
  .booking-cta--plain {
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 28px clamp(32px, 6vw, 96px);
    padding: clamp(36px, 5vw, 72px) clamp(24px, 5vw, 72px);
    background: var(--shell);
  }

  .booking-cta-copy {
    display: grid;
    gap: 16px;
  }

  /* Dark panel with photo, as the homepage's first-visit band */
  .booking-cta--media {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: 1fr auto;
    column-gap: clamp(32px, 5vw, 80px);
    row-gap: 28px;
    align-items: end;
    padding: clamp(16px, 2vw, 24px);
    padding-right: clamp(24px, 5vw, 80px);
    background: var(--cocoa);
    color: var(--on-dark);
  }

  .booking-cta-media {
    grid-row: 1 / 3;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: calc(var(--r-xl) - 10px);
    background: var(--cocoa-2);
  }

  .booking-cta-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .booking-cta--media .booking-cta-copy {
    align-self: end;
  }

  .booking-cta--media .booking-cta-actions {
    align-self: start;
    padding-bottom: clamp(8px, 2vw, 24px);
  }

  .booking-cta--media h2 { color: var(--cream); }
  .booking-cta--media p { color: var(--on-dark); }

  .booking-cta--media :global(.btn-secondary) {
    --btn-bg: transparent;
    --btn-fg: var(--cream);
    --btn-border: rgba(255, 253, 251, 0.32);
    --btn-bg-hover: rgba(255, 253, 251, 0.1);
    --btn-fg-hover: var(--cream);
    --btn-border-hover: rgba(255, 253, 251, 0.5);
  }

  @media (max-width: 900px) {
    .booking-cta--plain,
    .booking-cta--media {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
    }

    .booking-cta--media {
      padding: 12px 12px 28px;
    }

    .booking-cta-media {
      grid-row: auto;
      aspect-ratio: 4 / 3;
    }

    .booking-cta--media .booking-cta-copy,
    .booking-cta--media .booking-cta-actions {
      padding-inline: 12px;
    }

    .booking-cta--media .booking-cta-actions {
      padding-bottom: 0;
    }

    .booking-cta-actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
