---
import { bookingLinkForService, absoluteUrl } from '../../shared/site';
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import AiSummary from './AiSummary.astro';
import BookingCta from './BookingCta.astro';
import PriceMenu from './treatment/PriceMenu.astro';
import LinkList from './treatment/LinkList.astro';

interface Fact {
  label: string;
  value: string;
}

interface PriceItem {
  label: string;
  price: string;
  duration: string;
  note: string;
}

interface RelatedLink {
  href: string;
  title: string;
  description: string;
}

interface Props {
  title: string;
  description: string;
  h1: string;
  intro: string[];
  summaryTitle: string;
  summaryIntro: string;
  facts: Fact[];
  serviceType: string;
  bookingService: string;
  priceItems: PriceItem[];
  suitedFor: string[];
  process: string[];
  expectations: string;
  contraindications: string;
  related: RelatedLink[];
}

const {
  title,
  description,
  h1,
  intro,
  summaryTitle,
  summaryIntro,
  facts,
  serviceType,
  bookingService,
  priceItems,
  suitedFor,
  process,
  expectations,
  contraindications,
  related,
} = Astro.props;

const bookingHref = bookingLinkForService(bookingService);
const currentPath = Astro.url.pathname;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: h1,
  serviceType,
  category: 'Kosmetische Behandlung',
  url: absoluteUrl(currentPath),
  areaServed: 'Zürich',
  provider: {
    '@type': 'BeautySalon',
    name: 'Beauty Face Lift Zürich',
    url: absoluteUrl('/'),
    telephone: '+41792143462',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Bahnhofstrasse 94',
      addressLocality: 'Zürich',
      postalCode: '8001',
      addressCountry: 'CH',
    },
  },
  description,
};

// "Waxing Zürich – professionelle Haarentfernung …" → large name with one
// copper accent (its last word) above a quieter display sub-line.
const [h1Name, ...h1Rest] = h1.split(' – ');
const h1Sub = h1Rest.join(' – ');
const h1Words = h1Name.split(' ');
const h1Accent = h1Words.pop();
const h1Lead = h1Words.join(' ');

const [leadParagraph, ...moreIntro] = intro;
const capitalize = (text: string) => text.charAt(0).toUpperCase() + text.slice(1);
const prices = priceItems.map((item) => ({
  name: item.label,
  duration: item.duration,
  price: item.price,
  note: item.note,
}));
const relatedLinks = related.map((link) => ({ href: link.href, title: link.title, text: link.description }));
---

<Base title={title} description={description} structuredData={structuredData}>
  <header class="page-hero page-hero--split hub-hero">
    <div class="container page-hero-inner">
      <div class="page-hero-copy">
        <div class="reveal-up">
          <Breadcrumbs items={[
            { label: 'Home', href: '/' },
            { label: 'Behandlungen', href: '/behandlungen/' },
            { label: h1, display: h1Name },
          ]} />
        </div>
        <h1 class="hub-title reveal-up d-2">
          {h1Lead} <em>{h1Accent}</em>{h1Sub && (
            <span class="hub-title-sub"><span class="sr-only"> – </span>{h1Sub}</span>
          )}
        </h1>
        <p class="lead reveal-up d-3">{leadParagraph}</p>
        {moreIntro.map((paragraph) => <p class="reveal-up d-3">{paragraph}</p>)}
        <div class="btn-row reveal-up d-4">
          <a href={bookingHref} class="btn">Termin buchen</a>
          <a href="/kontakt/" class="btn-link">Beratung anfragen</a>
        </div>
      </div>
      <div class="hub-summary reveal-up d-5">
        <AiSummary variant="aside" title={summaryTitle} intro={summaryIntro} facts={facts} />
      </div>
    </div>
  </header>

  <section class="section section--ivory" aria-label="Preise und Dauer">
    <div class="container">
      <PriceMenu items={prices}>
        <Fragment slot="title">Preise &amp; <em>Dauer</em></Fragment>
      </PriceMenu>
    </div>
  </section>

  <section class="section" aria-labelledby="hub-details-title">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 id="hub-details-title">Was Sie <em>erwartet</em></h2>
        </div>
      </div>
      <div class="index-grid index-grid--2 hub-details">
        <div class="scroll-anim">
          <h3>Geeignet für</h3>
          <ul class="hub-list">
            {suitedFor.map((item) => <li>{capitalize(item)}</li>)}
          </ul>
        </div>
        <div class="scroll-anim">
          <h3>Ablauf</h3>
          <ol class="hub-process">
            {process.map((step) => <li>{step}</li>)}
          </ol>
        </div>
        <div class="scroll-anim">
          <h3>Realistische Erwartungen</h3>
          <p>{expectations}</p>
        </div>
        <div class="scroll-anim">
          <h3>Wichtig vor dem Termin</h3>
          <p>{contraindications}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight section--flush-top" id="buchen">
    <div class="container">
      <BookingCta
        treatment={bookingService}
        href={bookingHref}
        title={`${serviceType} an der Bahnhofstrasse`}
        text="Buchen Sie Ihren Wunschtermin bequem online. Teresa klärt Details und Eignung vor der Behandlung persönlich mit Ihnen."
      />
    </div>
  </section>

  <section class="section section--tight section--rule" aria-labelledby="hub-related-title">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 id="hub-related-title">Weitere <em>Empfehlungen</em></h2>
        </div>
        <a href="/behandlungen/" class="btn-link">Alle Behandlungen</a>
      </div>
      <LinkList items={relatedLinks} />
    </div>
  </section>
</Base>

<style>
  .d-1 { --d: 1; }
  .d-2 { --d: 2; }
  .d-3 { --d: 3; }
  .d-4 { --d: 4; }
  .d-5 { --d: 5; }

  .hub-hero .page-hero-copy :global(.breadcrumbs) {
    padding: 0;
  }

  .hub-hero .page-hero-inner {
    align-items: end;
  }

  .hub-title {
    max-width: 14ch;
    overflow-wrap: break-word;
    hyphens: auto;
    -webkit-hyphens: auto;
  }

  @media (max-width: 600px) {
    /* Long single words ("Gesichtsbehandlung") must fit 390px screens */
    .hub-title {
      max-width: none;
      font-size: clamp(2rem, 9.2vw, 2.6rem);
    }
  }

  .hub-title-sub {
    display: block;
    max-width: 26ch;
    margin-top: 18px;
    font-size: var(--fs-h3);
    line-height: 1.25;
    letter-spacing: -0.005em;
    color: var(--umber);
  }

  .page-hero-copy .btn-row {
    margin-top: 8px;
  }

  .hub-details h3 {
    margin-bottom: 4px;
  }

  .hub-list {
    display: grid;
    gap: 8px;
  }

  .hub-list li {
    display: flex;
    align-items: baseline;
    gap: 14px;
    color: var(--umber);
  }

  .hub-list li::before {
    content: '';
    flex: none;
    width: 14px;
    height: 1px;
    background: var(--bronze);
    transform: translateY(-4px);
  }

  .hub-process {
    display: grid;
    gap: 16px;
    counter-reset: hub-step;
  }

  .hub-process li {
    counter-increment: hub-step;
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
    color: var(--umber);
  }

  .hub-process li::before {
    content: counter(hub-step, decimal-leading-zero);
    font-family: var(--f-display);
    font-size: 1.35rem;
    line-height: 1;
    color: var(--bronze);
    font-variant-numeric: lining-nums;
  }

  @media (max-width: 900px) {
    .hub-summary {
      margin-top: 16px;
    }
  }
</style>
