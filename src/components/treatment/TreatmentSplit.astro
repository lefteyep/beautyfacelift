---
/**
 * Editorial split: one framed image beside the copy (default slot).
 *   reverse — image on the right on desktop
 * Copy comes first on mobile; the image then crops to 4:3.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { splitImageSizes, widthsFor } from './images';

interface Props {
  image: ImageMetadata;
  alt: string;
  reverse?: boolean;
  quality?: 'mid' | 'high';
  /** Horizontal focus of the cover crop. */
  focus?: 'left' | 'center' | 'right';
}

const { image, alt, reverse = false, quality = 'mid', focus = 'center' } = Astro.props;
---

<div class:list={['tp-split', reverse && 'is-reverse']}>
  <div class:list={['tp-split-media', 'scroll-anim', `focus-${focus}`]}>
    <Image
      src={image}
      widths={widthsFor(image)}
      sizes={splitImageSizes(image, 5 / 4)}
      format="webp"
      quality={quality}
      loading="lazy"
      alt={alt}
    />
  </div>
  <div class="tp-split-copy">
    <slot />
  </div>
</div>

<style>
  .tp-split {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(40px, 7vw, 120px);
    align-items: center;
  }

  .tp-split.is-reverse {
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
  }

  .tp-split.is-reverse .tp-split-media {
    order: 2;
  }

  .tp-split-media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: var(--r-lg);
    background: var(--blush);
  }

  .tp-split-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-expo);
  }

  .tp-split-media:hover :global(img) {
    transform: scale(1.03);
  }

  .focus-left :global(img) { object-position: 35% 50%; }
  .focus-right :global(img) { object-position: 65% 50%; }

  .tp-split-copy {
    display: grid;
    gap: 24px;
    align-content: center;
    justify-items: start;
    min-width: 0;
  }

  .tp-split-copy > :global(h2) {
    max-width: 16ch;
  }

  .tp-split-copy > :global(.lead) {
    max-width: 46ch;
  }

  .tp-split-copy > :global(.btn-row) {
    margin-top: 8px;
  }

  /* Quiet caveat under a list, e.g. "Nicht empfohlen bei …" */
  .tp-split-copy > :global(.split-note) {
    max-width: 52ch;
    margin-top: -4px;
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .tp-split,
    .tp-split.is-reverse {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }

    .tp-split-media,
    .tp-split.is-reverse .tp-split-media {
      order: 2;
      aspect-ratio: 4 / 3;
    }
  }
</style>
