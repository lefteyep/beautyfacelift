---
/**
 * FAQ layout: sticky heading column beside the accordion list.
 * Either pass `items` (rendered as plain-text accordion rows plus matching
 * FAQPage JSON-LD), or fill the default slot with <details class="faq-item">
 * rows and keep their text in sync with the page's own JSON-LD.
 * Slot "title" = h2 content.
 */
import { wissenLinkFor } from '../../pages/blog/_posts';
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  /** Link to the full FAQ page; pass false to hide. */
  allLink?: boolean;
  items?: FaqItem[];
}

const { allLink = true, items } = Astro.props;
// The matching Wissen article for this page, if there is one (see _posts.ts).
const wissen = wissenLinkFor(Astro.url.pathname);
// data-button-location marks the position, as on the other section-head buttons. It is named after the
// component because FaqBlock renders on several page types ("faq_" alone is the FAQ page's
// own prefix). The click tracker does not send internal links today (src/lib/track.ts).
const links = [
  allLink && { href: '/haeufige-fragen/', label: 'Alle Fragen', location: 'faq_block_all' },
  wissen && { href: wissen.href, label: wissen.label, location: 'faq_block_article' },
].filter((link): link is { href: string; label: string; location: string } => Boolean(link));
// One button sits bare in the head, like every other section head; two share a .btn-row.
const LinkRow = links.length > 1 ? 'div' : Fragment;
const linkRowProps = links.length > 1 ? { class: 'btn-row' } : {};

const faqData = items && {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": items.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<div class="faq-block">
  <div class="faq-block-head">
    <h2><slot name="title" /></h2>
    <LinkRow {...linkRowProps}>
      {links.map((link) => <a href={link.href} class="btn btn-secondary btn-arrow" data-button-location={link.location}>{link.label}</a>)}
    </LinkRow>
  </div>
  <div class="faq-list">
    {items ? items.map((item) => (
      <details class="faq-item">
        <summary><h3>{item.question}</h3></summary>
        <div class="faq-answer"><div class="faq-answer-inner">
          <p>{item.answer}</p>
        </div></div>
      </details>
    )) : <slot />}
  </div>
</div>

{faqData && <script type="application/ld+json" set:html={JSON.stringify(faqData)} />}

<style>
  .faq-block {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 5fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .faq-block-head {
    display: grid;
    gap: 20px;
    justify-items: start;
  }

  .faq-block-head h2 {
    max-width: 12ch;
  }

  @media (min-width: 901px) {
    .faq-block-head {
      position: sticky;
      top: calc(var(--nav-h) + 40px);
    }
  }

  @media (max-width: 900px) {
    .faq-block {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
  }
</style>
