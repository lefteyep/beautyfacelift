---
/**
 * Hairline list for suitability notes and similar enumerations.
 *   items: plain strings, or { term, text } rows
 *   size="large": term becomes an h3 in a 4fr / 7fr row (long explanations)
 */
interface Row {
  term: string;
  text: string;
}

interface Props {
  items: (string | Row)[];
  size?: 'default' | 'large';
}

const { items, size = 'default' } = Astro.props;
const hasTerms = items.some((item) => typeof item !== 'string');
---

<ul class:list={['ruled-list', hasTerms && 'has-terms', size === 'large' && 'is-large']}>
  {items.map((item) => (
    typeof item === 'string' ? (
      <li><span class="ruled-list-text">{item}</span></li>
    ) : (
      <li>
        {size === 'large'
          ? <h3 class="ruled-list-term">{item.term}</h3>
          : <span class="ruled-list-term">{item.term}</span>}
        <span class="ruled-list-text">{item.text}</span>
      </li>
    )
  ))}
</ul>

<style>
  .ruled-list {
    border-top: 1px solid var(--rule-strong);
  }

  .ruled-list li {
    padding-block: 14px;
    border-bottom: 1px solid var(--rule);
    color: var(--umber);
    line-height: 1.6;
  }

  .has-terms li {
    display: grid;
    grid-template-columns: minmax(0, 0.42fr) minmax(0, 1fr);
    gap: 4px 24px;
    align-items: baseline;
  }

  .ruled-list-term {
    font-family: var(--f-display);
    font-size: 1.12rem;
    line-height: 1.3;
    color: var(--espresso);
  }

  .is-large li {
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: 12px clamp(20px, 4vw, 64px);
    padding-block: clamp(22px, 2.6vw, 34px);
  }

  .is-large .ruled-list-term {
    font-size: var(--fs-h3);
    line-height: 1.15;
  }

  .is-large .ruled-list-text {
    max-width: 62ch;
  }

  @media (max-width: 700px) {
    .has-terms li,
    .is-large li {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
