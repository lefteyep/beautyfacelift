---
/**
 * Treatment hero: breadcrumbs, one H1 (default slot, one <em> accent),
 * one lead, booking + WhatsApp CTAs, rating proof, and the arched hero image
 * with an optional price card. Pair with treatmentHeroPreload() for Base.astro.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import { CONTACT_WHATSAPP_URL } from '../../../shared/site';
import { treatmentHeroSizes, treatmentHeroWidths } from './images';

interface Props {
  /** Tracking name, e.g. "Aquafacial" (data-treatment). */
  treatment: string;
  /** Last breadcrumb label for JSON-LD, e.g. "Aquafacial Zürich" (shown without "Zürich"). */
  breadcrumb: string;
  lead: string;
  bookingHref: string;
  image: ImageMetadata;
  alt: string;
  /** Horizontal focus of the cover crop. */
  focus?: 'left' | 'center' | 'right';
  /** Price card on the image, e.g. price "ab CHF 180", duration "60–90 Minuten". */
  price?: string;
  duration?: string;
}

const { treatment, breadcrumb, lead, bookingHref, image, alt, focus = 'center', price, duration } = Astro.props;
const crumbDisplay = breadcrumb.replace(/\s+Zürich$/, '');
---

<header class="treatment-hero tx-hero">
  <div class="tx-hero-copy">
    <div class="reveal-up">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Behandlungen', href: '/behandlungen/' },
        { label: breadcrumb, display: crumbDisplay },
      ]} />
    </div>
    <h1 class="tx-hero-title reveal-up d-1"><slot /></h1>
    <p class="lead reveal-up d-2">{lead}</p>
    <div class="btn-row reveal-up d-3">
      <a href={bookingHref} class="btn btn-lg btn-arrow" data-treatment={treatment} data-button-location="treatment_hero">Termin buchen</a>
      <a
        href={CONTACT_WHATSAPP_URL}
        class="btn btn-secondary btn-lg"
        target="_blank"
        rel="noopener"
        data-treatment={treatment}
        data-button-location="treatment_hero_whatsapp"
        data-source="treatment_hero"
      >Frage per WhatsApp</a>
    </div>
    <p class="tx-proof reveal-up d-4">
      <span class="tx-stars" aria-hidden="true">★★★★★</span>
      <span><strong>4,8</strong> aus 248+ Bewertungen</span>
    </p>
  </div>

  <div class="tx-hero-media">
    <div class:list={['arch', 'tx-hero-frame', 'reveal-media', `focus-${focus}`]}>
      <Image
        src={image}
        widths={treatmentHeroWidths(image)}
        sizes={treatmentHeroSizes(image)}
        format="webp"
        quality="high"
        priority
        alt={alt}
        id="treatment-hero-img"
      />
    </div>
    {price && (
      <p class="float-card tx-price reveal-up d-4">
        <strong>{price}</strong>
        {duration && <span>{duration}</span>}
      </p>
    )}
  </div>
</header>

<style>
  .d-1 { --d: 1; }
  .d-2 { --d: 2; }
  .d-3 { --d: 3; }
  .d-4 { --d: 4; }

  .tx-hero {
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    gap: clamp(32px, 6vw, 112px);
  }

  .tx-hero-copy {
    display: grid;
    gap: 24px;
    align-content: center;
    justify-items: start;
  }

  .tx-hero-copy :global(.breadcrumbs) {
    padding: 0;
  }

  .tx-hero-title {
    max-width: 14ch;
    font-size: clamp(2.75rem, 5.4vw, 5.25rem);
    line-height: 0.96;
    letter-spacing: -0.015em;
    overflow-wrap: break-word;
  }

  .tx-hero-copy .lead {
    max-width: 40ch;
  }

  .tx-hero-copy .btn-row {
    margin-top: 6px;
  }

  .tx-proof {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-size: 0.92rem;
    color: var(--text);
  }

  .tx-stars {
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    color: var(--gold);
  }

  /* Arch on the right; the price card overlaps its lower left edge. */
  .tx-hero-media {
    position: relative;
    width: min(100%, 500px);
    justify-self: end;
    padding: 0 0 36px 44px;
  }

  .tx-hero-frame {
    width: 100%;
    aspect-ratio: 4 / 5;
    max-height: max(520px, calc(100svh - var(--nav-h) - 140px));
    box-shadow: var(--shadow);
  }

  .tx-hero-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .focus-left :global(img) { object-position: 38% 50%; }
  .focus-center :global(img) { object-position: 50% 50%; }
  .focus-right :global(img) { object-position: 62% 50%; }

  .tx-price {
    position: absolute;
    left: 0;
    bottom: 0;
    display: grid;
    gap: 2px;
    padding: 16px 22px;
  }

  .tx-price strong {
    font-family: var(--f-serif);
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1.05;
    color: var(--cocoa);
  }

  .tx-price span {
    font-size: 0.85rem;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .tx-hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }

    .tx-hero-media {
      order: -1;
      width: 100%;
      justify-self: stretch;
      padding: 0;
    }

    .tx-hero-frame {
      aspect-ratio: 4 / 3;
      max-height: none;
      border-radius: var(--r-xl);
      box-shadow: none;
    }

    .tx-price {
      left: 12px;
      bottom: 12px;
      padding: 12px 16px;
    }

    .tx-price strong { font-size: 1.4rem; }

    .tx-hero-title {
      max-width: none;
      font-size: clamp(2.6rem, 11vw, 3.6rem);
    }
  }

  @media (max-width: 600px) {
    .tx-hero-copy .btn-row {
      width: 100%;
    }

    .tx-hero-copy .btn-row .btn {
      flex: 1 1 100%;
    }
  }
</style>
