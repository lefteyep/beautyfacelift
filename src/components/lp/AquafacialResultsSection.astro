---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type ResultImage = {
  src: ImageMetadata;
  alt: string;
};

type ResultExample = {
  image: ResultImage;
  caption: string;
  note?: string;
};

interface Props {
  eyebrow: string;
  headline: string;
  intro: string;
  examples: ResultExample[];
  disclaimer: string;
  ctaLabel: string;
  ctaTarget: string;
}

const {
  eyebrow,
  headline,
  intro,
  examples,
  disclaimer,
  ctaLabel,
  ctaTarget,
} = Astro.props as Props;

---

<section class="container lp-section aquafacial-results-section" id="aquafacial-results" aria-labelledby="aquafacial-results-title">
  <div class="aquafacial-results-head">
    <p class="lp-eyebrow">{eyebrow}</p>
    <h2 class="lp-section-title" id="aquafacial-results-title">{headline}</h2>
    <p class="lp-section-lead">{intro}</p>
  </div>

  <div class="aquafacial-results-grid" aria-label="Aquafacial Ergebnisbeispiele">
    {examples.map((example) => (
      <article class="aquafacial-result-card">
        <figure class="aquafacial-result-image">
          <Image
            src={example.image.src}
            widths={[360, 520, 720, 960, 1200]}
            sizes="(min-width: 1101px) 27vw, (min-width: 761px) 45vw, 88vw"
            format="webp"
            quality="high"
            alt={example.image.alt}
            loading="lazy"
          />
        </figure>
        <div class="aquafacial-result-copy">
          <h3>{example.caption}</h3>
          {example.note && <p>{example.note}</p>}
        </div>
      </article>
    ))}
  </div>

  <p class="aquafacial-results-disclaimer">{disclaimer}</p>

  <div class="lp-section-cta">
    <a href={ctaTarget} class="pill-btn" data-button-location="results_section" data-aquafacial-scroll>{ctaLabel}</a>
  </div>
</section>

<style>
  .aquafacial-results-section {
    border-block: 1px solid var(--border-subtle);
    background: linear-gradient(180deg, var(--bone) 0%, var(--paper-2) 100%);
    padding-bottom: clamp(72px, 8vw, 112px);
  }

  .aquafacial-results-head {
    display: grid;
    justify-items: center;
    max-width: min(100%, 1040px);
    margin: 0 auto 44px;
    text-align: center;
  }

  .aquafacial-results-head .lp-eyebrow {
    width: 100%;
    margin-bottom: 14px;
    text-align: center;
  }

  .aquafacial-results-head .lp-section-title {
    width: 100%;
    max-width: 1080px;
    margin-inline: auto;
    text-align: center;
  }

  .aquafacial-results-head .lp-section-lead {
    width: 100%;
    max-width: 980px;
    margin-inline: auto;
    text-align: center;
  }

  .aquafacial-results-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .aquafacial-result-card {
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    background: var(--bone);
    box-shadow: var(--shadow-1);
  }

  .aquafacial-result-image {
    position: relative;
    aspect-ratio: 1.34 / 1;
    margin: 0;
    overflow: hidden;
    background: #e8ddd8;
  }

  .aquafacial-result-image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .aquafacial-result-copy {
    display: grid;
    gap: 8px;
    padding: 20px;
  }

  .aquafacial-result-copy h3 {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 400;
    line-height: 1.18;
    letter-spacing: 0;
    text-transform: none;
  }

  .aquafacial-result-copy p,
  .aquafacial-results-disclaimer {
    margin: 0;
    color: var(--ink-2);
    font-size: 14px;
    line-height: 1.55;
  }

  .aquafacial-results-disclaimer {
    max-width: 780px;
    margin: 24px auto 0;
    text-align: center;
  }

  .aquafacial-results-section .lp-section-cta {
    display: flex;
    justify-content: center;
    margin-top: 28px;
  }

  @media (max-width: 1100px) {
    .aquafacial-results-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .aquafacial-results-section {
      border-block: 1px solid var(--border-subtle);
    }

    .aquafacial-results-head {
      margin-bottom: 32px;
    }

    .aquafacial-results-grid {
      grid-template-columns: 1fr;
    }

    .aquafacial-result-image {
      aspect-ratio: 1.34 / 1;
    }

    .aquafacial-result-copy {
      padding: 18px;
    }

    .aquafacial-result-copy h3 {
      font-size: 22px;
    }
  }
</style>
