---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type ResultImage = {
  src: ImageMetadata;
  alt: string;
};

type ResultExample = {
  image: ResultImage;
  caption: string;
  note?: string;
};

interface Props {
  eyebrow: string;
  headline: string;
  intro: string;
  examples: ResultExample[];
  disclaimer: string;
  ctaLabel: string;
  ctaTarget: string;
}

const {
  eyebrow,
  headline,
  intro,
  examples,
  disclaimer,
  ctaLabel,
  ctaTarget,
} = Astro.props as Props;

---

<section class="container lp-section aquafacial-results-section" id="aquafacial-results" aria-labelledby="aquafacial-results-title">
  <div class="aquafacial-results-head">
    <p class="lp-eyebrow">{eyebrow}</p>
    <h2 class="lp-section-title" id="aquafacial-results-title">{headline}</h2>
    <p class="lp-section-lead">{intro}</p>
  </div>

  <div class="aquafacial-results-grid" aria-label="Aquafacial Ergebnisbeispiele">
    {examples.map((example) => (
      <article class="aquafacial-result-card">
        <figure class="aquafacial-result-image">
          <Image
            src={example.image.src}
            widths={[360, 520, 720, 960, 1200]}
            sizes="(min-width: 1320px) 420px, (min-width: 761px) 31vw, calc(100vw - 40px)"
            format="webp"
            quality="high"
            alt={example.image.alt}
            loading="lazy"
          />
        </figure>
        <div class="aquafacial-result-copy">
          <h3>{example.caption}</h3>
          {example.note && <p>{example.note}</p>}
        </div>
      </article>
    ))}
  </div>

  <p class="aquafacial-results-disclaimer">{disclaimer}</p>

  <div class="lp-section-cta">
    <a href={ctaTarget} class="btn" data-button-location="results_section" data-aquafacial-scroll>{ctaLabel}</a>
  </div>
</section>

<style>
  .aquafacial-results-section {
    padding-top: clamp(72px, 9vw, 136px);
    padding-bottom: clamp(72px, 8vw, 112px);
    border-top: 1px solid var(--rule);
  }

  .aquafacial-results-head {
    display: grid;
    justify-items: center;
    gap: 20px;
    max-width: min(100%, 880px);
    margin: 0 auto clamp(40px, 5vw, 72px);
    text-align: center;
  }

  .aquafacial-results-head .lp-eyebrow {
    width: 100%;
    margin: 0;
    color: var(--clay);
    font-size: var(--fs-label);
    font-weight: 500;
    line-height: 1.4;
    text-align: center;
  }

  .aquafacial-results-head .lp-section-title {
    width: 100%;
    max-width: 20ch;
    margin-inline: auto;
    font-size: var(--fs-h2);
    line-height: 1.06;
    letter-spacing: -0.015em;
    text-align: center;
  }

  .aquafacial-results-head .lp-section-lead {
    width: 100%;
    max-width: 58ch;
    margin-inline: auto;
    font-size: var(--fs-lead);
    line-height: 1.6;
    text-align: center;
  }

  .aquafacial-results-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 48px clamp(20px, 3vw, 48px);
  }

  .aquafacial-result-card {
    display: grid;
    align-content: start;
    gap: 22px;
  }

  .aquafacial-result-image {
    position: relative;
    aspect-ratio: 1.34 / 1;
    margin: 0;
    overflow: hidden;
    border-radius: var(--r-lg);
    background: var(--stone);
  }

  .aquafacial-result-image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .aquafacial-result-copy {
    display: grid;
    gap: 10px;
    padding-top: 18px;
    border-top: 1px solid var(--rule-strong);
  }

  .aquafacial-result-copy h3 {
    margin: 0;
    font-size: var(--fs-h4);
    line-height: 1.25;
  }

  .aquafacial-result-copy p {
    margin: 0;
    color: var(--umber);
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .aquafacial-results-disclaimer {
    max-width: 72ch;
    margin: clamp(40px, 5vw, 56px) auto 0;
    color: var(--taupe);
    font-size: var(--fs-small);
    line-height: 1.55;
    text-align: center;
  }

  .aquafacial-results-section .lp-section-cta {
    display: flex;
    justify-content: center;
    margin-top: 32px;
  }

  @media (max-width: 760px) {
    .aquafacial-results-head .lp-section-title {
      font-size: clamp(1.9rem, 8.4vw, 2.4rem);
    }

    .aquafacial-results-head .lp-section-lead {
      font-size: 1.05rem;
    }

    .aquafacial-results-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }

    .aquafacial-results-section .lp-section-cta .btn {
      width: 100%;
    }
  }
</style>
