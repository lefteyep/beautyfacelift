---
interface Promise {
  text: string;
}

interface Props {
  variant?: 'rating' | 'promises';
  rating?: string;
  reviewCount?: string;
  address?: string;
  years?: string;
  promises?: Promise[];
  align?: 'left' | 'center';
}

const {
  variant = 'rating',
  rating = '4.8',
  reviewCount = '248+ Bewertungen',
  address = 'Bahnhofstrasse 94',
  years = '20+ Jahre',
  promises = [
    { text: 'Meist keine Ausfallzeit' },
    { text: 'Persönliche Betreuung' },
    { text: 'Transparente Preise' },
    { text: 'Unverbindliche Anfrage' },
  ],
  align = 'left',
} = Astro.props;
---

{variant === 'rating' ? (
  <div class={`trust-strip-lp trust-strip-lp--${align}`} aria-label={`${rating} von 5 Sternen, ${reviewCount}`}>
    <span class="trust-rating-group">
      <span class="trust-stars" aria-hidden="true">★★★★★</span>
      <strong class="trust-rating-num">{rating}</strong>
      <span class="trust-rating-label">{reviewCount}</span>
    </span>
    <span class="trust-sep" aria-hidden="true"></span>
    <span class="trust-item">{years} Erfahrung</span>
  </div>
) : (
  <div class={`trust-strip-lp trust-strip-lp--promises trust-strip-lp--${align}`}>
    {promises.map((p, i) => (
      <>
        {i > 0 && <span class="trust-sep" aria-hidden="true"></span>}
        <span class="trust-item trust-item--check">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" width="13" height="13" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          {p.text}
        </span>
      </>
    ))}
  </div>
)}

<style>
  /* Trust-line row: label type, hairline separators, bronze accents. */
  .trust-strip-lp {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 18px;
    font-family: var(--f-body);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.16em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--taupe);
  }

  .trust-strip-lp--left {
    justify-content: flex-start;
  }

  .trust-strip-lp--center {
    justify-content: center;
    text-align: center;
  }

  .trust-rating-group {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
  }

  .trust-stars {
    color: var(--bronze);
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    line-height: 1;
  }

  .trust-rating-num {
    color: var(--espresso);
    font-family: var(--f-display);
    font-size: 1.15rem;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1;
    text-transform: none;
    font-variant-numeric: lining-nums;
  }

  .trust-rating-label {
    color: var(--taupe);
  }

  .trust-sep {
    flex-shrink: 0;
    width: 1px;
    height: 12px;
    background: var(--rule-strong);
  }

  .trust-item {
    color: var(--taupe);
  }

  .trust-item--check {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--umber);
  }

  .trust-item--check svg {
    flex-shrink: 0;
    color: var(--bronze);
  }

  @media (max-width: 600px) {
    .trust-strip-lp {
      gap: 8px 14px;
      letter-spacing: 0.12em;
    }
  }
</style>
