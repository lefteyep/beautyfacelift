---
/**
 * WhatsApp contact for the Meta ad landing pages (prefilled message, tracked as contact).
 *   variant "inline" — secondary pill with the WhatsApp glyph (.btn-secondary)
 *   variant "link"   — text link with the site's arrow disc (.btn-link), next to a primary pill
 *   variant "sticky" — floating cocoa disc, bottom right. Like /lp/aquafacial/ it appears after 25 % scroll depth,
 *                      sits above a StickyOfferBar on phones and hides while the consent banner is open.
 */
interface Props {
  phone?: string;
  message?: string;
  label?: string;
  variant?: 'sticky' | 'inline' | 'link';
  source?: string;
}

const {
  phone = '41792143462',
  message = 'Hallo Teresa, ich interessiere mich für eine Beauty-Face-Lift-Behandlung.',
  label = 'WhatsApp schreiben',
  variant = 'inline',
  source = 'lp',
} = Astro.props;

const href = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
const dataSource = source;
const glyph = 'M17.47 14.37c-.3-.15-1.73-.85-2-.95s-.47-.15-.67.15-.77.95-.94 1.15-.35.22-.64.07a8.11 8.11 0 0 1-2.4-1.48 8.89 8.89 0 0 1-1.66-2.06c-.17-.3 0-.47.13-.62s.3-.35.45-.52a2 2 0 0 0 .3-.5.55.55 0 0 0 0-.52c-.07-.15-.67-1.62-.92-2.22s-.49-.5-.67-.51h-.57a1.1 1.1 0 0 0-.8.37 3.33 3.33 0 0 0-1 2.48 5.77 5.77 0 0 0 1.23 3.09 13.23 13.23 0 0 0 5.09 4.49 17.08 17.08 0 0 0 1.7.63 4.1 4.1 0 0 0 1.88.12 3.08 3.08 0 0 0 2-1.42 2.49 2.49 0 0 0 .18-1.42c-.08-.13-.27-.2-.57-.35ZM12 2a10 10 0 0 0-8.55 15.15L2 22l4.97-1.42A10 10 0 1 0 12 2Zm0 18.21a8.17 8.17 0 0 1-4.18-1.14l-.3-.18-3.08.88.9-3-.2-.31a8.21 8.21 0 1 1 6.86 3.75Z';
---

{variant === 'sticky' ? (
  <a
    class="wa-sticky"
    href={href}
    target="_blank"
    rel="noopener"
    aria-label={label}
    data-track-contact="whatsapp"
    data-source={dataSource}
  >
    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
      <path fill="currentColor" d={glyph} />
    </svg>
  </a>
) : variant === 'link' ? (
  <a
    class="wa-link btn-link"
    href={href}
    target="_blank"
    rel="noopener"
    data-track-contact="whatsapp"
    data-source={dataSource}
  >{label}</a>
) : (
  <a
    class="wa-inline btn btn-secondary"
    href={href}
    target="_blank"
    rel="noopener"
    data-track-contact="whatsapp"
    data-source={dataSource}
  >
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <path fill="currentColor" d={glyph} />
    </svg>
    {label}
  </a>
)}

<script>
  // Floating WhatsApp: revealed after 25 % scroll depth (body.lp-wa-scrolled), as on /lp/aquafacial/.
  function initFloatingWhatsApp() {
    if (!document.querySelector('.wa-sticky')) return;
    let ticking = false;
    const sync = () => {
      ticking = false;
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      document.body.classList.toggle('lp-wa-scrolled', scrollable > 0 && window.scrollY / scrollable >= 0.25);
    };
    window.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(sync);
    }, { passive: true });
    window.addEventListener('resize', sync);
    sync();
  }

  initFloatingWhatsApp();
</script>

<style>
  /* Floating disc (floating UI may carry the float shadow). Hidden until 25 % scroll depth. */
  .wa-sticky {
    position: fixed;
    right: 24px;
    bottom: calc(24px + env(safe-area-inset-bottom, 0px));
    left: auto;
    top: auto;
    z-index: 45;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 56px;
    height: 56px;
    margin: 0;
    padding: 0;
    border: 1px solid var(--rule-light-strong);
    border-radius: var(--r-pill);
    background: var(--cocoa);
    color: var(--cream);
    box-shadow: var(--shadow-float);
    text-decoration: none;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(12px);
    transition:
      opacity 0.35s ease,
      transform 0.5s var(--ease-expo),
      background-color 0.3s ease,
      visibility 0s linear 0.35s;
  }

  :global(body.lp-wa-scrolled:not(.bfl-consent-visible)) .wa-sticky {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: none;
    transition-delay: 0s;
  }

  :global(body.lp-wa-scrolled:not(.bfl-consent-visible)) .wa-sticky:hover {
    transform: translateY(-2px);
    background: var(--clay);
  }

  .wa-sticky:focus-visible {
    outline: 2px solid var(--clay);
    outline-offset: 4px;
  }

  /* Inline: secondary pill with the glyph. Dark bands get the light hairline pill from main.css. */
  .wa-inline svg {
    flex-shrink: 0;
  }

  /* Phones and tablets: smaller disc, above the offer bar (--lp-sticky-offer-height is 0 without one). */
  @media (max-width: 900px) {
    .wa-sticky {
      right: calc(16px + env(safe-area-inset-right, 0px));
      bottom: calc(var(--lp-sticky-offer-height, 0px) + 14px + env(safe-area-inset-bottom, 0px));
      width: 52px;
      height: 52px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-sticky {
      transition: none;
    }
  }
</style>
