---
interface Props {
  phone?: string;
  message?: string;
  label?: string;
  variant?: 'sticky' | 'inline';
  source?: string;
}

const {
  phone = '41792143462',
  message = 'Hallo Teresa, ich interessiere mich für eine Beauty-Face-Lift-Behandlung.',
  label = 'WhatsApp schreiben',
  variant = 'inline',
  source = 'lp',
} = Astro.props;

const href = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
const dataSource = source;
---

{variant === 'sticky' ? (
  <a
    class="wa-sticky"
    href={href}
    target="_blank"
    rel="noopener"
    aria-label={label}
    data-track-contact="whatsapp"
    data-source={dataSource}
  >
    <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
      <path fill="currentColor" d="M17.47 14.37c-.3-.15-1.73-.85-2-.95s-.47-.15-.67.15-.77.95-.94 1.15-.35.22-.64.07a8.11 8.11 0 0 1-2.4-1.48 8.89 8.89 0 0 1-1.66-2.06c-.17-.3 0-.47.13-.62s.3-.35.45-.52a2 2 0 0 0 .3-.5.55.55 0 0 0 0-.52c-.07-.15-.67-1.62-.92-2.22s-.49-.5-.67-.51h-.57a1.1 1.1 0 0 0-.8.37 3.33 3.33 0 0 0-1 2.48 5.77 5.77 0 0 0 1.23 3.09 13.23 13.23 0 0 0 5.09 4.49 17.08 17.08 0 0 0 1.7.63 4.1 4.1 0 0 0 1.88.12 3.08 3.08 0 0 0 2-1.42 2.49 2.49 0 0 0 .18-1.42c-.08-.13-.27-.2-.57-.35ZM12 2a10 10 0 0 0-8.55 15.15L2 22l4.97-1.42A10 10 0 1 0 12 2Zm0 18.21a8.17 8.17 0 0 1-4.18-1.14l-.3-.18-3.08.88.9-3-.2-.31a8.21 8.21 0 1 1 6.86 3.75Z"/>
    </svg>
  </a>
) : (
  <a
    class="wa-inline pill-btn pill-btn-light"
    href={href}
    target="_blank"
    rel="noopener"
    data-track-contact="whatsapp"
    data-source={dataSource}
  >
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <path fill="currentColor" d="M17.47 14.37c-.3-.15-1.73-.85-2-.95s-.47-.15-.67.15-.77.95-.94 1.15-.35.22-.64.07a8.11 8.11 0 0 1-2.4-1.48 8.89 8.89 0 0 1-1.66-2.06c-.17-.3 0-.47.13-.62s.3-.35.45-.52a2 2 0 0 0 .3-.5.55.55 0 0 0 0-.52c-.07-.15-.67-1.62-.92-2.22s-.49-.5-.67-.51h-.57a1.1 1.1 0 0 0-.8.37 3.33 3.33 0 0 0-1 2.48 5.77 5.77 0 0 0 1.23 3.09 13.23 13.23 0 0 0 5.09 4.49 17.08 17.08 0 0 0 1.7.63 4.1 4.1 0 0 0 1.88.12 3.08 3.08 0 0 0 2-1.42 2.49 2.49 0 0 0 .18-1.42c-.08-.13-.27-.2-.57-.35ZM12 2a10 10 0 0 0-8.55 15.15L2 22l4.97-1.42A10 10 0 1 0 12 2Zm0 18.21a8.17 8.17 0 0 1-4.18-1.14l-.3-.18-3.08.88.9-3-.2-.31a8.21 8.21 0 1 1 6.86 3.75Z"/>
    </svg>
    {label}
  </a>
)}

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-track-contact="whatsapp"]').forEach((el) => {
    el.addEventListener('click', async () => {
      const source = el.dataset.source || 'lp';
      try {
        const { trackContact } = await import('../../lib/track');
        trackContact({ method: 'whatsapp', source });
      } catch { /* tracking is non-critical */ }
    });
  });
</script>

<style>
  .wa-sticky {
    position: fixed;
    right: 20px;
    bottom: 20px;
    left: auto;
    top: auto;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    background: #25D366;
    color: #fff;
    padding: 0;
    margin: 0;
    border: none;
    border-radius: 50%;
    box-shadow: 0 10px 30px rgba(37, 211, 102, 0.35);
    text-decoration: none;
    box-sizing: border-box;
    transition: transform 0.2s var(--ease-expo), box-shadow 0.2s var(--ease-expo);
  }
  .wa-sticky:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 36px rgba(37, 211, 102, 0.45);
  }

  .wa-inline {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #25D366;
    color: #fff;
    border-color: #25D366;
    box-shadow: 0 6px 18px rgba(37, 211, 102, 0.28);
  }
  .wa-inline::before {
    display: none;
  }
  .wa-inline:hover {
    background: #1ebe57;
    border-color: #1ebe57;
    box-shadow: 0 10px 24px rgba(37, 211, 102, 0.4);
  }

  @media (max-width: 900px) {
    .wa-sticky {
      right: 16px;
      bottom: calc(90px + env(safe-area-inset-bottom, 0px));
      width: 52px;
      height: 52px;
    }
  }
</style>
