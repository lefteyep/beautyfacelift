---
interface Props {
  oldPrice?: number;
  newPrice: number;
  currency?: string;
  discountLabel?: string;
  eyebrow?: string;
  urgency?: string;
  ctaText?: string;
  ctaHref?: string;
  variant?: 'chip' | 'box';
}

const {
  oldPrice,
  newPrice,
  currency = 'CHF',
  discountLabel,
  eyebrow,
  urgency,
  ctaText,
  ctaHref,
  variant = 'box',
} = Astro.props;

const hasDiscount = typeof oldPrice === 'number' && oldPrice > newPrice;
const computedPercent = hasDiscount ? Math.round((((oldPrice as number) - newPrice) / (oldPrice as number)) * 100) : 0;
const badge = discountLabel ?? (hasDiscount ? `${computedPercent}% Rabatt` : 'Offizieller Preis');
---

{variant === 'chip' ? (
  <div class="offer-chip">
    <span class="offer-chip-badge">{badge}</span>
    <span class="offer-chip-prices">
      {hasDiscount && <s>{currency} {(oldPrice as number).toFixed(0)}</s>}
      <strong>{currency} {newPrice.toFixed(0)}</strong>
    </span>
    {urgency && <span class="offer-chip-urgency">{urgency}</span>}
  </div>
) : (
  <div class="offer-box">
    {eyebrow && <div class="offer-eyebrow">{eyebrow}</div>}
    <div class="offer-box-prices">
      {hasDiscount && <span class="offer-old">{currency} {(oldPrice as number).toFixed(0)}</span>}
      <span class="offer-new">{currency} {newPrice.toFixed(0)}</span>
    </div>
    <div class="offer-badge">{badge}</div>
    {urgency && <p class="offer-urgency">{urgency}</p>}
    {ctaText && ctaHref && (
      <a href={ctaHref} class="pill-btn offer-cta">{ctaText}</a>
    )}
  </div>
)}

<style>
  .offer-chip {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.45rem;
    padding: 0;
    background: transparent;
    border: none;
    border-radius: 0;
    box-shadow: none;
    max-width: 100%;
  }
  .offer-chip-badge {
    display: inline-block;
    background: var(--gold-deep);
    color: var(--paper);
    padding: 0.35rem 0.7rem;
    border-radius: var(--r-sm, 4px);
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    box-shadow: none;
    line-height: 1.2;
  }
  .offer-chip-prices {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
    white-space: nowrap;
  }
  .offer-chip-prices s {
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: 1.1rem;
    font-weight: 500;
    text-decoration: line-through;
    text-decoration-thickness: 1.5px;
    line-height: 1.1;
  }
  .offer-chip-prices strong {
    font-family: var(--font-sans);
    font-size: clamp(2.2rem, 4vw, 2.75rem);
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: 0;
    line-height: 1;
  }
  .offer-chip-urgency {
    color: var(--text-secondary);
    font-size: 11px;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .offer-chip-urgency::before {
    content: '';
    display: inline-block;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.6;
    flex-shrink: 0;
  }

  .offer-box {
    background: var(--bg-secondary);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-card);
    padding: 2.5rem 2rem;
    text-align: center;
    box-shadow: var(--shadow-medium);
    max-width: 520px;
    margin: 0 auto;
  }
  .offer-eyebrow {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: 1rem;
  }
  .offer-box-prices {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .offer-old {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--text-muted);
    text-decoration: line-through;
  }
  .offer-new {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    font-weight: 500;
    color: var(--text-primary);
    line-height: 1;
  }
  .offer-badge {
    display: inline-block;
    background: transparent;
    color: var(--accent-text);
    padding: 0;
    border-radius: 0;
    font-weight: 600;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    margin-bottom: 1.25rem;
    box-shadow: none;
  }
  .offer-urgency {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    margin-bottom: 1.5rem;
  }
  .offer-cta {
    display: inline-block;
  }

  @media (max-width: 600px) {
    .offer-box {
      padding: 2rem 1.25rem;
      border-radius: 16px;
    }
    .offer-box-prices {
      gap: 0.75rem;
      margin-bottom: 0.75rem;
    }
    .offer-old {
      font-size: 1.2rem;
    }
    .offer-new {
      font-size: clamp(2.25rem, 13vw, 3rem);
    }
    .offer-badge {
      margin-bottom: 1rem;
      font-size: 11px;
    }
    .offer-urgency {
      margin-bottom: 1.25rem;
      font-size: 0.9rem;
    }
    .offer-cta {
      width: 100%;
    }
  }
</style>
