---
interface Props {
  oldPrice?: number;
  newPrice: number;
  currency?: string;
  discountLabel?: string;
  eyebrow?: string;
  urgency?: string;
  ctaText?: string;
  ctaHref?: string;
  variant?: 'chip' | 'box';
}

const {
  oldPrice,
  newPrice,
  currency = 'CHF',
  discountLabel,
  eyebrow,
  urgency,
  ctaText,
  ctaHref,
  variant = 'box',
} = Astro.props;

const hasDiscount = typeof oldPrice === 'number' && oldPrice > newPrice;
const computedPercent = hasDiscount ? Math.round((((oldPrice as number) - newPrice) / (oldPrice as number)) * 100) : 0;
const badge = discountLabel ?? (hasDiscount ? `${computedPercent}% Rabatt` : 'Behandlungspreis');
---

{variant === 'chip' ? (
  <div class="offer-chip">
    <span class="offer-chip-badge">{badge}</span>
    <span class="offer-chip-prices">
      {hasDiscount && <s>{currency} {(oldPrice as number).toFixed(0)}</s>}
      <strong>{currency} {newPrice.toFixed(0)}</strong>
    </span>
    {urgency && <span class="offer-chip-urgency">{urgency}</span>}
  </div>
) : (
  <div class="offer-box">
    {eyebrow && <div class="offer-eyebrow">{eyebrow}</div>}
    <div class="offer-box-prices">
      {hasDiscount && <span class="offer-old">{currency} {(oldPrice as number).toFixed(0)}</span>}
      <span class="offer-new">{currency} {newPrice.toFixed(0)}</span>
    </div>
    <div class="offer-badge">{badge}</div>
    {urgency && <p class="offer-urgency">{urgency}</p>}
    {ctaText && ctaHref && (
      <a href={ctaHref} class="pill-btn offer-cta" data-button-location="offer_box">{ctaText}</a>
    )}
  </div>
)}

<style>
  /* Elegant price block: label type, display-serif numerals, hairlines — no fills, pills or shadows. */
  .offer-chip {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    max-width: 100%;
  }

  .offer-chip-badge {
    color: var(--bronze);
    font-family: var(--f-body);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    line-height: 1.3;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .offer-chip-prices {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
    white-space: nowrap;
  }

  .offer-chip-prices s {
    order: 2;
    color: var(--taupe);
    font-family: var(--f-display);
    font-size: 1.25rem;
    line-height: 1.1;
    text-decoration-thickness: 1px;
  }

  .offer-chip-prices strong {
    color: var(--espresso);
    font-family: var(--f-display);
    font-size: clamp(2.2rem, 3.6vw, 2.75rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.01em;
    font-variant-numeric: lining-nums;
  }

  .offer-chip-urgency {
    display: block;
    max-width: min(100%, 420px);
    padding-top: 10px;
    border-top: 1px solid var(--rule);
    color: var(--taupe);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.5;
    text-transform: uppercase;
    white-space: normal;
  }

  .offer-box {
    display: grid;
    justify-items: center;
    max-width: 560px;
    margin: 0 auto;
    padding: clamp(36px, 5vw, 56px) clamp(24px, 4vw, 48px);
    border: 1px solid var(--rule);
    border-top-color: var(--rule-strong);
    background: var(--ivory);
    text-align: center;
  }

  .offer-eyebrow {
    margin-bottom: 18px;
    color: var(--bronze);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    line-height: 1.4;
    text-transform: uppercase;
  }

  .offer-box-prices {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 6px 18px;
    margin-bottom: 18px;
  }

  .offer-old {
    order: 2;
    color: var(--taupe);
    font-family: var(--f-display);
    font-size: 1.5rem;
    line-height: 1;
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }

  .offer-new {
    color: var(--espresso);
    font-family: var(--f-display);
    font-size: clamp(2.75rem, 6vw, 3.75rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.015em;
    font-variant-numeric: lining-nums;
  }

  .offer-badge {
    padding-top: 16px;
    margin-bottom: 18px;
    border-top: 1px solid var(--rule);
    color: var(--espresso);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    line-height: 1.4;
    text-transform: uppercase;
  }

  .offer-urgency {
    max-width: 44ch;
    margin: 0 auto 28px;
    color: var(--umber);
    font-size: var(--fs-small);
    line-height: 1.55;
  }

  .offer-cta {
    display: inline-flex;
  }

  @media (max-width: 600px) {
    .offer-box {
      padding: 32px 20px;
    }

    .offer-old {
      font-size: 1.25rem;
    }

    .offer-new {
      font-size: clamp(2.4rem, 12vw, 3rem);
    }

    .offer-cta {
      width: 100%;
    }
  }
</style>
