---
interface Testimonial {
  text: string;
  name: string;
  role?: string;
}

interface Props {
  testimonials: Testimonial[];
  rating?: string;
  reviewCount?: string;
}

const { testimonials, rating = '4.8', reviewCount = '230+' } = Astro.props;
---

<div class="testimonials-wrap">
  <div class="testimonials-rating">
    <div class="testimonials-stars" aria-label={`${rating} von 5 Sternen`}>
      {Array.from({ length: 5 }).map(() => '★').join('')}
    </div>
    <strong>{rating}</strong>
    <span>{reviewCount} fünf-Sterne-Bewertungen</span>
  </div>

  <div class="testimonials-grid">
    {testimonials.map((t) => (
      <figure class="testimonial-card">
        <div class="testimonial-stars" aria-hidden="true">★★★★★</div>
        <blockquote>{t.text}</blockquote>
        <figcaption>
          <strong>{t.name}</strong>
          {t.role && <span>{t.role}</span>}
        </figcaption>
      </figure>
    ))}
  </div>
</div>

<style>
  .testimonials-wrap {
    max-width: 1100px;
    margin: 0 auto;
  }
  .testimonials-rating {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin-bottom: 2.5rem;
    font-size: var(--text-md);
    flex-wrap: wrap;
  }
  .testimonials-rating strong {
    font-family: var(--font-serif);
    font-size: 1.5rem;
  }
  .testimonials-rating span {
    color: var(--text-secondary);
  }
  .testimonials-stars {
    color: var(--accent);
    letter-spacing: 2px;
    font-size: 1.2rem;
  }
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 2rem;
  }
  .testimonial-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0.25rem 0 0.25rem 1.5rem;
    border-left: 1px solid var(--accent);
    background: transparent;
    border-radius: 0;
    box-shadow: none;
    transition: border-left-color 0.4s var(--ease-expo);
  }
  .testimonial-card:hover {
    border-left-color: var(--accent-dark);
  }
  .testimonial-stars {
    color: var(--accent);
    letter-spacing: 3px;
    font-size: 0.75rem;
  }
  .testimonial-card blockquote {
    font-family: var(--font-serif);
    color: var(--text-primary);
    font-size: 1.25rem;
    line-height: 1.45;
    font-weight: 300;
    letter-spacing: -0.005em;
  }
  .testimonial-card figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-family: var(--font-sans);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: var(--tracking-nav);
    color: var(--text-muted);
    margin-top: auto;
  }
  .testimonial-card figcaption strong {
    color: var(--text-primary);
    font-weight: 500;
  }
  .testimonial-card figcaption span {
    color: var(--text-muted);
  }

  @media (max-width: 600px) {
    .testimonials-rating {
      margin-bottom: 2rem;
      gap: 0.5rem;
    }
    .testimonials-rating strong {
      font-size: 1.25rem;
    }
    .testimonials-rating span {
      font-size: 0.9rem;
    }
    .testimonials-grid {
      gap: 1.5rem;
    }
    .testimonial-card {
      padding: 0.25rem 0 0.25rem 1.25rem;
    }
    .testimonial-card blockquote {
      font-size: 1.1rem;
    }
  }
</style>
