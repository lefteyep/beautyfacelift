---
interface Testimonial {
  text: string;
  name: string;
  role?: string;
}

interface Props {
  testimonials: Testimonial[];
  rating?: string;
  reviewCount?: string;
}

const { testimonials, rating = '4,8', reviewCount = '248+' } = Astro.props;
// Two or four quotes sit in two columns, everything else in three, so no row is left with a single orphan.
const columns = testimonials.length === 2 || testimonials.length === 4 ? 2 : 3;
---

<div class="testimonials-wrap">
  <div class="testimonials-rating">
    <div class="testimonials-stars" aria-label={`${rating} von 5 Sternen`}>
      {Array.from({ length: 5 }).map(() => '★').join('')}
    </div>
    <strong>{rating} / 5</strong>
    <span>aus {reviewCount} Bewertungen</span>
  </div>

  <div class:list={['testimonials-grid', `testimonials-grid--${columns}`]}>
    {testimonials.map((t) => (
      <figure class="testimonial-card">
        <div class="testimonial-stars" aria-hidden="true">★★★★★</div>
        <blockquote>„{t.text}“</blockquote>
        <figcaption>
          <strong>{t.name}</strong>
          {t.role && <span>{t.role}</span>}
        </figcaption>
      </figure>
    ))}
  </div>
</div>

<style>
  .testimonials-wrap {
    max-width: var(--container);
    margin: 0 auto;
  }

  .testimonials-rating {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 8px 16px;
    margin-bottom: clamp(36px, 4vw, 56px);
  }

  .testimonials-stars {
    color: var(--bronze);
    font-size: 0.8rem;
    letter-spacing: 0.3em;
  }

  .testimonials-rating strong {
    color: var(--espresso);
    font-family: var(--f-display);
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1;
    font-variant-numeric: lining-nums;
  }

  .testimonials-rating span {
    color: var(--taupe);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .testimonials-grid {
    display: grid;
    gap: 40px clamp(24px, 4vw, 64px);
  }

  .testimonials-grid--3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .testimonials-grid--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .testimonial-card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin: 0;
    padding: 28px 0 0;
    border-top: 1px solid var(--rule-strong);
  }

  .testimonial-stars {
    color: var(--bronze);
    font-size: 0.7rem;
    letter-spacing: 0.35em;
  }

  .testimonial-card blockquote {
    margin: 0;
    color: var(--espresso);
    font-family: var(--f-display);
    font-size: clamp(1.25rem, 1.7vw, 1.5rem);
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: 0;
  }

  .testimonial-card figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin-top: auto;
    font-family: var(--f-body);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .testimonial-card figcaption strong {
    color: var(--espresso);
    font-weight: 600;
  }

  .testimonial-card figcaption span {
    color: var(--taupe);
  }

  @media (max-width: 900px) {
    .testimonials-grid--3,
    .testimonials-grid--2 {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
