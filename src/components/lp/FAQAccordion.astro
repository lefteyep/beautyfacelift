---
interface Item {
  q: string;
  a: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<div class="faq-accordion-lp">
  {items.map((item, i) => (
    <details class="faq-item-lp" open={i === 0}>
      <summary>
        <h3>{item.q}</h3>
        <span class="faq-icon-lp" aria-hidden="true">
          <span class="faq-icon-plus"></span>
          <span class="faq-icon-minus"></span>
        </span>
      </summary>
      <div class="faq-body-lp"><p>{item.a}</p></div>
    </details>
  ))}
</div>

<style>
  /* Hairline accordion — question in display serif, "+" drawn in CSS turning to "×". */
  .faq-accordion-lp {
    width: 100%;
    max-width: 880px;
    margin: 0 auto;
    border-top: 1px solid var(--rule-strong);
  }

  .faq-item-lp {
    border-bottom: 1px solid var(--rule);
  }

  .faq-item-lp summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding-block: clamp(20px, 2.4vw, 28px);
    list-style: none;
    cursor: pointer;
  }

  .faq-item-lp summary::-webkit-details-marker {
    display: none;
  }

  .faq-item-lp summary h3 {
    margin: 0;
    color: var(--espresso);
    font-family: var(--f-display);
    font-size: clamp(1.2rem, 1.7vw, 1.4rem);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0;
    transition: color 0.3s ease;
  }

  .faq-item-lp summary:hover h3 {
    color: var(--bronze);
  }

  .faq-icon-lp {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
    color: var(--bronze);
    transition: transform 0.45s var(--ease-expo);
  }

  .faq-icon-plus,
  .faq-icon-minus {
    position: absolute;
    top: 50%;
    left: 50%;
    background: currentColor;
    transform: translate(-50%, -50%);
  }

  .faq-icon-plus {
    width: 14px;
    height: 1px;
  }

  .faq-icon-minus {
    width: 1px;
    height: 14px;
  }

  .faq-item-lp[open] .faq-icon-lp {
    transform: rotate(45deg);
  }

  .faq-body-lp {
    max-width: 68ch;
    padding: 0 0 clamp(22px, 2.6vw, 30px);
  }

  .faq-body-lp p {
    margin: 0;
    color: var(--umber);
    font-size: 1rem;
    line-height: 1.7;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-icon-lp {
      transition: none;
    }
  }
</style>
