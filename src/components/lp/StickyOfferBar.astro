---
interface Props {
  oldPrice?: number;
  newPrice: number;
  currency?: string;
  href?: string;
  ctaText?: string;
}

const {
  oldPrice,
  newPrice,
  currency = 'CHF',
  href = '/termin/',
  ctaText = 'Jetzt buchen',
} = Astro.props;

const hasDiscount = typeof oldPrice === 'number' && oldPrice > newPrice;
---

<div class="sticky-offer-bar on-dark" role="complementary" aria-label="Angebot">
  <div class="sticky-offer-prices">
    {hasDiscount && <span class="sticky-offer-old">{currency} {(oldPrice as number).toFixed(0)}.-</span>}
    <strong class="sticky-offer-new">{currency} {newPrice.toFixed(0)}.-</strong>
  </div>
  <a href={href} class="pill-btn sticky-offer-cta" data-button-location="sticky_offer_bar">{ctaText}</a>
</div>
<div class="sticky-offer-safe-space" aria-hidden="true"></div>

<style>
  :global(body) {
    --lp-sticky-offer-height: 68px;
  }

  /* The bar is hidden while the consent banner is open, so the banner can use the bottom edge. */
  :global(body.bfl-consent-visible) {
    --lp-sticky-offer-height: 0px;
  }

  /* Hairline espresso bar (phones/tablets only). Hidden while the consent banner is open. */
  .sticky-offer-bar {
    display: none;
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 39;
    box-sizing: border-box;
    height: calc(var(--lp-sticky-offer-height) + env(safe-area-inset-bottom, 0px));
    padding: 0 var(--gutter) env(safe-area-inset-bottom, 0px);
    border-top: 1px solid var(--rule-light-strong);
    box-shadow: var(--shadow-float);
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .sticky-offer-prices {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    line-height: 1.1;
  }

  .sticky-offer-old {
    color: var(--champagne);
    font-family: var(--f-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }

  .sticky-offer-new {
    color: var(--porcelain);
    font-family: var(--f-display);
    font-size: 1.4rem;
    font-weight: 400;
    letter-spacing: 0;
    font-variant-numeric: lining-nums;
  }

  .sticky-offer-cta {
    flex-shrink: 0;
    min-height: 46px;
    padding: 0 1.25rem;
  }

  .sticky-offer-safe-space {
    display: none;
  }

  @media (max-width: 900px) {
    :global(body) {
      padding-bottom: calc(var(--lp-sticky-offer-height) + env(safe-area-inset-bottom, 0px));
    }

    :global(body.bfl-consent-visible) {
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }

    .sticky-offer-bar {
      display: flex;
    }

    :global(body.bfl-consent-visible) .sticky-offer-bar {
      display: none;
    }

    .sticky-offer-safe-space {
      display: block;
      height: calc(var(--lp-sticky-offer-height) + env(safe-area-inset-bottom, 0px));
    }

    :global(body.bfl-consent-visible) .sticky-offer-safe-space {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .sticky-offer-bar {
      gap: 12px;
    }

    .sticky-offer-new {
      font-size: 1.25rem;
    }

    .sticky-offer-cta {
      padding: 0 1rem;
      letter-spacing: 0.12em;
    }
  }
</style>
