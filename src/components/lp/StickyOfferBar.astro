---
interface Props {
  oldPrice?: number;
  newPrice: number;
  currency?: string;
  href?: string;
  ctaText?: string;
  treatment?: string;
}

const {
  oldPrice,
  newPrice,
  currency = 'CHF',
  href = '/termin/',
  ctaText = 'Jetzt buchen',
  treatment,
} = Astro.props;

const hasDiscount = typeof oldPrice === 'number' && oldPrice > newPrice;
---

<div class="sticky-offer-bar" role="complementary" aria-label="Angebot">
  <div class="sticky-offer-prices">
    {hasDiscount && <span class="sticky-offer-old">{currency} {(oldPrice as number).toFixed(0)}.-</span>}
    <strong class="sticky-offer-new">{currency} {newPrice.toFixed(0)}.-</strong>
  </div>
  <a href={href} class="pill-btn sticky-offer-cta" data-treatment={treatment} data-button-location="sticky_offer_bar">{ctaText}</a>
</div>
<div class="sticky-offer-safe-space" aria-hidden="true"></div>

<style>
  :global(body) {
    --lp-sticky-offer-height: 78px;
  }

  .sticky-offer-bar {
    display: none;
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 39;
    min-height: var(--lp-sticky-offer-height);
    padding: 0.65rem 1rem calc(0.65rem + env(safe-area-inset-bottom, 0px));
    background: rgba(28, 26, 23, 0.96);
    color: var(--paper);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-top: 1px solid rgba(246, 241, 234, 0.16);
    box-shadow: 0 -10px 32px rgba(18, 18, 18, 0.18);
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .sticky-offer-prices {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    line-height: 1.1;
  }
  .sticky-offer-old {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: rgba(246, 241, 234, 0.58);
    text-decoration: line-through;
  }
  .sticky-offer-new {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-weight: 500;
    color: var(--paper);
    letter-spacing: 0;
  }

  .sticky-offer-cta {
    padding: 12px 22px;
    font-size: 11px;
    flex-shrink: 0;
  }

  .sticky-offer-safe-space {
    display: none;
  }

  @media (max-width: 900px) {
    :global(body) {
      padding-bottom: calc(var(--lp-sticky-offer-height) + env(safe-area-inset-bottom, 0px));
    }

    :global(body.bfl-consent-visible) {
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }

    .sticky-offer-bar {
      display: flex;
    }

    :global(body.bfl-consent-visible) .sticky-offer-bar {
      display: none;
    }

    .sticky-offer-safe-space {
      display: block;
      height: calc(var(--lp-sticky-offer-height) + env(safe-area-inset-bottom, 0px));
    }

    :global(body.bfl-consent-visible) .sticky-offer-safe-space {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .sticky-offer-bar {
      padding: 0.6rem 0.85rem calc(0.6rem + env(safe-area-inset-bottom, 0px));
      gap: 0.5rem;
    }
    .sticky-offer-old {
      font-size: 0.7rem;
    }
    .sticky-offer-new {
      font-size: 1.3rem;
    }
    .sticky-offer-cta {
      padding: 10px 16px;
      font-size: 10px;
      letter-spacing: 1.2px;
    }
  }
</style>
