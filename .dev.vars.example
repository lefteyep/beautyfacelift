# Copy to .dev.vars for local `wrangler dev`.
# .dev.vars is gitignored — never commit real secrets.
# Pull current values from: Cloudflare dashboard → Workers & Pages → beautyfacelift → Settings → Variables.

# Canonical production origin used in examples and verification.
SITE_URL=https://beautyfacelift-zuerich.ch

PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Tracking (optional — leave blank to disable)
# PUBLIC_META_PIXEL_ID is exposed to the browser for client-side Pixel (fbq).
# META_PIXEL_ID + META_ACCESS_TOKEN are server-side (CAPI) — keep these secret.
PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_ACCESS_TOKEN=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
PUBLIC_GTM_ID=

# Payments (optional — Stripe not yet wired into booking flow)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Enquiry emails: the Worker's /api/contact sends them through Resend (required for the contact form)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
OWNER_EMAIL=

# Contact form security (required in production, optional locally)
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTS=beautyfacelift.ch,www.beautyfacelift.ch,beautyfacelift.mediapaulo.workers.dev

# Lead database and cockpit (optional locally). The D1 binding LEADS_DB comes from wrangler.jsonc;
# create the local tables with `npm run d1:migrate:local`.
# Local only: identity used for /admin/ instead of Cloudflare Access.
# LEADS_DEV_EMAIL=
# Secret for signed lead links (unsubscribe); any long random string locally.
# LEADS_SIGNING_SECRET=
# Cloudflare Access team domain and application audience tag that protect /admin/.
# ACCESS_TEAM_DOMAIN=
# ACCESS_AUD=
# Comma-separated e-mail addresses allowed into the lead cockpit.
# ACCESS_ALLOWED_EMAILS=
# Recipient of forwarded booking mails (wrangler.jsonc sets the agency address until go-live).
# LEADS_FORWARD_TO=
# Recipient of reminders about unanswered leads (wrangler.jsonc sets the agency address until go-live).
# LEADS_NUDGE_TO=
# Automated e-mails to customers: "on" enables them; keep "off" locally.
# LEADS_CUSTOMER_MAILS=off
# Resend audience for contacts with marketing consent.
# RESEND_AUDIENCE_ID=
# Review link used in review requests.
# GOOGLE_REVIEW_URL=
